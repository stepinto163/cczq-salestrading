<?xml version="1.0" encoding="UTF-8"?>
<!-- Jenkins 环境变量由凭据管理或受控节点配置注入，不在仓库中保存密码。 -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>ficc-internal</id>
            <username>${env.FICC_MAVEN_USERNAME}</username>
            <password>${env.FICC_MAVEN_PASSWORD}</password>
        </server>
    </servers>
    <mirrors>
        <mirror>
            <id>ficc-internal</id>
            <mirrorOf>*</mirrorOf>
            <url>${env.FICC_MAVEN_REPOSITORY_URL}</url>
        </mirror>
    </mirrors>
</settings>
