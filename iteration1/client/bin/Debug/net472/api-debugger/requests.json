      "limit": 100
    }
  },
  {
    "serverName": "QuoteSvr",
    "topic": "ficc.quote.history.search",
    "description": "跨日期历史报价搜索",
    "request": {
      "fromDate": "2026-09-01",
      "toDate": "2026-09-14",
      "filter": {
        "conditions": [
          {
            "field": "bondRating",
            "operator": "EQ",
            "value": "AAA"
          }
        ]
      },
      "limit": 200
    }
  },
  {
    "serverName": "QuoteSvr",
