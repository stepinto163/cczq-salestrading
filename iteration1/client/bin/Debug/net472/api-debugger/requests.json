  },
  {
    "serverName": "QuoteSvr",
    "topic": "ficc.quote.query",
    "description": "当前报价搜索",
    "request": {
      "filter": {
        "market": "RATE",
        "conditions": [
          {
            "field": "bondRating",
            "operator": "IN",
            "value": [
              "AAA",
              "AA+"
            ]
          }
        ],
        "watchlistIds": [],
        "filterGroupIds": []
      },
      "status": [
        "ACTIVE"
      ],
      "ownerScope": "VISIBLE",
      "limit": 200
