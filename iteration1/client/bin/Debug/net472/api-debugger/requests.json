          "clientQuoteId": "${clientQuoteId}",
          "securityId": "250001.IB",
          "institutionId": "I-001",
          "contactId": "C-001",
          "side": "1",
          "quoteType": "1",
          "yieldType": "1",
          "price": "2.5000",
          "quantity": "1000",
          "quantityUnit": "WAN",
          "currency": "CNY",
          "tradeDate": "2026-09-14",
          "settlType": "2"
        }
      ]
    }
  },
  {
    "serverName": "QuoteSvr",
