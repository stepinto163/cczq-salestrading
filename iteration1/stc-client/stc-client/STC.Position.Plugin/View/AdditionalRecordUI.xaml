<bondComp:WindowBase x:Class="STC.Position.Plugin.View.AdditionalRecordUI"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Position.Plugin.View"
             xmlns:bondComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:ViewModel="clr-namespace:STC.Position.Plugin.ViewModel" 
             mc:Ignorable="d" 
             Title="补录" Height="200" Width="400" ResizeMode="CanResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen">
    <bondComp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/QuoteStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TextBlockForeColor" Color="#FFFFFF"></SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
            <!--文本框-->
            <SolidColorBrush x:Key="TextBox.Static.Border" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Static.Background" Color="#172422"/>
            <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Foreground" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF9300"/>
            <SolidColorBrush x:Key="TextBox.Focus.Background" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="TextBox.Focus.Foreground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextBox.Disable.Border" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Disable.Background" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="TextBox.Disable.Foreground" Color="#3C3C3C"/>

            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBorder" Color="#136C5E"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBackground" Color="#193D37"></SolidColorBrush>

            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Border" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Border" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Foreground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Border" Color="#238F7E"/>
            <SolidColorBrush x:Key="ListBoxItem.Normal.Border" Color="#193D37"/>

            <SolidColorBrush x:Key="MainFormBackground" Color="#141414"/>
            <SolidColorBrush x:Key="LostFocusBorderBrush" Color="#282828"/>
            <SolidColorBrush x:Key="GetFocusBorderBrush" Color="#8F9598"/>

        </ResourceDictionary>
    </bondComp:WindowBase.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
       
        <TextBlock  Text="组合名称:" Grid.Row="1" Grid.Column="0" FontSize="14" HorizontalAlignment="Right" Margin="10,0,5,0" VerticalAlignment="Center"   Foreground="{StaticResource QuotationList.SubTitle.Foreground}"></TextBlock>
        <!--<local:MultiSelectComboBox x:Name="comBookId" Grid.Column="1" Grid.Row="1" DefaultText="ALL" Width="120" HorizontalAlignment="Left"
                                                   SelectedValues="{Binding SelectBook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="22" Background="Black">
        </local:MultiSelectComboBox>-->
        <!--<ComboBox x:Name="comBookId"  Style="{StaticResource ComboBoxStyle}" Grid.Column="1" Grid.Row="1"
                 SelectedValuePath="Key" DisplayMemberPath="Value"  
            Margin="6,0,0,0" HorizontalAlignment="Left" SelectedValue="{Binding SelectBook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center"   Height="24" Width="160">
        </ComboBox>-->
        <ComboBox x:Name="comBookId"  Style="{StaticResource ComboBoxStyle}" Grid.Column="1" Grid.Row="1"
                 SelectedValuePath="Key" DisplayMemberPath="Value"  
            Margin="6,0,0,0" HorizontalAlignment="Left"
                              VerticalAlignment="Center" SelectedIndex="0"   Height="24" Width="150" >
        </ComboBox>


        <Border Grid.ColumnSpan="2" Grid.Row="2" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GraySlateButtonStyle}"  BorderThickness="0,1,0,0"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource BlueGreenStyle}"  BorderThickness="0,1,0,0"
                        Click="btnOK_Click" >确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</bondComp:WindowBase>
