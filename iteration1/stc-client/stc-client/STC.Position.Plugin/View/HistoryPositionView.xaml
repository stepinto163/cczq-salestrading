<UserControl x:Class="STC.Position.Plugin.View.HistoryPositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Position.Plugin.View"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <!--字体-->
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <FontFamily x:Key="Font.MicrosoftYaHei">Microsoft YaHei</FontFamily>
            <FontFamily x:Key="Font.MicrosoftYaHei.Bold">MicrosoftYaHei-Bold</FontFamily>
            <FontFamily x:Key="Font.MicrosoftYaHeiSemibold">MicrosoftYaHeiSemibold</FontFamily>
            <!--字体大小-->
            <SolidColorBrush x:Key="BorderBrush" Color="#282828"></SolidColorBrush>
            <SolidColorBrush x:Key="GridBackGround" Color="#0A0F0E"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockForeColor" Color="#FFFFFF"></SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ColorBrush.Orange6" Color="#FF963D"></SolidColorBrush>
            <SolidColorBrush x:Key="ColorBrush.Blue8" Color="#009AFF"></SolidColorBrush>

            <!--红色样式-->
            <Style x:Key="RedButtonStyle" TargetType="{x:Type Button}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="{StaticResource RedButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RedButton.Static.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource RedButton.Static.Foreground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource RedButton.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource RedButton.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Pressed.Border}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource RedButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource RedButton.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <!-- 居中 -->
            <Style x:Key="MMDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderCenterStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="MMDataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderRightStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="MMDataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>


            <Style x:Key="SumColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="#F9C152" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="SumColorEmptyStyleAlignmentLeft" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Margin" Value="4 0 0 0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="BidLongColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrShortColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue8}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BookListColumnStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="#FFFFFF "/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                        <Setter Property="Foreground" Value="#00CDAD" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MainListTitleBackgroup.ColorBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyleNetAvgPrice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleNetAvgYield" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>

                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleLastNetprice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleLastPrice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="SelfCheckBoxStyle" TargetType="{x:Type CheckBox}">
                <Style.Resources>
                    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="Transparent"/>
                    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#136C5E"/>
                    <Style x:Key="OptionMarkFocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="14,0,0,0" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="#FF9200"/>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="#FF5593FF"/>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="#FF212121"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Background" Color="#FFE6E6E6"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Border" Color="#FFBCBCBC"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Glyph" Color="#FF707070"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="Transparent"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="#FF3C77DD"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="#FF212121"/>
                    <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="#FF212121"/>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="checkBoxBorder" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,3,1,3" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid x:Name="markGrid">
                                        <Path x:Name="optionMark"  Data="M0.1,6 3.2,7.5 7.5,2 7.0,0.2 3.2,5.2 1,4 0.2,4 z" Fill="#FFFFFF" Opacity="0" Stretch="None"/>
                                        <Rectangle x:Name="indeterminateMark" Fill="{StaticResource OptionMark.Static.Glyph}" Margin="2" Opacity="0"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasContent" Value="true">
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource OptionMarkFocusVisual}"/>
                                    <Setter Property="Padding" Value="4,1,0,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="#1E1E1E"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="#3C3C3C"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.Disabled.Glyph}"/>
                                    <Setter Property="Opacity" TargetName="templateRoot" Value="0.4"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.Pressed.Glyph}"/>
                                    <!--<Setter Property="Fill" TargetName="contentPresenter" Value="{StaticResource OptionMark.Pressed.Glyph}"/>-->
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="0"/>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="#136C5E"></Setter>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="#136C5E"></Setter>
                                    <!--<Setter Property="BorderThickness" TargetName="checkBoxBorder" Value="0"/>-->
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="0"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GridSplitterPreviewStyle">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Fill="#80000000"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <Rectangle Width="12" Height="1" Stroke="{StaticResource DefaultForegroup.ColorBrush}" Margin="0,2,0,2"/>
                                    <Rectangle Width="12" Height="1" Stroke="{StaticResource DefaultForegroup.ColorBrush}" Margin="0,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!--绿色样式-->
            <Style x:Key="SplitButtonStyle" TargetType="{x:Type Button}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="#136C5E"/>
                <!--<Setter Property="BorderBrush" Value="#00D198"/>-->
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderThickness" Value="0, 0, 0, 0"/>
                <!--<Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="80"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#146C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#2CAB97"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#1C4B43"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Pressed.Border}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource RedButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource RedButton.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--DefaultDataGrid 样式-->
            <Style x:Key="QueryDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="DefaultDataGridForQuery" TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGrid}">
                <Setter Property="RowStyle" Value="{DynamicResource QueryDataGridRowStyle}"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0" BorderBrush="{Binding BorderBrush}" x:Name="Border_Right" BorderThickness="1,1,1,1">
            <Grid x:Name="gridMain">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"></RowDefinition>
                    <RowDefinition Height="52*"></RowDefinition>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"></RowDefinition>
                    <RowDefinition Height="50*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="84"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0"  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <comp:SearchTextBox FontSize="12" Height="22" Width="164" Margin="4,2,0,0" IsFuzzy="True"
                                        SearchText="{Binding SecurityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#0B0C0C" Background="Transparent"/>

                            <DatePicker x:Name="dpFrom" Width="120px" Height="24" Margin="10,0,0,0" SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center"></DatePicker>
                            <TextBlock  Text="-" Margin="5,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"></TextBlock>
                            <DatePicker x:Name="dpTo" Width="120" Height="24" Style="{StaticResource DefaultDatePickerStyle}" SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  VerticalContentAlignment="Center"></DatePicker>

                            <TextBlock  Text="组合:" Margin="10,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"></TextBlock>
                            <!--<local:MultiSelectComboBox x:Name="comBookId" DefaultText="All" Width="120"
                                                    SelectedValues="{Binding SelectBook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="22" Background="Black">
                            </local:MultiSelectComboBox>-->

                            <comp:MultiTreeComboBox  Grid.Column="1" Width="200" Height="26"  Margin="10 0 0 0"  Name="TreeView_NodeList"
                                        VerticalAlignment="Center" TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" Foreground="White"
                                        TreeItemsSource="{Binding MultiTreeComboxItemsSource}" IsEnableMultiSelect="True" IsEnableSelectRootNode="True" DefaultText="ALL"   SelectedItemChanged ="TreeView_NodeList_SelectedItemChanged"
                                        >
                                <comp:MultiTreeComboBox.TreeItemItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                        <StackPanel Orientation="Horizontal" Height="24">
                                            <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}"/>
                                            <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Checked}" Value="1">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </comp:MultiTreeComboBox.TreeItemItemTemplate>
                            </comp:MultiTreeComboBox>

                            <!--<TextBlock  Text="{Binding SecurityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"></TextBlock>-->
                        </StackPanel>

                        <!--<StackPanel  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="btnManualInput" Margin="0,0,4,0" Style="{StaticResource RedButtonStyle}" FontFamily="Microsoft YaHei"  FontSize="12" Padding="0,-1,0,0" Command="{Binding ManualInputCommand}" Width="80" Height="16" Content="成交录入"></Button>
                        </StackPanel>-->

                    </Grid>
                </Border>
                <!--历史持仓Main-->
                <comp:ExDataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="HistoryMainPosition_newdg" ItemsSource="{Binding Mv.View, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{DynamicResource DefaultDataGridForQuery}" LoadingRow="dgDetail_LoadingRow" RowHeaderWidth="0"  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                    VirtualizingStackPanel.VirtualizationMode="Standard"
                                    VirtualizingStackPanel.IsVirtualizing="True" SelectedItem="{Binding SelectedPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Sorting="dgDetail_Sorting" MouseDoubleClick="Orders_dataGrid_MouseDoubleClick">
                    
                    <DataGrid.Columns>
                        <DataGridTemplateColumn  Width="60" Header="序号" MinWidth="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn  Header="代码" Width="Auto" MinWidth="85" SortMemberPath="securityid" ClipboardContentBinding="{Binding securityid}">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding securityid}" Margin="4 0 0 0" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding securityid}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn  Header="简称" Width="Auto" MinWidth="90" SortMemberPath="symbol" ClipboardContentBinding="{Binding symbol}">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="4 0 0 0"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding symbol}" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding symbol}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="方向" Width="Auto" MinWidth="40"  HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding side}" Margin="4 0 0 0" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding side}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="持仓日期" Width="Auto" MinWidth="74" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                    <Setter Property="TextBlock.FontWeight" Value="Normal"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding traderdate}" Margin="4 0 0 0" TextTrimming="CharacterEllipsis"  FontWeight="Normal"  ToolTip="{Binding traderdate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="起息日"  Binding="{Binding settlDate}" Width="Auto" MinWidth="74"  CellStyle="{StaticResource SumColorEmptyStyleAlignmentLeft}" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>
                        <DataGridTextColumn Header="总净持仓"  Binding="{Binding netposition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                        <DataGridTemplateColumn Header="均价(净)" Width="Auto" MinWidth="80" CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtNetavgprice" Text="{Binding netavgprice,StringFormat={}{0:N4}}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding netavgprice}" Value="0">
                                            <Setter TargetName="txtNetavgprice" Property="Text" Value="--"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding netavgprice}" Value="0.0">
                                            <Setter TargetName="txtNetavgprice" Property="Text" Value="--"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="均价(%)" Width="Auto" MinWidth="80" CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="txtNetavgyield" Text="{Binding netavgyield,StringFormat={}{0:N4}}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding netavgyield}" Value="0">
                                            <Setter TargetName="txtNetavgyield" Property="Text" Value="--"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding netavgyield}" Value="0.0">
                                            <Setter TargetName="txtNetavgyield" Property="Text" Value="--"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="结算价" Width="Auto" MinWidth="80" CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="netprice" Text="{Binding netprice,StringFormat={}{0:N4}}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding netprice}" Value="0">
                                            <Setter TargetName="netprice" Property="Text" Value="--"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding netprice}" Value="0.0">
                                            <Setter TargetName="netprice" Property="Text" Value="--"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="日初头寸"  Binding="{Binding initialPosition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="100"  CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="今日多仓"  Binding="{Binding todaylongposition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="100" CellStyle="{StaticResource BidLongColorEmptyStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="今日空仓"  Binding="{Binding todayshortposition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="100" CellStyle="{StaticResource OfrShortColorEmptyStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="今日净持仓"  Binding="{Binding dailyNetPosition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="100"  CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                        <DataGridTextColumn Header="当日盈亏(元)" Binding="{Binding totalprofitandloss,StringFormat={}{0:N2}}" Width="Auto" MinWidth="120" CellStyle="{StaticResource SumColorStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>

                        <!--<DataGridTextColumn Header="Key" Binding="{Binding key}"  Width="Auto"  CellStyle="{StaticResource SumColorStyle}"/>-->
                        <DataGridTextColumn Header="组合" Binding="{Binding bookname}" Width="Auto" MinWidth="90" CanUserSort="True" CellStyle="{StaticResource SumColorEmptyStyleAlignmentLeft}" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>
                        <DataGridTextColumn Header="最后更新时间" Binding="{Binding updatetime}" Width="Auto" MinWidth="100" CellStyle="{StaticResource SumColorEmptyStyleAlignmentLeft}" Foreground="#A0A0A0" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>
                        <!--<DataGridTextColumn Header="Key" Binding="{Binding key}"  Width="Auto"  CellStyle="{StaticResource SumColorStyle}"/>-->
                    </DataGrid.Columns>
                </comp:ExDataGrid>
                <comp:PageControl x:Name="pageControl" Grid.Row="2" HorizontalAlignment="Right" 
                                   PageChanged="pageControl_PageChanged" 
                                   Visibility="{Binding PageVisible,Converter={StaticResource visibilityConvertor}}"/>
                <fUI:LoadingMask x:Name="positionMainMask" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="2" ></fUI:LoadingMask>
                <!--历史持仓明细收缩按钮-->
                <!--Button x:Name="btnHor" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Width="40" Height="6" Content="∨" Padding="0, -3, 0, 0" FontSize="9" Style="{StaticResource SplitButtonStyle}"
                Margin="0, 1, 0, 1" Panel.ZIndex="1" Click="btnHor_Click"></Button-->
                <GridSplitter x:Name="gridSplitter" Grid.Row="3" Background="{DynamicResource MainBackgroup.ColorBrush}" Style="{StaticResource VGridSplitterStyle2}"/>
                
                <!--历史持仓Main-->
                <local:HistoryPositionOrderDetail Grid.Row="4" x:Name="UC_Hpod"/>
            </Grid>
            
        </Border>
    </Grid>
</UserControl>
