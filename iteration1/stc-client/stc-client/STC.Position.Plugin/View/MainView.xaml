<UserControl x:Class="STC.Position.Plugin.View.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Position.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common" Initialized="UserControl_Initialized" Loaded="UserControl_Loaded"
             xmlns:commonmodel="clr-namespace:STC.Common.Model.Admin;assembly=STC.Common"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            
            <Style x:Key="SelfTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="SumColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="#F9C152" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="SumColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="SumColorEmptyStyleAlignmentLeft" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Margin" Value="4 0 0 0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="QHSumColorEmptyStyleAlignmentLeft" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Margin" Value="4 0 0 0"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="BidLongColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange6}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrShortColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue8}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BookListColumnStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="#FFFFFF "/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                        <Setter Property="Foreground" Value="#00CDAD" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MainListTitleBackgroup.ColorBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyleNetAvgPrice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleNetAvgYield" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleLastNetprice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleLastPrice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DefaultContextMenu" TargetType="{x:Type ContextMenu}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border x:Name="Border"
                         Background="#282828"
                         BorderThickness="1">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#FF6E6D6D" />
                                </Border.BorderBrush>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasDropShadow"
                                Value="true">
                                    <Setter TargetName="Border"
                                Property="Padding"
                                Value="0,3,0,3" />
                                    <Setter TargetName="Border"
                                Property="CornerRadius"
                                Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DefaultMenuItem" TargetType="MenuItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid ToolTip="{TemplateBinding Header}" Height="30" Background="Transparent" Width="{TemplateBinding Width}">
                                <Grid.ColumnDefinitions>
                                    <!--<ColumnDefinition Width="30" />-->
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="Transparent"/>
                                <Border x:Name="_border"   Grid.ColumnSpan="2"/>
                                <!--<Image x:Name="_imgicon" Width="12" Height="12" Stretch="Uniform" Source="{Binding Icon,RelativeSource={RelativeSource TemplatedParent}}" />-->
                                <TextBlock Foreground="#FFFFFF" Grid.Column="1" Margin="5 0 15 0" TextAlignment="Center"  VerticalAlignment="Center" x:Name="_txt" Text="{Binding Header,RelativeSource={RelativeSource TemplatedParent}}" />
                                <Path  Visibility="Collapsed" x:Name="_path" Grid.Column="1" HorizontalAlignment="Right"  Margin="5 13 5 0"   Data="M0,4 4,0 0,-4 z" Fill="#7E8A92"/>
                                <Popup  Placement="Right" x:Name="SubMenuPopup" AllowsTransparency="True"   Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" >
                                    <ScrollViewer   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <Border Background="Transparent" Name="SubmenuBorder" BorderBrush="LightGray" BorderThickness="1"  SnapsToDevicePixels="True"    >
                                            <StackPanel   IsItemsHost="True"   KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </ScrollViewer>
                                </Popup>

                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="true">
                                    <Setter TargetName="_path" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="_border" Property="Background" Value="#1E1E1E"/>
                                    <Setter TargetName="_txt" Property="Foreground" Value="White"/>
                                    <Setter TargetName="_path" Property="Fill" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="_txt" Property="Foreground" Value="Gray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--默认不展开-->
            <Style x:Key="SelfGreenBlueTreeViewItemStyle" TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource GreenBlueTreeViewItemStyle}">
                <Setter Property="IsExpanded" Value="True"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="mainPositionGrid"  Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="2" BorderBrush="{Binding BorderBrush}"   BorderThickness="1,1,1,1" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="288"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="280"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!--MainTab-->
                <TabControl x:Name="MainTab" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" Background="{DynamicResource MainTitleBackgroup.ColorBrush}" Style="{DynamicResource TabControlStyle1}" SelectedIndex="{Binding SelectedPageIndex,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TabItem  Header="持仓列表" Width="96"  Height="24"  Style="{DynamicResource TabItemStyle_Button}">
                        <Grid  Background="{DynamicResource MainBackgroup.ColorBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" MinWidth="170" BorderBrush="{Binding BorderBrush}"  x:Name="Border_Left" BorderThickness="1,1,0,1" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
                                <commComp:MultiSelectTreeViewControl Name="TreeView_NodeList" HorizontalAlignment="Left"  VerticalContentAlignment="Top"
                                            BorderThickness="0"  Margin="4,0,0,10" Foreground="White" Background="{DynamicResource MainTitleBackgroup.ColorBrush}"
                                            TreeItemStyle="{DynamicResource SelfGreenBlueTreeViewItemStyle}" IsEnableSelectRootNode="True" 
                                            TreeItemsSource="{Binding MultiTreeComboxItemsSource}" SelectedItemChanged ="TreeView_NodeList_SelectedItemChanged">

                                    <commComp:MultiSelectTreeViewControl.TreeItemItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                            <StackPanel Orientation="Horizontal" Height="24">
                                                <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}"/>
                                                <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Checked}" Value="1">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </commComp:MultiSelectTreeViewControl.TreeItemItemTemplate>
                                </commComp:MultiSelectTreeViewControl>
                            </Border>

                            <GridSplitter x:Name="gridSplitter" MinWidth="7" Grid.Column="1"  Background="{DynamicResource MainBackgroup.ColorBrush}" Style="{DynamicResource VGridSplitterStyle2}"/>

                            <!--持仓列表-->
                            <!--风险敞口-->
                            <Border  Grid.Column="2" BorderBrush="{Binding BorderBrush}" Background="{DynamicResource MainBackgroup.ColorBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0"  Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding RiskExposureTagVisible}">
                                        <Button Content="持仓明细" Width="100" Height="24" Margin="0 0 0 0" Style="{DynamicResource  BlueGreenOrangeGraySlateButtonStyle}" Foreground="{DynamicResource DefaultGridForground}" Tag="{Binding PositionDetailTag, Mode =TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0 1 0 0" Command="{Binding PositionDetailCommand}"/>
                                        <Button Content="风险敞口" Width="100" Height="24" Margin="4 0 0 0" Style="{DynamicResource  BlueGreenOrangeGraySlateButtonStyle}"  Foreground="{DynamicResource DefaultGridForground}" Tag="{Binding RiskExposureTag, Mode =TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0 1 0 0" Command="{Binding RiskExposureCommand}"/>
                                    </StackPanel>

                                    <TabControl x:Name="SubMainTab" Grid.Row="1" Grid.Column="0"  BorderBrush="Transparent" Background="{DynamicResource MainBackgroup.ColorBrush}" SelectedIndex="{Binding SubSelectedPageIndex,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TabItem Header="持仓明细" Style="{DynamicResource TabItemStyle1}" Height="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="52"/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <DataGrid x:Name="dgNewPositionTotal" ItemsSource="{Binding FullPositionTotal, UpdateSourceTrigger=PropertyChanged}"
                                                        Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}"  Background="{DynamicResource DefaultBackgroup.ColorBrush}"
                                                        SelectionMode="Single"  FrozenColumnCount="2"
                                                        Sorting="dgDetail_Sorting" 
                                                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                          Loaded="DataGrid_Loaded"
                                                       >
                                                    <DataGrid.Columns>
                                                        <!--<DataGridTextColumn Header="key"  Binding="{Binding key}" MinWidth="64" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}"/>-->
                                                        <!--DataGridTextColumn Header="Bookid" Binding="{Binding bookid}" Width="Auto" CanUserSort="True" CellStyle="{StaticResource SumColorEmptyStyle}"/-->
                                                        <DataGridTemplateColumn  Header="代码" Width="Auto" MinWidth="85" CanUserSort="False" ClipboardContentBinding="{Binding securityid}">
                                                            <DataGridTemplateColumn.CellStyle>
                                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                                                    <Setter Property="Foreground" Value="#C29B4E"/>
                                                                    <EventSetter Event="MouseDoubleClick" Handler="dgPositionDetail_DataGridCell_MouseDoubleClick"/>
                                                                </Style>
                                                            </DataGridTemplateColumn.CellStyle>
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding securityid}" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding securityid}"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTemplateColumn  Header="简称" Width="Auto" MinWidth="90" SortMemberPath="symbol" ClipboardContentBinding="{Binding symbol}">
                                                            <DataGridTemplateColumn.CellStyle>
                                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                                                    <Setter Property="Foreground" Value="#C29B4E"/>
                                                                    <EventSetter Event="MouseDoubleClick" Handler="dgPositionDetail_DataGridCell_MouseDoubleClick"/>
                                                                </Style>
                                                            </DataGridTemplateColumn.CellStyle>
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding symbol}" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding symbol}"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>


                                                        <DataGridTextColumn Header="清算速度"  Visibility="Visible" Binding="{Binding settlType}" Width="Auto" MinWidth="64"  CanUserSort="False" CellStyle="{StaticResource QHSumColorEmptyStyleAlignmentLeft}" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>
                                                        <DataGridTextColumn Header="起息日"  Binding="{Binding settlDate}" Width="Auto" MinWidth="74" CellStyle="{StaticResource SumColorEmptyStyleAlignmentLeft}" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>
                                                        <DataGridTextColumn Header="总净持仓"  Binding="{Binding netposition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="64" CanUserSort="False" CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                                                        <DataGridTemplateColumn Header="均价(净)"  Visibility="Visible"  Width="Auto"  MinWidth="80" CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" CanUserSort="False" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock x:Name="txtNetavgprice" Text="{Binding netavgprice,StringFormat={}{0:N4}}"/>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding netavgprice}" Value="0">
                                                                            <Setter TargetName="txtNetavgprice" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding netavgprice}" Value="0.0">
                                                                            <Setter TargetName="txtNetavgprice" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTemplateColumn Header="均价(%)"   Visibility="Visible"  Width="Auto" MinWidth="80" CellStyle="{StaticResource SumMoneyEmptyStyleNetAvgPrice}" CanUserSort="False" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock x:Name="txtNetavgyield" Text="{Binding netavgyield,StringFormat={}{0:N4}}"/>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding netavgyield}" Value="0">
                                                                            <Setter TargetName="txtNetavgyield" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding netavgyield}" Value="0.0">
                                                                            <Setter TargetName="txtNetavgyield" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTemplateColumn Header="最新价(净)"   Visibility="Visible"  Width="Auto" MinWidth="80" CellStyle="{StaticResource SumMoneyEmptyStyleLastNetprice}" CanUserSort="False" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock x:Name="txtLastnetprice" Text="{Binding lastnetprice,StringFormat={}{0:N4}}"/>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding lastnetprice}" Value="0">
                                                                            <Setter TargetName="txtLastnetprice" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding lastnetprice}" Value="0.0">
                                                                            <Setter TargetName="txtLastnetprice" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="最新价(%)"    Visibility="Visible" Width="Auto" MinWidth="80" CellStyle="{StaticResource SumMoneyEmptyStyleLastPrice}" CanUserSort="False" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock x:Name="txtLastprice" Text="{Binding lastprice,StringFormat={}{0:N4}}"/>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding lastprice}" Value="0">
                                                                            <Setter TargetName="txtLastprice" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding lastprice}" Value="0.0">
                                                                            <Setter TargetName="txtLastprice" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTextColumn Header="总持仓量(多)"   Visibility="Visible"   Binding="{Binding longposition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="100" CanUserSort="False" CellStyle="{StaticResource BidLongColorEmptyStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                                                        <DataGridTemplateColumn Header="均价(多)"    Visibility="Visible" Width="Auto" MinWidth="100" CellStyle="{StaticResource BidLongColorEmptyStyle}" CanUserSort="False" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock x:Name="txtYtdSettlementPrice" Text="{Binding longavgprice,StringFormat={}{0:N4}}"/>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding longavgprice}" Value="0">
                                                                            <Setter TargetName="txtYtdSettlementPrice" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding longavgprice}" Value="0.0">
                                                                            <Setter TargetName="txtYtdSettlementPrice" Property="Text" Value="--"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
