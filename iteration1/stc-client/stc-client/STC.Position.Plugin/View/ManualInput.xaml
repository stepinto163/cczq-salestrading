                                                         Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F"
                                                         PreviewTextInput="TextBox_PreviewTextInput"
                                                         PreviewKeyDown="TextBox_PreviewKeyDown">
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NetPrice,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
