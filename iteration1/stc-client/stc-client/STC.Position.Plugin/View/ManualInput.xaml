                                                         Height="22" Padding="0,2,0,0"  input:InputMethod.IsInputMethodEnabled="False" 
                                                         Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F"
                                                         PreviewTextInput="TextBox_PreviewTextInput"
                                                         PreviewKeyDown="TextBox_PreviewKeyDown">
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!--<DataTrigger Binding="{Binding MarketIndicator}" Value="5">
                                                <Setter Property="IsEnabled"  TargetName="txtPrice" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MarketIndicator}" Value="4">
                                                <Setter Property="IsEnabled"  TargetName="txtPrice" Value="True" />
                                            </DataTrigger>-->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Price,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="txtPrice" Property="BorderBrush" Value="red"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

