                                                </TextBlock>
                                                <TextBox x:Name="txtCounterPartyName" Height="22" Padding="0,2,0,0"  Visibility="{Binding EditBtnVisible,Converter={StaticResource visibilityConvertor}}" Text="{Binding CounterPartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F"
                                                          IsEnabled="{Binding CounterPartyNameEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                        <!--<DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding MarketIndicator}" Value="5">
                                                <Setter Property="IsEnabled"  TargetName="txtCounterPartyName" Value="False" />
