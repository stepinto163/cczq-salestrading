                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <TextBlock VerticalAlignment="Center" Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}"  Text="{Binding Path=CounterPartySubName}">
                                                </TextBlock>
                                                <TextBox x:Name="txtCounterPartySubName" Height="22" Padding="0,2,0,0"  Visibility="{Binding EditBtnVisible,Converter={StaticResource visibilityConvertor}}" Text="{Binding CounterPartySubName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F">
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                        <!--<DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding MarketIndicator}" Value="5">
                                                <Setter Property="IsEnabled"  TargetName="txtCounterPartySubName" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MarketIndicator}" Value="4">
                                                <Setter Property="IsEnabled"  TargetName="txtCounterPartySubName" Value="True" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>-->
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn  Width="92" Header="组合" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <TextBlock VerticalAlignment="Center" Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}"
                                                      Text="{Binding Path=BookName}">
                                                </TextBlock>
                                                <comp:MultiTreeComboBox  Visibility="{Binding EditBtnVisible,Converter={StaticResource visibilityConvertor}}"
                                                                         Grid.Column="1" Width="80" Height="24"  Margin="0 0 0 0"
                                                                         VerticalAlignment="Center" TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" Foreground="White"
                                                                         TreeItemsSource="{x:Static ViewModel:ManualInputViewModel.MultiTreeComboxItemsSource}" IsEnableMultiSelect="False"  
                                                                         SelectedItem="{Binding BookId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         SelectedTexts="{Binding BookName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <comp:MultiTreeComboBox.TreeItemItemTemplate>
                                                        <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                                            <StackPanel Orientation="Horizontal" Height="22">
                                                                <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}" Visibility="{Binding IsLeaf, Converter={StaticResource visibilityConvertor}}"/>
                                                                <Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>
                                                                <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Checked}" Value="1">
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                                            </StackPanel>
                                                        </HierarchicalDataTemplate>
                                                    </comp:MultiTreeComboBox.TreeItemItemTemplate>
                                                </comp:MultiTreeComboBox>
                                                <!--<ComboBox x:Name="comBookId" SelectedValue="{Binding BookId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding EditBtnVisible,Converter={StaticResource visibilityConvertor}}" 
                                                          ItemsSource="{x:Static ViewModel:ManualInputViewModel.LstBookList}"  
                                                          Style="{StaticResource DefaultComboBoxStyle}" 
                                                          Width="90" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F"
                                                          Height="22" SelectedValuePath="Key" DisplayMemberPath="Value" >
                                                </ComboBox>-->
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
