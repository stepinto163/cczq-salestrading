                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <TextBlock VerticalAlignment="Center" Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}"  Text="{Binding Path=Remark}"
                                                           ToolTipService.ToolTip="{Binding Path=Remark}">
                                                </TextBlock>
                                                <TextBox  Height="22" Visibility="{Binding EditBtnVisible,Converter={StaticResource visibilityConvertor}}" Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F">
                                                </TextBox>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="40" MinWidth="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsAdded,Converter={StaticResource visibilityConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                        Style="{StaticResource SaveButton}" ToolTip="验证" Visibility="{Binding EditBtnVisible,Converter={StaticResource visibilityConvertor}}" 
                                                        Command="{Binding DataContext.SaveRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                                <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                        Style="{StaticResource EditButton}" ToolTip="修改" Visibility="{Binding SaveBtnVisible,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Border>
        <fUI:LoadingMask x:Name="emsloadMask" Visibility="Collapsed" Grid.Row="1" Grid.ColumnSpan="3"></fUI:LoadingMask>

        <Border Grid.Row="2" BorderThickness="2, 0, 2, 2"   CornerRadius="0,0,4,4" BorderBrush="#A0A0A0" Background="#141414">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"></ColumnDefinition>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="20"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Grid.Row="0" Margin="0,0,0,0"  Content="+"  ToolTip="新增订单" IsEnabled="{Binding IsCanSave,Converter={StaticResource  booleanConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Command="{Binding AddRecordCommand}" FontSize="12" Foreground="{DynamicResource TextBlockForeground}" Style="{DynamicResource RedButtonStyle}"  Width="24" Height="24"/>
                <StackPanel  Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Foreground="#A0A0A0" FontFamily="Microsoft YaHei" FontWeight="SemiBold" FontSize="12">
                        <Run Text="已填写"></Run>
                        <Run Text="{Binding RecordCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                        <Run Text="笔成交"></Run>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="3" Grid.Row="0" Margin="0,0,0,0"  Content="取消" Command="{Binding CancelWindowCommand}" FontSize="12" Foreground="{DynamicResource TextBlockForeground}" Style="{DynamicResource DefaultButtonStyle}"  Width="60" Height="24"/>
                <Button Grid.Column="4" Grid.Row="0" Margin="0,0,0,0" Content="确认"  ToolTip="提交保存" IsEnabled="{Binding IsCanSave,Converter={StaticResource  booleanConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Command="{Binding OkCommand}" FontSize="12" Style="{DynamicResource RedButtonStyle}" Foreground="{DynamicResource TextBlockForeground}" Width="100" Height="24"/>

            </Grid>
        </Border>
    </Grid>
</Window>
