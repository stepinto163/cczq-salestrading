                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding MarketIndicator}" Value="4"/>
                                                    <Condition Binding="{Binding EditBtnVisible}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsEnabled"  TargetName="comSettleType" Value="True" />
                                                <Setter Property="Visibility"  TargetName="comSettleType" Value="Visible" />
                                            </MultiDataTrigger>
