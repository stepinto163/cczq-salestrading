                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <TextBlock VerticalAlignment="Center" Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}"  Text="{Binding Path=TradeDate}">
                                                </TextBlock>
                                                <DatePicker x:Name="datePicker" Grid.Column="1" Width="90" Height="24"
                                                            SelectedDate="{Binding TradeDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                            DisplayDateStart="{Binding CurrentDate,Mode=TwoWay}"
