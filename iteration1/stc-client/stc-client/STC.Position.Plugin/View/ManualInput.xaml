                                                          ItemsSource="{x:Static ViewModel:ManualInputViewModel.LstVenuetypegw}"
                                                          Style="{StaticResource DefaultComboBoxStyle}"
                                                          Width="60" 
                                                          Foreground="{StaticResource DefaultForegroup.ColorBrush}" 
                                                          Background="#0F0F0F"
                                                          SelectedValuePath="Key"
