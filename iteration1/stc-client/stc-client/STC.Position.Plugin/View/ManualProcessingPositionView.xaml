<Window x:Class="STC.Position.Plugin.View.ManualProcessingPositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Position.Plugin.View"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:ViewModel="clr-namespace:STC.Position.Plugin.ViewModel" 
             mc:Ignorable="d" 
             Title="跨日结转"  ResizeMode="NoResize" AllowsTransparency ="True"
             WindowState="Normal" WindowStartupLocation="CenterScreen" WindowStyle="None" Topmost="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"  BorderThickness="0" Background="Transparent"  BorderBrush="Transparent"
             Width="460" Height="224">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>


            <Style x:Key="SelfCalendarDayButtonStyle" TargetType="{x:Type CalendarDayButton}">
                <Setter Property="MinWidth" Value="5"/>
                <Setter Property="MinHeight" Value="5"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.1"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="0.5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="0.5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                                <DoubleAnimation Duration="0" To=".35" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="NormalText"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Unselected"/>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To=".75" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="SelectedBackground"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="CalendarButtonFocused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="DayButtonFocusVisual">
                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                        <DiscreteObjectKeyFrame.Value>
                                                            <Visibility>Visible</Visibility>
                                                        </DiscreteObjectKeyFrame.Value>
                                                    </DiscreteObjectKeyFrame>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CalendarButtonUnfocused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="DayButtonFocusVisual">
                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                        <DiscreteObjectKeyFrame.Value>
                                                            <Visibility>Collapsed</Visibility>
                                                        </DiscreteObjectKeyFrame.Value>
                                                    </DiscreteObjectKeyFrame>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ActiveStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Active"/>
                                        <VisualState x:Name="Inactive">
                                            <Storyboard>
                                                <ColorAnimation Duration="0" To="#FF777777" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="NormalText"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DayStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="RegularDay"/>
                                        <VisualState x:Name="Today">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="TodayBackground"/>
                                                <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="NormalText"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="BlackoutDayStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="NormalDay">
                                        </VisualState>
                                        <VisualState x:Name="BlackoutDay">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To=".5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Blackout"/>
                                                <DoubleAnimation Duration="0" To=".4" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="NormalText"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Rectangle x:Name="TodayBackground" Fill="#193D37" Opacity="0" RadiusY="1" RadiusX="1"/>
                                <Rectangle x:Name="SelectedBackground" Fill="Transparent" Opacity="0" RadiusY="1" RadiusX="1"/>
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"/>
                                <Rectangle x:Name="HighlightBackground" Fill="Black" Opacity="0" RadiusY="1" RadiusX="1"/>
                                <ContentPresenter x:Name="NormalText" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="5,1,5,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Path x:Name="Blackout" Data="M6.49241251,5.53100139 L10.8558668,1.15050666 C10.9932898,1.02444399 11.0620028,0.867048874 11.0620028,0.678321323 C11.0620028,0.489593772 10.9962215,0.329266969 10.8646619,0.197340914 C10.7331023,0.0654148584 10.5727755,-0.000364938572 10.3836814,0 C10.1945874,0.000367983957 10.0371923,0.069079471 9.91149611,0.206135984 L5.53100139,4.56959026 L1.15050666,0.206135984 C1.02444399,0.0687130098 0.867048874,0 0.678321323,0 C0.489593772,0 0.329266969,0.0657813196 0.197340914,0.197340914 C0.0654148584,0.328900507 -0.000364938572,0.489227311 0,0.678321323 C0.000367983957,0.867415335 0.069079471,1.02481045 0.206135984,1.15050666 L4.56959026,5.53100139 L0.206135984,9.91149611 C0.0687130098,10.0375588 0,10.1949539 0,10.3836814 C0,10.572409 0.0657813196,10.7327358 0.197340914,10.8646619 C0.328900507,10.9965879 0.489227311,11.0623677 0.678321323,11.0620028 C0.867415335,11.0616348 1.02481045,10.9929233 1.15050666,10.8558668 L5.53100139,6.47537206 L9.91149611,10.8558668 C10.0375588,10.9932898 10.1949539,11.0620028 10.3836814,11.0620028 C10.572409,11.0620028 10.7327358,10.9962215 10.8646619,10.8646619 C10.9965879,10.7331023 11.0623677,10.5727755 11.0620028,10.3836814 C11.0616348,10.1945874 10.9929233,10.0371923 10.8558668,9.91149611 L6.49241251,5.53100139 Z" Fill="LightGray" HorizontalAlignment="Stretch" Margin="3" Opacity="0" RenderTransformOrigin="0.5,0.5" Stretch="Fill" Height="10" Width="10" VerticalAlignment="Stretch"/>
                                <Rectangle x:Name="DayButtonFocusVisual" IsHitTestVisible="false" RadiusY="1" RadiusX="1" Stroke="#FF45D6FA" Visibility="Collapsed"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SelfDefaultCalendarStyle" TargetType="{x:Type Calendar}" BasedOn="{StaticResource DefaultCalendarStyle}">
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource SelfCalendarDayButtonStyle}"/>
            </Style>
            
            <Style x:Key="SelfDatePickerStyle" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource DefaultDatePickerStyle}">
                <Setter Property="CalendarStyle" Value="{StaticResource SelfDefaultCalendarStyle}"/>
            </Style>
            
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="48"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border BorderThickness="2,2,2,0"  Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="#A0A0A0"  Background="{StaticResource LostFocusBorderBrush}">
            <Grid  Background="{StaticResource LostFocusBorderBrush}" Margin="2,0,2,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleIcon"  Grid.Column="0"  Width="32" Stretch="Uniform" HorizontalAlignment="Center"></Image>
                <TextBlock Text="跨日结转" Grid.Column="1" Margin="0, 1, 0, 0" Foreground = "#FFFFFF" FontFamily="MicroSoft YaHei" FontWeight="SemiBold" FontSize="14"/>
                <Button Grid.Column="3" Height="24" Width="24"  Command="{Binding CloseWindowCommand}" IsCancel="True" Style="{DynamicResource  DrpImageCloseButton}" />
            </Grid>
        </Border>
        
        <!--主操作区-->
        <Border BorderThickness="2,0,2,0" Grid.Row="1" CornerRadius="0,0,0,0" BorderBrush="#A0A0A0" Background="#141414">
            <Grid>
                <Border BorderThickness="1" Margin="10 10 10 0" BorderBrush="#3C3C3C" Background="#141414">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0"></ColumnDefinition>
                            <ColumnDefinition Width="140"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="0"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="开始日期：" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="{DynamicResource TextBlockDefaultDisableForeground}" FontSize="12" />
                        
                        <!--本次结转-->
                        <TextBlock Text="本次结转：" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"  Foreground="{DynamicResource TextBlockDefaultDisableForeground}" FontSize="12" />
                        <TextBlock Grid.Row="1"  Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="4" MaxWidth="240" Text="{Binding StatusCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='ManualProcessingPositionStatus'}" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" HorizontalAlignment="Left" VerticalAlignment="Top"  Foreground="#E63034" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0 -2 0 0">
                        </TextBlock>
                        <!--最后状态-->
                        <TextBlock Text="上一次结转：" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"  Foreground="{DynamicResource TextBlockDefaultDisableForeground}" FontSize="12" />
                        <TextBlock Grid.Row="2"  Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="4" x:Name="txtStatusMsg" MaxWidth="240" Text="{Binding LastStatusCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='ManualProcessingPositionStatus'}" 
                                   ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" HorizontalAlignment="Left" VerticalAlignment="Top"  Foreground="#E63034" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="Wrap">
                        </TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" MaxWidth="330" Margin="80 0 0 0" Text="{Binding LastStatusMsg}" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                   ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" Foreground="{DynamicResource TextBlockDefaultDisableForeground}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                        
                        <!--重新跑批开始日期 -->
                        <DatePicker x:Name="dpFrom" Grid.Row="0" Grid.Column="2" Style="{DynamicResource SelfDatePickerStyle}"  Grid.ColumnSpan="2" Width="128px" Height="24" Margin="0,0,0,0"  
                                    SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                    ></DatePicker>

                        <!--<DatePicker x:Name="datePicker" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top"  Width="98"/>
                        <Calendar x:Name="holidayCalendar" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionMode="MultipleRange" Margin="0 0 0 0 " Width="300" Style="{StaticResource {x:Type Calendar}}">
                            <Calendar.CalendarDayButtonStyle>
                                <Style TargetType="CalendarDayButton" BasedOn="{StaticResource SelfCalendarDayButtonStyle}"/>
                            </Calendar.CalendarDayButtonStyle>
                        </Calendar>-->

                        <!-- Grid.Row="1" Grid.Column="3" Content="强制停止" Width="80" Height="24" Command="{Binding ForceRunCommand}"  IsEnabled="{Binding IsCanRun, Converter={StaticResource  reversebooleanConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="2" FontSize="12" Style="{DynamicResource BlueGreenOrangeGraySlateButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center"/-->
                        
                        <fUI:LoadingMask x:Name="emsloadMask" Visibility="Collapsed" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Background="Transparent" Margin="0 36 0 0"></fUI:LoadingMask>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        
        <!--命令区-->
        <Border Grid.Row="2" BorderThickness="2, 0, 2, 2"   CornerRadius="0,0,4,4" BorderBrush="#A0A0A0" Background="#141414">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Grid.Row="0" Margin="0,0,0,0"  Content="关闭窗口" Command="{Binding CancelCommand}" FontSize="12"  Style="{DynamicResource DefaultButtonStyle}"  Width="80" Height="24"/>
                <Button Grid.Column="2" Grid.Row="0" Margin="0,0,0,0" Content="开始执行" IsEnabled="{Binding IsCanRun, Converter={StaticResource  booleanConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Command="{Binding OkCommand}" FontSize="12" Style="{DynamicResource RedButtonStyle}"  Width="100" Height="24"/>

            </Grid>
        </Border>
    </Grid>
</Window>
