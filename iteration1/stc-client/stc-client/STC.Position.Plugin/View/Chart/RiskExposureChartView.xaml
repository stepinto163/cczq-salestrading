<UserControl x:Class="STC.Position.Plugin.View.Chart.RiskExposureChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Position.Plugin.View.Chart"
             xmlns:oxyplot="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
             xmlns:oxyshared="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf.Shared"
             xmlns:selfconv="clr-namespace:STC.Position.Plugin.Convertor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <selfconv:DataPointDataConverter x:Key="DataPointDataConverterKey"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid  x:Name="gridMain" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="-10 0 -10 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <!--加入模拟交易工具栏-->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 20 0"  Panel.ZIndex="1" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <TextBlock Text="最后刷新时间: "  Foreground="#8F9598" FontStyle="Normal" FontWeight="Medium" FontSize="12" Margin="4 0 0 0"/>
            <TextBlock Text="{Binding LastUpdateTime, Mode= TwoWay, UpdateSourceTrigger=PropertyChanged}"  Foreground="#F9C152" FontStyle="Normal" FontWeight="Medium" FontSize="12" Margin="4 0 0 0"/>
            <!--Button x:Name="RefreshBtn_Best" Margin="4 0 0 0" Style="{DynamicResource RefreshButton_24}" VerticalAlignment="Center" Command="{Binding RefreshCommand}" /-->
        </StackPanel>
        
        <TextBlock Text="元" Grid.Row="1"  Grid.Column="1"  Foreground="#8F9598" FontStyle="Normal" FontWeight="Medium" FontSize="11" Margin="60 -10 0 0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1" Height="24" Width="64"/>
        <oxyplot:PlotView  Grid.Row="1"  Grid.Column="1" x:Name="Plot" Model="{Binding plotModel1}" Margin="0,0,10,10">
                <oxyplot:PlotView.DefaultTrackerTemplate>
                    <ControlTemplate>
                        <oxyshared:TrackerControl Position="{Binding Position}"  Distance="10"  CanCenterVertically="False" CanCenterHorizontally="False"  LineStroke="#FFEBC8" LineDashArray="2" BorderEdgeMode="Unspecified" HorizontalLineVisibility="Visible" VerticalLineVisibility="Visible"  BorderBrush="#308376" Foreground="#FFEBC8"  ShowPointer="True" BorderThickness="1"  CornerRadius="3" LineExtents="{Binding PlotModel.PlotArea}">
                            <oxyshared:TrackerControl.Background>
                                <LinearGradientBrush EndPoint="0,1">
                                    <GradientStop Color="#193D37" />
                                    <GradientStop Offset="1" Color="#193D37"/>
                                </LinearGradientBrush>
                            </oxyshared:TrackerControl.Background>
                            <oxyshared:TrackerControl.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Foreground="#D7D7D7">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource DataPointDataConverterKey}">
                                                <Binding/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </oxyshared:TrackerControl.Content>
                        </oxyshared:TrackerControl>
                    </ControlTemplate>
                </oxyplot:PlotView.DefaultTrackerTemplate>
        </oxyplot:PlotView>
    </Grid>
</UserControl>
