<UserControl x:Class="STC.Position.Plugin.View.RiskExposureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Position.Plugin.View"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:localchart="clr-namespace:STC.Position.Plugin.View.Chart"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:selfconv="clr-namespace:STC.Position.Plugin.Convertor"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="680" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <selfconv:DecimalToSixPlacesConverter x:Key="DecimalToSixPlacesConverter"/>
            <fcon:ReverseBooleanConvertor x:Key="reversebooleanConvertor"/>
            <fcon:VisibilityConvertor x:Key="visiblityConvertor"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="IsNotValid" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding enable}" Value="0">
                        <Setter Property="Foreground" Value="#A0A0A0"/>
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="SelfDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="Padding" Value="5,0,0,0"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid  x:Name="gridMain"  Background="{DynamicResource MainBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="chartGrid"></RowDefinition>
            <RowDefinition Height="2"></RowDefinition>
            <RowDefinition x:Name="DVGrid" Height="Auto" MinHeight="144" MaxHeight="144"></RowDefinition><!--144, 70-->
            <RowDefinition Height="2"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--图表区域-->
        <Border Grid.Row="0" Grid.Column="0" BorderThickness="0" Margin="10 0 10 0">
             <!--画图-->
             <localchart:RiskExposureChartView x:Name="chart"/>
        </Border>

        <GridSplitter x:Name="gridSplitter" Grid.Row="1"  Grid.Column="0" Background="{DynamicResource BackgroundBrush}" Style="{DynamicResource HGridSplitterStyle2}"/>
        
        <!--数据区域-->
        <Border x:Name="DVBorder" Grid.Row="2" Grid.Column="0" BorderThickness="0">
            <DataGrid x:Name="DVdatagrid"  Margin="10 5 20 0"
                        ItemsSource="{Binding Mv.View}"
                        Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}" BorderThickness="0.5" BorderBrush="#282828" 
                        GridLinesVisibility="All" HorizontalGridLinesBrush="#282828" VerticalGridLinesBrush="#282828" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsSynchronizedWithCurrentItem="True" SelectionMode="Extended" SelectionUnit="FullRow">
                    <DataGrid.Columns>

                    <!--DataGridTextColumn Header="bookid"  Binding="{Binding bookid}" Width="64" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}"  Visibility="Visible"/>
                    <DataGridTextColumn Header="key"  Binding="{Binding key}" MinWidth="64" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}" Visibility="Visible"/>
                    <DataGridTextColumn Header="sort"  Binding="{Binding sortkey}" Width="32" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}"  Visibility="Visible"/>

                    <DataGridTemplateColumn  Header="代码" Width="Auto" MinWidth="85" ClipboardContentBinding="{Binding securityid}" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}"  CellStyle="{DynamicResource DataGridTextCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding securityid}" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding securityid}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="量"  Binding="{Binding quantity,StringFormat={}{0:N0}}" Width="Auto" MinWidth="64" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}"/-->

                    <DataGridTextColumn Header="DV01(元)" MinWidth="80" Binding="{Binding DV01}"  CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}"  CellStyle="{DynamicResource DataGridTextCenterStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Foreground"  Value="#D7D7D7"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="总计" Width="1.2*" MinWidth="120" Binding="{Binding TotfyDV01, Converter={StaticResource DecimalToSixPlacesConverter}}" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                    <Setter Property="TextAlignment"  Value="Right"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                            </DataGridTextColumn.ElementStyle>
                        
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="6M" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                <TextBlock x:Name="txt_F6M" Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F6M , Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap"></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="1Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F1Y, Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="2Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F2Y,  Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right"  TextWrapping="Wrap"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="3Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F3Y, Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="5Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F5Y, Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="7Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F7Y,  Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap" ></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="10Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F10Y,  Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap" ></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="15Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F15Y, Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="20Y" Width="*" MinWidth="80" CanUserSort="False" HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F20Y,  Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap" ></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="30Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F30Y,  Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="40Y" Width="*" MinWidth="80" CanUserSort="False"  HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F40Y,  Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="50Y" Width="*" MinWidth="80" CanUserSort="False" HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource DefaultGridForground}" Text="{Binding F50Y,  Converter={StaticResource DecimalToSixPlacesConverter}}" Padding="0" TextAlignment="Right" TextWrapping="Wrap" ></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
        </Border>

        <fUI:LoadingMask x:Name="RealSimLoadingMask" Grid.Row="2" Grid.Column="0" Visibility="{Binding RealSimLoadMaskVisible}"></fUI:LoadingMask>
        
        <!--<GridSplitter x:Name="gridSplitter2" Grid.Row="3" Grid.Column="0" Background="{DynamicResource BackgroundBrush}" Style="{DynamicResource HGridSplitterStyle2}"/>-->

        <!--加入模拟交易-->
        <Border Grid.Row="4" BorderThickness="0" Margin="10 0 10 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!--加入模拟交易工具栏-->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!--<CheckBox Content="加入模拟交易" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Height="12" Foreground="#FFEBC8" FontStyle="Normal" FontWeight="SemiBold" FontSize="12" Background="Transparent" Padding="4,-2,0,0"
                            IsChecked="{Binding ChkJoinSimTrading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    </CheckBox>-->

                    <comp:SearchTextBox FontSize="12" Height="22" Width="164" Margin="0,2,0,0"  HintText="请输入债券代码，简称" AfterSearchBond="SearchTextBox_AfterSearchBond"
                                    SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#0B0C0C" Background="Transparent"/>

                    <!--<Button Content="批量删除" Width="80" Height="24" Margin="10 0 0 0" Style="{DynamicResource  BlueGreenOrangeGraySlateButtonStyle}" IsEnabled="{Binding IsEdit, Converter={StaticResource reversebooleanConvertor}}" Foreground="{DynamicResource DefaultGridForground}" Tag="4"  BorderThickness="0 1 0 0" Command="{Binding ManualBatchDelSimTradingCommand}" />-->

                    <Button Content="新增" Width="80" Height="24" Margin="10 0 0 0" Style="{DynamicResource BlueGreenOrangeGraySlateButtonStyle}" IsEnabled="{Binding IsEdit, Converter={StaticResource reversebooleanConvertor}}" Foreground="{DynamicResource DefaultGridForground}" Tag="4"  BorderThickness="0 1 0 0" Command="{Binding ManualAddSimTradingCommand}" />
                </StackPanel>

                <!--模拟数据-->
                <DataGrid Grid.Row="1" x:Name="SimDataGrid" ItemsSource="{Binding GlobalViewMv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedItem="{Binding SelectSimOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        ColumnHeaderStyle="{DynamicResource SelfDataGridColumnHeaderStyle}" IsSynchronizedWithCurrentItem="True" SelectionMode="Extended" SelectionUnit="FullRow">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="" Width="40" HeaderStyle="{StaticResource SelfDataGridColumnHeaderStyle}" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox Width="13" Height="13"                          
                                                          IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                          Visibility="{Binding HasItems,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Converter={StaticResource visiblityConvertor}}"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                          Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" BorderBrush="{DynamicResource GraySlateButton.Static.Border}" ToolTip="选择全部或取消选择" Click="AllCheckBox_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="Selected_Chk" HorizontalAlignment="Left" Content="" 
                                              IsChecked="{Binding ischecked,Mode=TwoWay, Converter={StaticResource booleanConvertor}, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{DynamicResource  GreenBlueCheckedNormalCheckBox}"
                                              BorderBrush="{DynamicResource DailanBlueGreenOrangeComboBoxTextBox.Disabled.Foreground}" Width="13" Height="13" Background="Transparent"
                                              Click="Selected_Chk_Click">
                                    </CheckBox>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding updateTime}" Value="{x:Null}">
                                            <Setter TargetName="Selected_Chk" Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--DataGridTextColumn Binding="{Binding id}" Header="ID" Width="Auto" MinWidth="80"/-->
                        
                        <DataGridTemplateColumn  Width="106" CanUserSort="True" HeaderStyle="{StaticResource SelfDataGridColumnHeaderStyle}">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" Text="代码"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBlock VerticalAlignment="Center" Visibility="{Binding IsCanAdded ,Converter={StaticResource reversevisibilityConvertor}}" Style="{StaticResource IsNotValid}" Text="{Binding Path=securityid}">
                                            </TextBlock>
                                            <comp:SettingSearchTextBox Visibility="{Binding IsCanAdded ,Converter={StaticResource visibilityConvertor}}"
                                                        FontSize="12" Height="22"  HintText="请输入债券..." TextWidth="86" Width="86" Margin="-10,0,0,0"
                                                        SearchText="{Binding securityid_edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F"
                                                        AfterSearch="SettingSearchTextBox_AfterSearch"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="简称" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="InsName_display" Foreground="#FFFFFF" Text="{Binding symbol}" Padding="0" Style="{StaticResource IsNotValid}" TextTrimming="CharacterEllipsis"></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="剩余期限" Width="Auto" MinWidth="70" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="InsName_display" Foreground="#FFFFFF" Text="{Binding RemaingingTime}" Padding="0" Style="{StaticResource IsNotValid}" TextTrimming="CharacterEllipsis" ></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="组合" Width="Auto" MinWidth="180" MaxWidth="360">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBlock VerticalAlignment="Center" Visibility="{Binding IsCanAdded ,Converter={StaticResource reversevisibilityConvertor}}" Style="{StaticResource IsNotValid}" Text="{Binding Path=bookName}">
                                            </TextBlock>
                                            <comp:MultiTreeComboBox  Grid.Column="1"  Height="26"  Margin="0 0 0 0"  Name="TreeView_NodeList" Visibility="{Binding IsCanAdded ,Converter={StaticResource visibilityConvertor}}"
                                            VerticalAlignment="Center" TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" Foreground="White" SelectedItem="{Binding bookId_edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedId="{Binding bookId_edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TreeItemsSource="{Binding itemsource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnableMultiSelect="False" IsEnableSelectRootNode="False" DefaultText="ALL"  SelectedItemChanged ="TreeView_NodeList_SelectedItemChanged">
                                                <comp:MultiTreeComboBox.TreeItemItemTemplate>
                                                    <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                                        <StackPanel Orientation="Horizontal" Height="24">
                                                            <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}" Visibility="{Binding IsLeaf, Converter={StaticResource visibilityConvertor}}"/>
                                                            <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Checked}" Value="1">
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                                        </StackPanel>
                                                    </HierarchicalDataTemplate>
                                                </comp:MultiTreeComboBox.TreeItemItemTemplate>
                                            </comp:MultiTreeComboBox>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn  Header="方向" Width="Auto" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"  Text="{Binding side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='sidepositon'}" Visibility="{Binding IsCanAdded ,Converter={StaticResource reversevisibilityConvertor}}" Style="{StaticResource IsNotValid}">
                                            </TextBlock>

                                            <CheckBox x:Name="Selected_Chk1" HorizontalAlignment="Left" Content="" Height="20" IsChecked="{Binding side_edit,Mode=TwoWay, Converter={StaticResource booleanConvertor}, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBluePositionButtionCheckBoxStyle}"  Visibility="{Binding IsCanAdded ,Converter={StaticResource visibilityConvertor}}" BorderBrush="{DynamicResource DailanBlueGreenOrangeComboBoxTextBox.Disabled.Foreground}"  Background="Transparent" >
                                            </CheckBox>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn  Header="面额(万)" Width="Auto" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"  Visibility="{Binding IsCanAdded ,Converter={StaticResource reversevisibilityConvertor}}" Style="{StaticResource IsNotValid}" Text="{Binding Path=qty, StringFormat='#,##0'}">
                                            </TextBlock>
                                            <TextBox Visibility="{Binding IsCanAdded ,Converter={StaticResource visibilityConvertor}}" Text="{Binding qty_edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{DynamicResource TextBoxDefaultStyle}" HorizontalContentAlignment="Left" ToolTip="正数，500的整数被，输入范围（0，100,000]"
                                                              Height="22" Margin="0,0,0,0" Padding="0,2,0,0" input:InputMethod.IsInputMethodEnabled="False" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F" PreviewKeyDown="TextBox_PreviewKeyDown">
                                            </TextBox>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding closeBy}" Header="最后更新人" Width="Auto" MinWidth="80"/>
                        
                        <!--<DataGridTemplateColumn Header="最后更新人" Width="90" MinWidth="60" SortMemberPath="Text">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock  Foreground="#FFFFFF" Text="{Binding FullName}" VerticalAlignment="Center" TextAlignment="Left" Style="{StaticResource IsNotValid}" TextTrimming="CharacterEllipsis"></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->


                        <DataGridTextColumn Header="最后更新时间"  Binding="{Binding updateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter='yyyy-MM-dd HH:mm:ss'}" Width="Auto" MinWidth="120" />

                        <DataGridTemplateColumn Header="编辑" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <!--保存-->
                                        <Button Width="24" Height="24" Style="{DynamicResource  SaveButton}"  Visibility="{Binding SaveBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.SaveRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"  CommandParameter="{Binding id}" ToolTip="保存" />
                                        <!--取消-->
                                        <Button  Width="24" Height="24" Style="{DynamicResource  EditCloseButton}"  Visibility="{Binding SaveBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.CancelRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"  CommandParameter="{Binding id}" ToolTip="取消"/>
                                        <!--修改-->
                                        <Button  Width="24" Height="24" Style="{DynamicResource  EditButton}"  Visibility="{Binding EditBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"  CommandParameter="{Binding id}" ToolTip="修改"/>
                                        <!--删除或撤销修改状态-->
                                        <Button  Width="24" Height="24" Style="{DynamicResource  DeleteButton}"  Visibility="{Binding EditBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.DelRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"  CommandParameter="{Binding id}" ToolTip="删除"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

