                        <DataGridTextColumn Header="账户" Binding="{Binding accId}" Width="Auto" MinWidth="90" CanUserSort="True"  />
                        <DataGridTextColumn Header="交易编号" Binding="{Binding execId}" Width="Auto" MinWidth="90" CanUserSort="True"/>
                        <DataGridTextColumn Header="外部成交编号" Binding="{Binding venueExecId}" Width="Auto" MinWidth="90" CanUserSort="True"/>
                        <DataGridTemplateColumn  Header="代码" Width="Auto" MinWidth="85" SortMemberPath="securityid" ClipboardContentBinding="{Binding securityid}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding securityid}" TextTrimming="CharacterEllipsis"  ToolTip="{Binding securityid}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="交易日期" Binding="{Binding traderdate}" Width="Auto" MinWidth="90" CanUserSort="True"  />
                        <DataGridTextColumn Header="方向" Binding="{Binding side}" Width="Auto" MinWidth="90" CanUserSort="True"  />
                        <DataGridTextColumn Header="净价(元)" Binding="{Binding netprice}" Width="Auto" MinWidth="90" CanUserSort="True" />
                        <DataGridTextColumn Header="成交价(%)" Binding="{Binding yield}" Width="Auto" MinWidth="90" CanUserSort="True" />
                        <DataGridTextColumn Header="成交量(万)" Binding="{Binding amount}" Width="Auto" MinWidth="90" CanUserSort="True" />

                        <DataGridTextColumn Header="清算日期"  Binding="{Binding settlDate}" Width="Auto" MinWidth="100" />
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

        <Border Name="dgPosition" Visibility="Collapsed" Grid.Row="1" BorderBrush="{Binding BorderBrush}" BorderThickness="1,1,1,1" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="24"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <!--持仓核对-->
                <DataGrid Grid.Row="0" x:Name="OwnPosition" ItemsSource="{Binding Mv.View, UpdateSourceTrigger=PropertyChanged}" 
                            Style="{DynamicResource DefaultDataGrid}" Background="{DynamicResource DefaultBackgroup.ColorBrush}" 
                            SelectedItem="{Binding SelectedPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         LoadingRow="OwnPosition_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn  Width="60" Header="序号" MinWidth="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="核对结果" Width="Auto" MinWidth="90" CanUserSort="True"  HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="cnstatus" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CheckResult}" Value="成功">
                                            <Setter TargetName="cnstatus" Property="TextBlock.Foreground" Value="Green"/>
                                            <Setter TargetName="cnstatus" Property="TextBlock.Text" Value="成功"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CheckResult}" Value="失败">
