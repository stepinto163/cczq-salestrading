                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="组合" Binding="{Binding bookname}" Width="Auto" MinWidth="90" CanUserSort="True"  HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>

                        <DataGridTemplateColumn  Header="代码" Width="Auto" MinWidth="85" SortMemberPath="securityid" ClipboardContentBinding="{Binding securityid}">
                            <!--<DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                    --><!--<Setter Property="Foreground" Value="#C29B4E"/>--><!--
                                </Style>
                            </DataGridTemplateColumn.CellStyle>-->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding securityid}" TextTrimming="CharacterEllipsis"  ToolTip="{Binding securityid}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn  Header="简称" Width="Auto" MinWidth="90" SortMemberPath="symbol" ClipboardContentBinding="{Binding symbol}">
                            <!--<DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                    --><!--<Setter Property="Foreground" Value="#C29B4E"/>--><!--
                                </Style>
                            </DataGridTemplateColumn.CellStyle>-->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding symbol}" TextTrimming="CharacterEllipsis"   ToolTip="{Binding symbol}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn  Header="临时代码" Width="Auto" MinWidth="90" SortMemberPath="tempCode" ClipboardContentBinding="{Binding tempCode}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding tempCode}" TextTrimming="CharacterEllipsis"   ToolTip="{Binding tempCode}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Header="总持仓(万)"  Binding="{Binding NetPosition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="100"  HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>
                        <DataGridTextColumn Header="衡泰持仓(万)"  Binding="{Binding htNetPosition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="100"   HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>

                       
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter x:Name="gridSplitter" Grid.Row="1" Background="{StaticResource MainBackgroup.ColorBrush}" Style="{StaticResource VGridSplitterStyle2}"/>

                <!--恒泰持仓-->
                <DataGrid   Grid.Row="2" x:Name="htPosition" ItemsSource="{Binding Ht.View, UpdateSourceTrigger=PropertyChanged}"
                            Style="{DynamicResource DefaultDataGrid}" Background="{DynamicResource DefaultBackgroup.ColorBrush}" 
                            SelectedItem="{Binding SelectedItem_dgPositionDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           LoadingRow="htPosition_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn  Width="60" Header="序号" MinWidth="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="衡泰账号" Binding="{Binding bookid}" Width="Auto" MinWidth="90" CanUserSort="True" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>
                        <DataGridTemplateColumn  Header="代码" Width="Auto" MinWidth="90" SortMemberPath="symbol" ClipboardContentBinding="{Binding securityid}">
                            <!--<DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                                    <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                                    --><!--<Setter Property="Foreground" Value="#C29B4E"/>-->
                                    <!--<EventSetter Event="MouseDoubleClick" Handler="dgPositionDetail_DataGridCell_MouseDoubleClick"/>--><!--
                                </Style>
                            </DataGridTemplateColumn.CellStyle>-->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding securityid}" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding securityid}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="衡泰持仓(万)"  Binding="{Binding NetPosition,StringFormat={}{0:N0}}" Width="Auto" MinWidth="100" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"/>
                        
                       
                       
