<UserControl x:Class="STC.Position.Plugin.View.PositionCheckUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Position.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:Component="clr-namespace:STC.Position.Plugin.View" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>


            <Style x:Key="SelfTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="SumColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="#F9C152" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="SumColorEmptyStyleAlignmentLeft" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange6}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Margin" Value="4 0 0 0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="BidLongColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange6}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrShortColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue8}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BookListColumnStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="#FFFFFF "/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                        <Setter Property="Foreground" Value="#00CDAD" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MainListTitleBackgroup.ColorBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyleNetAvgPrice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleNetAvgYield" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>

                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleLastNetprice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleLastPrice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DefaultContextMenu" TargetType="{x:Type ContextMenu}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border x:Name="Border"
                         Background="#282828"
                         BorderThickness="1">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#FF6E6D6D" />
                                </Border.BorderBrush>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasDropShadow"
                                Value="true">
                                    <Setter TargetName="Border"
                                Property="Padding"
                                Value="0,3,0,3" />
                                    <Setter TargetName="Border"
                                Property="CornerRadius"
                                Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DefaultMenuItem" TargetType="MenuItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid ToolTip="{TemplateBinding Header}" Height="30" Background="Transparent" Width="{TemplateBinding Width}">
                                <Grid.ColumnDefinitions>
                                    <!--<ColumnDefinition Width="30" />-->
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="Transparent"/>
                                <Border x:Name="_border"   Grid.ColumnSpan="2"/>
                                <!--<Image x:Name="_imgicon" Width="12" Height="12" Stretch="Uniform" Source="{Binding Icon,RelativeSource={RelativeSource TemplatedParent}}" />-->
                                <TextBlock Foreground="#FFFFFF" Grid.Column="1" Margin="5 0 15 0" TextAlignment="Center"  VerticalAlignment="Center" x:Name="_txt" Text="{Binding Header,RelativeSource={RelativeSource TemplatedParent}}" />
                                <Path  Visibility="Collapsed" x:Name="_path" Grid.Column="1" HorizontalAlignment="Right"  Margin="5 13 5 0"   Data="M0,4 4,0 0,-4 z" Fill="#7E8A92"/>
                                <Popup  Placement="Right" x:Name="SubMenuPopup" AllowsTransparency="True"   Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" >
                                    <ScrollViewer   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <Border Background="Transparent" Name="SubmenuBorder" BorderBrush="LightGray" BorderThickness="1"  SnapsToDevicePixels="True"    >
                                            <StackPanel   IsItemsHost="True"   KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </ScrollViewer>
                                </Popup>

                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="true">
                                    <Setter TargetName="_path" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="_border" Property="Background" Value="#1E1E1E"/>
                                    <Setter TargetName="_txt" Property="Foreground" Value="White"/>
                                    <Setter TargetName="_path" Property="Fill" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="_txt" Property="Foreground" Value="Gray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SelfCalendarDayButtonStyle" TargetType="{x:Type CalendarDayButton}">
                <Setter Property="MinWidth" Value="5"/>
                <Setter Property="MinHeight" Value="5"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.1"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="0.5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="0.5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                                <DoubleAnimation Duration="0" To=".35" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="NormalText"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Unselected"/>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To=".75" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="SelectedBackground"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="CalendarButtonFocused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="DayButtonFocusVisual">
                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                        <DiscreteObjectKeyFrame.Value>
                                                            <Visibility>Visible</Visibility>
                                                        </DiscreteObjectKeyFrame.Value>
                                                    </DiscreteObjectKeyFrame>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CalendarButtonUnfocused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="DayButtonFocusVisual">
                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                        <DiscreteObjectKeyFrame.Value>
                                                            <Visibility>Collapsed</Visibility>
                                                        </DiscreteObjectKeyFrame.Value>
                                                    </DiscreteObjectKeyFrame>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="ActiveStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Active"/>
                                        <VisualState x:Name="Inactive">
                                            <Storyboard>
                                                <ColorAnimation Duration="0" To="#FF777777" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="NormalText"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DayStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="RegularDay"/>
                                        <VisualState x:Name="Today">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="TodayBackground"/>
                                                <ColorAnimation Duration="0" To="#FFFFFFFF" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="NormalText"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="BlackoutDayStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0"/>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="NormalDay">
                                        </VisualState>
                                        <VisualState x:Name="BlackoutDay">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To=".5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Blackout"/>
                                                <DoubleAnimation Duration="0" To=".4" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="NormalText"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Rectangle x:Name="TodayBackground" Fill="#193D37" Opacity="0" RadiusY="1" RadiusX="1"/>
                                <Rectangle x:Name="SelectedBackground" Fill="Transparent" Opacity="0" RadiusY="1" RadiusX="1"/>
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"/>
                                <Rectangle x:Name="HighlightBackground" Fill="Black" Opacity="0" RadiusY="1" RadiusX="1"/>
                                <ContentPresenter x:Name="NormalText" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="5,1,5,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Path x:Name="Blackout" Data="M6.49241251,5.53100139 L10.8558668,1.15050666 C10.9932898,1.02444399 11.0620028,0.867048874 11.0620028,0.678321323 C11.0620028,0.489593772 10.9962215,0.329266969 10.8646619,0.197340914 C10.7331023,0.0654148584 10.5727755,-0.000364938572 10.3836814,0 C10.1945874,0.000367983957 10.0371923,0.069079471 9.91149611,0.206135984 L5.53100139,4.56959026 L1.15050666,0.206135984 C1.02444399,0.0687130098 0.867048874,0 0.678321323,0 C0.489593772,0 0.329266969,0.0657813196 0.197340914,0.197340914 C0.0654148584,0.328900507 -0.000364938572,0.489227311 0,0.678321323 C0.000367983957,0.867415335 0.069079471,1.02481045 0.206135984,1.15050666 L4.56959026,5.53100139 L0.206135984,9.91149611 C0.0687130098,10.0375588 0,10.1949539 0,10.3836814 C0,10.572409 0.0657813196,10.7327358 0.197340914,10.8646619 C0.328900507,10.9965879 0.489227311,11.0623677 0.678321323,11.0620028 C0.867415335,11.0616348 1.02481045,10.9929233 1.15050666,10.8558668 L5.53100139,6.47537206 L9.91149611,10.8558668 C10.0375588,10.9932898 10.1949539,11.0620028 10.3836814,11.0620028 C10.572409,11.0620028 10.7327358,10.9962215 10.8646619,10.8646619 C10.9965879,10.7331023 11.0623677,10.5727755 11.0620028,10.3836814 C11.0616348,10.1945874 10.9929233,10.0371923 10.8558668,9.91149611 L6.49241251,5.53100139 Z" Fill="LightGray" HorizontalAlignment="Stretch" Margin="3" Opacity="0" RenderTransformOrigin="0.5,0.5" Stretch="Fill" Height="10" Width="10" VerticalAlignment="Stretch"/>
                                <Rectangle x:Name="DayButtonFocusVisual" IsHitTestVisible="false" RadiusY="1" RadiusX="1" Stroke="#FF45D6FA" Visibility="Collapsed"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="SelfDefaultCalendarStyle" TargetType="{x:Type Calendar}" BasedOn="{StaticResource DefaultCalendarStyle}">
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource SelfCalendarDayButtonStyle}"/>
            </Style>
            <Style x:Key="SelfDatePickerStyle" TargetType="{x:Type DatePicker}" BasedOn="{StaticResource DefaultDatePickerStyle}">
                <Setter Property="CalendarStyle" Value="{StaticResource SelfDefaultCalendarStyle}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1000"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="30"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Name="spTitle" Orientation="Horizontal" Grid.Row="0">

                <ListBox x:Name="positionStatus" Background="Transparent" VerticalAlignment="Center" SelectionMode="Single" SelectionChanged="positionStatus_SelectionChanged" Margin="10 0 0 0">
                    <ListBox.Template>
                        <ControlTemplate>
                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBoxItem Content="交易核对" Tag="0" IsSelected="True" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="64" HorizontalContentAlignment="Center" Height="24" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal" Margin="5,0,0,0" BorderThickness="0 1 0 0"/>

                    <ListBoxItem Content="持仓核对" Tag="1" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="64" HorizontalContentAlignment="Center" Height="24" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                       </ListBox>

                <TextBlock  Text="组合:" Margin="10,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"></TextBlock>
                <local:MultiSelectComboBox x:Name="comBookId" DefaultText="ALL" Width="120"
                                                   SelectedValues="{Binding SelectBook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="22" Background="Black">
                </local:MultiSelectComboBox>

                <TextBlock  Text="核对结果:" Margin="10,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"></TextBlock>

                <ComboBox x:Name="checkCBox"
                Margin="0,0,0,0" Width="100" Height="20" VerticalAlignment="Center" 
                      SelectedIndex="0" 
                      Style="{DynamicResource ComboBoxStyle}" 
                      Text="{Binding ResultSelectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="全部" Tag="1" IsSelected="True"></ComboBoxItem>
                    <ComboBoxItem Content="成功" Tag="2"></ComboBoxItem>
                    <ComboBoxItem Content="失败" Tag="3"></ComboBoxItem>
                </ComboBox>

                <DatePicker x:Name="dpTo" Style="{DynamicResource SelfDatePickerStyle}"  Grid.ColumnSpan="2" Width="110px" Height="24" Margin="5,0,0,0"  
                                    SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" VerticalContentAlignment="Center"></DatePicker>
                
                <commComp:SearchTextBox HorizontalAlignment="Left" Margin="5 0 0 0" x:Name="Search_TextBox"
                                 SearchText="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalAlignment="Center" Width="120" Height="20" IsFuzzy="True"/>

                <Button Content="同步数据" x:Name="SyncBT" Width="100" Margin="40,0,1,0" Style="{DynamicResource  BlueGreenOrangeGraySlateButtonStyle}" 
                    Height="24" BorderThickness="0 1 0 0" Command="{Binding SyncCommand}" IsEnabled="{Binding SyncEnable}"/>
                <Button Content="核对" x:Name="checkBT" Width="100" Margin="10,0,1,0" Style="{DynamicResource  BlueGreenOrangeGraySlateButtonStyle}" 
                    Height="24" BorderThickness="0 1 0 0" Command="{Binding CheckCommand}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock  x:Name="txUpdateTime"  Text="上次同步成功时间:" Foreground="{StaticResource ColorBrush.While}" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                             Margin="0,5,0,0"  />
                <TextBlock  Text="{Binding LastUpdateTime}" Foreground="{StaticResource ColorBrush.While}" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                            Margin="5,5,4,0"  />
                <TextBlock  x:Name="txConut"  Text=" 获取条数:" Foreground="{StaticResource ColorBrush.While}" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                             Margin="0,5,0,0"  />
                <TextBlock  Text="{Binding LastHtCount}" Foreground="{StaticResource ColorBrush.While}" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                            Margin="5,5,4,0"  />
            </StackPanel>
            <Button x:Name="btnExport" Width="24" Height="24" Grid.Column="2"
                        VerticalAlignment="Center" Style="{DynamicResource ExportButton}" 
                        Command="{Binding ExportCommand}"/>
        </Grid>

        <Border Name="dgDeal"  Grid.Row="1" BorderBrush="{Binding BorderBrush}" BorderThickness="1,1,1,1" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="24"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <!--交易核对-->
                <Component:CustomExecDataGrid Grid.Row="0"  x:Name="Trade_dataGrid" ItemsSource="{Binding Trade.View, UpdateSourceTrigger=PropertyChanged}"  VirtualizingStackPanel.VirtualizationMode="Standard"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                            Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}" Background="{DynamicResource DefaultBackgroup.ColorBrush}" 
                            SelectedItem="{Binding SelectedTradeItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="dgMenu_Post" Style="{StaticResource DefaultContextMenu}" >
                            <MenuItem x:Name="copyId" Header="复制外部成交编号" Style="{StaticResource DefaultMenuItem}" Click="copyId_Click"/>
                            <MenuItem x:Name="batchEnter" Header="批量补录" Style="{StaticResource DefaultMenuItem}" Click="batchEnter_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
