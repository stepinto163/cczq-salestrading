                                <DataTemplate>
                                    <TextBlock x:Name="cnstatus" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CheckResult}" Value="成功">
                                            <Setter TargetName="cnstatus" Property="TextBlock.Foreground" Value="Green"/>
                                            <Setter TargetName="cnstatus" Property="TextBlock.Text" Value="成功"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CheckResult}" Value="失败">
                                            <Setter TargetName="cnstatus"  Property="TextBlock.Foreground" Value="Red"/>
                                            <Setter TargetName="cnstatus" Property="TextBlock.Text" Value="失败"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn  Header="操作" Width="Auto" MinWidth="90" >
                            <DataGridTemplateColumn.CellTemplate>
