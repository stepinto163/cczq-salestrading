                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->

                <DataGridTextColumn Binding="{Binding SecurityID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="代码" MinWidth="80" Width="Auto" MaxWidth="300" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <DataGridTextColumn Binding="{Binding Symbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="简称" MinWidth="80" Width="Auto" MaxWidth="300" CellStyle="{StaticResource QueryDataGridCellStyle}"/>

                <DataGridComboBoxColumn ItemsSource="{x:Static viewmodel:HistoryPositionOrderDetailViewModel.SideItemSource}" 
                                                SelectedValueBinding="{Binding Side, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                SelectedValuePath="Key" DisplayMemberPath="Value"  
                                                Header="方向" Width="40" CellStyle="{StaticResource ColumnColorStyle}" IsReadOnly="True" />

                <DataGridTextColumn Binding="{Binding LastPx,Converter={StaticResource numConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ConverterParameter=''}" Header="成交价(%)" Width="110" CellStyle="{StaticResource ColumnColorStyle}"/>
                <DataGridTextColumn Binding="{Binding NetPrice,StringFormat={}{0:N4}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="成交净价" Width="120" SortMemberPath="NetPrice1" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <!--<DataGridTextColumn Binding="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="报量(万元)" Width="2*" CellStyle="{StaticResource DataGridCellStyle1}"/>-->
                <DataGridTextColumn Binding="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="成交量（万元）" Width="150" CellStyle="{StaticResource QueryDataGridCellStyle}"/>

                <DataGridTextColumn Binding="{Binding Veneues,ConverterParameter=venues_exe, Converter={StaticResource EnumTypeConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="渠道" Width="125" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <!--<DataGridTextColumn Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                    ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                    Header="清算速度" Width="Auto" MinWidth="60" CellStyle="{StaticResource QueryDataGridCellStyle}">-->
                <DataGridTextColumn  Binding="{Binding SettlType,ConverterParameter=settletype_myorder,Converter={StaticResource EnumTypeConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Header="清算速度" Width="Auto" MinWidth="60" CellStyle="{StaticResource QueryDataGridCellStyle}">
                </DataGridTextColumn>

                <DataGridTextColumn Header="创建日期" Width="Auto" Binding="{Binding CreateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>

                <DataGridTextColumn Header="交易日期" Width="Auto" Binding="{Binding TradeDate,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}" CellStyle="{StaticResource QueryDataGridCellStyle}" />
                <!--<DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="交易日期" Width="3*"/>
                <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="成交时间" Width="3*"/>-->
                <DataGridTextColumn Header="成交时间" Width="150" Binding="{Binding ExecutionTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter='yyyy-MM-dd HH:mm:ss'}" CellStyle="{StaticResource QueryDataGridCellStyle}" />

                <DataGridTemplateColumn Header="对手方" Width="100" MinWidth="50" ClipboardContentBinding="{Binding CounterPartyName}" CellStyle="{StaticResource QueryDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPartyName}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="对手交易员" Width="100" MinWidth="70" ClipboardContentBinding="{Binding CounterPartySubName}" CellStyle="{StaticResource QueryDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPartySubName}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--<DataGridTemplateColumn Header="同步状态" Width="2*" ClipboardContentBinding="{Binding SyncStatus, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='synchflag'}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock x:Name="syncStatusTB" Text="{Binding SyncStatus, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='synchflag'}"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SyncStatus}" Value="C">
