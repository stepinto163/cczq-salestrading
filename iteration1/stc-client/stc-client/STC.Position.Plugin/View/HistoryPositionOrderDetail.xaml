                                    <Setter TargetName="syncStatusTB" Property="Foreground" Value="#E63034"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTextColumn Header="成交编号" Width="250"  MinWidth="60"  Binding="{Binding ExecID}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <DataGridTextColumn Header="外部成交编号" Width="250"  MinWidth="60"  Binding="{Binding Venueexecid}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <DataGridTextColumn Header="订单编号" Width="250" MinWidth="60" Binding="{Binding StrategyOrderId}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>

                <DataGridTextColumn Header="组合" Width="Auto"  MinWidth="30" Binding="{Binding BookName}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <DataGridTextColumn Header="组合ID" Width="Auto" MinWidth="30" Binding="{Binding BookID}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <DataGridTemplateColumn Header="备注" Width="100" MinWidth="40" ClipboardContentBinding="{Binding Remark}" 
                                        CellStyle="{StaticResource QueryDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Remark}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="来源" Width="2*" MinWidth="40" Binding="{Binding DataType, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <DataGridTextColumn Header="未关联" Width="2*" MinWidth="40" Binding="{Binding NotRelatedButtonVisible, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <DataGridTextColumn Header="已关联" Width="2*" MinWidth="40" Binding="{Binding RelatedButtonVisible, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>
                <DataGridTextColumn Header="删除" Width="2*" MinWidth="40" Binding="{Binding DelBtnVisible, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" CellStyle="{StaticResource QueryDataGridCellStyle}"/>-->
                
                
            </DataGrid.Columns>
        </CommonComp:ExDataGrid>

        <local:PageControl x:Name="EMSPageControl" Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Right" 
                               PageChanged="EMSPageControl_PageChanged"
                               Visibility="{Binding EMSPageVisible,Converter={StaticResource visibilityConvertor}}"/>
        <fUI:LoadingMask x:Name="positionloadMask" Visibility="Collapsed" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"></fUI:LoadingMask>
    </Grid>
</UserControl>
