                                                        Style="{StaticResource SelfRelatedButton}" ToolTip="已关联"  Visibility="{Binding RelatedButtonVisible,Converter={StaticResource visibilityConvertor}}"  Command="{Binding DataContext.SelfRelatedCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" CommandParameter="{Binding ExecID}"></Button>

                                    <Button BorderThickness="0" Height="24" Width="24"  Margin="0,-5,0,0"  VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                        Style="{StaticResource SelfNotRelatedButton}" ToolTip="未关联" Visibility="{Binding NotRelatedButtonVisible,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.SelfNotRelatedCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" CommandParameter="{Binding ExecID}"></Button>

                                    <Button Foreground="#A0A0A0" Width="20" Height="20" Margin="-4,-5,0,0" VerticalContentAlignment="Center" ToolTip="删除" HorizontalAlignment="Center" 
                                                        Style="{StaticResource SelfDeleteButton}" Visibility="{Binding DelBtnVisible,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.DelBtnCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" CommandParameter="{Binding ExecID}"/>
                                </StackPanel>
