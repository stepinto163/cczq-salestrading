<UserControl x:Class="STC.Position.Plugin.View.TransactionStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Position.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>


            <Style x:Key="SelfTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="SumColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="#F9C152" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="SumColorEmptyStyleAlignmentLeft" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Margin" Value="4 0 0 0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="BidLongColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange6}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrShortColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue8}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BookListColumnStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="#FFFFFF "/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                        <Setter Property="Foreground" Value="#00CDAD" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MainListTitleBackgroup.ColorBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyleNetAvgPrice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleNetAvgYield" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>

                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleLastNetprice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SumMoneyEmptyStyleLastPrice" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DefaultContextMenu" TargetType="{x:Type ContextMenu}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Grid.IsSharedSizeScope" Value="true" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border x:Name="Border"
                         Background="#282828"
                         BorderThickness="1">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#FF6E6D6D" />
                                </Border.BorderBrush>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasDropShadow"
                                Value="true">
                                    <Setter TargetName="Border"
                                Property="Padding"
                                Value="0,3,0,3" />
                                    <Setter TargetName="Border"
                                Property="CornerRadius"
                                Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DefaultMenuItem" TargetType="MenuItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid ToolTip="{TemplateBinding Header}" Height="30" Background="Transparent" Width="{TemplateBinding Width}">
                                <Grid.ColumnDefinitions>
                                    <!--<ColumnDefinition Width="30" />-->
                                    <ColumnDefinition Width="*" MinWidth="80"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="Transparent"/>
                                <Border x:Name="_border"   Grid.ColumnSpan="2"/>
                                <!--<Image x:Name="_imgicon" Width="12" Height="12" Stretch="Uniform" Source="{Binding Icon,RelativeSource={RelativeSource TemplatedParent}}" />-->
                                <TextBlock Foreground="#FFFFFF" Grid.Column="1" Margin="5 0 15 0" TextAlignment="Center"  VerticalAlignment="Center" x:Name="_txt" Text="{Binding Header,RelativeSource={RelativeSource TemplatedParent}}" />
                                <Path  Visibility="Collapsed" x:Name="_path" Grid.Column="1" HorizontalAlignment="Right"  Margin="5 13 5 0"   Data="M0,4 4,0 0,-4 z" Fill="#7E8A92"/>
                                <Popup  Placement="Right" x:Name="SubMenuPopup" AllowsTransparency="True"   Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" >
                                    <ScrollViewer   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <Border Background="Transparent" Name="SubmenuBorder" BorderBrush="LightGray" BorderThickness="1"  SnapsToDevicePixels="True"    >
                                            <StackPanel   IsItemsHost="True"   KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </Border>
                                    </ScrollViewer>
                                </Popup>

                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="true">
                                    <Setter TargetName="_path" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="_border" Property="Background" Value="#1E1E1E"/>
                                    <Setter TargetName="_txt" Property="Foreground" Value="White"/>
                                    <Setter TargetName="_path" Property="Fill" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="_txt" Property="Foreground" Value="Gray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid  x:Name="gridMain" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" MinWidth="120" BorderBrush="{Binding BorderBrush}"  x:Name="Border_Left" BorderThickness="1,1,0,1" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
              <commComp:MultiSelectTreeViewControl  Name="TreeView_NodeList" HorizontalAlignment="Left"  VerticalContentAlignment="Top"
                                 BorderThickness="0"  Margin="4,0,0,10" Foreground="White" Background="{DynamicResource MainTitleBackgroup.ColorBrush}"
                                 TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" IsEnableSelectRootNode="True" 
                                 TreeItemsSource="{Binding MultiTreeComboxItemsSourceNew}" SelectedItemChanged ="TreeView_NodeList_SelectedItemChanged">

                    <commComp:MultiSelectTreeViewControl.TreeItemItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                            <StackPanel Orientation="Horizontal" Height="24">
                                <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}"/>
                                <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Checked}" Value="1">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </commComp:MultiSelectTreeViewControl.TreeItemItemTemplate>
                </commComp:MultiSelectTreeViewControl>
        </Border>


        <GridSplitter x:Name="gridSplitter" MinWidth="7" Grid.Column="1" Background="{DynamicResource MainBackgroup.ColorBrush}" Style="{DynamicResource VGridSplitterStyle2}"/>

        <Border Grid.Column="2" BorderBrush="{Binding BorderBrush}"   BorderThickness="1,1,1,1" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <!--持仓汇总-->
            <commComp:ExDataGrid x:Name="dgPositionStatistics" ItemsSource="{Binding StatisticsMv.View, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}" Background="{DynamicResource DefaultBackgroup.ColorBrush}"
                                         Sorting="dgDetailStatistic_Sorting"
                                         FixedDisplayColumns="代码,简称,持仓" DefaultHideColumns="昨持仓量(多),昨持仓量(空),今持仓量(多),今持仓量(空)"
                                         ScrollViewer.HorizontalScrollBarVisibility="Visible">
                <DataGrid.Columns>
                    <DataGridTextColumn Header=" 代码" Binding="{Binding securityid}" Width="Auto" CanUserSort="True" MinWidth="78"  CellStyle="{StaticResource SumColorStyle}"/>
                    <DataGridTextColumn Header="简称"  Binding="{Binding symbol}" Width="Auto" CanUserSort="True" MinWidth="100"  CellStyle="{StaticResource SumColorEmptyStyle}"/>
                    <DataGridTemplateColumn Header="买成交量(手)" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtLongLot" Text="{Binding longLot,StringFormat={}{0:N0}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding marketindicator}" Value="4">
                                        <Setter TargetName="txtLongLot" Property="Text" Value="--"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="卖成交量(手)" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtShortLot" Text="{Binding shortLot,StringFormat={}{0:N0}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding marketindicator}" Value="4">
                                        <Setter TargetName="txtShortLot" Property="Text" Value="--"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="净成交量(手)" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtNetLot" Text="{Binding netLot,StringFormat={}{0:N0}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding marketindicator}" Value="4">
                                        <Setter TargetName="txtNetLot" Property="Text" Value="--"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="总成交量(手)" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtTotalLot" Text="{Binding totalLot,StringFormat={}{0:N0}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding marketindicator}" Value="4">
                                        <Setter TargetName="txtTotalLot" Property="Text" Value="--"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="买成交量（万元）" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtLongVolume" Text="{Binding longVolume,StringFormat={}{0:N0}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                                        <Setter TargetName="txtLongVolume" Property="Text" Value="--"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="卖成交量（万元）" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtShortVolume" Text="{Binding shortVolume,StringFormat={}{0:N0}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                                        <Setter TargetName="txtShortVolume" Property="Text" Value="--"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="净成交量（万元）" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtNetVolume" Text="{Binding netVolume,StringFormat={}{0:N0}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                                        <Setter TargetName="txtNetVolume" Property="Text" Value="--"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="总成交量（万元）" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="txtTotalVolume" Text="{Binding totalVolume,StringFormat={}{0:N0}}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding marketindicator}" Value="5">
                                        <Setter TargetName="txtTotalVolume" Property="Text" Value="--"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="成交均价（买）"  Binding="{Binding longAvgPrice,StringFormat={}{0:N4}}" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorEmptyStyle}"/>
                    <DataGridTextColumn Header="成交均价（卖）"  Binding="{Binding shortAvgPrice,StringFormat={}{0:N4}}" Width="Auto" MinWidth="64"  CellStyle="{StaticResource SumColorEmptyStyle}"/>
                    <DataGridTextColumn Header="总成交金额（万元）"  Binding="{Binding totalAmt,StringFormat={}{0:N0}}" Width="Auto" MinWidth="120"  CellStyle="{StaticResource SumColorStyle}"/>
                    <DataGridTextColumn Header="组合" Binding="{Binding bookname}" Width="Auto" MinWidth="64" CanUserSort="True" CellStyle="{StaticResource SumColorEmptyStyle}"/>
                    <DataGridTextColumn Header="最后更新时间" Binding="{Binding lastUpdateTime}" Width="Auto" MinWidth="100" CellStyle="{StaticResource SumColorEmptyStyle}"  Foreground="#A0A0A0"/>
                </DataGrid.Columns>
            </commComp:ExDataGrid>

        </Border>
    </Grid>
</UserControl>
