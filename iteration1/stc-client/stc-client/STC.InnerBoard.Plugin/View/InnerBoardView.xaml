                                    <Border x:Name="SuggestFlagBd" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="荐" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FireFlagBd" Grid.Column="2" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="火" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FloorPriceBd" Grid.Column="3" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="底" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OcoFlagBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="OCO" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="PackBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="打包" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Border BorderThickness="0 0 0 1" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Grid.Row="1"/>
                                <TextBlock x:Name="publicMark" Grid.Row="2" Foreground="#FFFFFF" Text="{Binding PublicRemarks_InnerOfr, StringFormat={}公告:{0}}" VerticalAlignment="Bottom"/>
                                <!--<TextBlock x:Name="personalRemark" Grid.Row="3" Foreground="Wheat" VerticalAlignment="Bottom" Text="{Binding PersonalRemarks_InnerOfr}"/>-->
                            </Grid>

                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HurryFlag_InnerOfr}" Value="1">
                                <Setter TargetName="HurryFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SuggestFlag_InnerOfr}" Value="1">
                                <Setter TargetName="SuggestFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FireFlag_InnerOfr}" Value="1">
                                <Setter TargetName="FireFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FloorPrice_InnerOfr}" Value="1">
                                <Setter TargetName="FloorPriceBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerOfr}" Value="1">
                                <Setter TargetName="OcoFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerOfr}" Value="2">
                                <Setter TargetName="PackBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PublicRemarks_InnerOfr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                <Setter TargetName="publicMark" Property="Text" Value="(公告栏)"/>
                                <Setter TargetName="publicMark" Property="Foreground" Value="#3C3C3C"/>
                            </DataTrigger>
                            <!--<DataTrigger Binding="{Binding PersonalRemarks_InnerOfr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                <Setter TargetName="personalRemark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </UserControl.Template>
            </UserControl>

            <UserControl x:Key="Float_BestBid" FontWeight="Normal">
