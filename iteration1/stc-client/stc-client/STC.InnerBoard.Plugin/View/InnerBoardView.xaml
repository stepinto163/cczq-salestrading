<UserControl x:Class="STC.InnerBoard.Plugin.View.InnerBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.InnerBoard.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:localComp="clr-namespace:STC.InnerBoard.Plugin.View.Component"
             xmlns:card="clr-namespace:STC.Common.View.Card;assembly=STC.Common"
             xmlns:command="clr-namespace:STC.InnerBoard.Plugin.Command"
             xmlns:utils="clr-namespace:STC.InnerBoard.Plugin.Utils"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" Name="innerBoard"
             d:DesignHeight="450" d:DesignWidth="1500" Unloaded="UserControl_Unloaded"
             DataContextChanged="InnerBoardView_DataContextChanged" Loaded="innerBoard_Loaded"
             xmlns:con="clr-namespace:STC.InnerBoard.Plugin.Convertor"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <con:ColorConvertor x:Key="colorCon"/>
            <con:EmptyColorConvertor x:Key="emptyColorCon"/>
            <fcon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <con:RemainingTimeAndDaysOffStrConvetor x:Key="remainingTimeAndDaysOffStrConvetor"/>
            <con:DaysOffStrConverter x:Key="daysOffStrConverter"/>
            <fcon:StrContainsConvertor x:Key="strContainsConvertor"/>
            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <fcon:ReverseVisibilityConvertor x:Key="reversevisibilityConvertor"/>
            <fcon:StringConvertor x:Key="StringConvertor"/>
            <fcon:IsInnerConvertor x:Key="IsInnerConvertor"/>
            <SolidColorBrush x:Key="YellowForground" Color="#FFEBC8"/>
            <fcon:MultiBindingConverter x:Key="MultiBindingConverter"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            
            <Style x:Key="InnerBidPointPriceStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <!--<EventSetter Event="MouseDoubleClick" Handler="InnerBid_DataGridCell_MouseDoubleClick"/>-->
                <!--<EventSetter Event="MouseEnter" Handler="InnerBid_DataGridCell_MouseEnter"/>-->
            </Style>

            <Style x:Key="InnerOfrPointPriceStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <!--<EventSetter Event="MouseDoubleClick" Handler="InnerOfr_DataGridCell_MouseDoubleClick"/>-->
                <!--<EventSetter Event="MouseEnter" Handler="InnerOfr_DataGridCell_MouseEnter"/>-->
            </Style>

             <Style x:Key="SinglePointPriceStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <EventSetter Event="MouseDoubleClick" Handler="Single_DataGridCell_MouseDoubleClick"/>
            </Style>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource SinglePointPriceStyle}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FuzzyColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SecurityID}" Value="99999">
                        <Setter Property="Foreground" Value="#FFDA9A" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <!-- FrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Polygon Fill="#FFB60E" Points="6 -5.31777997e-15 0 7.42857143 4 7.42857143 2 13 8 5.57142857 3.99658203 5.57142857"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- NoFrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfNonFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="NF" Foreground="White">
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--内部看板-->
            <Style x:Key="TagGroupListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.Static.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.Static.Foreground}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="4 0 0 4"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="1" VerticalAlignment="Center" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource DefaultContextMenu}">
                                        <MenuItem x:Name="TagGroupMenu" Header="{Binding IfSubscribe, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='ifsubscribe_menu'}" Style="{DynamicResource DefaultMenuItem}" Click="TagGroupMenu_Click"/>
                                        <MenuItem x:Name="EditGroupMenu" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="EditGroupMenu_Click"/>
                                        <MenuItem x:Name="DelGroupMenu" Header="删除" Style="{DynamicResource DefaultMenuItem}" Click="DelGroupMenu_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Path x:Name="svg_path" Style="{DynamicResource subscrib_path}" Visibility="{Binding IfSubscribe, Converter={StaticResource visibilityConvertor}}" Margin="0 0 4 0"/>
                                    <!--<Image x:Name="subscribeImage" Source="/STC.Common;component/Images/订阅.png" Width="24" Height="24" Visibility="{Binding IfSubscribe, Converter={StaticResource visibilityConvertor}}"/>-->
                                    <ContentPresenter Grid.Column="1" x:Name="Cp" TextElement.FontSize="{TemplateBinding FontSize}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscribeImage" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscribeImage" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <UserControl x:Key="Float_Single" FontWeight="Normal">
                <UserControl.Template>
                    <ControlTemplate TargetType="{x:Type UserControl}">
                        <Border Name="Border" BorderThickness="1" CornerRadius="2" Background="{DynamicResource Tooltip.Background}" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Width="132" Height="{TemplateBinding Height}">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HurryFlagBd" Grid.Column="0" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="急" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="SuggestFlagBd" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="荐" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FireFlagBd" Grid.Column="2" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="火" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FloorPriceBd" Grid.Column="3" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="底" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OcoFlagBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="OCO" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="PackBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="打包" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Border BorderThickness="0 0 0 1" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Grid.Row="1"/>
                                <TextBlock x:Name="publicMark" Grid.Row="2" Foreground="#FFFFFF" Text="{Binding PublicRemarks, StringFormat={}公告:{0}}" VerticalAlignment="Bottom" />
                                <!--<TextBlock x:Name="personalRemark" Grid.Row="3" Foreground="Wheat" Text="{Binding PersonalRemarks}" VerticalAlignment="Bottom" />-->
                            </Grid>

                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HurryFlag}" Value="1">
                                <Setter TargetName="HurryFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SuggestFlag}" Value="1">
                                <Setter TargetName="SuggestFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FireFlag}" Value="1">
                                <Setter TargetName="FireFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FloorPrice}" Value="1">
                                <Setter TargetName="FloorPriceBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag}" Value="1">
                                <Setter TargetName="OcoFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag}" Value="2">
                                <Setter TargetName="PackBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PublicRemarks, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                <Setter TargetName="publicMark" Property="Text" Value="(公告栏)"/>
                                <Setter TargetName="publicMark" Property="Foreground" Value="#3C3C3C"/>
                            </DataTrigger>
                            <!--<DataTrigger Binding="{Binding PersonalRemarks, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                <Setter TargetName="personalRemark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </UserControl.Template>
            </UserControl>

