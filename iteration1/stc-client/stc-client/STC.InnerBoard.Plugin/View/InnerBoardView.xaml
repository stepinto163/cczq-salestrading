                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Outstanding_Amount, StringFormat={}{0:N2}}" Header="未偿还金额(亿)" Width="auto" MinWidth="120"/>
                            <DataGridTextColumn Binding="{Binding IssueAmount, StringFormat={}{0:N2}}" Header="发行量(亿)" Width="auto" MinWidth="120"/>
                            <DataGridTextColumn Binding="{Binding IssueType}" Header="募集类型"  Width="80" MinWidth="20" MaxWidth="300" IsReadOnly="True"/>
                            <DataGridTextColumn Binding="{Binding UpdateTime}" Header="最后更新时间" Width="Auto" MinWidth="80" CellStyle="{StaticResource FuzzyColumnColorStyle}"/>
                        </DataGrid.Columns>
                    </localComp:CustomInnerDataGrid>

                    <Grid x:Name="singleOperationGrid" Height="31" VerticalAlignment="Bottom" Visibility="{Binding IsSingleOperationGrid}" Grid.Row="3" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#000000" Opacity="0.75" IsHitTestVisible="False" BorderThickness="0 1 0 0" Grid.ColumnSpan="3"/>
                        <commComp:HoverButton x:Name="SingleCopyBtn" Content="复制" Width="100" Height="22" Margin="42,0,0,0" HorizontalAlignment="Left" Click="SingleCopyBtn_Click"
                                        Padding="1" Style="{ DynamicResource HoverButton}" FontSize="14"
                                        Background="{DynamicResource LightGrayButton.Static.Background}"
                                        BorderBrush="{DynamicResource LightGrayButton.Static.Border}"
                                        Foreground="#D7D7D7"
                                        PressBackground="{DynamicResource LightGrayButton.Pressed.Background}" 
                                        PressBorderBrush="{DynamicResource LightGrayButton.Pressed.Border}"
                                        HoverBackground="{DynamicResource LightGrayButton.MouseOver.Background}" 
                                        HoverBorderBrush="{DynamicResource LightGrayButton.MouseOver.Border}"/>

                        <commComp:HoverButton x:Name="SingleSendBtn" Content="推送" Width="100" Height="22" Margin="152,0,0,0" HorizontalAlignment="Left" Click="SingleSendBtn_Click" Visibility="Collapsed"
                                        Padding="1" Style="{ DynamicResource HoverButton}" FontSize="14"
                                        Background="{DynamicResource BlueGreenButton.Static.Background}"
                                        BorderBrush="{DynamicResource BlueGreenButton.Static.Border}"
                                        Foreground="#D7D7D7"
                                        PressBackground="{DynamicResource BlueGreenButton.Pressed.Background}" 
                                        PressBorderBrush="{DynamicResource BlueGreenButton.Pressed.Border}"
                                        HoverBackground="{DynamicResource BlueGreenButton.MouseOver.Background}" 
                                        HoverBorderBrush="{DynamicResource BlueGreenButton.MouseOver.Border}"/>

                    </Grid>


                    <Button x:Name="returnTopBtn" Content="回到顶部" Style="{DynamicResource InnerBoardButton}"  Grid.RowSpan="4"  VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0 0 0 15" Width="284" Height="24" Visibility="Collapsed" Click="returnTopBtn_Click"/>
                    <Button x:Name="returnTopBtn_refresh" Content="出现新数据，点击刷新" Style="{DynamicResource InnerBoardButton_refresh}"  Grid.RowSpan="4"  VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0 0 0 15" Width="284" Height="24" Visibility="Collapsed"  Click="returnTopBtn_Click"/>

                    <fUI:LoadingMask x:Name="SingleMask" Visibility="{Binding SingleLoadMaskVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.RowSpan="3" Grid.ColumnSpan="2"></fUI:LoadingMask>

                </Grid>
            </TabItem>

            <TabItem x:Name="historyreqTab" Header="历史需求"  Width="96" Visibility="{Binding IsShowIHR}" Style="{DynamicResource TabItemStyle_Button}">
                <local:InnerHistoryRequire x:Name="ihr_Inner"></local:InnerHistoryRequire>
            </TabItem>
        </TabControl>

        <commComp:RowCountBar x:Name="countBar" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="290 0 0 6" Visibility="Collapsed"
                              RowCount="{Binding RowCount}" BidRowCount="{Binding BidRowCount}" OfrRowCount="{Binding OfrRowCount}"/>
        <commComp:RowCountBar x:Name="countBar_best" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="290 0 0 6"
                              RowCount="{Binding RowCount_Best}" BidRowCount="{Binding BidRowCount_Best}" OfrRowCount="{Binding OfrRowCount_Best}" />
        <commComp:RowCountBar x:Name="countBar_H" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="290 0 0 6" Visibility="Collapsed"
                              RowCount="{Binding DataContext.RowCount, ElementName=ihr_Inner}"
                              BidRowCount="{Binding DataContext.BidRowCount, ElementName=ihr_Inner}"
                              OfrRowCount="{Binding DataContext.OfrRowCount, ElementName=ihr_Inner}"/>

        <Button x:Name="btnFullScreen" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PopupButton}" 
                    Command="{x:Static utils:CommonUtils.PopupWindowCommand}" Margin="0 0 10 4">
            <Button.CommandParameter>
                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                    <MultiBinding.Bindings>
                        <Binding Source="{x:Static command:PopupTypeEnum.InnerBoard}" Mode="OneWay"/>
                        <Binding ElementName="innerBoard"/>
                    </MultiBinding.Bindings>
                </MultiBinding>
            </Button.CommandParameter>
        </Button>


        <Button x:Name="btnVer" Grid.RowSpan="2" Grid.Column="1" Width="8" Height="40" Padding="0, 0, 0, 0" Margin="1, 0, 1, 0" Content=">" 
                FontSize="8" Style="{DynamicResource SplitButtonStyle}"  Panel.ZIndex="1" Click="BtnVer_Click"></Button>

        <!-- gridSplitter -->
        <GridSplitter x:Name="gridSplitter" Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource BackgroundBrush}" Style="{DynamicResource VGridSplitterStyleNoVer}"  DragCompleted="gridSplitter_DragCompleted"/>


        <Border BorderBrush="#282828" Margin="2" Grid.Column="2" Grid.RowSpan="2"  x:Name="Pov" BorderThickness="1" Background="#141414" Visibility="Visible">
            <!--<card:PriceAndOrderView x:Name="dgPrice"></card:PriceAndOrderView>-->
        </Border>
    </Grid>

</UserControl>
