                </UserControl.Template>
            </UserControl>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid x:Name="innerBorderGrid"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Row0"/>
            <ColumnDefinition Width="9" x:Name="Row1"/>
            <ColumnDefinition x:Name="Row2" Width="300"/>
        </Grid.ColumnDefinitions>


        <TabControl Name="InnerBoard_Bond_TC" Grid.RowSpan="2" Background="{DynamicResource MainTitleBackgroup.ColorBrush}" Style="{DynamicResource TabControlStyle1}" SelectionChanged="TabControl_SelectionChanged">
            <TabItem x:Name="bestTab" Header="最优" Width="96" Style="{DynamicResource TabItemStyle_Button}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
