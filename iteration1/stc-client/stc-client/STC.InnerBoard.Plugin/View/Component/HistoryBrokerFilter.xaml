<UserControl x:Class="STC.InnerBoard.Plugin.View.Component.HistoryBrokerFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.InnerBoard.Plugin.View.Component"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Horizontal" Height="30">
            
            <TextBlock x:Name="StyleLbl" Text="筛选:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="StyleListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="StyleListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="ALL" Style="{DynamicResource CommonFilterListBoxItemStyle}" IsSelected="True" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="已加入" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="未加入" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
               
            </ListBox>
          
          
        </StackPanel>
    </Grid>
</UserControl>
