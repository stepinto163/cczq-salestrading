<UserControl x:Class="STC.InnerBoard.Plugin.View.HistoryBrokerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:STC.InnerBoard.Plugin.View.Component"
            xmlns:fconv="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:ViewModel="clr-namespace:STC.InnerBoard.Plugin.ViewModel" 
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
            xmlns:CommonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:localComp="clr-namespace:STC.InnerBoard.Plugin.View.Component"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="1500" Initialized="UserControl_Initialized" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.InnerBoard.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <!--<sys:String x:Key="TimeFormatHHMMSS">HH:mm:ss</sys:String>
            <sys:String x:Key="TimeFormatYYYYMMDD">yyyy-MM-dd</sys:String>
            --><!--yyyy-MM-dd--><!--
            <sys:String x:Key="TimeFormatMMDDHHMM">MM-dd HH:mm</sys:String>
            --><!--MM-dd HH:mm-->
            <!--<sys:String x:Key="TimeFormatYYYYMMDD2">yyyyMMdd</sys:String>-->

            <!--<fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:SettleTypeConvertor x:Key="settleTypeConvertor"/>
            <fcon:TreasuryFutureConvertor x:Key="treasuryFutureConverter"/>
            <fcon:BondFieldConvertor x:Key="bondFieldConverter"/>
            <fcon:FormatDateTimeConvertor x:Key="FormatDateTimeConvertor"/>-->
            <sys:String x:Key="TimeFormatYYYYMMDDHHMM">yyyy-MM-dd HH:mm:ss</sys:String>
            <fconv:VisibilityConvertor x:Key="visibilityConvertor"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="true"/>
            </Style>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="risktypeColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="3">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Red7}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}" BasedOn="{DynamicResource DataGridCellStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" MouseEnter="ContentPresenter_MouseEnter">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="textBlock" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="VGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{DynamicResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <Rectangle Width="12" Height="1" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" Margin="0,2,0,2"/>
                                    <Rectangle Width="12" Height="1" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" Margin="0,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid Background="#141414">

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <local:HistoryBrokerFilter x:Name="historyFilter" RiskFilterDicChanged="historyFilter_RiskFilterDicChanged"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                
                
                <!--<Button x:Name="btnFullScreen" Width="24" Height="24" HorizontalAlignment="Left" 
                        VerticalAlignment="Center" Style="{DynamicResource ExportButton}"
                        Command="{Binding ExportCommand}"/>-->
            </StackPanel>
        </Grid>
        <!--<CommonComp:ExDataGrid x:Name="TPDataGrid" Grid.Row="1" Margin="0,0,20,0" AutoGenerateColumns="False" Style="{DynamicResource DefaultSelfDataGrid}" ItemsSource="{Binding BrokerHisDV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            RowHeaderWidth="0" >-->

        <localComp:CustomInnerDataGrid  Grid.Row="1" x:Name="Risk_dataGrid" Style="{DynamicResource DefaultDataGrid}"
                ItemsSource="{Binding BrokerHisDV}" 
                  LoadingRow="Risk_dataGrid_LoadingRow" RowHeaderWidth="0" Margin="10,0,10,0" 
                                SelectedItem="{Binding SelectedItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding updateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDDHHMM}}" 
                                    Header="最新报价时间" Width="*"   IsReadOnly="True" CanUserSort="False"/>


                <DataGridTextColumn Binding="{Binding senderId}" Width="*"   Header="QQ号码"  IsReadOnly="True" CanUserSort="False"/>

                <DataGridTextColumn Binding="{Binding senderName}" Width="*"   Header="QQ名称"  IsReadOnly="True" CanUserSort="False"/>

                <DataGridTemplateColumn Header="加入白名单" Width="100" MinWidth="45">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                        Style="{DynamicResource MainPageImageAddButton}" ToolTip="加入" 
                                            Visibility="{Binding AddBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>

                                    <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                        Style="{DynamicResource MainImageMinButton}" ToolTip="删除"  
                                            Visibility="{Binding DelBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.DelCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                   
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

              

            </DataGrid.Columns>
        </localComp:CustomInnerDataGrid>
        <CommonComp:PageControl x:Name="pageControl" Grid.Row="2" HorizontalAlignment="Right" 
                               PageChanged="pageControl_PageChanged" 
                               Visibility="{Binding PageVisible,Converter={StaticResource visibilityConvertor}}"/>

        <fUI:LoadingMask x:Name="loadMask" Visibility="Collapsed" Grid.RowSpan="3" Grid.Row="0"></fUI:LoadingMask>
    </Grid>
</UserControl>
