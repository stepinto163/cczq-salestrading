                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="原文" Width="90" MinWidth="60" SortMemberPath="Text">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock x:Name="TrdNameLb_display" Height="12"  Foreground="#FFFFFF" Text="{Binding Text}" VerticalAlignment="Center" TextAlignment="Left"  FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter='yyyy-MM-dd HH:mm:ss'}" Header="更新时间" Width="Auto" MinWidth="120" Foreground="{StaticResource YellowForground}"/>
                <DataGridTextColumn Binding="{Binding CreateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter='yyyy-MM-dd HH:mm:ss'}" Header="创建时间" Width="Auto" MinWidth="120" Foreground="{StaticResource YellowForground}"/>
                
                <DataGridTemplateColumn Header="中债估值" Width="auto" MinWidth="80" SortMemberPath="ChinaBondValuation">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ChinaBondValuationFull, Converter={StaticResource StringConvertor}, ConverterParameter='--'}" Foreground="{Binding ChinaBondValuationFull, Converter={StaticResource emptyColorCon}}"/>
                                <Image x:Name="DataInfo" Source="/STC.Common;component/Images/icon 更多信息.png" Margin="10 0 0 0" Width="12" Height="12"  Visibility="Collapsed" ToolTip="{Binding CCDCValuation_Date}"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowLastWorkDay}" Value="!">
                                    <Setter Property="Visibility" TargetName="DataInfo" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="中债行权" Width="auto" MinWidth="80" SortMemberPath="ChinaBondExercise">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ChinaBondExercise, Converter={StaticResource numConvertor}, ConverterParameter=0}" Foreground="{Binding ChinaBondExercise, Converter={StaticResource emptyColorCon}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="中债到期" Width="auto" MinWidth="80" SortMemberPath="ChinaBondDue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ChinaBondDue, Converter={StaticResource numConvertor}, ConverterParameter=0}" Foreground="{Binding ChinaBondDue, Converter={StaticResource emptyColorCon}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Binding="{Binding CCDCValuation,Converter={StaticResource numConvertor}}" Header="中债估值" Width="auto" MinWidth="80"/>-->
                <DataGridTemplateColumn Header="中债估值偏离" Width="auto" MinWidth="80" SortMemberPath="CCDCValuation_BP">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip>
                                        偏离计算公式："bid偏离=bid报价-中债"，"ofr偏离=中债-ofr报价"
                                    </ToolTip>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CCDCValuation_BP,Converter={StaticResource numConvertor},ConverterParameter='bp'}" Foreground="{Binding CCDCValuation_BP, Converter={StaticResource emptyColorCon}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="中证估值" Width="auto" MinWidth="80" SortMemberPath="CsiBondValuation">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CsiBondValuationFull, Converter={StaticResource StringConvertor}, ConverterParameter='--'}" Foreground="{Binding CsiBondValuationFull, Converter={StaticResource emptyColorCon}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="中证行权" Width="auto" MinWidth="80" SortMemberPath="ChinaBondExercise">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CsiBondValuationExercise, Converter={StaticResource numConvertor}, ConverterParameter=0}" Foreground="{Binding CsiBondValuationExercise, Converter={StaticResource emptyColorCon}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="中证到期" Width="auto" MinWidth="80" SortMemberPath="ChinaBondDue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CsiBondValuationDue, Converter={StaticResource numConvertor}, ConverterParameter=0}" Foreground="{Binding CsiBondValuationDue, Converter={StaticResource emptyColorCon}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="中证估值偏离" Width="auto" MinWidth="80" SortMemberPath="CsiValuation_BP">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip>
                                        偏离计算公式："bid偏离=bid报价-中证"，"ofr偏离=中证-ofr报价"
                                    </ToolTip>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CsiValuation_BP,Converter={StaticResource numConvertor},ConverterParameter='bp'}" Foreground="{Binding CsiValuation_BP, Converter={StaticResource emptyColorCon}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding Rating}" Header="评级信息" Width="Auto" MinWidth="80" Foreground="{StaticResource YellowForground}"/>
                <DataGridTextColumn Binding="{Binding Cdc_Implited_Rating}" Header="中债隐含" Width="Auto" MinWidth="85" ClipboardContentBinding="{Binding Cdc_Implited_Rating}" Foreground="{StaticResource YellowForground}"/>


                <!--<DataGridTemplateColumn Header="Client" Width="auto" MinWidth="80" SortMemberPath="Client">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Client}" Foreground="{Binding Client, Converter={StaticResource colorCon}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <!--<DataGridTextColumn Binding="{Binding Info1}" Header="Info1" Width="Auto" MinWidth="80"/>-->
                <!--<DataGridTextColumn Binding="{Binding NetPrice}" Header="净价" Width="Auto" MinWidth="80"/>-->
                <!--<DataGridTextColumn Binding="{Binding TermDays}" Header="剩余天数" Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Binding="{Binding CouponRateCurrent}" Header="票面" Width="Auto" MinWidth="80"/>-->
                <DataGridTemplateColumn  Header="发行人" Width="100" MinWidth="60" SortMemberPath="IssuerName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="IssuerNameTB" Text="{Binding IssuerName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding IssuerName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding IssueType}" Header="募集类型"  Width="80" MinWidth="20" MaxWidth="300" IsReadOnly="True"/>
            </DataGrid.Columns>
        </localComp:CustomInnerDataGrid>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="5" Visibility="{Binding EMSPageVisible,Converter={StaticResource visibilityConvertor}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="100"></ColumnDefinition>
                    <ColumnDefinition ></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{DynamicResource DefaultGridForground}" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Run Text="总计"></Run>
                        <Run Text="{Binding TotalCount}"></Run>
                        <Run Text="条"></Run>
                </TextBlock>
                
                <comp:PageControl x:Name="EMSPageControl"  HorizontalAlignment="Right" Grid.Column="2" PageChanged="EMSPageControl_PageChanged"
                                    Visibility="{Binding EMSPageVisible,Converter={StaticResource visibilityConvertor}}"/>
            </Grid>
            
        </StackPanel>

        <fUI:LoadingMask x:Name="positionloadMask" Visibility="{Binding LoadMaskVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.RowSpan="2" Grid.ColumnSpan="2"
                         IsVisibleChanged="positionloadMask_IsVisibleChanged"></fUI:LoadingMask>
    </Grid>
</UserControl>
