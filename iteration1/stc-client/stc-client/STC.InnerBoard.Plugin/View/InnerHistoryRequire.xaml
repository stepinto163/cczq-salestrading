<UserControl x:Class="STC.InnerBoard.Plugin.View.InnerHistoryRequire"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.InnerBoard.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:localComp="clr-namespace:STC.InnerBoard.Plugin.View.Component"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             xmlns:con="clr-namespace:STC.InnerBoard.Plugin.Convertor"
             xmlns:ComCon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             d:DesignHeight="450" d:DesignWidth="1120">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <con:ColorConvertor x:Key="colorCon"/>
            <con:EmptyColorConvertor x:Key="emptyColorCon"/>
            <con:RemainingTimeAndDaysOffStrConvetor x:Key="remainingTimeAndDaysOffStrConvetor"/>
            <con:DaysOffStrConverter x:Key="daysOffStrConverter"/>
            <ComCon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <SolidColorBrush x:Key="DataGridBackGround" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="DefaultDisableForground" Color="#A0A0A0"/>
            <SolidColorBrush x:Key="DefaultGridForground" Color="#D7D7D7"/>
            <SolidColorBrush x:Key="YellowForground" Color="#FFEBC8"/>

            <!-- 居中 -->
            <Style x:Key="DataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="DataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Right"/>
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="DataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Left"/>
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>

            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--标签-->
            <Style x:Key="SelfTagGroupListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.Static.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.Static.Foreground}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="4 0 0 4"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="1" VerticalAlignment="Center" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="svg_path" Style="{DynamicResource subscrib_path}" Visibility="{Binding IfSubscribe, Converter={StaticResource visibilityConvertor}}" Margin="0 0 4 0"/>
                                    <!--<Image x:Name="subscribeImage" Source="/STC.Common;component/Images/订阅.png" Width="24" Height="24" Visibility="{Binding IfSubscribe, Converter={StaticResource visibilityConvertor}}"/>-->
                                    <ContentPresenter Grid.Column="1" x:Name="Cp" TextElement.FontSize="{TemplateBinding FontSize}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscribeImage" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscribeImage" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <UserControl x:Key="Float_BestOfr" FontWeight="Normal">
                <UserControl.Template>
                    <ControlTemplate TargetType="{x:Type UserControl}">
                        <Border Name="Border" BorderThickness="1" CornerRadius="2" Background="{DynamicResource Tooltip.Background}" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Width="132" Height="{TemplateBinding Height}">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HurryFlagBd" Grid.Column="0" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="急" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="SuggestFlagBd" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="荐" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FireFlagBd" Grid.Column="2" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="火" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FloorPriceBd" Grid.Column="3" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="底" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OcoFlagBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="OCO" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="PackBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="打包" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Border BorderThickness="0 0 0 1" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Grid.Row="1"/>
                                <TextBlock x:Name="publicMark" Grid.Row="2" Foreground="#FFFFFF" Text="{Binding PublicRemarks_InnerOfr, StringFormat={}公告:{0}}" VerticalAlignment="Bottom"/>
                                <!--<TextBlock x:Name="personalRemark" Grid.Row="3" Foreground="Wheat" Text="{Binding PersonalRemarks_InnerOfr}" VerticalAlignment="Bottom"/>-->
                            </Grid>

                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HurryFlag_InnerOfr}" Value="1">
                                <Setter TargetName="HurryFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SuggestFlag_InnerOfr}" Value="1">
                                <Setter TargetName="SuggestFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FireFlag_InnerOfr}" Value="1">
                                <Setter TargetName="FireFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FloorPrice_InnerOfr}" Value="1">
                                <Setter TargetName="FloorPriceBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerOfr}" Value="1">
                                <Setter TargetName="OcoFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerOfr}" Value="2">
                                <Setter TargetName="PackBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PublicRemarks_InnerOfr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                <Setter TargetName="publicMark" Property="Text" Value="(公告栏)"/>
                                <Setter TargetName="publicMark" Property="Foreground" Value="#3C3C3C"/>
                            </DataTrigger>
                            <!--<DataTrigger Binding="{Binding PersonalRemarks_InnerOfr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                <Setter TargetName="personalRemark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </UserControl.Template>
            </UserControl>

            <UserControl x:Key="Float_BestBid" FontWeight="Normal">
                <UserControl.Template>
                    <ControlTemplate TargetType="{x:Type UserControl}">
                        <Border Name="Border" BorderThickness="1" CornerRadius="2" Background="{DynamicResource Tooltip.Background}" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Width="132" Height="{TemplateBinding Height}">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HurryFlagBd" Grid.Column="0" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="急" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="SuggestFlagBd" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="荐" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FireFlagBd" Grid.Column="2" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="火" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FloorPriceBd" Grid.Column="3" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="底" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OcoFlagBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="OCO" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="PackBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="打包" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Border BorderThickness="0 0 0 1" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Grid.Row="1"/>
                                <TextBlock x:Name="publicMark" Grid.Row="2" Foreground="#FFFFFF" Text="{Binding PublicRemarks_InnerBid, StringFormat={}公告:{0}}" VerticalAlignment="Bottom"/>
                                <!--<TextBlock x:Name="personalRemark" Grid.Row="3" Foreground="Wheat" Text="{Binding PersonalRemarks_InnerBid}" VerticalAlignment="Bottom"/>-->
                            </Grid>

                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HurryFlag_InnerBid}" Value="1">
                                <Setter TargetName="HurryFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SuggestFlag_InnerBid}" Value="1">
                                <Setter TargetName="SuggestFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FireFlag_InnerBid}" Value="1">
                                <Setter TargetName="FireFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FloorPrice_InnerBid}" Value="1">
                                <Setter TargetName="FloorPriceBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerBid}" Value="1">
                                <Setter TargetName="OcoFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerBid}" Value="2">
                                <Setter TargetName="PackBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PublicRemarks_InnerBid, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                <Setter TargetName="publicMark" Property="Text" Value="(公告栏)"/>
                                <Setter TargetName="publicMark" Property="Foreground" Value="#3C3C3C"/>
                            </DataTrigger>
                            <!--<DataTrigger Binding="{Binding PersonalRemarks_InnerBid, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                <Setter TargetName="personalRemark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </UserControl.Template>
            </UserControl>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource  MainBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!--左标题区-->
        <StackPanel Orientation="Horizontal">
            <Button Content="+ 新增需求" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"  Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Command="{Binding NewRequireCommand}"/>
            <Button Content="批量识别" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Command="{Binding OpenRecognizeWinCommand}"/>
            <Button Content="+模糊" x:Name="btnFuzzyRequire" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Click="btnFuzzyRequire_Click" Visibility="{Binding IsShowFuzzy}"/>
            <Grid Margin="6 0 0 0" x:Name="single">
                <RadioButton x:Name="SingleRd_ALL" Content="全" Height="24" Width="24" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource AllRadioButtonStyle}" IsChecked="True" Click="Single_Click"  ToolTip="全部债券"/>
                <RadioButton x:Name="SingleRd_R" Content="利率"  Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource RateRadioButtonStyle}" Margin="26 0 0 0" Click="Single_Click"  ToolTip="仅利率"/>
                <RadioButton x:Name="SingleRd_C" Content="信用" Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource CreditRadioButtonStyle}" Margin="64 0 0 0" Click="Single_Click"  ToolTip="仅信用"/>
            </Grid>
        </StackPanel>
        <!--右标题区-->
        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" >
            <commComp:SearchTextBox x:Name="Search_TextBox_Best" HintText="搜索..." ToolTip="可模糊查询债券代码、债券简称、客户机构、客户名、Trader、操作人、发行人、担保人"  HorizontalAlignment="Right" VerticalAlignment="Center" SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="24" IsFuzzy="True" IsMagnifierMode="False"
                                    MouseOverBorderBrush="{DynamicResource TextBox.MouseOver.Border}" FocusBorderBrush="{DynamicResource TextBox.Focus.Border}"/>
            <Button x:Name="RefreshBtn_Best" Width="24" Height="24" Style="{DynamicResource RefreshButton_24}"  Command="{Binding RefreshCommand}"  HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Rectangle Width="1" Height="16" Fill="#3C3C3C" HorizontalAlignment="Right"/>
            <Button x:Name="singleToggleBt0n" Width="24" Height="24" Style="{DynamicResource CollapsedButton_24}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="singleToggleBtn_Best_Click"/>
        </StackPanel>

        <!--过滤筛选-->
        <localComp:InnerBoardFilterPanel_New x:Name="HistoryFilterPanel"  Grid.Row="1" Grid.ColumnSpan="2" Visibility4IsMe="Visible" IsMe="{Binding IsMe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartTermDY="{Binding StartTermDY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndTermDY="{Binding EndTermDY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsAppTerm="{Binding IsAppTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            FocusTags="{Binding FocusTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartCoupon="{Binding StartCoupon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndCoupon="{Binding EndCoupon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsCoupon="{Binding IsCoupon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartPrice="{Binding StartPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            EndPrice="{Binding EndPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartChinaBondValue="{Binding StartChinaBondValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            EndChinaBondValue="{Binding EndChinaBondValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartBidBp="{Binding StartBidBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndBidBp="{Binding EndBidBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartOfrBp="{Binding StartOfrBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndOfrBp="{Binding EndOfrBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsFuzzy="{Binding IsFuzzy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SaveAction="Save_Click" EditAction="EditGroup_Click" IsShowSaveEdit="Collapsed" 
    VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling"
    ScrollViewer.IsDeferredScrollingEnabled="True" 
                                             ShowAllAction="HistoryFilterPanel_ShowAllAction"/>
        <!--多标签-->
        <Grid  Grid.Row="2" Grid.ColumnSpan="2"  >
            <ListBox x:Name="ProfileListBox"  Background="Black" VerticalAlignment="Center" SelectionMode="Single"
                                     ItemsSource="{Binding  ViewSource_Tag.View}" 
                                     SelectedItem="{Binding SelectedItem_Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseDown="ProfileListBox_PreviewMouseDown" SelectionChanged="ProfileListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelfTagGroupListBoxItemStyle}">
                        <Setter Property="Content" Value="{Binding GroupName}"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
        
        <!--恢复按钮和撤销类型过滤部分-->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" x:Name="ExtendFilterPanel" MaxHeight="30">
            <Button x:Name="ShowAll_ToggleButton" Content="恢复报价"  Command="{Binding BatchResumeCommand}" Width="80" Height="24" Margin="10 1 0 4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0 1 0 0" Style="{DynamicResource BlueGreenStyle}"/>
            <TextBlock Text="撤销类型" VerticalAlignment="Center" Foreground="{DynamicResource Button.Static.Foreground}" Margin="4,0,0,0"></TextBlock>
            <comp:MultiSelectComboBox x:Name="cmbcancelordertype" Tag="CancelOrderType"  Width="180" Height="24" Background="Black" Margin="4 1 0 4" DefaultText="不限" FilterDicChanged="cmbcancelordertype_FilterDicChanged">
            </comp:MultiSelectComboBox>

        </StackPanel>
        
        <!--恢复报价日期过滤部分-->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" x:Name="ExtendFilterPanel2" MaxHeight="30">
            <ListBox x:Name="TimeLimitListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Single" SelectedIndex="{Binding TimeLimitSelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="今天" Tag="Today" Style="{DynamicResource  InnerBoardFilterListBoxItemDodgerBlueStyle}" />
                <ListBoxItem Content="昨天" Tag="YesterDay" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="60" Margin="4,0,0,0"/>
                <ListBoxItem Content="最近7天" Tag="Last7Days" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}"  IsSelected="True" Width="60" Margin="4,0,0,0"/>
                <ListBoxItem Content="最近30天" Tag="Last30Days"  Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="60" Margin="4,0,0,0"/>
                <ListBoxItem Content="不限" Tag="UnLimited"  Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="60" Margin="4,0,0,0"/>
            </ListBox>

            <CheckBox VerticalAlignment="Center" Content=" 按日期查询" Margin="4,0,0,0" Visibility="Collapsed" IsChecked="{Binding DealTimeChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource  DefaultCheckBoxStyle}" Foreground="#D7D7D7" BorderBrush="{DynamicResource ColorBrush.Gray15}" ></CheckBox>

            <DatePicker x:Name="dateStartPicker" Grid.Column="1" Width="90" Height="24" Margin="4, 0, 0, 0" SelectedDate="{Binding DealTimeBegin,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBlueDatePickerStyle}" Foreground="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Foreground}"
                                                    Background="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Background}" BorderBrush="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Border}">
              <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="IsReadOnly" Value="True"/>
                    </Style>
                </DatePicker.Resources>
            </DatePicker>
