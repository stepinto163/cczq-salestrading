<UserControl x:Class="STC.InnerBoard.Plugin.View.InnerDepthPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.InnerBoard.Plugin.View"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:localComp="clr-namespace:STC.InnerBoard.Plugin.View.Component"
             mc:Ignorable="d" 
             FontSize="12"
             Foreground="#515151" Width="980" Height="{Binding ViewHeight}"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->

            <!-- FrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Polygon Fill="#FFB60E" Points="6 -5.31777997e-15 0 7.42857143 4 7.42857143 2 13 8 5.57142857 3.99658203 5.57142857"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- NoFrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfNonFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="NF" Foreground="White">
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <UserControl x:Key="Float_BestOfr" FontWeight="Normal">
                <UserControl.Template>
                    <ControlTemplate TargetType="{x:Type UserControl}">
                        <Border Name="Border" BorderThickness="1" CornerRadius="2" Background="{DynamicResource Tooltip.Background}" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Width="132" Height="{TemplateBinding Height}">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HurryFlagBd" Grid.Column="0" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="急" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="SuggestFlagBd" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="荐" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FireFlagBd" Grid.Column="2" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="火" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FloorPriceBd" Grid.Column="3" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="底" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OcoFlagBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="OCO" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="PackBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="打包" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Border BorderThickness="0 0 0 1" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Grid.Row="1"/>
                                <TextBlock x:Name="publicMark" Grid.Row="2" Foreground="#FFFFFF" Text="{Binding PublicRemarks_InnerOfr, StringFormat={}公告:{0}}" VerticalAlignment="Bottom" />
                                <!--<TextBlock x:Name="personalRemark" Grid.Row="3" Foreground="Wheat" Text="{Binding PersonalRemarks_InnerOfr}" VerticalAlignment="Bottom" />-->
                            </Grid>

                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HurryFlag_InnerOfr}" Value="1">
                                <Setter TargetName="HurryFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SuggestFlag_InnerOfr}" Value="1">
                                <Setter TargetName="SuggestFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FireFlag_InnerOfr}" Value="1">
                                <Setter TargetName="FireFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FloorPrice_InnerOfr}" Value="1">
                                <Setter TargetName="FloorPriceBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerOfr}" Value="1">
                                <Setter TargetName="OcoFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerOfr}" Value="2">
                                <Setter TargetName="PackBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PublicRemarks_InnerOfr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                <Setter TargetName="publicMark" Property="Text" Value="(公告栏)"/>
                                <Setter TargetName="publicMark" Property="Foreground" Value="#3C3C3C"/>
                            </DataTrigger>
                            <!--<DataTrigger Binding="{Binding PersonalRemarks_InnerOfr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                <Setter TargetName="personalRemark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </UserControl.Template>
            </UserControl>

            <UserControl x:Key="Float_BestBid" FontWeight="Normal">
                <UserControl.Template>
                    <ControlTemplate TargetType="{x:Type UserControl}">
                        <Border Name="Border" BorderThickness="1" CornerRadius="2" Background="{DynamicResource Tooltip.Background}" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Width="132" Height="{TemplateBinding Height}">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="20"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="HurryFlagBd" Grid.Column="0" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="急" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="SuggestFlagBd" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="荐" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FireFlagBd" Grid.Column="2" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="火" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="FloorPriceBd" Grid.Column="3" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="底" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="OcoFlagBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="OCO" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="PackBd" Grid.Column="4" Background="{DynamicResource TextBox.Focus.Border}" Width="36" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="0 0 2 0" HorizontalAlignment="Left">
                                        <TextBlock Text="打包" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Border BorderThickness="0 0 0 1" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Grid.Row="1"/>
                                <TextBlock x:Name="publicMark" Grid.Row="2" Foreground="#FFFFFF" Text="{Binding PublicRemarks_InnerBid, StringFormat={}公告:{0}}" VerticalAlignment="Bottom"/>
                                <!--<TextBlock x:Name="personalRemark" Grid.Row="3" Foreground="Wheat" Text="{Binding PersonalRemarks_InnerBid}" VerticalAlignment="Bottom"/>-->
                            </Grid>

                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HurryFlag_InnerBid}" Value="1">
                                <Setter TargetName="HurryFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SuggestFlag_InnerBid}" Value="1">
                                <Setter TargetName="SuggestFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FireFlag_InnerBid}" Value="1">
                                <Setter TargetName="FireFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FloorPrice_InnerBid}" Value="1">
                                <Setter TargetName="FloorPriceBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerBid}" Value="1">
                                <Setter TargetName="OcoFlagBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OCOFlag_InnerBid}" Value="2">
                                <Setter TargetName="PackBd" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PublicRemarks_InnerBid, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                <Setter TargetName="publicMark" Property="Text" Value="(公告栏)"/>
                                <Setter TargetName="publicMark" Property="Foreground" Value="#3C3C3C"/>
                            </DataTrigger>
                            <!--<DataTrigger Binding="{Binding PersonalRemarks_InnerBid, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                <Setter TargetName="personalRemark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>-->
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </UserControl.Template>
            </UserControl>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="2" Grid.Row="0" CornerRadius="4" BorderBrush="#A0A0A0"  Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Height="24" Margin="0,4,0,0" x:Name="TitlePanel"  HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Margin="6, 4, 0, 0" Text="{Binding SecurityID}" x:Name="TextBlockSecurity" Foreground="{DynamicResource LogDefaultFontBrush}" FontSize="14" FontWeight="Bold"></TextBlock>
                <TextBlock Margin="6, 4, 0, 0" Text="{Binding Symbol}" Foreground="{DynamicResource LogDefaultFontBrush}"  ToolTip="{Binding Symbol}" FontSize="14" FontWeight="Bold" ></TextBlock>
            </StackPanel>

            <Button x:Name="JOIN" Content="JOIN" Width="64" Height="24" Margin="0,0,70,0" HorizontalAlignment="Right" Style="{DynamicResource GrayButtonStyle2}" Click="JOIN_Click"  BorderBrush="#3C3C3C" BorderThickness="0 1 0 0" Background="#282828"/>
            <Button x:Name="REF" Content="REF" Width="64" Height="24" Margin="0,0,4,0" HorizontalAlignment="Right" Style="{DynamicResource GrayButtonStyle2}" Click="REF_Click"  BorderBrush="#3C3C3C" BorderThickness="0 1 0 0" Background="#282828"/>

            <localComp:CustomInnerDataGrid x:Name="depthDg" Grid.Row="1" Style="{DynamicResource DefaultDataGrid}" ItemsSource="{Binding ViewSource.View}" MouseDoubleClick="depthDg_MouseDoubleClick" IsColumnSetting="False"
                      SelectedItem="{Binding SelectedDepthData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HeadersVisibility="None" MouseRightButtonDown="depthDg_MouseRightButtonDown">
                <localComp:CustomInnerDataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource  DataGridCellStyle}">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </localComp:CustomInnerDataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="dgMenu_Best" Style="{DynamicResource DefaultContextMenu}" Opened="dgMenu_Best_Opened">
                        <MenuItem x:Name="JoinMenu_Best" Header="Join" Style="{DynamicResource DefaultMenuItem}" Click="JoinMenu_Best_Click"/>
                        <MenuItem x:Name="PointPriceMenu_Best" Header="点价" Style="{DynamicResource DefaultMenuItem}" Click="PointPriceMenu_Best_Click"/>
                        <MenuItem x:Name="ReplyPriceMenu_Best" Header="回价" Style="{DynamicResource DefaultMenuItem}" Click="ReplyPriceMenu_Best_Click"/>
                        <MenuItem x:Name="REFMenu_Best" Header="REF" Style="{DynamicResource DefaultMenuItem}" Click="REFMenu_Best_Click"/>
                        <MenuItem x:Name="EditMenu_Best" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="EditMenu_Best_Click"/>
                        <MenuItem x:Name="ConsiderationMenu_Best" Header="报对价" Style="{DynamicResource DefaultMenuItem}" Click="ConsiderationMenu_Best_Click"/>
                        <MenuItem x:Name="CopyMenu_Best" Header="复制" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_Best_Click"/>
                        <!--<MenuItem x:Name="SearchMenu_Best" Header="搜索该券" Style="{DynamicResource DefaultMenuItem}" Click="SearchMenu_Best_Click"/>-->
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="报价时间(B)" Width="70" Binding="{Binding UpdateTime_InnerBid}"  CellStyle="{DynamicResource DataGridTextLeftStyle}"/>
                    <DataGridTemplateColumn Header="Client(B)" Width="60" CellStyle="{DynamicResource DataGridTextLeftStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Client_InnerBid}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Client_InnerBid}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Trader(B)" Width="11*" CellStyle="{DynamicResource DataGridTextCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="isMeBorder_bid" CornerRadius="2" Background="#853629" Width="16" Height="16" Visibility="Collapsed" Margin="0,0,1,0" >
                                        <TextBlock Text="我" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding PartySubName_InnerBid}" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding PartySubName_InnerBid}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMe_InnerBid}" Value="true">
                                        <Setter TargetName="isMeBorder_bid" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Vol.Bid" Width="12*" CellStyle="{DynamicResource DataGridTextLeftStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="qtyTB_InnerBid" Text="{Binding Qty_InnerBid, Converter={StaticResource StringConvertor}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                                          ToolTip="{Binding Qty_InnerBid, Converter={StaticResource StringConvertor}}"/>
                                    <Border x:Name="wholeTag_InnerBid" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" Margin="1 0 0 0" CornerRadius="1" Visibility="Collapsed">
                                        <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="reply_InnerBid" Grid.Column="2" Content="未回" Height="18" Width="40" Style="{DynamicResource RedButtonStyle2}" Visibility="Collapsed" Click="ConsiderationMenu_Best_Click"/>
                                    <!--<Border x:Name="reply_InnerBid" Grid.Column="2" CornerRadius="6" Width="36" Background="#136C5E" Visibility="Collapsed" Margin="1 0 0 0">
                                        <TextBlock Text="未回" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>-->
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding WholeFlag_InnerBid}" Value="1">
                                        <Setter TargetName="wholeTag_InnerBid" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Count_InnerBid}" Value="0">
                                        <Setter TargetName="qtyTB_InnerBid" Property="Text" Value=""/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DQType_InnerBid}" Value="!">
                                        <Setter TargetName="reply_InnerBid" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Bid" Width="13*" CellStyle="{DynamicResource DataGridTextCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="17"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="17"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- fq标签 -->
                                    <Grid Grid.Column="0" MouseEnter="BestBid_Arrow_MouseEnter" MouseLeave="BestBid_Arrow_MouseLeave">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Polygon x:Name="BidArrow" Stroke="#FFFFFF" StrokeThickness="0" Fill="#FB943C" Points="0,0 0,10 10,0" HorizontalAlignment="Left" Visibility="Collapsed">
                                        </Polygon>
                                        <Border x:Name="BidFqTag" Grid.Row="1" Background="{DynamicResource TextBox.Focus.Border}" Cursor="2" BorderThickness="0" Visibility="Collapsed" Width="10" Height="10">
                                            <TextBlock Text="底" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontSize="10"/>
                                        </Border>
                                    </Grid>

                                    <!-- 大拇指 -->
                                    <Image x:Name="thumbImage" Grid.Column="1" Source="/STC.Common;component/Images/大拇指.png" Width="10" Height="10" Visibility="Collapsed" Margin="1,0,0,0"/>

                                    <!--价格标签-->
                                    <Border x:Name="priceType_bd_InnerBid" Width="16" Height="16" BorderThickness="1" Visibility="Collapsed" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="priceType_txt_InnerBid" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontSize="12"/>
                                    </Border>

                                    <!-- 价格 -->
                                    <TextBlock x:Name="priceTB_InnerBid" Grid.Column="3" Text="{Binding Price_Display_InnerBid, StringFormat={}{0:0.00##}, Converter={StaticResource StringConvertor}, ConverterParameter='Bid'}" Foreground="{DynamicResource ColorBrush.Orange}" FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>

                                    <!-- 意向图标 -->
                                    <Image x:Name="firmbtn" Source="/STC.Common;component/Images/Firm.png" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="1,0,0,0" Grid.Column="4"
                                                       Visibility="Collapsed"/>
                                    <Button x:Name="nonfirmbtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="1,0,0,0" Grid.Column="4"
                                                        Style="{DynamicResource SelfNonFirmButton}" Visibility="Collapsed">
                                    </Button>
                                    <TextBlock x:Name="intentionTB" Text="(意)" Width="20" Height="18" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="1,0,0,0" Grid.Column="4"
                                                       Visibility="Collapsed"></TextBlock>
                                    
                                    <!-- 清算速度 -->
                                    <Border x:Name="T0" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#6E2022" BorderThickness="0" Margin="1,0,0,0" Grid.Column="5">
                                        <TextBlock Text="+0" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    </Border>
                                    <Border x:Name="YuanQi" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#3C3C3C" BorderThickness="0" Margin="1,0,0,0" Grid.Column="5">
                                        <TextBlock Text="远" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" 
                                                    ToolTip="{Binding SettleType_InnerBid, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_tooltip'}"/>
                                    </Border>
                                    <Border x:Name="duo" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#6E2022" BorderThickness="0" Margin="1,0,0,0" Grid.Column="5">
                                        <TextBlock Text="多" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding PriceType_InnerBid}" Value="7">
                                        <Setter TargetName="priceType_bd_InnerBid" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="priceType_bd_InnerBid" Property="BorderBrush" Value="#964E00"/>
                                        <Setter TargetName="priceType_txt_InnerBid" Property="Text" Value="权"/>
                                        <Setter TargetName="priceType_txt_InnerBid" Property="Foreground" Value="#964E00"/>
                                    </DataTrigger>
                                    <!--净价-->
                                    <DataTrigger Binding="{Binding PriceType_InnerBid}" Value="1">
                                        <Setter TargetName="priceType_bd_InnerBid" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="priceType_bd_InnerBid" Property="BorderBrush" Value="Green"/>
                                        <Setter TargetName="priceType_txt_InnerBid" Property="Text" Value="N"/>
                                        <Setter TargetName="priceType_txt_InnerBid" Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <!--全价-->
                                    <DataTrigger Binding="{Binding PriceType_InnerBid}" Value="2">
                                        <Setter TargetName="priceType_bd_InnerBid" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="priceType_bd_InnerBid" Property="BorderBrush" Value="#FB943C"/>
                                        <Setter TargetName="priceType_txt_InnerBid" Property="Text" Value="F"/>
                                        <Setter TargetName="priceType_txt_InnerBid" Property="Foreground" Value="#FB943C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettleType_InnerBid}" Value="1">
                                        <Setter TargetName="T0" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettleType_InnerBid}" Value="4">
                                        <Setter TargetName="YuanQi" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettleType_InnerBid,Converter={StaticResource strContainsConvertor}, ConverterParameter='+'}" Value="true">
                                        <Setter TargetName="YuanQi" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding FirmFlag_InnerBid}" Value="0">
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Visible"/>
