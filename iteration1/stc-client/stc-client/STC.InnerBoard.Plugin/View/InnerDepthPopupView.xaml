                                                                Fill="Red" Visibility="{Binding IsRisk, Converter={StaticResource visibilityConvertor}}"/>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding RiskInfo}" Grid.Column="1">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Text}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ofr" Width="13*" CellStyle="{DynamicResource DataGridTextCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="17"/>
                                        <ColumnDefinition Width="10"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 清算速度 -->
                                    <Border x:Name="T0" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#6E2022" BorderThickness="0" Margin="0,0,1,0" Grid.Column="0">
                                        <TextBlock Text="+0" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    </Border>
                                    <Border x:Name="YuanQi" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#3C3C3C" BorderThickness="0" Margin="0,0,1,0" Grid.Column="0">
                                        <TextBlock Text="远" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" 
                                                    ToolTip="{Binding SettleType_InnerOfr, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_tooltip'}"/>
                                    </Border>
                                    <Border x:Name="duo" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#6E2022" BorderThickness="0" Margin="0,0,1,0" Grid.Column="0">
                                        <TextBlock Text="多" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8" />
                                    </Border>

                                    <!-- 意向图标 -->
                                    <Image x:Name="firmbtn" Source="/STC.Common;component/Images/Firm.png" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Left"   
                                           Margin="0,0,1,0" Grid.Column="1" Visibility="Collapsed"/>
                                    <Button x:Name="nonfirmbtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Style="{DynamicResource SelfNonFirmButton}" Visibility="Collapsed" Margin="0,0,1,0" Grid.Column="1">
                                    </Button>
                                    <TextBlock x:Name="intentionTB" Text="(意)" Width="20" Height="18" VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                                                       Visibility="Collapsed" Margin="0,0,1,0" Grid.Column="1"></TextBlock>

                                    <!-- 价格标签 -->
                                    <Border x:Name="priceType_bd_InnerOfr" Grid.Column="2" Width="16" Height="16" BorderThickness="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="priceType_txt_InnerOfr" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontSize="12"/>
                                    </Border>

                                    <TextBlock x:Name="priceTB_InnerOfr" Text="{Binding Price_Display_InnerOfr, StringFormat={}{0:0.00##}, Converter={StaticResource StringConvertor}, ConverterParameter='Ofr'}" Foreground="{DynamicResource ColorBrush.Blue}" FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" 
                                               ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"
                                               Grid.Column="3"/>

                                    <!-- 大拇指 -->
                                    <Image x:Name="thumbImage" Grid.Column="4" Source="/STC.Common;component/Images/大拇指.png" Width="10" Height="10" Visibility="Collapsed" Margin="0,0,1,0"/>

                                    <!--GF标签-->
                                    <Grid Grid.Column="5" MouseEnter="BestOfr_Arrow_MouseEnter" MouseLeave="BestOfr_Arrow_MouseLeave">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Polygon x:Name="OfrArrow" Stroke="#FFFFFF" StrokeThickness="0" Fill="#58B3FF" Points="0,0 10,0 10,10" HorizontalAlignment="Right" Visibility="Collapsed">
                                            
                                        </Polygon>
                                        <Border x:Name="OfrFqTag" Grid.Row="1" Background="{DynamicResource TextBox.Focus.Border}" Cursor="2" BorderThickness="0"  Visibility="Collapsed" Width="10" Height="10">
                                            <TextBlock Text="底" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding PriceType_InnerOfr}" Value="7">
                                        <Setter TargetName="priceType_bd_InnerOfr" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="priceType_bd_InnerOfr" Property="BorderBrush" Value="#964E00"/>
                                        <Setter TargetName="priceType_txt_InnerOfr" Property="Text" Value="权"/>
                                        <Setter TargetName="priceType_txt_InnerOfr" Property="Foreground" Value="#964E00"/>
                                    </DataTrigger>
                                    <!--净价-->
                                    <DataTrigger Binding="{Binding PriceType_InnerOfr}" Value="1">
                                        <Setter TargetName="priceType_bd_InnerOfr" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="priceType_bd_InnerOfr" Property="BorderBrush" Value="Green"/>
                                        <Setter TargetName="priceType_txt_InnerOfr" Property="Text" Value="N"/>
                                        <Setter TargetName="priceType_txt_InnerOfr" Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <!--全价-->
                                    <DataTrigger Binding="{Binding PriceType_InnerOfr}" Value="2">
                                        <Setter TargetName="priceType_bd_InnerOfr" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="priceType_bd_InnerOfr" Property="BorderBrush" Value="#FB943C"/>
                                        <Setter TargetName="priceType_txt_InnerOfr" Property="Text" Value="F"/>
                                        <Setter TargetName="priceType_txt_InnerOfr" Property="Foreground" Value="#FB943C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettleType_InnerOfr}" Value="1">
                                        <Setter TargetName="T0" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettleType_InnerOfr}" Value="4">
                                        <Setter TargetName="YuanQi" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettleType_InnerOfr,Converter={StaticResource strContainsConvertor}, ConverterParameter='+'}" Value="true">
                                        <Setter TargetName="YuanQi" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!--<DataTrigger Binding="{Binding FirmFlag_InnerOfr}" Value="0">
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="intentionTB" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>-->
                                    <DataTrigger Binding="{Binding FirmFlag_InnerOfr}" Value="1">
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="intentionTB" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FirmFlag_InnerOfr}" Value="(需求)">
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="intentionTB" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Count_InnerOfr}" Value="0">
                                        <Setter TargetName="priceTB_InnerOfr" Property="Text" Value=""/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMarketBest_InnerOfr}" Value="1">
                                        <Setter TargetName="thumbImage" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HurryFlag_InnerOfr}" Value="1">
                                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SuggestFlag_InnerOfr}" Value="1">
                                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FireFlag_InnerOfr}" Value="1">
                                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FloorPrice_InnerOfr}" Value="1">
                                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="OfrFqTag" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OCOFlag_InnerOfr}" Value="1">
                                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OCOFlag_InnerOfr}" Value="2">
                                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PublicRemarks_InnerOfr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PersonalRemarks_InnerOfr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Vol.Ofr" Width="12*" CellStyle="{DynamicResource DataGridTextRightStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="reply_InnerOfr" Content="未回" Height="18" Width="40" Style="{DynamicResource RedButtonStyle2}" Visibility="Collapsed" Click="ConsiderationMenu_Best_Click"/>
                                    <!--<Border x:Name="reply_InnerOfr" CornerRadius="6" Width="36" Background="#136C5E" Visibility="Collapsed" Margin="0 0 1 0">
                                        <TextBlock Text="未回" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>-->
                                    <Border x:Name="wholeTag_InnerOfr" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18"  CornerRadius="1" Visibility="Collapsed" Margin="0 0 1 0">
                                        <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="qtyTb_InnerOfr" Grid.Column="2"  Text="{Binding Qty_InnerOfr, Converter={StaticResource StringConvertor}}" 
                                               ToolTip="{Binding Qty_InnerOfr, Converter={StaticResource StringConvertor}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding WholeFlag_InnerOfr}" Value="1">
                                        <Setter TargetName="wholeTag_InnerOfr" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Count_InnerOfr}" Value="0">
                                        <Setter TargetName="qtyTb_InnerOfr" Property="Text" Value=""/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DQType_InnerOfr}" Value="!">
                                        <Setter TargetName="reply_InnerOfr" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Trader(O)" Width="11*" CellStyle="{DynamicResource DataGridTextCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PartySubName_InnerOfr}"  TextTrimming="CharacterEllipsis" ToolTip="{Binding PartySubName_InnerOfr}"/>
                                    <Border x:Name="isMeBorder_Ofr" Grid.Column="1" CornerRadius="2" Background="#853629" Width="16" Height="16" Visibility="Collapsed" Margin="1,0,0,0">
                                        <TextBlock Text="我" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMe_InnerOfr}" Value="true">
                                        <Setter TargetName="isMeBorder_Ofr" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Client(O)" Width="60" CellStyle="{DynamicResource DataGridTextRightStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Client_InnerOfr}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Client_InnerOfr}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="报价时间(O)" Width="70" Binding="{Binding UpdateTime_InnerOfr}"  CellStyle="{DynamicResource DataGridTextRightStyle}"/>
                </DataGrid.Columns>
            </localComp:CustomInnerDataGrid>
        </Grid>

    </Border>
</UserControl>
