<base:WindowBase x:Class="STC.DownloadCenter.Plugin.View.AddTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.DownloadCenter.Plugin.View"
              xmlns:base="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
              xmlns:val="clr-namespace:STC.DownloadCenter.Plugin.Validation"
             mc:Ignorable="d" MinboxEnable="False" MaxboxEnable="False" Title="新增下载"  ResizeMode="NoResize"
             Width="376" Padding="0"
             d:DesignWidth="380" SizeToContent="Height">
    <base:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DatePickerDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="STCDefaultBoxStyle_Ex" TargetType="TextBox" BasedOn="{StaticResource STCDefaultBoxStyle}">
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="ToolTip"
                                Value="{Binding RelativeSource={RelativeSource Self}
                            ,Path=(Validation.Errors)[0].ErrorContent}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{StaticResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </base:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="1" Text="合约代码:" Foreground="#A0A0A0" Margin="0 0 10 0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <base:SearchTextBox x:Name="SecurityID_TextBox" Grid.Row="1" Grid.Column="1"
                                 SearchText="{Binding Securityid_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True,ValidatesOnExceptions=True}"
                                 VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="264" Height="24" AfterSearch="SecurityID_TextBox_AfterSearch"/>

        <TextBlock Grid.Row="3" Text="数据类型:" Foreground="#A0A0A0" Margin="0 0 10 0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                  Style="{StaticResource NonEditableBorderComboBoxStyle}" Width="264" Height="24"  VerticalContentAlignment="Center"
                  ItemsSource="{Binding DataTypeViewSource.View}" SelectedValue="{Binding DataType_Edit}" SelectionChanged="ComboBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock x:Name="item" Text="{Binding DataTypeName}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        
        <TextBlock Grid.Row="5" Text="清算速度:" Foreground="#A0A0A0" Margin="0 0 10 0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding SettleTypeVisibility}"/>
        <ComboBox x:Name="settleTypeMode_ccb" Grid.Row="5" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"  Visibility="{Binding SettleTypeVisibility}"
                  Style="{StaticResource NonEditableBorderComboBoxStyle}" Width="264" Height="24" VerticalContentAlignment="Center"
                  ItemsSource="{Binding SettleTypeDic}" DisplayMemberPath="Value"  SelectedValuePath="Key" IsEnabled="{Binding SettleTypeEnable}"
                  SelectedValue="{Binding EditSettleTypeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"/>
        <Border Width="100" Height="8" Grid.Row="6" Visibility="{Binding SettleTypeVisibility}"/>

        <TextBlock Grid.Row="7" Text="频率:" Foreground="#A0A0A0" Margin="0 0 10 0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding TextVisibility}"/>
        <ComboBox x:Name="text_ccb" Grid.Row="7" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"  Visibility="{Binding TextVisibility}"
                  Style="{StaticResource NonEditableBorderComboBoxStyle}" Width="264" Height="24" VerticalContentAlignment="Center"
                  ItemsSource="{Binding TextDic}" DisplayMemberPath="Value"  SelectedValuePath="Key"
                  SelectedValue="{Binding EditTextMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"/>
        <Border Width="100" Height="8" Grid.Row="8" Visibility="{Binding TextVisibility}"/>

        <TextBlock Grid.Row="9" Text="行情类型:" Foreground="#A0A0A0" Margin="0 0 10 0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding TypeVisibility}"/>
        <ComboBox x:Name="type_ccb" Grid.Row="9" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left"  Visibility="{Binding TypeVisibility}"
                  Style="{StaticResource NonEditableBorderComboBoxStyle}" Width="264" Height="24" VerticalContentAlignment="Center"
                  ItemsSource="{Binding TypeDic}" DisplayMemberPath="Value"  SelectedValuePath="Key"
                  SelectedValue="{Binding EditTypeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True}"/>
        <Border Width="100" Height="8" Grid.Row="10" Visibility="{Binding TypeVisibility}"/>

        <TextBlock Grid.Row="11" Text="开始时间:" Foreground="#A0A0A0" Margin="0 0 10 0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <DatePicker x:Name="start_datePicker" Grid.Row="11" Grid.Column="1" Width="140" Height="24" HorizontalAlignment="Left"
                                    Style="{DynamicResource DefaultDatePickerStyle}">
            <DatePicker.SelectedDate>
                <Binding Path="StartDate" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                    <Binding.ValidationRules>
                        <val:OrderParamsValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </DatePicker.SelectedDate>
        </DatePicker>
        <StackPanel Orientation="Horizontal" Height="24" Grid.Row="11" Grid.Column="1" Margin="150, 0, 0, 0">
            <base:WatermarkTextBox  WaterMark="时" ContextMenu="{x:Null}" Tag="2" MaxLength="2" x:Name="StartHour"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  InputMethod.IsInputMethodEnabled="False" Width="28" Height="24" BorderBrush="#193D37"  Padding="0, 0, 0, 0">
                <TextBox.ToolTip>
                    <ToolTip Content="输入范围:(0，24]"></ToolTip>
                </TextBox.ToolTip>
                <TextBox.Text>
                    <Binding Path="StartHour" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                        <Binding.ValidationRules>
                            <val:OrderParamsValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </base:WatermarkTextBox>
            <TextBlock Grid.Row="0" Text=":"  Margin="6,0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
            <base:WatermarkTextBox WaterMark="分" ContextMenu="{x:Null}"  Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="StartMinute"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0">
                <TextBox.ToolTip>
                    <ToolTip Content="输入范围:[0-60)"></ToolTip>
                </TextBox.ToolTip>
                <TextBox.Text>
                    <Binding Path="StartMinute" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                        <Binding.ValidationRules>
                            <val:OrderParamsValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </base:WatermarkTextBox>
            <TextBlock Grid.Row="0" Text=":"   Margin="6, 0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
            <base:WatermarkTextBox WaterMark="秒" ContextMenu="{x:Null}" Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="StartSecond"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0">
                <TextBox.ToolTip>
                    <ToolTip Content="输入范围:[0-60)"></ToolTip>
                </TextBox.ToolTip>
                <TextBox.Text>
                    <Binding Path="StartSecond" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                        <Binding.ValidationRules>
                            <val:OrderParamsValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </base:WatermarkTextBox>

        </StackPanel>


        <TextBlock Grid.Row="13" Text="结束时间:" Foreground="#A0A0A0" Margin="0 0 10 0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <DatePicker x:Name="end_datePicker" Grid.Row="13" Grid.Column="1" Width="140" Height="24" HorizontalAlignment="Left"
                                    Style="{DynamicResource DefaultDatePickerStyle}">
            <DatePicker.SelectedDate>
                <Binding Path="EndDate" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                    <Binding.ValidationRules>
                        <val:OrderParamsValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </DatePicker.SelectedDate>
        </DatePicker>
        <StackPanel Orientation="Horizontal" Height="24" Grid.Row="13" Grid.Column="1" Margin="150, 0, 0, 0" Visibility="{Binding TimeValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
            <base:WatermarkTextBox  WaterMark="时" ContextMenu="{x:Null}" Tag="2" MaxLength="2" x:Name="EndHour"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" InputMethod.IsInputMethodEnabled="False" Width="28" Height="24" BorderBrush="#193D37"  Padding="0, 0, 0, 0">
                <TextBox.ToolTip>
                    <ToolTip Content="输入范围:(0，24]"></ToolTip>
                </TextBox.ToolTip>
                <TextBox.Text>
                    <Binding Path="EndHour" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                        <Binding.ValidationRules>
                            <val:OrderParamsValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </base:WatermarkTextBox>
            <TextBlock Grid.Row="0" Text=":"  Margin="6,0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
            <base:WatermarkTextBox WaterMark="分" ContextMenu="{x:Null}"  Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="EndMinute"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0">
                <TextBox.ToolTip>
                    <ToolTip Content="输入范围:[0-60)"></ToolTip>
                </TextBox.ToolTip>
                <TextBox.Text>
                    <Binding Path="EndMinute" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                        <Binding.ValidationRules>
                            <val:OrderParamsValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </base:WatermarkTextBox>
            <TextBlock Grid.Row="0" Text=":"   Margin="6, 0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
            <base:WatermarkTextBox WaterMark="秒" ContextMenu="{x:Null}" Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="EndSecond"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"   InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0">
                <TextBox.ToolTip>
                    <ToolTip Content="输入范围:[0-60)"></ToolTip>
                </TextBox.ToolTip>
                <TextBox.Text>
                    <Binding Path="EndSecond" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                        <Binding.ValidationRules>
                            <val:OrderParamsValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </base:WatermarkTextBox>
            
        </StackPanel>

        <!--第四行-->
        <Border Grid.Row="15" Grid.ColumnSpan="2" BorderBrush="#232323" BorderThickness="0 1 0 0" >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK_Click">确认
                    <Button.IsEnabled>
                       <MultiBinding Converter="{StaticResource multiAndConverter}">
                            <MultiBinding.Bindings>
                                <Binding ElementName="SecurityID_TextBox" Path="(Validation.HasError)"/>
                                <Binding ElementName="settleTypeMode_ccb" Path="(Validation.HasError)"/>

                                <Binding ElementName="start_datePicker" Path="(Validation.HasError)"/>
                                <Binding ElementName="StartHour" Path="(Validation.HasError)"/>
                                <Binding ElementName="StartMinute" Path="(Validation.HasError)"/>
                                <Binding ElementName="StartSecond" Path="(Validation.HasError)"/>

                                <Binding ElementName="end_datePicker" Path="(Validation.HasError)"/>
                                <Binding ElementName="EndHour" Path="(Validation.HasError)"/>
                                <Binding ElementName="EndMinute" Path="(Validation.HasError)"/>
                                <Binding ElementName="EndSecond" Path="(Validation.HasError)"/>
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</base:WindowBase>
