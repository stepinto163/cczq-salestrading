                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="主体剩余额度(万)"  Visibility="Visible" Width="Auto" MinWidth="80" CanUserSort="False"  CellStyle="{StaticResource SumColorStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txtNetavgprice" Text="{Binding Quotalimit,StringFormat={}{0:N0}}" Padding="0 0 4 0"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Quotalimit}" Value="0.0">
                                    <Setter TargetName="txtNetavgprice" Property="Text" Value="0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Visibility="Visible" Width="Auto" MinWidth="80" CanUserSort="False"  CellStyle="{StaticResource SumColorStyle}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="单券剩余额度(万)" VerticalAlignment="Center"/>
                                <Viewbox Width="14" Height="14">
                                    <Path Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource InfoIconStyle}"
                     Data="M8,0 C3.58,0 0,3.58 0,8 C0,12.42 3.58,16 8,16 C12.42,16 16,12.42 16,8 C16,3.58 12.42,0 8,0 Z M8.93,12.588 L7.07,12.588 L7.07,10.646 L8.93,10.646 L8.93,12.588 Z M8.93,9.293 L7.07,9.293 L7.07,3.411 L8.93,3.411 L8.93,9.293 Z"
                    ToolTip="&lt;单券发行量&gt;*&lt;可投比例&gt;-&lt;公司单券总持仓&gt;">
                                    </Path>
                                </Viewbox>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txtSingleBondAmount" Text="{Binding SingleBondAmount,StringFormat={}{0:N0}}" Padding="0 0 4 0"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SingleBondAmount}" Value="0.0">
                                    <Setter TargetName="txtSingleBondAmount" Property="Text" Value="0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="单券发行量(万)"  Visibility="Visible"  Binding="{Binding OutStandingAmount,StringFormat={}{0:N0}}" Width="Auto" MinWidth="80" CanUserSort="False" CellStyle="{StaticResource SumColorStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="可投比例(%)"  Visibility="Visible"  Binding="{Binding Investmentratio}" Width="Auto" MinWidth="80" CanUserSort="False" CellStyle="{StaticResource SumColorStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>

                <DataGridTemplateColumn Header="内部主体评级" Width="Auto" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Rate}" x:Name="txtRate" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding ShowRateEnddate}"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Rate}" Value="{x:Null}">
                                    <Setter TargetName="txtRate" Property="Text" Value=""/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRateEnddated}" Value="True">
                                    <Setter Property="Foreground" TargetName="txtRate" Value="Red"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="0 0 4 0"/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="内部债券评级" Width="Auto" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Bonddrating}" x:Name="txtBonddrating" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding ShowRatingExpiryDate}"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Bonddrating}" Value="{x:Null}">
                                    <Setter TargetName="txtBonddrating" Property="Text" Value=""/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRatingExpiryEnddated}" Value="True">
                                    <Setter Property="Foreground" TargetName="txtBonddrating" Value="Red"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="0 0 4 0"/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="成本净价(元)" Width="Auto" MinWidth="80" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txtNetavgprice" Text="{Binding Netprice,StringFormat={}{0:N4}}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Netprice}" Value="0">
                                    <Setter TargetName="txtNetavgprice" Property="Text" Value="--"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Netprice}" Value="0.0">
                                    <Setter TargetName="txtNetavgprice" Property="Text" Value="--"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="中债估值(元)" Width="auto" MinWidth="80" SortMemberPath="ValuationYield">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txtValuationYield"  Text="{Binding ValuationYield, Converter={StaticResource StringConvertor}, ConverterParameter='--'}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ValuationYield}" Value="0">
                                    <Setter TargetName="txtValuationYield" Property="Text" Value="--"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ValuationYield}" Value="0.0">
                                    <Setter TargetName="txtValuationYield" Property="Text" Value="--"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="中债估值(%)" Width="auto" MinWidth="80" SortMemberPath="ValuationYield2">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txtValuationYield2" Text="{Binding ValuationYield2}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ValuationYield2}" Value="0">
                                    <Setter TargetName="txtValuationYield2" Property="Text" Value="--"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ValuationYield2}" Value="0.0">
                                    <Setter TargetName="txtValuationYield2" Property="Text" Value="--"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="中证估值(%)" Width="auto" MinWidth="80" SortMemberPath="CsiBondValuation">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txtValuationYield" Text="{Binding CsiBondValuation}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CsiBondValuation}" Value="0">
                                    <Setter TargetName="txtValuationYield" Property="Text" Value="--"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CsiBondValuation}" Value="0.0">
                                    <Setter TargetName="txtValuationYield" Property="Text" Value="--"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Header="交易所收盘价(元)"  Visibility="Visible"  Width="Auto" MinWidth="120" CanUserSort="False" CellStyle="{StaticResource SumColorStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txtExClose" Text="{Binding ExClose}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ExClose}" Value="">
                                    <Setter TargetName="txtExClose" Property="Text" Value="--"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="交易所收盘价(%)"  Visibility="Visible"  Width="Auto" MinWidth="120" CanUserSort="False" CellStyle="{StaticResource SumColorStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txtExClose2" Text="{Binding ExClose2}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ExClose2}" Value="">
                                    <Setter TargetName="txtExClose2" Property="Text" Value="--"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Header="募集类型" MinWidth="60" Width="Auto" SortMemberPath="IssueType">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="IssueTypeTB" Text="{Binding IssueType}" TextTrimming="CharacterEllipsis" ToolTip="{Binding IssueType}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IssueType}" Value="--">
                                    <Setter TargetName="IssueTypeTB" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn  Header="担保人" MinWidth="60" Width="Auto" SortMemberPath="Guarantor">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="GuarantorTB" Text="{Binding Guarantor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Guarantor}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Guarantor}" Value="--">
                                    <Setter TargetName="GuarantorTB" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn  Header="担保人内部评级" MinWidth="60" Width="Auto" SortMemberPath="Issuer">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="GuarantorRatingTB" Text="{Binding GuarantorRating}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GuarantorRating}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding GuarantorRating}" Value="--">
                                    <Setter TargetName="GuarantorRatingTB" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--<DataGridTextColumn Header="Key" Binding="{Binding Key}"  Width="Auto"  CellStyle="{StaticResource SumColorStyle}"/>-->
            </DataGrid.Columns>
        </DataGrid>

        <!--第三行 中间 查询状态-->
        <fUI:LoadingMask x:Name="positionloadMask" Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConvertor}}"  Grid.Row="3" Grid.RowSpan="1" Grid.ColumnSpan="2"
                         IsVisibleChanged="PositionloadMask_IsVisibleChanged"></fUI:LoadingMask>

        
        <!-- gridSplitter -->
        <Button x:Name="btnVer" Grid.Column="1" Grid.Row="3"  Grid.RowSpan="3"  Width="8" Height="40" Padding="0, 0, 0, 0" Margin="1, 0, 1, 0" Content=">" 
                FontSize="8" Style="{DynamicResource SplitButtonStyle}" Click="BtnVer_Click"  Panel.ZIndex="1"></Button>
        <GridSplitter x:Name="gridSplitter"  Grid.Row="3"  Grid.Column="1" Grid.RowSpan="3" Background="{DynamicResource BackgroundBrush}" Style="{DynamicResource VGridSplitterStyleNoVer}"  DragCompleted="GridSplitter_DragCompleted"/>

        <!--第三行 右侧 质押券显示区-->
        <DataGrid x:Name="dgDetailPosition"  Grid.Row="3" Grid.Column="2" Grid.RowSpan="5" ItemsSource="{Binding DtMv.View}" 
            Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}"  Background="{DynamicResource DefaultBackgroup.ColorBrush}"
             IsSynchronizedWithCurrentItem="True" SelectionMode="Extended" SelectionUnit="FullRow" 
            BorderThickness="0.5" BorderBrush="#282828"  GridLinesVisibility="None" HorizontalGridLinesBrush="#282828" VerticalGridLinesBrush="#282828" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
            EnableRowVirtualization="True"  EnableColumnVirtualization="True"  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
            SelectionChanged ="dgDetailPosition_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                        <Setter Property="Height" Value="24" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="dgMenu_Reference" Style="{DynamicResource DefaultContextMenu}" Opened="dgMenu_Reference_Opened">
                        <MenuItem x:Name="CopyMenu_SecurityID_Reference" Header="复制" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_SecurityID_Reference_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                <DataGridTemplateColumn  Header="" Width="Auto" MinWidth="30" CanUserSort="False" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                             <CheckBox x:Name="Selected_Chk" IsChecked="{Binding IsChecked, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"  Focusable="False" IsHitTestVisible="False" ToolTipService.IsEnabled="True"
                                   Margin="4,0,0,0" Style="{DynamicResource HistoryRequireCheckBoxStyle}" ToolTip="请在表格中按住鼠标左键选择, Ctrl+鼠标单选"  IsEnabled="True">
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTemplateColumn  Header="组合" Width="Auto" MinWidth="85" CanUserSort="False" ClipboardContentBinding="{Binding PortfolioName}">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource SumColorStyle}">
                            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                            <Setter Property="Foreground" Value="White"/>
                       </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PortfolioName}" TextTrimming="CharacterEllipsis"  Margin="4,0,0,0" FontWeight="SemiBold"  ToolTip="{Binding PortfolioName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="交易账户" Width="Auto" MinWidth="90" Binding="{Binding TradeAccount}" ClipboardContentBinding="{Binding TradeAccount}">
                </DataGridTextColumn>-->


                <DataGridTemplateColumn Header="方向" Width="Auto" MinWidth="90" ClipboardContentBinding="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='patradeside'}" HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="sideandtype" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='patradeside'}"  FontSize="11" Style="{StaticResource PASizeStyle}"/>
                            <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TradeType}" Value="3"/>
                                        <Condition Binding="{Binding Side}" Value="2"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="sideandtype" Property="Text" Value="买入"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TradeType}" Value="3"/>
                                        <Condition Binding="{Binding Side}" Value="4"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="sideandtype" Property="Text" Value="买入"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TradeType}" Value="3"/>
                                        <Condition Binding="{Binding Side}" Value="3"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="sideandtype" Property="Text" Value="卖出"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding TradeType}" Value="3"/>
                                        <Condition Binding="{Binding Side}" Value="5"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="sideandtype" Property="Text" Value="卖出"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="质押量(万)" Width="Auto" MinWidth="90" Binding="{Binding Qty ,StringFormat={}{0:N0}}" ClipboardContentBinding="{Binding Qty, Converter={StaticResource QtyToIntStringConverter}}" CellStyle="{StaticResource DataGridTextRightStyle}" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="质押到期日" Width="Auto" MinWidth="105" SortMemberPath="MaturityDate" ClipboardContentBinding="{Binding MaturityDate}">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                            <Setter Property="Padding" Value="9,0,5,0"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="backBorderRemainingTime" Background="Transparent">
                                    <TextBlock x:Name="remainingTimetb" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding MaturityDate}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Text}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>    
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding MaturityDate}" Value="已到期">
                                    <Setter TargetName="remainingTimetb" Property="Foreground" Value="#B03131"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrentDay}" Value="1">
                                    <Setter TargetName="backBorderRemainingTime" Property="Background" Value="Green"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn Header="质押对手方" Width="Auto" MinWidth="90" Binding="{Binding CounterParty}" ClipboardContentBinding="{Binding CounterParty}" >
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="类型" Width="Auto" MinWidth="120" CanUserSort="False" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}" ClipboardContentBinding="{Binding TradeType,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='patradetype'}">  
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txttradetpe" Text="{Binding TradeType,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='patradetype'}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding TradeType}" Value="1">
                                    <!--<Setter TargetName="txttradetpe" Property="Text" Value="质押"/>-->
                                    <Setter TargetName="txttradetpe" Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TradeType}" Value="2">
                                    <!--<Setter TargetName="txttradetpe" Property="Text" Value="STC在途意向"/>-->
                                    <Setter TargetName="txttradetpe" Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TradeType}" Value="3">
                                    <!--<Setter TargetName="txttradetpe" Property="Text" Value="STC在途成交"/>-->
                                    <Setter TargetName="txttradetpe" Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
       
        
        <!--Bottom {DynamicResource BackgroundBrush}-->
        <Grid Background="Transparent" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <!--Button Content="复制代码" Width="80" Height="24" Margin="4 0 0 0" IsTabStop="False" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Command="{Binding CopyCodeCommand}"/-->
                <!-- 示例1: 基本使用 -->
                <local:DualCommandButton Content="复制持仓" Command="{Binding CopyPositionCommand}" Width="80" Height="24" SecondaryCommand="{Binding SetCopyPositionFieldCommand}" BorderThickness="0 1 0 0" SecondaryToolTip="点击设置复制要素" Margin="4,0,0,0"/>
                <Button Content="全部卖出" Width="80" Height="24" Margin="4 0 0 0" IsTabStop="False" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Command="{Binding SalelAllCommand}" Cursor=""/>
                <Button Content="部分卖出" Width="80" Height="24" Margin="4 0 0 0" IsTabStop="False" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Command="{Binding PartiallySoldCommand}"/>
            </StackPanel>

            <!--第四行 左侧 分页 {Binding EMSPageVisible,Converter={StaticResource VisibilityConvertor}}-->
            <StackPanel Visibility="{Binding EMSPageVisible,Converter={StaticResource VisibilityConvertor}}" VerticalAlignment="Center"  Margin="0 0 20 0" Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource DefaultGridForground}" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                              <Run Text="共"></Run>
                              <Run Text="{Binding TotalCount}"></Run>
                              <Run Text="条"></Run>
                              <Run Text=",当前页"></Run>
                              <Run Text="{Binding RowCount}"></Run>
                              <Run Text="条"></Run>
                        </TextBlock>

                    <comp:PageControl x:Name="EMSPageControl"  HorizontalAlignment="Right" Grid.Column="2"  IsEnableSearch="{Binding IsLoading, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PageChanged="EMSPageControl_PageChanged"  Visibility="{Binding EMSPageVisible,Converter={StaticResource VisibilityConvertor}}"/>
                    </Grid>

                </StackPanel>
        </Grid>
    </Grid>
</UserControl>
