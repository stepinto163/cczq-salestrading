    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Col0"/>
            <ColumnDefinition Width="9"/>
            <ColumnDefinition x:Name="Col2" Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <!--第一行-->
        <StackPanel Margin="0 0 10 0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="SHOW ALL" x:Name="btnShowAll" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Click="btnShowAll_Click"/>

            <!--信用债，利率债筛选-->
            <Grid Margin="4 0 0 0" x:Name="single">
                <RadioButton x:Name="SingleRd_ALL" Content="全" Height="24" Width="24" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource AllRadioButtonStyle}" IsChecked="True" Click="Single_Click"  ToolTip="全部债券"/>
                <RadioButton x:Name="SingleRd_R" Content="利率"  Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource RateRadioButtonStyle}" Margin="26 0 0 0" Click="Single_Click"  ToolTip="仅利率"/>
                <RadioButton x:Name="SingleRd_C" Content="信用" Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource CreditRadioButtonStyle}" Margin="64 0 0 0" Click="Single_Click"  ToolTip="仅信用"/>
            </Grid>

            <TextBlock x:Name="txBook0" Text="绩效经理:" VerticalAlignment="Center" HorizontalAlignment="Right"  Style="{StaticResource TextBlockStyle}"  Margin="8,0,4,0"/>

            <commComp:MultiSelectComboBox IsEditable="True" Focusable="False"  x:Name="FundAccountCB" Width="220" Height="22"
                                          IsCanUse="{Binding IsFundAccount,Converter={StaticResource reversebooleanConvertor}}" 
                                          ItemsSource="{Binding DictFundAccount}" SelectedValues="{Binding SelectetFundAccountItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 0 0 0" DefaultText="ALL">
                
            </commComp:MultiSelectComboBox>

            <TextBlock Text="投资组合名称:" VerticalAlignment="Center" HorizontalAlignment="Right"  Style="{StaticResource TextBlockStyle}"  Margin="4,0,4,0"/>
            <commComp:MultiTreeComboBox Width="240" Height="24"  Margin="0 0 0 0"  x:Name="cmbMultiTree"
                            VerticalAlignment="Center" Foreground="{StaticResource ComboBoxItem.Static.Foreground}"
                            TreeItemsSource="{Binding MultiTreeComboxItemsSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            IsEnableMultiSelect="True"  DefaultText="ALL" IsEnableSelectRootNode="True" IsEnableSearch="True" MaxDropDownHeight="516"
                            SelectedItem="{Binding SelectedTradeAccountCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsCanUse="True"
                            SelectedTexts="{Binding SelectedTradeAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            SelectedParentId="{Binding SelectedGroupItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedProductId="{Binding SelectedProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentTexts="{Binding SelectedGroupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentItems="{Binding SelectedGroupDict, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <commComp:MultiTreeComboBox.TreeItemItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                        <StackPanel Orientation="Horizontal" Height="24">
                            <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Tag="{Binding Id}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TreeCheckBoxButton}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding  RelativeSource={RelativeSource AncestorType={x:Type commComp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                    <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                    <Condition Binding="{Binding IsLeaf}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type commComp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                    <Condition Binding="{Binding IsGroup}" Value="False"/>
                                                    <Condition Binding="{Binding IsLeaf}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type commComp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                    <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                    <Condition Binding="{Binding IsLeaf}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>                            
                            <!--<Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>-->
                            <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" ToolTip="{Binding IsGroup}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Checked}" Value="1">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
