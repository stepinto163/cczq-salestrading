                                                  UseLayoutRounding="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Fill="{TemplateBinding Foreground}"/>
                                        </Viewbox>
                                        
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource SlateGrayButton.Static.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource SlateGrayButton.Static.Border}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource SlateGrayButton.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource SlateGrayButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource SlateGrayButton.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource SlateGrayButton.Pressed.Border}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource SlateGrayButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource SlateGrayButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SlateGrayButton.Disabled.Foreground}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource SlateGrayButton.Disabled.Foreground}"/>
                                </Trigger>
                                <!-- hover 触发 -->
                                <Trigger SourceName="GearArea" Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource SlateGrayButton.Static.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource SlateGrayButton.Static.Border}"/>
                                    <Setter TargetName="GearArea" Property="Background" Value="{DynamicResource SlateGrayButton.MouseOver.Background}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SlateGrayButton.MouseOver.Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--组显示-->
            <Style x:Key="TagGroupListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.Static.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.Static.Foreground}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="4 0 0 4"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="1" VerticalAlignment="Center" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource DefaultContextMenu}">
                                        <!--<MenuItem x:Name="EditGroupMenu" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="EditGroupMenu_Click"/>-->
                                        <MenuItem x:Name="DelGroupMenu" Header="删除" Style="{DynamicResource DefaultMenuItem}" Click="DelGroupMenu_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <!--Image x:Name="svg_path" Source ="pack://application:,,,/STC.Frame;component/Images/group_1_normal.png"  Margin="0 0 4 0" Width="12" Height="12"></Image-->
                                    <ContentPresenter Grid.Column="1" x:Name="Cp" TextElement.FontSize="{TemplateBinding FontSize}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>-->
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>-->
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 图标样式 -->
            <Style x:Key="InfoIconStyle" TargetType="Path">
                <Setter Property="Fill" Value="Gray"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource SlateGrayButton.MouseOver.Background}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 展开或收缩面板CheckBox -->
            <Style x:Key="ExpandCollapsedStyle" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border Name="border" CornerRadius="2" Background="Transparent">
                                <Label Name="label"  Margin="0"  Padding="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Label.Content>
                                        <Path x:Name="svg_path" Data="M0,0 L10,0 5,6 z"  UseLayoutRounding="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Fill="{DynamicResource  SvgButton.Static.Foreground}" RenderTransformOrigin="0.5 0.5"/>
                                    </Label.Content>
                                </Label>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="svg_path" Property="Data" Value="M0,0 L10,0 5,6 z"/>
                                    <Setter TargetName="svg_path" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource  SvgButton.MouseOver.Background}" />
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource  SvgButton.MouseOver.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource  SvgButton.MouseOver.Background}" />
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource  SvgButton.MouseOver.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- GreenBlueComboBox Default 样式-->
            <Style x:Key="DTitileToggleButton" TargetType="{x:Type ToggleButton}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Focusable" Value="false"/>
                <Setter Property="ClickMode" Value="Press"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="templateRoot" SnapsToDevicePixels="true" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <Border x:Name="splitBorder" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0 -2 2 0" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
                                    <Path x:Name="arrow"  Stroke="{DynamicResource GreenBlueComboBoxArrowBtn.Normal.Stroke}" StrokeThickness="1" Data="M 6,10 L 10,15 L 14,10"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--鼠标移过-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Stroke" TargetName="arrow" Value="{DynamicResource GreenBlueComboBoxArrowBtn.MouseOver.Stroke}"/>
                                </Trigger>
                                
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="{DynamicResource ComboBoxItem.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource GreenBlueComboBoxArrowBtn.MouseOver.Border}"/>
                                </MultiDataTrigger>
                                <!--鼠标按下-->
                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter Property="Stroke" TargetName="arrow" Value="{DynamicResource GreenBlueComboBoxArrowBtn.Normal.Stroke}"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="{DynamicResource ComboBoxItem.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource GreenBlueComboBoxArrowBtn.MouseOver.Border}"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ComboBox}" x:Key="DTitileComboxStyle">
                <Setter Property="BorderBrush" Value="#3C3C3C"></Setter>
                <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.Static.Background}"></Setter>
                <Setter Property="Foreground" Value="#FFEBC8"></Setter>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <Border  Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="1"/>

                                <ContentPresenter x:Name="txText" Margin="4 0 4 0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding Tag}" />

                                <TextBlock x:Name="txWaterMark" Foreground="{DynamicResource ComboBoxItem.Static.Foreground}" Text="ALL" Background="Transparent" Padding="3" TextTrimming="CharacterEllipsis" >
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Content, ElementName=txText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                

                                <!--ToggleButton 已数据绑定到 ComboBox 本身以切换 IsDropDownOpen-->
                                <ToggleButton Grid.Column="1"  Grid.ColumnSpan="1"  Style="{StaticResource DTitileToggleButton}" x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                </ToggleButton>

                                <!--Path x:Name="Arrow" Grid.Column="1"  Grid.ColumnSpan="1" Stroke="{DynamicResource GreenBlueComboBoxArrowBtn.Normal.Stroke}" StrokeThickness="1" Data="M 6,10 L 10,15 L 14,10" Margin="-6 -8 0 0"  HorizontalAlignment="Center"  VerticalAlignment="Center"/-->

                                <!--Popup 可显示 ComboBox 中的项列表。IsOpen 已数据绑定到通过 ComboBoxToggleButton 来切换的 IsDropDownOpen-->
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Margin="0,4,0,0" Placement="Bottom" x:Name="Popup"  Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{TemplateBinding Background}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFEBC8" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer  MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="Transparent"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- 定义右键菜单资源 -->
            <ContextMenu x:Key="HeaderContextMenu" Style="{DynamicResource DefaultContextMenu}">
                <MenuItem Header="表头设置" Click="HeaderSettings_Click" Style="{DynamicResource DefaultMenuItem}"/>
            </ContextMenu>



            <!-- 石板灰按钮 样式 - 颜色资源 -->
            <SolidColorBrush x:Key="DualButton.Static.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="DualButton.Static.Border" Color="#238F7E"/>
            <SolidColorBrush x:Key="DualButton.Static.Foreground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DualButton.Static.Foreground2" Color="#8F9598"/>
            
            <SolidColorBrush x:Key="DualButton.MouseOver.Background" Color="#238F7E"/>
            <SolidColorBrush x:Key="DualButton.MouseOver.Border" Color="#00FFD6"/>

            <SolidColorBrush x:Key="DualButton.Pressed.Background" Color="#90136C5E"/>
            <SolidColorBrush x:Key="DualButton.Pressed.Border" Color="#90238F7E"/>
            <SolidColorBrush x:Key="DualButton.Pressed.Foreground" Color="#FFFFFF"/>

            <SolidColorBrush x:Key="DualButton.Disabled.Background" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="DualButton.Disabled.Border" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="DualButton.Disabled.Foreground" Color="#61636C"/>

            
