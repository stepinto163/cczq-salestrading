                <Setter Property="Background" Value="{StaticResource DualButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DualButton.Static.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource DualButton.Static.Foreground}"/>
