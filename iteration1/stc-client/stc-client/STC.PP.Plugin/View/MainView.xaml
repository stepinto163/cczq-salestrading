                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition SourceName="PART_MainArea" Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsMainEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="PART_MainArea" Value="{StaticResource DualButton.MouseOver.Background}"/>
                                    <Setter Property="Background" TargetName="PART_SecondaryArea" Value="{StaticResource DualButton.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource DualButton.MouseOver.Border}"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource DualButton.MouseOver.Background}"/>
                                </MultiTrigger>

                                <!-- 主区域禁用状态 -->
                                <Trigger Property="IsMainEnabled" Value="False">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource DualButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource DualButton.Disabled.Border}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{StaticResource DualButton.Static.Foreground2}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource DualButton.Disabled.Foreground}"/>
                                </Trigger>
                                
                                <!-- 辅助区域鼠标悬停 -->
                                <Trigger SourceName="PART_SecondaryArea" Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="PART_SecondaryArea" Value="{StaticResource DualButton.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="PART_SecondaryArea" Value="Transparent"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{StaticResource DualButton.MouseOver.Border}"/>
                                </Trigger>

                                <!-- 控件完全禁用 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource DualButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource DualButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource DualButton.Disabled.Foreground}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{StaticResource DualButton.Disabled.Foreground}"/>
                                </Trigger>
