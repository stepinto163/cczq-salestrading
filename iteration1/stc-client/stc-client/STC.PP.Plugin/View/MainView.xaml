<UserControl x:Class="STC.PP.Plugin.View.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:local="clr-namespace:STC.PP.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:con="clr-namespace:STC.PP.Plugin.Convertor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <con:ColorConvertor x:Key="EmptyColorCon"/>
            <con:QtyToIntStringConverter  x:Key="QtyToIntStringConverter"/>
            <con:ComboBoxDisplayConverter x:Key="ComboBoxDisplayConverter"/>
            <fcon:BoolVisibilityConvertor x:Key="BoolVisibilityConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:NumberConvertor3 x:Key="numConvertor3"/>
            <fcon:VisibilityConvertor x:Key="VisibilityConvertor"/>
            <fcon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <fcon:BooleanConvertor x:Key="booleanConvertor"/>
            <fcon:FormatDateTimeConvertor x:Key="FormatDateTimeConvertor"/>
            <fcon:StringConvertor x:Key="StringConvertor"/>
            <fcon:IntentionStatusConvertor x:Key="intentionStatusConvertor"/>
            <fcon:DaysOffStrConverter x:Key="daysOffStrConverter"/>
            <fcon:VenuesColorConvertor x:Key="venuesColorConvertor"/>
            <fcon:VenuesSimpleConvertor x:Key="venuesSimpleConvertor"/>
            <fcon:InnerBoardColorConvertor x:Key="colorCon"/>
            <fcon:RadioButtonConverter x:Key="radioBtnConverter"/>
            <fcon:GreaterThanZeroConverter x:Key="greaterThanZeroConverter"/>
            
            <SolidColorBrush x:Key="TextBlockForeColor" Color="#FFFFFF"></SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>


            <SolidColorBrush x:Key="MainFormBackground" Color="#141414"/>
            <SolidColorBrush x:Key="LostFocusBorderBrush" Color="#282828"/>
            <SolidColorBrush x:Key="GetFocusBorderBrush" Color="#8F9598"/>

            <!--设置样式专用-->
            <SolidColorBrush x:Key="DataGridBorderBrush" Color="#3C3C3C"/>

            <Style TargetType="Image" x:Key="ImageStyle">
                <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BookType}" Value="R">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="P">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/group_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="A">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <Style x:Key="TextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>


            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="true"/>
            </Style>
            
            <Style x:Key="IsNotValid" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding enable}" Value="0">
                        <Setter Property="Foreground" Value="#A0A0A0"/>
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="SumColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="BorderThickness" Value="0"/>
                <!--<Style.Triggers>
                    <DataTrigger Binding="{Binding bookid}" Value="0">
                        <Setter Property="Foreground" Value="#F9C152" />
                        <Setter Property="FontSize" Value="14"/>
                    </DataTrigger>
                </Style.Triggers>-->
            </Style>

            <Style x:Key="SumColorEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="SumColorEmptyStyleAlignmentLeft" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Margin" Value="4 0 0 0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="BookListColumnStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="Foreground" Value="#FFFFFF "/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                        <Setter Property="Foreground" Value="#00CDAD" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SumMoneyEmptyStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyleNoSpace}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MainListTitleBackgroup.ColorBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>


            <!--买卖样式-->
            <Style x:Key="PASizeStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="24"></Setter>
                <Setter Property="Width" Value="40"></Setter>
                <Setter Property="Padding" Value="0,4,0,0"></Setter>
                <Setter Property="TextAlignment" Value="Center"></Setter>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="1"/>
                            <!--正回购-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Green}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="2"/>
                            <!--STC在途意向Bid-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="3"/>
                            <!--STC在途意向Ofr-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="4"/>
                            <!--STC在途成交Bid-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="5"/>
                            <!--STC在途成交Ofr-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </MultiDataTrigger>

                </Style.Triggers>

            </Style>

            <!--带齿轮的ButtonStyle-->
            <Style x:Key="SlateGrayStyleWithSet" TargetType="{x:Type Button}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
                <Setter Property="Background" Value="{DynamicResource SlateGrayButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SlateGrayButton.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource SlateGrayButton.Static.Foreground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="contentPresenter" Grid.Column="0" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    <!-- 齿轮按钮 -->
                                    <Border x:Name="GearArea"  Grid.Column="1" Width="16" Height="16"  Background="Transparent" Cursor="Hand" Focusable="True" ToolTip="点击设置复制要素">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Border.InputBindings>
