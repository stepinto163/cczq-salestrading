<UserControl x:Class="STC.PP.Plugin.View.CopyPositionFieldSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.PP.Plugin.View"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:vm ="clr-namespace:STC.Common.ViewModel.UI;assembly=STC.Common"
             xmlns:SelectorT="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Margin="10,0,10,20">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <fcon:BoolVisibilityConvertor x:Key="PPBoolVisibilityConvertor"/>

            <Style x:Key="SystemSetTextBoxStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource DataGrid.SubTitle.Foreground}"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!--组-->
            <DataTemplate x:Key="msgGroup">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                    <ItemsControl x:Name="TradeListBox"  Background="Transparent" ItemsSource="{Binding subList}"  Width="520">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True" ItemHeight="30" ItemWidth="130" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding name}" ToolTip="{Binding name}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}"
                              IsChecked="{Binding ischecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding isenabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{Binding visible, Converter={StaticResource PPBoolVisibilityConvertor}}"  Tag="group" Checked="CheckBox_Checked"  Unchecked="CheckBox_Checked"
                              FontSize="14" FontFamily="Microsoft YaHei" Margin="0 0 0 0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <!--项目列表-->
            <DataTemplate x:Key="msgItem">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                    <ItemsControl x:Name="TradeListBox"  Background="Transparent" ItemsSource="{Binding subList}"  Width="580">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True" ItemHeight="30" ItemWidth="140" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding name}" ToolTip="{Binding name}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}"
                                  IsChecked="{Binding ischecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding isenabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding visible, Mode=TwoWay, Converter={StaticResource PPBoolVisibilityConvertor}}"
                                  Tag="Set" FontSize="12" FontFamily="Microsoft YaHei"  Margin="0 0 10 5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>


            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"></Setter>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="MinHeight" Value="44"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding visible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="64"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--设置区域-->
        <Border Grid.Row="0" BorderThickness="0" BorderBrush="#A0A0A0" Margin="0 0 0 0" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Text="复制持仓" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="10 0 0 0"  TextTrimming="CharacterEllipsis" Style="{StaticResource SystemSetTextBoxStyle}" Foreground="{DynamicResource DefaultGridForground}" FontFamily="MicroSoft YaiHei"  FontWeight="Bold"/>

                <DataGrid x:Name="TPDataGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="0 -10 0 0"  Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}" ItemsSource="{Binding GridDatas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                   RowHeaderWidth="0"  RowDetailsVisibilityMode="Visible"  HorizontalScrollBarVisibility="Disabled" RowStyle="{DynamicResource DataGridRowStyle}" VerticalGridLinesBrush="Transparent" Width="640"
                   GridLinesVisibility="None" HeadersVisibility="None" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
                    <DataGrid.Columns>
                        <!--<DataGridTemplateColumn Header="Id" MinWidth="20" Visibility="Visible">
                            
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding id}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource SystemSetTextBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="TextBlock.HorizontalAlignment" Value="Left"/>
                                    <Setter Property="TextBlock.VerticalAlignment" Value="Top"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>-->

                        <DataGridTemplateColumn Header="说明" MinWidth="6">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource SystemSetTextBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="TextBlock.HorizontalAlignment" Value="Left"/>
                                    <Setter Property="TextBlock.VerticalAlignment" Value="Top"/>
                                    <Setter Property="TextBlock.Margin" Value="0 2 0 0"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="开关" Width="*" >
                            <DataGridTemplateColumn.CellTemplateSelector>
                                <SelectorT:MsgAlertSettingSelector />
                            </DataGridTemplateColumn.CellTemplateSelector>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="TextBlock.HorizontalAlignment" Value="Left"/>
                                    <Setter Property="TextBlock.VerticalAlignment" Value="Top"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="Height" Value="Auto"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!--<DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" BorderThickness="0,0,0,0" x:Name="RowDetail" Visibility="Collapsed" Margin="20 -4 0 0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" MinHeight="38"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Row="0">
                                        <ItemsControl x:Name="TradeListBox"  Background="Transparent" ItemsSource="{Binding subList}"  Width="520">
                                            <ItemsControl.Template>
                                                <ControlTemplate>
                                                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True" ItemHeight="30" ItemWidth="120" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <CheckBox Content="{Binding name}" ToolTip="{Binding code}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" IsChecked="{Binding ischecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding isenabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Visibility="{Binding visible,Converter={StaticResource PPBoolVisibilityConvertor}}" FontSize="12" FontFamily="MicroSoft YaiHei" Margin="0 0 10 5"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding subList.isgroup}" Value="true"/>
                                        <Condition Binding="{Binding subList.visible}" Value="true"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" TargetName="RowDetail" Value="Visible"></Setter>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding subList}" Value="{x:Null}"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" TargetName="RowDetail" Value="Collapsed"></Setter>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>-->
                </DataGrid>
            </Grid>
        </Border>

        <!--命令区域-->
        <Border Grid.Row="1" BorderThickness="0" BorderBrush="#A0A0A0" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="0"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="恢复默认" Margin="10,0,0,0" Command="{Binding RestoreDefaultCommand}" Visibility="{Binding MsgAlertVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12"  Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0,1,0,0"  Width="80" Height="24" ToolTip="恢复到全局默认设置"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!--Button Content="取消" Command="{Binding CancelCommand}" Visibility="{Binding MsgAlertVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12"  Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0,1,0,0"  Width="80" Height="24"/-->
                    <Button Content="确认" Margin="0,0,10,0" Command="{Binding ConfirmCommand}" FontSize="12"  Style="{DynamicResource BlueGreenStyle}" BorderThickness="0,1,0,0"  Width="80" Height="24" ToolTip="保存个人设置"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
