<?xml version="1.0" encoding="utf-8"?>
<!--
    项目级 NuGet 配置。
    仓库内所有其它工程都用 Reference+HintPath 或 packages.config,
    CommunityToolkit.Mvvm 是仓库首个 PackageReference。
    为保证 Jenkins 离线可构建, 包体直接随仓库提交在 nuget/ 目录, 并 <clear /> 掉 nuget.org。
    新增/升级包时: 先 `nuget install <id> -Version <ver> -OutputDirectory <tmp>` 拉全依赖链,
    再把 .nupkg 拷进 nuget/ 并同步更新本文件旁的 nuget/README.md 清单。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="repo-local" value="nuget" />
  </packageSources>
  <config>
    <!-- 还原展开目录, 避免污染开发机全局缓存, 也让 CI 上的产物可预期 -->
    <add key="globalPackagesFolder" value="packages\gpf" />
  </config>
</configuration>
