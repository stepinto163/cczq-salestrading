<UserControl x:Class="STC.Common.View.Setting.InnerSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Setting"
             xmlns:comp="clr-namespace:STC.Common.View.Component"
             xmlns:con="clr-namespace:STC.Common.Convertor"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" MinHeight="340" Margin="20,0,20,0" HorizontalAlignment="Left" VerticalAlignment="Top">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>-->
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <con:RadioButtonConverter x:Key="radioBtnConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"></RowDefinition>
            <!--<RowDefinition Height="Auto"></RowDefinition>-->
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition/>
        </Grid.RowDefinitions>
            <StackPanel x:Name="copyModeSp" Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                <TextBlock Text="行情复制" Foreground="#D7D7D7"/>
            <RadioButton x:Name="InnerModeChk" Content="内部最优" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding IsInnerCopyModeChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <RadioButton x:Name="BrokerModeChk" Content="经纪商最优" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsBrokerCopyModeChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <RadioButton x:Name="NoneModeChk" Content="无价量" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsNoneCopyModeChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        
            <StackPanel x:Name="rateSP" Orientation="Horizontal" Grid.Row="1">
                <TextBlock Text="利率" Foreground="SkyBlue"  VerticalAlignment="Top" Margin="0 8 5 0" />
                <ItemsControl x:Name="RateListBox"  Background="Transparent" VerticalAlignment="Center"
                                     ItemsSource="{Binding RateList}" Width="420"> 
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Foreground="#D7D7D7" Padding="5 0 0 0"  Margin="0 0 10 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <StackPanel x:Name="creditSP" Orientation="Horizontal" Grid.Row="2">
                <TextBlock Text="信用" Foreground="SkyBlue"  VerticalAlignment="Top" Margin="0 0 5 0"/>
                <ItemsControl x:Name="CreditListBox"  Background="Transparent" VerticalAlignment="Center"
                                     ItemsSource="{Binding CreditList}"  Width="420"
                                     >
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}"  Foreground="#D7D7D7" Padding="5 0 0 0" Margin="0 0 10 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <Border BorderThickness="0 1 0 0" BorderBrush="#282828" Margin="10 0 10 0" Grid.Row="3"/>
        
            <StackPanel Orientation="Horizontal"  Grid.Row="3">
                <TextBlock Text="排序" Foreground="#D7D7D7" VerticalAlignment="Center"  Margin="0 0 5 0"/>
                <ItemsControl x:Name="CommonBox"  Background="Transparent" VerticalAlignment="Center"
                                     ItemsSource="{Binding CommonList}"  Width="420">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource  GreenBlueCheckedNormalCheckBox}"  Foreground="#D7D7D7" Padding="5 0 0 0" Margin="0 0 10 5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="4">
                <TextBlock Text="分割符" Foreground="#D7D7D7"/>

                <RadioButton x:Name="SpaceChk" Content="空格" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding IsSpaceChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <RadioButton x:Name="LongSpaceChk" Content="长空格" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsLongSpaceChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <RadioButton x:Name="TagChk" Content="Tab制表符" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsTagChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

        <Grid Grid.Row="5" Height="130">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition/>
                <RowDefinition Height="24"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="加减点步长" Foreground="#D7D7D7"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20 0 0 0" VerticalAlignment="Top">
                <comp:DrpNumericUpDown x:Name="bp1" Height="24" Width="80" NumericValue="{Binding BP1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                TextContentAlignment="Left" TextForeground="White" Foreground="White"  VerticalAlignment ="Center" DecimalLength="2" RangeValue="1" MaxValue="100" MinValue="0" UpDownBorderThickness="1" NumBorderBrush="#3C3C3C" UpDownBackground="#282828" UpDownBorderBrush="#282828" UpMargin="0,1,1,0"  DownMargin="0,1,1,1"
                                                                FontFamily="MicroSoft YaiHei" FontSize="14" FontWeight="Bold" Padding="0,0,0,0" AllowEmpty="True"/>
                <TextBlock Text="bp" Foreground="#D7D7D7" VerticalAlignment="Center" Margin="2 0 10 0"/>
                <comp:DrpNumericUpDown x:Name="bp2" Height="24" Width="80" NumericValue="{Binding BP2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                TextContentAlignment="Left" TextForeground="White" Foreground="White"  VerticalAlignment ="Center" DecimalLength="2" RangeValue="1" MaxValue="100" MinValue="0" UpDownBorderThickness="1" NumBorderBrush="#3C3C3C" UpDownBackground="#282828" UpDownBorderBrush="#282828" UpMargin="0,1,1,0"  DownMargin="0,1,1,1"
                                                                FontFamily="MicroSoft YaiHei" FontSize="14" FontWeight="Bold" Padding="0,0,0,0" AllowEmpty="True"/>
                <TextBlock Text="bp" Foreground="#D7D7D7" VerticalAlignment="Center" Margin="2 0 10 0"/>
                <comp:DrpNumericUpDown x:Name="bp3" Height="24" Width="80" NumericValue="{Binding BP3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                TextContentAlignment="Left" TextForeground="White" Foreground="White"  VerticalAlignment ="Center" DecimalLength="2" RangeValue="1" MaxValue="100" MinValue="0" UpDownBorderThickness="1" NumBorderBrush="#3C3C3C" UpDownBackground="#282828" UpDownBorderBrush="#282828" UpMargin="0,1,1,0"  DownMargin="0,1,1,1"
                                                                FontFamily="MicroSoft YaiHei" FontSize="14" FontWeight="Bold" Padding="0,0,0,0" AllowEmpty="True"/>
                <TextBlock Text="bp" Foreground="#D7D7D7" VerticalAlignment="Center" Margin="2 0 10 0"/>
            </StackPanel>
            <TextBlock  Grid.Row="2" Text="推荐语" Foreground="#D7D7D7"/>
            <TextBox x:Name="RecommedTB" Grid.Row="3" Text="{Binding Recommendation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource STCDefaultBoxStyle}" Width="296" Height="24" HorizontalAlignment="left" VerticalAlignment="Top" Margin="20 0 0 0" MaxLength="200"/>
            <TextBlock Grid.Row="4" Margin="280 0 0 0"><Run Foreground="#D7D7D7" Text="{Binding CurrentRecommendationLength}"></Run><Run Foreground="#A0A0A0">/200</Run></TextBlock>
        </Grid>

        <Border Grid.Row="6" Visibility="{Binding CreditRateVisible, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}">
            <Grid Height="100">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock Text="日初订单恢复提醒" Foreground="#D7D7D7" Grid.Row="0" />

                <StackPanel Orientation="Horizontal" Grid.Row="1"  Margin="0 8 5 0">
                    <TextBlock Text="利率" Foreground="SkyBlue"  VerticalAlignment="Top"/>
                    <RadioButton  Content="无需恢复" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding RateNoRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" VerticalAlignment="Top"/>
                    <RadioButton  Content="手动恢复" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding RateManualRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" VerticalAlignment="Top"/>
                    <RadioButton  Content="自动恢复" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding RateAutoRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" VerticalAlignment="Top"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="2"  Margin="0 8 5 0">
                    <TextBlock Text="信用" Foreground="SkyBlue"  VerticalAlignment="Top"/>
                    <RadioButton  Content="无需恢复" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding CreditNoRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" VerticalAlignment="Top"/>
                    <RadioButton  Content="手动恢复" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding CreditManualRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" VerticalAlignment="Top"/>
                    <RadioButton  Content="自动恢复" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding CreditAutoRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" VerticalAlignment="Top"/>
                </StackPanel>


                <StackPanel Orientation="Horizontal" Grid.Row="3"  HorizontalAlignment="Right" Margin="0 4,5,0">
                    <TextBlock Text="注：如设置提醒手工恢复、自动恢复，将于次日上午 8:00 生效" Foreground="#D7D7D7" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>


        <Border Grid.Row="7" Margin="0 10 10 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Text="订阅范围" Foreground="#D7D7D7" Grid.Row="0" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 8 5 0">
                        <CheckBox Content="内部" IsChecked="{Binding INNERIsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Foreground="#D7D7D7" Padding="5 0 0 0"  Margin="0 0 10 0"/>
                        <CheckBox Content="经纪商行情" IsChecked="{Binding BrokerIsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}"  Foreground="#D7D7D7" Padding="5 0 0 0" Margin="0 0 10 0"/>
                    </StackPanel>
                </Grid>
            </Border>

        <!--<Border Grid.Row="8" Margin="0 24 10 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="双击自动发送QQ信息设置" Foreground="#D7D7D7" Grid.Row="0" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="54 10 5 0">
                    <CheckBox Content="勾选后,双击报价自动发送报价信息到QQ" IsChecked="{Binding IsAutoSendQQ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Foreground="#D7D7D7" Padding="5 0 0 0"  Margin="0 0 10 0"/>
                </StackPanel>
            </Grid>
        </Border>-->
        <Border Grid.Row="8" Margin="0 24 10 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="报价精度" Foreground="#D7D7D7" Grid.Row="0" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="54 10 5 0">
                    <TextBlock Text="利率" Foreground="SkyBlue"  VerticalAlignment="Top" Margin="0 0 5 0"/>
                    <RadioButton x:Name="Interest2" Content="2位" Style="{DynamicResource DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding IsRateDPChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
                    <RadioButton x:Name="Interest4" Content="4位" Style="{DynamicResource DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding IsRateDPChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource radioBtnConverter}, ConverterParameter='2'}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="54 10 5 0">
                    <TextBlock Text="信用" Foreground="SkyBlue"  VerticalAlignment="Top" Margin="0 0 5 0"/>
                    <RadioButton x:Name="Credit2" Content="2位" Style="{DynamicResource DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding IsCreditDPChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
                    <RadioButton x:Name="Credit4" Content="4位" Style="{DynamicResource DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding IsCreditDPChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource radioBtnConverter}, ConverterParameter='2'}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>
