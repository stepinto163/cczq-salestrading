<UserControl x:Class="STC.Common.View.Card.MarketCardOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Card"
             xmlns:commConv="clr-namespace:STC.Common.Convertor"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"  Initialized="MarketExecution_Initialized"
             d:DesignWidth="286" d:DesignHeight ="60">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <commConv:LastIsValidConverter x:Key="lastIsValidConverter"/>
            <commConv:LastImageVisibilityConverter x:Key="lastImageVisibilityConverter"/> 
            <!--高开低收-->
            <SolidColorBrush x:Key="Textblock.Foreground.HOLC.Gray" Color="#788187"/>
            <SolidColorBrush x:Key="Textblock.Foreground.Red" Color="#FF3C3C"/>
            <SolidColorBrush x:Key="Textblock.Foreground.Green" Color="#21DF1F"/>
            <SolidColorBrush x:Key="Textblock.Foreground.Gray" Color="#8F9598"/>
            <!--字体-->
            <FontFamily x:Key="Font.MicrosoftYaHei">Microsoft YaHei</FontFamily>
            <FontFamily x:Key="Font.MicrosoftYaHei.Bold">MicrosoftYaHei-Bold</FontFamily>
            <FontFamily x:Key="Font.MicrosoftYaHeiSemibold">MicrosoftYaHeiSemibold</FontFamily>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 右下角的占位颜色 -->
                                <Rectangle x:Name="Corner" Grid.Column="1" Fill="Transparent" Grid.Row="1"/>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Grid.Column="0" Margin="{TemplateBinding Padding}" Grid.Row="0"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Grid.Row="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}"/>
                                <ScrollBar x:Name="PART_HorizontalScrollBar" AutomationProperties.AutomationId="HorizontalScrollBar" Cursor="Arrow" Grid.Column="0" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0" Orientation="Horizontal" Grid.Row="1" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportWidth}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!--ListView样式-->
            <Style x:Key="ListViewStyle" TargetType="{x:Type ListBox}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Gray"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource MainBackgroup.ColorBrush}"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
            </Style>
            
            <!--ItemContainerStyle样式-->
            <Style x:Key="ListViewItemContainerStyle" TargetType="{x:Type ListBoxItem}">
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Background" Value="#193D37"/>
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property ="IsHitTestVisible" Value="True"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="true">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ListView.AlternationIndex" Value="0"></Condition>
                                <Condition Property="IsMouseOver" Value="False"></Condition>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource MainBackgroup.ColorBrush}"></Setter>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ListView.AlternationIndex" Value="1"></Condition>
                                <Condition Property="IsMouseOver" Value="False"></Condition>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource MainBackgroup.ColorBrush}"></Setter>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                             <Setter Property="Background" Value="{DynamicResource Item.MouseOver.Background}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            
            
            <!--买卖样式-->
            <Style x:Key="TempSizeStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="24"></Setter>
                <Setter Property="Width" Value="40"></Setter>
                <Setter Property="Padding" Value="0,4,0,0"></Setter>
                <Setter Property="TextAlignment" Value="Center"></Setter>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="X"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="Z"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Green}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="Y"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="1"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="3"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Green}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="2"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                    </MultiDataTrigger>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource lastIsValidConverter}">
                                <Binding Path="IsValid" />
                                <Binding Path="IsOwnInst" />
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Foreground" Value="{DynamicResource Textblock.Foreground.HOLC.Gray}" />
                    </DataTrigger>
                </Style.Triggers>

            </Style>
            
             <DataTemplate x:Key="TempSide">
                <TextBlock x:Name="tSideName" Style="{DynamicResource TempSizeStyle}" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"  FontSize="11"></TextBlock>
            </DataTemplate>

            <!--渠道样式-->
            <Style x:Key="TempSourceTraderStyle" TargetType="TextBlock" BasedOn="{StaticResource SourceTraderStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsValid}" Value="N">
                        <Setter Property="Foreground" Value="#4A4D4C" />
                        <Setter Property="Background" Value="#282828" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="TempSourceTrader">
                <TextBlock x:Name="SourceTraderText"  Style="{DynamicResource TempSourceTraderStyle}" FontSize="11"></TextBlock>
            </DataTemplate>

            <!--是否有效样式-->
            <Style x:Key="imageValidStyle" TargetType="Image">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsValid}" Value="N">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsValid}" Value="Y">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--价格样式-->
            <Style x:Key="TextBlockPriceStyle" TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsValid}" Value="N">
                        <Setter Property="Foreground" Value="{DynamicResource Textblock.Foreground.HOLC.Gray}" />
                    </DataTrigger>
                </Style.Triggers>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>

            <!--时间样式-->
            <Style x:Key="TimeStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Foreground" Value="{DynamicResource Textblock.Foreground.HOLC.Gray}"/>
                <Setter Property="Padding" Value="0,4,0,0"></Setter>
                <Setter Property="TextBlock.TextAlignment" Value="Center"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="TextAlignment" Value="Center"></Setter>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
            </Style>

            <!--涨跌样式-->
            <Style x:Key="DownUpStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="10"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DownUpBrush}" Value="0"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="#FFFFFF" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DownUpBrush}" Value="2"/>
                        </MultiDataTrigger.Conditions>
                        <Setter  Property="Foreground" Value="{DynamicResource Textblock.Foreground.Red}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DownUpBrush}" Value="1"/>
                        </MultiDataTrigger.Conditions>
                        <Setter  Property="Foreground" Value="{DynamicResource Textblock.Foreground.Green}" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsValid}" Value="N">
                        <Setter Property="Foreground" Value="{DynamicResource Textblock.Foreground.Gray}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            
            
            <Style x:Key="TabControlStyle" TargetType="{x:Type TabControl}">
                <Setter Property="Padding" Value="2"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource RedButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource RedButton.Static.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid x:Name="templateRoot" ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColumnDefinition0"/>
                                    <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                                    <RowDefinition x:Name="RowDefinition1" Height="*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid x:Name="HeaderPanel" Rows="1" Background="Transparent" Grid.Column="0" IsItemsHost="True" Margin="0" Grid.Row="0" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
                                <Line X1="0" X2="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" Stroke="White" StrokeThickness="0.1" VerticalAlignment="Bottom" Margin="0 0 0 0" SnapsToDevicePixels="True"/>
                                <Border x:Name="ContentPanel" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.Column="0" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentTemplate="{TemplateBinding SelectedContentTemplate}" Content="{TemplateBinding SelectedContent}" ContentStringFormat="{TemplateBinding SelectedContentStringFormat}" ContentSource="SelectedContent" Margin="0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="TabStripPlacement" Value="Bottom">
                                    <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="1"/>
                                    <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                    <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                    <Setter Property="Height" TargetName="RowDefinition1" Value="Auto"/>
                                </Trigger>
                                <Trigger Property="TabStripPlacement" Value="Left">
                                    <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="0"/>
                                    <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                    <Setter Property="Grid.Column" TargetName="HeaderPanel" Value="0"/>
                                    <Setter Property="Grid.Column" TargetName="ContentPanel" Value="1"/>
                                    <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto"/>
                                    <Setter Property="Width" TargetName="ColumnDefinition1" Value="*"/>
                                    <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                    <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                                </Trigger>
                                <Trigger Property="TabStripPlacement" Value="Right">
                                    <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="0"/>
                                    <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                    <Setter Property="Grid.Column" TargetName="HeaderPanel" Value="1"/>
                                    <Setter Property="Grid.Column" TargetName="ContentPanel" Value="0"/>
                                    <Setter Property="Width" TargetName="ColumnDefinition0" Value="*"/>
                                    <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto"/>
                                    <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                    <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="templateRoot" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{DynamicResource MainBackgroup.ColorBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource RedButton.Static.Border}"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid x:Name="templateRoot"  SnapsToDevicePixels="True" Background="Transparent" Margin="1,0,1,0" Height="{TemplateBinding Height}">
                                <TextBlock x:Name="txt" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{TemplateBinding Header}" ToolTip="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type TabControl}}}" Value="Top"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" TargetName="txt" Value="#FFFFFF"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="false"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type TabControl}}}" Value="Left"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Opacity" TargetName="templateRoot" Value="0.56"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="false"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type TabControl}}}" Value="Bottom"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Opacity" TargetName="templateRoot" Value="0.56"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="false"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type TabControl}}}" Value="Right"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Opacity" TargetName="templateRoot" Value="0.56"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="false"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type TabControl}}}" Value="Top"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Opacity" TargetName="templateRoot" Value="0.56"/>
                                </MultiDataTrigger>

                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type TabControl}}}" Value="Top"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Panel.ZIndex" Value="1"/>
                                    <Setter Property="Foreground" TargetName="txt" Value="#FFFFFF"/>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                </MultiDataTrigger>


                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="false"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type TabControl}}}" Value="Top"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Panel.ZIndex" Value="1"/>
                                    <Setter Property="Foreground" TargetName="txt" Value="#FFFFFF"/>
                                    <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource MainBackgroup.ColorBrush}"/>
                                </MultiDataTrigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HOLCStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Height" Value="16"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Text}" Value="--">
                        <Setter Property="Foreground" Value="#4A4D4C"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Text}" Value="- -">
                        <Setter Property="Foreground" Value="#4A4D4C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <!--<RowDefinition Height="{Binding OhlcHeight}"></RowDefinition>-->
            <RowDefinition Height="{Binding OhlcHeight}"></RowDefinition>
            <RowDefinition MinHeight="30"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource MainSplitterBackgroup.ColorBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"></ColumnDefinition>
                <ColumnDefinition Width="25"></ColumnDefinition>
                <ColumnDefinition Width="24"></ColumnDefinition>
                <ColumnDefinition Width="16"></ColumnDefinition>
                <ColumnDefinition Width="32*"></ColumnDefinition>
                <ColumnDefinition Width="16"></ColumnDefinition>
                <ColumnDefinition Width="32*"></ColumnDefinition>
                <ColumnDefinition Width="16"></ColumnDefinition>
                <ColumnDefinition Width="32*"></ColumnDefinition>
                <ColumnDefinition Width="25"></ColumnDefinition>
                <ColumnDefinition Width="32*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <!--X-Bound 清算速度-->
                <ListBox x:Name="lbPirceType" SelectionMode="Single" Grid.Column="0" Grid.ColumnSpan="2"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                                     Height="24" 
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectedIndex="{Binding ListTypeIndex, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"
                                     SelectionChanged="lbPirceType_SelectionChanged"
                                     FontSize="12"
                                     BorderBrush="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem x:Name="btnListFloatButton" Width="20" Height="18" Style="{DynamicResource ListFloatBlueButton}"/>
                <ListBoxItem x:Name="btnChatFloatButton" Width="20" Height="18" Style="{DynamicResource ListChatBlueButton}"/>
            </ListBox>
            <!--<CheckBox Grid.Column="0" Visibility="Collapsed" x:Name="btnListFloatButton" Style="{StaticResource KLineButton}" Height="24" Width="24" Margin="1,0,0,0" IsChecked="{Binding ListFloatButtonChecked, Mode=TwoWay}" Checked="btnListFloatButton_Checked" Unchecked="btnListFloatButton_Checked"></CheckBox>
            <CheckBox Grid.Column="2" Visibility="Collapsed" x:Name="btnChatFloatButton" Style="{StaticResource KLineButton}" Height="24" Width="24" HorizontalAlignment="Center"  IsChecked="{Binding ChatFloatButtonChecked, Mode=TwoWay}"></CheckBox>-->

            <Button Grid.Column="2" Width="24" Height="24"  BorderThickness="0" Style="{DynamicResource KLineButton}"  ToolTip="查看K线分析"  Click="btnKline_Click"/>
            
            <TextBlock Grid.Column="3" Margin="0,0,0,0" Text="昨:" Width="15" HorizontalAlignment="Right" Foreground="{StaticResource Textblock.Foreground.HOLC.Gray}"  FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource Font.MicrosoftYaHei}"></TextBlock>
            <TextBlock Grid.Column="4" Margin="2,5,0,0" 
                       Text="{Binding CloseYield, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       Visibility="{Binding IsYieldType,Converter={StaticResource visibilityConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding CloseYield}"  Style="{DynamicResource HOLCStyle}">
            </TextBlock>
            <TextBlock Grid.Column="4" Margin="2,5,0,0" 
                       Text="{Binding CloseNetPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       Visibility="{Binding IsYieldType,Converter={StaticResource reversevisibilityConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding CloseNetPx}"  Style="{DynamicResource HOLCStyle}">
            </TextBlock>
            <TextBlock Grid.Column="5" Text="高:" Width="15"  HorizontalAlignment="Right" Foreground="{StaticResource Textblock.Foreground.HOLC.Gray}"  FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource Font.MicrosoftYaHei}" ></TextBlock>
            <TextBlock Grid.Column="6"  Margin="2,5,0,0" 
                       Text="{Binding HighYield, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       Visibility="{Binding IsYieldType,Converter={StaticResource visibilityConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding HighYield}" Style="{DynamicResource HOLCStyle}">
            </TextBlock>
            <TextBlock Grid.Column="6"  Margin="2,5,0,0" 
                       Text="{Binding HighNetPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       Visibility="{Binding IsYieldType,Converter={StaticResource reversevisibilityConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding HighNetPx}" Style="{DynamicResource HOLCStyle}">
            </TextBlock>
            <TextBlock Grid.Column="7" Text="低:" Width="15" HorizontalAlignment="Right" Foreground="{StaticResource Textblock.Foreground.HOLC.Gray}"  FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource Font.MicrosoftYaHei}"></TextBlock>

            <TextBlock Grid.Column="8"  Margin="2,5,0,0" 
                       Text="{Binding LowYield, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       Visibility="{Binding IsYieldType,Converter={StaticResource visibilityConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding LowYield}" Style="{DynamicResource HOLCStyle}">
            </TextBlock>
            <TextBlock Grid.Column="8"  Margin="2,5,0,0" 
                       Text="{Binding LowNetPx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       Visibility="{Binding IsYieldType,Converter={StaticResource reversevisibilityConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="{Binding LowNetPx}" Style="{DynamicResource HOLCStyle}">
            </TextBlock>

            <TextBlock Grid.Column="9" Text="成交:" Width="25" HorizontalAlignment="Left" Foreground="{StaticResource Textblock.Foreground.HOLC.Gray}"  FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource Font.MicrosoftYaHei}"></TextBlock>
            <StackPanel Orientation="Horizontal" Grid.Column="10" >
                <TextBlock Height="16" Margin="2,6,0,0" Text="{Binding OrderCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding OrderCount}" Style="{DynamicResource HOLCStyle}">
                </TextBlock>
                <TextBlock Grid.Column="6" Text="笔" Width="15" HorizontalAlignment="Right" Margin="3,3,0,0"  Foreground="{StaticResource Textblock.Foreground.HOLC.Gray}"  FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource Font.MicrosoftYaHei}" ToolTip="{Binding SearchText}"></TextBlock>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,0,0">
               <TabControl BorderBrush="Transparent" x:Name="Tab_DgPrice" BorderThickness="0" Style="{DynamicResource TabControlStyle}" Margin="0">
                        <TabItem Header="列表模式" BorderThickness="1" BorderBrush="Transparent" Style="{DynamicResource TabItemStyle}" Height="0">
                        <ListView AlternationCount="2" x:Name="dgMarket" VirtualizingPanel.IsVirtualizing="True"  ScrollViewer.CanContentScroll="True"  VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ItemsSource="{Binding FilteredMarketExecutions.View, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ListViewStyle}" Background="{DynamicResource MainBackgroup.ColorBrush}"  ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                 ScrollViewer.VerticalScrollBarVisibility="{Binding HorizontalScrollBarVisibility,Mode=TwoWay}"  ItemContainerStyle="{DynamicResource ListViewItemContainerStyle}">
                                <!--<ListView.View>
                <GridView x:Name="GrdView_Students">
                    <GridViewColumn Width="40" Header="学号" CellTemplate="{StaticResource TempSide}" />
                    <GridViewColumn Width="60" Header="姓名" CellTemplate="{StaticResource TempSourceTrader}"/>
                </GridView>
            </ListView.View>-->
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                    <DataTemplate>
                                    <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" MinWidth="32"/>
                                                <ColumnDefinition Width="26" MinWidth="26"/>
                                                <ColumnDefinition Width="50*" MinWidth="50"/>
                                            <ColumnDefinition Width="64*" MinWidth="64"/>
                                            <ColumnDefinition Width="50" MinWidth="50"/>
                                            <ColumnDefinition Width="42" MinWidth="42"/>
                                                <ColumnDefinition Width="50*" MinWidth="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock  Grid.Column="0" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side2'}"  FontSize="11" Style="{StaticResource TempSizeStyle}" />
                                        <Image Grid.Column="1" Height="12"  
                                               Source="/STC.Common;component/Images/stclite-invalid.png"
                                               ToolTip="{Binding OwnInstTip}">
                                            <Image.Visibility>
                                                <MultiBinding Converter="{StaticResource lastImageVisibilityConverter}">
                                                    <Binding Path="IsValid" />
                                                    <Binding Path="IsOwnInst" />
                                                </MultiBinding>
                                            </Image.Visibility>
                                        </Image>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" >
                                            <TextBlock x:Name="tbYield" Text="{Binding ExecutePricePercent_Display, Converter={StaticResource numConvertor}}" 
                                                       Visibility="{Binding DataContext.IsYieldType, RelativeSource={RelativeSource AncestorType={x:Type ListView}, Mode=FindAncestor},Converter={StaticResource visibilityConvertor}}"
                                                       FontSize="12" Style="{DynamicResource TextBlockPriceStyle}"></TextBlock>
                                            <TextBlock x:Name="tbNetPx" Text="{Binding NetPrice_Display, Converter={StaticResource numConvertor}}" 
                                                       Visibility="{Binding DataContext.IsYieldType, RelativeSource={RelativeSource AncestorType={x:Type ListView}, Mode=FindAncestor},Converter={StaticResource reversevisibilityConvertor}}"
                                                       FontSize="12" Style="{DynamicResource TextBlockPriceStyle}"></TextBlock>
                                            <Border x:Name="YuanQi" CornerRadius="2" Width="12" Height="14" Visibility="{Binding SettlTypeYuanVis,Converter={StaticResource visibilityConvertor}}" Background="{DynamicResource MainSplitterBackgroup.ColorBrush}" 
                                                    BorderThickness="0" Margin="2,0,0,0" ToolTip="{Binding SettlType_yuan, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_tooltip'}">
                                                <TextBlock Text="远" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FFFFFF" 
                                                   ToolTip="{Binding SettlType_yuan, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_tooltip'}"/>
                                            </Border>
                                            <Border x:Name="T0" CornerRadius="2" Width="14" Height="14" Visibility="{Binding SettlTypeT0Vis,Converter={StaticResource visibilityConvertor}}"
                                                    BorderThickness="0" Margin="2,0,0,0">
                                                <TextBlock Text="+0" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FFFFFF" Background="#6E2022"/>
                                            </Border>
                                        </StackPanel>
                                        <!--涨跌-->
                                             <!--<TextBlock Grid.Column="3" x:Name="tbDownUp"  Style="{DynamicResource DownUpStyle}">-->
                                        <TextBlock Grid.Column="3" x:Name="tbDownUp" 
                                                   Text="{Binding Bp, Converter={StaticResource numConvertor}, ConverterParameter=2}"
                                                   Visibility="{Binding DataContext.IsYieldType, RelativeSource={RelativeSource AncestorType={x:Type ListView}, Mode=FindAncestor},Converter={StaticResource visibilityConvertor}}"
                                                   Style="{DynamicResource DownUpStyle}">
                                            </TextBlock>
                                        <TextBlock Grid.Column="3" x:Name="tbDownUpNetPx" 
                                                   Text="{Binding NetPriceSpread, Converter={StaticResource numConvertor}, ConverterParameter=3}"
                                                   Visibility="{Binding DataContext.IsYieldType, RelativeSource={RelativeSource AncestorType={x:Type ListView}, Mode=FindAncestor},Converter={StaticResource reversevisibilityConvertor}}"
                                                       
                                                   Style="{DynamicResource DownUpStyle}">
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding LastQty}" FontSize="12" Style="{DynamicResource TextBlockPriceStyle}"
                                                   HorizontalAlignment="Left" ToolTip="{Binding LastQty}"></TextBlock>

                                        <!--渠道-->
                                            <Border Grid.Column="5"  Height="16" Width="40" CornerRadius="2" ToolTip="{Binding InstitutionName}" Visibility="Visible">
                                                <TextBlock Text="{Binding SourceTrader,Converter={StaticResource EnumTypeConvertor},ConverterParameter=venuesxb}" Width="40" Style="{DynamicResource TempSourceTraderStyle}"/>
                                                <Border.BorderBrush>
                                                    <MultiBinding Converter="{StaticResource venuesBordreBurshColorConvertor}">
                                                        <Binding Path="SourceTrader"/>
                                                        <Binding Path="IsValid"/>
                                                </MultiBinding>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource venuesBordreBurshColorConvertor}">
                                                        <Binding Path="SourceTrader"/>
                                                        <Binding Path="IsValid"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                            </Border>
                                            <!--时间-->
                                        <TextBlock  Grid.Column="6"  Style ="{DynamicResource TimeStyle}" Text="{Binding Time, Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" ToolTip="{Binding Time}"/>
                                        </Grid>
                                    </DataTemplate>

                                </ListView.ItemTemplate>
                                <!--隐藏列头-->
                                <ListView.Resources>
                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </ListView.Resources>
                            </ListView>
                        </TabItem>
                        <TabItem Header="图表模式" BorderThickness="0"  BorderBrush="Transparent"  Style="{DynamicResource TabItemStyle}"  Height="0">
                            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" >

                            </Frame>
                        </TabItem>
                    </TabControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
