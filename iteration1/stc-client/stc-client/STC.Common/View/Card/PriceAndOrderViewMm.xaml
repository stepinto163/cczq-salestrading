                            <Setter TargetName="duo" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="T0" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="YuanQi" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

