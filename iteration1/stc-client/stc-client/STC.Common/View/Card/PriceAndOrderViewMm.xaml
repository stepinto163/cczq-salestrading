                    --><!--鼠标移过--><!--
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Ofr.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Ofr.MouseOver.BorderBrush}"/>
                    </MultiTrigger>
                    --><!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色--><!--
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Ofr.Selected.Backgroud}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Ofr.Selected.BorderBrush}"/>
