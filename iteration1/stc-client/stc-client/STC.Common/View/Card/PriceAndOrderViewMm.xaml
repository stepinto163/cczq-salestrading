                             HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                             CellStyle="{StaticResource QuotationList_DataGridCellStyle_left}">
                            <!--MouseDoubleClick="DgBid_MouseDoubleClick" LostFocus="DgBid_LostFocus"-->
                            <DataGrid.Columns>
                                <!-- Venues -->
                                <DataGridTemplateColumn  Header="S" Width="24" CellTemplate="{StaticResource Bid_Source_DataTemplate}"/>
                                <!-- Settler  -->
                                <DataGridTemplateColumn Width="16" CellTemplate="{StaticResource Bid_SettleType_DataTemplate}" />
                                <!-- Total Qty -->
                                <DataGridTemplateColumn Header="累计" Width="32" CellTemplate="{StaticResource Bid_Qty_DataTemplate}"/>
                                <!--  Sign -->
                                <DataGridTemplateColumn x:Name="bidEntryPxColumn" Header="%" Width="60">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource Bid_QuotationList_DataGridColumnHeaderStyle}">
                                                <Setter Property="Margin" Value="0,0,0,0"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="14"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="EntryPx_TB" HorizontalAlignment="Right" Style="{StaticResource EnlargeFontSizeElementStyle_Bid}" Text="{Binding Yield, Converter={StaticResource FormatPriceConvertor}}"
                                                            TextAlignment="Right"  Grid.Column="0"
                                                           TextTrimming="WordEllipsis"
                                                           ToolTip="{Binding Yield,Converter={StaticResource numConvertor},ConverterParameter=1}"  Margin="0,2,0,0"/>
                                                    <Image x:Name="bargainFlag_Img" Height="14" HorizontalAlignment="Left" Margin="0,0,0,0" Style="{StaticResource BargainFlagStyle}" Grid.Column="1"/>
                                                    </Grid>
                                                    <!--<DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HidePxFlag}" Value="1">
                                                            <Setter TargetName="EntryPx_TB" Property="Text" Value=""/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>-->
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <!--Ofr-->
                        <Border  Grid.Column="1" BorderThickness="1, 0, 0, 1"  Height="146" VerticalAlignment="Top" BorderBrush="#3C3C3C">
                            <DataGrid  x:Name="OfrDataGrid_Frozen" Margin="0,0,2,0" Height="146" VerticalAlignment="Top" ItemsSource="{Binding OfrQuotations}" 
                            Style="{StaticResource CardDataGrid}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}"
                             Background="{DynamicResource MainFrame.Background}"
                             HorizontalScrollBarVisibility="Hidden"  VerticalScrollBarVisibility="Hidden"
                             CellStyle="{StaticResource QuotationList_DataGridCellStyle}"
                             RowStyle="{DynamicResource OfrDataGridRowStyle}">
                                <!--MouseDoubleClick="DgBid_MouseDoubleClick" LostFocus="DgBid_LostFocus"-->
                                <DataGrid.Columns>
                                    <!-- ofr -->
                                    <!--  Sign -->
                                    <DataGridTemplateColumn x:Name="OfrEntryPxColumn" Header="%" Width="60"  Visibility="Visible">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource QuotationList_DataGridColumnHeaderStyle}">
                                                <Setter Property="Margin" Value="-2,0,0,0"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="EntryPx_TB"  Grid.Column="1"  Style="{StaticResource EnlargeFontSizeElementStyle_Ofr}" Text="{Binding Yield, Converter={StaticResource FormatPriceConvertor}}"
                                                       ToolTip="{Binding Yield,Converter={StaticResource numConvertor},ConverterParameter=1}" TextTrimming="WordEllipsis"
                                                       Margin="0,2,0,0"/>
                                                    <!--<TextBlock Text="{Binding FirmFlag, Converter={StaticResource FirmFlagConvertor}}" Margin="2,0,0,0" Width="6"
                                           Foreground="#FFFFFF" />-->
                                                    <Image x:Name="bargainFlag_Img" Height="13" Margin="0,0,0,0"  Style="{StaticResource BargainFlagStyle}" Grid.Column="0"/>
                                                </Grid>
                                                <!--<DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HidePxFlag}" Value="1">
                                                        <Setter TargetName="EntryPx_TB" Property="Text" Value=""/>
                                                        --><!--<Setter TargetName="bargainFlag_Img" Property="Visibility" Value="Collapsed"/>--><!--
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>-->
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Total Qty -->
                                    <DataGridTemplateColumn Header="累计" Width="34" CellTemplate="{StaticResource Ofr_Qty_DataTemplate}"/>
                                    <!-- Settler  -->
                                    <DataGridTemplateColumn Width="16" CellTemplate="{StaticResource Ofr_SettleType_DataTemplate}" />
                                    <!-- Venues -->
                                    <DataGridTemplateColumn  Header="S" Width="24" CellTemplate="{StaticResource Ofr_Venues_DataTemplate}"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

               </Grid>

            </Border>
        </Grid>
    </Border>
    
</UserControl>
