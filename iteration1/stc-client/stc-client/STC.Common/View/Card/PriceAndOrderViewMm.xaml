            <SolidColorBrush x:Key="Bid.MouseOver.BorderBrush" Color="#FF7D00"/>
            
            <SolidColorBrush x:Key="Ofr.Selected.Backgroud" Color="#4C009AFF"/>
            <SolidColorBrush x:Key="Ofr.Selected.BorderBrush" Color="#009AFF"/>
            <SolidColorBrush x:Key="Ofr.Selected.BorderBrush-16%" Color="#16009AFF"/>
            <SolidColorBrush x:Key="Ofr.Selected.BorderBrush-30%" Color="#30009AFF"/>
            <SolidColorBrush x:Key="Ofr.Selected.BorderBrush-50%" Color="#50009AFF"/>

            <SolidColorBrush x:Key="Ofr.MouseOver.Background" Color="#063B5B"/>
            <SolidColorBrush x:Key="Ofr.MouseOver.BorderBrush" Color="#009AFF"/>
            
            <SolidColorBrush x:Key="Popup.Background" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="Bid.textblock.foreground" Color="#FF7D00"/>
            <SolidColorBrush x:Key="Bid.textblock.foreground-30%" Color="#30FF7D00"/>
            <SolidColorBrush x:Key="Textblock.Foreground.Red" Color="#FF3C3C"/>
            <SolidColorBrush x:Key="Textblock.Foreground.Red-16%" Color="#20FF3C3C"/>
            <SolidColorBrush x:Key="Textblock.Foreground.Red-60%" Color="#90FF3C3C"/>
