            <SolidColorBrush x:Key="Textblock.Foreground.HOLC.Gray" Color="#788187"/>
            <!--Grid Hover Color-->
            <SolidColorBrush x:Key="Gird.MouseOver.Disable.BgBrush" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="Gird.MouseOver.Disable.BorderBrush" Color="#303030"/>


            <ContextMenu x:Key="OrderContextMenu" Style="{StaticResource DefaultContextMenu}"  ContextMenuOpening="UserControl_ContextMenuOpening">
                <MenuItem x:Name="miSendPrice" Header="报价" Style="{StaticResource DefaultMenuItem}" Click="OrderMenuItme_Click"/>
                <MenuItem x:Name="miEdit" Header="编辑" Style="{StaticResource DefaultMenuItem}" Click="MenuItem_Click"/>
                <MenuItem x:Name="miCancel" Header="撤销" Style="{StaticResource DefaultMenuItem}" Click="MiCancel_Click"/>
            </ContextMenu>


            <Style x:Key="BidBrokerBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.BidBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="需请示"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriceModel.BidBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="OfrBrokerBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.OfrBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="需请示"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriceModel.OfrBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
