                        <Image x:Name="Img"  Height="16" Width="16" Stretch="UniformToFill" Source="pack://application:,,,/STC.Common;component/Images/stc_icon_calendar_normal.png"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!--<Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>-->
