    <Style x:Key="listBoxItemContainStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="IsSelected" Value="{Binding Checked}"/>
        <Setter Property="Content" Value="{Binding Name}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter TargetName="border" Property="Background" Value="{Binding BgColor}"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="false">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ColorBrush.Gray15}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="true">
                            <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{DynamicResource ColorBrush.While}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{DynamicResource ColorBrush.While}"/>
                            <!--<Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>-->
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Width" Value="55"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Content" Value="{Binding Name}"/>
        <Setter Property="IsSelected" Value="{Binding Checked}"/>
        <Setter Property="Visibility" Value="{Binding ItemVisibility}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}" BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter TargetName="border" Property="Background" Value="{Binding BgColor}"></Setter>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="false">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ColorBrush.Gray15}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="true">
                            <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{DynamicResource ColorBrush.While}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{DynamicResource ColorBrush.Gray14}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
        <Setter Property="Background" Value="{DynamicResource ColorBrush.Gray15}"/>
        <Setter Property="FontSize" Value="12"/>
        <!--<Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>-->
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}">

                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="DatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <TextBox Text="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat=yyy/MM/dd}"
                                     BorderThickness="0" Background="#172422" FontSize="12px"
                                     Foreground="{StaticResource TextBlockForeground}" Padding="0, 4, 0, 0" TextAlignment="Center" FontFamily="Microsoft YaHei"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DatePickStyleBtns" TargetType="{x:Type Button}">
