<UserControl x:Class="STC.Common.View.Order.InnerView.StopProfitLossView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.Common.View.Order.InnerView"
             mc:Ignorable="d" 
             d:DesignHeight="98" d:DesignWidth="394">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/View/Order/SendPriceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent" >
                                <Border.Background>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_dropdownarrow_normal.png"/>
                                </Border.Background>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>-->
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox" x:Key="ComboBoxStyle">
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="24"></Setter>
                            <Setter Property="MinWidth" Value="60"></Setter>
                            <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"></Setter>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Back" Background="{StaticResource ColorBrush.Gray15}"  BorderThickness="0,0,0,0" Padding="2, 0, 0, 0">
                                            <ContentPresenter ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                                <Setter TargetName="Back" Property="BorderThickness" Value="1"></Setter>
                                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid Background="#3C3C3C">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBox  Grid.Column="0" BorderThickness="1, 1, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray15}" Background="{StaticResource ColorBrush.Black7}"
                                  Text="{TemplateBinding Text}" Foreground="{StaticResource ColorBrush.While}" FontSize="12" Padding="2, 1, 0, 0">
                                </TextBox>
                                <Border  Grid.Column="0" BorderThickness="0" BorderBrush="#3C3C3C" CornerRadius="1">
                                    <TextBlock ></TextBlock>
                                </Border>
                                <Border Grid.Column="1" BorderThickness="0, 1, 1, 1" BorderBrush="{StaticResource ColorBrush.Gray15}" CornerRadius="1" Background="{StaticResource ColorBrush.Black7}">
                                    <ToggleButton Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"></ToggleButton>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource ColorBrush.Black7}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


        </ResourceDictionary>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Text="类型:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12"></TextBlock>
            <ComboBox Grid.Row="0" Grid.Column="1" Height="24" Margin="4, 0, 0, 0" Style="{DynamicResource ComboBoxStyle}" 
                      SelectionChanged="ComboBox_SelectionChanged" SelectedIndex="{Binding SelectType}">
                <ComboBoxItem Content="最新市价-%" Tag="1"></ComboBoxItem>
                <ComboBoxItem Content="持仓量-kw(千万)" Tag="2"></ComboBoxItem>
            </ComboBox>

        </Grid>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68"></ColumnDefinition>
                <ColumnDefinition Width="94"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding IsCheckStopProfit, Mode=TwoWay}"
                      Style="{StaticResource SelfCheckBoxStyle}"  BorderBrush="{StaticResource ColorBrush.Gray15}"
                      Height="18" Width="52" Content="止盈：" Foreground="{StaticResource ColorBrush.PaleGrey}" FontSize="12"></CheckBox>
            
            <Border Height="28" Width="90" Grid.Column="1" CornerRadius="1" BorderThickness="1" Margin="4, 0, 0, 0" BorderBrush="{StaticResource ColorBrush.Gray19}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="24"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Tag="3" HorizontalAlignment="Left" Style="{StaticResource DefaultTextBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" 
                             PreviewTextInput="TextBox_PreviewTextInput" Width="66"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                         IsEnabled="{Binding FirmGridEnable}" Text="{Binding StopProfitTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Black9}">
                        <!--<TextBox.ToolTip>
                            <ToolTip Content="输入范围:1-120分钟"></ToolTip>
                        </TextBox.ToolTip>-->
                    </TextBox>
                    <Button Width="24" Grid.Row="1" Grid.Column="1" Height="12" Padding="0, -2, 0, 0" Margin="0, 0, 0, 1" Background="{StaticResource ColorBrush.Gray15}" 
                            Foreground="{StaticResource ColorBrush.While}" Content="-" Command="{Binding DownStopProfitCommand}" Style="{StaticResource AddButton}"/>
                    <Button Width="24"  Grid.Row="0" Grid.Column="1" Height="12" Padding="0, -2, 0, 0" Margin="0, 0, 0, 0" Background="{StaticResource ColorBrush.Gray15}" 
                            Foreground="{StaticResource ColorBrush.While}" Content="+" Command="{Binding AddStopProfitCommand}" Style="{StaticResource AddButton}"/>
                </Grid>


            </Border>

            <TextBlock Text="类型:" Grid.Row="0" Grid.Column="2" Margin="4, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12"></TextBlock>
        </Grid>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68"></ColumnDefinition>
                <ColumnDefinition Width="94"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding IsCheckStopLoss, Mode=TwoWay}"
                      Style="{StaticResource SelfCheckBoxStyle}"  BorderBrush="{StaticResource ColorBrush.Gray15}"
                      Height="18" Width="52" Content="止损：" Foreground="{StaticResource ColorBrush.PaleGrey}" FontSize="12"></CheckBox>
            <Border Height="28" Width="90" Grid.Column="1" CornerRadius="1" BorderThickness="1" Margin="4, 0, 0, 0" BorderBrush="{StaticResource ColorBrush.Gray19}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="24"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Tag="3" HorizontalAlignment="Left" Style="{StaticResource DefaultTextBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" 
                             PreviewTextInput="TextBox_PreviewTextInput" Width="66"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                         IsEnabled="{Binding FirmGridEnable}" Text="{Binding StopLossTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Black9}">
                        <!--<TextBox.ToolTip>
                            <ToolTip Content="输入范围:1-120分钟"></ToolTip>
                        </TextBox.ToolTip>-->
                    </TextBox>
                    <Button Width="24" Grid.Row="1" Grid.Column="1" Height="12"  Padding="0, -2, 0, 0" Margin="0, 0, 0, 1" Background="{StaticResource ColorBrush.Gray15}" 
                            Foreground="{StaticResource ColorBrush.While}" Content="-" Command="{Binding DownStopLossCommand}" Style="{StaticResource AddButton}"/>
                    <Button Width="24"  Grid.Row="0" Grid.Column="1" Height="12" Margin="0, 0, 0, 0" Background="{StaticResource ColorBrush.Gray15}" 
                            Foreground="{StaticResource ColorBrush.While}" Content="+" Command="{Binding AddStopLossCommand}" Padding="0, -2, 0, 0" Style="{StaticResource AddButton}"/>
                </Grid>


            </Border>

            <TextBlock Text="类型:" Grid.Row="0" Grid.Column="2" Margin="4, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       TextAlignment="Center" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12"></TextBlock>
        </Grid>


    </Grid>
</UserControl>
