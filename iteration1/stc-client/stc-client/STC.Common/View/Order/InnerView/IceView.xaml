<UserControl x:Class="STC.Common.View.Order.InnerView.IceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.Common.View.Order.InnerView"
             mc:Ignorable="d" 
             d:DesignHeight="36" d:DesignWidth="394">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/View/Order/SendPriceDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>


    <Grid>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="总量:" TextAlignment="Center" Padding="0, 14, 0, 0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12"/>

            <Border Height="28" Width="90" CornerRadius="1" BorderThickness="1" Margin="4, 0, 0, 0" BorderBrush="{StaticResource ColorBrush.Gray19}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="24"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Tag="3" HorizontalAlignment="Left" Style="{StaticResource DefaultTextBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" 
                             PreviewTextInput="TextBox_PreviewTextInput" Width="66"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                         IsEnabled="{Binding FirmGridEnable}" Text="{Binding TotalTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Black9}">
                        <TextBox.ToolTip>
                            <ToolTip Content="输入范围:1-120分钟"></ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <Button Width="24" Grid.Row="1" Grid.Column="1" Height="12" Margin="0, 0, 0, 1" Background="{StaticResource ColorBrush.Gray15}" Padding="0, -2, 0, 0"
                            Foreground="{StaticResource ColorBrush.While}" Content="-" Command="{Binding DownTotalCommand}" Style="{StaticResource AddButton}"/>
                    <Button Width="24"  Grid.Row="0" Grid.Column="1" Height="12" Margin="0, 0, 0, 0" Background="{StaticResource ColorBrush.Gray15}" Padding="0, -2, 0, 0"
                            Foreground="{StaticResource ColorBrush.While}" Content="+" Command="{Binding AddTotalCommand}" Style="{StaticResource AddButton}"/>
                </Grid>


            </Border>

            <TextBlock Text="kw" TextAlignment="Center" Margin="4, 0, 0, 0" Padding="0, 14, 0, 0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12"/>
            <TextBlock Text="单笔量:" TextAlignment="Center" Margin="8, 0, 0, 0" Padding="0, 14, 0, 0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12"/>


            <Border Height="28" Width="90" CornerRadius="1" BorderThickness="1" Margin="4, 0, 0, 0" BorderBrush="{StaticResource ColorBrush.Gray19}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="24"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Tag="3" HorizontalAlignment="Left" Style="{StaticResource DefaultTextBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" 
                             PreviewTextInput="TextBox_PreviewTextInput" Width="66"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                         IsEnabled="{Binding FirmGridEnable}" Text="{Binding OneTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Black9}">
                        <TextBox.ToolTip>
                            <ToolTip Content="输入范围:1-120分钟"></ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <Button Width="24" Grid.Row="1" Grid.Column="1" Height="12" Margin="0, 0, 0, 1" Background="{StaticResource ColorBrush.Gray15}" Padding="0, -2, 0, 0" 
                            Foreground="{StaticResource ColorBrush.While}" Content="-" Command="{Binding DownOneCommand}" Style="{StaticResource AddButton}"/>
                    <Button Width="24"  Grid.Row="0" Grid.Column="1" Height="12" Margin="0, 0, 0, 0" Background="{StaticResource ColorBrush.Gray15}" Padding="0, -2, 0, 0" 
                            Foreground="{StaticResource ColorBrush.While}" Content="+" Command="{Binding AddOneCommand}" Style="{StaticResource AddButton}"/>
                </Grid>


            </Border>

            <TextBlock Text="kw" TextAlignment="Center" Margin="4, 0, 0, 0" Padding="0, 14, 0, 0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12"/>
            
        </StackPanel>
        
        
    </Grid>
</UserControl>
