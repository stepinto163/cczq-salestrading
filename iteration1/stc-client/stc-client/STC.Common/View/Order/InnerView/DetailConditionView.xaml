<UserControl x:Class="STC.Common.View.Order.InnerView.DetailConditionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:Component="clr-namespace:STC.Common.View.Component"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.Common.View.Order.InnerView"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="394">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/View/Order/SendPriceDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ComboBoxStyleDictionary.xaml"/>-->
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CustomTabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontFamily" Value="MicrosoftYaHei"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid>
                                <Border x:Name="Border"  Margin="0, 0, 0, 0" Background="Transparent"  CornerRadius="2,2,2,2" BorderThickness="0" >
                                    <Grid>
                                        <TextBlock x:Name="ContentSite" Text="{TemplateBinding Header}" Grid.Column="0" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="CornerRadius" Value="2, 2, 0, 0"/>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,0"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{Binding ItemHeadForeground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource ColorBrush.Gray14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0">
        <Border.Background>
            <ImageBrush ImageSource="{Binding BgImageSource}" Opacity="1"></ImageBrush>
            <!--<ImageBrush ImageSource="/STC.Common;component/Images/stc_sniper_bid.png"></ImageBrush>-->
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TabControl x:Name="SettlTypeListBox" Margin="10, 0, 0, 0" BorderThickness="0" Background="Transparent" Grid.Row="0"                            
                             SelectedIndex="{Binding SettleBoxIndex, Mode=TwoWay}" BorderBrush="Transparent">
                    <TabItem x:Name="lbCancel" Header="撤单条件" Style="{DynamicResource CustomTabItemStyle}" Margin="0,-2,0,4" FontSize="12" />
                    <TabItem x:Name="lbSub" Header="订阅"  Style="{StaticResource CustomTabItemStyle}"  Margin="0,-2,0,4" FontSize="12" Visibility="{Binding LBSubVisibility}"/>
                </TabControl>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding CancelConVisibility}" Margin="10,0,0,0">
                <!--<Grid Grid.Row="1" Visibility="Collapsed">-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>


                <!--有效时长-->
                <Grid Grid.Row="0" Grid.Column="0" Margin="2, 5, 0, 0">
                    <Border BorderThickness="0, 0, 0, 0" BorderBrush="{StaticResource ColorBrush.Black}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16"></RowDefinition>
                                <RowDefinition Height="32"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Grid.Row="0" Text="有效时长:" Height="16" HorizontalAlignment="Left" Foreground="{StaticResource TextBlockDefaultDisableForeground}" FontSize="12" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <StackPanel Orientation="Horizontal"  Grid.Column="0">
                                    <ComboBox x:Name="cbSettle2" Width="60" Height="24" Style="{DynamicResource DailanBlueGreenOrangeComboBoxStyle}" ToolTip="REQ" SelectedIndex="{Binding ValidSelectIndex,Mode=TwoWay}"  ToolTipService.IsEnabled="False" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                                        <ComboBoxItem Content="默认" Tag="1"></ComboBoxItem>
                                        <ComboBoxItem Content="时长" Tag="2"></ComboBoxItem>
                                        <ComboBoxItem Content="时点" Tag="3"></ComboBoxItem>
                                        <ComboBoxItem Content="无   " Tag="4"></ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Grid.Row="0" Margin="10, 0, 0, 0"  Height="16" HorizontalAlignment="Left" Grid.Column="0"  FontSize="12"  Visibility="{Binding DefaultValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                                <Run Text="每日" Foreground="{DynamicResource ColorBrush.Gray14}" />
                                                <Run Text="6:00、12:00、16:30" Foreground="#F9C152"/>
                                                <Run Text="自动撤回"  Foreground="{DynamicResource ColorBrush.Gray14}"/>
                                    </TextBlock>
                                    <!--时长-->
                                    <StackPanel Orientation="Horizontal" Height="24" Grid.Column="0"  Margin="6, 0, 0, 0"  Visibility="{Binding HourValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                        <Component:WatermarkTextBox WaterMark="" ContextMenu="{x:Null}" Tag="1" MaxLength="3" x:Name="ValidMinute" PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" Text="{Binding ValidMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputMethod.IsInputMethodEnabled="False" Width="28"  Height="24" Padding="0, 0, 0, 0" Style="{StaticResource GreenBlueWatermarkTextBox}">
                                            <TextBox.ToolTip>
                                                <ToolTip Content="输入范围:[0-500]分钟"></ToolTip>
                                            </TextBox.ToolTip>
                                        </Component:WatermarkTextBox>
                                        <TextBlock Grid.Row="0" Text="分" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                        <Component:WatermarkTextBox  WaterMark="" ContextMenu="{x:Null}"  Margin="6,0,0, 0" Tag="3"  MaxLength="2"  x:Name="ValidSecond"   PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  Padding="0, 0, 0, 0"  Style="{DynamicResource GreenBlueWatermarkTextBox}">
                                            <TextBox.ToolTip>
                                                <ToolTip Content="输入范围:[0-60)"></ToolTip>
                                            </TextBox.ToolTip>
                                        </Component:WatermarkTextBox>
                                        <TextBlock Grid.Row="0" Text="秒"  Height="16"  Margin="6, 0, 0, 0" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="后失效" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                    </StackPanel>
                                    <!--时点-->
                                    <StackPanel Orientation="Horizontal" Height="24"  Grid.Column="0"  Margin="10, 0, 0, 0" Visibility="{Binding TimeValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                        <Component:WatermarkTextBox  WaterMark="时" ContextMenu="{x:Null}" Tag="2" MaxLength="2" x:Name="ValidTimeHour"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False" Width="28" Height="24" Padding="0, 0, 0, 0" Style="{DynamicResource GreenBlueWatermarkTextBox}"> 
                                            <TextBox.ToolTip>
                                                <ToolTip Content="输入范围:(0，24]"></ToolTip>
                                            </TextBox.ToolTip>
                                        </Component:WatermarkTextBox>
                                        <TextBlock Grid.Row="0" Text=":"  Margin="6,0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                        <Component:WatermarkTextBox WaterMark="分" ContextMenu="{x:Null}"  Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="ValidTimeMinute"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"   Padding="0, 0, 0, 0"  Style="{DynamicResource GreenBlueWatermarkTextBox}">
                                            <TextBox.ToolTip>
                                                <ToolTip Content="输入范围:[0-60)"></ToolTip>
                                            </TextBox.ToolTip>
                                        </Component:WatermarkTextBox>
                                        <TextBlock Grid.Row="0" Text=":"   Margin="6, 0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                        <Component:WatermarkTextBox WaterMark="秒" ContextMenu="{x:Null}" Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="ValidTimeSecond"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  Padding="0, 0, 0, 0"  Style="{DynamicResource GreenBlueWatermarkTextBox}">
                                            <TextBox.ToolTip>
                                                <ToolTip Content="输入范围:[0-60)"></ToolTip>
                                            </TextBox.ToolTip>
                                        </Component:WatermarkTextBox>
                                        <TextBlock Grid.Column="1" Text="失效" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>


                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                    <CheckBox x:Name="cbMorethanParty"  IsChecked="{Binding MorethanMarketBPCheck}" Margin="0,10,0,0" FontFamily="{DynamicResource DefaultFont}" 
                      FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Background="Transparent" 
                      Foreground="{DynamicResource ListBoxItem.SelectedActive.Foreground}" Content="与市场最优倒挂" Width="105"></CheckBox>

                    <Border Width="56" Height="24" CornerRadius="2" Margin="4, 0, 0, 0" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray15}"
                        Background="{DynamicResource ColorBrush.Black}" IsEnabled="{Binding MorethanMarketBPCheck}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="34" Height="24" Background="{DynamicResource ColorBrush.Black}"
                                 BorderThickness="0" Padding="0, 4, 0, 0" Foreground="{DynamicResource ColorBrush.While}" Text="{Binding MorethanMarketBP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>

                            <Button Grid.Row="0" Grid.Column="1" Content="∧" Width="16" Height="12" Padding="0, -3, 0, 0" Margin="0, 0, 0, 0"
                                Style="{DynamicResource AddAmountButtonStyle}" Command="{Binding AddCommand}"></Button>
                            <Button Grid.Row="1" Grid.Column="1" Content="∨" Width="16" Height="12" Padding="0, -3, 0, 0" Margin="0, 1, 0, 0"
                                Style="{DynamicResource AddAmountButtonStyle}" Command="{Binding DownCommand}"></Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="bp撤单" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4, 0, 0, 0" Foreground="{DynamicResource ListBoxItem.SelectedActive.Foreground}"></TextBlock>

                    <Button Grid.Column="3" HorizontalAlignment="Left"  Visibility="{Binding ConditionVisibility}" Margin="4,0,0,0"
                                        Style="{DynamicResource InfoButton}" Width="15" Height="15">
                        <Button.ToolTip>
                            <ToolTip Content="对于Bid报价：[市场最优Ofr] - [我的bid] >= Nbp，即撤单&#13;对于Ofr报价：[我的Ofr] - [市场最优Bid] >=Nbp，即撤单 &#13;*&lt;市场最优&gt;的范围包括经纪商行情、双边、XBond，不包含本机构报价。"></ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>


            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding SubConVisibility}"  Margin="10,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="订阅报价:" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource DefaultFont}" 
                       Foreground="{DynamicResource ColorBrush.Gray14}" Margin="0, 6, 0, 0"></TextBlock>
                <CheckBox Content="该券同向" Grid.Row="1" FontWeight="Bold" IsChecked="{Binding CheckSyntropy}" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray-23}" Foreground="{DynamicResource ColorBrush.White-1}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Background="Transparent" Padding="2, -2, 0, 0"></CheckBox>
                <TextBlock Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource DefaultFont}" 
                       Foreground="{DynamicResource ColorBrush.Gray14}" Margin="68, 0, 0, 0">
                <Run Text="(#"></Run>
                <Run Text="{Binding SecurityID}"></Run>
                <Run Text=" "></Run>
                <Run Text="{Binding SyntropyTxt}"></Run>
                <Run Text=")"></Run>
                </TextBlock>


                <CheckBox Content="该券反向" Grid.Row="2" FontWeight="Bold" IsChecked="{Binding CheckReverse}" Foreground="{DynamicResource ColorBrush.White-1}"
                  HorizontalAlignment="Left" VerticalAlignment="Top"  Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Background="Transparent"  BorderBrush="{DynamicResource ColorBrush.Gray-23}"  Padding="2, -2, 0, 0"
                      Margin="0, 0, 0, 0"></CheckBox>
                <TextBlock Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="{DynamicResource DefaultFont}" 
                       Foreground="{DynamicResource ColorBrush.Gray14}" Margin="68, -2, 0, 0" > 
            <Run Text="(#"></Run>
            <Run Text="{Binding SecurityID}"></Run>
            <Run Text=" "></Run>
            <Run Text="{Binding ReverseTxt}"></Run>
            <Run Text=")"></Run>
                </TextBlock>
            </Grid>



        </Grid>
    </Border>
</UserControl>
