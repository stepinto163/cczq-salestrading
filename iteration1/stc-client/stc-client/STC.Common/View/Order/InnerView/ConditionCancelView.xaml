<UserControl x:Class="STC.Common.View.Order.InnerView.ConditionCancelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Order.InnerView"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="395"
             Height="100">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/View/Order/SendPriceDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <Style x:Key="CusTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#400B0C0C"/>
                <!--<Setter Property="BorderBrush" Value="#193D37"/>-->
                <!--<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>-->
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                    <Setter TargetName="border" Property="Background" Value="#515151"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#300F0F0F"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#136C5E"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#A0A0A0"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#300F0F0F"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BdFocusBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="20"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="条件撤销:" Margin="10, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{StaticResource TextBlockDisableForeground}" FontSize="12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="185"></ColumnDefinition>
                <ColumnDefinition Width="60"></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="cbMorethanParty" Grid.Row="0" Grid.Column="0" IsChecked="{Binding MorethanPartyBPCheck}" Margin="10,5,0,0" FontFamily="{StaticResource DefaultFont}" 
                      FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="Transparent" 
                      Foreground="{Binding TxBrush}" Content="{Binding ConditionTxt}" ></CheckBox>

            <TextBox x:Name="tbMorethanParty"  Grid.Column="1" PreviewTextInput="TextBox_PreviewTextInput" Width="55" Height="24"  Margin="2, 2, 0, 0"  input:InputMethod.IsInputMethodEnabled="False"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"  FontSize="12" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray15}"
                                     Text="{Binding MorethanPartyBP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="2" Style="{DynamicResource CusTextBoxStyle}" Foreground="White"  
                                     SelectionBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}" TextAlignment="Right" Padding="0, 0, 20, 0"
                     IsEnabled="{Binding MorethanPartyBPCheck}">
                
            </TextBox>

            <TextBlock Grid.Column="1" x:Name="AmountTxtKw" Text="bp" Foreground="White"  Background="Transparent" Padding="0, 0, 3, 0"
                                            FontSize="10" Margin="38,10,1,0" Width="16"/>

            <TextBlock Text="自动撤回" Grid.Column="2" Margin="10, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{Binding TxBrush}" FontSize="12" />

            <Button Grid.Column="3" HorizontalAlignment="Left"  Visibility="{Binding ConditionVisibility}"
                                        Style="{StaticResource InfoButton}" Width="15" Height="15">
                <Button.ToolTip>
                    <ToolTip Content="价差定义：&#13;Bid方向：对手方最优报价 - 本方报价 &#13;Ofr方向：本方报价 - 对手方最优报价"></ToolTip>
                </Button.ToolTip>
            </Button>

        </Grid>

        <Grid Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="136"></ColumnDefinition>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="60"></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="cbMorethanMarket"  Grid.Row="0" Grid.Column="0" IsChecked="{Binding MorethanMarketBPCheck}" Margin="10,5,0,0" FontFamily="{StaticResource DefaultFont}" 
                      FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="Transparent" 
                      Foreground="{Binding TxBrush}" Content="市场最新成交价-本方报价 >" Grid.ColumnSpan="3" ></CheckBox>

            <TextBox x:Name="tbMorethanMarket"  Grid.Column="3" PreviewTextInput="TextBox_PreviewTextInput" Width="55" Height="24"  Margin="3,2,1,-1"  input:InputMethod.IsInputMethodEnabled="False"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"  FontSize="12" BorderThickness="2" BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}" 
                                     Text="{Binding MorethanMarketBP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="2" Style="{DynamicResource SelfSendPriceTextBox}" Foreground="White"  
                                     SelectionBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}" TextAlignment="Right" Padding="0, 0, 5, 0"
                     IsEnabled="{Binding MorethanMarketBPCheck}"/>

            <TextBlock Text="自动撤回:" Grid.Column="4" Margin="10,4,0,5" Height="16" HorizontalAlignment="Left" Foreground="{StaticResource TextBlockDisableForeground}" FontSize="12" />


        </Grid>

        <CheckBox x:Name="cbUpside" Grid.Row="3" Grid.Column="0" IsChecked="{Binding UpsideCheck}" Margin="10,5,0,0" FontFamily="{StaticResource DefaultFont}" 
                      FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="Transparent" 
                      Foreground="{Binding TxBrush}" Content="倒挂即撤单"></CheckBox>

        <TextBlock Grid.Row="4" Text="*如选择多个条件，则任意一个满足，系统将自动发出撤单请求" Margin="30, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{StaticResource TextBlockDisableForeground}" FontSize="12" />


    </Grid>
</UserControl>
