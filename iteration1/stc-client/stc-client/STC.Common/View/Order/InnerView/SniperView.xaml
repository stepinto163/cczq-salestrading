<UserControl x:Class="STC.Common.View.Order.InnerView.SniperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Order.InnerView"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="394" Background="Transparent" Height="64">
    
    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/View/Order/SendPriceDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <!--撮合范围-->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!--Button  Expand-->
            <TextBlock Grid.Column="0" Height="24" Text="撮合范围:" Visibility="{Binding VenueVisible}"  Margin="10, 8, 0, 0"  VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextBlockDefaultDisableForeground}" FontSize="12" />
            <TextBlock Grid.Column="0" Height="24" Text="撮合范围:" Margin="10, 8, 0, 0"  VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextBlockDefaultDisableForeground}" FontSize="12" />
            <StackPanel Orientation="Horizontal" Grid.Column="1" Height="32">

                <CheckBox x:Name="ckAll" Visibility="{Binding CheckAllVisibility, Mode=TwoWay}" IsChecked="{Binding CheckAll, Mode=TwoWay}" Margin="0, 0, 0, 0" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}"  
                          IsEnabled="{Binding CheckAllEnable}" Width="45" Height="14"  Grid.Column="1" Content="所有"  Foreground="{DynamicResource TextBlockDefaultForground}" FontSize="12"></CheckBox>

                
                
                <!--<CheckBox x:Name="ckInst" Visibility="{Binding CheckInnerVisibility}" IsEnabled="{Binding CheckInnerEnable}" IsChecked="{Binding CheckInner, Mode=TwoWay}" Margin="4, 0, 0, 0" 
                          Style="{StaticResource SelfCheckBoxStyle}"  BorderBrush="{StaticResource ColorBrush.Gray15}" Height="18" Width="70" Grid.Column="2" Content="仅本机构"
                          Foreground="{StaticResource TextBlockForeground}" FontSize="12" Click="CheckBox_Click"></CheckBox>

                <CheckBox x:Name="ckXbond" Visibility="{Binding CheckXBondVisibility}" IsEnabled="{Binding CheckXBondEnable}"  IsChecked="{Binding CheckXBond, Mode=TwoWay}" VerticalAlignment="Center"
                          Margin="4, 0, 0, 0" Grid.Column="3" BorderThickness="2"  Click="CheckBox_Click"
                              Height="18"  Content="X-bond" FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource SelfCheckBoxStyle}"
                              Foreground="{StaticResource TextBlockForeground}" BorderBrush="{StaticResource ColorBrush.Gray15}"></CheckBox>-->
            </StackPanel>
        </Grid>
        <!--余量发送渠道-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
             <!--余量发送渠道--> 
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="余量发送渠道:" Margin="10, 0, 0, 0"  HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="{DynamicResource TextBlockDefaultDisableForeground }" FontSize="12" />
                <CheckBox x:Name="ckInner" Margin="10, 0, 0, 0"  Content="仅内部" IsChecked="{Binding CheckNotOut, Mode=TwoWay}" IsEnabled="{Binding CheckNotoutEnable,Mode=TwoWay}"
                          Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Height="14" Foreground="{DynamicResource TextBlockDefaultForground}" BorderBrush="{DynamicResource ColorBrush.Gray15}"
                          Background="{DynamicResource ColorBrush.Transparent}"></CheckBox>


            </StackPanel>

            <TextBlock Text="*Ctrl 可复选"  Margin="0, 4, 12, 0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="{DynamicResource TextBlockDefaultDisableForeground }" 
                           FontSize="12" />

        </Grid>
    </Grid>
</UserControl>
