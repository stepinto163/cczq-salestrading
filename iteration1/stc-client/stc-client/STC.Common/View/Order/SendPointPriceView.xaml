                                <TextBlock Text="{Binding SendPriceItem.BestOfrShortOuter}" Foreground="{Binding AllBestOfrForground}"  FontSize="12" x:Name="tbBestOfr" MouseLeftButtonDown="tbBestOfr_MouseLeftButtonDown" TextAlignment="Left" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" MouseEnter="tbBestOfr_MouseEnter" MouseLeave="tbBestOfr_MouseLeave"/>
                            </StackPanel>

                            <Button  IsEnabled="False" HorizontalAlignment="Center"  Visibility="{Binding SendPriceItem.CalWarnVisibility}"
                                        Style="{StaticResource InfoButton}" Width="15" Height="15">
                                <Button.ToolTip>
                                    <ToolTip Content="调用计算器服务失败"></ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" Grid.Row="1" Grid.ColumnSpan="2" Margin="12, 0, 0, 0">
                            <Border BorderBrush="{DynamicResource ColorBrush.Gray15}" BorderThickness="1" CornerRadius="2">
                                <Grid  x:Name="bor_AddOrReduce" Width="128">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"></RowDefinition>
                                        <RowDefinition Height="20"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="24"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>


                                    <TextBox x:Name="PriceTxt" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" PreviewTextInput="TextBox_PreviewTextInput"  Width="104" Height="40" input:InputMethod.IsInputMethodEnabled="False"
                                                PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"  Tag="{Binding OfrOrBid, Mode=TwoWay}" Padding="0, 5, 5, 0" IsReadOnly="{Binding IsReadOnlyPrice,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                FontSize="24" BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}" Text="{Binding CustomPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Style="{DynamicResource SelfSendPriceTextBox}" Foreground="White" HorizontalContentAlignment="Center">
                                    </TextBox>

                                    <Button x:Name="btnAddPrice" Padding="0,0,0,0" Grid.Column="1" Margin="1,1,0,1" Grid.Row="0" TabIndex="-1" Width="24" Height="20" Content="+" Command="{Binding AddPriceCommand}" Style="{DynamicResource AddAmountButtonStyle}" IsEnabled="{Binding IsReadOnlyPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource reversebooleanConvertor}}" FontSize="12"/>
                                    <Button x:Name="btnReducePrice" Padding="0,0,0,0" Grid.Column="1"  Margin="1,1,0,0"  Grid.Row="1" TabIndex="-1" Width="24" Height="20" Content="-" Command="{Binding ReducePriceCommand}" Style="{DynamicResource DecreaseAmountButtonStyle}" IsEnabled="{Binding IsReadOnlyPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource reversebooleanConvertor}}" FontSize="12"/>
                                </Grid>
                            </Border>

                            <Border Width="20" Visibility="{Binding IsShowIRS}">
                                <TextBlock Grid.Row="1" Foreground="{DynamicResource ColorBrush.While}"  Width="15" Height="14" TextAlignment="Center" HorizontalAlignment="Center"
                                               Margin="0, 0, 0, 0">
                                    <TextBlock.Background>
                                        <ImageBrush ImageSource="../../Images/stc_icon_linked_normal.png"/>
                                    </TextBlock.Background>
                                </TextBlock>
                            </Border>

                        </StackPanel>

                        <TextBlock x:Name="PriceTxtPercent" Grid.Row="1" Text="%"  Foreground="{DynamicResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="60, 24, 0, 0" Width="14" Height="20"/>
                        <!--<Component:AlertSign Grid.Row="1" Visibility="{Binding AlertSignVisible,Mode=TwoWay}" Height="24" Margin="20,0,0,0" HorizontalAlignment="Left" ToolTipText="{Binding AlertSignToolTipText,Mode=TwoWay}"/>-->
                    </Grid>

                    <!--XBound 净价-->
                    <Grid Visibility="{Binding IsShowIRS}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource ColorBrush.Gray15}" BorderThickness="1"
                                    CornerRadius="2">
                            <TextBox  Grid.Row="1"  x:Name="netPrice"  Grid.Column="1" PreviewTextInput="TextBox_PreviewTextInput" Width="114" Height="41" input:InputMethod.IsInputMethodEnabled="False"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"  FontSize="24" BorderThickness="2" BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}" 
                                     Text="{Binding NetPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding OfrOrBid, Mode=TwoWay}"  IsReadOnly="{Binding IsReadOnlyPrice,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource SelfSendPriceTextBox}" Foreground="White"  
                                     TextAlignment="Right" Padding="0, 4, 5, 0"/>
                        </Border>
                    </Grid>

                    <!--量-->

                    <Inner:QtyView x:Name="qtyView" Margin="10,0,0,0"></Inner:QtyView>
                </StackPanel>

                <Grid Grid.Row="5">
                    <TextBlock Visibility="{Binding AlertSignVisible}" Margin="12, 2, 0, 0" Foreground="{Binding AlertSignForground}" FontSize="{DynamicResource FontSize-12}">
                            <Run Text="{Binding AlertSignToolTipText}"></Run>
                    </TextBlock>
                </Grid>

                <!--清算速度 标题-->
                <Grid Grid.Row="6" Visibility="{Binding IsShowIRS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="清算速度：" Margin="12, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="#788187" FontSize="12" />
                </Grid>
                <!--GVN TKN和定向报价具体控制界面-->
                <StackPanel Grid.Column="0" Margin="0,0,0,0" Grid.Row="7" Grid.RowSpan="5" >
                    <TabControl BorderBrush="Transparent" x:Name="Tab_DgPrice" BorderThickness="0" Style="{DynamicResource TabControlStyle}"  Margin="0" SelectedIndex="{Binding ListPointTypeIndex, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}">
                        <TabItem Header="Normal" BorderThickness="1" BorderBrush="Transparent" Style="{DynamicResource TabItemStyle}" Height="0">
                            <Grid ShowGridLines="False" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!--清算速度-->
                                <Grid Grid.Row="0" >
                                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsShowIRS}">
                                        <!--普通包教清算速度-->
                                        <ComboBox x:Name="SettlTypeCombox"  Width="60" Tag="{Binding NormalAddOneOpenedTag}" ToolTip="{Binding TitleBidOrOfr}" ToolTipService.IsEnabled="False" Text="{Binding AddOneShowText}"  Margin="12, 0, 2, 2"  Height="24"
                                            Style="{DynamicResource DailanBlueGreenOrangeComboBoxStyle}" SelectedIndex="{Binding NormalSettleBoxIndex,Mode=TwoWay}" FontWeight="Normal" HorizontalContentAlignment="Right" Padding="0 0 0 0" IsDropDownOpen="{Binding SettleIsDropDownOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="+1" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                                            <ComboBoxItem Content="今+1" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                                            <ComboBoxItem Content="明+0" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                                        </ComboBox>

                                        <ListBox x:Name="LstSettleBox" FontSize="12"  SelectedIndex="{Binding NormalSpotIndex, Mode=TwoWay}"  ToolTipService.IsEnabled="False"
                                         SelectionMode="Single">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="{x:Type ListBox}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                                        <WrapPanel Orientation="Horizontal" IsItemsHost="True">
                                                        </WrapPanel>
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                        </ListBox>


                                    </WrapPanel>
                                </Grid>

                                <!--愿意等待-->
                                <Border  Grid.Row="2"  BorderThickness="0, 0, 0, 0" BorderBrush="{DynamicResource LostFocusBorderBrush}">
                                    <Grid Margin="0,1,0,-1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"></RowDefinition>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48*"></ColumnDefinition>
                                            <ColumnDefinition Width="65*"></ColumnDefinition>
                                            <ColumnDefinition Width="120"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="3"  Margin="12,0,0,0">
                                            <CheckBox x:Name="chk_nonfirm" IsChecked="{Binding LockTimeOutCheck, Mode=TwoWay}" Margin="0, 0, 0, 0" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  VerticalAlignment="Center" BorderThickness="2" 
                              Height="14"  IsEnabled="{Binding IsFirmEnable,Mode=TwoWay}" 
                              FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Padding="4,0,0,0" FontFamily="MicroSosft.YaHei" Background="{DynamicResource ColorBrush.Transparent}"
                              Foreground="#FFFFFF" Content="愿意匹配Nonfirm并等待">

                                            </CheckBox>
                                            <!--NumericValue="{Binding IocOutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" -->
                                            <component:NumericUpDown  NumericValue="{Binding IocOutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  PreviewKeyDown="NumericUpDown_PreviewKeyDown"  ContextMenu="{x:Null}" 
                                                      TextContentAlignment="Center" DecimalLength="0" Width="50" Height="24" FontSize="12" RangeValue="1"  MaxValue="300" MinValue="1"  ToolTip="输入范围:1-300秒" UpDownBorderThickness="1" Foreground="{DynamicResource TextBlockDefaultForground}"  NumBorderBrush="#3C3C3C" UpDownBackground="#282828" UpDownBorderBrush="#282828" UpMargin="0,1,1,0"  DownMargin="0,1,1,1"
                                                      Margin="4,0,0,0"></component:NumericUpDown>

                                            <TextBlock Text="秒" Grid.Column="2" TextAlignment="Center" VerticalAlignment="Center" Margin="5, 0, 0, 0"  
                                    Foreground="{DynamicResource TextBlockDefaultDisableForeground}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!--投组账户-->
                                <Border  Grid.Row="3"  BorderThickness="0, 0, 0, 0" BorderBrush="{DynamicResource LostFocusBorderBrush}" Height="34" Visibility="{Binding AccountUserVisibility}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="投组账户" Foreground="{DynamicResource TextBlockDefaultDisableForeground}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <component:MultiTreeComboBox x:Name="bookBox" Grid.Column="1" Width="120" Height="24"  Margin="6 0 0 0"  
                                        VerticalAlignment="Center" TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" Foreground="White"
                                        TreeItemsSource="{Binding MultiTreeComboxItemsSource}" IsEnableMultiSelect="False"  SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedTexts="{Binding SelectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <component:MultiTreeComboBox.TreeItemItemTemplate>
                                                <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                                    <StackPanel Orientation="Horizontal" Height="24">
                                                        <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}" Visibility="{Binding IsLeaf, Converter={StaticResource visibilityConvertor}}"/>
                                                        <Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>
                                                        <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Checked}" Value="1">
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                                    </StackPanel>
                                                </HierarchicalDataTemplate>
                                            </component:MultiTreeComboBox.TreeItemItemTemplate>
                                        </component:MultiTreeComboBox>
                                        <!--<ComboBox x:Name="AccountUserCbc" ItemsSource="{Binding AccountUserSource}" Style="{DynamicResource DailanBlueGreenOrangeComboBoxStyle}" ToolTip="REQ"  ToolTipService.IsEnabled="False" Padding="0 0 0 0" Tag="0"
                                          SelectedItem="{Binding AccountUserItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DropDownOpened="AccountUserCbc_DropDownOpened"
                                          Width="160" Height="24" Margin="10,0,0,0" VerticalContentAlignment="Center"
                                          DockPanel.Dock="Left" HorizontalAlignment="Left"
                                      SourceUpdated="AccountUserCbc_SourceUpdated">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel/>
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Id}" />
                                                        <TextBlock x:Name="midTB" Text="-" />
                                                        <TextBlock Text="{Binding AccountName}" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Id, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                                            <Setter TargetName="midTB" Property="Text" Value=""/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>-->
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="定向" BorderThickness="1" BorderBrush="Transparent" Style="{DynamicResource TabItemStyle}" Height="0">
                            <Grid ShowGridLines="False" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <!--清算速度-->
                                <Grid Grid.Row="0">
                                    <WrapPanel Orientation="Horizontal" Visibility="{Binding IsShowIRS}">
                                        <!--定向清算速度-->
                                        <ComboBox x:Name="DrpSettlTypeCombox"  Width="60" Tag="{Binding DrpAddOneOpenedTag}" Text="{Binding AddOneShowText}" Margin="12, 0, 0, 2"  Height="24" ToolTip="DRP"  ToolTipService.IsEnabled="False"
                                            Style="{DynamicResource DailanBlueGreenOrangeComboBoxStyle}" SelectedIndex="{Binding DrpSettleBoxIndex,Mode=TwoWay}" FontWeight="Normal" HorizontalContentAlignment="Right" Padding="0 0 0 0" IsDropDownOpen="{Binding SettleIsDropDownOpen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="+1" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                                            <ComboBoxItem Content="今+1" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                                            <ComboBoxItem Content="明+0" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                                        </ComboBox>

                                        <ListBox x:Name="LstSettleBox2" Grid.Column="0" SelectionMode="Single" Margin="-1, -2, 0, 0"   ToolTipService.IsEnabled="False"
                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                                             Height="26" 
                                             Background="Transparent" MinWidth="126"
                                             BorderThickness="0"
                                             FontSize="12" SelectedIndex="{Binding DrpSpotIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             VerticalAlignment="Center" HorizontalAlignment="Left" 
                                             BorderBrush="Transparent">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <!--<ListBoxItem x:Name="lbOne" Width="60" Visibility="{Binding LbOneVisibility, Mode=TwoWay}" Height="24" Content="+1"  Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>-->
                                            <ListBoxItem x:Name="lbTomOne2" Width="60" Height="24"  Content="+0" Style="{DynamicResource DailanGreenOrangeListBoxItemStyle}" ToolTip="DRP" ToolTipService.IsEnabled="False"/>
                                            <ListBoxItem x:Name="lbOther2" Width="60"  Height="24" Content="远" Style="{DynamicResource DailanGreenOrangeListBoxItemStyle}" ToolTip="DRP" ToolTipService.IsEnabled="False"/>
                                        </ListBox>

                                        <DatePicker x:Name="datePicker" Grid.Column="1" Width="90" Height="24" Margin="2, -2, 0, 0"
                                         SelectedDate="{Binding FwdSelectDate,Mode=TwoWay}" Visibility="{Binding SendPriceItem.DateVisible}"  Style="{DynamicResource GreenBlueDatePickerStyle}" Foreground="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Foreground}"
                                                    Background="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Background}" BorderBrush="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Border}">
                                            <DatePicker.Resources>
                                                <Style TargetType="DatePickerTextBox">
                                                    <Setter Property="IsReadOnly" Value="True"/>
                                                </Style>
                                            </DatePicker.Resources>
                                        </DatePicker>

                                        <ComboBox x:Name="cbSettle" Grid.Column="2" Width="48"  Margin="4,-2,0,0"  Height="24" SelectedIndex="{Binding FwdComboBoxSelectIndex,Mode=TwoWay}"  ToolTipService.IsEnabled="False"
                                  Visibility="{Binding SendPriceItem.SettleTypeVisible}"  Style="{DynamicResource DailanBlueGreenOrangeComboBoxStyle}"  HorizontalContentAlignment="Right" Padding="0 0,0,0" Tag="0">
                                            <ComboBoxItem Content="T+0" Tag="1"></ComboBoxItem>
                                            <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>
                                        </ComboBox>
                                    </WrapPanel>


                                </Grid>


                                <!--失效时间和整量选择-->
                                <Border  Grid.Row="2"  BorderThickness="0, 0, 0, 0" BorderBrush="{DynamicResource Main.BorderBrush}">
                                    <Grid Margin="0,0,0,-1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12"></ColumnDefinition>
                                            <ColumnDefinition Width="65*"></ColumnDefinition>
                                            <ColumnDefinition Width="120"></ColumnDefinition>
                                            <ColumnDefinition Width="16"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <!--时长-->
                                        <StackPanel Orientation="Horizontal" Height="24" Grid.Column="1">
                                            <component:WatermarkTextBox WaterMark="" ContextMenu="{x:Null}" Tag="1" MaxLength="3" x:Name="ValidMinute" PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" Text="{Binding ValidMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputMethod.IsInputMethodEnabled="False" Width="32"  Height="24" Background="#0F0F0F"  Padding="0, 0, 0, 0" Style="{DynamicResource GreenBlueWatermarkTextBox}">
                                                <TextBox.ToolTip>
                                                    <ToolTip Content="输入范围:[0-500]分钟"></ToolTip>
                                                </TextBox.ToolTip>
                                            </component:WatermarkTextBox>
                                            <TextBlock Grid.Row="0" Text="分" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                            <component:WatermarkTextBox  WaterMark="" ContextMenu="{x:Null}"  Margin="6,0,0, 0" Tag="3"  MaxLength="2"  x:Name="ValidSecond"   PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="32" Height="24" Background="#0F0F0F" Padding="0, 0, 0, 0"  Style="{DynamicResource GreenBlueWatermarkTextBox}">
                                                <TextBox.ToolTip>
                                                    <ToolTip Content="输入范围:[0-60)"></ToolTip>
                                                </TextBox.ToolTip>
                                            </component:WatermarkTextBox>
                                            <TextBlock Grid.Row="0" Text="秒"  Height="16"  Margin="6, 0, 0, 0" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="后失效" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                                        </StackPanel>

                                        <CheckBox VerticalAlignment="Center" Content="整量"  Grid.Column="2" HorizontalAlignment="Right"  Visibility="{Binding IsShowIRS}" BorderThickness="2" Height="14"
                                            IsChecked="{Binding WholeFlagChecked, Mode=TwoWay}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Foreground="{DynamicResource ColorBrush.Gray14}"
                                            BorderBrush="{DynamicResource ColorBrush.Gray15}" ></CheckBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </StackPanel>


            </Grid>
        </Border>

        <!--分割线-->
        <Border Grid.Row="3" BorderThickness="2, 0, 2, 0" CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ColorBrush.Gray13}">
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Main.BorderBrush}"></Border>
        </Border>
        <!--提交-->
        <Border Grid.Row="4" BorderThickness="2, 0, 2, 2"  CornerRadius="0,0,4,4" BorderBrush="{Binding BorderBrush}" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="64"></ColumnDefinition>
                    <ColumnDefinition Width="102"></ColumnDefinition>
                    <ColumnDefinition Width="10"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Margin="12,0,0,0">
                    <TextBlock Text="*请详细确认以上信息" HorizontalAlignment="Left" Foreground="#D7D7D7" FontSize="12px" FontFamily="Microsoft YaHei" VerticalAlignment="Center" Width="114"/>
                    <TextBlock HorizontalAlignment="Left" Foreground="#D7D7D7" FontSize="12px" FontFamily="Microsoft YaHei" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="{Binding DrpWarningVisibility,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <Run Text="{Binding PendingCancelTime}" Foreground="#00CDAD"></Run>
                            <Run Text="s 内不可撤"></Run>
                    </TextBlock>
                </StackPanel>


                <Button Grid.Row="0" Grid.Column="1"  Margin="0,0,2,0" Content="取消" Command="{Binding CancelCommand}" FontSize="12"
                        Style="{DynamicResource GraySlateButtonStyle}" Width="60" Height="24" HorizontalAlignment="Right" Foreground="#D7D7D7" BorderThickness="0 1 0 0"/>
                <Button Grid.Row="0" Grid.Column="2" Margin="2,0,0,0" Content="{Binding ConfirmButtonContent}"  Command="{Binding OkCommand}" FontSize="12" Tag="{Binding ConfirmButtonTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource BlueGreenOrangeGraySlateButtonStyle}" Width="100" Height="24" Foreground="#D7D7D7" BorderThickness="0 1 0 0"/>

            </Grid>
        </Border>
    </Grid>
</Window>
