<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Component="clr-namespace:STC.Common.View.Component"
        xmlns:local="clr-namespace:STC.Common.View"
        xmlns:orderViewModel="clr-namespace:STC.Common.ViewModel.Order" 
        xmlns:card="clr-namespace:STC.Common.View.Card"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
        xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
        x:Class="STC.Common.View.SendPriceFutureViewLite"
        mc:Ignorable="d"
        Title="发布需求" Height="540" Width="495"  WindowStartupLocation="CenterScreen" ResizeMode="NoResize" AllowsTransparency ="True"
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown"  Topmost="False"  BorderThickness="0" Background="Transparent"  BorderBrush="#0C4F44"  KeyDown="Window_KeyDown" Unloaded="Window_Unloaded"
        Activated="Window_Activated" Deactivated="Window_Deactivated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TextBlockForeColor" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"/>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
            <!--文本框-->
            <SolidColorBrush x:Key="TextBox.Static.Border" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Static.Background" Color="#172422"/>
            <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Foreground" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF9300"/>
            <SolidColorBrush x:Key="TextBox.Focus.Background" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="TextBox.Focus.Foreground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextBox.Disable.Border" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Disable.Background" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="TextBox.Disable.Foreground" Color="#3C3C3C"/>

            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"/>
            <SolidColorBrush x:Key="PriceDefaultComboBorder" Color="#136C5E"/>
            <SolidColorBrush x:Key="PriceDefaultComboBackground" Color="#193D37"/>

            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Border" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Border" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Foreground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Border" Color="#238F7E"/>
            <SolidColorBrush x:Key="ListBoxItem.Normal.Border" Color="#193D37"/>

            <SolidColorBrush x:Key="MainFormBackground" Color="#0A0F0E"/>
            <SolidColorBrush x:Key="LostFocusBorderBrush" Color="#282828"/>
            <SolidColorBrush x:Key="GetFocusBorderBrush" Color="#8F9598"/>

            <Style x:Key="SelfCommonFilterListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!--<Setter Property="Padding" Value="0"/>-->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="IsSelected" Value="{Binding Checked}"/>
                <Setter Property="Visibility" Value="{Binding ItemVisibility}"/>
                <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
                <!--<Setter Property="Padding" Value="10,0,10,0"/>-->
                <Setter Property="Width" Value="55"/>
                <Setter Property="Margin" Value="1, 0, 0, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="#172422" CornerRadius="2" BorderThickness="0, 1, 0, 0" VerticalAlignment="Center" Margin="0,0,0,0" 
                            BorderBrush="{StaticResource ListBoxItem.Normal.Border}" IsEnabled="{TemplateBinding IsEnabled}"  Padding="{TemplateBinding Padding}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="Cp" Content="{TemplateBinding Content}" TextElement.Foreground="{TemplateBinding Foreground}"  TextElement.FontSize="{TemplateBinding FontSize}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedActive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedActive.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Border}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource TextBlockForeground}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.FontWeight" Value="Bold"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Cp" Value="#788187"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DepthDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGrid}">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Gray"/>
            </Style>
            <Style x:Key="FifthTickStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Background="{StaticResource DataGridColumnHeaderBackground}">
                                <Grid Width="80" Height="48">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Width="40" x:Name="btnFifth" Margin="0, 0, 0, 0" Content="Fifth" 
                                            Foreground="{StaticResource DataGridColumnHeaderForeground}"
                                            FontWeight="Bold"
                                            ToolTip="点击切换档位报价"
                                            Click="btnFifth_Click"
                                            VerticalAlignment="Center" Grid.Row="0" Grid.Column="0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsFifthDepth,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ListBoxItem.MouseOver.Background}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsFifthDepth,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource ListBoxItem.SelectedActive.Background}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Width="40" x:Name="btnTick" Margin="0, 0, 0, 0" Content="Tick" 
                                            Foreground="{StaticResource DataGridColumnHeaderForeground}"                                                  
                                            FontWeight="Bold"
                                            ToolTip="点击切换全价位"
                                            Click="btnTick_Click"
                                            VerticalAlignment="Center" Grid.Row="0" Grid.Column="1">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsFifthDepth,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ListBoxItem.SelectedActive.Background}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsFifthDepth,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource ListBoxItem.MouseOver.Background}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="btnTen"  HorizontalAlignment="Center" Width="40" 
                                            Click="btnTen_Click"
                                            LostMouseCapture="btnTen_OnLostMouseCapture"
                                            Content="10" 
                                            Background="{StaticResource ListBoxItem.SelectedActive.Background}"
                                            VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                    <Popup x:Name="popupTenMenu" StaysOpen="False" Margin="0" PlacementTarget="{Binding ElementName=btnTen}" AllowsTransparency="True">
                                        <StackPanel Margin="0">
                                            <Button Content="10档盘口" 
                                                    Background="{StaticResource ListBoxItem.SelectedActive.Background}"
                                                    Foreground="{StaticResource DataGridColumnHeaderForeground}"
                                                    FontWeight="Bold"
                                                    Click="btnTen_Click1" Width="40"/>
                                            <Button Content="20档盘口"
                                                    Background="{StaticResource ListBoxItem.SelectedActive.Background}"
                                                    Foreground="{StaticResource DataGridColumnHeaderForeground}"
                                                    FontWeight="Bold"
                                                    Click="btnTen_Click2" Width="40"/>
                                        </StackPanel>
                                    </Popup>
                                    <Button Width="40" x:Name="btnCenter" Margin="0, 0, 0, 0" Content="居中" 
                                            Background="{StaticResource ListBoxItem.SelectedActive.Background}" 
                                            Foreground="{StaticResource DataGridColumnHeaderForeground}"
                                            FontWeight="Bold"
                                            ToolTip="居中显示"
                                            Click="btnCenter_Click"
                                            VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StrategyBuyQtyStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Gray" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Background="{StaticResource DataGridColumnHeaderBackground}">
                                <!--模板绑定-->
                                <Grid Width="Auto" Height="48" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="50*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="策略买" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               x:Name="txtSumStrategyBuyQty" 
                                               Text="{Binding DataContext.StrategyBuyQtySum,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}"                                                
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" 
                                               Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ManualBuyQtyStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Background="{StaticResource DataGridColumnHeaderBackground}">
                                <Grid Width="Auto" Height="48" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="50*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="手工买" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               x:Name="txtSumManualBuyQty" 
                                               Text="{Binding DataContext.ManualBuyQtySum,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}"                                                
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" 
                                               Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BuyQtyStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="Template">
                    <Setter.Value>
