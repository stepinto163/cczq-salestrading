                                                        HeaderStyle="{StaticResource StrategyBuyQtyStyle}"
                                                        CellStyle="{StaticResource StrategyBuyDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtStrategyBuyQty" Text="{Binding StrategyBuyQty}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   MouseLeave="ContentPresenter_MouseLeaveStrategyBuyQty"
                                                   MouseEnter="ContentPresenter_MouseEnterStrategyBuyQty">
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding StrategyBuyQty}" Value="0"></Condition>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter TargetName="txtStrategyBuyQty" Property="Text" Value="      "></Setter>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn CellStyle="{StaticResource ManualBuyDataGridCellStyle}"
                                                    Header="手工买" Width="12*" HeaderStyle="{StaticResource ManualBuyQtyStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtManualBuyQty" Text="{Binding ManualBuyQty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   MouseLeave="ContentPresenter_MouseLeaveManualBuyQty"
                                                   MouseEnter="ContentPresenter_MouseEnterManualBuyQty">
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ManualBuyQty}" Value="0"></Condition>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter TargetName="txtManualBuyQty" Property="Text" Value="      "></Setter>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn CellStyle="{StaticResource BuyQtyDataGridCellStyle}"
                                                    Header="买量" Width="12*" HeaderStyle="{StaticResource BuyQtyStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtBuyQty" Text="{Binding BuyQty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   MouseLeave="ContentPresenter_MouseLeaveBuyQty"
                                                   MouseEnter="ContentPresenter_MouseEnterBuyQty">
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding BuyQty}" Value="0"></Condition>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter TargetName="txtBuyQty" Property="Text" Value="      "></Setter>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn CellStyle="{StaticResource PriceDataGridCellStyle}" 
                                                    Width="25*" 
                                                    HeaderStyle="{StaticResource FifthTickStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtPrice" 
                                                   Text="{Binding Price}" 
                                                   Foreground="{Binding BuySell, Converter={StaticResource colorConverter},ConverterParameter=1}"
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center">
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn CellStyle="{StaticResource SellQtyDataGridCellStyle}"
                                                    Header="卖量" Width="12*" HeaderStyle="{StaticResource SellQtyStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtSellQty" Text="{Binding SellQty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   MouseLeave="ContentPresenter_MouseLeaveSellQty"
                                                   MouseEnter="ContentPresenter_MouseEnterSellQty">
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SellQty}" Value="0"></Condition>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter TargetName="txtSellQty" Property="Text" Value="      "></Setter>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn CellStyle="{StaticResource ManualSellDataGridCellStyle}"
                                                    Header="手工卖" Width="12*" HeaderStyle="{StaticResource ManualSellQtyStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtManualSellQty" Text="{Binding ManualSellQty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   MouseLeave="ContentPresenter_MouseLeaveManualSellQty"
                                                   MouseEnter="ContentPresenter_MouseEnterManualSellQty">
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ManualSellQty}" Value="0"></Condition>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter TargetName="txtManualSellQty" Property="Text" Value="      "></Setter>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn CellStyle="{StaticResource StrategySellDataGridCellStyle}"
                                                    Header="策略卖" Width="12*" MinWidth="40" HeaderStyle="{StaticResource StrategySellQtyStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txtStrategySellQty" Text="{Binding StrategySellQty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   MouseLeave="ContentPresenter_MouseLeaveStrategySellQty"
                                                   MouseEnter="ContentPresenter_MouseEnterStrategySellQty">
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding StrategySellQty}" Value="0"></Condition>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter TargetName="txtStrategySellQty" Property="Text" Value="      "></Setter>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="2" >
                        <Button Width="100" x:Name="btnCancelAll" 
                                Height="24"
                                Margin="20,5,0,10"
                                Content="撤销全部挂单" 
                                Background="{StaticResource ListBoxItem.SelectedActive.Background}" 
                                Foreground="White"
                                ToolTip="点击撤销用户所有当前合约挂单"
                                Click="btnCancelAll_Click"
                                VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"/>
                        <Button Width="100" x:Name="btnCancelStrategy" 
                                Height="24"
                                Margin="10,5,0,10"
                                Content="撤销策略挂单" 
                                Background="{StaticResource ListBoxItem.SelectedActive.Background}" 
                                Foreground="White"
                                ToolTip="点击撤销用户所有当前合约策略挂单"
                                Click="btnCancelStrategy_Click"
                                VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"/>
                        <Button Width="100" x:Name="btnCancelManual" 
                                Height="24"
                                Margin="10,5,0,10"
                                Content="撤销手工挂单" 
                                Background="{StaticResource ListBoxItem.SelectedActive.Background}" 
                                Foreground="White"
                                ToolTip="点击撤销用户所有当前合约手工挂单"
                                Click="btnCancelManual_Click"
                                VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"/>
                        <Button Width="60" x:Name="btnQuit" 
                                Height="20"
                                Margin="10,5,0,10"
                                Content="取消" 
                                Foreground="White"
                                Background="Gray"
                                ToolTip="退出"
                                Click="btnQuit_Click"
                                VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
