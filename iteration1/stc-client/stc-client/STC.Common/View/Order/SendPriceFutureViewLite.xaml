                                    </Grid.ColumnDefinitions>
                                    <Label Content="买量" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               x:Name="txtSumBuyQty" 
                                               Text="{Binding DataContext.BuyQtySum,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}"                                                
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" 
                                               Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StrategySellQtyStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Background="{StaticResource DataGridColumnHeaderBackground}">
                                <!--模板绑定-->
                                <Grid Width="Auto" Height="48" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="50*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="策略卖" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               x:Name="txtSumStrategySellQty" 
                                               Text="{Binding DataContext.StrategySellQtySum,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}"                                                
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" 
                                               Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ManualSellQtyStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Background="{StaticResource DataGridColumnHeaderBackground}">
                                <Grid Width="Auto" Height="48" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="50*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="手工卖" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               x:Name="txtSumManualSellQty" 
                                               Text="{Binding DataContext.ManualSellQtySum,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}"                                                
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" 
                                               Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SellQtyStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Background="{StaticResource DataGridColumnHeaderBackground}">
                                <Grid Width="Auto" Height="48" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50*" />
                                        <RowDefinition Height="50*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="卖量" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" 
                                           Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               x:Name="txtSumSellQty" 
                                               Text="{Binding DataContext.SellQtySum,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,
                       RelativeSource={RelativeSource AncestorType=DataGrid}}"                                                
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" 
                                               Foreground="{StaticResource DataGridColumnHeaderForeground}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="StrategyBuyDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <!--<Setter Property="ToolTip" Value="双击可撤销该价格所有策略买单，请谨慎操作。"/>-->
                <EventSetter Event="MouseDoubleClick" Handler="strategyBuyQtyCell_MouseDoubleClick"/>
                <EventSetter Event="Loaded" Handler="strategyBuyQtyCell_Load"/>
            </Style>
            <Style x:Key="ManualBuyDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <!--<Setter Property="ToolTip" Value="双击可撤销该价格所有手工买单，请谨慎操作。"/>-->
                <EventSetter Event="MouseDoubleClick" Handler="manualBuyQtyCell_MouseDoubleClick"/>
                <EventSetter Event="Loaded" Handler="manualBuyQtyCell_Load"/>
            </Style>
            <Style x:Key="StrategySellDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <!--<Setter Property="ToolTip" Value="双击可撤销该价格所有策略卖单，请谨慎操作。"/>-->
                <EventSetter Event="MouseDoubleClick" Handler="strategySellQtyCell_MouseDoubleClick"/>
                <EventSetter Event="Loaded" Handler="strategySellQtyCell_Load"/>
            </Style>
            <Style x:Key="ManualSellDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <!--<Setter Property="ToolTip" Value="双击可撤销该价格所有手工卖单，请谨慎操作。"/>-->
                <EventSetter Event="MouseDoubleClick" Handler="manualSellQtyCell_MouseDoubleClick"/>
                <EventSetter Event="Loaded" Handler="manualSellQtyCell_Load"/>
            </Style>
            <Style x:Key="PriceDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="Red"/>
                <EventSetter Event="Loaded" Handler="priceCell_Load"/>
            </Style>
            <Style x:Key="BuyQtyDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <!--<Setter Property="ToolTip" Value="{Binding DataContext.BuyTip,UpdateSourceTrigger=PropertyChanged,Mode=OneWay,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>-->
