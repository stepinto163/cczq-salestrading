            <!--Combox-->
            <Style TargetType="{x:Type ComboBox}" x:Key="ComboBoxStyle2">
                <Setter Property="IsEditable" Value="False"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="MinHeight" Value="24"/>
                            <Setter Property="MinWidth" Value="48"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                        <Border x:Name="Back" Background="{StaticResource TextBox.MouseOver.Background}"  BorderThickness="0,0,0,0" Padding="6, 0, 0, 0">
                                            <ContentPresenter x:Name="CP" ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="#136C5E"/>
                                                <Setter TargetName="Back" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="bdTextBox"   Grid.Column="0" BorderThickness="1, 1, 0, 1" BorderBrush="#193D37" Background="#172422" Text="{TemplateBinding Text}" Foreground="{StaticResource TextBlockForeground}" FontSize="12" Padding="0, 4, 0, 0"/>
                                <Border Grid.Column="0" CornerRadius="2" BorderThickness="0, 1, 0, 1" BorderBrush="#193D37">
                                    <TextBlock MouseDown="TextBlock_MouseDown"/>
                                </Border>
                                <Border x:Name="bdToggle" Grid.Column="1" BorderThickness="0, 1, 1, 1" BorderBrush="#193D37" Margin="0, 0, 0, 0" Background="#193D37" CornerRadius="0, 2, 2, 0">
                                    <ToggleButton x:Name="tbArrow" Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" Background="#172422" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdTextBox" Property="Background" Value="#172422"/>
                                    <Setter TargetName="bdToggle" Property="Background" Value="#172422"/>
                                </Trigger>

                                <Trigger Property="Selector.IsSelected" Value="True">
                                    <Setter TargetName ="bdTextBox" Property="TextBlock.FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

