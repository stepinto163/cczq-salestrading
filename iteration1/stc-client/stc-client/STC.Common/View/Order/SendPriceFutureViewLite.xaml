            <!--清算速度 +1 按钮 新弹出式 Combox -->
            <Style TargetType="{x:Type ComboBox}" x:Key="CapAccountComboxStyle">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Text" Value="默认"/>
                <Setter Property="IsEditable" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="IsDropDownOpen" Value="False"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="MinHeight" Value="24"/>
                            <Setter Property="MinWidth" Value="56"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                        <Border x:Name="popBack" BorderBrush="#193D37" Background="#193D37" BorderThickness="0,0,0,1" CornerRadius="0">
                                            <Canvas>
                                                <ContentPresenter x:Name="CP" Canvas.Right="20" Canvas.Top="4"  ContentSource="{Binding Source}" />
                                            </Canvas>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="popBack" Property="Background" Value="#136C5E"/>
                                                <Setter TargetName="popBack" Property="BorderBrush" Value="#2CAB97"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Back"  BorderBrush="#136C5E"  Background="{TemplateBinding Background}" BorderThickness="0,1,0,0" CornerRadius="2">
                                    <Border x:Name="InerBack"  BorderBrush="#193D37"  Background="Transparent" BorderThickness="0,0,0,1"  CornerRadius="2">
                                        <Canvas>
                                            <TextBox x:Name="bdTextBox"  Canvas.Right="18"   Canvas.Top="4"  BorderThickness="0"  Background="Transparent" Text="{TemplateBinding Text}" Foreground="{StaticResource TextBlockForeground}" FontSize="12"/>
                                            <ToggleButton x:Name="tbArrow" Canvas.Right="1"  Canvas.Bottom="0"  Canvas.Top="0" Style="{StaticResource SelfFilterComboxStyleBtn}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                                        </Canvas>
                                    </Border>
                                </Border>
                                <Border>
                                    <TextBlock x:Name="bdTextBlock" MouseDown ="bdCapAccountComboBox_MouseDown"/>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="0,2,0,2" BorderThickness="0,0,0,0" Background="#172422" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#2CAB97"/>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"/>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="2"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="1"/>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#136C5E"/>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"/>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#2CAB97"/>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"/>
                                </MultiTrigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="1"/>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"/>
                                    <Setter TargetName="Back" Property="Background" Value="#193D37"/>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#193D37"/>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="0"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"/>
                                    <Setter TargetName="Back" Property="Background" Value="#172422"/>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#172422"/>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"/>
                                </MultiTrigger>

                                <Trigger Property="Selector.IsSelected" Value="True">
                                    <Setter TargetName="bdTextBox" Property="TextBlock.FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="{x:Type ToggleButton}" x:Key="PriceComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="splitBorder" Height="24" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0" HorizontalAlignment="Center" BorderThickness="0" BorderBrush="Transparent">
                                <!--TextBlock x:Name="arrow" Text="v" Foreground="#788187" Background="Transparent" Padding="6, 3, 0, 0" FontFamily="Calibri" FontSize="14"/-->
                                <Path  x:Name="arrow" Data="M 6,10 L 10,15 L 14,10" SnapsToDevicePixels="False"  Stroke="#788187" StrokeThickness="1"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
