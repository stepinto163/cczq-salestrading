            <!--价格和数量-->
            <Style x:Key="SelfSendPriceTextBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#0B0C0C"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderBrush" Value="#0B0C0C"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="#0B0C0C" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="false"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                        <Condition Property="Tag" Value="1"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                        <Condition Property="Tag" Value="0"/>
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="true"/>
                                        <Condition Property="Tag" Value="1"/>
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                    <Setter Property="SelectionBrush" Value="#009AFF"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="true"/>
                                        <Condition Property="Tag" Value="0"/>
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                    <Setter Property="SelectionBrush" Value="#009AFF"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--展开Button-->
            <Style x:Key="ExpandButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="FontFamily" Value="KaiTi"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="0" BorderBrush="#4C000000" BorderThickness="0,0,0,0" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="12,0,0,12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.5,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#136C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#2CAB97 "/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource TextBlockForeground}"/>
                                    <Setter Property="TextElement.FontWeight" TargetName="contentPresenter" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--CheckBox的样式-->
            <Style x:Key="CheckAllForSendPrice" TargetType="{x:Type CheckBox}">
                <Style.Resources>
                    <SolidColorBrush x:Key="CheckForDelete.Static.Background" Color="#0F0F0F"/>
                    <SolidColorBrush x:Key="CheckForDelete.Static.Border" Color="#136C5E"/>
                    <SolidColorBrush x:Key="CheckForDelete.MouseOver.Background" Color="#136C5E"/>
                    <SolidColorBrush x:Key="CheckForDelete.MouseOver.Border" Color="#136C5E"/>
                    <SolidColorBrush x:Key="CheckForDelete.MouseOver.Glyph" Color="#FFEBC8"/>
                    <SolidColorBrush x:Key="CheckForDelete.Disabled.Background" Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="CheckForDelete.Disabled.Border" Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="CheckForDelete.Disabled.Glyph" Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="CheckForDelete.Pressed.Background" Color="#FF9300"/>
                    <SolidColorBrush x:Key="CheckForDelete.Pressed.Border" Color="#FF9300"/>
                    <SolidColorBrush x:Key="CheckForDelete.Pressed.Glyph" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckForDelete.Static.Glyph" Color="#136C5E"/>
                </Style.Resources>
                <Setter Property="Background" Value="{DynamicResource CheckForDelete.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CheckForDelete.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="4,-2,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="checkBoxBorder" CornerRadius="1" Height="12" Width="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid x:Name="markGrid" Margin="-1">
                                        <Path x:Name="optionMark"  Data="M0.1,6 3.2,7.5 7.5,2 7.0,0.2 3.2,5.2 1,4 0.2,4 z" Fill="Black" Opacity="0" Stretch="None"/>
                                        <Rectangle x:Name="indeterminateMark" Fill="{DynamicResource CheckForDelete.Static.Border}" Opacity="0"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.MouseOver.Background}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource CheckForDelete.MouseOver.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource CheckForDelete.MouseOver.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Disabled.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource CheckForDelete.Disabled.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource CheckForDelete.Disabled.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Pressed.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource CheckForDelete.Pressed.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource CheckForDelete.Pressed.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="0"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource CheckForDelete.Pressed.Border}"/>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Pressed.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Pressed.Border}"/>
                                    <!--<Setter Property="BorderThickness" TargetName="checkBoxBorder" Value="0"/>-->
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="0"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SelfCheckBoxStyle" TargetType="{x:Type CheckBox}">
                <Style.Resources>
                    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="Transparent"/>
                    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#136C5E"/>
                    <Style x:Key="OptionMarkFocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="14,0,0,0" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="#FF9200"/>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="#FF5593FF"/>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="#FF212121"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Background" Color="#FFE6E6E6"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Border" Color="#FFBCBCBC"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Glyph" Color="#FF707070"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="Transparent"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="#FF3C77DD"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="#FF212121"/>
                    <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="#FF212121"/>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="checkBoxBorder" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,3,1,3" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid x:Name="markGrid">
                                        <Path x:Name="optionMark"  Data="M0.1,6 3.2,7.5 7.5,2 7.0,0.2 3.2,5.2 1,4 0.2,4 z" Fill="#FFFFFF" Opacity="0" Stretch="None"/>
                                        <Rectangle x:Name="indeterminateMark" Fill="{StaticResource OptionMark.Static.Glyph}" Margin="2" Opacity="0"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasContent" Value="true">
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource OptionMarkFocusVisual}"/>
                                    <Setter Property="Padding" Value="4,1,0,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="#1E1E1E"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="#3C3C3C"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.Disabled.Glyph}"/>
                                    <Setter Property="Opacity" TargetName="templateRoot" Value="0.4"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.Pressed.Glyph}"/>
                                    <!--<Setter Property="Fill" TargetName="contentPresenter" Value="{StaticResource OptionMark.Pressed.Glyph}"/>-->
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="0"/>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="#136C5E"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="#136C5E"/>
                                    <!--<Setter Property="BorderThickness" TargetName="checkBoxBorder" Value="0"/>-->
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="0"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <SolidColorBrush x:Key="SelectItemBorderBrush" Color="#F9C152"/>
            <SolidColorBrush x:Key="SelectItemBackground" Color="#FF9300"/>
            <SolidColorBrush x:Key="SelectItemForeground" Color="#000000"/>

            <!-- 2 ,3, 5 按钮-->
            <Style x:Key="BtnAmountListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!--<Setter Property="Padding" Value="0"/>-->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="Background" Value="{StaticResource TextBox.Disable.Background}"/>
                <!--<Setter Property="Padding" Value="10,0,10,0"/>-->
                <Setter Property="Width" Value="48"/>
                <Setter Property="Margin" Value="2, 0, 0, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" BorderThickness="0, 1, 0, 0" VerticalAlignment="Center" Margin="0,0,0,0" 
                                BorderBrush="{TemplateBinding Background}"  Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="Cp" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource TextBox.Disable.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource TextBox.Disable.Background}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{DynamicResource ListBoxItem.SelectedActive.Foreground}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--有效时长Combox-->
            <Style TargetType="ComboBox" x:Key="PriceComboBox">
                <Setter Property="Height" Value="24"></Setter>
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="IsReadOnly" Value="True"></Setter>
                <Setter Property="IsDropDownOpen" Value="False"></Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="24"></Setter>
                            <Setter Property="MinWidth" Value="56"></Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"></Setter>
                            <Setter Property="Background" Value="{StaticResource MainFormBackground}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="popBack" BorderBrush="#193D37" Background="{StaticResource MainFormBackground}" BorderThickness="0,0,0,1" CornerRadius="0">
                                            <Canvas>
                                                <ContentPresenter Canvas.Right="50" Canvas.Top="4"  ContentSource="{Binding Source}" ></ContentPresenter>
                                            </Canvas>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="popBack" Property="Background" Value="#136C5E"></Setter>
                                                <Setter TargetName="popBack" Property="BorderBrush" Value="#2CAB97"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Name="Back"  BorderBrush="#136C5E"  Background="{StaticResource MainFormBackground}" BorderThickness="1,1,1,1" CornerRadius="2">
                                    <Border Name="InerBack"  BorderBrush="#193D37"  Background="Transparent" BorderThickness="0,0,0,1"  CornerRadius="2">
                                        <Canvas>
                                            <TextBox x:Name="bdTextBox"  Canvas.Right="50"   Canvas.Top="4"  BorderThickness="0"  Background="Transparent" Text="{TemplateBinding Text}" Foreground="{StaticResource TextBlockForeground}" FontSize="12">
                                            </TextBox>
                                            <ToggleButton x:Name="tbArrow" Canvas.Right="1"  Canvas.Bottom="0"  Canvas.Top="0" Style="{StaticResource PriceComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"></ToggleButton>
                                        </Canvas>
                                    </Border>
                                </Border>
                                <Border>
                                    <TextBlock x:Name="bdTextBlock" MouseDown="bdTextBlock_MouseDown"></TextBlock>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="0,0,0,0" BorderThickness="0,0,0,0" Background="#172422" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#2CAB97"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="2"></Setter>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#136C5E"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#2CAB97"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#193D37"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <!--下单窗口-->
    <Grid Height="940" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="122"/>
            <RowDefinition Height="96"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderThickness="2,2,2,0" x:Name="Border_Left1" Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="{Binding BorderBrush}"  Background="{StaticResource MainFormBackground}">
            <Grid  Background="#0F0F0F" Margin="4,0,2,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="282"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="发布需求" Width="48" Margin="-4, 4, 0, 0" Grid.Column="0"  Foreground = "#FFFFFF" FontFamily="MicroSoft YaHei" FontWeight="Bold" FontSize="{StaticResource SmallContentFontSize}"/>
                <Button Width="16" Height="16" Grid.Column="3" Margin="0,0,-2,0" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />

                <!--<Button x:Name="btnDepth" Command="{Binding DepthCommand}" HorizontalAlignment="Right" Content="{Binding SendPriceType}" Grid.Column="2" Style="{StaticResource DepthButton}"/>-->
            </Grid>
        </Border>

        <Border BorderThickness="2,0,2,0" x:Name="Border_Left2" Grid.Row="1"  BorderBrush="{Binding BorderBrush}"  Background="{StaticResource MainFormBackground}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="246"/>
                    <ColumnDefinition Width="246"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BidBtn" Content="Bid" Command="{Binding BidCommand}" Tag="{Binding IsBidSelect, Mode=TwoWay}"  Grid.Column="0" Margin="0,2,1,0"  Height="30" Style="{StaticResource BidButton}" Background="{Binding SendPriceItem.BidBG}"/>
                <Button x:Name="OfrBtn" Content="Ofr" Command="{Binding OfrCommand}" Tag="{Binding IsBidSelect, Mode=TwoWay}"  Grid.Column="1" Margin="1,2,-1,0"  Height="30" Style="{StaticResource OfrButton}" Background="{Binding SendPriceItem.OfrBG}">
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderThickness="2, 0, 2, 0" x:Name="Border_Left3" BorderBrush="{Binding BorderBrush}" Background="{StaticResource MainFormBackground}">
            <Grid Background="{Binding SendPriceItem.BorderBG}">
                <!--<Grid Background="{StaticResource BidLinearGradientBrush}">-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="90"/>
                    <!--<RowDefinition Height="Auto"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="12"/>-->
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Component:CustomTradeSearchTextBox x:Name="Search_TextBox" HorizontalAlignment="Left" Grid.Column="0"
                                    AfterSearch="Search_TextBox_AfterSearch" ShowText="{Binding ShowText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Top"  BorderBrush="{StaticResource MainFormBackground}" 
                                    Width="375" Height="30" Margin="8,0,0,0"/>
                </Grid>
                <!--量-->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ListBox  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"  x:Name="ConstAmount"  
                                      SelectionMode="Single" Margin="6, 0, 0, 0" 
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     Height="26" 
                                     Background="Transparent" MinWidth="110"
                                     BorderThickness="0"
                                     FontSize="12"  SelectedIndex="{Binding SetAmountTxtIndex, Mode=TwoWay}"
                                     VerticalAlignment="Center" HorizontalAlignment="Left" 
                                     BorderBrush="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Width="47" Height="20" x:Name="ConstAmount1" Content="1" Style="{DynamicResource BtnAmountListBoxItemStyle}" FontFamily="Roboto" FontStyle="Italic" Background="{StaticResource MainFormBackground}"/>
                            <ListBoxItem Width="47" Height="20" x:Name="ConstAmount5" Content="5" Style="{DynamicResource BtnAmountListBoxItemStyle}"  FontFamily="Roboto" FontStyle="Italic" Background="{StaticResource MainFormBackground}"/>
                            <ListBoxItem Width="47" Height="20" x:Name="ConstAmount10" Content="10" Style="{DynamicResource BtnAmountListBoxItemStyle}"  FontFamily="Roboto" FontStyle="Italic" Background="{StaticResource MainFormBackground}"/>
                            <ListBoxItem Width="47" Height="20" x:Name="ConstAmount20" Content="20" Style="{DynamicResource BtnAmountListBoxItemStyle}"  FontFamily="Roboto" FontStyle="Italic" Background="{StaticResource MainFormBackground}"/>
                            <ListBoxItem Width="47" Height="20" x:Name="ConstAmount50" Content="50" Style="{DynamicResource BtnAmountListBoxItemStyle}"  FontFamily="Roboto" FontStyle="Italic" Background="{StaticResource MainFormBackground}"/>
                        </ListBox>
                    </Grid>

                    <TextBox  Grid.Column="0" Grid.Row="1" x:Name="AmountTxt" 
                                  Height="40"
                                  FontSize="24" 
                                  InputMethod.IsInputMethodEnabled="False"
                                  PreviewTextInput="TextBox_PreviewTextInput" 
                                  PreviewKeyDown="TextBox_PreviewKeyDown"
                                  ContextMenu="{x:Null}" 
                                  TextChanged="AmountTxt_TextChanged"
                                  BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"  
                                  Text="{Binding SendPriceItem.Amount, Mode=TwoWay}" Margin="9,2,31,0" 
                                  Tag="{Binding OfrOrBid, Mode=TwoWay}"
                                  Style="{DynamicResource SelfSendPriceTextBox}"
                                  Foreground="White"
                                  HorizontalContentAlignment="Center"/>
                    <TextBlock Grid.Column="0" Grid.Row="1" x:Name="AmountTxtLot" 
                                   Text="手" 
                                   Foreground="{StaticResource ColorBrush.Gray14}" 
                                   Background="Transparent"
                                   FontSize="10" 
                                   Margin="217,20,10,0"
                                   Width="14" 
                                   Height="20"/>
                    <Grid Grid.Column="1" Grid.Row="1" Margin="0,2,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="6*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnAddAmout" Padding="0,0,0,0" Margin="0,0,0,0" Grid.Row="0" TabIndex="-1" Width="34" Height="16" Content="+" Command="{Binding AddAmountCommand}" Style="{StaticResource AddAmountButtonStyle}" FontSize="12"/>
                        <Button Grid.Column="0" x:Name="btnReduceAmout" Padding="0,0,0,0"  Margin="0,0,0,0"  Grid.Row="1" TabIndex="-1" Width="34" Height="16" Content="-" Command="{Binding ReduceAmountCommand}" Style="{StaticResource DecreaseAmountButtonStyle}"  FontSize="12"/>
                        <TextBlock Visibility="Hidden" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" x:Name="MaxAmountTxtLot" Text="&lt;=5手"  Foreground="{StaticResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="0,19,0,0" Width="36"/>
                        <!--<Button Grid.Row="1"
                                    Grid.Column="1"
                                Margin="30,0,0,0" 
                                Content=">>" 
                                x:Name="btn_Expand" 
                                Tag="Visible"
                                Padding="6,-1,0,0" 
                                Style="{DynamicResource ExpandButton}" 
                                Command="{Binding ExpandCommand}" 
                                Foreground="{StaticResource TextBlockForeground}"
                                Visibility="Collapsed"
                                Width="24"
                                Height="20">
                            <Button.RenderTransform>
                                <RotateTransform  CenterX="12" CenterY="10" Angle="270"></RotateTransform>
                            </Button.RenderTransform>
                        </Button>-->
