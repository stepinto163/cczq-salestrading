<UserControl x:Class="STC.Common.View.Order.InnerPanel.TagView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Order.InnerPanel"
             xmlns:comp="clr-namespace:STC.Common.View.Component"
             mc:Ignorable="d" 
             d:DesignHeight="145" d:DesignWidth="394">


    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/View/Order/SendPriceDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <Style x:Key="CusCheckBoxStyle" TargetType="{x:Type CheckBox}">
                <Style.Resources>
                    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#136C5E"/>
                    <Style x:Key="OptionMarkFocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="14,0,0,0" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="#FF9200"/>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="#FF5593FF"/>
                    <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="#FF212121"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Background" Color="#FFE6E6E6"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Border" Color="#FFBCBCBC"/>
                    <SolidColorBrush x:Key="OptionMark.Disabled.Glyph" Color="#FF707070"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="Transparent"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="#FF3C77DD"/>
                    <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="#FF212121"/>
                    <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="#FF212121"/>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="checkBoxBorder" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid x:Name="markGrid">
                                        <Path x:Name="optionMark" Data="F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z " Fill="#FFFFFF" Margin="1" Opacity="0" Stretch="None"/>
                                        <Rectangle x:Name="indeterminateMark" Fill="{StaticResource OptionMark.Static.Glyph}" Margin="2" Opacity="0"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasContent" Value="true">
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource OptionMarkFocusVisual}"/>
                                    <Setter Property="Padding" Value="4,1,0,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.MouseOver.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Disabled.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.Disabled.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.Disabled.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{StaticResource OptionMark.Pressed.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{StaticResource OptionMark.Pressed.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="0"/>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="#136C5E"></Setter>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="#136C5E"></Setter>
                                    <!--<Setter Property="BorderThickness" TargetName="checkBoxBorder" Value="0"/>-->
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="0"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="templateRoot" SnapsToDevicePixels="true" Background="Black" BorderBrush="#515151" BorderThickness="0,0,0,0">
                                <Border x:Name="splitBorder" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0,0,2,0" 
                                        HorizontalAlignment="Center" BorderThickness="0" BorderBrush="Transparent">
                                    <!--<TextBlock x:Name="arrow" Text="v" Foreground="{StaticResource TextBox.Static.Foreground}" Background="#172422" Padding="6, 3, 0, 0"></TextBlock>-->
                                    <Path  x:Name="arrow" Data="M 6,10 L 10,15 L 14,10" SnapsToDevicePixels="False"  Stroke="#788187" StrokeThickness="1"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--鼠标移过-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Stroke" TargetName="arrow" Value="#FFFFFF"/>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                </Trigger>
                                <!--<MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                    -->
                                <!--<Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>-->
                                <!--
                                </MultiDataTrigger>-->
                                <!--鼠标按下-->
                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter Property="Stroke" TargetName="arrow" Value="#788187"/>
                                    <Setter Property="Background" TargetName="templateRoot"  Value="#172422" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                    <!--<Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>-->
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--Combox-->
            <Style TargetType="ComboBox" x:Key="ComboBoxStyle2">
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="24"></Setter>
                            <Setter Property="MinWidth" Value="48"></Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"></Setter>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Back" Background="{StaticResource TextBox.MouseOver.Background}" CornerRadius="2" BorderBrush="{StaticResource ColorBrush.Gray15}" BorderThickness="1" Padding="6, 0, 0, 0">
                                            <ContentPresenter x:Name="CP" ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                                <Setter TargetName="Back" Property="BorderThickness" Value="1"></Setter>
                                                <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="bdTextBox"   Grid.Column="0" BorderThickness="0" BorderBrush="#193D37" Background="Black" Text="{TemplateBinding Text}" Foreground="{StaticResource TextBlockForeground}" FontSize="12" Padding="0, 4, 0, 0">
                                </TextBox>
                                <Border Grid.Column="0" CornerRadius="2" BorderThickness="0" BorderBrush="#193D37">
                                    <TextBlock MouseDown="TextBlock_MouseDown"></TextBlock>
                                </Border>
                                <Border x:Name="bdToggle" Grid.Column="1" BorderThickness="0" BorderBrush="#193D37" Margin="0, 0, 0, 0" Background="Black" CornerRadius="0, 2, 2, 0">
                                    <ToggleButton x:Name="tbArrow" Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" ></ToggleButton>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" Background="#172422" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdTextBox" Property="Background" Value="#172422"></Setter>
                                    <Setter TargetName="bdToggle" Property="Background" Value="#172422"></Setter>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName ="bdTextBox" Property="TextBlock.FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>


    </UserControl.Resources>
    
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="标签:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource DefaultFont}" 
                       Foreground="{StaticResource ColorBrush.Gray14}"></TextBlock>

        <CheckBox Content="VIP" Foreground="{StaticResource ColorBrush.Yellow-1}" Grid.Row="1" Width="40" FontStyle="Italic" FontWeight="Bold" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray-23}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource CommonCheckBoxStyle}" Background="Transparent" Padding="0,0,0,0"
                  IsChecked="{Binding CheckVIP}"></CheckBox>
        <CheckBox Grid.Row="1" Margin="52, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray-23}"
                  Style="{StaticResource CommonCheckBoxStyle}" Background="Transparent" Padding="0,0,0,0" IsChecked="{Binding CheckClientType}"></CheckBox>
        <!--<ComboBox Grid.Row="1" Margin="71, 0, 0, 0" Width="136" HorizontalAlignment="Left" Height="24" Style="{StaticResource ComboBoxStyle2}"></ComboBox>-->


        <Border Grid.Row="1" Margin="65, 0, 0, 0" HorizontalAlignment="Left">
            <comp:AutoCompleteComboBox x:Name="TrdNameCb_edit" Height="24" Margin="5 0 0 0" Width="136" IsEnabled="{Binding CheckClientType}"
                                                       DisplayValuePath="shortnamecn" LostFocus="TrdNameCb_edit_LostFocus"
                                                       SelectedItem="{Binding SelectedInstintuion_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding ClientTypeEnum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                        BackGroundCob="{StaticResource ColorBrush.Black8}" 
                                                       MouseOverBorderBrushCob="{StaticResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{StaticResource TextBox.Focus.Border}"
                                                       Watermark="客户类型" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedUserIDCB_PatternChanged">
                <comp:AutoCompleteComboBox.AutoCompColumns>
                    <DataGridTemplateColumn MinWidth="50" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="Transparent">
                                    <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Text}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                </comp:AutoCompleteComboBox.AutoCompColumns>
            </comp:AutoCompleteComboBox>
        </Border>




        <TextBlock Grid.Row="2" Text="订阅报价:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource DefaultFont}" 
                       Foreground="{StaticResource ColorBrush.Gray14}"></TextBlock>
        <CheckBox Content="该券同向" Grid.Row="3" FontWeight="Bold" IsChecked="{Binding CheckSyntropy}" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray-23}" Foreground="{StaticResource ColorBrush.White-1}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource CommonCheckBoxStyle}" Background="Transparent" Padding="2,0,0,0"></CheckBox>
        <TextBlock Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource DefaultFont}" 
                       Foreground="{StaticResource ColorBrush.Gray14}" Margin="68, 2, 0, 0">
            <Run Text="(#"></Run>
            <Run Text="{Binding SecurityID}"></Run>
            <Run Text=" "></Run>
            <Run Text="{Binding SyntropyTxt}"></Run>
            <Run Text=")"></Run>
        </TextBlock>


        <CheckBox Content="该券反向" Grid.Row="4" FontWeight="Bold" IsChecked="{Binding CheckReverse}" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray-23}" Foreground="{StaticResource ColorBrush.White-1}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource CommonCheckBoxStyle}" Background="Transparent" Padding="2,0,0,0"></CheckBox>
        <TextBlock Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource DefaultFont}" 
                       Foreground="{StaticResource ColorBrush.Gray14}" Margin="68, 2, 0, 0">
            <Run Text="(#"></Run>
            <Run Text="{Binding SecurityID}"></Run>
            <Run Text=" "></Run>
            <Run Text="{Binding ReverseTxt}"></Run>
            <Run Text=")"></Run>
        </TextBlock>
    </Grid>
</UserControl>
