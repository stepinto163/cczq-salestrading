<UserControl x:Class="STC.Common.View.MyTrading.BuySellQtyPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View"
             xmlns:comp="clr-namespace:STC.Common.View.Component"
             xmlns:vm="clr-namespace:STC.Common.ViewModel.SendPriceFutureViewLite"
             mc:Ignorable="d" 
             FontSize="12"
             Foreground="{DynamicResource DefaultForegroup.ColorBrush}" MaxHeight="507"
             d:DesignHeight="60" d:DesignWidth="80" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <vm:BuySellPopupViewModel x:Key="buySellPopupViewModel"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.DataContext>
        <StaticResourceExtension ResourceKey="buySellPopupViewModel"/>
    </UserControl.DataContext>
    <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

        <Border BorderThickness="2,2,2,2" Grid.Row="0" CornerRadius="0,0,0,0" BorderBrush="{Binding Color}"  Background="{StaticResource MainBackgroup.ColorBrush}">
            <StackPanel Orientation="Horizontal" Margin="4,0,0,0" Width="40">
                <TextBlock Text="{Binding Sign}"
                           Foreground="{Binding Color}"
                           VerticalAlignment="Center" 
                           Margin="4,0,0,0"/>
                <TextBlock Text="{Binding Amount}" 
                           Foreground="{Binding Color}"
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="4,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
