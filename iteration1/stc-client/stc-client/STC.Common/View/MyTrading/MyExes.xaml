                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>-->

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <local:MyExecutionsFilterPanel x:Name="myExeFilter" VerticalAlignment="Center" HorizontalAlignment="Left" FilterDicChanged="myExeFilter_FilterDicChanged" Margin="0,-2,0,0"/>

        <Component:SearchTextBox x:Name="Search_TextBox" HorizontalAlignment="Left" Margin="875 0 0 0" 
                                 SearchText="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Width="120" Height="18" IsFuzzy="True"/>

        <Component:CustomExecDataGrid x:Name="MyExecutions_Intention_dataGrid" Grid.Row="2" Style="{StaticResource DefaultDataGrid}"
                          ItemsSource="{Binding MyExecutionsDV}" 
                          SelectedItem="{Binding SelectedItem_MyExecutions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          MouseRightButtonDown="MyExecutions_dataGrid_MouseRightButtonDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Width="Auto" MinWidth="16" Binding="{Binding ID}" FontWeight="SemiBold"/>
                <DataGridTextColumn Binding="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}" 
                                                    ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                    Header="方向" Width="Auto" MinWidth="40" CellStyle="{StaticResource ColumnColorStyle}"/>
                <DataGridTextColumn Header="代码" Width="Auto" MinWidth="85" Binding="{Binding SecurityID}" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="简称" Width="Auto" MinWidth="85" Binding="{Binding Symbol}"  FontWeight="SemiBold"/>
                <DataGridTextColumn Header="同步状态" Width="Auto" MinWidth="85"
                                        Binding="{Binding SyncStatus, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='synchflag'}"
                                                ClipboardContentBinding="{Binding SyncStatus, Converter={StaticResource EnumTypeConvertor},ConverterParameter='synchflag'}"  />
                    <DataGridTextColumn Header="成交价(%)" Width="Auto" MinWidth="80" Binding="{Binding LastPx_Display, Converter={StaticResource numConvertor},ConverterParameter=''}" SortMemberPath="LastPx"
                                            FontWeight="SemiBold" />
                <DataGridTextColumn Header="净价(元)" Width="Auto" MinWidth="80" Binding="{Binding NetPrice,Converter={StaticResource numConvertor}}"/>
                <!--<DataGridTextColumn Header="全价(元)" Width="Auto" MinWidth="80" Binding="{Binding DirtyPrice,StringFormat={}{0:N4}}"/>-->
                <DataGridTextColumn Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                                    ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                                    Header="清算速度" Width="Auto" MinWidth="70" SortMemberPath="SettlDate">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                            <Setter Property="ToolTip" Value="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                        </Style>

                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="成交量(万)" Width="Auto" MinWidth="70" Binding="{Binding LastQty}"/>
                <!--<DataGridTextColumn Header="结算金额(元)" Width="Auto" MinWidth="80" Binding="{Binding DeliveryAmount,StringFormat={}{0:N2}}"/>-->
                <DataGridTemplateColumn Header="对手方" Width="Auto" MinWidth="80"  MaxWidth="200" ClipboardContentBinding="{Binding CounterPartyName, Converter={StaticResource StringConvertor}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPartyName, Converter={StaticResource StringConvertor}}" TextTrimming="CharacterEllipsis" 
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="对手交易员" Width="Auto" MinWidth="90"  MaxWidth="200" ClipboardContentBinding="{Binding CounterPartySubName, Converter={StaticResource StringConvertor}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPartySubName, Converter={StaticResource StringConvertor}}" TextTrimming="CharacterEllipsis" 
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="成交编号" Width="Auto" MinWidth="150" Binding="{Binding ExecID}"/>
                <DataGridTextColumn Binding="{Binding QuantID}" Header="策略名" Width="Auto"  MinWidth="70"/>
                <DataGridTextColumn Binding="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues_exe'}" 
                                                    ClipboardContentBinding="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues_exe'}" 
                                                    Header="渠道" Width="Auto" MinWidth="70"/>
                <DataGridTextColumn Header="本方交易员" Width="Auto" MinWidth="80" Binding="{Binding PartySubName}"/>
                <DataGridTextColumn Header="成交时间" Width="Auto" MinWidth="60" Binding="{Binding ExecutionTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}"
                                            Foreground="{StaticResource DataGrid.SubTitle.Foreground}" 
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}" 
                                            CellStyle="{StaticResource DataGridTextRightStyle}"/>
                <DataGridTextColumn Header="我的订单号" Width="Auto" MinWidth="135" Binding="{Binding StrategyOrderID}"/>
                <DataGridTextColumn Header="对手订单号" Width="Auto" MinWidth="135" Binding="{Binding RefOrderID, Converter={StaticResource StringConvertor}}"/>
                <DataGridTemplateColumn Header="客户机构" Width="Auto" MinWidth="70" SortMemberPath="InstitutionName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="InsName_display" Foreground="#FFFFFF" Text="{Binding InstitutionName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstitutionName}"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="客户名" Width="Auto"  MinWidth="70" SortMemberPath="TraderName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="TrdNameLb_display" Foreground="#FFFFFF" Text="{Binding TraderName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TraderName}"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </Component:CustomExecDataGrid>
    </Grid>
</UserControl>
