<UserControl x:Class="STC.Common.View.MyTrading.MyExecutionsFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:STC.Common.View.MyTrading"
             mc:Ignorable="d"  FontSize="12" Height="24"
             d:DesignHeight="24" d:DesignWidth="870">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
        <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
        <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <StackPanel Orientation="Horizontal" Height="16" >
      <TextBlock x:Name="VenuesLbl" Text="交易场所:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
      <ListBox x:Name="VenuesListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="VenuesListBox_SelectionChanged">
        <ListBox.Template>
          <ControlTemplate>
            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
          </ControlTemplate>
        </ListBox.Template>
        <ListBoxItem Content="全部" x:Name="All" Style="{StaticResource MyCommonFilterListBoxItemStyle}" IsSelected="True" />
                <ListBoxItem Content="Tradebook" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="X-Bond" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="双边" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>

                <ListBoxItem Content="全部" x:Name="AllBroker" Style="{StaticResource MyCommonFilterListBoxItemStyle}" Margin="10,0,0,0"/>
                <ListBoxItem Content="国际" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="国利" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="平安" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="信唐" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="中诚" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
      </ListBox>

      <TextBlock x:Name="SyncStatusLbl" Text="同步状态:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>

      <ListBox x:Name="SyncStatusBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="SyncStatusBox_SelectionChanged">
        <ListBox.Template>
          <ControlTemplate>
            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
          </ControlTemplate>
        </ListBox.Template>
                <ListBoxItem Content="全部" Style="{StaticResource MyCommonFilterListBoxItemStyle}" IsSelected="True" />
                <ListBoxItem Content="已发送" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="待处理" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
      </ListBox>

            <TextBlock x:Name="tbCodeType" Text="债券类型:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="lbCodeType" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="LbCodeType_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{StaticResource MyCommonFilterListBoxItemStyle}" IsSelected="True" />
                <ListBoxItem Content="利率" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="信用" Style="{StaticResource MyCommonFilterListBoxItemStyle}"/>
            </ListBox>
        </StackPanel>
  </Grid>
</UserControl>
