<UserControl x:Class="STC.Common.View.MyTrading.MyOrdersFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:command="clr-namespace:STC.Common.Command"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             mc:Ignorable="d"  
             FontSize="12" Height="24"
             d:DesignHeight="24" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CloseAllComboBoxStyle" TargetType="ComboBoxItem">
                <Setter Property="MinHeight" Value="20"></Setter>
                <Setter Property="MinWidth" Value="60"></Setter>
                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                <Setter Property="FontSize" Value="12"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Name="Back" Background="#3C3C3C"  BorderThickness="0" BorderBrush="#3C3C3C">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonDown">
                                        <command:ExecuteCommandAction Command="{Binding DataContext.CancelAllOrdersCommand,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}}" >
                                            <command:ExecuteCommandAction.CommandParameter>
                                                <MultiBinding Converter="{StaticResource  MultiBindingConverter}">
                                                    <MultiBinding.Bindings>
                                                        <Binding ElementName="CancelAll_CBC"/>
                                                        <Binding ElementName="cp" Path="Content"/>
                                                    </MultiBinding.Bindings>
                                                </MultiBinding>
                                            </command:ExecuteCommandAction.CommandParameter>
                                        </command:ExecuteCommandAction>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <ContentPresenter x:Name="cp" ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,5,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#A0A0A0"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal" Height="24">
            <TextBlock x:Name="SourceLbl" Text="来源:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="VenuesListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="VenuesListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource MyCommonFilterListBoxItemStyle}" IsSelected="True" />
                <!--<ListBoxItem Content="人工" Style="{StaticResource CommonFilterListBoxItemStyle}"/>-->
                <ListBoxItem Content="内部" Style="{DynamicResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="做市" Style="{DynamicResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="IDB" Visibility="Collapsed" Style="{DynamicResource MyCommonFilterListBoxItemStyle}" Width="40"/>
                <ListBoxItem Content="量化" Visibility="Collapsed" Style="{DynamicResource MyCommonFilterListBoxItemStyle}" Width="40"/>
            </ListBox>

            <TextBlock x:Name="FirmFlagLbl" Text="类型:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="FirmFlagListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="FirmFlagListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource MyCommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="firm" Style="{DynamicResource MyCommonFilterListBoxItemStyle}" Width="60"/>
                <ListBoxItem Content="nonfirm" Style="{DynamicResource MyCommonFilterListBoxItemStyle}" Width="60"/>
            </ListBox>

            <TextBlock x:Name="tbCodeType" Text="债券类型:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="lbCodeType" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="LbCodeType_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource MyCommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="利率" Style="{DynamicResource MyCommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="信用" Style="{DynamicResource MyCommonFilterListBoxItemStyle}"/>
            </ListBox>

            <Button x:Name="CancelAllBtn" Content="一键撤单" Width="80" Height="18" Margin="10,0,5,0"  HorizontalAlignment="Right"
                    Visibility="Collapsed" Style="{DynamicResource  BlueGreenStyle}" Click="CancelAllBtn_Click"/>
            <!--<ComboBox x:Name="CancelAll_CBC" Width="120" Height="18" Margin="10,0,5,0"  HorizontalAlignment="Right" Background="#3C3C3C"
                      Style="{StaticResource NonEditableComboBoxStyle}" Visibility="Collapsed">
                <ComboBoxItem Content="一键撤销" IsSelected="True" Style="{StaticResource CloseAllComboBoxStyle}">

                </ComboBoxItem>
                <ComboBoxItem Content="一键撤量化订单" Style="{StaticResource CloseAllComboBoxStyle}" >
                   
                </ComboBoxItem>
            </ComboBox>-->
            <Button x:Name="ResendBtn" Content="恢复报价" Height="20" Width="80" VerticalAlignment="Center" Margin="10,0,5,0" 
                    Visibility="Collapsed" Style="{DynamicResource BlueGreenStyle}" Command="{Binding ResendCommand}"
                    IsEnabled="{Binding IsEnabled_Resend}"/>
        </StackPanel>   
    </Grid>
</UserControl>
