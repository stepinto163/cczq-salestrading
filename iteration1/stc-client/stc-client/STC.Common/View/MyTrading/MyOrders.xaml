<UserControl x:Class="STC.Common.View.MyTrading.MyOrders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Component="clr-namespace:STC.Common.View.Component" 
             xmlns:myTrading="clr-namespace:STC.Common.View.MyTrading"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <ContextMenu x:Key="CopyContextMenu" Style="{StaticResource DefaultContextMenu}" ContextMenuOpening="UserControl_ContextMenuOpening">
                <MenuItem x:Name="copyRow" Header="复制" Style="{StaticResource DefaultMenuItem}" Click="copyRow_Click"/>
                <MenuItem x:Name="copySTCCode" Header="复制单号" Style="{StaticResource DefaultMenuItem}" Click="copySTCCode_Click"/>
            </ContextMenu>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" MouseEnter="ContentPresenter_MouseEnter">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 删除按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfDeleteButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Image Source="/STC.Common;component/Images/stc_icon_newdelet_normal.png" Width="12"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#136C5E" />
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_newdelet_hover.png" Width="12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_newdelet_press.png" Width="12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_newdelet_disable.png" Width="12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 新编辑按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfEditButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Image Source="/STC.Common;component/Images/stc_icon_newedit_normal.png" Width="12"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#136C5E" />
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_newedit_hover.png" Width="12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_newedit_hover.png" Width="12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_newedit_disable.png" Width="12"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 时钟按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="TimerButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="-2,0,0,0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Image Source="/STC.Common;component/Images/stc_icon_history_normal.png" Width="14"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#136C5E" />
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_history_hover.png" Width="14"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_history_normal.png" Width="14"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Common;component/Images/stc_icon_history_normal.png" Width="14"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Setter  Property="Visibility">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource clockVisibilityConvertor}">
                            <Binding Path="IsPoint"/>
                            <Binding Path="ValidUntilTime"/>
                            <Binding Path="RemainingTime"/>
                            <Binding Path="Info1"/>
                        </MultiBinding>
                    </Setter.Value>
                </Setter>

            </Style>

            <!--ToolTip的样式-->
            <!--<Style TargetType="ToolTip">
                <Setter Property="Background" Value="#282828"/>
                <Setter Property="Padding" Value="4,2,4,2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="ArialMT"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderBrush" Value="#8F9598"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border x:Name="Root" CornerRadius="2" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}">
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <Border.Resources>
                                        <Storyboard x:Key="Visible State"/>
                                        <Storyboard x:Key="Normal State"/>
                                    </Border.Resources>
                                    <ContentPresenter
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Cursor="{TemplateBinding Cursor}"
                              Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>-->

            <!-- FrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Polygon Fill="#FFB60E" Points="6 -5.31777997e-15 0 7.42857143 4 7.42857143 2 13 8 5.57142857 3.99658203 5.57142857"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- NoFrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfNonFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="NF" Foreground="White">
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <myTrading:MyOrdersFilterPanel x:Name="myOrderFilter" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                       FilterDicChanged="myOrderFilter_FilterDicChanged" Visibility4CancelAllBtn="Visible"
                                       Visibility4ResendBtn="Collapsed" Margin="10,-2,0,0" />
        <Component:SearchTextBox x:Name="Search_TextBox" HorizontalAlignment="Left" Margin="655 0 0 0" 
                                 SearchText="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Width="120" Height="18" IsFuzzy="True"/>
        <!--Style="{StaticResource DefaultDataGrid}"-->
        <Grid Grid.Row="2">

            <Component:CustomExecDataGrid x:Name="MyOrders_Intention_dataGrid" ItemsSource="{Binding MyOrdersDV}"
                                  SelectedItem="{Binding SelectedItem_MyOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource DefaultDataGrid}"
                                  SizeChanged="MyOrders_dataGrid_SizeChanged" MouseDoubleClick="MyOrders_dataGrid_MouseDoubleClick"
                                                  MouseRightButtonDown="MyOrders_dataGrid_MouseRightButtonDown">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="选择" Width="27" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="CheckBox_All" PreviewMouseLeftButtonDown="CheckBox_All_PreviewMouseLeftButtonDown" 
                                                      IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding EnabledBtn}"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                                <DataTemplate.Triggers>
                                    <DataTrigger  Binding="{Binding ShowDeleteBtn}" Value="2">
                                        <Setter TargetName="Selected_Chk" Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"
                                                    ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                    Header="方向" Width="Auto" MinWidth="40" CellStyle="{StaticResource ColumnColorStyle}"/>
                    <DataGridTextColumn Binding="{Binding SecurityID}" Header="代码" Width="Auto" MinWidth="85" FontWeight="SemiBold" ClipboardContentBinding="{Binding SecurityID}"/>
                    <DataGridTextColumn Binding="{Binding Symbol}" Header="简称" Width="Auto" MinWidth="85" FontWeight="SemiBold" ClipboardContentBinding="{Binding Symbol}"/>
                    <DataGridTextColumn Binding="{Binding SettleType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                    ClipboardContentBinding="{Binding SettleType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                    Header="清算速度" Width="Auto" MinWidth="40" SortMemberPath="SettlDate">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="ToolTip" Value="{Binding SettleType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="60" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="EditBtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Style="{StaticResource SelfEditButton}" Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                        IsEnabled="{Binding EnabledBtn}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown">
                                    </Button>
                                    <Button x:Name="DelBtn"  Height="18" Width="18" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DelOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                        Style="{StaticResource SelfDeleteButton}" Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"
                                                        IsEnabled="{Binding EnabledBtn}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"/>

                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger  Binding="{Binding IsPoint}" Value="1">
                                        <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="DelBtn" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="意向" Width="Auto" MinWidth="50" HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <!--<TextBlock x:Name="firmflag" Text="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag'}">
                                                </TextBlock>-->
                                    <Button x:Name="firmbtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Style="{StaticResource SelfFirmButton}" Visibility="Collapsed">
                                    </Button>
                                    <Button x:Name="nonfirmbtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Style="{StaticResource SelfNonFirmButton}" Visibility="Collapsed">
                                    </Button>
                                    <TextBlock Foreground="#00FFD6" x:Name="point_txt" Visibility="Collapsed" >
                                                    <Run Text=" ("></Run><Run Text="{Binding RemainSeconds}" FontWeight="Medium" FontFamily="Roboto"> </Run><Run Text="s)"></Run>
                                    </TextBlock>
                                    <Button x:Name="clock_img" Height="18" Width="18" Margin="0,0,0,0" VerticalAlignment="Center" 
                                                        Style="{StaticResource TimerButton}" IsEnabled="True"  ToolTip="{Binding RemainingTime}" MouseEnter="clock_img_MouseEnter" MouseLeave="clock_img_MouseLeave">
                                    </Button>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FirmFlag}" Value="0"/>
                                            <Condition Binding="{Binding IsPoint}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FirmFlag}" Value="1"/>
                                            <Condition Binding="{Binding IsPoint}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                    <DataTrigger  Binding="{Binding IsPoint}" Value="1">
                                        <Setter TargetName="point_txt" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding RemainSeconds}" Value="0">
                                        <Setter TargetName="point_txt" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding RemainSeconds}" Value="1">
                                        <Setter TargetName="point_txt" Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding RemainSeconds}" Value="2">
                                        <Setter TargetName="point_txt" Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding RemainSeconds}" Value="3">
                                        <Setter TargetName="point_txt" Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding RemainSeconds}" Value="4">
                                        <Setter TargetName="point_txt" Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding RemainSeconds}" Value="5">
                                        <Setter TargetName="point_txt" Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding ordstatus}" Value="4">
                                        <Setter TargetName="point_txt" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding ordstatus}" Value="8">
                                        <Setter TargetName="point_txt" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger  Binding="{Binding ordstatus}" Value="2">
                                        <Setter TargetName="point_txt" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding ExecType,ConverterParameter=ordstatus, Converter={StaticResource EnumTypeConvertor}}" Header="状态" Width="Auto" MinWidth="50"/>
                    <DataGridTextColumn Binding="{Binding ordertype}" Header="订单类型" Width="Auto"  MinWidth="80"/>
                    <DataGridTextColumn Binding="{Binding Price,Converter={StaticResource numConvertor},ConverterParameter=''}" Header="报价(%)" Width="Auto" MinWidth="60" CellStyle="{StaticResource ColumnColorStyle}"/>
                    <!--<DataGridTextColumn Binding="{Binding NetPrice,StringFormat={}{0:N4}}" Header="净价(元)" Width="Auto" MinWidth="60" FontWeight="SemiBold"/>-->
                    <!--<DataGridTextColumn Binding="{Binding WholeFlag, ConverterParameter=wholeflag, Converter={StaticResource EnumTypeConvertor}}" Header="整量" Width="Auto" MinWidth="80"/>-->
                    <!--<DataGridTextColumn Binding="{Binding warningStatus}" Header="warningStatus" Width="Auto" MinWidth="80">
                                </DataGridTextColumn>-->
                    <DataGridTemplateColumn Header="报量(万元)" Width="Auto" MinWidth="80" CellStyle="{StaticResource DataGridCellStyle1}"
                                                        ClipboardContentBinding="{Binding Qty}" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border x:Name="warningTag" Background="Transparent" Width="6" Height="6" CornerRadius="3" DockPanel.Dock="Left"></Border>
                                    <TextBlock Text="{Binding Qty}"/>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding warningStatus}" Value="1">
                                        <Setter TargetName="warningTag" Property="Background" Value="#F9C152"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--<DataGridTextColumn Binding="{Binding DealingQty}" Header="已处理(万元)" Width="Auto" MinWidth="80"/>-->
                    <DataGridTextColumn Binding="{Binding ExecQty,Converter={StaticResource numConvertor}}" Header="已成交(万元)" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Binding="{Binding PartySubName}" Header="本方交易员" Width="Auto" MinWidth="80"/>

                    <!--<DataGridTextColumn Binding="{Binding OrdType}" Header="报价方式" Width="Auto"  MinWidth="70"/>-->
                    <DataGridTextColumn Binding="{Binding Veneues,ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" Header="报价方式" Width="Auto" MinWidth="50"/>
                    <DataGridTextColumn Binding="{Binding CrossVenues,ConverterParameter=crossvenues, Converter={StaticResource EnumTypeConvertor}}" Header="撮合范围" Width="Auto"  MinWidth="70"/>

                    <DataGridTextColumn Binding="{Binding QuantID}" Header="策略名" Width="Auto"  MinWidth="70"/>
                    <DataGridTextColumn Binding="{Binding VenuesSelectDisplay}" Header="渠道" Width="Auto"  MinWidth="70"/>

                    <!--<DataGridTextColumn Binding="{Binding VenuesSelectF}" Header="VenuesSelectF" Width="Auto"  MinWidth="70"/>
                                <DataGridTextColumn Binding="{Binding VenuesRdmNum}" Header="VenuesRdmNum" Width="Auto"  MinWidth="70"/>
                                <DataGridTextColumn Binding="{Binding SelfSelectVenues}" Header="SelfSelectVenues" Width="Auto"  MinWidth="70"/>-->

                    <DataGridTextColumn Binding="{Binding STCCode}" Header="STC单号" Width="Auto"  MinWidth="135"/>
                    <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" Header="最后更新时间" Width="Auto" MinWidth="60"
                                                    Foreground="{StaticResource DataGrid.SubTitle.Foreground}" 
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}" 
                                                    CellStyle="{StaticResource DataGridTextRightStyle}"/>
                    <DataGridTemplateColumn Header="客户机构" Width="Auto" MinWidth="70" SortMemberPath="InstitutionName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="InsName_display" Foreground="#FFFFFF" Text="{Binding InstitutionName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstitutionName}"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="客户名" Width="Auto"  MinWidth="70" SortMemberPath="TraderName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="TrdNameLb_display" Foreground="#FFFFFF" Text="{Binding TraderName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TraderName}"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="xxxx"/>
                </DataGrid.Columns>
