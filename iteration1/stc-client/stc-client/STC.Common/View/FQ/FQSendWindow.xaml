<commComp:WindowBase x:Class="STC.Common.View.FQ.FQSendWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.FQ"
             xmlns:commComp="clr-namespace:STC.Common.View.Component"
             mc:Ignorable="d" Title="推送" MaxboxEnable="False" MinboxEnable="False"
             ResizeMode="NoResize" Width="674" Height="398" 
             d:DesignHeight="350" d:DesignWidth="500" Loaded="FQSendWindow_Loaded">
    <Window.Resources>
        <ControlTemplate x:Key="ib" TargetType="{x:Type Button}">
            <TextBlock x:Name="txtI" Cursor="Hand" Text="{TemplateBinding Content}" Foreground="#888C8A" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#4587F0"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="qq_part" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="TraderTB" Text="机构/交易员:" Margin="8 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#8F9598"/>
            <commComp:MultiSelectComboBox x:Name="TraderCbb" Width="240" Height="22" Margin="10 0 0 0" HorizontalAlignment="Left" 
                                      VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" 
                                      DefaultText="不限"
                                      IsEditable="True">
            </commComp:MultiSelectComboBox>

            
        </StackPanel>

        <StackPanel x:Name="yc_qq_part" Orientation="Horizontal" VerticalAlignment="Center"  Visibility="Collapsed">
            <TextBlock x:Name="TraderTB_YC" Text="机构:" Margin="8 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#8F9598"/>
            <commComp:MultiSelectComboBox x:Name="TraderCbb_YC" Width="240" Height="22" Margin="10 0 0 0" HorizontalAlignment="Left"
                                      VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" 
                                      DefaultText="不限"
                                      IsEditable="True">
            </commComp:MultiSelectComboBox>
        </StackPanel>

        <Button x:Name="settingBtn" Width="16" Height="16" HorizontalAlignment="Right" Margin="0 0 12 0" Style="{DynamicResource MainPageImageSettingButton}" Click="settingBtn_Click"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="option_part" Orientation="Horizontal" VerticalAlignment="Center">
                <!--<TextBlock Text="加减点" VerticalAlignment="Center" Margin="8 0 0 0"/>-->
                <TextBlock Text="Bid:" VerticalAlignment="Center" Margin="8 0 0 0" Foreground="#ED6D00"/>
                <Button x:Name="bp1_bid" Content="+0.25bp" Height="24" Width="52" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="bp_bid_Click"/>
                <Button x:Name="bp2_bid" Content="+0.5bp" Height="24" Width="52" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="bp_bid_Click"/>
                <Button x:Name="bp3_bid" Content="+1bp" Height="24" Width="52" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="bp_bid_Click"/>
                <Button x:Name="bid" Content="bid" Height="24" Width="36" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="bp_bid_Click"/>
                <TextBlock Text="Ofr:" VerticalAlignment="Center" Margin="16 0 0 0" Foreground="#007FFF"/>
                <Button x:Name="bp1_ofr" Content="-0.25bp" Height="24" Width="52" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="bp_ofr_Click"/>
                <Button x:Name="bp2_ofr" Content="-0.5bp" Height="24" Width="52" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="bp_ofr_Click"/>
                <Button x:Name="bp3_ofr" Content="-1bp" Height="24" Width="52" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="bp_ofr_Click"/>
                <Button x:Name="ofr" Content="ofr" Height="24" Width="36" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="bp_ofr_Click"/>

                <TextBlock Text="报量:" VerticalAlignment="Center" Margin="16 0 0 0" Foreground="#8F9598"/>
                <Button x:Name="qty" Content="--" Height="24" Width="42" Margin="2 0 0 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="qty_Click"/>
            </StackPanel>

            <Button x:Name="resettingBtn" Content="恢复默认" Grid.Column="1" Height="24" Width="60" Margin="46 0 10 0" Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0" Foreground="#D7D7D7" Click="resettingBtn_Click"/>
        </Grid>

        <StackPanel x:Name="yc_option_part" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="推送方向:" VerticalAlignment="Center" Margin="16 0 0 0" Foreground="#FFFFFF"/>
            <RadioButton x:Name="push_all_chk" Content="全部推送" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#FFFFFF" Margin="10 0 0 0" IsChecked="True"/>
            <RadioButton x:Name="push_bid_chk" Content="只推Bid" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#ED6D00"  Margin="20 0 0 0"/>
            <RadioButton x:Name="push_ofr_chk" Content="只推Ofr" Style="{StaticResource  DefaultRadioButtonStyle}" Foreground="#007FFF"  Margin="20 0 0 0"/>
        </StackPanel>

        <!--<TextBox x:Name="contentTxt" Grid.Row="2" TextWrapping="Wrap" Height="120" Width="552" Style="{DynamicResource STCDefaultBoxStyle}" 
                 HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="2"/>-->

        <RichTextBox x:Name="rtb" Grid.Row="2" Background="black" FontWeight="Bold" Padding="2" IsReadOnly="true" Height="236" Width="658" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#3C3C3C"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <!--<RichTextBox.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute"/>
                <CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute"/>
            </RichTextBox.CommandBindings>
            <FlowDocument x:Name="fd" LineHeight="4">

            </FlowDocument>-->
        </RichTextBox>

        <Button x:Name="SendBtn" Content="发送" Grid.Row="3" Width="100" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0"  Foreground="#D7D7D7" Click="SendBtn_Click"/>
        <Button x:Name="CopyBtn" Content="复制" Grid.Row="3" Width="100" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{DynamicResource SlateGrayStyle}" BorderThickness="0 1 0 0"  Foreground="#D7D7D7" Click="CopyBtn_Click" Visibility="Collapsed"/>
    </Grid>
</commComp:WindowBase>
