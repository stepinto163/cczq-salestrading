<Window x:Class="STC.Common.View.Drp.Component.Broker.BrokerMessageBoxGUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
        x:Name="系统提示" mc:Ignorable="d" Loaded="sysWarnGUI_Loaded" Window.SizeToContent="Height" MinHeight="150"
        Title="系统提示" Height="150" Width="300"  Background="#141414"  ResizeMode="CanResize" WindowStartupLocation="CenterScreen" 
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" BorderThickness="1" BorderBrush="#282828">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <DockPanel x:Name="dpMain" LastChildFill="True" >
        <Grid x:Name="gTitle" DockPanel.Dock="Top"  Height="30"  Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="tbTitle" x:FieldModifier="public" Text="系统提示" Margin="10,0,0,0" Grid.Column="0" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="12px"></TextBlock>
            <Button x:Name="btnClose" Grid.Column="2"  Margin="0,0,0,0" Style="{DynamicResource DrpImageCloseButton}" Width="24" Height="24" Click="Button_Click" IsCancel="True"></Button>
        </Grid>
        <Grid x:Name="gDetail" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ed:RegularPolygon Fill="#DE8E0B" Grid.Row="0" Grid.Column="1" InnerRadius="1" PointCount="3" Stretch="Fill" Stroke="#DE8E0B" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="!" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="16" Margin="0" Padding="0"></TextBlock>
            <TextBlock x:Name="tbMsg" x:FieldModifier="public" Padding="25, 0, 0, 0" Margin="0,10,0,10" Text="请确认价格4.0645 GVN" Width="220" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"  TextWrapping="Wrap" FontSize="12px" Foreground="#FFFFFF"/>

            <Grid Grid.Row="1" Grid.Column="2" Margin="0, 0, 0, 10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCloseB" Content="取消" Grid.Column="0" HorizontalAlignment="Center" Width="80" Height="22" Margin="0 0 5 0"
                        FontFamily="{StaticResource DefaultFont}"  FontSize="12px" Foreground="#FFEBC8" 
                        Style="{DynamicResource CancelButtonStyle}" Click="Button_Click" IsDefault="False"/>
                <Button x:Name="btnOK" Content="确认" Grid.Column="1" HorizontalAlignment="Left" Width="93" Height="22" 
                        FontFamily="{StaticResource DefaultFont}"  FontSize="{StaticResource NormalContentFontSize}" Foreground="#FFEBC8"
                        Style="{DynamicResource ConfirmButtonStyle}" Click="btnOK_Click" IsDefault="true"/>

            </Grid>

        </Grid>

    </DockPanel>
</Window>
