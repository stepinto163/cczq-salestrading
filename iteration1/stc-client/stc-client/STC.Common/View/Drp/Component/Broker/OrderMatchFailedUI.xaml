                                            UseLayoutRounding="True" VerticalAlignment="Center"  HorizontalAlignment="Center" Fill="{TemplateBinding Foreground}"/>
                                    </Viewbox>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <!--<Setter Property="Background" TargetName="background" Value=""/>-->
                                    <!--<Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource  SvgButton.Static.Foreground}"/>-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{DynamicResource  SvgButton.MouseOver.Background}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource  SvgButton.Static.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource ImageButton.Disabled.Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border DockPanel.Dock="Top" BorderThickness="2,2,2,0" x:Name="Border_Left1" Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="#8F9598"  Background="{StaticResource ColorBrush.Gray18}">
            <Grid x:Name="gTitle" Height="30" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Title" Text="我的客户发来意向" Margin="10,0,0,0" 
                           FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                           FontSize="14" Foreground="{StaticResource ColorBrush.White2}" Grid.Column="0" VerticalAlignment="Center" />
                <Button x:Name="btnClose" Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource DrpImageCloseButton}" Width="20" Height="20" IsCancel="True"/>

            </Grid>
        </Border>
        <Border BorderThickness="2, 0, 2, 2" x:Name="Border_Left2" CornerRadius="0,0,4,4" Grid.Row="1"
                BorderBrush="#8F9598" 
                Background="{StaticResource ColorBrush.Gray13}">
            <StackPanel x:Name="spDetail" Background="{Binding BGBackground}">
                <Grid x:Name="grid1" Margin="15,10,15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="tbGoodsCode" Grid.Column="0" FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}" FontSize="20px" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Yellow}"  Text="{Binding SecurityID}"></TextBlock>
                    <TextBlock x:Name="tbSymbol" Grid.Column="1" Margin="10,0,0,0"  FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}"  FontSize="20px" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Yellow}" Text="{Binding Symbol}"></TextBlock>
                    <TextBlock x:Name="tbUpdateTime" Grid.Column="3" FontFamily="{StaticResource FontFamily.Roboto}" FontSize="14px" Foreground="{StaticResource ColorBrush.PaleGrey}" Text="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}"></TextBlock>
                </Grid>
                <StackPanel x:Name="stackPanel1" Orientation="Vertical" Grid.Row="1" Margin="16,0,15,10">
                    <Grid x:Name="gFirst" Margin="0,15,0,15" Visibility="Visible" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="tbABroker" Text="{Binding TraderName}" Grid.Column="0" Style="{StaticResource PTSelfBrokerTextBlockStyle}" 
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbSide" Margin="10,0,0,0" Grid.Column="1" 
                                    Text="{Binding Side,ConverterParameter=side2, Converter={StaticResource EnumTypeConvertor}}"
                                    Style="{StaticResource PTSideTextBlockStyle}">
                        </TextBlock>

                        <TextBlock x:Name="tbBTraderInfo"  Grid.Column="2" Margin="10,0,0,0"  Style="{StaticResource PTInstBrokerTextBlockStyle}"  
                                    TextTrimming="CharacterEllipsis" Text="{Binding CounterPartyInstitutionName}" MaxWidth="180">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbBBroker" Grid.Column="3" Text="{Binding CounterPartyTraderName}"  
                                Margin="10,0,0,0" Style="{StaticResource PTOtherBrokerTextBlockStyle}"></TextBlock>

                    </Grid>
                    <StackPanel x:Name="spRejectInfo" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/STC.Common;component/Images/stc-status-yellow.png" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBlock x:Name="tbMsg" FontFamily="{StaticResource DefaultFont}" FontSize="16" 
                                   Foreground="{StaticResource ColorBrush.White2}" Height="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{Binding Msg}"></TextBlock>
                    </StackPanel>
                    <!--<TextBlock x:Name="tbMsg" Margin="0,10,0,10" FontFamily="{StaticResource DefaultFont}" FontSize="16" 
                               Text="{Binding Msg}"   
                               Foreground="{Binding ColorBrush.White2}" FontWeight="Bold"  HorizontalAlignment="Center"></TextBlock>-->

                    <StackPanel x:Name="spMain" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 20 0 10">
                        <TextBlock  FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="14" Foreground="{StaticResource ColorBrush.Gray14}" VerticalAlignment="Center">
                            <Run>未分配报价</Run>           
                            <!--<Run x:Name="tbPrice" FontFamily="{StaticResource DefaultFont}" 
                                 FontWeight="Bold" FontSize="16px" Text="{Binding Price,Converter={StaticResource numConvertor},ConverterParameter=''}"                                 
                                 Foreground="{StaticResource ColorBrush.Orange5}"></Run>-->
                        </TextBlock>
                        <TextBlock  Margin="2,0,5,0" FontFamily="{StaticResource DefaultFont}" HorizontalAlignment="Left" 
                                    Text="{Binding Price,Converter={StaticResource numConvertor},ConverterParameter=''}"
                                    FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#ED6D00"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Side}" Value="2">
                                            <Setter Property="Foreground" Value="#0082D8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HandlInst}" Value="1">
                                            <Setter Property="Foreground" Value="#00FFB4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="lbSide"
                               Margin="10,0,2,0"
                               FontFamily="{StaticResource DefaultFont}"
                               FontSize="14"
                               FontWeight="Bold"
                               Height="20" Text="{Binding Side,ConverterParameter=side, Converter={StaticResource EnumTypeConvertor}}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#ED6D00"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Side}" Value="2">
                                            <Setter Property="Foreground" Value="#0082D8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!--<Label x:Name="lbSide"
                               Foreground="{StaticResource ColorBrush.Orange5}"
                               Margin="10,0,2,0"
                               BorderThickness="0"
                               Padding="2"
                               VerticalContentAlignment="Center"
                               FontFamily="{StaticResource DefaultFont}"
                               FontSize="14"
                               FontWeight="Bold"
                               Height="20" Content="{Binding Side,ConverterParameter=side, Converter={StaticResource EnumTypeConvertor}}"></Label>-->
                        <TextBlock  FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="14" Foreground="{StaticResource ColorBrush.Gray14}" VerticalAlignment="Center">            
                            <Run>还有</Run>
                            <Run x:Name="tbCount" Text="{Binding Count}" Foreground="{DynamicResource ColorBrush.Yellow}"></Run>
                            <Run >笔</Run>
                            <Run>原因：</Run>
                        </TextBlock>
                        <TextBlock x:Name="tbWholeFlag" 
                                   Padding="0,3,0,3"
                                   FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                                   FontSize="14" 
                                   Foreground="{StaticResource ColorBrush.White2}" 
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="60"
                                   Text="{Binding WholeFlag}">
                        <TextBlock.ToolTip>
                            <ToolTip Content="{Binding Path=Text}"></ToolTip>
                        </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="tbReason" 
                                   Padding="0,3,0,3"
                                   FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                                   FontSize="14" 
                                   Foreground="{StaticResource ColorBrush.Gray14}" 
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="80"
                                   Text="{Binding RejectText}">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip></TextBlock>
                        <Button x:Name="detailbtn" BorderThickness="0" 
                                VerticalAlignment="Center" Margin="20 0 0 5" HorizontalAlignment="Left" 
                                Style="{StaticResource detailButton}" Command="{Binding DetailCommand}" ToolTip="查看"></Button>
                        <!--<Button x:Name="btnDetail" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CommonButtonStyle}" Foreground="#FFEBC8" Background="#136C5E" Height="22" Width="44" Click="btnDetail_Click">查看</Button>-->
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
