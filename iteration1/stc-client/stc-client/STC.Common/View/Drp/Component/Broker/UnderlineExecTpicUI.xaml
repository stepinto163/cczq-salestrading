<UserControl x:Class="STC.Common.View.Drp.Component.Broker.UnderlineExecTpicUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Drp.Component.Broker"
             xmlns:fcon="clr-namespace:STC.Common.Convertor"
             mc:Ignorable="d" 
            d:DesignHeight="300" d:DesignWidth="300" MinWidth="445" KeyDown="UserControl_KeyDown" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <fcon:FormatDateTimeConvertor x:Key="FormatDateTimeConvertor"/>
            <fcon:BrokerSettleTypeConverter x:Key="BrokerSettleTypeConverter"/>
            <fcon:NumberConvertor x:Key="numConvertor"/>
            <Style x:Key="TBSmallStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"></Setter>
                <Setter Property="FontSize" Value="14px"></Setter>
                <Setter Property="Foreground" Value="#D7D7D7"></Setter>
                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 标题区 -->
        <Border Grid.Row="0" BorderThickness="2,2,2,0"
                x:Name="Border_Left1"  CornerRadius="4,4,0,0" 
                BorderBrush="#8F9598"  
                Background="{StaticResource ColorBrush.Gray18}">
            <Grid x:Name="gTitle" Height="26" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="线下成交单" Margin="10,0,0,0"  
                           FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                           FontSize="14" Foreground="{StaticResource ColorBrush.White2}" Grid.Column="0" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="btnClose" Margin="0,0,10,0" Style="{StaticResource DrpImageCloseButton}" Width="20" Height="20" IsCancel="True"/>

            </Grid>
        </Border>
        <!-- 主内容区 -->
        <Border BorderThickness="2, 0, 2, 0" Grid.Row="1"
                x:Name="Border_Left2" CornerRadius="0,0,0,0" 
                BorderBrush="#8F9598" 
                Background="{StaticResource ColorBrush.Gray13}">
            <Grid x:Name="gMain" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid x:Name="gInfo" Margin="15,10,15,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="tbGoodsCode" Grid.Column="0" FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}" FontSize="20px" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Yellow}"  Text="{Binding SecurityID}"></TextBlock>
                    <TextBlock x:Name="tbSymbol" Grid.Column="1" Margin="10,0,0,0"  FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}"  FontSize="20px" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Yellow}" Text="{Binding Symbol}"></TextBlock>
                    <TextBlock x:Name="tbUpdateTime" Grid.Column="3" FontFamily="{StaticResource FontFamily.Roboto}" FontSize="14px" Foreground="{StaticResource ColorBrush.PaleGrey}" Text="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}"></TextBlock>
                </Grid>
                <StackPanel x:Name="spDetail" Orientation="Vertical" Grid.Row="1" Margin="16,0,15,10">
                    <Grid x:Name="gFirst" Margin="0,15,0,15" Visibility="Visible" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="tbTraderAInfo" Grid.Column="0" TextTrimming="CharacterEllipsis" 
                                   Text="{Binding InstitutionName}" Style="{StaticResource TBSmallStyle}" Margin="0, 0, 20, 0" MaxWidth="180">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="tbABroker" Text="{Binding TraderName}" Grid.Column="1" Style="{StaticResource TBSmallStyle}" MaxWidth="80"
                                   TextTrimming="CharacterEllipsis" >
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbSide" Margin="20,0,0,0" Grid.Column="2" 
                                       Text="{Binding Side}"
                                       Style="{StaticResource TBSmallStyle}" Foreground="#ED6D00">
                        </TextBlock>

                        <TextBlock x:Name="tbTraderBInfo" Grid.Column="4" Text="{Binding CounterPartyInstitutionName}" 
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource TBSmallStyle}" Margin="10, 0, 0, 0" MaxWidth="110">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbBBroker" Grid.Column="5" Text="{Binding CounterPartyTraderName}"  
                                   Margin="10,0,0,0" Style="{DynamicResource PTSelfBrokerTextBlockStyle}" FontWeight="Bold" Foreground="#FF9D61" MaxWidth="60"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="tbBrokerAMsg" Grid.Column="0" Text="线下单信息" 
                           FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="14" Foreground="{StaticResource ColorBrush.Gray14}" 
                           VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock x:Name="tbClickPrice" Margin="10,0,10,0" Grid.Row="0" Grid.Column="1"  Text="{Binding Price,Converter={StaticResource numConvertor},ConverterParameter=''}" 
                           FontFamily="{StaticResource DefaultFont}" FontWeight="Bold" FontSize="20" 
                           Foreground="{StaticResource ColorBrush.Orange5}" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock x:Name="tbQuoteQty" Foreground="{StaticResource ColorBrush.Yellow}" Grid.Column="2" Text="{Binding OrderQty}"
                               FontFamily="{StaticResource DefaultFont}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"></TextBlock>
                        <TextBlock x:Name="tbBClickSettlType" Margin="10,0,0,0" Grid.Column="3"  Text="{Binding SettleAllDisplay}" TextWrapping="WrapWithOverflow"
                                    FontFamily="{StaticResource DefaultFont}" Foreground="{StaticResource ColorBrush.White-1}"
                                    FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>

                </StackPanel>

            </Grid>
        </Border>
        <!-- 分割线 -->
        <Border Grid.Row="2" BorderThickness="2, 0, 2, 0" CornerRadius="0,0,0,0" BorderBrush="#8F9598" Background="{DynamicResource ColorBrush.Gray13}" >
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Main.BorderBrush}" Visibility="{Binding ButtonVisible,Converter={StaticResource visibilityConvertor}}"></Border>
        </Border>
        <!-- 提交 -->
        <Border BorderThickness="2, 0, 2, 2" Grid.Row="3"
                CornerRadius="0,0,4,4" 
                BorderBrush="#8F9598" 
                Background="{StaticResource ColorBrush.Gray13}">
            <Button Margin="0,10,0,10" x:Name="btnOK" Content="我知道了" FontFamily="Microsoft YaHei" Foreground="#D7D7D7" FontWeight="SemiBold" FontSize="12px" 
                        Background="#136C5E" Width="100" BorderThickness="0 1 0 0" Height="29"  Style="{StaticResource ConfirmButtonStyle}" Command="{Binding OkCommand}"></Button>
        </Border>
    </Grid>
</UserControl>
