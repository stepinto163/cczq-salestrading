<UserControl x:Class="STC.Common.View.Drp.Component.Broker.UnMatchReasonUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Drp.Component.Broker"
             mc:Ignorable="d" 
             x:Name="ucUnMatchReasonUI" d:DesignHeight="28" d:DesignWidth="350" Background="Transparent" Margin="0" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="LabelStyle1" TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Label}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="5" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="spMain" Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock  FontFamily="{StaticResource DefaultFont}" Foreground="#FFEBC8" Padding="0,3,0,3" VerticalAlignment="Center" FontSize="12px">
            <Run>未匹配报价:</Run>           
            <Run x:Name="tbPrice" Foreground="#F9C66E" FontSize="14" FontWeight="Bold">5.95</Run>
        </TextBlock>
        <Label Background="#E06E00" 
               x:Name="lbSide"
               Foreground="#FFFFFF" 
               Margin="5,0,5,0"
               BorderThickness="0"
               Padding="3"
               VerticalContentAlignment="Center"
               FontFamily="{StaticResource DefaultFont}"
               FontSize="12"
               Height="18"
               Style="{DynamicResource LabelStyle1}">Offer</Label>
        <TextBlock  FontFamily="{StaticResource DefaultFont}" Foreground="#FFEBC8" Padding="0,3,0,3" VerticalAlignment="Center" FontSize="12px">            
            <Run>还有</Run>
            <Run x:Name="tbCount">2</Run>
            <Run >笔，原因：</Run>
        </TextBlock>
        <TextBlock x:Name="tbReason" 
                   Padding="0,3,0,3"
                   FontFamily="{StaticResource DefaultFont}"
                   FontSize="12"
                   Foreground="#FFEBC8" 
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="60"
                   Text="同机构">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip></TextBlock>
        <Button x:Name="btnDetail" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CommonButtonStyle}" Foreground="#FFEBC8" Background="#136C5E" Height="22" Width="44" Click="btnDetail_Click">查看</Button>
    </StackPanel>
</UserControl>
