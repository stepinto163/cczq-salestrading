<UserControl x:Class="STC.Common.View.Drp.Component.Broker.AmountUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Drp.Component.Broker"
             mc:Ignorable="d" 
             x:Name="ucAmountUI" d:DesignHeight="55" d:DesignWidth="170" MinWidth="170px" Height="45px" Foreground="#FFEBC8" BorderThickness="0">
    <Grid x:Name="gMain" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="15"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="tbAmount" Grid.Row="0" Grid.Column="0" Text="5" Margin="0" 
                 FontFamily="{StaticResource DefaultFont}" FontSize="24px" 
                 HorizontalAlignment="Stretch" BorderThickness="1" Height="30"   
                 VerticalAlignment="Center" Background="#0E1A18" 
                 Style="{StaticResource  DefaultTextBoxStyle}" 
                 TextChanged="tbAmount_TextChanged" InputMethod.IsInputMethodEnabled="False" 
                 PreviewTextInput="tbAmount_PreviewTextInput" ContextMenu="{x:Null}" 
                 PreviewKeyDown="tbAmount_PreviewKeyDown"></TextBox>
        <TextBlock Text="kw" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{StaticResource DefaultFont}" Foreground="#FFFFFF" Opacity="0.5"></TextBlock>
        <Button x:Name="btnSubtraction" Grid.Row="0" Grid.Column="1" Content="-" BorderThickness="0" FontFamily="{StaticResource DefaultFont}"  FontSize="18px" Margin="10,0,0,0" Background="#3C3C3C"  Width="37px" Height="30px" Style="{StaticResource ConfirmButtonStyle}" Click="btnSubtraction_Click"/>
        <Button x:Name="btnAdd" Grid.Row="0" Grid.Column="2" Content="+" BorderThickness="0" FontFamily="{StaticResource DefaultFont}"  FontSize="18px" Margin="5,0,0,0" Background="#3C3C3C" Width="37px" Height="30px" Style="{StaticResource ConfirmButtonStyle}" Click="btnAdd_Click"/>
    </Grid>
</UserControl>
