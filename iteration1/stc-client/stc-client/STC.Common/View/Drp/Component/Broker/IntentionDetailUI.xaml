    <Grid x:Name="gGrid" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid x:Name="gFirst" Margin="0,25,0,5" Visibility="Visible" VerticalAlignment="Center" Grid.Row="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"></ColumnDefinition>
                <ColumnDefinition Width="60"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="tbBTraderInfo"  Grid.Column="0" Style="{DynamicResource PTInstBrokerTextBlockStyle}"  HorizontalAlignment="Left"
                                TextTrimming="CharacterEllipsis" Text="{Binding CounterPartyInstitutionName}" MaxWidth="180">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <TextBlock x:Name="tbBBroker" Grid.Column="1" Text="{Binding CounterPartyTraderName}"  
                                Margin="10,0,0,0" HorizontalAlignment="Left"
                                TextTrimming="CharacterEllipsis">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
                        <Setter Property="FontSize" Value="14px"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BrokerAIsMe}" Value="1">
                                <Setter Property="Foreground" Value="#00CDAD"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="tbQuoteQty" Foreground="{StaticResource ColorBrush.Yellow}" Grid.Column="2" Text="{Binding DayOrderQty}"
                    FontFamily="{StaticResource DefaultFont}" FontSize="14" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"></TextBlock>
            <TextBlock x:Name="tbClickBSettlType" Margin="0,0,5,0" Grid.Column="3"  Text="{Binding DaySettlType, Converter={StaticResource BrokerSettleTypeConverter},ConverterParameter='popup'}" 
                            FontFamily="{StaticResource DefaultFont}" Foreground="{StaticResource ColorBrush.White-1}" 
                            FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
            <StackPanel  x:Name="spQuoteTag" Margin="0,0,5,0" Grid.Column="4"  VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="ocoflagshowbtn" BorderThickness="0" Margin="2 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                        Style="{StaticResource ocoButton}" Visibility="{Binding OCOVisible, Converter={StaticResource visibilityConvertor}}" ToolTip="oco">
                </Button>

                <Button x:Name="packageflagshowbtn" BorderThickness="0" Margin="2 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                            Style="{StaticResource packageButton}" Visibility="{Binding PackageVisible, Converter={StaticResource visibilityConvertor}}" ToolTip="打包">
                </Button>

                <Button x:Name="onestarButtonshowbtn" BorderThickness="0" Margin="2 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                                    Style="{StaticResource onestarButton}" Visibility="{Binding XVisible, Converter={StaticResource visibilityConvertor}}" ToolTip="需请示">
                </Button>

                <Button x:Name="twostarButtonshowbtn" BorderThickness="0" Margin="2 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                                    Style="{StaticResource twostarButton}" Visibility="{Binding XXVisible, Converter={StaticResource visibilityConvertor}}" ToolTip="必须请示">
                </Button>

                <Button x:Name="switchbtn" BorderThickness="0" VerticalAlignment="Center" Margin="2 0 0 0" HorizontalAlignment="Left"
                                                                        Style="{StaticResource exchangeButton}" Visibility="{Binding SwitchVisible, Converter={StaticResource visibilityConvertor}}" ToolTip="换券">
                </Button>
            </StackPanel>
            <TextBlock x:Name="tbContent" Grid.Column="5"
                            Margin="0,0,50,0" FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                            Foreground="{StaticResource ColorBrush.Gray14}" FontSize="14" 
                            VerticalAlignment="Center" 
                            Text="{Binding DayComment}" MaxWidth="100" TextAlignment="Left" TextTrimming="CharacterEllipsis">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </Grid>
        <Border Grid.Row="1" CornerRadius="0,0,0,0" BorderBrush="#8F9598" Background="{DynamicResource ColorBrush.Gray13}"  Margin="0 15 0 0">
            <Border BorderThickness="0,0,0,0" BorderBrush="{DynamicResource Main.BorderBrush}"></Border>
        </Border>
    </Grid>
</UserControl>
