        <ResourceDictionary>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:FormatDateTimeConvertor x:Key="FormatDateTimeConvertor"/>
            <fcon:BrokerSettleTypeConverter x:Key="BrokerSettleTypeConverter"/>
            <fcon:BooleanConvertor x:Key="booleanConvertor"/>
