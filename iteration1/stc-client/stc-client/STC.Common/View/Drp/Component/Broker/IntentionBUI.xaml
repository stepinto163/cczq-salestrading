                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource  SvgButton.Static.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource ImageButton.Disabled.Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid  Background="{StaticResource ColorBrush.Gray13}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 标题区 -->
        <Border BorderThickness="2,2,2,0" Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="#8F9598" Background="{StaticResource ColorBrush.Gray18}">
            <Grid x:Name="gTitle" Height="28" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Title" Text="我的客户被点价" Margin="10,0,0,0"  
                                   FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                                   FontSize="14" Foreground="{StaticResource ColorBrush.White2}" Grid.Column="0" VerticalAlignment="Center" />
                <!--TextBlock x:Name="LabMsgId" Text="{Binding MsgId}" ToolTip="{Binding MsgId}" FontSize="14" Foreground="{StaticResource ColorBrush.White2}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/-->
                <Button x:Name="btnClose" Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource DrpImageCloseButton}" Width="20" Height="20" IsCancel="True"/>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <Border BorderThickness="2, 0, 2, 2"  CornerRadius="0,0,2,2" Grid.Row="1" BorderBrush="#8F9598" Background="{Binding BGBackground}">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--债券信息，更新时间，点价信息-->
                <Border Grid.Row="0" BorderBrush="#8F9598">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="tbGoodsCode" VerticalAlignment="Center" Grid.Column="0" Margin="10 0 0 0" FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}" FontSize="20px" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Yellow}"  Text="{Binding SecurityID}"></TextBlock>

                        <TextBlock x:Name="tbSymbol" VerticalAlignment="Center" Grid.Column="1" Margin="10,0,0,0" MaxWidth="218"  TextTrimming="WordEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}"  FontSize="20px" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Yellow}" Text="{Binding Symbol}"></TextBlock>
                
                        <TextBlock x:Name="tbUpdateTime" VerticalAlignment="Center" Grid.Column="3" Margin="0 0 16 0" Width="54" FontFamily="{StaticResource FontFamily.Roboto}" FontSize="14px" Foreground="{StaticResource ColorBrush.PaleGrey}" Text="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}"></TextBlock>
                    </Grid>
                </Border>

                <!--上分割线-->
                <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0,0,0,0" BorderBrush="#208F9598" Background="{DynamicResource ColorBrush.Gray13}">
                </Border>

                <!-- 主内容区 #8F9598 -->
                <Border  Grid.Row="2" CornerRadius="0 0 4 4" BorderThickness="0" MaxHeight="891">
                    <!-- 表格用于显示点价反馈信息 -->
                    <!-- Datagrid列表 -->
                    <DataGrid x:Name="dgQtyList" ItemsSource="{Binding FeedBackQuotations}"
                                HeadersVisibility="None" BorderThickness="0" BorderBrush="#cde0fa" Background="Transparent"  Margin="10 0 0 0" AutoGenerateColumns="False" SelectionUnit="FullRow"  SelectionMode="Single" CanUserAddRows="False"
                                VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"  IsReadOnly="False" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Style="{DynamicResource DrpDefaultDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Red" BorderThickness="0" Width="412">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                    <RowDefinition></RowDefinition>
                                                </Grid.RowDefinitions>
                                                
                                                <!--第一行 报价信息，方向 发送按钮-->
                                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="70"></ColumnDefinition>
                                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                                        <ColumnDefinition Width="48"></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="24"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                        <RowDefinition Height="Auto"></RowDefinition>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock x:Name="tbABroker" Text="{Binding TraderName}" Grid.Column="0" MaxWidth="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Margin" Value="0"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
                                                                <Setter Property="FontSize" Value="14px"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                                        <Setter Property="Foreground" Value="#00CDAD"></Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock x:Name="tbSide" Margin="10,0,0,0" Grid.Column="1" Text="{Binding Side,ConverterParameter=side2, Converter={StaticResource EnumTypeConvertor}}" Style="{StaticResource PTSideTextBlockStyle}">
                                                    </TextBlock>


                                                    <TextBlock x:Name="tbBTraderInfo"  Grid.Column="2" Margin="10,0,0,0" MaxWidth="130" Style="{DynamicResource PTInstBrokerTextBlockStyle}"  TextTrimming="WordEllipsis" Text="{Binding CounterPartyInstitutionName}" HorizontalAlignment="Left" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                                    </TextBlock>

                                                    <TextBlock x:Name="tbBBroker" Grid.Column="3" Text="{Binding CounterPartyTraderName}" Width="70" Margin="6,0,0,0" Style="{DynamicResource PTSelfBrokerTextBlockStyle}" TextTrimming="WordEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button  BorderThickness="0" Width="24" VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding DataContext.AutoCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" CommandParameter="{Binding ExecID}"  Style="{StaticResource autoButton}" ToolTip="自动发送" IsEnabled="{Binding AutoEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource booleanConvertor}}">
                                                        </Button>
                                                        <Button  BorderThickness="0" Width="24" VerticalAlignment="Center" Margin="0 -5 0 0" HorizontalAlignment="Left" Style="{StaticResource manualButton}" ToolTip="手动发送" Command="{Binding DataContext.ManualCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" CommandParameter="{Binding ExecID}"  IsEnabled="{Binding ManualEnable,Converter={StaticResource booleanConvertor}}">
                                                        </Button>
                                                    </StackPanel>


                                                    <TextBlock  Grid.Row="1" x:Name="tbComment" Margin="10,0,10,0" Width="310" Grid.Column="2" Grid.ColumnSpan="5" FontSize="14"  FontFamily="{StaticResource DefaultFont}" Foreground="{StaticResource ColorBrush.Gray14}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding QQMsg}" ToolTip="{Binding QQMsg}" TextWrapping="Wrap">
                                                    </TextBlock>
                                                </Grid>

                                                <!--第二行 客户点价，被点报价-->
                                                <Grid Grid.Row="1" HorizontalAlignment="Left" Margin="0 6 0 0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"></RowDefinition>
                                                        <RowDefinition Height="10"></RowDefinition>
                                                        <RowDefinition Height="*"></RowDefinition>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock  Margin="0,0,0,0" Grid.Row="0" Grid.Column="0" Text="客户点价" FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="14" Foreground="{StaticResource ColorBrush.Gray14}" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>

                                                    <TextBlock  Margin="5,0,5,0" Grid.Row="0" Grid.Column="1"  Text="{Binding Price,Converter={StaticResource numConvertor},ConverterParameter=''}" FontFamily="{StaticResource DefaultFont}" FontWeight="Bold" FontSize="20"  VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="#ED6D00"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Side}" Value="2">
                                                                        <Setter Property="Foreground" Value="#0082D8" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HandlInst}" Value="1">
                                                                        <Setter Property="Foreground" Value="#00FFB4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Grid Margin="0,0,0,0" Grid.Row="0" Grid.Column="2" Width="192">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"></RowDefinition>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="tbAmount" Grid.Row="0" Grid.Column="0" Text="{Binding PointOrderQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource DefaultFont}" FontSize="24px" Foreground="White" HorizontalAlignment="Left" BorderThickness="1" Height="32"   
                                                                VerticalAlignment="Center" Padding="10 0 0 0" Style="{StaticResource  CustomQtyTextBox}" Width="120" TabIndex="1" input:InputMethod.IsInputMethodEnabled="False" IsEnabled="{Binding AmountIsEnable, Converter={StaticResource booleanConvertor}}"  MaxLength="9"
                                                                ContextMenu="{x:Null}" PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" Tag="{Binding ExecID}">
                                                        </TextBox>
                                                        
                                                        <TextBlock Text="kw" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{StaticResource DefaultFont}" Foreground="#A0A0A0" FontSize="12" Margin="0,0,5,0"></TextBlock>

                                                        <Button x:Name="btnSubtraction" Grid.Row="0" Grid.Column="2" BorderThickness="0 1 0 0" Margin="4,0,0,0" Width="32px" Height="32px" Style="{StaticResource MinusButton}"
                                                            Command="{Binding DataContext.SubtractionCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" CommandParameter="{Binding ExecID}" IsEnabled="{Binding SubtractionEnabled, Converter={StaticResource booleanConvertor}}"/>
                                                        <Button x:Name="btnAdd" Grid.Row="0" Grid.Column="1" BorderThickness="0 1 0 0" Margin="4,0,0,0" Width="32px" Height="32px" Style="{StaticResource AddPlusButton}"
                                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" CommandParameter="{Binding ExecID}" IsEnabled="{Binding AddEnabled, Converter={StaticResource booleanConvertor}}"/>
                                                    </Grid>

                                                    <TextBlock x:Name="tbBrokerBMsg" Margin="0,0,5,0" Grid.Row="2" Grid.Column="0" Text="被点报价" FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="14" Foreground="{StaticResource ColorBrush.Gray14}" VerticalAlignment="Center" HorizontalAlignment="Right"></TextBlock>

                                                    <TextBlock x:Name="tbQuotePrice" Margin="5,0,5,0" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource DefaultFont}" HorizontalAlignment="Left" Text="{Binding DayPrice,Converter={StaticResource numConvertor},ConverterParameter=''}"  FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="#ED6D00"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Side}" Value="2">
                                                                        <Setter Property="Foreground" Value="#0082D8" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DayHandlInst}" Value="1">
                                                                        <Setter Property="Foreground" Value="#00FFB4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                
                                                    <StackPanel  x:Name="spQuoteTag" Margin="0,0,5,0" Grid.Row="2" Grid.Column="2"  VerticalAlignment="Center" Orientation="Horizontal">
                                                    
                                                        <Button x:Name="ocoflagshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource ocoButton}" Visibility="Collapsed" ToolTip="oco">
                                                        </Button>
                                                        <Button x:Name="packageflagshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource packageButton}" Visibility="Collapsed" ToolTip="打包">
                                                        </Button>
                                                        <Button x:Name="onestarButtonshowbtn" MinHeight="10" MinWidth="10" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource onestarButton}" Visibility="Collapsed" ToolTip="需请示">
                                                        </Button>
                                                        <Button x:Name="twostarButtonshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource twostarButton}" Visibility="Collapsed" ToolTip="必须请示">
                                                        </Button>
                                                        <Button x:Name="switchbtn" BorderThickness="0" VerticalAlignment="Center" Margin="2 -2 0 0" HorizontalAlignment="Left" Style="{StaticResource exchangeButton}" Visibility="Collapsed" ToolTip="换券">
                                                        </Button>

                                                        <TextBlock x:Name="tbQuoteQty" Foreground="{StaticResource ColorBrush.Yellow}" Grid.Row="2" Grid.Column="3" Text="{Binding DayOrderQty}" FontFamily="{StaticResource DefaultFont}" FontSize="14" FontWeight="Bold" Margin="5,0,5,0" VerticalAlignment="Center"></TextBlock>
                                                        <TextBlock x:Name="tbBClickSettlType" Margin="0,0,5,0" Grid.Row="0" Grid.Column="4"  Text="{Binding DaySettlType, Converter={StaticResource BrokerSettleTypeConverter},ConverterParameter='popup'}" FontFamily="{StaticResource DefaultFont}" Foreground="{StaticResource ColorBrush.White-1}"  FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                                                        <TextBlock x:Name="tbContent" Grid.Row="2" Grid.Column="5" Margin="0,0,50,0" FontFamily="{StaticResource IDCFontFamily.YaHei}" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="14" VerticalAlignment="Center" Text="{Binding DayComment}" MaxWidth="100" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!--第三行 操作按钮-->
                                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0" Width="412">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100"></ColumnDefinition>
                                                            <ColumnDefinition Width="130"></ColumnDefinition>
                                                            <ColumnDefinition Width="180"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>
                                                        <!--订单状态-->
                                                        <TextBlock Grid.Column="0" x:Name="txtStatusMsg" Width="100" Visibility="Collapsed"  ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" HorizontalAlignment="Left" Foreground="#E63034" FontSize="14" TextTrimming="CharacterEllipsis">
                                                        </TextBlock>

                                                        <StackPanel x:Name="spButton"  Grid.Column="2" Visibility="Visible" Margin="0,0,10,0" Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding ButtonIsEnable,Converter={StaticResource booleanConvertor}}">
                                                            <Button x:Name="btnReject" Content="拒绝" Margin="0,0,2,0" FontFamily="{StaticResource DefaultFont}" BorderThickness="0" FontSize="12px" 
                                                                Background="#B54645" Width="60" Height="24"  Foreground="{StaticResource ColorBrush.White-1}" Style="{StaticResource CancelButtonStyle}" Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"   CommandParameter="{Binding ExecID}" TabIndex="2"></Button>
                                                            <Button x:Name="btnOk" Content="确定" Margin="2,0,5,0" FontFamily="{StaticResource DefaultFont}" Foreground="{StaticResource ColorBrush.White-1}" BorderThickness="0" FontSize="12px" 
                                                                Background="#136C5E" Width="90" Height="24"  Style="{StaticResource ConfirmButtonStyle}" Command="{Binding DataContext.OkCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"   CommandParameter="{Binding ExecID}" TabIndex="3"></Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="F">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已拒绝"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已拒绝"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="C">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已过期"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已过期"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="D">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已删除"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已删除"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="4">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已撤单"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已撤单"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding OrdStatus}" Value="H">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已拒绝"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已拒绝"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="E">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#269E68"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="G">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#269E68"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="1">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#874EB9"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="部分确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="部分确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="2">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#FF9D61"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="待确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="待确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Collapsed"></Setter>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding OrdStatus}" Value="X">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="请稍后重试..."></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="请稍后重试..."></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ocoFlag}" Value="1"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ocoflagshowbtn" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ocoFlag}" Value="2"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="packageflagshowbtn" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ExchangeSignFlag}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="switchbtn" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ExchangeSignFlag}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="switchbtn" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>

                                            <DataTrigger Binding="{Binding bargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                                                <Setter TargetName="onestarButtonshowbtn" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding bargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                                                <Setter TargetName="twostarButtonshowbtn" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
    <!--</DockPanel>-->
</UserControl>
