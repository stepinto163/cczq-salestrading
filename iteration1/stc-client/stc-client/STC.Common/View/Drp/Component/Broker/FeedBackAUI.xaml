                                    </Viewbox>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{DynamicResource  SvgButton.MouseOver.Background}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource  SvgButton.MouseOver.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{DynamicResource  SvgButton.MouseOver.Background}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource  SvgButton.MouseOver.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource ImageButton.Disabled.Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--DataGridRow样式-->

            <Style x:Key="DrpDefaultDataGrid" TargetType="DataGrid">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <!-- 不需要虚拟模式 -->
                <!--<Setter Property="EnableRowVirtualization" Value="False"/>-->
                <!-- 不需要边框 -->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="BorderBrush" Value="{StaticResource DataGridColumnHeaderBorderBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="RowStyle" Value="{DynamicResource DrpDataGridRowStyle}"/>
                <Setter Property="CellStyle" Value="{DynamicResource DrpDataGridCellStyle}"/>
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            </Style>

            <Style x:Key="DrpDataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#282828"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <Style x:Key="DrpDataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="MinHeight" Value="94"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="2,0,2,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,0">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <!--<Setter Property="Background" Value="#0A2420" />-->
                        <Setter Property="Foreground" Value="#00CDAD" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="False">
                        <!--<Setter Property="Background" Value="{DynamicResource DataGridBackGround}" />-->
                        <Setter Property="Foreground" Value="#A0A0A0" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource HoverDataGridBackGround}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SelfDataGridTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#D7D7D7"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#3C3C3C"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
        </ResourceDictionary>
    </UserControl.Resources>
    <!--{StaticResource ColorBrush.Gray18}-->
    <Grid Background="{StaticResource ColorBrush.Gray13}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"></RowDefinition>
        </Grid.RowDefinitions>
        <!-- 标题区 -->
        <Border Grid.Row="0" BorderThickness="2,2,2,0" x:Name="Border_Left1"  CornerRadius="4,4,0,0"  BorderBrush="#8F9598"  Background="{StaticResource ColorBrush.Gray18}">
            <Grid x:Name="gTitle" Height="30" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Title" Text="收到点价反馈" Margin="10,0,0,0"  
                           FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                           FontSize="14" Foreground="{StaticResource ColorBrush.White2}" Grid.Column="0" VerticalAlignment="Center" />
                <!--<TextBlock x:Name="LabMsgId" Text="{Binding BlockNum}" ToolTip="{Binding BlockNum}" FontSize="14" Foreground="{StaticResource ColorBrush.White2}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>-->
                <Button x:Name="btnClose" Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource DrpImageCloseButton}" Width="20" Height="20" IsCancel="True"/>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <Border BorderThickness="2, 0, 2, 0" Grid.Row="1" BorderBrush="#8F9598" Background="{Binding BGBackground}">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="1"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <!--债券信息，更新时间，点价信息-->
                <Grid Grid.Row="0" Margin="0 0 0 0">
                    <Grid x:Name="gGrid" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                            <RowDefinition Height="auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid x:Name="gInfo" Margin="15,0,15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            
                            <TextBlock x:Name="tbGoodsCode" VerticalAlignment="Center" Grid.Column="0" Margin="0 0 0 0" FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}" FontSize="20px" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Yellow}"  Text="{Binding SecurityID}">
                            </TextBlock>

                            <TextBlock x:Name="tbSymbol" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="218" TextTrimming="WordEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}"  FontSize="20px" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Yellow}" Text="{Binding Symbol}"></TextBlock>

                            <TextBlock x:Name="tbUpdateTime" VerticalAlignment="Center" Grid.Column="3" Margin="0 0 0 0" Width="54" FontFamily="{StaticResource FontFamily.Roboto}" FontSize="14px" Foreground="{StaticResource ColorBrush.PaleGrey}" Text="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}"></TextBlock>

                            <Grid VerticalAlignment="Center" HorizontalAlignment="Left"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="tbBrokerAMsg"  Margin="0,0,0,0" Grid.Row="0" Grid.Column="0" Text="点价信息" 
                                FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="14" Foreground="{StaticResource ColorBrush.Gray14}" 
                                VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>

                                <TextBlock x:Name="tbClickPrice" Margin="5,0,5,0" Grid.Row="0" Grid.Column="1"  Text="{Binding Price,Converter={StaticResource numConvertor},ConverterParameter=''}" 
                                FontFamily="{StaticResource DefaultFont}" FontWeight="Bold" FontSize="20"  VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="#ED6D00"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Side}" Value="2">
                                                    <Setter Property="Foreground" Value="#0082D8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HandlInst}" Value="1">
                                                    <Setter Property="Foreground" Value="#00FFB4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock x:Name="tbSide" Margin="5,0,5,0" Grid.Row="0" Grid.Column="2" 
                                       Text="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter=side2}"
                                       VerticalAlignment="Center" Style="{StaticResource PTSideTextBlockStyle}">
                                </TextBlock>
                                <TextBlock x:Name="tbClickQty" Margin="0,0,5,0" Grid.Row="0" Grid.Column="3"  Text="{Binding OrderQty}" 
                                        Foreground="{StaticResource ColorBrush.Yellow}" FontFamily="{StaticResource DefaultFont}" 
                                        FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

                                <TextBlock x:Name="tbClickSettlType" Margin="0,0,5,0" Grid.Row="0" Grid.Column="4"  Text="{Binding SettlType,Converter={StaticResource BrokerSettleTypeConverter},ConverterParameter='popup'}" 
                                        FontFamily="{StaticResource DefaultFont}" Foreground="{StaticResource ColorBrush.White-1}" 
                                        FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <!--上分割线-->
                <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0,0,0,0" BorderBrush="#282828" Background="{DynamicResource ColorBrush.Gray13}">
                </Border>
                
                <!-- 表格用于显示点价反馈信息 -->
                <Grid Margin="0" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"   MaxHeight="890">
                    <!-- Datagrid列表 -->
                    <DataGrid x:Name="dgQtyList" ItemsSource="{Binding FeedBackQuotations}"
                                HeadersVisibility="None" BorderThickness="0"  AutoGenerateColumns="False" SelectionUnit="FullRow"  SelectionMode="Single" CanUserAddRows="False"
                                VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" Background="Transparent" IsReadOnly="False" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Style="{DynamicResource DrpDefaultDataGrid}"> 
                        <DataGrid.Columns>
                            
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Width="140" Text="{Binding CounterPartyInstitutionName}" Margin="12 4 0 0" Style="{DynamicResource PTInstBrokerTextBlockStyle}" Foreground="#F9C152" HorizontalAlignment="Left"  TextTrimming="WordEllipsis" TextWrapping="Wrap" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn MinWidth="40" MaxWidth="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 10 0 0" >
                                            <TextBlock  Margin="2,0,5,0"  Height="24" Text="{Binding DayOrderQty}" ToolTip="{Binding ExecID}" Foreground="#F9C152" FontFamily="{StaticResource DefaultFont}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0 10 0 0" >
                                            <TextBlock Height="24" Width="60" Text="{Binding DaySettlType,Converter={StaticResource BrokerSettleTypeConverter},ConverterParameter='popup'}"  TextTrimming="WordEllipsis"
                                                        FontFamily="{StaticResource DefaultFont}" Foreground="{StaticResource ColorBrush.White-1}"  FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Width="176">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition></RowDefinition>
                                            </Grid.RowDefinitions>
                                            
                                            <StackPanel ToolTip="{Binding id}" Grid.Row="0" Margin="0 4 0 0"  Orientation="Horizontal" HorizontalAlignment="Right" ToolTipService.IsEnabled="False">
                                                    <!--第一行 Broker 剩余量 状态-->
                                                    <TextBlock Text="{Binding CounterPartyTraderName}" ToolTip="{Binding OrderID}" x:Name="txtbroker" FontFamily="{StaticResource DefaultFont}" Foreground="#FFFFFF"  FontSize="14"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    </TextBlock>
                                                    <TextBlock  x:Name="txtLastQty" Text="{Binding PartLastQty}" Margin="4 0 0 0" Visibility="Collapsed"
                                                                Foreground="{StaticResource ColorBrush.Yellow}" FontFamily="{StaticResource DefaultFont}"  FontSize="14" FontWeight="Bold" 
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    </TextBlock>

                                                <TextBlock  x:Name="txtStatusMsg" Margin="4 0 0 0" Text="{Binding StatusMsg}" ToolTip="{Binding StatusMsg}" FontSize="14" FontFamily="{StaticResource DefaultFont}" 
                                                            HorizontalAlignment="Left"  TextTrimming="CharacterEllipsis">
                                                    </TextBlock>
                                            </StackPanel>

                                            <!--第二行 备注信息-->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal"  Margin="0 14 0 0">
                                                <Button x:Name="ocoflagshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource ocoButton}" Visibility="Collapsed" ToolTip="oco">
                                                </Button>
                                                <Button x:Name="packageflagshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource packageButton}" Visibility="Collapsed" ToolTip="打包">
                                                </Button>
                                                <Button x:Name="onestarButtonshowbtn" MinHeight="10" MinWidth="10" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource onestarButton}" Visibility="Collapsed" ToolTip="需请示">
                                                </Button>
                                                <Button x:Name="twostarButtonshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource twostarButton}" Visibility="Collapsed" ToolTip="必须请示">
                                                </Button>
                                                <Button x:Name="switchbtn" BorderThickness="0" VerticalAlignment="Center" Margin="2 -2 0 0" HorizontalAlignment="Left" Style="{StaticResource exchangeButton}" Visibility="Collapsed" ToolTip="换券">
                                                </Button>
                                                <TextBlock Margin="6 -4 0 0"  FontFamily="{StaticResource IDCFontFamily.YaHei}"  Foreground="{StaticResource ColorBrush.Gray14}" FontSize="14" 
                                                        VerticalAlignment="Center" Text="{Binding DayComment}" MaxWidth="122" TextAlignment="Left" TextTrimming="WordEllipsis" TextWrapping="Wrap" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                                </TextBlock>
                                            </StackPanel>

                                            <!--第三行 操作按钮-->
                                            <StackPanel  Grid.Row="2" Visibility="{Binding ButtonVisible,Converter={StaticResource visibleconverter}}" Orientation="Horizontal"  Margin="0 0 0 0" HorizontalAlignment="Right">
                                                <Button x:Name="btnReject" Content="拒绝" Margin="0,0,2,0" FontFamily="{StaticResource DefaultFont}"  BorderThickness="0 1 0 0" FontSize="12px" 
                                                        Background="#B54645" Width="60" Height="24"  Foreground="{StaticResource ColorBrush.White-1}" Style="{StaticResource RedButtonStyle3}"  Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"   CommandParameter="{Binding ExecID}"></Button>
                                                <Button x:Name="btnOk" Content="确定" Margin="2,0,0,0" FontFamily="{StaticResource DefaultFont}" Foreground="{StaticResource ColorBrush.White-1}" BorderThickness="0 1 0 0" FontSize="12px" 
                                                        Background="#136C5E" Width="80" Height="24" Style="{StaticResource ConfirmButtonStyle}"  Command="{Binding DataContext.OkCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"   CommandParameter="{Binding ExecID}"></Button>
                                            </StackPanel>
                                        </Grid>
                                        
                                        <DataTemplate.Triggers>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMe}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="txtbroker" Property="Foreground" Value="#00CDAD"/>
                                            </MultiDataTrigger>
                                            
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="F">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已拒绝"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已拒绝"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="C">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已过期"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已过期"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="D">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已删除"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已删除"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="4">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已撤单"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已撤单"></Setter>
                                            </DataTrigger>
                                            
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="H">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#E63034"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已拒绝"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已拒绝"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="E">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#269E68"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已确认"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="G">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#269E68"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="已确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="已确认"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="1">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#874EB9"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="部分确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="部分确认"></Setter>
                                                <Setter TargetName="txtLastQty" Property="Visibility" Value="Visible"></Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OrdStatus}" Value="2">
                                                <Setter TargetName="txtStatusMsg" Property="Foreground" Value="#FF9D61"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="Text" Value="待确认"></Setter>
                                                <Setter TargetName="txtStatusMsg" Property="ToolTip" Value="待确认"></Setter>
                                            </DataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ocoFlag}" Value="1"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="ocoflagshowbtn" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ocoFlag}" Value="2"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="packageflagshowbtn" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ExchangeSignFlag}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="switchbtn" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ExchangeSignFlag}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="switchbtn" Property="Visibility" Value="Collapsed"/>
                                            </MultiDataTrigger>

                                            <DataTrigger Binding="{Binding bargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                                                <Setter TargetName="onestarButtonshowbtn" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding bargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                                                <Setter TargetName="twostarButtonshowbtn" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
        <!-- Bottom -->
        <Border BorderThickness="2, 0, 2, 2" Grid.Row="2" CornerRadius="0,0,4,4" BorderBrush="#8F9598" Background="#141414">
            <Border BorderThickness="0,1,0,0" Margin="0 -1 0 0" BorderBrush="{DynamicResource Main.BorderBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                    <TextBlock  FontFamily="PingFang SC"  FontSize="12px" FontWeight="SemiBold" HorizontalAlignment="Center"  VerticalAlignment="Center" Foreground="#E6890D" Text="手工点价 不能发送消息"></TextBlock>
                </StackPanel>
            </Border>
        </Border>
        
    </Grid>
    <!--</DockPanel>-->

</UserControl>
