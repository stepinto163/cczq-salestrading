<Window x:Class="STC.Common.View.Drp.Component.MMAgencyMsgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Drp.Component"            
             xmlns:comp ="clr-namespace:STC.Common.View.Component"
             mc:Ignorable="d" 
             Title="双边待办处理事项" Height="398" Width="640" MinHeight="394" WindowStartupLocation="CenterScreen" AllowsTransparency="True" 
             WindowState="Normal" WindowStyle="None" BorderThickness="0" Background="Transparent" Deactivated="Window_Deactivated" Activated="Window_Activated">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--TextBlock 样式-->
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.White-1}"></Setter>
                <Setter Property="FontFamily" Value="MicrosoftYaHei"></Setter>
                <Setter Property="FontSize" Value="12"></Setter>
            </Style>
            <!-- 关闭按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="DrpImageCloseButton">
                <Setter Property="Background" Value="#282828"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderBrush" Value="#515151"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,0" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <Border x:Name="border2" SnapsToDevicePixels="true" Width="10" Height="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="/STC.Common;component/Images/close_normal.png"/>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="#788187"/>
                                    <Setter Property="Background" TargetName="border" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="border2">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/close_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="#3C3C3C"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#515151"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
            
            <Style x:Key="PPSendPriceButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#136C5E"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#238F7E"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#238F7E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#00CDAD"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="BBAddAmountButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#3C3C3C"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderBrush" Value="#515151"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#3C3C3C"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#A0A0A0"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FFFFFF"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="#3C3C3C"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#515151"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*" MinHeight="250"/>
            <RowDefinition Height="2"/>
        </Grid.RowDefinitions>
        <!--标题区-->
        <Border BorderThickness="2,2,2,0" x:Name="Border_Left1" Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{StaticResource ColorBrush.Gray18}">
            <Grid  Background="{StaticResource ColorBrush.Gray18}" Margin="2,0,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleIcon" Width="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="4,0,0,0"></Image>
                <TextBlock Text="双边待办处理事项" Height="24" Grid.Column="1" HorizontalAlignment="Left" Margin="5,3,0,0" FontWeight="Bold" FontSize="{StaticResource NormalContentFontSize}"/>
                <TextBlock Grid.Column="2" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"></TextBlock>
                <Button x:Name="PART_CloseButton" Width="24" Height="24" Grid.Column="4" Margin="0,0,0,0" HorizontalAlignment="Right" IsCancel="True" Command="{Binding CancelCommand}" Style="{StaticResource DrpImageCloseButton}" />
            </Grid>
        </Border>
        <Border Grid.Row="1" BorderThickness="2, 0, 2, 0" CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Gray13}">
        </Border>

        <Border Grid.Row="2" BorderThickness="2,0,2,0" CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{StaticResource ColorBrush.Gray13}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="产生原因：" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                <comp:MultiSelectComboBox x:Name="ReasonCbb" Width="100" Height="22" Background="Black" Margin="10 1 0 4"  Tag="REASON" 
                                          FilterDicChanged="ReasonCbb_FilterDicChanged">
                </comp:MultiSelectComboBox>
                <TextBlock Text="分组：" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                <comp:MultiSelectComboBox x:Name="GroupCbb" Width="100" Height="22" Background="Black" Margin="10 1 0 4"  Tag="GROUP" 
                                          FilterDicChanged="GroupCbb_FilterDicChanged">
                </comp:MultiSelectComboBox>
                
                
            </WrapPanel>
        </Border>
        <Border Grid.Row="3" Grid.RowSpan="3" BorderThickness="2, 0, 2, 2" x:Name="Border_Left2" CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Gray13}">
            <DataGrid Style="{StaticResource DefaultDataGrid}" Margin="0" 
                      ItemsSource="{Binding DataDV}"                      
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn MinWidth="60" Width="*" Header="分组">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GroupName}" HorizontalAlignment="Left" FontSize="12"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="60" Header="类别">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="typetb" Text="{Binding GroupType}" HorizontalAlignment="Left" FontSize="12"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="120" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="DelBtn"  Width="40" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Content="处理"
                                                Command="{Binding DataContext.DealCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                Padding="1"
                                                Style="{DynamicResource PPSendPriceButton}"
                                                Foreground="#D7D7D7">
                                    </Button>

                                    <Button x:Name="IgnoreBtn"  Width="40" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="3,0,0,0"
                                                Content="忽略"
                                                Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                Padding="1"
                                                Style="{DynamicResource BBAddAmountButtonStyle}"
                                                Foreground="#D7D7D7">
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="100" Header="债券代码">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SecurityId}" HorizontalAlignment="Left" FontSize="12"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="100" Header="债券简称">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Symbol}" HorizontalAlignment="Left" FontSize="12"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="120" Width="2*" Header="产生原因">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Reason}" HorizontalAlignment="Left" FontSize="12"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
