<UserControl x:Class="STC.Common.View.Drp.Component.NofirmPointPriceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Common.View.Drp.Component"
        xmlns:fcon="clr-namespace:STC.Common.Convertor"
        xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Height="196" Width="380">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:ReverseVisibilityConvertor x:Key="ReverseVisibilityConvertor"/>
            <SolidColorBrush x:Key="SelectDataGridBackGround" Color="#0A2420"/>
            <SolidColorBrush x:Key="DataGridBackGround" Color="#141414"/>
            
            <Style TargetType="Button" x:Key="CloseButtonStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="&#9932;" FontSize="12" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style TargetType="{x:Type local:NofirmPointPriceView}">
                <!--<Setter Property="Height" Value="100"/>-->
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform />
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="5" Direction="0" ShadowDepth="0" Opacity=".25"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--TextBlock 样式-->
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.White-1}"></Setter>
                <Setter Property="FontFamily" Value="MicrosoftYaHei"></Setter>
                <Setter Property="FontSize" Value="12"></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:.5" />
                    <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleX" From="0" To="1" Duration="0:0:.2"/>
                    <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleY" From="0" To="1" Duration="0:0:.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <!--<EventTrigger RoutedEvent="local:NotificationWindow.NotificationCloseInvoked">
            <BeginStoryboard>
                <Storyboard Duration="0:0:.1">
                    <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleX" From="1" To="0.1" Duration="0:0:.2"/>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard BeginTime="0:0:.2">
                    <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleY" From="1" To="0" Duration="0:0:.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>-->
    </UserControl.Triggers>
    
    <Grid MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="2"></RowDefinition>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition Height="10"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="76"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="39"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Border Background="Transparent" Grid.Row="0"></Border>
        <!--标题区-->
        <Border BorderThickness="2,2,2,0" x:Name="Border_Left1" Grid.Row="1"  CornerRadius="4,4,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BackgroundBrush}">
            <Grid  Background="{DynamicResource BackgroundBrush}" Margin="2,0,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleIcon" Width="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="4,0,0,0"></Image>
                <TextBlock Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="24" Grid.Column="1" HorizontalAlignment="Left" Margin="5,2,0,0" FontWeight="Bold" FontSize="{DynamicResource NormalContentFontSize}"/>
                <Button x:Name="PART_CloseButton" Width="24" Height="24" Grid.Column="2" Margin="0,0,0,0" HorizontalAlignment="Right" IsCancel="True" Style="{DynamicResource DrpImageCloseButton}" />
            </Grid>
        </Border>
        <!--空行-->
        <Border BorderThickness="2,0,2,0" Grid.Row="2"  CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
        </Border>
        
        <!--点价信息-->
        <Border BorderThickness="2,0,2,0" x:Name="Border_Left3" Grid.Row="3"  CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="4"></ColumnDefinition>
                    <ColumnDefinition Width="68"></ColumnDefinition>
                    <ColumnDefinition Width="16"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock  Grid.Column="1" Text="{Binding Symbol}" Foreground="#C29B4E"  FontWeight="Bold" FontSize="18" VerticalAlignment="Center"></TextBlock>
                <!--总的倒计时-->
                <StackPanel Orientation="Horizontal" Grid.Column="3">
                    <Grid x:Name="Grid" Width="68"  Height="40">
                        <Border x:Name="out_border" CornerRadius="2" BorderBrush="Transparent" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{DynamicResource GraySlateButton.MouseOver.Background}" BorderThickness="0,1,0,0" Background="{DynamicResource GraySlateButton.Static.Background}" SnapsToDevicePixels="true">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding OrderRemainSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" FontSize="26" FontFamily="MicroSoft YaiHei" FontWeight="Bold" Foreground="#FF333A" TextWrapping="Wrap">
                                    </TextBlock>
                                    <TextBlock VerticalAlignment="Center" Margin="1,6,0,0" Text="s" Visibility="{Binding OrderRemainSecondsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontFamily="MicroSoftYaiHei" FontWeight="Bold" Foreground="#FF333A">
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Border>
                        <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <!--订单基本信息-->
        <Border Grid.Row="4" x:Name="Border_Left2"  BorderThickness="2, 0, 2, 0" CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="4"></ColumnDefinition>
                    <ColumnDefinition Width="68"></ColumnDefinition>
                    <ColumnDefinition Width="16"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MaxWidth="160"></ColumnDefinition>
                        <ColumnDefinition Width="150"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" >
                        <TextBlock Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" Foreground="#A0A0A0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold" FontSize="12"></TextBlock>
                        <TextBlock Text="点价" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold" FontSize="12"></TextBlock>
                    </StackPanel>
                        
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PointPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#D7D7D7" MinWidth="56" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBox Text="{Binding PointAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnableEditAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DrpPriceAmountEditTextBox}" Foreground="{Binding AlertsignPointAmountforground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Left" Margin="2,0,0,0" Padding="4,4,0,0" Width="88" Height="32" VerticalAlignment="Center" FontSize="18" InputMethod.IsInputMethodEnabled="False">

                        </TextBox>
                        <TextBlock x:Name="kw_unit" Text="{Binding ShowKwUnit}"  Foreground="{DynamicResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="-20,18,1,0" Width="16" Visibility="{Binding IsShowIRS, Converter={StaticResource ReverseVisibilityConvertor}}"/>
                        <TextBlock x:Name="million_unit" Text="百万"  Foreground="{DynamicResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="-26,18,1,0" Width="22"  Visibility="{Binding IsShowIRS, Converter={StaticResource booleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
                
                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                    <Button Margin="0,0,2,0" Content="_" Command="{Binding ReduceAmountCommand}" FontSize="18" Padding="0,-20,0,0"  Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0" IsEnabled="{Binding IsEnableEditAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#D7D7D7"/>
                    <Button Margin="2,0,0,0" Content="+" Command="{Binding AddAmountCommand}" FontSize="18" Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0" IsEnabled="{Binding IsEnableEditAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#D7D7D7" />
                </StackPanel>
                
                
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                    <TextBlock  Text="我的报价" Foreground="#A0A0A0" Width="48" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"></TextBlock>
                    <TextBlock Text="{Binding ShowPrice}" Margin="2,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSide}" Value="1">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange7}"></Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowSide}" Value="2">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue8}"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ShowLeavesQtyTotal}" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
                    </TextBlock>
                    <Border x:Name="txtwhole" Grid.Column="1" CornerRadius="2" Width="16" Height="16" Visibility="{Binding WholeFlag, Converter={StaticResource ReverseVisibilityConvertor}}" Background="{DynamicResource TextBox.Focus.Border}" BorderThickness="0" Margin="0,0,0,0">
                        <TextBlock Text="整" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF">
                        </TextBlock>
                    </Border>

                    <TextBlock Text="{Binding ShowSettle}" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Visibility="{Binding IsShowIRS, Converter={StaticResource ReverseVisibilityConvertor}}">
                    </TextBlock>

                    <Button x:Name="btnCopyMsg" Height="18" Width="16" ToolTip="复制" Style="{DynamicResource DrpCopyMsgButton}"  PreviewMouseLeftButtonDown="btnCopyMsg_PreviewMouseLeftButtonDown"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--分割线-->
        <Border Grid.Row="5" BorderThickness="2, 0, 2, 0" CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <Border BorderThickness="0,1,0,0" BorderBrush="#282828"></Border>    
        </Border>
        
        <!--功能按钮-->
        <Border Grid.Row="6" x:Name="Border_Left4"  BorderThickness="2, 0, 2, 2" CornerRadius="0,0,4,4" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button  Content="拒绝" Command="{Binding RefuseCommand}" FontSize="12" BorderThickness="0 1 0 0"
                        Style="{DynamicResource GraySlateButtonStyle}" Width="64" Height="24" HorizontalAlignment="Right" Foreground="#D7D7D7"/>
                    <Button  Content="确认"  Command="{Binding CommitCommand}" FontSize="12" Margin="4,0,0,0" BorderThickness="0 1 0 0"
                        Style="{DynamicResource BlueGreenStyle}" Width="88" Height="24" Foreground="#D7D7D7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
