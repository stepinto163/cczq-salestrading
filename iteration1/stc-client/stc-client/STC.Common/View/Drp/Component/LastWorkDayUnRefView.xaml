<UserControl x:Class="STC.Common.View.Drp.Component.LastWorkDayUnRefView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Common.View.Drp.Component"
        xmlns:fcon="clr-namespace:STC.Common.Convertor"
        xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Height="148" Width="380">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            
            <Style TargetType="Button" x:Key="CloseButtonStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="&#9932;" FontSize="12" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style TargetType="{x:Type local:LastWorkDayUnRefView}">
                <!--<Setter Property="Height" Value="100"/>-->
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="LayoutTransform">
                    <Setter.Value>
                        <ScaleTransform />
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="5" Direction="0" ShadowDepth="0" Opacity=".25"/>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:.5" />
                    <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleX" From="0" To="1" Duration="0:0:.2"/>
                    <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleY" From="0" To="1" Duration="0:0:.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="local:NotificationWindow.NotificationCloseInvoked">
            <BeginStoryboard>
                <Storyboard Duration="0:0:.1">
                    <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleX" From="1" To="0.1" Duration="0:0:.2"/>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard BeginTime="0:0:.2">
                    <DoubleAnimation Storyboard.TargetProperty="LayoutTransform.ScaleY" From="1" To="0" Duration="0:0:.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="2"></RowDefinition>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition Height="1"></RowDefinition>
            <RowDefinition Height="39"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Border Background="Transparent" Grid.Row="0"></Border>
        <!--标题区-->
        <Border BorderThickness="2,2,2,0" x:Name="Border_Left1" Grid.Row="1"  CornerRadius="4,4,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BackgroundBrush}">
            <Grid Background="{DynamicResource BackgroundBrush}" Margin="1,0,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleIcon" Width="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="4,0,0,0"></Image>
                <TextBlock Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="24" Grid.Column="1" HorizontalAlignment="Left" Margin="5,2,0,0" FontWeight="Bold" FontSize="{DynamicResource NormalContentFontSize}"/>
                <Button x:Name="PART_CloseButton" Width="24" Height="24" Grid.Column="2" Margin="0,0,0,0" HorizontalAlignment="Right" IsCancel="True" Style="{DynamicResource DrpImageCloseButton}" />
            </Grid>
        </Border>
        <!--空行-->
        <Border BorderThickness="2,0,2,0" Grid.Row="2"  CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
        </Border>

        <!--基本信息-->
        <Border BorderThickness="2,0,2,0" x:Name="Border_Left3" Grid.Row="3"  CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}"> 
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="4"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock  Grid.Column="1" Text="{Binding Message}" Foreground="#A0A0A0" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" TextWrapping="WrapWithOverflow"></TextBlock>
            </Grid>
        </Border>
     
        <!--分割线-->
        <Border Grid.Row="4" BorderThickness="2, 0, 2, 0" CornerRadius="0,0,0,0" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <Border BorderThickness="0,1,0,0" BorderBrush="#282828"></Border>    
        </Border>
        
        <!--功能按钮-->
        <Border Grid.Row="5" x:Name="Border_Left4"  BorderThickness="2, 0, 2, 2" CornerRadius="0,0,4,4" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"></ColumnDefinition>
                    <ColumnDefinition Width="80"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="20"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Button  Content="忽略" Command="{Binding RefuseCommand}" FontSize="12" Grid.Column="1"
                        Style="{DynamicResource GraySlateButtonStyle}" Width="64" Height="24" HorizontalAlignment="Left" BorderThickness="0 1 0 0"/>
                
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button  Content="查看" Command="{Binding ReViewCommand}" FontSize="12" 
                        Style="{DynamicResource GraySlateButtonStyle}" Width="64" Height="24" HorizontalAlignment="Left" BorderThickness="0 1 0 0"/>
                    <Button  Content="批量恢复"  Command="{Binding CommitCommand}" FontSize="12" Margin="4,0,0,0"
                        Style="{DynamicResource BlueGreenStyle}" Width="88" Height="24" BorderThickness="0 1 0 0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
