<UserControl x:Class="STC.Common.View.Drp.Component.ConfirmRef_BuyTrader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Drp.Component"
             xmlns:comp="clr-namespace:STC.Common.View.Component"
             mc:Ignorable="d" Height="175" Width="380"
             d:DesignHeight="450" d:DesignWidth="800" Background="Black" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <!--点价 窗体背景色 -->
            <LinearGradientBrush x:Key="BidLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#66FF7D00" Offset="0"/>
                <GradientStop Color="#00FF7D00" Offset="0.3"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="OfrLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#48009AFF" Offset="0"/>
                <GradientStop Color="#00009AFF" Offset="0.3"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="1 2 1 0">
        <!-- 程序外边框 注意 x:Name="MainBorder" 不要改 ，因为需要实现 更新时动态提醒效果-->
        <Border x:Name="MainBorder" Background="{StaticResource MainListTitleBackgroup.ColorBrush}" Style="{DynamicResource StrongNotifyBorder}" CornerRadius="4" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition />
                    <RowDefinition Height="48"></RowDefinition>
                </Grid.RowDefinitions>

                <!-- 标题区 注意如果需要拖动标题栏 时拖出屏幕，在 x:Name="Border_Left1" 不要改，因为需要 在代码中注册 拖拽效果事件 Border_Left1_PreviewMouseMove -->
                <Border BorderThickness="0" x:Name="Border_Left1" Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="#8F9598"  Background="{StaticResource ColorBrush.Gray18}">
                    <Grid x:Name="gTitle" Height="30" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Title" Text="" Margin="10,0,0,2"  FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontSize="14" Foreground="{StaticResource ColorBrush.White2}" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock  x:Name="tbMsgId" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontSize="14" Foreground="SeaGreen" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 25 0"/>
                        <CheckBox x:Name="btnPop" Style="{StaticResource GrPopupRestoreButtonStyle}" IsChecked="True" Grid.Column="2" Margin="0 3 0 0" Checked="OnReturnControlClick" Unchecked="OnReturnControlClick" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" ToolTip="弹出"></CheckBox>
                        <Button x:Name="PART_CloseButton" Width="24" Height="24" Grid.Column="3" Margin="0,-4,0,0" HorizontalAlignment="Right" Click="PART_CloseButton_Click" IsCancel="True" Style="{StaticResource DrpImageCloseButton}" />
                    </Grid>
                </Border>

                <Border BorderThickness="0" Grid.Row="1" Margin="0 0 0 0" BorderBrush="#8F9598">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" Text="{Binding InvestorName}" Foreground="{DynamicResource Text.Foreground.NoPermission}" FontSize="14" Margin="20 0 0 0" Grid.ColumnSpan="2"/>
                        <TextBlock Grid.Row="2" Text="{Binding RefText}" Height="48" TextWrapping="Wrap" Foreground="{DynamicResource Text.Foreground.NoPermission}" FontSize="14" Margin="20 0 0 0" Grid.ColumnSpan="2"/>
                    </Grid>
                </Border>

                <Border BorderThickness="0" Grid.Row="2" CornerRadius="0,0,4,4" BorderBrush="#8F9598" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!--上分割线-->
                        <Border Grid.Row="0" BorderThickness="0,1,0,0" CornerRadius="0,0,0,0" BorderBrush="#208F9598" Background="{DynamicResource ColorBrush.Gray13}">
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button  Content="取消" x:Name="btn_Cancel" FontSize="12" Click="btn_Cancel_Click"  BorderThickness="0 1 0 0" Style="{DynamicResource GraySlateButtonStyle}" Width="64" Height="24" HorizontalAlignment="Right" Foreground="#D7D7D7"/>
                            <Button  Content="确认" x:Name="btn_Confirm" FontSize="12" Click="btn_Confirm_Click" Margin="4,0,8,0" BorderThickness="0 1 0 0" Style="{DynamicResource BlueGreenStyle}" Width="88" Height="24" Foreground="#D7D7D7"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
