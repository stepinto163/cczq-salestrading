<Window x:Class="STC.Common.View.StrongNotify.StrongNotifyMainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.StrongNotify"
             mc:Ignorable="d" 
             Title="消息管理器"
             ShowInTaskbar="False"
             WindowStyle="None"
             ShowActivated="False"
             AllowsTransparency="True"
             Topmost="True"
             Opacity="1"
            d:DesignWidth="200"  d:DesignHeight="100" Width="200" Height="120"  UseLayoutRounding = "True" SnapsToDevicePixels = "True" IsHitTestVisible = "True"
             Background="Transparent">
    <Window.Resources>
        <!--<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes\Generic.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>-->
    </Window.Resources>

    <Grid>
        <ScrollViewer x:Name="scrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <local:RightToLeftBottomToTopPanel x:Name="CustomPanel" Background="Transparent" AllowDrop="True">
            </local:RightToLeftBottomToTopPanel>
        </ScrollViewer>
    </Grid>
</Window>
