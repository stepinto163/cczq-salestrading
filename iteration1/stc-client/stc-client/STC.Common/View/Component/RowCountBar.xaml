<UserControl x:Class="STC.Common.View.Component.RowCountBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Component"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Fill="#3C3C3C" RadiusY="1" RadiusX="1" StrokeThickness="1" Margin="4,4,0,4" Width="1"/>
        <TextBlock Grid.Column="1" FontStyle="Normal" Foreground="#A0A0A0" FontFamily="Microsoft YaHei" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center">
            <Run Text="共"></Run>
            <Run x:Name="rowCount_run" Text="0" Foreground="White"></Run>
            <Run Text=" 条记录， 其中Bid "></Run>
            <Run x:Name="bidRowCount_run" Text="0" Foreground="White"></Run>
            <Run Text="条，Ofr "></Run>
            <Run x:Name="ofrRowCount_run" Text="0" Foreground="White"></Run>
            <Run Text="条"></Run>
        </TextBlock>
    </Grid>

</UserControl>
