<local:WindowBase x:Class="STC.Common.View.Component.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Common.View.Component"
        mc:Ignorable="d"
        Title="CustomMessageBox" Width="380" SizeToContent="WidthAndHeight"
                  MaxboxEnable="False" MinboxEnable="False" ResizeMode="NoResize"
                  FocusManager.FocusedElement="{Binding ElementName=btnOK}"
                  Closing="WindowBase_Closing">
    <local:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
        
    </local:WindowBase.Resources>
    <local:WindowBase.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </local:WindowBase.InputBindings>
    
    <!--<Viewbox x:Name="RootViewbox" Stretch="None">-->
    <Grid x:Name="RootGrid" Background="{DynamicResource MainBackgroup.ColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MaxHeight="400"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--<Grid x:Name="gTitle" Grid.ColumnSpan="2" DockPanel.Dock="Top" Background="{DynamicResource BackgroundBrush}" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>
                
                <Image x:Name="TitleIcon" Width="32" Stretch="Uniform" HorizontalAlignment="Center"></Image>
                <TextBlock x:Name="tbTitle"  Grid.Column="1" x:FieldModifier="public" Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:WindowBase}}, Path=Title}"  Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="{DynamicResource IDCFontFamily.YaHei}" FontSize="12px"></TextBlock>
                <Button x:Name="btnClose" Grid.Column="3" Style="{DynamicResource MainImageCloseButton}" Background="Transparent" Width="20" Height="20" Command="{x:Static SystemCommands.CloseWindowCommand}" IsCancel="True"></Button>
            </Grid>-->

        <Border x:Name="ErroIcon" Grid.Row="1" Width="16" Height="16" CornerRadius="8" Background="#E63034" Visibility="Collapsed">
            <TextBlock Text="×" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="InfoIcon" Grid.Row="1" Width="16" Height="16" CornerRadius="8" Background="#00A84B" Visibility="Collapsed">
            <TextBlock Text="✔" Foreground="#FFFFFF"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="QuestionIcon" Grid.Row="1" Width="16" Height="16" CornerRadius="8" Background="#E63034" Visibility="Collapsed">
            <TextBlock Text="!" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Margin="5,28,10,30" Grid.Row="1" Grid.Column="1" MinWidth="260" 
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="viewer">
            <TextBlock x:Name="txtMessage"  Foreground="#FFFFFF" TextWrapping="Wrap" FontSize="{DynamicResource NormalContentFontSize}"></TextBlock>
        </ScrollViewer>

        <Border Grid.ColumnSpan="2" Grid.Row="2" BorderBrush="#232323" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0 0 0 0"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}" BorderThickness="0 0 0 0"
                        Click="btnOK_Click" IsDefault="True">确定</Button>
                </StackPanel>

            </Border>
        </Grid>
    <!--</Viewbox>-->

</local:WindowBase>
