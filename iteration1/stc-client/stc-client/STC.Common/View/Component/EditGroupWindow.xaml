<local:WindowBase x:Class="STC.Common.View.Component.EditGroupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Component"
             mc:Ignorable="d" Title="组管理" Height="390" Width="1300"
             d:DesignHeight="390" d:DesignWidth="900" Closing="WindowBase_Closing" Closed="WindowBase_Closed">

    <Window.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="EditGroup_DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"></Setter>
                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="Height" Value="32"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource DefaultAlternatingRowBackground.ColorBrush}"/>
                    </Trigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Item.SelectedInactive.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedInactive.Border}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Item.SelectedInactive.Foreground}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Item.SelectedActive.Foreground}"/>
                    </MultiTrigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Item.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Item.MouseOver.Border}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="1150"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="GroupList" Style="{DynamicResource DefaultDataGrid}" HeadersVisibility="None" ItemsSource="{Binding ViewSource.View}" SelectionMode="Single"
                   IsReadOnly="False" SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RowStyle="{DynamicResource EditGroup_DataGridRowStyle}"
                  BeginningEdit="GroupList_BeginningEdit" CellEditEnding="GroupList_CellEditEnding" PreparingCellForEdit="GroupList_PreparingCellForEdit" RowEditEnding="GroupList_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <!--<Image x:Name="subscrib_normal" Source="/STC.Common;component/Images/订阅.png" Width="24" Height="24" Visibility="Collapsed"/>-->
                                <Path x:Name="svg_path" Style="{DynamicResource subscrib_path}" Visibility="Collapsed"/>
                                <TextBlock Text="{Binding GroupName_Edit}" Grid.Column="1" Foreground="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Foreground}" VerticalAlignment="Center"/>
                                <Button x:Name="DelBtn" Style="{DynamicResource DeleteButton}" Grid.Column="2" Width="18" Height="18" 
                                        Visibility="Collapsed"
                                        Command="{Binding DataContext.DelCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"/>

                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IfSubscribe}" Value="true">
                                    <Setter TargetName="svg_path" Property="Visibility" Value="Visible"/>
                                    <!--<Setter TargetName="subscrib_normal" Property="Visibility" Value="Visible"/>-->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="true">
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscrib_normal" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=IsSelected}" Value="true"/>
                                        <!--<Condition Binding="{Binding Inf1}" Value="TAG"/>-->
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="DelBtn" Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <local:WatermarkTextBox x:Name="editTextBox" WaterMark="请输入组名" Text="{Binding GroupName_Edit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>

        <!--分割-->
        <GridSplitter x:Name="gridSplitter" Grid.Column="1" Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Style="{DynamicResource VGridSplitterStyle3}"/>


        <Border x:Name="TagBd" BorderBrush="#282828" BorderThickness="1 0 0 0"  Grid.Column="2" Visibility="{Binding SelectedItem.TagPanelVisibility}" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="groupName" Text="{Binding SelectedItem.GroupName_Edit}" Foreground="#D7D7D7" Margin="4 4 0 0"  VerticalAlignment="Center" FontSize="16"/>
                <CheckBox x:Name="subChk" Content="订阅" Grid.Row="1"  Style="{DynamicResource DefaultCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalAlignment="Left" Padding="4 0 0 0" Margin="4 0 0 0" Foreground="#D7D7D7" IsChecked="{Binding SelectedItem.IfSubscribe_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Top">
                    <RadioButton x:Name="poolRd" Content="券池" Height="24" Width="32" FontWeight="Bold" IsChecked="{Binding SelectedItem.IsGroup_Edit}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Background" Value="#D7D7D7"/>
                                <Setter Property="Foreground" Value="#515151"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                                <Border x:Name="border" CornerRadius="12 0 0 12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                                    <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="Center" Margin="2 0 0 0" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="true">
                                        <Setter Property="Foreground" Value="{DynamicResource BlueGreenButton.Static.Foreground}"/>
                                        <Setter Property="Background" Value="{DynamicResource BlueGreenButton.Static.Background}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="Foreground" Value="{DynamicResource BlueGreenButton.MouseOver.Border}"/>
                                        <Setter Property="Background" Value="{DynamicResource BlueGreenButton.MouseOver.Background}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="filterRd" Content="筛选" Height="24" Width="32" FontWeight="Bold" IsChecked="{Binding SelectedItem.IsGroup_Edit, Mode=OneWay, Converter={StaticResource reversebooleanConvertor}}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                                <Setter Property="Background" Value="#D7D7D7"/>
                                <Setter Property="Foreground" Value="#515151"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                                <Border x:Name="border" CornerRadius="0 12 12 0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                                    <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="Center" Margin="0 0 2 0" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="true">
                                        <Setter Property="Foreground" Value="{DynamicResource BlueGreenButton.Static.Foreground}"/>
                                        <Setter Property="Background" Value="{DynamicResource BlueGreenButton.Static.Background}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="Foreground" Value="{DynamicResource BlueGreenButton.MouseOver.Border}"/>
                                        <Setter Property="Background" Value="{DynamicResource BlueGreenButton.MouseOver.Background}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
                
                <local:SecurityFilterPanel x:Name="filterPanel" Grid.Row="3" Visibility="{Binding SelectedItem.IsGroup_Edit, Converter={StaticResource reversevisibilityConvertor}}"
                                                StartTermDY="{Binding SelectedItem.StartTermDY_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                EndTermDY="{Binding SelectedItem.EndTermDY_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsAppTerm="{Binding IsAppTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                
                                                FocusTags="{Binding SelectedItem.FocusTags_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                StartCoupon="{Binding SelectedItem.StartCoupon_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                EndCoupon="{Binding SelectedItem.EndCoupon_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsCoupon="{Binding SelectedItem.IsCoupon_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                StartPrice="{Binding SelectedItem.StartPrice_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                EndPrice="{Binding SelectedItem.EndPrice_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                StartChinaBondValue="{Binding SelectedItem.StartChinaBond_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                EndChinaBondValue="{Binding SelectedItem.EndChinaBond_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                StartBidBp="{Binding SelectedItem.StartBidBp_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndBidBp="{Binding SelectedItem.EndBidBp_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                StartOfrBp="{Binding SelectedItem.StartOfrBp_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndOfrBp="{Binding SelectedItem.EndOfrBp_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                />

                <Grid Grid.Row="3" Visibility="{Binding SelectedItem.IsGroup_Edit, Converter={StaticResource visibilityConvertor}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Button x:Name="GroupBtn" Width="88" Height="24" Style="{DynamicResource GrayButtonStyle}" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center"
                            Command="{Binding GroupManagerCommand}">
                            <WrapPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                                <Image Source="/STC.quant.plugin;component/Images/券组管理.png" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                                <TextBlock Text="券组管理" Width="Auto" Height="16" Margin="2,0,0,0"/>
                            </WrapPanel>
                        </Button>

                        <TextBlock Text="{Binding SelectedItem.CheckCount, StringFormat={}已选{0}组}" Margin="100 0 0 0" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="bondGroup" Grid.Row="3" Style="{StaticResource DefaultDataGrid}" ItemsSource="{Binding GroupView}" RowHeight="24">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="27" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="Selected_Chk" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Click="Selected_Chk_Click"
                                        Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" BorderBrush="{DynamicResource GraySlateButton.Static.Border}" Height="12"></CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" Header="组名" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Groupname}" VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="债券数量" MinWidth="50" Width="0.5*" Binding="{Binding BondNum}" />

                            <DataGridTemplateColumn MinWidth="100"  Width="2.5*" Header="操作文本" CanUserSort="False" SortMemberPath="Value" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Label Content="{Binding BondCode}" Foreground="#FFFFFF">
                                            <Label.ToolTip>
                                                <ToolTip  >
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Width="400"/>
                                                </ToolTip>
                                            </Label.ToolTip>
                                        </Label>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="作者"  Width="*" MinWidth="75" Binding="{Binding Username}" />
                            <DataGridTextColumn Header="最后编辑人"  Width="*" MinWidth="75" Binding="{Binding Closeby}" />

                            <DataGridTextColumn Header="更新时间" MinWidth="130" Width="*" Binding="{Binding updatetime}" >
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
               
            </Grid>
        </Border>

        <Border x:Name="BondBd" BorderBrush="#282828" BorderThickness="1 0 0 0"  Grid.Column="2" Visibility="{Binding SelectedItem.BondPanelVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="groupName_Bond" Text="{Binding SelectedItem.GroupName_Edit}" Foreground="#D7D7D7" Margin="4 4 0 0"  VerticalAlignment="Center" FontSize="16"/>
                <CheckBox x:Name="subChk_Bond" Content="订阅" Grid.Row="1" Style="{DynamicResource DefaultCheckBoxStyle}" Padding="4 0 0 0" Margin="4 0 0 0" Foreground="#D7D7D7" IsChecked="{Binding SelectedItem.IfSubscribe_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding SelectedItem.Remark}" Grid.Row="2" FontWeight="Bold" Foreground="#D7D7D7" FontSize="16" Margin="10 20 0 0"/>
            </Grid>
        </Border>

        <Border BorderBrush="#282828" BorderThickness="0 1 0 0" Grid.Row="1" Grid.ColumnSpan="3">
            <Grid>
                <Button x:Name="NewGroupBtn" Content="添加组" Style="{DynamicResource GraySlateButtonStyle}" Width="60" Height="24" Margin="8 0 0 0" HorizontalAlignment="Left" Click="NewGroupBtn_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0"/>

                <Button x:Name="CancelBtn" Content="取消" Style="{DynamicResource GraySlateButtonStyle}" Width="60" Height="24" Margin="0 0 112 0" HorizontalAlignment="Right" Click="CancelBtn_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0"/>
                <Button x:Name="SaveBtn" Content="保存" Style="{DynamicResource BlueGreenStyle}" Width="100" Height="24" Margin="0 0 8 0" HorizontalAlignment="Right" Click="SaveBtn_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0"/>
            </Grid>
        </Border>
    </Grid>
</local:WindowBase>
