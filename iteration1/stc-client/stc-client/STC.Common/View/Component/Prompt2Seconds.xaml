<Window x:Class="STC.Common.View.Component.Prompt2Seconds"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
          x:Name="root"
        MinHeight="80" WindowStartupLocation ="CenterScreen" MinWidth="200" Initialized="root_Initialized"
         WindowStyle="None" Background="{x:Null}" AllowsTransparency="True"
        Window.SizeToContent="WidthAndHeight" BorderThickness="1" BorderBrush="#A0A0A0">

    <Grid  Background="{DynamicResource MainTitleBackgroup.ColorBrush}" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="tbTitle" Text="{Binding PromptTitle, ElementName=root}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="2秒后消失" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="100,0,10,0" Foreground="#A0A0A0"/>
        </DockPanel>
        <TextBlock x:Name="tbRefer" Text="{Binding PromptContext, ElementName=root}" Grid.Row="1" Grid.ColumnSpan="2" Foreground="#FFFFFF" Margin="20,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Window>
