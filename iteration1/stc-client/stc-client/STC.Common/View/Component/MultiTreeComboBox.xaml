        </ResourceDictionary>
        
    </UserControl.Resources>

    <ComboBox Style="{StaticResource CmbTreeComboBox}" Loaded="treeComboBox_Loaded" MaxDropDownHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" IsHitTestVisible="True" IsTabStop="False" Focusable="False" SnapsToDevicePixels="True" OverridesDefaultStyle="True"  IsSynchronizedWithCurrentItem="True" x:Name="ComboBox" DropDownOpened="ComboBox_DropDownOpened"/>
