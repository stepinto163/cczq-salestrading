<UserControl x:Class="STC.Common.View.Component.CustomFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Component"            
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--<UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>-->
    <Grid Background="{DynamicResource MainBackgroup.ColorBrush}">
        <TextBox x:Name="tb" Width="0" Height="0"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ShowAll_ToggleButton" Content="SHOW ALL" Width="80" Height="24" Margin="4 1 0 4"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          IsChecked="False" Style="{DynamicResource ShowAllRadioButtonStyle}" />
                    <local:FilterOptions x:Name="side" TagKey="SIDE" Margin="10 1 0 4" TagsListChanged="TagsListChanged"/>


                    <!--清算不限-->
                    <local:MultiSelectComboBox x:Name="settltype" Tag="SETTL_TYPE" Width="100" Height="24" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 1 0 4" DefaultText="清算不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>

                    <!--意向不限-->
                    <local:MultiSelectComboBox x:Name="firmflag" Tag="FIRM" Width="100" Height="24" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 1 0 4" DefaultText="意向不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>

                    <!--业务不限-->
                    <local:MultiSelectComboBox x:Name="business" Tag="ROLE_TYPE"  Width="100" Height="24" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 1 0 4" DefaultText="业务不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>

                    <!--客户不限-->
                    <local:MultiSelectComboBox x:Name="OrgCbb" Tag="ORG_TYPE" Width="140" Height="24" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 1 0 4" DefaultText="客户不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>


                    <CheckBox x:Name="vipCB" Style="{DynamicResource DefaultCheckBoxStyle}" Content="VIP" Foreground="#D7D7D7" Padding="4 0 0 0" Margin="4 1 0 4"
                              Checked="vipCB_Checked" Unchecked="vipCB_Unchecked"/>
                    <CheckBox Style="{DynamicResource DefaultCheckBoxStyle}" Content="收益率" Foreground="#D7D7D7" Padding="4 0 0 0" Margin="4 1 0 4" Visibility="Collapsed"/>

                    <CheckBox Style="{DynamicResource DefaultCheckBoxStyle}" Content="偏移" Foreground="#D7D7D7" Padding="4 0 0 0" Margin="4 1 0 4" Visibility="Collapsed"/>
                    <TextBlock x:Name="Coupontb" Text="票面" Foreground="#D7D7D7" VerticalAlignment="Center" Margin="8 0 4 2"/>
                    <StackPanel x:Name="Coupon_Part"  Margin="4 1 0 4"  VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBox x:Name="SCoupon" Style="{DynamicResource STCDefaultBoxStyle}" Height="18" Width="50" input:InputMethod.IsInputMethodEnabled="False"
                         PreviewTextInput="TextBox_PreviewTextInput" Foreground="{DynamicResource ComboBoxItem.MouseOver.Border}"
                          PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" KeyDown="Coupon_KeyDown" LostFocus="SCoupon_LostFocus"/>
                        <TextBlock Text="-" Foreground="#7D7D7D"/>
                        <TextBox x:Name="ECoupon" Style="{DynamicResource STCDefaultBoxStyle}" Height="18" Width="50" input:InputMethod.IsInputMethodEnabled="False"
                         PreviewTextInput="TextBox_PreviewTextInput" Foreground="{DynamicResource ComboBoxItem.MouseOver.Border}"
                          PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" KeyDown="Coupon_KeyDown" LostFocus="ECoupon_LostFocus"/>
                     </StackPanel>

                    <TextBlock x:Name="pricetb" Text="报价" Foreground="#D7D7D7" VerticalAlignment="Center" Margin="8 0 4 2"/>
                    <StackPanel x:Name="Price_Part"  Margin="4 1 0 4"  VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBox x:Name="SPrice" Style="{DynamicResource defaultPercenTextBox}" Height="18" Width="50" input:InputMethod.IsInputMethodEnabled="False"
                         PreviewTextInput="TextBox_PreviewTextInput" Foreground="{DynamicResource ComboBoxItem.MouseOver.Border}"
                          PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" KeyDown="Price_KeyDown" LostFocus="Price_LostFocus"/>
                        <TextBlock Text=" - " Foreground="#7D7D7D"/>
                        <TextBox x:Name="EPrice" Style="{DynamicResource defaultPercenTextBox}" Height="18" Width="50" input:InputMethod.IsInputMethodEnabled="False"
                         PreviewTextInput="TextBox_PreviewTextInput" Foreground="{DynamicResource ComboBoxItem.MouseOver.Border}"
                          PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" KeyDown="Price_KeyDown" LostFocus="Price_LostFocus"/>
                     </StackPanel>
                    <TextBlock x:Name="ChinaBondValuetb" Text="中债估值" Foreground="#D7D7D7" VerticalAlignment="Center" Margin="8 0 4 2"/>
                    <StackPanel x:Name="ChinaBondValue_Part"  Margin="4 1 0 4"  VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBox x:Name="SChinaBondValue" Style="{DynamicResource STCDefaultBoxStyle}" Height="18" Width="50" input:InputMethod.IsInputMethodEnabled="False"
                         PreviewTextInput="TextBox_PreviewTextInput" Foreground="{DynamicResource ComboBoxItem.MouseOver.Border}"
                          PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" KeyDown="ChinaBondValue_KeyDown" LostFocus="ChinaBondValue_LostFocus"/>
                        <TextBlock Text=" - " Foreground="#7D7D7D"/>
                        <TextBox x:Name="EChinaBondValue" Style="{DynamicResource STCDefaultBoxStyle}" Height="18" Width="50" input:InputMethod.IsInputMethodEnabled="False"
                         PreviewTextInput="TextBox_PreviewTextInput" Foreground="{DynamicResource ComboBoxItem.MouseOver.Border}"
                          PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" KeyDown="ChinaBondValue_KeyDown" LostFocus="ChinaBondValue_LostFocus"/>
                     </StackPanel>


                    <CheckBox x:Name="isMMNoReplyCB" Content="做市未回" VerticalAlignment="Center" Margin="4 1 0 4" Style="{DynamicResource DefaultCheckBoxStyle}" IsChecked="true" Padding="5 0 0 0"
                      Foreground="#D7D7D7" Checked="isMMNoReplyCB_Checked"  Unchecked="isMMNoReplyCB_Unchecked"/>

                    <CheckBox x:Name="isMeCB" Content="我" VerticalAlignment="Center" Margin="4 1 0 4" Style="{DynamicResource DefaultCheckBoxStyle}" IsChecked="false" Padding="5 0 0 0"
                      Visibility="Collapsed"
                      Foreground="#D7D7D7" Checked="isMeCB_Checked" Unchecked="isMeCB_Unchecked"/>


                    <CheckBox x:Name="isFuzzyCB" Content="仅模糊" VerticalAlignment="Center" Margin="4 1 0 4" Style="{DynamicResource DefaultCheckBoxStyle}" IsChecked="false" Padding="5 0 0 0"
                      Foreground="#D7D7D7" Checked="isFuzzyCB_Checked" Unchecked="isFuzzyCB_Unchecked"/>
                </StackPanel>

                <WrapPanel x:Name="row1" Orientation="Horizontal"  Grid.Row="1" Width="1300" HorizontalAlignment="Left">
                    <!--债券类型-->
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton x:Name="BondType_All_ToggleButton" Content="ALL" Width="40" Height="24" Margin="4 1 0 4"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                              IsChecked="False" Style="{DynamicResource ShowAllOangleRadioButtonStyle}"/>
                        <ListBox x:Name="BondTypeListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="BondTypeListBox_SelectionChanged">
                            <ListBox.Template>
                                <ControlTemplate>
                                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBoxItem Content="国债" Tag="1011" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24"  Margin="2,1,0,4"/>
                            <ListBoxItem Content="央票" Tag="1100" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24"  Margin="2,1,0,4"/>
                            <ListBoxItem Content="政金债" Tag="1101" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="52" Height="24"  Margin="2,1,0,4"/>
                            <ListBoxItem Content="地方债" Tag="1110" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="52" Height="24"  Margin="2,1,0,4"/>
                            <ListBoxItem Content="商业银行债" Tag="1111" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="72" Height="24"  Margin="2,1,0,4"/>
                        </ListBox>
                    </WrapPanel>

                    <!--债券类型-->
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton x:Name="FinBondType_All_ToggleButton" Content="ALL" Width="40" Height="24" Margin="10 1 0 4" 
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            IsChecked="False" Style="{DynamicResource ShowAllOangleRadioButtonStyle}"/>
                        <ListBox x:Name="FinBondTypeListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="FinBondTypeListBox_SelectionChanged">
                            <ListBox.Template>
                                <ControlTemplate>
                                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBoxItem Content="国开" Tag="0001" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24"  Margin="2,1,0,4"/>
                            <ListBoxItem Content="口行" Tag="0010" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24"  Margin="2,1,0,4"/>
                            <ListBoxItem Content="农发" Tag="0011" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24"  Margin="2,1,0,4"/>
                        </ListBox>

                    </WrapPanel>

                    <!--一般债-->
                    <local:FilterOptions x:Name="filter2" TagKey="LOCAL_GOV_BOND_TYPE" Margin="10 1 0 4" TagsListChanged="TagsListChanged"/>
                </WrapPanel>

                <WrapPanel x:Name="row2" Orientation="Horizontal" Grid.Row="2" Width="1300" HorizontalAlignment="Left">
                    <local:FilterOptions x:Name="filter1" Margin="4 1 0 4" TagKey="BOND_SUB_TYPE" TagsListChanged="TagsListChanged"/>

                    <local:FilterOptions x:Name="filter3" Margin="10 1 0 4" TagKey="ENTERPRISE_TYPE" TagsListChanged="TagsListChanged"/>

                    <local:FilterOptions x:Name="filter5" Margin="10 1 0 4" TagKey="FIN_INST_BOND" TagsListChanged="TagsListChanged"/>

                     <TextBlock Text="NCD类型" Foreground="#A0A0A0" Margin="10 1 0 4" VerticalAlignment="Center"/>
                    <!--NCD类型-->
                    <local:MultiSelectComboBox x:Name="banktype" Width="100" Height="22" Background="Black" Margin="10 1 0 4" DefaultText="不限" Tag="NCD_TYPE" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>
                </WrapPanel>

                <WrapPanel x:Name="row3_1" Orientation="Horizontal" Grid.Row="3" Width="1300" HorizontalAlignment="Left">
                    <!--债券期限-->
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton x:Name="Term_All_ToggleButton" Content="ALL" Width="40" Height="24" Margin="4 1 0 4" 
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            IsChecked="False" Style="{DynamicResource ShowAllOangleRadioButtonStyle}"/>
                        <ListBox x:Name="TermListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="TermListBox_SelectionChanged">
                            <ListBox.Template>
                                <ControlTemplate>
                                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBoxItem Content="&lt;3M" Tag="0001" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="52" Height="24" Margin="2,1,0,4"/>
                            <ListBoxItem Content="3-6M" Tag="0010" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24" Margin="2,1,0,4"/>
                            <ListBoxItem Content="6-9M" Tag="0011" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24" Margin="2,1,0,4"/>
                            <ListBoxItem Content="9-12M" Tag="0100" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24" Margin="2,1,0,4"/>
                            <ListBoxItem Content="1-3Y" Tag="0101" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24" Margin="2,1,0,4"/>
                            <ListBoxItem Content="3-5Y" Tag="0110" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24" Margin="2,1,0,4"/>
                            <ListBoxItem Content="5-10Y" Tag="0111" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24" Margin="2,1,0,4"/>
                            <ListBoxItem Content="&gt;10Y" Tag="1000" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="40" Height="24" Margin="2,1,0,4"/>
                        </ListBox>
                        <local:CustomTermControl x:Name="TermCtrl" Width="160" Height="24" Margin="4 0 0 0" OKAction="TermCtrl_OKAction"/>

                        <!--银行类型-->
                        <TextBlock x:Name="ratetypetb" Text="利息类型" Foreground="#A0A0A0" Margin="10 1 0 4" VerticalAlignment="Center"/>
                        <local:MultiSelectComboBox x:Name="ratetype" Tag="CAL_INTER_TYPE" Width="140" Height="22" Background="Black" Margin="10 1 0 4" DefaultText="不限" FilterDicChanged="Cbb_FilterDicChanged">
                        </local:MultiSelectComboBox>

                        <!--交易所-->
                        <local:FilterOptions x:Name="exchange" Margin="10 1 0 4" TagKey="LISTED_MARKET" TagsListChanged="TagsListChanged"/>

                        <!--可质押-->
                        <local:FilterOptions x:Name="ifPleded" Margin="10 1 0 4" TagKey="IF_PLEDGED" TagsListChanged="TagsListChanged"/>
                    </WrapPanel>
                </WrapPanel>

                <WrapPanel x:Name="row3_2" Orientation="Horizontal" Grid.Row="4" Width="1300" HorizontalAlignment="Left">
                    <!--主体-->
                    <TextBlock Text="主体" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:FilterOptions x:Name="rate" Margin="4 1 0 4" TagKey="RANKING_TYPE" TagsListChanged="TagsListChanged"/>

                    <!--债项-->
                    <TextBlock Text="债项" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiSelectComboBox x:Name="OrgCbb3" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" Tag="RATING_CURRENT" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>

                    <!--中债资信-->
                    <TextBlock Text="中债资信" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiSelectComboBox x:Name="creditRate" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" Tag="ISSUER_RATING_CURRENT_CBR" FilterDicChanged="Cbb_FilterDicChanged"/>

                    <!--中债隐含-->
                    <TextBlock Text="中债隐含" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4" />
                    <local:MultiSelectComboBox x:Name="OrgCbb1" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" Tag="CDC_IMPLITED_RATING" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>

                    <!--中证隐含-->
                    <TextBlock Text="中证隐含" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiSelectComboBox x:Name="OrgCbb2" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" Tag="CSI_IMPLIED_RATING" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>


                </WrapPanel>

                <WrapPanel x:Name="row6" Orientation="Horizontal" Grid.Row="5" Width="1300" HorizontalAlignment="Left">
                    <local:FilterOptions x:Name="filter7" Margin="4 1 0 4"  TagKey="IF_MUNICIPAL" TagsListChanged="TagsListChanged"/>
                    <local:FilterOptions x:Name="filter8" Margin="10 1 0 4"  TagKey="IF_PLATFORM" TagsListChanged="TagsListChanged"/>
                    <local:FilterOptions x:Name="filter9" Margin="10 1 0 4" TagKey="ADMIN_LEVEL" TagsListChanged="TagsListChanged"/>
                    <local:FilterOptions x:Name="filter10" Margin="10 1 0 4" TagKey="IF_GUARANTEE" TagsListChanged="TagsListChanged"/>
                    <local:FilterOptions x:Name="filter11" Margin="10 1 0 4" TagKey="ISSUE_TYPE" TagsListChanged="TagsListChanged"/>

                </WrapPanel>

                <WrapPanel x:Name="row5" Orientation="Horizontal" Grid.Row="6" Width="1300" HorizontalAlignment="Left">

                    <!--行业-->
                    <TextBlock Text="行业" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:HierarchicalComboBox x:Name="OrgCbb5" Width="160" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" Tag="INDUSTRY_TYPE" FilterDicChanged="HierarchicalComboBox_FilterDicChanged" IsEditable="True"/>


                    <!--地区-->
                    <TextBlock Text="地区" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiSelectComboBox x:Name="OrgCbb6" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" Tag="REGION_TYPE" FilterDicChanged="Cbb_FilterDicChanged" IsEditable="True">
                    </local:MultiSelectComboBox>


                    <!--年份-->
                    <TextBlock Text="年份" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiSelectComboBox x:Name="OrgCbb7" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" Tag="ISSUE_YEAR" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>


                    <!--发行人-->
                    <TextBlock Text="发行人" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiAutoCompleteComboBox x:Name="OrgCbb8" Width="120" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" Watermark="" Tag="ISSUER" FilterDicChanged="MultiAutoCbb_FilterDicChanged" HasRecognizeBtn="True"
                                                     PatternChanged="IssuerCbb_PatternChanged" LetterFilterChanged="IssuerCbb_LetterFilterChanged">

                    </local:MultiAutoCompleteComboBox>


                    <!--担保人-->
                    <TextBlock Text="担保人" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiAutoCompleteComboBox x:Name="OrgCbb9" Width="120" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" Watermark="" Tag="GUARANTOR" FilterDicChanged="MultiAutoCbb_FilterDicChanged"
                                                     PatternChanged="GuarantorCbb_PatternChanged" LetterFilterChanged="GuarantorCbb_LetterFilterChanged">
                    </local:MultiAutoCompleteComboBox>

                    <!--永续-->
                    <TextBlock Text="永续" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiSelectComboBox x:Name="OrgCbb10" Tag="PERPETUAL_TYPE" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>

                    <!--假日-->
                    <TextBlock Text="假日" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <local:MultiSelectComboBox x:Name="OrgCbb11" Tag="HOLIDAY_TYPE" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="10 1 0 4" DefaultText="不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </local:MultiSelectComboBox>

                    <local:FilterOptions x:Name="filter12" Margin="10 1 0 4" TagKey="CUM_TYPE" TagsListChanged="TagsListChanged"/>
                </WrapPanel>

                <WrapPanel x:Name="row4" Orientation="Horizontal" Grid.Row="6" Width="1300" Visibility="Collapsed">

                </WrapPanel>
            </Grid>
        </ScrollViewer>
        <Button x:Name="savebtn"  Visibility="Collapsed" Style="{DynamicResource SaveButton_24}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 34 18" Click="Save_Click"/>
        <Button x:Name="editbtn"  Visibility="Collapsed" Style="{DynamicResource SettingButton_24}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 10 18" Click="EditGroup_Click"/>

    </Grid>
</UserControl>
