<UserControl x:Class="STC.Common.View.Component.DescriptionCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.Component"
             mc:Ignorable="d" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="mainGrid" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="已筛选" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="#FFDA9A"/>
        <Border Name="out_border" Grid.Column="1" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="2" Height="24" MouseUp="out_border_MouseUp">
            <ItemsControl x:Name="descriptionList" Background="#0F0F0F" MouseEnter="descriptionList_MouseEnter" MouseLeave="descriptionList_MouseLeave">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="txtBorder" MaxWidth="86" MinWidth="32" Background="#1E1E1E" CornerRadius="2" Margin="2" Padding="4 2 4 2">
                            <TextBlock x:Name="txt" Foreground="#FFDA9A" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                        Text="{Binding Title}"  VerticalAlignment="Center" TextAlignment="Center"></TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <local:PopupEx x:Name="popDescriptionList" PlacementTarget="{Binding ElementName=out_border}" StaysOpen="False" MaxHeight="300" Opened="popDescriptionList_Opened"
                   PopupAnimation="Slide" AllowsTransparency="False">
            <Border BorderBrush="#282828" BorderThickness="1" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                   
                    <!--{StaticResource DefaultBackgroup.ColorBrush}-->
                    <DataGrid x:Name="dgDescriptionList" Grid.Row="1"
                        HeadersVisibility="None" Background="{DynamicResource DefaultBackgroup.ColorBrush}"
                        BorderThickness="0" AutoGenerateColumns="False"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.CanContentScroll="True"
                        Margin="0" FontSize="10" Width="100"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                        <!--<DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="{TemplateBinding Padding}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                        </DataGrid.CellStyle>-->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"></Setter>
                                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                                    </Trigger>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                                    </Trigger>
                                    <!-- 不知悬浮颜色 todo  -->
                                    <!--选中颜色-->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="#3C3C3C"/>
                                        <Setter Property="BorderBrush" Value="#3C3C3C"/>
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="#3C3C3C"/>
                                        <Setter Property="BorderBrush" Value="#3C3C3C"/>
                                    </MultiTrigger>
                                    <!--鼠标移过-->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="#3C3C3C"/>
                                        <Setter Property="BorderBrush" Value="#3C3C3C"/>
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="#3C3C3C"/>
                                        <Setter Property="BorderBrush" Value="#3C3C3C"/>
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="20" Background="Transparent">
                                            <TextBlock x:Name="tb" Text="{Binding Title}" Foreground="#FFDA9A" TextWrapping="Wrap" VerticalAlignment="Center">
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </local:PopupEx>
    </Grid>
</UserControl>
