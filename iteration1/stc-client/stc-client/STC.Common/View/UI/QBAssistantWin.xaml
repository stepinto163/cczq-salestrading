<Window x:Class="STC.Common.View.UI.QBAssistantWin"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"  
        Title="PopupWindow" MinWidth="510" MinHeight="550" Width="510" Height="550" AllowsTransparency ="True" UseLayoutRounding="True" SnapsToDevicePixels="True" IsHitTestVisible="True" WindowStartupLocation="CenterScreen" WindowStyle="None"  WindowState="Normal" Background="Transparent"
        Closed="Window_Closed" KeyDown="Window_KeyDown" Deactivated="Window_Deactivated" Activated="Window_Activated">
    <Window.Resources>
        <Style x:Key="CornerDotCheckBox" TargetType="CheckBox">
            <Setter Property="Width"  Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth"  Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <!-- 给个透明背景，保证点击可命中 -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="Transparent">
                            <Viewbox Height="{TemplateBinding MinHeight}" Width="{TemplateBinding MinWidth}">
                                <!-- 左上角三角形：M0,0 -> L16,0 -> L0,16 -> Z -->
                                <Path x:Name="Tri" Data="M0,0 A2,4 0 0 0 0,2 L0,22 L22,0 Z" Fill="#12696B" />
                            </Viewbox>
                            <!-- 斜边装饰线（可选） -->
                            <Path Data="M0,19.5 L19.5,0" Stroke="#12696B" StrokeThickness="0.4" SnapsToDevicePixels="True" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                            <!-- 圆点（用 Path 画圆）：半径2，整体平移到(3,3) 附近 -->
                            <!-- 圆的 Path： 以(3,3)附近为中心，直径6 -->
                            <Path x:Name="Dot" RenderTransformOrigin="0.5,0.5" Data="M 1.5,0 A 1.5,1.5 0 1 1 -1.5,0 A 1.5,1.5 0 1 1 1.5,0 Z">
                                <Path.RenderTransform>
                                    <TranslateTransform X="5" Y="5"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- 未选中：深色点 -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="#1F2A27"/>
                            </Trigger>

                            <!-- 选中：黄色点 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="#DDE5C35D"/>
                                <Setter TargetName="Tri" Property="Fill" Value="#90238F7E"/>

                            </Trigger>

                            <!-- 鼠标悬停（可选：让三角略亮） -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="Dot" Value="0.95"/>
                                <Setter Property="Fill" TargetName="Tri" Value="#238F7E"/>
                            </Trigger>

                            <!-- 不可用（整体半透明） -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" BasedOn="{x:Null}"/>
        <Style TargetType="Window" BasedOn="{x:Null}"/>

        <Style x:Key="CircleCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="circle"
                             Width="6"
                             Height="6"
                             Fill="{TemplateBinding Background}"
                             StrokeThickness="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="Green"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="2" BorderThickness="1"  SnapsToDevicePixels="True" BorderBrush="#12696B" Background="#232628">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Border  CornerRadius="2 1 0 0" Grid.Row="0" Margin="0,0,0,0" x:Name="TitleBar" Height="20" BorderThickness="0"  Background="#0B4D52" Opacity="1">
                <Grid  Style="{x:Null}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="18"></ColumnDefinition>
                        <ColumnDefinition Width="18"></ColumnDefinition>
                        <ColumnDefinition Width="18"></ColumnDefinition>
                        <ColumnDefinition Width="18"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <CheckBox  Style="{StaticResource  CornerDotCheckBox}" Grid.Column="0" Margin="0"  Width="20" Height="20" MinHeight="20" MinWidth="20" VerticalAlignment="Top" x:Name="btnFixFloatButton" Visibility="Visible" Checked="btnFixFloatButton_Checked" Unchecked="btnFixFloatButton_Checked" ToolTip="置顶"></CheckBox>
                    <TextBlock  Grid.Column="1" x:Name="TextBlockSecurity" Foreground="#FFEBC8" FontFamily="Microsoft YaHei" FontStyle="Normal" FontWeight="Regular" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>

                    <Button Style="{DynamicResource ChromeRefreshButton}"  Grid.Column="3" Height="18" Width="18" MinHeight="11" MinWidth="11" Foreground="#FFEBC8"  Click="Reload_Click" ToolTip="刷新"/>
                    <Button Style="{DynamicResource MainPageMinButton}"  Grid.Column="4" Height="18" Width="18" MinHeight="11" MinWidth="11" Foreground="#FFEBC8"  Click="btnMin_Click" ToolTip="最小化"/>
                    <CheckBox x:Name="btnMax" Style="{DynamicResource WinFullRestoreButtonStyle}" MinHeight="8" MinWidth="8" Height="18" Width="18"  Grid.Column="5" IsChecked="False"  Foreground="#FFEBC8" Checked="btnMax_Click" Unchecked="btnMax_Click" ToolTip="最大化"></CheckBox>
                    <Button x:Name="btnClose" Style="{DynamicResource MainPageCloseButton}" Grid.Column="6"  Foreground="#FFEBC8"  Margin="0,1,1,0" VerticalAlignment="Center"  Width="18" Height="18" Click="btnClose_Click" IsCancel="True" ToolTip="关闭" />
                </Grid>
            </Border>
            <Border CornerRadius="0 0 3 3" Grid.Row="1" BorderThickness="1" BorderBrush="Transparent">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="#232628">

                </Frame>
            </Border>
        </Grid>
    </Border>
</Window>
