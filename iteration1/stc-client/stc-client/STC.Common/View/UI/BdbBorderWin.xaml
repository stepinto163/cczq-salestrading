<Window x:Class="STC.Common.View.UI.BdbBorderWin"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"  
        Title="PopupWindow" Width="682" Height="578" AllowsTransparency ="True" UseLayoutRounding="True" SnapsToDevicePixels="True" IsHitTestVisible="True" WindowStartupLocation="CenterScreen" WindowStyle="None"  WindowState="Normal" Background="Transparent"
        Closed="Window_Closed" KeyDown="Window_KeyDown" SizeToContent="WidthAndHeight" Deactivated="Window_Deactivated" Activated="Window_Activated">
    <Window.Resources>
        <Style x:Key="CornerDotCheckBox" TargetType="CheckBox">
            <Setter Property="Width"  Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth"  Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <!-- 给个透明背景，保证点击可命中 -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="Transparent">
                            <Viewbox Height="{TemplateBinding MinHeight}" Width="{TemplateBinding MinWidth}">
                                <!-- 左上角三角形：M0,0 -> L16,0 -> L0,16 -> Z -->
                                <Path x:Name="Tri" Data="M0,0 A2,4 0 0 0 0,2 L0,22 L22,0 Z" Fill="#12696B" />
                            </Viewbox>
                            <!-- 斜边装饰线（可选） -->
                            <Path Data="M0,19.5 L19.5,0" Stroke="#12696B" StrokeThickness="0.4" SnapsToDevicePixels="True" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                            <!-- 圆点（用 Path 画圆）：半径2，整体平移到(3,3) 附近 -->
                            <!-- 圆的 Path： 以(3,3)附近为中心，直径6 -->
                            <Path x:Name="Dot" RenderTransformOrigin="0.5,0.5" Data="M 1.5,0 A 1.5,1.5 0 1 1 -1.5,0 A 1.5,1.5 0 1 1 1.5,0 Z">
                                <Path.RenderTransform>
                                    <TranslateTransform X="5" Y="5"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- 未选中：深色点 -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Dot" Property="Fill" Value="#1F2A27"/>
                            </Trigger>

                            <!-- 选中：黄色点 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="#DDE5C35D"/>
                                <Setter TargetName="Tri" Property="Fill" Value="#90238F7E"/>

                            </Trigger>

                            <!-- 鼠标悬停（可选：让三角略亮） -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="Dot" Value="0.95"/>
                                <Setter Property="Fill" TargetName="Tri" Value="#238F7E"/>
                            </Trigger>

                            <!-- 不可用（整体半透明） -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" BasedOn="{x:Null}"/>
        <Style TargetType="Window" BasedOn="{x:Null}"/>

        <Style x:Key="CircleCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="circle"
                             Width="5"
                             Height="5"
                             Fill="{TemplateBinding Background}"
                             StrokeThickness="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="Green"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="MainBorder" CornerRadius="2" BorderThickness="1"  SnapsToDevicePixels="True" BorderBrush="#12696B" Background="#232628">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
            </Grid.RowDefinitions>
            <Border CornerRadius="1 1 0 0" Grid.Row="0" Margin="0" x:Name="TitleBar" BorderThickness="0"  Background="#0B4D52" Opacity="1">
                <Grid  Style="{x:Null}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="20"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <CheckBox  Grid.Column="0" Width="20" Height="20" MinHeight="20" MinWidth="20" Margin="0 0 0 0 " VerticalAlignment="Top" x:Name="btnFixFloatButton" Visibility="Visible" Style="{StaticResource  CornerDotCheckBox}" Checked="btnFixFloatButton_Checked" Unchecked="btnFixFloatButton_Checked" ToolTip="置顶"></CheckBox>
                    <TextBlock  Grid.Column="1" x:Name="TextBlockSecurity" Foreground="#FFEBC8" FontFamily="Microsoft YaHei" FontStyle="Normal" FontWeight="Regular" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                    <Button Grid.Column="4"  Margin="0,1,1,0" x:Name="btnClose" Style="{DynamicResource MainPageCloseButton}" Foreground="#FFEBC8" VerticalAlignment="Top"  Width="20" Height="20" Click="btnClose_Click" IsCancel="True" ToolTip="关闭" IsDefault="False" Focusable="False"/>
                </Grid>
            </Border>
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="#232628">

            </Frame>

            <Border Grid.Row="2" Margin="0" CornerRadius="4" x:Name="BottomBar" BorderThickness="0 0 0 1"  Background="#0B4D52" Opacity="1">
                <Grid  Style="{x:Null}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Style="{StaticResource CircleCheckBoxStyle}" x:Name="chkIsConnect" Grid.Column="0" IsEnabled="False" Visibility="Collapsed"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        
                        <TextBlock x:Name="TextUserInfo" Text=""  Foreground="#FFEBC8" FontFamily="Microsoft YaHei" FontStyle="Normal" FontWeight="Regular" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"></TextBlock>
                        
                        <Button x:Name="btnReconnect" Visibility="Collapsed" Margin="4 0 0 0" Background="Transparent" BorderThickness="0" FontStyle="Normal" FontWeight="Regular" FontSize="12" Foreground="#23AAA6" Click="btnReconnect_Click" >
                            <Button.Content>
                                <TextBlock Text="重新连接" TextDecorations="Underline" />
                            </Button.Content>
                        </Button>

                        <Button x:Name="btnConnectService" Visibility="Collapsed" Margin="4 0 0 0" Background="Transparent" BorderThickness="0" FontStyle="Normal" FontWeight="Regular" FontSize="12" Foreground="#23AAA6" Click="btnConnectService_Click" >
                            <Button.Content>
                                <TextBlock Text="联系客服" TextDecorations="Underline" />
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
