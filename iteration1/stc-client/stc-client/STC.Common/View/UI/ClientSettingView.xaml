<UserControl x:Class="STC.Common.View.UI.ClientSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="修复与报错" Foreground="#A0A0A0" HorizontalAlignment="Right" Margin="0 5 5 0" FontWeight="Bold"/>

        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
            <Button x:Name="repairDataBtn" Content="数据修复" Width="114" Height="24" Foreground="#D7D7D7" Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0,1,0,0" Click="repairDataBtn_Click"/>

            <Button Content="发送错误报告" Width="114" Height="24" Foreground="#D7D7D7" Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0,1,0,0" Margin="0 8 0 0" Visibility="Collapsed"/>
        </StackPanel>

        <CheckBox Name="StartDpsChk"  Grid.Row="1" Grid.ColumnSpan="2" Content=" 启动DPS" VerticalAlignment="Center" Margin="34 5 5 0"  BorderThickness="2" 
                                          BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="14"  
                                          PreviewMouseLeftButtonDown="StartDpsChk_PreviewMouseLeftButtonDown"
                                          FontSize="{DynamicResource SmallContentFontSize}" 
                                          Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                                          Background="{DynamicResource ColorBrush.Transparent}" 
                                          Foreground="{DynamicResource ColorBrush.Gray14}" FontWeight="Bold"></CheckBox>
    </Grid>
</UserControl>
