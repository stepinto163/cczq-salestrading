<UserControl x:Class="STC.Common.View.UI.LogoInfoGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:cv ="clr-namespace:STC.Common.Convertor"
             Height="46" Width="Auto">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <cv:VisibilityConvertor x:Key="visibilityConvertor"/>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0, 0, 0, 0">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="74"></ColumnDefinition>
            <ColumnDefinition Width="24"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition Width="24"></ColumnDefinition>
            <ColumnDefinition Width="24"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"  Grid.RowSpan="2" Grid.Column="0" Panel.ZIndex="1" MouseLeftButtonDown="Pic_MouseLeftButtonDown">
            <Image x:Name="TitleIconTop" Margin="0,0,0,0" Height="24" Stretch="UniformToFill"></Image>
            <Image x:Name="TitleIconLeft" Margin="8,0,0,0" Height="24" Stretch="UniformToFill"></Image>
            <Image x:Name="TitleIconMiddle" Height="24" Margin="8,0,0,0" Stretch="UniformToFill"></Image>
            <Image x:Name="TitleIconRight" Height="24" Margin="2,0,0,0" Stretch="UniformToFill"></Image>
        </StackPanel>

        <Separator Style="{DynamicResource {x:Static ToolBar.SeparatorStyleKey}}" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                           Height="22" Width="1" BorderBrush="#4F6964" BorderThickness="1"></Separator>

        <TextBlock Text="Hello" HorizontalAlignment="Left" Foreground="{DynamicResource ColorBrush.While}" 
                   Grid.Row="0" Grid.Column="1" FontSize="10" VerticalAlignment="Bottom" Margin="6,0,0,0"
                   Width="35" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Height="12" ></TextBlock>

        <TextBlock x:Name="tbUserName" Text="Hello" Foreground="{DynamicResource ColorBrush.While}" Grid.Row="1" Grid.Column="1" FontSize="10"
                           Margin="6, 0, 0, 5" Width="120" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Regular}" Height="12" ></TextBlock>


        <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="4" Margin="0, 0, 0, 3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnSkin" Style="{DynamicResource RefreshButton}" Visibility="Collapsed" Width="14" Height="14" Grid.Column="0" Click="btnSkin_Click"></Button>
            <Button x:Name="btnMin" Style="{DynamicResource MainPageMinButton}" Width="14" Height="14" Grid.Column="1" Click="btnMin_Click"></Button>
            <!--Button x:Name="btnMax" Style="{DynamicResource MainPageMaxButton}" Width="22" Height="12" Grid.Column="2" Click="btnMax_Click"></Button-->
            <CheckBox x:Name="btnMax" Style="{DynamicResource WinFullRestoreButtonStyle}" Grid.Column="2" Checked="btnMax_Click" Unchecked="btnMax_Click"></CheckBox>
            <Button x:Name="btnClose" Style="{DynamicResource MainPageCloseButton}" Width="14" Height="14" Grid.Column="3" Click="btnClose_Click"></Button>
        </Grid>

        <Border x:Name="bdStatus" Margin="0, 2, 0, 5" Background="#00A84B" CornerRadius="2" Width="10" Height="10" Grid.Row="1" Grid.Column="2"
                MouseEnter="btnStatus_MouseEnter" MouseLeave="btnStatus_MouseLeave"></Border>


        <Button x:Name="btnMsg" Margin="0, 0, 0, 5" Style="{DynamicResource MainPageSmallBellButton}" Foreground="{DynamicResource DefaultGridForground}" Width="20" Height="20" Grid.Row="1" Grid.Column="3"
                Click="BtnMsg_Click"></Button>
        <Ellipse x:Name="MsgElli" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18 ,0, 0, 0"  Visibility="Collapsed" Width="5"  Height="5" Fill="#FF3C3C" Grid.Row="1" Grid.Column="3" />
        
        <Button x:Name="btnSetting" Margin="0, 0, 0, 5" Style="{DynamicResource MainPageSettingButton}" Width="20" Height="20" Click="btnSetting_Click" Grid.Row="1" Grid.Column="4"></Button>
        <Ellipse x:Name="elli" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18 ,0, 0, 0"  Visibility="Collapsed" Width="5"  Height="5" Fill="#FF3C3C" Grid.Row="1" Grid.Column="4" />

        <Button x:Name="btnRedirect" Margin="0, 0, 0, 5" Style="{DynamicResource MainPageLogouteButton}"  Width="20" Height="20" Grid.Row="1" Grid.Column="5"
                Click="btnRedirect_Click"></Button>

        <Popup x:Name="popMsg" PlacementTarget="{Binding ElementName=bdStatus}"  StaysOpen="False" Width="462" Height="Auto" PopupAnimation="Slide" AllowsTransparency="True">
            <Border x:Name="border" CornerRadius="1" BorderBrush="{DynamicResource ColorBrush.Red11}" BorderThickness="1" Background="{DynamicResource ColorBrush.Black8}">
                <Grid x:Name="grid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="81"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="tbStatus" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Bold}" Text=" X-Bond：" Visibility="Collapsed"
                                   VerticalAlignment="Center" Margin="0,4,0,0" Grid.Row="0" Grid.Column="0"  HorizontalAlignment="Right"
                               Foreground="{DynamicResource ColorBrush.While}" FontSize="{DynamicResource SmallContentFontSize}"></TextBlock>
                            <TextBlock  Grid.Row="0" Grid.Column="1" Margin="10 , 0, 0, 0" x:Name="tbStatusTxt" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}" Text="" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrush.While}" FontSize="{DynamicResource SmallContentFontSize}"></TextBlock>
                        </Grid>
                    </StackPanel>


                    <Border Grid.Row="1" BorderThickness="0, 0 ,0 ,1" BorderBrush="{DynamicResource ColorBrush.Gray20}" x:Name="BorderConnectStatus">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"></ColumnDefinition>
                                <ColumnDefinition Width="14"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="tbError" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Bold}" Text="个连线中断，请立即处理。" Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="3"
                                Height="34" Foreground="{DynamicResource ColorBrush.Red7}" FontSize="{DynamicResource SmallContentFontSize}" Padding="0, 11, 0, 0" TextAlignment="Center"></TextBlock>

                            <TextBlock x:Name="tbConStatus" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Bold}" Text="连接状态：" 
                                   VerticalAlignment="Center" Margin="10,0,0,10" Width="60" Grid.Row="1" Grid.Column="0"
                               Foreground="{DynamicResource ColorBrush.While}" FontSize="{DynamicResource SmallContentFontSize}"></TextBlock>

                            <Border x:Name="bdConStatus" CornerRadius="1" Margin="0,0,0,10" Background="{DynamicResource ColorBrush.Red7}" Width="10" Height="10" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left"></Border>
                            <TextBlock x:Name="tbConStatusTxt" Text="连接中断" Margin="0,0,0,10" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{DynamicResource ColorBrush.Red7}"
                                   Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                        </Grid>


                    </Border>

                    <Grid Grid.Row="2" Grid.Column="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <!--<RowDefinition MinHeight="30"></RowDefinition>-->
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"></ColumnDefinition>
                            <ColumnDefinition Width="14"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="服务器连接：" Grid.Column="0" Grid.Row="0" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{DynamicResource ColorBrush.Gray14}"
                                   VerticalAlignment="Center"  HorizontalAlignment="Left" Margin="10, 0, 0, 0"></TextBlock>
                        <TextBlock x:Name="tradeTX" Text="交易接口：" Grid.Column="0" Grid.Row="1" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{DynamicResource ColorBrush.Gray14}"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" Margin="22, 10, 0, 0"></TextBlock>
                        <TextBlock x:Name="priceTX" Text="行情接口：" Grid.Column="0" Grid.Row="2" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{DynamicResource ColorBrush.Gray14}"
                                   VerticalAlignment="Top"  HorizontalAlignment="Left" Margin="21, 10, 0, 0"></TextBlock>

                        <!--<TextBlock Text="内部接口：" Grid.Column="0" Grid.Row="3" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.Gray14}"
                                   VerticalAlignment="Top"  HorizontalAlignment="Left" Margin="21, 10, 0, 0"></TextBlock>-->

                        <Border x:Name="bdSTC" CornerRadius="1" Background="#00A84B" Width="10" Height="10" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left"></Border>
                        <TextBlock x:Name="tbSTC" Text="STC" FontFamily="{DynamicResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{DynamicResource ColorBrush.While}"
                                   Grid.Column="2" Grid.Row="0"  HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

                        <Grid x:Name="gridTrader" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"  MinHeight="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid x:Name="gridPrice" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" MinHeight="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <!--<Grid x:Name="gridInner" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                        </Grid>-->


                        <!--<Border x:Name="bdXBond" CornerRadius="1" Background="{StaticResource ColorBrush.Red7}" Width="10" Height="10" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left"></Border>
                        <TextBlock x:Name="tbXBond" Text="X-Bond" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.Red7}"
                                   Grid.Column="2" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

                        <Border x:Name="bdESP" CornerRadius="1" Background="{StaticResource ColorBrush.Red7}" Width="10" Height="10" Grid.Column="3" Grid.Row="1" HorizontalAlignment="Left"></Border>
                        <TextBlock x:Name="tbESP" Text="双边(ESP)" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.Red7}"
                                   Grid.Column="4" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

                        <Border x:Name="bdSOR" CornerRadius="1" Background="{StaticResource ColorBrush.Red7}" Width="10" Height="10" Grid.Column="5" Grid.Row="1" HorizontalAlignment="Left"></Border>
                        <TextBlock x:Name="tbSOR" Text="经纪商交易(SOR)" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.Red7}"
                                   Grid.Column="6" Grid.Row="1"  HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>

                        <Border x:Name="bdCDH" CornerRadius="1" Background="{StaticResource ColorBrush.Green14}" Width="10" Height="10" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left"></Border>
                        <TextBlock x:Name="tbCDH" Text="经纪商行情(CDH)" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.While}"
                                   Grid.Column="2" Grid.Row="2"  HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>-->
                    </Grid>


                </Grid>
            </Border>
        </Popup>

    </Grid>
</UserControl>
