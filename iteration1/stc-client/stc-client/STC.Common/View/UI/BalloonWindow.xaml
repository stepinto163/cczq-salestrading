<Window  x:Class="STC.Common.View.UI.BalloonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MinWidth="300" MinHeight="50" MaxWidth="360" SizeToContent="Height">
    <Border Background="{DynamicResource MainTitleBackgroup.ColorBrush}" BorderBrush="#367469" BorderThickness="2"  CornerRadius="4" Margin="0">
        <StackPanel>
            <TextBlock x:Name="TitleBlock" FontSize="10"  FontWeight="Bold" Foreground="#F5D296" Margin="4"/>
            <TextBlock x:Name="MessageBlock" TextWrapping="Wrap" FontSize="12" Margin="4,0,4,8" Foreground="#F5D296" />
        </StackPanel>
    </Border>
</Window>
