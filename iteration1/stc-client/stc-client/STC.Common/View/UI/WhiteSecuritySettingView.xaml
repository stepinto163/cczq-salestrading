<UserControl x:Class="STC.Common.View.UI.WhiteSecuritySettingView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View.UI"
             xmlns:comp="clr-namespace:STC.Common.View.Component"
             xmlns:fconv ="clr-namespace:STC.Common.Convertor"
              xmlns:ViewModel="clr-namespace:STC.Common.ViewModel.UI" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Margin="20,0,20,20">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <fconv:BlackListRTLConvertor x:Key="blackListRTLConvertor"/>
            <SolidColorBrush x:Key="TextBlockForeColor" Color="#FFFFFF"></SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>


            <SolidColorBrush x:Key="MainFormBackground" Color="#141414"/>
            <SolidColorBrush x:Key="LostFocusBorderBrush" Color="#282828"/>
            <SolidColorBrush x:Key="GetFocusBorderBrush" Color="#8F9598"/>

            <!--设置样式专用-->
            <SolidColorBrush x:Key="DataGridBorderBrush" Color="#3C3C3C"/>
            <!-- 字体 -->
            <Style TargetType="{x:Type Button}" x:Key="SelfImageButtonStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_operation_history_dark_pressed.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_operation_history_dark_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_operation_history_dark_disabled.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>

                                <DataTrigger Binding="{Binding ChkMsg}" Value="">
                                    <Setter Property="Control.Background" TargetName="background" Value="Transparent"/>
                                </DataTrigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="true"/>
            </Style>
            <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment"  Value="Center"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Padding" Value="5,0,5,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                <Grid>
                                    <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment ="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0"
                                                    HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                    VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Path x:Name="SortArrow"
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"                                           
                                                        Width="8" Height="6" Margin="2,0,0,0"
                                                        Stretch="Fill" Opacity="0.5" Fill="{TemplateBinding Foreground}"
                                                        RenderTransformOrigin="0.5,0.4"
                                                        Visibility="Collapsed"
                                                        Data="M0,0 L1,0 0.5,1 z"/>
                                    </Grid>

                                    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{DynamicResource ColumnHeaderGripperStyle}"/>
                                    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{DynamicResource ColumnHeaderGripperStyle}"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="1" Height="12" BorderBrush="#3C3C3C" BorderThickness="0 0 1 0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_LeftHeaderGripper" Property="Background">
                                <Setter.Value>
                                    <RadialGradientBrush>
                                        <GradientStop Color="Black" Offset="1"/>
                                        <GradientStop Color="White" Offset="0.5"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        -->
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SortArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"></Setter>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="Height" Value="30"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                    </Trigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.SelectedInactive.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Item.SelectedInactive.Border}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Item.SelectedActive.Border}"/>
                    </MultiTrigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Item.MouseOver.Border}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <!--<Setter Property="Padding" Value="10,0,0,0"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True" BorderBrush="{DynamicResource DataGridCellBorderBrush}" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DefaultSelfDataGrid" TargetType="DataGrid">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>

                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <!--<Setter Property="SelectionMode" Value="Single"/>
                -->
                <!-- 不需要虚拟模式 -->
                <!--<Setter Property="EnableRowVirtualization" Value="False"/>-->
                <!-- 不需要边框 -->
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="VirtualizingStackPanel.IsVirtualizing"  Value="True"/>
                <Setter Property="VirtualizingStackPanel.VirtualizationMode"  Value="Recycling"/>
                <Setter Property="BorderBrush" Value="{StaticResource DataGridBorderBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="AlternationCount" Value="1"/>
                <!--
                <Setter Property="AlternatingRowBackground" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>-->

                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
                <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}"/>
                <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DataGridBorderBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DataGridBorderBrush}"/>
            </Style>

            <Style x:Key="IsNotValid" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding enable}" Value="0">
                        <Setter Property="Foreground" Value="#A0A0A0"/>
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

          
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="64"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="TPDataGrid" AutoGenerateColumns="False"  Style="{DynamicResource DefaultSelfDataGrid}" ItemsSource="{Binding GlobalView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedIndex="{Binding SelectedIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" RowHeaderWidth="0" HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTemplateColumn  Width="106" Header="债券代码" CanUserSort="True" SortMemberPath="securityid">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock VerticalAlignment="Center" Visibility="{Binding IsCanAdded ,Converter={StaticResource reversevisibilityConvertor}}" Style="{StaticResource IsNotValid}" Text="{Binding Path=securityid}">
                                    </TextBlock>
                                    <comp:SettingSearchTextBox Visibility="{Binding IsCanAdded ,Converter={StaticResource visibilityConvertor}}"
                                        FontSize="12" Height="22"  HintText="请输入债券..." TextWidth="86" Width="86" Margin="-10,0,0,0"
                                        SearchText="{Binding securityid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F"
                                        AfterSearch="SettingSearchTextBox_AfterSearch"/>

                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Width="170" Header="黑名单类别" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock VerticalAlignment="Center" Visibility="{Binding IsCanAdded ,Converter={StaticResource reversevisibilityConvertor}}"
                                                           Text="{Binding code, Converter={StaticResource blackListRTLConvertor}}" Margin="0,0,8,0" Style="{StaticResource IsNotValid}" ToolTip="{Binding code, Converter={StaticResource blackListRTLConvertor}}"/>

                                    <ComboBox x:Name="RisCombox" SelectedValue="{Binding code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Height="22"
                                                    Visibility="{Binding IsCanAdded,Converter={StaticResource visibilityConvertor}}" 
                                                    ItemsSource="{Binding itemsource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource DefaultComboBoxStyle}"
                                                    Width="148" Margin="0,0,10,0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}" Background="#0F0F0F"
                                                    SelectedValuePath="Key" DisplayMemberPath="Value" >
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Width="178" Header="审批信息" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock VerticalAlignment="Center" Visibility="{Binding IsCanAdded ,Converter={StaticResource reversevisibilityConvertor}}" Style="{StaticResource IsNotValid}" Text="{Binding Path=message}">
                                    </TextBlock>
                                    <TextBox Visibility="{Binding IsCanAdded,Converter={StaticResource visibilityConvertor}}" Text="{Binding message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   
                                                          Height="22" Margin="-10,0,0,0" Padding="0,2,0,0" Width="158" input:InputMethod.IsInputMethodEnabled="False" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Background="#0F0F0F" PreviewKeyDown="TextBox_PreviewKeyDown">
                                    </TextBox>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                

                <DataGridTemplateColumn  Width="80" Header="修改时间"  CanUserSort="True" SortMemberPath="updatetime">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock VerticalAlignment="Center" Visibility="{Binding IsCanAdded ,Converter={StaticResource visibilityConvertor}}" Style="{StaticResource IsNotValid}" Foreground="#A0A0A0" Text="确认后显示"/>
                                    <TextBlock VerticalAlignment="Center"  Visibility="{Binding IsCanAdded ,Converter={StaticResource reversevisibilityConvertor}}" Style="{StaticResource IsNotValid}" Text="{Binding Path=updatetime}" TextWrapping="Wrap">
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn  Width="38" Header="状态"  CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <CheckBox x:Name="enableChk" IsChecked="{Binding enable,Mode=TwoWay, Converter={StaticResource booleanConvertor}, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource  GreenBlueSwitchCheckBoxStyle}"
                                              Height="16" Width="34"  IsEnabled="{Binding SaveBtnVisible, Mode=TwoWay, Converter={StaticResource booleanConvertor}, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="-10 0 0 0" IsTabStop="False"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                        Style="{DynamicResource SaveButton}" ToolTip="保存" Visibility="{Binding SaveBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.SaveRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                    <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                        Style="{DynamicResource EditButton}" ToolTip="修改"  Visibility="{Binding EditBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                    <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                        Style="{DynamicResource EditCloseButton}" ToolTip="删除或撤销修改状态" Visibility="{Binding SaveBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.DelRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>


        <Border Grid.Row="1" BorderThickness="0" BorderBrush="#A0A0A0" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"></ColumnDefinition>
                    <ColumnDefinition Width="80"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="0"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Grid.Row="0" Margin="0,0,0,0"  Content="下载黑名单" Command="{Binding DownloadFileCommand}" FontSize="12"  Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0,1,0,0"  Width="80" Height="24"/>
                <Button Grid.Column="2" Grid.Row="0" Margin="0,0,0,0"  Content="刷新黑名单"  ToolTip="刷新黑名单" Command="{Binding RefreshCommand}" 
                        FontSize="12"  Style="{DynamicResource BlueGreenStyle}" BorderThickness="0,1,0,0"  Width="80" Height="24"/>
                <!--<CheckBox Style="{StaticResource SwitchIsValidCheckBoxStyle}" Grid.Column="2" Width="32" IsChecked="True" ></CheckBox>-->
                <!--<Button Grid.Column="2" BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                                        Style="{StaticResource EditButton}" ToolTip="修改"  Visibility="{Binding EditBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" IsEnabled="{Binding IsCanSave,Converter={StaticResource  booleanConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Button>-->
                 <Button Grid.Column="4" Grid.Row="0" Margin="0,0,0,0"  Content="新增"  ToolTip="新增" IsEnabled="{Binding IsCanSave,Converter={StaticResource  booleanConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Command="{Binding AddRecordCommand}" 
                        FontSize="12"   Style="{DynamicResource BlueGreenStyle}" BorderThickness="0 1 0 0"  Width="100" Height="24"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
