  <!-- ===================== CommunityToolkit.Mvvm（全插件共享） =====================
       接入细节见 <repo>\build\Mvvm.targets 与 <repo>\nuget\README.md。
       PackageReference 显式声明在此, 让 VS 引用树可见; 构建期逻辑(LangVersion/去重/裁剪/补挂分析器)
       在 Import 的 Mvvm.targets 里。
       $(MvvmRuntimeDll) 列出运行期必需的程序集 —— 只有本工程落盘(输出目录即宿主 client\bin),
       各插件工程 Import 同一 targets 但不设该属性, 故一个都不落, 复用 bin 下这份。 -->
  <ItemGroup>
    <Compile Include="Utils\Events\EventAggregator.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <PropertyGroup>
    <!-- 运行期必需程序集白名单(v4.7.2 实测):
         System.Runtime.InteropServices.RuntimeInformation 自 4.7.1 起内置(mscorlib),无需落盘;
         Microsoft.Bcl.AsyncInterfaces 在 net472 下由 NuGet 选中 net462 资产(4.6.1 时代走 netstandard2.0 被裁剪),
         AsyncRelayCommand 的 IAsyncDisposable 运行期需要,故显式保留。 -->
    <MvvmRuntimeDll>;CommunityToolkit.Mvvm;System.Memory;System.Buffers;System.Numerics.Vectors;System.Runtime.CompilerServices.Unsafe;Microsoft.Bcl.AsyncInterfaces;</MvvmRuntimeDll>
  </PropertyGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(MSBuildThisFileDirectory)..\build\Mvvm.targets" />
