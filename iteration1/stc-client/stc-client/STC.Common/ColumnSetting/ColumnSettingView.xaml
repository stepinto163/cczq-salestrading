<xbondComp:WindowBase x:Class="STC.Common.ColumnSetting.ColumnSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.ColumnSetting"
            xmlns:xbondComp="clr-namespace:STC.Common.View.Component"
                      
             mc:Ignorable="d" Title="表头设置" SizeToContent="Height" Width="520" ResizeMode="NoResize"
             d:DesignHeight="450" d:DesignWidth="800" >

    <Window.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                --><!--<ResourceDictionary Source="/STC.MM.Plugin;component/Resources/MMThemes.xaml"/>--><!--
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <ItemsControl x:Name="ColumnListBox" Background="Transparent" Foreground="#A0A0A0" Margin="10 0 10 0">
            <ItemsControl.Template>
                <ControlTemplate>
                    <WrapPanel Background="{TemplateBinding Background}" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="30" Width="120">
                        <CheckBox Style="{DynamicResource DefaultCheckBoxStyle}" Content="{Binding ColumnName}" IsEnabled="{Binding IsEnable}"
                              IsChecked="{Binding IsVisible}" Foreground="AntiqueWhite" FontSize="14" 
                              VerticalContentAlignment="Center" Padding="10 0 10 0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--确认取消按钮区域-->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#282828" BorderThickness="0 1 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="CancelBtn" Style="{DynamicResource  GraySlateButtonStyle}" Width="60" Height="24" Content="取消" Click="CancelBtn_Click"  Foreground="#D7D7D7" BorderThickness="0 1 0 0"/>
                <Button x:Name="DefaultBtn" Style="{DynamicResource  BlueGreenStyle}" Width="100" Height="24" Content="恢复默认" Margin="10,0,0,0" Click="DefaultBtn_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0"/>
                <Button x:Name="OKBtn" Style="{DynamicResource  BlueGreenStyle}" Width="100" Height="24" Content="确认" Margin="10,0,0,0" Click="OKBtn_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0"/>
            </StackPanel>
        </Border>
    </Grid>
</xbondComp:WindowBase>
