    <Style x:Key="PopButtonStyle" TargetType="{x:Type Button}">
        <Style.Resources>
            <Style x:Key="FocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <LinearGradientBrush x:Key="Button.Static.Background" Opacity="1" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.5" Color="#AEA192"></GradientStop>
                <GradientStop Offset="1" Color="#6E645E"></GradientStop>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Button.Static.Border" Color="#FFFFFF" Opacity="0.3"/>
            <LinearGradientBrush x:Key="Button.MouseOver.Background" Opacity="1" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.5" Color="#C8BAAA"></GradientStop>
                <GradientStop Offset="1" Color="#847A73"></GradientStop>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FFFFFF" Opacity="0.3"/>
            <LinearGradientBrush x:Key="Button.Pressed.Background" Opacity="1" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.5" Color="#847A73"></GradientStop>
                <GradientStop Offset="1" Color="#C8BAAA"></GradientStop>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FFFFFF" Opacity="0.3"/>
            <SolidColorBrush x:Key="Button.Disabled.Background" Color="#4A4D4C"/>
            <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFFFFF" Opacity="0.3"/>
            <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#888C8A"/>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
