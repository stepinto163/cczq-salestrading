                                    <Image Source="/STC.Common;component/Images/stc_icon_listview2_normal.png" Height="10"/>
                                </Setter.Value>
                            </Setter>-->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--绿色图表模式 Button-->
    <Style TargetType="{x:Type ListBoxItem}" x:Key="ListChatBlueButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!--<Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="11"/>-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Background="{TemplateBinding Background}">
                            <!--<Viewbox Height="14" Width="15">-->
                                <Path x:Name="svg_path" Style="{StaticResource chart_path}"/>
                            <!--</Viewbox>-->
                        </Border>
                        <Grid>
                            <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="true">
                            <!--<Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>-->
                            <Setter TargetName="svg_path" Property="Fill" Value="{StaticResource ListBoxItem.SelectedActive.Foreground}"/>
                            <Setter Property="Background" Value="#315850"/>
                            <!--<Setter TargetName="label" Property="Content">
                                <Setter.Value>
                                    <Image Source="/STC.Common;component/Images/stc_icon_chart2_selected.png" Height="10"/>
                                </Setter.Value>
                            </Setter>-->
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!--<Setter TargetName="border" Property="Background" Value="{DynamicResource ListBoxItemSettle.SelectedActive.Background}"/>-->
                            <Setter Property="Background" Value="#315850"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <!--<Setter TargetName="label" Property="Content">
                                <Setter.Value>
                                    <Image Source="/STC.Common;component/Images/stc_icon_chart2_normal.png" Height="10"/>
                                </Setter.Value>
                            </Setter>-->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>