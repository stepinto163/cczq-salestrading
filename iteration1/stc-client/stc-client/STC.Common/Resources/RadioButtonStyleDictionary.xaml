<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="STC.SkinStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ListMode_RadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="SnapsToDevicePixels" Value="true"></Setter>
      
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid x:Name="grid" Height="24"  Width="24">
                        <Border x:Name="bg" BorderThickness="0" BorderBrush="{TemplateBinding BorderBrush}"  Margin="4">
                            <Border.Background>
                                <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_listview_normal.png"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <!--触发器：设置选中状态符号-->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter Property="Background" TargetName="bg">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_listview_seleted.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="bg">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_listview_hover.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Control.Background" TargetName="bg">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_listview_press.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" TargetName="bg">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_listview_disable.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
