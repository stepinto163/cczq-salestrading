<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin/STC.SkinStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style x:Key="GridSplitterPreviewStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Fill="#80000000"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 默认纵向分割栏 -->
    <Style x:Key="VGridSplitterStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
        <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="Transparent">
                        <Grid>
                            <Rectangle Width="1" Height="{TemplateBinding Height}" Stroke="{StaticResource GridSplitter.Separator.ColorBrush}" />
                            <Border Width="8" Height="80" Background="{DynamicResource GridSplitter.Background.ColorBrush}" CornerRadius="2">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Rectangle Width="1" Height="12" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" Margin="2,0,2,0" />
                                    <Rectangle Width="1" Height="12" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 默认横向分割栏 -->
    <Style x:Key="HGridSplitterStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
        <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Background="Transparent">
                        <Grid>
                            <Rectangle Height="1" Width="{TemplateBinding Width}" Stroke="{StaticResource GridSplitter.Separator.ColorBrush}" />
                            <Border Width="80" Height="8" Background="{DynamicResource GridSplitter.Background.ColorBrush}" CornerRadius="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <Rectangle Width="12" Height="1" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" Margin="0,2,0,2" />
                                    <Rectangle Width="12" Height="1" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
        <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Rectangle Width="1" Height="12" Stroke="Transparent" Margin="2,0,2,0"/>
                            <Rectangle Width="1" Height="12" Stroke="Transparent" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
        <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                            <Rectangle Width="12" Height="1" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" Margin="0,2,0,2"/>
                            <Rectangle Width="12" Height="1" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" Margin="0,0,0,2"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--内部看板左右分割-->
    <Style x:Key="VGridSplitterStyleNoVer" TargetType="{x:Type GridSplitter}">
        <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Rectangle Width="1" Height="12" Stroke="{DynamicResource Background}" Margin="2,0,2,0"/>
                            <Rectangle Width="1" Height="12" Stroke="{DynamicResource Background}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VGridSplitterStyle3" TargetType="{x:Type GridSplitter}">
        <Setter Property="PreviewStyle" Value="{DynamicResource GridSplitterPreviewStyle}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Rectangle Width="1" Height="12" Stroke="#515151" Margin="0,0,2,0"/>
                            <Rectangle Width="1" Height="12" Stroke="#515151" Margin="-2,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>