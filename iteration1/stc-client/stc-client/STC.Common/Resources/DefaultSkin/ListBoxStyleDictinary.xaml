    <!--列表Button-->
    <Style x:Key="ListFloatButtonStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource CommonFilterListBoxItemStyle}">
        <!--<Setter Property="Padding" Value="0"/>-->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Name="Border" CornerRadius="0" Background="Transparent">
                        <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Label.Content>
                                <Image Source="/STC.Common;component/Images/stc_icon_listview2_normal.png" Height="10"/>
                            </Label.Content>
                        </Label>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="true">
                            <Setter TargetName="label" Property="Content">
                                <Setter.Value>
                                    <Image Source="/STC.Common;component/Images/stc_icon_listview2_selected.png" Height="10"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Item.MouseOver.Background}" />
                            <Setter TargetName="label" Property="Content">
                                <Setter.Value>
                                    <Image Source="/STC.Common;component/Images/stc_icon_listview2_hover.png" Height="10"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

