    <ControlTemplate x:Key="ShowStarCheckBoxTemplate" 
                     TargetType="CheckBox">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Padding="0"
                   Visibility="Visible"
                   Name="label1"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Label.Content>
                    <Image Source="/STC.Common;component/Images/Rectangle.png"
                           Width="12"
                           Height="12" />
                </Label.Content>
            </Label>
            <Label Padding="0"
                   Visibility="Collapsed"
                   Name="label2"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Label.Content>
                    <Image Source="/STC.Common;component/Images/Check-Rectangle.png"
                           Width="12"
                           Height="12" />
                </Label.Content>
            </Label>

            <ContentPresenter Name="content"
                              Grid.Column="1"
                              ContentSource="Content"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="4,0,0,0"
                              TextElement.FontSize="12"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked"
                     Value="True">
                <Setter TargetName="label2"
                        Property="Visibility"
                        Value="Collapsed" />
                <Setter TargetName="label1"
                        Property="Visibility"
                        Value="Visible" />
                <Setter TargetName="label1"
                        Property="Content">
                    <Setter.Value>
                        <Image Source="/STC.Common;component/Images/Check-Rectangle.png"
                               Width="12"
                               Height="12" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="TitleTBFont" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="FontSize" Value="12px"/>
        <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"/>
    </Style>


    


    <Style x:Key="DataGridDefaultStyle" TargetType="DataGrid">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="Background" Value="#040B0B"/>
        <Setter Property="AlternationCount" Value="1"/>
        <Setter Property="AlternatingRowBackground" Value="#121716"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Margin" Value="10,0,0,0"/>
                    <Setter Property="Foreground">
                        <Setter.Value>
                            <SolidColorBrush Color="#FFFFFF" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background" Value="#040B0B"/>
                    <Setter Property="Height" Value="30"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#FFEBC8"></Setter>
                    <Setter Property="Background" Value="#193D37"/>
                    <Setter Property="Margin" Value="0,0,0,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Height" Value="30"/>
                    <Style.Triggers>
                        <!--<Trigger Property="AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="#121716"/>
                                </Trigger>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#0E0F0E"/>
                                </Trigger>-->
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" Value="#172422"/>
                            <Setter Property="Foreground" Value="Yellow"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="true">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#00CA8E"/>
                        </Trigger>

                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#136C5E"/>
                            <Setter Property="Foreground" Value="#FFEBC8"/>
                          
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主界面最小化按钮样式-->
    <Style TargetType="{x:Type Button}" x:Key="MainPageImageMinButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                            <Border.Background>
                                <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_system_small_normal.png"/>
                            </Border.Background>
                        </Border>
                        <Grid>
                            <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_system_small_hover.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Control.Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_system_small_press.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!--<Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Control.Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_login_setting.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

