                    </Setter.Value>
                </Setter>
            </Style>
            <SolidColorBrush x:Key="OptionMark.Checked.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="OptionMark.Checked.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="#FFF3F9FF"/>
            <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="#FF5593FF"/>
            <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="#FF212121"/>
            <SolidColorBrush x:Key="OptionMark.Disabled.Background" Color="#4A4D4C"/>
            <SolidColorBrush x:Key="OptionMark.Disabled.Foreground" Color="#888C8A"/>
            <SolidColorBrush x:Key="OptionMark.Disabled.Border" Color="#FFBCBCBC"/>
            <SolidColorBrush x:Key="OptionMark.Disabled.Glyph" Color="#FF707070"/>
            <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="#FFD9ECFF"/>
            <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="#FF3C77DD"/>
            <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="#FF212121"/>
            <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="#FF212121"/>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource OptionMark.Static.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsChecked" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="51"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="MinHeight" Value="16px"/>
        <Setter Property="MaxHeight" Value="20px"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Content" Value="关市"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid>
                        <Border x:Name="checkBoxBorder" 
                                    SnapsToDevicePixels="True"                                     
                                    CornerRadius="8" 
                                    VerticalAlignment="Stretch"
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Background="{TemplateBinding Background}" 
                                    HorizontalAlignment="Stretch"                                     
                                    >

                            <Grid x:Name="markGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="eClose"
                                        Width="12px"
                                         Height="12px"
                                         Stroke="{TemplateBinding Foreground}" 
                                             Margin="3,0,3,0"
                                         Fill="{TemplateBinding Foreground}"
                                         Grid.Column="0" 
                                         VerticalAlignment="Center" 
                                         HorizontalAlignment="Center"></Ellipse>
                                <ContentPresenter x:Name="contentPresenter" 
                                                  Grid.Column="1" 
                                                  Focusable="False" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  Margin="0" 
                                                  RecognizesAccessKey="True" 
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  VerticalAlignment="Center"
                                                      />
                                <Ellipse x:Name="eOpen"
                                             Visibility="Collapsed"
                                        Width="12px" 
                                         Height="12px"
                                         Stroke="{TemplateBinding Foreground}" 
                                         Fill="{TemplateBinding Foreground}"
                                             Margin="3,0,3,0"
                                         Grid.Column="2" 
                                         VerticalAlignment="Center" 
                                         HorizontalAlignment="Center"></Ellipse>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <!--<Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Border}"/>-->
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <!--<Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Border}"/>-->
                        </Trigger>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter Property="Content" TargetName="contentPresenter" Value="开市"/>
                            <Setter Property="HorizontalAlignment" TargetName="contentPresenter" Value="Right"/>
                            <Setter Property="Visibility" TargetName="eOpen" Value="Visible"/>
                            <Setter Property="Visibility" TargetName="eClose" Value="Collapsed"/>
                            <Setter Property="Foreground" Value="{StaticResource OptionMark.Checked.Foreground}"/>
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Checked.Background}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Disabled.Background}"/>
                            <Setter Property="Foreground" Value="{StaticResource OptionMark.Disabled.Foreground}"/>
                            <!--<Setter Property="Opacity" Value="0.7"/>-->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwitchMMCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Style.Resources>
            <Style x:Key="FocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="OptionMark.Static.Foreground" Color="#888C8A"/>
            <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#FF707070"/>
            <Style x:Key="OptionMarkFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="14,0,0,0" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <SolidColorBrush x:Key="OptionMark.Checked.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="OptionMark.Checked.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="#FFF3F9FF"/>
            <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="#FF5593FF"/>
            <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="#FF212121"/>
            <SolidColorBrush x:Key="OptionMark.Disabled.Background" Color="#4A4D4C"/>
            <SolidColorBrush x:Key="OptionMark.Disabled.Foreground" Color="#888C8A"/>
            <SolidColorBrush x:Key="OptionMark.Disabled.Border" Color="#FFBCBCBC"/>
            <SolidColorBrush x:Key="OptionMark.Disabled.Glyph" Color="#FF707070"/>
            <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="#FFD9ECFF"/>
            <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="#FF3C77DD"/>
            <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="#FF212121"/>
            <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="#FF212121"/>
        </Style.Resources>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Background" Value="#282828"/>
        <!--{StaticResource OptionMark.Static.Background}-->
        <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource OptionMark.Static.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="IsChecked" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="51"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="MinHeight" Value="16px"/>
        <Setter Property="MaxHeight" Value="20px"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid>
                        <Border x:Name="checkBoxBorder" 
                                    SnapsToDevicePixels="True"                                     
                                    CornerRadius="7" 
                                    VerticalAlignment="Stretch"
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Background="{TemplateBinding Background}" 
                                    HorizontalAlignment="Stretch"                                     
                                    >

                            <Grid x:Name="markGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="eClose"
                                        Width="12px"
                                         Height="12px"
                                         Stroke="{TemplateBinding Foreground}" 
                                         Margin="3,0,3,0"
                                         Fill="{TemplateBinding Foreground}"
                                         Grid.Column="0" 
                                         VerticalAlignment="Center" 
                                         HorizontalAlignment="Center"></Ellipse>
                                <ContentPresenter x:Name="contentPresenter" 
                                                  Grid.Column="1" 
                                                  Focusable="False" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  Margin="0" 
                                                  RecognizesAccessKey="True" 
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  VerticalAlignment="Center"
                                                      />
                                <Ellipse x:Name="eOpen"
                                             Visibility="Collapsed"
                                        Width="12px" 
                                         Height="12px"
                                         Stroke="{TemplateBinding Foreground}" 
                                         Fill="{TemplateBinding Foreground}"
                                             Margin="3,0,3,0"
                                         Grid.Column="2" 
                                         VerticalAlignment="Center" 
                                         HorizontalAlignment="Center"></Ellipse>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <!--<Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.MouseOver.Border}"/>-->
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <!--<Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Pressed.Border}"/>-->
                        </Trigger>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter Property="Content" TargetName="contentPresenter" Value=""/>
                            <Setter Property="HorizontalAlignment" TargetName="contentPresenter" Value="Right"/>
                            <Setter Property="Visibility" TargetName="eOpen" Value="Visible"/>
                            <Setter Property="Visibility" TargetName="eClose" Value="Collapsed"/>
                            <Setter Property="Foreground" Value="{StaticResource OptionMark.Checked.Foreground}"/>
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Checked.Background}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{StaticResource OptionMark.Disabled.Background}"/>
                            <Setter Property="Foreground" Value="{StaticResource OptionMark.Disabled.Foreground}"/>
                            <!--<Setter Property="Opacity" Value="0.7"/>-->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShowStarCheckBoxStyle"
           TargetType="CheckBox">
        <Setter Property="Template"
                Value="{StaticResource ShowStarCheckBoxTemplate}" />
    </Style>

    <!--渠道样式-->
    <Style x:Key="SourceTraderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <!--<Setter Property="FontWeight" Value="SemiBold"/>-->
        <Setter Property="Height" Value="24"></Setter>
        <Setter Property="Width" Value="40"></Setter>
        <Setter Property="Padding" Value="0,6,0,0"></Setter>
        <Setter Property="TextBlock.TextAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"></Setter>
        <Setter Property="FontSize" Value="10"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SourceTrader}" Value="ODM">
                <Setter Property="FontFamily" Value="MicrosoftYaHei"></Setter>
                <Setter Property="FontWeight" Value="Thin"></Setter>
                <Setter Property="Padding" Value="0,8,0,0"></Setter>
                <Setter Property="FontSize" Value="10"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--方向样式-->
    <Style x:Key="CommonSideTextBlockStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Side}" Value="2">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!--K线-->
    <Style x:Key="KLineButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="background" Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="2">
                            <Path x:Name="svg_path" Data="M4,12a1,1,0,0,1-1-1V6A1,1,0,0,1,4,5h.5V3h1V5H6A1,1,0,0,1,7,6v5a1,1,0,0,1-1,1H5.5v2h-1V12ZM6,6H4v5H6Zm4,3A1,1,0,0,1,9,8V5a1,1,0,0,1,1-1h.5V2h1V4H12a1,1,0,0,1,1,1V8a1,1,0,0,1-1,1h-.5v2h-1V9Z"
                                  UseLayoutRounding="True"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Fill="#FFEBC8" />
                            <!--<Border.Background>
                                <ImageBrush ImageSource="/STC.Common;component/Images/copy.png" Stretch="UniformToFill"/>
                            </Border.Background>-->
                        </Border>
                        <Grid>
                            <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Fill" TargetName="svg_path" Value="#F9C152"/>
                            <!--<Setter Property="Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/copy2.png" Stretch="UniformToFill"/>
                                </Setter.Value>
                            </Setter>-->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Visibility" TargetName="background" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>