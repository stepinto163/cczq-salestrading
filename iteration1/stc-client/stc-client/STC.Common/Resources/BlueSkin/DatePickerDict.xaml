    <Style x:Key="GreenBlueDatePickerBtns" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent">
                        <Image x:Name="Img"  Height="16" Width="16" Stretch="UniformToFill" Source="pack://application:,,,/STC.Common;component/Images/Public/stc_icon_calendar_normal.png"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource GreenBlueComboBoxPopup.Normal.Background}"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GreenBlueDatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource GreenBlueListBoxItem.Normal.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource GreenBlueListBoxItem.Normal.Foreground}"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <TextBox  x:Name="Back" Text="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat=yyy/MM/dd}"
                                     BorderThickness="0"  FontSize="12px" Background="{TemplateBinding Background}"
                                     Foreground="{TemplateBinding Foreground}" Padding="0, 4, 0, 0" TextAlignment="Center" FontFamily="{TemplateBinding FontFamily}"/>
                    <!--<ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource GreenBlueListBoxItem.MouseOver.Background}"></Setter>
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource GreenBlueListBoxItem.MouseOver.Border}"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>