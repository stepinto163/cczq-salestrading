<UserControl x:Class="STC.WorkTable.Plugin.View.WorkTable.HistoryIntentionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkTable.Plugin.View.WorkTable"
             xmlns:comComponent="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:command="clr-namespace:STC.WorkTable.Plugin.Command"
             xmlns:utils="clr-namespace:STC.WorkTable.Plugin.Utils"
             mc:Ignorable="d" x:Name="historyIntentionList"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="SelfFilterListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!--<Setter Property="Padding" Value="0"/>-->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <!--<Setter Property="Padding" Value="10,0,10,0"/>-->
                <!--<Setter Property="Width" Value="54"/>
                <Setter Property="Margin" Value="2, 0, 0, 0"/>-->
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="#3C3C3C" CornerRadius="2" BorderThickness="0, 1, 0, 0" VerticalAlignment="Center" Margin="0,0,0,0" 
                            BorderBrush="#515151"  Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="Cp" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedInactive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedInactive.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedActive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Border}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource ListBoxItem.SelectedActive.Foreground}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{StaticResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="32"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Background="#282828" Visibility="Collapsed" Height="25">
            <Border BorderBrush="#136C5E" BorderThickness="0 0 0 2"  Margin="8 0 0 0" Padding="4 0 4 0">
                <TextBlock Text="{Binding CurrentTotalCount_History, StringFormat={}历史需求({0})}" Foreground="#FFFFFF" Margin="0 4 0 0"/>
            </Border>
            <Rectangle Margin="8 0 8 0" Width="1" Height="16" Fill="#3C3C3C"/>
            <TextBlock Foreground="#A0A0A0" VerticalAlignment="Center">
                        共<Run Text="{Binding TotalCount_History}" Foreground="#FFFFFF"/>条需求,其中Bid<Run Text="{Binding BidCount_History}" Foreground="#FFFFFF"/>条,Ofr<Run Text="{Binding BidCount_History}" Foreground="#FFFFFF"/>条
            </TextBlock>
        </StackPanel>
        <Button x:Name="popupWindowBtn" Width="16" Height="16" Margin="0 0 6 0" Style="{StaticResource PopupButton}" HorizontalAlignment="Right"
                 Command="{x:Static utils:CommonUtils.PopupWindowCommand}" Visibility="Collapsed">
            <Button.CommandParameter>
                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                    <MultiBinding.Bindings>
                        <Binding Source="{x:Static command:PopupTypeEnum.HistoryIntentionList}" Mode="OneWay"/>
                        <Binding ElementName="historyIntentionList"/>
                    </MultiBinding.Bindings>
                </MultiBinding>
            </Button.CommandParameter>
        </Button>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ListBox x:Name="TimeSpanType" Background="Transparent" VerticalAlignment="Center" SelectionMode="Single" SelectionChanged="TimeSpanType_SelectionChanged" Width="Auto" Margin="8 0 0 0">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="今日" Style="{StaticResource SelfFilterListBoxItemStyle}" IsSelected="True" Width="56" Height="24"/>
                <ListBoxItem Content="近1周" Style="{StaticResource SelfFilterListBoxItemStyle}" Width="56" Height="24" Margin="4 0 0 0"/>
                <ListBoxItem Content="近1月" Style="{StaticResource SelfFilterListBoxItemStyle}" Width="56" Height="24" Margin="4 0 0 0"/>
            </ListBox>
            <DatePicker x:Name="dpFrom" Width="100px" Height="20" SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" Margin="10,0,0,0" SelectedDateChanged="dpFrom_SelectedDateChanged"/>
            <TextBlock Text="-" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="Auto" Height="Auto"/>
            <DatePicker x:Name="dpTo" Width="100px" Height="20" SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" Margin="5,0,0,0" SelectedDateChanged="dpTo_SelectedDateChanged"/>
            <TextBlock Text="筛选:" Margin="8 0 0 0" Width="32" VerticalAlignment="Center" Foreground="#FFFFFF"/>
            <ListBox x:Name="HistoryFilter" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended"
                             SelectionChanged="HistoryFilter_SelectionChanged" Width="Auto" Margin="8 0 0 0">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem x:Name="AllHistoryFilterItem" Content="全部" IsSelected="True" Style="{StaticResource SelfFilterListBoxItemStyle}" Width="56" Height="24"/>
                <ListBoxItem Content="同客户" Style="{StaticResource SelfFilterListBoxItemStyle}" Width="56" Height="24" Margin="4 0 0 0"/>
                <ListBoxItem Content="同券反向" Style="{StaticResource SelfFilterListBoxItemStyle}" Width="56" Height="24" Margin="4 0 0 0"/>
            </ListBox>
            <!--<comComponent:HoverButton Content="全部" Width="56" Height="24" Margin="8,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource RedButton.Static.Background}"
                                           BorderBrush="{StaticResource RedButton.Static.Border}"
                                           Foreground="{StaticResource RedButton.Static.Foreground}"
                                           PressBackground="{StaticResource RedButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource RedButton.Pressed.Border}"
                                           HoverBackground="{StaticResource RedButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource RedButton.MouseOver.Border}"/>
                    <comComponent:HoverButton Content="同客户" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
                    <comComponent:HoverButton Content="同券反向" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>-->
            <CheckBox Content="本人" IsChecked="{Binding IsMe_History, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="#A0A0A0" Padding="4 0 0 0" Style="{StaticResource DefaultCheckBoxStyle}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <comComponent:SearchTextBox x:Name="Search_TextBox_history" Grid.Column="1" HorizontalAlignment="Left" 
                                 SearchText="{Binding SearchSecurityID_History, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Width="120" Height="18" />
            <!--<Button Width="16" Height="16" Style="{StaticResource MainPageNoticeLookButton}"/>-->
            <Button Margin="8 0 0 0" Width="16" Height="16" Style="{StaticResource FilterButton}" Click="SearchBtn_Click"/>
            <comComponent:PopupEx x:Name="FilterPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchBtn}" StaysOpen="True"
                               PopupAnimation="Slide" AllowsTransparency="False" MouseLeave="FilterPopup_MouseLeave">
                <Border Width="420" Height="226" BorderBrush="#A0A0A0" BorderThickness="1" Background="#3C3C3C">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="筛选条件" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                            <!--<Button FontSize="16" Background="Transparent" 
                                    BorderThickness="0" HorizontalAlignment="Right" 
                                    Foreground="#FFFFFF"  Margin="0,0,10,0" Height="22" Width="22"
                                    Click="CloseFilterButton_Click" Style="{StaticResource ImageCloseButton}"/>-->
                        </Grid>
                        <Grid Grid.Row="1" Background="#1E1E1E">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!--债券类型-->
                            <TextBlock Text="债券类型:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <RadioButton x:Name="ShowAll_ToggleButton" Width="40" Height="18" Margin="0,0,0,0"  
                                         VerticalContentAlignment="Top" HorizontalContentAlignment="Center"
                                          IsChecked="True" Content="全部" Foreground="White" Style="{StaticResource ShowAllRadioStyle}" 
                                          Checked="ShowAll_ToggleButton_Checked"
                                             Unchecked="ShowAll_ToggleButton_Unchecked"
                                             Click="ShowAll_ToggleButton_Click"/>
                                <ListBox x:Name="InterestRateDebtListBox" Grid.Column="1" Grid.Row="0"  FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="5" ItemsSource="{Binding InterestRateDebtList_History}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                </ListBox>
                                <ListBox x:Name="CreditBondListBox" Grid.Column="1" Grid.Row="1"  FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="10" ItemsSource="{Binding CreditBondList_History}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                            <Setter Property="Margin" Value="{Binding itemMargin}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                </ListBox>
                            </Grid>

                            <!--政府性金融债-->
                            <TextBlock Grid.Row="1" Text="政策性金融债:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <ListBox x:Name="PolicyFinancialBondListBox" Grid.Row="1" Grid.Column="1" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" FontSize="10" ItemsSource="{Binding PolicyFinancialBondList_History}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding itemText}"/>
                                        <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>


                            </ListBox>

                            <!--剩余期限-->
                            <TextBlock Grid.Row="2" Text="剩余期限:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <ListBox x:Name="RemaingingTimeFilterListBox" Grid.Row="2" Grid.Column="1" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" FontSize="10" ItemsSource="{Binding RemaingingTimeList_History}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding itemText}"/>
                                        <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>

                            </ListBox>

                            <!--主题评级-->
                            <TextBlock Grid.Row="4" Text="主体评级:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <ListBox x:Name="Rating_CurrentFilterListBox" Grid.Row="4" Grid.Column="1" FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" ItemsSource="{Binding RatingList_History}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding itemText}"/>
                                        <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>

                            </ListBox>

                            <!--清算速度-->
                            <TextBlock Grid.Row="5" Text="清算速度:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <ListBox x:Name="SettlTypeFilterListBox" Grid.Row="5" Grid.Column="1" FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="4" ItemsSource="{Binding SettlTypeList_History}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding itemText}"/>
                                        <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>

                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </comComponent:PopupEx>
            <!--<Button Margin="8 0 0 0" Width="16" Height="16" Style="{StaticResource HistoryButton}"/>-->
            <Button Margin="4 0 4 0" Width="24" Height="24" Style="{StaticResource ExportButton2}" Command="{Binding ExportCommand_History}" IsEnabled="{Binding ExportEnabled_History}"/>
        </StackPanel>
        <DataGrid Grid.Row="2" x:Name="NewHistoryIntentionList_dg" Style="{StaticResource DefaultDataGrid}" RowHeight="32" ItemsSource="{Binding HistoryViewSource.View}">
            <DataGrid.Columns>
                <!--<DataGridTemplateColumn Header="选择" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" 
                                                      IsChecked="{Binding DataContext.IsAllChecked_Ignore, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->

                <DataGridTextColumn Header="客户机构" MinWidth="92" Binding="{Binding InstitutionName}"/>
                <DataGridTextColumn Header="客户名" MinWidth="92" Binding="{Binding TraderName}"/>
                <DataGridTextColumn Header="时间" MinWidth="76" Binding="{Binding CreateTime}"/>
                <DataGridTextColumn Header="代码" MinWidth="72" Binding="{Binding SecurityId}"/>
                <DataGridTextColumn Header="简称" MinWidth="52" Binding="{Binding Symbol}"/>
                <DataGridTemplateColumn Header="方向" MinWidth="52" Width="52" MaxWidth="60" CanUserSort="True" SortMemberPath="Side" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="SideTB_display" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Style="{StaticResource CommonSideTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="报价" MinWidth="68" Binding="{Binding Price, StringFormat={}{0:0.00##}}"/>
                <DataGridTextColumn Header="报量(万元)" MinWidth="76" Binding="{Binding Qty, StringFormat={}{0:0}}"/>
                <DataGridTextColumn Header="成交价" MinWidth="60" Binding="{Binding ExecutionPrice, StringFormat={}{0:0.00##}}"/>
                <DataGridTextColumn Header="PNL" MinWidth="60" Binding="{Binding PNL}"/>
                <DataGridTextColumn Header="时长" MinWidth="60" Binding="{Binding RunningTime, Converter={StaticResource MmQuoteTimeConvertor}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="10 0 0 0">
                        共<Run Text="{Binding TotalCount_History}" Foreground="#FFFFFF"/>条需求,其中Bid<Run Text="{Binding BidCount_History}" Foreground="#FFFFFF"/>条,Ofr<Run Text="{Binding BidCount_History}" Foreground="#FFFFFF"/>条
        </TextBlock>
        <comComponent:PageControl x:Name="outlinePageControl" Grid.Row="3" HorizontalAlignment="Right" 
                                          PageSize="1000"
                                          CurrentPageNum="{Binding CurrentPageNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          TotalCount="{Binding TotalCount_History, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Visibility="{Binding OutlinePageVisible,Converter={StaticResource visibilityConvertor}}"/>

        <fUI:LoadingMask  Grid.RowSpan="4"  x:Name="outlineloadMask" Visibility="Collapsed"></fUI:LoadingMask>
    </Grid>
</UserControl>
