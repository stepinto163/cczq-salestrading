<base:WindowBase x:Class="STC.WorkTable.Plugin.View.WorkTable.EndIntentionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkTable.Plugin.View.WorkTable"
             xmlns:localcomp="clr-namespace:STC.WorkTable.Plugin.View.Component"
             xmlns:base="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" MinboxEnable="False" MaxboxEnable="False" Title="结单设置"  ResizeMode="NoResize"
             Width="376" Padding="0" SizeToContent="Height" Background="Black">
    <base:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="STCDefaultBoxStyle_Ex" TargetType="TextBox" BasedOn="{StaticResource STCDefaultBoxStyle}">
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="ToolTip"
                                Value="{Binding RelativeSource={RelativeSource Self}
                            ,Path=(Validation.Errors)[0].ErrorContent}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{StaticResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </base:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="116"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!--第一行-->
        <Border Grid.ColumnSpan="2" BorderBrush="#232323" BorderThickness="1" />
        <TextBlock Text="报价路径:" Foreground="#A0A0A0" Margin="0 16 8 0" HorizontalAlignment="Right"/>
        <TextBox Grid.Column="1" Height="22" Width="260" Text="中国银行" Margin="8 13 0 0" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource STCDefaultBoxStyle_Ex}"/>
        <CheckBox Grid.Column="1" Height="24" Width="260" IsChecked="True" Content="结单自动生成报告(默认推荐)" Foreground="#FFFFFF" Padding="8 0 0 0 " Margin="8 43 0 0" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource DefaultCheckBoxStyle}"/>
        <CheckBox Grid.Column="1" Height="24" Width="260" IsChecked="True" Content="仅完成度100%生成报告" Foreground="#FFFFFF" Padding="8 0 0 0 " Margin="8 73 0 0" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource DefaultCheckBoxStyle}"/>
        <!--第二行-->
        <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="#232323" BorderThickness="1" >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK_Click">确定</Button>
            </StackPanel>
        </Border>
    </Grid>
    </base:WindowBase>