                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="方向" MinWidth="45" Width="45" MaxWidth="60" CanUserSort="True" SortMemberPath="Side">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="SideTB_display" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Width="45" Style="{StaticResource SideTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="代码" MinWidth="80" Width="100" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="SecurityIDTB" Text="{Binding SecurityId}"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecurityId}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="报价" MinWidth="70" Width="70" MaxWidth="90" CanUserSort="True" SortMemberPath="Price">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Price_Display" Text="{Binding Price, StringFormat={}{0:0.00##}}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="报量" MinWidth="70" Width="70" MaxWidth="90" CanUserSort="True" SortMemberPath="Qty">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Quantity_display" Text="{Binding Qty, StringFormat={}{0:0}}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="清算速度" MinWidth="80" Width="80" MaxWidth="145" CanUserSort="True" SortMemberPath="SettlType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="settlType_dispay" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"  FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Broker" Width="70" MinWidth="60" MaxWidth="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="QuantityTB" Width="80" Margin="5,0,0,0" Text="{Binding BrokerName}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="原文" Width="160" MinWidth="160" MaxWidth="300" CanUserSort="True" SortMemberPath="Text">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="OriginalTextTB" Margin="0,0,0,0" Text="{Binding Text}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip  DataContext="{Binding}">
                                                <TextBlock Text="{Binding Text, Converter={StaticResource subStringConverter}, ConverterParameter=250}" TextWrapping="Wrap" MaxWidth="200"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <!--<Image Margin="1,0,0,0" Source="/STC.XBond.Plugin;component/Images/stc_icon_input_search_typing.png" Width="20" Height="20" VerticalAlignment="Center"/>-->
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="处理" MinWidth="60" Width="auto" MaxWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--<TextBlock Text="{Binding Status, Converter={StaticResource EnumTypeConvertor},ConverterParameter='intentionstatus'}"/>-->
                                <Button x:Name="ReorderBtn" Content="恢复" Margin="0,0,0,0" HorizontalAlignment="Left" Width="48" Height="16" Style="{StaticResource DefaultButtonStyle}" 
                                            Command="{Binding DataContext.ReorderCommand,RelativeSource={RelativeSource AncestorType={x:Type DataGrid},Mode=FindAncestor}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" Width="Auto" MinWidth="70" MaxWidth="70"/>
                </DataGrid.Columns>
            </commonComp:ExDataGrid>
            <TextBlock Grid.Row="2" Margin="10,4,0,4" Foreground="#FFFFFF"  VerticalAlignment="Center" Grid.ColumnSpan="3">共<Run Text="{Binding TotalCount4Ignore}"/>条已忽略订单，其中Bid<Run Text="{Binding TotalCount4BidIgnore}"/>条，Ofr<Run Text="{Binding TotalCount4OfrIgnore}"/>条</TextBlock>
        </Grid>
        
    </Grid>
</UserControl>
