<UserControl x:Class="STC.WorkTable.Plugin.View.WorkTable.MyOrderDefaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkTable.Plugin.View.WorkTable"
             xmlns:comp ="clr-namespace:STC.WorkTable.Plugin.View.Component"
             xmlns:commonComp ="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:command="clr-namespace:STC.WorkTable.Plugin.Command"
             xmlns:utils="clr-namespace:STC.WorkTable.Plugin.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200" Initialized="UserControl_Initialized">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/STC.SkinStyle.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/TabControlStyleDictionary.xaml"/>-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>-->
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/CalendarStyleDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <FrameworkElement x:Key="Proxy" DataContext="{Binding}"/>

            <Style x:Key="SideTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <!-- 搜索文本框 -->
            <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{StaticResource TextBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextBox.Static.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBox.Focus.Foreground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>

                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{StaticResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!--待处理/已处理/已忽略-->
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <RadioButton x:Name="WorkingRB"
                         Style="{StaticResource BoxRadioButton}" Margin="5,0,5,0"
                         IsChecked="{Binding OrderStatusEnum,Converter={StaticResource TBookStatusEnumToBoolConvertor},ConverterParameter=0}">待处理</RadioButton>
                <RadioButton x:Name="WorkedRB"
                         Style="{StaticResource BoxRadioButton}" Margin="0,0,5,0"
                         IsChecked="{Binding OrderStatusEnum,Converter={StaticResource TBookStatusEnumToBoolConvertor},ConverterParameter=1}">已处理</RadioButton>
                <RadioButton x:Name="IgnoreRB"
                         Style="{StaticResource BoxRadioButton}" Margin="0,0,5,0"
                         IsChecked="{Binding OrderStatusEnum,Converter={StaticResource TBookStatusEnumToBoolConvertor},ConverterParameter=2}">已忽略</RadioButton>
            </StackPanel>
            <StackPanel  Grid.Column="1" Orientation="Horizontal" Margin="10 0 0 0">
                <ComboBox x:Name="SearchComboBox" Width="90" Height="18" DockPanel.Dock="Right"
                        VerticalContentAlignment="Center" SelectedIndex="0"
                        SelectionChanged ="SearchComboBox_SelectionChanged" Style="{StaticResource NonEditableComboBoxStyle}">
                    <ComboBoxItem Content="债券代码" Tag="SecurityID"/>
                    <ComboBoxItem Content="客户机构" Tag="InstitutionName"/>
                    <ComboBoxItem Content="客户名" Tag="TradeName"/>
                </ComboBox>
                <TextBox x:Name="SearchTextBox" Width="130" Margin="2,0" Height="18" Style="{StaticResource SearchTextBoxStyle}" TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0 0 10 0" HorizontalAlignment="Right" Visibility="{Binding WorkingDataGridVisibility}">

                <TextBlock Text="批量操作：" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#A0A0A0" Background="Transparent" HorizontalAlignment="Left" Width="Auto"/>
                <Button x:Name="AllConfirmBtn" Content="确认" Margin="2,0,0,0" HorizontalAlignment="Left" Width="60" Height="16" Style="{StaticResource DefaultButtonStyle}" 
                                            Command="{Binding AllConfirmCommand}" IsEnabled="{Binding ConfirmEnable}"/>
                <Button x:Name="AllQuickConfirmBtn" HorizontalAlignment="Left" Margin="2,0,0,0" Width="60" Height="16" Style="{StaticResource DefaultButtonStyle}"
                                            Command="{Binding AllQuickConfirmCommand}" IsEnabled="{Binding QuickConfirmEnable}">
                    <WrapPanel Height="16">
                        <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock Text="确认" VerticalAlignment="Center" Foreground="#FFEBC8" HorizontalAlignment="Left" Width="Auto"/>
                    </WrapPanel>
                </Button>
                <Button x:Name="AllTGBtn" Margin="2,0,0,0" Content="T/G" HorizontalAlignment="Left" Width="60" Height="16" Style="{StaticResource DefaultButtonStyle}"
                                            Command="{Binding AllTGCommand}" IsEnabled="{Binding TGEnable}" Visibility="Collapsed"/>
                <Button x:Name="AllIgnoreBtn" Margin="2,0,0,0" Content="忽略" HorizontalAlignment="Left" Width="60" Height="16" Style="{StaticResource DefaultButtonStyle}"
                                            Command="{Binding AllIgnoreCommand}" IsEnabled="{Binding IgnoreEnable}"/>
                <TextBlock />

                <Button x:Name="btnImport" ToolTip="导入" Width="24" Height="24" Margin="2,0,0,0"  HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ImportButton2}" Command="{Binding ImportCommand}" IsEnabled="{Binding BtnEnable}"/>
                <Button x:Name="btnExport" ToolTip="导出" Width="24" Height="24" Margin="2,0,0,0"  HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ExportButton2}" Command="{Binding ExportCommand}" IsEnabled="{Binding ExportEnabled}"/>
            </StackPanel>

            <Button x:Name="RecoverBtn" Content="恢复" Style="{StaticResource DefaultButtonStyle}" HorizontalAlignment="Right" Width="60" Height="18" Grid.Column="3" Margin="0 0 115 0"
                    Command="{Binding AllRecoverCommand}" Visibility="{Binding IgnoreDataGridVisibility}" IsEnabled="{Binding RecoverEnable}"/>
            <Button x:Name="QuoteIdentifyBtn"  HorizontalAlignment="Right" Width="80" Height="18" Grid.Column="3" Margin="0 0 30 0"
                        Style="{StaticResource RedButtonStyle}" Command="{Binding QuoteIdentifyCommand}">
                <WrapPanel>
                    <Image Source="/STC.WorkTable.Plugin;component/Images/stc_icon_import_normal.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="报价识别" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                </WrapPanel>
            </Button>
            <Button x:Name="btnFullScreen" Grid.Column="3" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PopupButton}" 
                    Command="{x:Static utils:CommonUtils.PopupWindowCommand}" CommandParameter="{x:Static command:PopupTypeEnum.IntentionWorkTable}" Margin="0 0 10 0"/>
        </Grid>

        <!--待处理-->
        <Grid Grid.Row="2" Visibility="{Binding WorkingDataGridVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <commonComp:ExDataGrid x:Name="WorkingDataGrid"
                      ItemsSource="{Binding WorkingViewSource.View}"
                      SelectedItem="{Binding SelectedItem_Working,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource DefaultDataGrid}" 
                      LoadingRow="DataGrid_LoadingRow" IsReadOnly="False"
                      UnloadingRow="DataGrid_UnloadingRow" SelectionMode="Single"
                  
                  BeginningEdit="WorkingDataGrid_BeginningEdit"
                  CellEditEnding="WorkingDataGrid_CellEditEnding"
                  
                  PreviewKeyDown="DataGrid_PreviewKeyDown"
                  PreparingCellForEdit="DataGrid_PreparingCellForEdit">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="选择" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" 
                                                      IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="序号" Width="Auto" MinWidth="40" MaxWidth="80" IsReadOnly="True" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="No_TB" Text="{Binding No}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="客户机构" MinWidth="115" Width="115" MaxWidth="150" CanUserSort="True" SortMemberPath="InstitutionName">
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!--编辑部分-->
                                <!--<comp:SearchComboBox x:Name="InsNameCb_edit"
                                SearchComboText="{Binding InstitutionName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                                Height="18" Padding="0, 0, 0, 0" SelectedItem="{Binding SelectedInstintuion_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Foreground="{StaticResource ColorBrush.Gray15}"  
                                BackGroundCob="{StaticResource ColorBrush.Black8}" 
                                MouseOverBorderBrushCob="{StaticResource ColorBrush.Gray15}" 
                                FocusBorderBrushCob="{StaticResource ColorBrush.Gray15 }"
                                SearchInputText="{Binding InstitutionName_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>-->
                                <comp:AutoCompleteComboBox x:Name="InsNameCb_edit" Height="18" 
                                                       DisplayValuePath="shortnamecn"
                                                       SelectedItem="{Binding SelectedInstintuion_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding InstitutionName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{StaticResource ColorBrush.Black8}" 
                                                       MouseOverBorderBrushCob="{StaticResource ColorBrush.Red7}" 
                                                       FocusBorderBrushCob="{StaticResource ColorBrush.Red7}"
                                                       Watermark="客户机构" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedInstitutionCB_PatternChanged">
                                    <comp:AutoCompleteComboBox.AutoCompColumns>
                                        <DataGridTemplateColumn Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent">
                                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Content="{Binding Text}"/>
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!--<DataGridTemplateColumn Width="240">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent">
                                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding FullName}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Content="{Binding Text}"/>
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>-->

                                    </comp:AutoCompleteComboBox.AutoCompColumns>
                                </comp:AutoCompleteComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--显示部分-->
                                <Border x:Name="InsNameBorder">
                                    <TextBlock x:Name="InsName_display" Foreground="#FFFFFF" Text="{Binding InstitutionName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstitutionName}"></TextBlock>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!--没有客户机构-->
                                    <DataTrigger Binding="{Binding InstitutionName,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                        <Setter TargetName="InsNameBorder" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="InsNameBorder" Property="BorderBrush" Value="red"/>
                                        <Setter TargetName="InsName_display" Property="Text" Value="客户机构"/>
                                        <Setter TargetName="InsName_display" Property="Foreground" Value="#3C3C3C"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="客户名" MinWidth="115" Width="115" MaxWidth="150" CanUserSort="True" SortMemberPath="TraderName">
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!--编辑部分-->
                                <!--<comp:SearchTradComboBox x:Name="TrdNameCb_edit" SearTradchComboText="{Binding TraderName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="12" BackGroundCob="{StaticResource SearchCombobox.Backgroud.ColorBrush }" Height="18"
                                     Padding="0, 0, 0, 0" Foreground="{StaticResource ColorBrush.Gray15}" Background="{ StaticResource ColorBrush.Black8}" 
                                     MouseOverBorderBrushCob="{StaticResource ColorBrush.Gray15}" FocusBorderBrushCob="{StaticResource ColorBrush.Gray15 }"
                                    SelectedItem="{Binding SelectedTrader_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SearchtradInputText="{Binding TraderName_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>-->

                                <comp:AutoCompleteComboBox x:Name="TrdNameCb_edit" Height="18" 
                                                       DisplayValuePath="namecn"
                                                       SelectedItem="{Binding SelectedTrader_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding TraderName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{StaticResource ColorBrush.Black8}" 
                                                       MouseOverBorderBrushCob="{StaticResource ColorBrush.Red7}" 
                                                       FocusBorderBrushCob="{StaticResource ColorBrush.Red7}"
                                                       Watermark="客户名" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedUserIDCB_PatternChanged">
                                    <comp:AutoCompleteComboBox.AutoCompColumns>
                                        <DataGridTemplateColumn MinWidth="100" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent">
                                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding namecn}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Content="{Binding Text}"/>
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </comp:AutoCompleteComboBox.AutoCompColumns>
                                </comp:AutoCompleteComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--显示部分-->
                                <Border x:Name="TrdNameBorder">
                                    <TextBlock x:Name="TrdNameLb_display" Foreground="#FFFFFF" Text="{Binding TraderName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TraderName}"></TextBlock>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!--没有客户名-->
                                    <DataTrigger Binding="{Binding TraderName,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                        <Setter TargetName="TrdNameBorder" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="TrdNameBorder" Property="BorderBrush" Value="red"/>
                                        <Setter TargetName="TrdNameLb_display" Property="Text" Value="客户名"/>
                                        <Setter TargetName="TrdNameLb_display" Property="Foreground" Value="#3C3C3C"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="方向" MinWidth="55" Width="55" MaxWidth="60" CanUserSort="True" SortMemberPath="Side">
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!--编辑部分-->
                                <ComboBox x:Name="cbSide_edit" Height="18" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding DataContext.SideDic,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" 
                                          DisplayMemberPath="Value"  SelectedValuePath="Key" Grid.Column="2"
                                          SelectedValue="{Binding Side_Edit,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{StaticResource NonEditableComboBoxStyle}"
                                      FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--显示部分-->
                                <Border x:Name="SideBorder">
                                    <TextBlock x:Name="SideTB_display" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Width="45" Style="{StaticResource SideTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!--没有方向-->
                                    <DataTrigger Binding="{Binding Side,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                        <Setter TargetName="SideBorder" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="SideBorder" Property="BorderBrush" Value="red"/>
                                        <Setter TargetName="SideTB_display" Property="Text" Value="方向"/>
                                        <Setter TargetName="SideTB_display" Property="Foreground" Value="#3C3C3C"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="代码" MinWidth="80" Width="100" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="SecurityIDTB" Text="{Binding SecurityId}"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecurityId}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="报价" MinWidth="70" Width="70" MaxWidth="90" CanUserSort="True" SortMemberPath="Price">
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!--编辑部分-->
                                <commonComp:NumericUpDown x:Name="PriceNU_Edit" NumericValue="{Binding Price_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                    MinValue="0" MaxValue="999999999999" DecimalLength="4" RangeValue="0.0025" VerticalAlignment="Center"
                                                Loaded="PriceNU_Edit_Loaded"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="PriceBorder">
                                    <!--显示部分-->
                                    <TextBlock x:Name="Price_Display" Text="{Binding Price, StringFormat={}{0:0.00##}}" VerticalAlignment="Center"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Price,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                        <Setter TargetName="PriceBorder" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="PriceBorder" Property="BorderBrush" Value="red"/>
                                        <Setter TargetName="Price_Display" Property="Text" Value="--"/>
                                        <Setter TargetName="Price_Display" Property="Foreground" Value="#3C3C3C"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="报量" MinWidth="70" Width="70" MaxWidth="90" CanUserSort="True" SortMemberPath="Qty">
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!--编辑部分-->
                                <commonComp:NumericUpDown x:Name="QuantityNU_edit" NumericValue="{Binding Qty_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                    MinValue="1000" MaxValue="100000000" DecimalLength="0" RangeValue="1000" VerticalAlignment="Center"
                                                FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                                Loaded="QuantityNU_edit_Loaded"  LostFocus="QuantityNU_edit_LostFocus" ToolTip="输入范围:1000-100000000;且是1000的倍数"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="QtyBorder">
                                    <!--显示部分-->
                                    <TextBlock x:Name="Quantity_display" Text="{Binding Qty, StringFormat={}{0:0}}" VerticalAlignment="Center"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Qty,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                        <Setter TargetName="QtyBorder" Property="BorderThickness" Value="1"/>
                                        <Setter TargetName="QtyBorder" Property="BorderBrush" Value="red"/>
                                        <Setter TargetName="Quantity_display" Property="Text" Value="--"/>
                                        <Setter TargetName="Quantity_display" Property="Foreground" Value="#3C3C3C"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="清算速度" MinWidth="80" Width="80" MaxWidth="145" CanUserSort="True" SortMemberPath="SettlType">
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <!--编辑部分-->
                                <comp:SettleTypeSelector SettleType="{Binding SettlType_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"
                                                     CreateTime="{Binding CreateTime}"
                                                     FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
                                <!--<StackPanel x:Name="settltype_panel_edit" Orientation="Horizontal">
                                <DatePicker x:Name="datePicker" Width="70" Height="24" 
                                                
                                        SelectedDate="{Binding edit_settltype_date,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Style="{StaticResource SettlTypeDatePickerStyle}"
                                            CalendarStyle="{StaticResource BlackRed_CalendarStyle}">
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                                <ComboBox x:Name="cbSettle" Width="60"  Height="24"  Margin="1,0,0,0" VerticalContentAlignment="Center"
                                                SelectedIndex="{Binding edit_settletype,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Style="{StaticResource NonEditableComboBoxStyle}">
                                    <ComboBoxItem Content="T+0" Tag="1"></ComboBoxItem>
                                    <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>
                                </ComboBox>
                            </StackPanel>-->
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="settlTypeBorder">
                                    <!--显示部分-->
                                    <TextBlock x:Name="settlType_dispay" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"  FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                                <DataTemplate.Triggers>
