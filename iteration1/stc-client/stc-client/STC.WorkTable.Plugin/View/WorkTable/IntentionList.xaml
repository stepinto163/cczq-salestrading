<UserControl x:Class="STC.WorkTable.Plugin.View.WorkTable.IntentionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkTable.Plugin.View.WorkTable"
             xmlns:comComponent="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:command="clr-namespace:STC.WorkTable.Plugin.Command"
             xmlns:utils="clr-namespace:STC.WorkTable.Plugin.Utils"
             mc:Ignorable="d" x:Name="intentionList"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <!--状态样式-->
            <Style x:Key="StatusTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="5">
                        <Setter Property="Foreground" Value="#00CA8E" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="4">
                        <Setter Property="Foreground" Value="#F08A2B" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Background="#282828">
            <Border BorderBrush="#136C5E" BorderThickness="0 0 0 2" Padding="4 0 4 0" Margin="8 0 0 0">
                <TextBlock Text="{Binding CurrentTotalCount, StringFormat={}需求列表({0})}" Foreground="#FFFFFF" Margin="0 4 0 0"/>
            </Border>
            <Rectangle Margin="8 0 8 0" Width="1" Height="16" Fill="#3C3C3C"/>
            <TextBlock Foreground="#A0A0A0" VerticalAlignment="Center">
                        共<Run Text="{Binding TotalCount}" Foreground="#FFFFFF"/>条需求,其中Bid<Run Text="{Binding BidCount}" Foreground="#FFFFFF"/>条,Ofr<Run Text="{Binding OfrCount}" Foreground="#FFFFFF"/>条
            </TextBlock>
        </StackPanel>
        <Button x:Name="popupWindowBtn" Width="16" Height="16" Margin="0 0 6 0" Style="{StaticResource PopupButton}" HorizontalAlignment="Right"
                Command="{x:Static utils:CommonUtils.PopupWindowCommand}">
            <Button.CommandParameter>
                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                    <MultiBinding.Bindings>
                        <Binding Source="{x:Static command:PopupTypeEnum.IntentionList}" Mode="OneWay"/>
                        <Binding ElementName="intentionList"/>
                    </MultiBinding.Bindings>
                </MultiBinding>
            </Button.CommandParameter>
        </Button>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <comComponent:HoverButton Content="报价识别" Width="80" Height="24" Margin="8,0,0,0" HorizontalAlignment="Left"
                                           Command="{Binding QuoteIdentifyCommand}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource RedButton.Static.Background}"
                                           BorderBrush="{StaticResource RedButton.Static.Border}"
                                           Foreground="{StaticResource RedButton.Static.Foreground}"
                                           PressBackground="{StaticResource RedButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource RedButton.Pressed.Border}"
                                           HoverBackground="{StaticResource RedButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource RedButton.MouseOver.Border}"/>
            <comComponent:HoverButton x:Name="StartAndStopAllBtn" Content="{Binding StopAllBtnText}" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Command="{Binding StopAllCommand}"  IsEnabled="{Binding StopAllBtnEnable}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
            <comComponent:HoverButton Content="结单" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Command="{Binding EndCommand}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
            <TextBlock Text="操作:" Margin="12 0 0 0" Width="32" Foreground="#FFFFFF" VerticalAlignment="Center" TextAlignment="Center"/>
            <comComponent:HoverButton Width="56" Height="24" HorizontalAlignment="Left"
                                           Command="{Binding DoFirmOrderCommand}" CommandParameter="All" IsEnabled="{Binding DoFirmOrderBtnEnable}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                <WrapPanel Height="12">
                    <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="全部" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                </WrapPanel>
            </comComponent:HoverButton>
            <comComponent:HoverButton Width="56" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"
                                              Command="{Binding DoFirmOrderCommand}" CommandParameter="1000" IsEnabled="{Binding DoFirmOrderBtnEnable}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                <WrapPanel Height="12">
                    <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="1000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                </WrapPanel>
            </comComponent:HoverButton>
            <comComponent:HoverButton Width="56" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"
                                              Command="{Binding DoFirmOrderCommand}" CommandParameter="3000" IsEnabled="{Binding DoFirmOrderBtnEnable}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                <WrapPanel Height="12">
                    <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="3000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                </WrapPanel>
            </comComponent:HoverButton>
            <comComponent:HoverButton Width="56" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"
                                              Command="{Binding DoFirmOrderCommand}" CommandParameter="5000" IsEnabled="{Binding DoFirmOrderBtnEnable}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                <WrapPanel Height="12">
                    <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="5000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                </WrapPanel>
            </comComponent:HoverButton>
            <comComponent:HoverButton Width="56" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"
                                              Command="{Binding DoFirmOrderCommand}" CommandParameter="" IsEnabled="{Binding DoFirmOrderBtnEnable}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                <WrapPanel Height="12">
                    <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="报价" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                </WrapPanel>
            </comComponent:HoverButton>
            <TextBlock Text="状态:" Margin="8 0 0 0" Width="32" VerticalAlignment="Center" Foreground="#FFFFFF"/>
            <ComboBox Width="64" Height="24" ItemsSource="{Binding StatusDic}" SelectedValue="{Binding SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" DisplayMemberPath="Value" VerticalContentAlignment="Center" Style="{StaticResource NonEditableBorderComboBoxStyle}"/>
            <CheckBox Content="本人" IsChecked="{Binding IsMe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="#A0A0A0" Padding="4 0 0 0" Style="{StaticResource DefaultCheckBoxStyle}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <!--<Button Width="16" Height="16" Style="{StaticResource MainPageNoticeLookButton}"/>-->
            <comComponent:SearchTextBox x:Name="Search_TextBox" Grid.Column="1" HorizontalAlignment="Left" 
                                 SearchText="{Binding SearchSecurityID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Width="120" Height="18" />
            <Button Margin="8 0 0 0" Width="16" Height="16" Style="{StaticResource FilterButton}" Click="SearchBtn_Click"/>
            <comComponent:PopupEx x:Name="FilterPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchBtn}" StaysOpen="True"
                               PopupAnimation="Slide" AllowsTransparency="False" MouseLeave="FilterPopup_MouseLeave">
                <Border Width="420" Height="226" BorderBrush="#A0A0A0" BorderThickness="1" Background="#3C3C3C">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="筛选条件" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                            <!--<Button FontSize="16" Background="Transparent" Height="22" Width="22"
                                    BorderThickness="0" HorizontalAlignment="Right" 
                                    Foreground="#FFFFFF"  Margin="0,0,10,0"
                                    Click="CloseFilterButton_Click" Style="{StaticResource ImageCloseButton}"/>-->
                        </Grid>
                        <Grid Grid.Row="1" Background="#1E1E1E">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!--债券类型-->
                            <TextBlock Text="债券类型:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <RadioButton x:Name="ShowAll_ToggleButton" Width="40" Height="18" Margin="0,0,0,0"  
                                         VerticalContentAlignment="Top" HorizontalContentAlignment="Center"
                                          IsChecked="True" Content="全部" Foreground="White" Style="{StaticResource ShowAllRadioStyle}" 
                                          Checked="ShowAll_ToggleButton_Checked"
                                             Unchecked="ShowAll_ToggleButton_Unchecked"
                                             Click="ShowAll_ToggleButton_Click"/>
                                <ListBox x:Name="InterestRateDebtListBox" Grid.Column="1" Grid.Row="0"  FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="5" ItemsSource="{Binding InterestRateDebtList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                </ListBox>
                                <ListBox x:Name="CreditBondListBox" Grid.Column="1" Grid.Row="1"  FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="10" ItemsSource="{Binding CreditBondList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                            <Setter Property="Margin" Value="{Binding itemMargin}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                </ListBox>
                            </Grid>

                            <!--政府性金融债-->
                            <TextBlock Grid.Row="1" Text="政策性金融债:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <ListBox x:Name="PolicyFinancialBondListBox" Grid.Row="1" Grid.Column="1" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" FontSize="10" ItemsSource="{Binding PolicyFinancialBondList}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding itemText}"/>
                                        <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>


                            </ListBox>

                            <!--剩余期限-->
                            <TextBlock Grid.Row="2" Text="剩余期限:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <ListBox x:Name="RemaingingTimeFilterListBox" Grid.Row="2" Grid.Column="1" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" FontSize="10" ItemsSource="{Binding RemaingingTimeList}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding itemText}"/>
                                        <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>

                            </ListBox>

                            <!--主题评级-->
                            <TextBlock Grid.Row="4" Text="主体评级:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <ListBox x:Name="Rating_CurrentFilterListBox" Grid.Row="4" Grid.Column="1" FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" ItemsSource="{Binding RatingList}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding itemText}"/>
                                        <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>

                            </ListBox>

                            <!--清算速度-->
                            <TextBlock Grid.Row="5" Text="清算速度:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                            <ListBox x:Name="SettlTypeFilterListBox" Grid.Row="5" Grid.Column="1" FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="4" ItemsSource="{Binding SettlTypeList}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding itemText}"/>
                                        <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>

                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </comComponent:PopupEx>

            <Button Margin="4 0 4 0" Width="24" Height="24" Style="{StaticResource ExportButton2}" Command="{Binding ExportCommand}" IsEnabled="{Binding ExportEnabled}"/>
        </StackPanel>
        <comComponent:ExDataGrid x:Name="NewIntentionList_dg" Grid.Row="2" Style="{StaticResource DefaultDataGrid}" RowHeight="32"
                          ItemsSource="{Binding WorkedViewSource.View}" SelectionChanged="dg_SelectionChanged"
                          SelectedItem="{Binding SelectedItem_Worked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选择" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" 
                                                      IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="80" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!--<Button x:Name="StartStopBtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                        PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown">
                                            
                                        </Button>-->
                                <CheckBox x:Name="StartStopBtn" IsChecked="{Binding enable,Mode=OneWay}"  Style="{StaticResource SwitchMMCheckBoxStyle}" Height="16" Width="34" Foreground="#3C3C3C" 
                                                 PreviewMouseLeftButtonDown="CheckBox_PreviewMouseLeftButtonDown" Margin="4 0 0 0" IsTabStop="False"/>
                                <Button x:Name="DelBtn"  Height="18" Width="18" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DelOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                        FontSize="10" Style="{StaticResource DetailButton}"
                                                        IsEnabled="{Binding EnabledBtn}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"/>
                                <Button x:Name="detailBtn" Grid.Column="1" HorizontalAlignment="Right" Width="12" Height="12"  BorderThickness="0" Style="{StaticResource OpenSecurityButton}"
                                        ToolTip="查看行情小窗" Click="detailBtn_Click"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="5">
                                    <Setter TargetName="StartStopBtn" Property="IsEnabled" Value="false"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="需求ID" MinWidth="92" Binding="{Binding IntentionId}"/>
                <DataGridTextColumn Header="代码" MinWidth="76" Binding="{Binding SecurityId}"/>
                <DataGridTextColumn Header="简称" MinWidth="72" Binding="{Binding Symbol}"/>
                <DataGridTemplateColumn Header="方向" MinWidth="52" Width="52" MaxWidth="60" CanUserSort="True" SortMemberPath="Side" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="SideTB_display" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Style="{StaticResource CommonSideTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="报价(%)" MinWidth="68" Binding="{Binding Price, StringFormat={}{0:0.00##}}"/>
                <DataGridTextColumn Header="报量(万元)" MinWidth="68" Binding="{Binding Qty, StringFormat={}{0:0}}"/>
                <DataGridTextColumn Header="成交量(万元)" MinWidth="76" Binding="{Binding BookQty, StringFormat={}{0:0}}"/>
                <DataGridTextColumn Header="清算速度" MinWidth="60" Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"/>
                <DataGridTextColumn Header="经纪人" MinWidth="60" Binding="{Binding NikeName}"/>
                <DataGridTextColumn Header="客户机构" MinWidth="60" Binding="{Binding InstitutionName}"/>
                <DataGridTextColumn Header="客户名" MinWidth="60" Binding="{Binding TraderName}"/>
                <DataGridTextColumn Header="完成度" MinWidth="52" Binding="{Binding CompleteRate, StringFormat={}{0}%}"/>
                <DataGridTemplateColumn Header="状态" MinWidth="70" Width="70" MaxWidth="90" CanUserSort="True" SortMemberPath="Status" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="StatusTB_display" Text="{Binding Status,Converter={StaticResource EnumTypeConvertor},ConverterParameter='intentionstatus1'}" Style="{StaticResource StatusTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </comComponent:ExDataGrid>
    </Grid>
</UserControl>
