<UserControl x:Class="STC.WorkTable.Plugin.View.WorkTable.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkTable.Plugin.View.WorkTable"
             xmlns:panel="clr-namespace:STC.WorkTable.Plugin.View.IntentionPanel"
             xmlns:comUtils="clr-namespace:STC.Common.Utils;assembly=STC.Common"
             xmlns:myTrading="clr-namespace:STC.Common.View.MyTrading;assembly=STC.Common"
             xmlns:command="clr-namespace:STC.WorkTable.Plugin.Command"
             xmlns:utils="clr-namespace:STC.WorkTable.Plugin.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--绿色样式-->
            <Style x:Key="SplitButtonStyle" TargetType="{x:Type Button}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="#136C5E"/>
                <!--<Setter Property="BorderBrush" Value="#00D198"/>-->
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderThickness" Value="0, 0, 0, 0"/>
                <!--<Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="80"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#146C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#2CAB97"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#1C4B43"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Pressed.Border}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource RedButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource RedButton.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--下划线TabItem-->
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TabItem.Unselected.Foreground}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                                <Border x:Name="Border" Background="Transparent" CornerRadius="2,2,2,2" BorderThickness="0,0,0,2" BorderBrush="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite"
                                                      HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      Margin="{TemplateBinding Padding}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                      VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      ContentSource="Header" 
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                      TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                      TextBlock.FontSize="{TemplateBinding FontSize}"
                                                      RecognizesAccessKey="True">
                                            <ContentPresenter.LayoutTransform>
                                                <RotateTransform Angle="0" />
                                            </ContentPresenter.LayoutTransform>
                                        </ContentPresenter>
                                        <Ellipse x:Name="elli" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10 ,4, 0, 0" Width="5" Visibility="{TemplateBinding Tag, Converter={StaticResource SettleVisibilityConvertor}}" Height="5" Fill="#FF3C3C" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="Top"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource TabItem.Static.Border}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="SemiBold"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="intentionGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="9"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="9"/>
            <ColumnDefinition Width="282"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="9"/>
            <RowDefinition Height="400"/>
        </Grid.RowDefinitions>

        <!-- IM请求 -->
        <Border BorderBrush="#282828" Grid.RowSpan="3">
            <local:TradeRequestView/>
        </Border>

        <Border  Grid.Column="1" Grid.RowSpan="3">
            <Button x:Name="btnVerLeft" Height="40" Padding="0, 0, 0, 0" Margin="1, 0, 1, 0" Content="&lt;" 
                FontSize="8" Style="{StaticResource SplitButtonStyle}"  Panel.ZIndex="1" Click="btnVerLeft_Click"></Button>
        </Border>

        <!-- 需求列表 -->
        <Border Grid.Column="2" BorderBrush="#282828" BorderThickness="1 0 1 1" >
            <local:IntentionList SelectionChanged="IntentionList_SelectionChanged"/>
        </Border>

        <Button x:Name="btnHorBottom" Grid.Column="2" Grid.Row="1" Width="40"  Content="∨" FontSize="6" Padding="0 -1 0 1" Style="{StaticResource SplitButtonStyle}"
                Margin="0, 1, 0, 1" Panel.ZIndex="1" Click="BtnHorBottom_Click"></Button>
        <!-- gridSplitter -->
        <GridSplitter x:Name="gridSplitter" Background="Transparent" Grid.Column="2" Grid.Row="1" Style="{StaticResource HGridSplitterStyle2}"/>

        
        <Border Grid.Column="2" Grid.Row="2" Margin="0 2 0 0" BorderBrush="#282828" BorderThickness="1" >
            <TabControl x:Name="TradeInfo_tabControl"   Style="{StaticResource TabControlStyle1}"  Background="{StaticResource MainBackgroup.ColorBrush}" SelectionChanged="TradeInfo_tabControl_SelectionChanged" MinHeight="60">
                <!-- 历史需求列表-->
                <TabItem x:Name="historyIntentionList_TabItem" Header="历史需求" Width="100">
                    <local:HistoryIntentionList x:Name="historyIntentionList"/>
                </TabItem>
                <!--我的订单-->
                <TabItem x:Name="MyOrders_TabItem" Header="{Binding ElementName=myOrdersPart,Path=TotalCountOrderHeader}" Width="100" Tag="{Binding ElementName=myOrdersPart, Path=IsMyOrdersShowRedDot}">
                    <myTrading:MyOrders x:Name="myOrdersPart"/>
                </TabItem>
                <!--我的成交-->
                <TabItem x:Name="MyExes_TabItem" Header="{Binding ElementName=myExesPart, Path=TotalCountExecutionsHeader}" Width="100" Tag="{Binding Path=IsMyExecutionsShowRedDot,ElementName=myExesPart}">
                    <myTrading:MyExes x:Name="myExesPart"/>
                </TabItem>
            </TabControl>
        </Border>

        <Button x:Name="btnHistory"  Grid.Column="2" Grid.Row="2" Width="12" Height="12" Margin="0 10 34 0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource HistoryButton}" Click="btnHistory_Click" Visibility="Collapsed"/>
        <Button x:Name="btnFullScreen" Grid.Column="2" Grid.Row="2" Width="12" Height="12" Margin="0 10 10 0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PopupButton}" />
        <!--<Button x:Name="popupWindowBtn" Grid.Column="2" Grid.Row="2" Width="16" Height="16" VerticalAlignment="Top" Margin="0 6 10 0" Style="{StaticResource PopupButton}" HorizontalAlignment="Right"
                Command="{x:Static utils:CommonUtils.PopupWindowCommand}">
            <Button.CommandParameter>
                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                    <MultiBinding.Bindings>
                        <Binding Source="{x:Static command:PopupTypeEnum.IntentionList}" Mode="OneWay"/>
                        <Binding ElementName="intentionList"/>
                    </MultiBinding.Bindings>
                </MultiBinding>
            </Button.CommandParameter>
        </Button>-->

        <Border Grid.Column="3" Grid.RowSpan="3">
            <Button x:Name="btnVer" Height="40" Padding="0, 0, 0, 0" Margin="1, 0, 1, 0" Content="&gt;" 
                FontSize="8" Style="{StaticResource SplitButtonStyle}"  Panel.ZIndex="1" Click="BtnVer_Click"></Button>
        </Border>
       

        <Border x:Name="intentionPanel_border" Grid.Column="4" Grid.RowSpan="3" BorderBrush="#282828" BorderThickness="1 0 1 1">
            <panel:IntentionPanel x:Name="intentionPanel"/>
        </Border>
    </Grid>
</UserControl>
