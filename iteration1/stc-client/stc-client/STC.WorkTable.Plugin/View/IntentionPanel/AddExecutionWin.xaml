<comComp:WindowBase x:Class="STC.WorkTable.Plugin.View.IntentionPanel.AddExecutionWin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkTable.Plugin.View.IntentionPanel"
             xmlns:comp="clr-namespace:STC.WorkTable.Plugin.View.Component"
             xmlns:comComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:val="clr-namespace:STC.WorkTable.Plugin.Validation"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             mc:Ignorable="d" Title="STC成交单" MaxboxEnable="False" MinboxEnable="False" ResizeMode="NoResize"
             Height="450" Width="850" x:Name="RelateExecWin">
    <comComp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DatePickerDict.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            
            <ControlTemplate x:Key="ErrorTemplate">
                <Border BorderBrush="Red"
                        BorderThickness="1">
                    <Grid>
                        <Path Data="M 0,0 L 8,0 L 8,8 Z" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Top"
                              Fill="Red"
                              ToolTip="{Binding ElementName=adorner,Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>
                        <AdornedElementPlaceholder Name="adorner"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </ResourceDictionary>
    </comComp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition/>
            <RowDefinition Height="32"/>
            <RowDefinition/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>
        <TextBlock Text="关联STC成交单" Foreground="#A0A0A0" VerticalAlignment="Bottom" Margin="21 0 0 4"/>
        <DataGrid Grid.Row="1" Style="{StaticResource DefaultDataGrid}" RowHeight="32" Margin="21 0 21 0" GridLinesVisibility="All" 
                  ItemsSource="{Binding STCExecsViewSource.View}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选择" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click"
                                                      IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk" Checked="Selected_Chk_Click" Unchecked="Selected_Chk_Unchecked" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="对手机构" MinWidth="72" Binding="{Binding CounterPartyName}"/>
                <DataGridTextColumn Header="对手方" MinWidth="64" Binding="{Binding CounterPartySubName}"/>
                <DataGridTextColumn Header="成交价" MinWidth="64" Binding="{Binding Price,StringFormat={}{0:0.00##}}"/>
                <DataGridTextColumn Header="成交日期" MinWidth="64" Binding="{Binding TransactTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}"/>
                <DataGridTextColumn Header="清算速度" MinWidth="64" Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"/>
                <DataGridTemplateColumn Header="簿记量" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <comComp:NumericUpDown x:Name="ExeQtyNU_edit" NumericValue="{Binding BookQty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                    MinValue="1000" MaxValue="{Binding RemainQty}" DecimalLength="0" RangeValue="1000" VerticalAlignment="Center" NumBorderBrush ="#3C3C3C"
                                                FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" Height="24" ValueChanged="ExeQtyNU_edit_ValueChanged"
                                                Loaded="ExeQtyNU_edit_Loaded" ToolTip="输入范围:小于等于剩余报量;且是1000的倍数"/>
                            <!--<TextBox Text="{Binding ExeQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource  STCDefaultBoxStyle}"/>-->
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="剩余量" MinWidth="64" Binding="{Binding RemainQty, StringFormat={}{0:0}}"/>
                <DataGridTextColumn Header="成交单号" Width="Auto" MinWidth="150" Binding="{Binding ExecId}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="成交录入" Foreground="#A0A0A0" VerticalAlignment="Bottom" Margin="21 0 0 4"/>
        <DataGrid Grid.Row="3" Style="{StaticResource DefaultDataGrid}" RowHeight="32" Margin="21 0 21 0" GridLinesVisibility="All" 
                  ItemsSource="{Binding CustomExecsViewSource.View}" SelectedItem="{Binding SelectedRow_Custom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <i:Interaction.Behaviors>
                <val:ValidationErrorBehavior />
            </i:Interaction.Behaviors>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="操作" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Button Width="16" Height="16" Command="{Binding DataContext.AddCustomCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border CornerRadius="8" Background="#00CDAD">
                                            <TextBlock Text="+" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="16" Height="16" Command="{Binding DataContext.DeleteCustomCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border CornerRadius="8" Background="#00CDAD">
                                            <TextBlock Text="-" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="对手机构" MinWidth="110" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Height="24" Style="{StaticResource STCDefaultBoxStyle}" Validation.ErrorTemplate="{StaticResource ErrorTemplate}">
                                <TextBox.Text>
                                    <Binding Path="CounterPartyName" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" ValidatesOnNotifyDataErrors="True">
                                        <Binding.ValidationRules>
                                            <val:ValidationForAddExecution ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="对手方" MinWidth="110" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Height="24" Style="{StaticResource STCDefaultBoxStyle}" Validation.ErrorTemplate="{StaticResource ErrorTemplate}">
                                <TextBox.Text>
                                    <Binding Path="CounterPartySubName" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" ValidatesOnNotifyDataErrors="True">
                                        <Binding.ValidationRules>
                                            <val:ValidationForAddExecution ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="成交价" MinWidth="100" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <comComp:NumericUpDown x:Name="PriceNU_Edit" Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                                   NumBorderBrush ="#3C3C3C"
                                                MinValue="0" MaxValue="999999999999" DecimalLength="4" RangeValue="0.0025" VerticalAlignment="Center" Height="24"
                                            Loaded="PriceNU_Edit_Loaded">
                                <comComp:NumericUpDown.NumericValue>
                                    <Binding Path="Price" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" ValidatesOnNotifyDataErrors="True">
                                        <Binding.ValidationRules>
                                            <val:ValidationForAddExecution ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </comComp:NumericUpDown.NumericValue>
                            </comComp:NumericUpDown>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTemplateColumn Header="交易日期" MinWidth="120" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker x:Name="ExecutionTime_dp" Width="100px" Height="24" 
                                                    SelectedDate="{Binding TradeDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource DefaultDatePickerStyle}" 
                                                    VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTemplateColumn Header="清算速度" MinWidth="120" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <comp:SettleTypeSelector Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                            CreateTime="{Binding TradeDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="24"
                                            FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">
                                <comp:SettleTypeSelector.SettleType>
                                    <Binding Path="SettlType" Mode="TwoWay" Converter='{StaticResource EnumTypeConvertor}' ConverterParameter='settletype' UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" ValidatesOnNotifyDataErrors="True">
                                        <Binding.ValidationRules>
                                            <val:ValidationForAddExecution ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </comp:SettleTypeSelector.SettleType>
                            </comp:SettleTypeSelector>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="成交量" MinWidth="100" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <comComp:NumericUpDown x:Name="QuantityNU_edit" Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                                    MinValue="1000" MaxValue="100000000" DecimalLength="0" RangeValue="1000" VerticalAlignment="Center"
                                                   NumBorderBrush ="#3C3C3C" ToolTip="输入范围:1000-100000000;且是1000的倍数"
                                                FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" Height="24"
                                                Loaded="QuantityNU_edit_Loaded" ValueChanged="ExeQtyNU_edit_ValueChanged">
                                <comComp:NumericUpDown.NumericValue>
                                    <Binding Path="BookQty" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" ValidatesOnNotifyDataErrors="True">
                                        <Binding.ValidationRules>
                                            <val:ValidationForAddExecution ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </comComp:NumericUpDown.NumericValue>
                            </comComp:NumericUpDown>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="备注" MinWidth="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding remark ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource STCDefaultBoxStyle}" Height="24"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="21 0 0 0" VerticalAlignment="Center">
            <TextBlock Text ="{Binding Data.IntentionId}" Foreground="#A0A0A0"/>
            <TextBlock Text=" 报量 " Foreground="#A0A0A0"/>
            <TextBlock Text="{Binding Data.Qty, StringFormat={}{0:0}}" Foreground="#FFFFFF"/>
            <TextBlock Text=" / 已成交 " Foreground="#A0A0A0"/>
            <TextBlock Text="{Binding Data.BookQty,StringFormat={}{0:0}}" Foreground="#FFFFFF"/>
            <TextBlock Text=" / 余量 " Foreground="#A0A0A0"/>
            <TextBlock Text="{Binding Data.LeftQty,StringFormat={}{0:0}}" Foreground="#FFFFFF"/>
            <TextBlock Text="{Binding Error}" Foreground="#FF3F44" Visibility="{Binding ErrorVisibility}" Margin="10 0 0 0"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 21 0">
            <Button Style="{StaticResource  CancelButtonStyle}" Width="60" Height="24" Content="取消" Foreground="#FFFFFF" Command="{Binding CancelBtnCommand}" CommandParameter="{Binding ElementName=RelateExecWin}"/>
            <Button Style="{StaticResource  ConfirmButtonStyle}" Width="100" Height="24" Content="确认" Foreground="#FFFFFF" Margin="10,0,0,0" Command ="{Binding ConfirmBtnCommand}"  CommandParameter="{Binding ElementName=RelateExecWin}" IsEnabled="{Binding IsOkBtnEnable}"/>
        </StackPanel>

    </Grid>
</comComp:WindowBase>
