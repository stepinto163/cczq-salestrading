<UserControl x:Class="STC.WorkTable.Plugin.View.IntentionPanel.QuotationPart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkTable.Plugin.View.IntentionPanel"
             xmlns:Comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
              xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignWidth="280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--字体-->
            <FontFamily x:Key="Font.MicrosoftYaHei">Microsoft YaHei</FontFamily>
            <FontFamily x:Key="Font.MicrosoftYaHei.Bold">MicrosoftYaHei-Bold</FontFamily>
            <FontFamily x:Key="Font.MicrosoftYaHeiSemibold">MicrosoftYaHeiSemibold</FontFamily>
            <!--字体大小-->
            <sys:Double x:Key="FontSize-10">10</sys:Double>
            <sys:Double x:Key="FontSize-11">11</sys:Double>
            <sys:Double x:Key="FontSize-12">12</sys:Double>
            <sys:Double x:Key="FontSize-20">20</sys:Double>
            <sys:Double x:Key="FontSize-14">14</sys:Double>
            <sys:Double x:Key="FontSize-16">16</sys:Double>
            <sys:Double x:Key="FontSize-18">18</sys:Double>
            <sys:Double x:Key="FontSize-24">24</sys:Double>

            <SolidColorBrush x:Key="MainFrame.Background" Color="#141414"/>
            <!--高开低收-->
            <SolidColorBrush x:Key="Textblock.Foreground.HOLC.Gray" Color="#788187"/>

            <ContextMenu x:Key="OrderContextMenu" Style="{StaticResource DefaultContextMenu}"  ContextMenuOpening="UserControl_ContextMenuOpening">
                <MenuItem x:Name="miSendPrice" Header="报价" Style="{StaticResource DefaultMenuItem}" Click="OrderMenuItme_Click"/>
            </ContextMenu>

            <!--最优价样式 Bid-->
            <Style x:Key="BestEnlargeFontSizeElementStyle_Bid" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange_firm}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.BidIsPermission}" Value="false">
                        <Setter Property="Foreground" Value="#FB943C"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="Margin" Value="0,6,0,0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriceModel.BestBid}" Value="--">
                        <Setter Property="Foreground" Value="#4A4D4C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!--最优价样式 Ofr-->
            <Style x:Key="BestEnlargeFontSizeElementStyle_Ofr" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue_firm}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.OfrIsPermission}" Value="false">
                        <Setter Property="Foreground" Value="#009AFF"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="Margin" Value="0,6,0,0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriceModel.BestOfr}" Value="--">
                        <Setter Property="Foreground" Value="#4A4D4C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--最优价样式 Amount Bid-->
            <Style x:Key="BestAmountEnlargeFontSizeElementStyle_Bid" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.BidIsPermission}" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource Textblock.Foreground.HOLC.Gray}"/>
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--最优价样式 Ofr-->
            <Style x:Key="BestAmountEnlargeFontSizeElementStyle_Ofr" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.OfrIsPermission}" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource Textblock.Foreground.HOLC.Gray}"/>
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!--买卖样式-->
            <Style x:Key="LastExecSideShowStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextAlignment" Value="Center"></Setter>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding LastExecSideShow}" Value="TKN"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding LastExecSideShow}" Value="TRD"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Green}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding LastExecSideShow}" Value="GVN"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}" />
                    </MultiDataTrigger>

                </Style.Triggers>

            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="32"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="8, 2, 2, 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding LastExecPrice}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{StaticResource FontSize-18}" FontFamily="Roboto"  FontWeight="Medium" Foreground="{Binding LastExecBrush}"/>
                <TextBlock  Grid.Column="1" Margin="4,0,0,0" Text="{Binding LastExecPriceBP}" ToolTip="{Binding LastExecPriceBP}"  VerticalAlignment="Center" FontSize="{StaticResource FontSize-12}" FontFamily="Roboto"  FontWeight="SemiBold" Foreground="{Binding LastExecBrush}" />

                <!--<TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding LastExecSideShow}" FontSize="{StaticResource FontSize-10}" Foreground="#FFEBC8"/>-->

                <TextBlock Grid.Column="2" Margin="4,0,0,0"  VerticalAlignment="Center" Text="{Binding LastExecSideShow}"   FontSize="{StaticResource FontSize-12}" FontFamily="Roboto"  FontWeight="SemiBold" Style="{StaticResource LastExecSideShowStyle}" />

                <TextBlock Grid.Column="3" Margin="4,0,0,0"  VerticalAlignment="Center" Text="{Binding LastExecSource,Mode=TwoWay}" FontSize="{StaticResource FontSize-12}" FontFamily="MircroSoft YaHei" FontWeight="SemiBold" Foreground="#8F9598"/>

            </Grid>
            <Comp:SettleFilterView HorizontalAlignment="Right" Margin="0, 0, 5, 0" x:Name="FilterPanel" Grid.Column="2"
                                       FilterDic="{Binding SettleFilterDic, Mode=TwoWay}"  FilterDicChanged="FilterPanel_FilterDicChanged"></Comp:SettleFilterView>

        </Grid>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="2"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="1"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!--BorderBrush="{Binding PriceModel.UpSideBidBorderBrush}" -->
            <Border x:Name="bdBid" Grid.Column="1"  BorderThickness="1" Margin="0,0,0,0" BorderBrush="{Binding PriceModel.UpSideBidBorderBrush,Mode=TwoWay}" Background="{Binding PriceModel.UpSideBidBgBrush,Mode=TwoWay}" MouseRightButtonUp="BdBid_MouseRightButtonUp" MouseEnter="bdBid_MouseEnter" MouseLeave="bdBid_MouseLeave" MouseLeftButtonDown="bdBid_MouseLeftButtonDown" MinWidth="139">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Polygon x:Name="BidArrow" Margin="1.5, 2, 0, 0" Grid.Column="0"  Visibility="{Binding PriceModel.BidArrowVisibilly}" Stroke="{Binding PriceModel.BidArrowStroke}" Fill="{Binding PriceModel.BidArrowFill}" 
                                 Points="0,0 0,10 10,0" VerticalAlignment="Top" HorizontalAlignment="Left" ToolTip="{Binding PriceModel.BidArrowToolTxt}">
                    </Polygon>

                    <Border x:Name="T0" Grid.Column="0" Margin="8,0,0,0"  CornerRadius="2" Width="16" Height="16" Visibility="{Binding PriceModel.BestBidSettler, Converter={StaticResource SettleVisibilityConvertor}}" Background="#0A2420" BorderThickness="0">
                        <TextBlock Text="{Binding PriceModel.BestBidSettler}" VerticalAlignment="Center" HorizontalAlignment="Center"
                             Foreground="#FFFFFF" FontSize="{StaticResource FontSize-10}"  FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}"  ToolTip="{Binding PriceModel.BestBidSettlerYuan }">
                        </TextBlock>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding PriceModel.BestBidAmount}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PriceModel.BestBidAmount}" MinWidth="30" Height="24"
                               TextAlignment="Center" Padding="0,6,0,0"
                               VerticalAlignment="Center" Style="{StaticResource BestAmountEnlargeFontSizeElementStyle_Bid}"></TextBlock>

                    <TextBlock Grid.Column="2" Text="{Binding PriceModel.BestBid, Converter={StaticResource FormatPriceConvertor}}" Height="24" MinWidth="62" VerticalAlignment="Center" HorizontalAlignment="Left" TextAlignment="Center" 
                              Style="{StaticResource BestEnlargeFontSizeElementStyle_Bid}" Padding="0,2,0,0"></TextBlock>

                </Grid>

            </Border>


            <!--BorderBrush="{Binding PriceModel.UpSideOfrBorderBrush}" -->
            <Border x:Name="bdOfr" Grid.Column="3" BorderThickness="1" Margin="-1,0,1,0" BorderBrush="{Binding PriceModel.UpSideOfrBorderBrush,Mode=TwoWay}" Background="{Binding PriceModel.UpSideOfrBgBrush,Mode=TwoWay}" MouseRightButtonUp="BdOfr_MouseRightButtonUp" MouseEnter="bdOfr_MouseEnter" MouseLeave="bdOfr_MouseLeave" MouseLeftButtonDown="bdOfr_MouseLeftButtonDown" MinWidth="139">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="24"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"  Text="{Binding PriceModel.BestOfr, Converter={StaticResource FormatPriceConvertor}}" Height="24" MinWidth="62" VerticalAlignment="Center" HorizontalAlignment="Right"  TextAlignment="Center"
                                   Style="{StaticResource BestEnlargeFontSizeElementStyle_Ofr}" Padding="0,2,0,0"></TextBlock>

                    <TextBlock Grid.Column="1" Text="{Binding PriceModel.BestOfrAmount}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PriceModel.BestOfrAmount}" MinWidth="30" Height="24" 
                               TextAlignment="Center" VerticalAlignment="Center"  Padding="0,6,0,0"
                               Grid.RowSpan="2" Style="{StaticResource BestAmountEnlargeFontSizeElementStyle_Ofr}"></TextBlock>


                    <Polygon x:Name="OfrArrow" Grid.Column="2" Margin="0,2,1,0" Visibility="{Binding PriceModel.OfrArrowVisibilly}" Stroke="{Binding PriceModel.OfrArrowStroke}" Fill="{Binding PriceModel.OfrArrowFill}" 
                                 Points="0,0 10,0 10,10" HorizontalAlignment="Right"  ToolTip="{Binding PriceModel.OfrArrowToolTxt}" Grid.RowSpan="2" />


                    <Border x:Name="T1" Grid.Column="2" Margin="0,0,5,0"  CornerRadius="2" Width="16" Height="16" Visibility="{Binding PriceModel.BestOfrSettler, Converter={StaticResource SettleVisibilityConvertor}}" Background="#0A2420" BorderThickness="0">
                        <TextBlock  Text="{Binding PriceModel.BestOfrSettler}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="{StaticResource FontSize-10}" 
                               Foreground="#FFFFFF" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}" ToolTip="{Binding PriceModel.BestOfrSettlerYuan}"></TextBlock>
                    </Border>

                </Grid>
            </Border>

            <Border Grid.Column="1" Width="23" x:Name="BidBorder" Height="25" CornerRadius="2,0,0,0" HorizontalAlignment="Right"  VerticalAlignment="Bottom" BorderThickness="1,1,0,0"  BorderBrush="{Binding PriceModel.UpSideBidBorderBrush,Mode=TwoWay}"></Border>
            <Border Grid.Column="3" Width="23" x:Name="OfrBorder" Height="25" CornerRadius="0,2,0,0" HorizontalAlignment="Left"  VerticalAlignment="Bottom" BorderThickness="0,1,1,0"  BorderBrush="{Binding PriceModel.UpSideOfrBorderBrush,Mode=TwoWay}"></Border>
            <Border Grid.Column="1" Grid.ColumnSpan="3" x:Name="BpBorder"  Width="46" Height="24" HorizontalAlignment="Center" VerticalAlignment="Bottom"  
                        Background="{StaticResource MainFrame.Background}" CornerRadius="2,2,0,0" BorderThickness="1,1,1,0" BorderBrush="{StaticResource MainFrame.Background}">
            </Border>
            <Border Grid.Column="1" Grid.ColumnSpan="3" BorderThickness="0,0,0,1" CornerRadius="2,2,0,0" Width="44" Height="23" Margin="0,8,0,0" VerticalAlignment="Bottom" BorderBrush="{Binding PriceModel.UpSideBdBrush,Mode=TwoWay}" Background="{Binding PriceModel.UpSideBdBrush,Mode=TwoWay}">
                <TextBlock  Text="{Binding PriceModel.BestPriceDisplayBP}" TextAlignment="Center" Foreground="{Binding PriceModel.UpSideForgroundBrush,Mode=TwoWay}" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"
                                    FontSize="{StaticResource FontSize-11}" FontWeight="Bold" VerticalAlignment="Center" ToolTip="{Binding PriceModel.BestPriceBP}">
                </TextBlock>

            </Border>
        </Grid>

    </Grid>
</UserControl>
