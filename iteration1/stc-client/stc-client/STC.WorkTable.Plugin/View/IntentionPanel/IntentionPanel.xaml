                                           Background="#392512"
                                           BorderBrush="#392512"
                                           Foreground="#F9C152"
                                           PressBackground="#5B3616" 
                                           PressBorderBrush="#F9C152"
                                           HoverBackground="#5B3616" 
                                           HoverBorderBrush="#5B3616"/>
                <Comp:HoverButton Width="47" Height="24" HorizontalAlignment="Left" Content="-5kw" BorderThickness="1"
                                          Command="{Binding EditQtyCommand}"  CommandParameter="-5kw"
