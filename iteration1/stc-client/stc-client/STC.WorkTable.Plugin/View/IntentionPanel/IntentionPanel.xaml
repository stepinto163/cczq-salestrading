                                          Command="{Binding EditQtyCommand}"  CommandParameter="-1kw"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="#392512"
                                           BorderBrush="#392512"
                                           Foreground="#F9C152"
                                           PressBackground="#5B3616" 
                                           PressBorderBrush="#F9C152"
                                           HoverBackground="#5B3616" 
                                           HoverBorderBrush="#5B3616"/>

