            <Grid Grid.Row="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Background="#282828">
                    <Border BorderBrush="#136C5E" BorderThickness="0 0 0 2"  Margin="8 0 0 0" Padding="4 0 4 0">
                        <TextBlock Text="{Binding TotalExecCount, StringFormat={}成交记录({0})}" Foreground="#FFFFFF" Margin="0 4 0 0"/>
                    </Border>
                    
                    <Rectangle Margin="8 0 8 0" Width="1" Height="16" Fill="#3C3C3C"/>
                    <Button Width="16" Height="16" Command="{Binding AddExecCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border CornerRadius="8" Background="#136C5E">
                                    <TextBlock Text="+" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Foreground="#A0A0A0" VerticalAlignment="Center" Margin="8 0 0 0">
                        共<Run Text="{Binding TotalExecCount}" Foreground="#FFFFFF"/>笔,成交量<Run Text="{Binding TotalExecQty}" Foreground="#FFFFFF"/>kw
                    </TextBlock>
                </StackPanel>
                <DataGrid Grid.Row="1" Style="{StaticResource DefaultDataGrid}" RowHeight="32" ItemsSource="{Binding IntentionExecViewSource.View}"
                          SelectedItem="{Binding SelectIntentionExec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PNL(rmb)" MinWidth="60" Binding="{Binding PNL}"/>
                        <DataGridTextColumn Header="成交价" MinWidth="60" Binding="{Binding Price, StringFormat={}{0:0.00##}}"/>
                        <DataGridTextColumn Header="成交量" MinWidth="76" Binding="{Binding BookQty, StringFormat={}{0:0}}"/>
                        <DataGridTemplateColumn Header="渠道" Width="Auto" MinWidth="60"  CanUserSort="True" SortMemberPath="Venues">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="SourceTraderBorder" Background="{Binding Venues,Converter={StaticResource venuesColorConvertor}}"  CornerRadius="2" Height="16" Width="40" HorizontalAlignment="Left">
                                        <TextBlock x:Name="SourceTraderText" Foreground="{StaticResource DefaultForegroup.ColorBrush}" 
                                           Text="{Binding Venues, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='venuesxb'}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SourceTraderStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="时间" MinWidth="76" Binding="{Binding TransactTime}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>