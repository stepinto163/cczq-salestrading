                                           Foreground="#00B563"
                                           PressBackground="#193D37" 
                                           PressBorderBrush="#00B563"
                                           HoverBackground="#193D37" 
                                           HoverBorderBrush="#193D37"/>
            </StackPanel>

            <StackPanel Grid.Row="9" Orientation="Horizontal" Visibility="{Binding BtnVisibility}">
                <Comp:HoverButton Width="47" Height="24" HorizontalAlignment="Left" Content="+5kw" BorderThickness="1"
