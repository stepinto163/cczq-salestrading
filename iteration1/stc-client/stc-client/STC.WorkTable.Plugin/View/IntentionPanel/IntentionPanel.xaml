<UserControl x:Class="STC.WorkTable.Plugin.View.IntentionPanel.IntentionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkTable.Plugin.View.IntentionPanel"
             xmlns:Comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:STC.WorkTable.Plugin.Convertor" 
             mc:Ignorable="d"
             d:DesignWidth="282">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/themes/Generic.xaml"/>
                <ResourceDictionary Source="/STC.WorkTable.Plugin;component/Resources/STC.SkinStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- FrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Polygon Fill="#FFB60E" Points="6 -5.31777997e-15 0 7.42857143 4 7.42857143 2 13 8 5.57142857 3.99658203 5.57142857"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- NoFrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfNonFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="NF" Foreground="White">
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="VenuesListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!--<Setter Property="Padding" Value="0"/>-->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <!--<Setter Property="Padding" Value="10,0,10,0"/>-->
                <!--<Setter Property="Width" Value="54"/>
                <Setter Property="Margin" Value="2, 0, 0, 0"/>-->
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="#3C3C3C" CornerRadius="2" BorderThickness="0, 1, 0, 0" VerticalAlignment="Center" Margin="0,0,0,0" 
                            BorderBrush="#515151"  Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="Cp" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedInactive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedInactive.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedActive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Border}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource ListBoxItem.SelectedActive.Foreground}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#A0A0A0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="2" BorderBrush="#282828" BorderThickness="0, 0, 0, 0" Background="#000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="50"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="86"/>
                <RowDefinition />
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="0" x:Name="TitleBar" Height="24" Background="#282828">
                <Grid>
                    <Border x:Name="bdSecurity"  BorderThickness="0">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="6"></ColumnDefinition>
                                <ColumnDefinition Width="40"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Height="24" Margin="0,4,0,0" x:Name="TitlePanel"  HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Margin="6, 4, 0, 0" Text="{Binding Data.SecurityId}" x:Name="TextBlockSecurity" Foreground="{StaticResource LogDefaultFontBrush}" FontSize="14" FontWeight="Bold" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"></TextBlock>
                                <TextBlock Margin="6, 4, 0, 0" Text="{Binding Data.Symbol}" Foreground="{StaticResource LogDefaultFontBrush}"  ToolTip="{Binding SymbolName}" FontSize="14" FontWeight="Bold" ></TextBlock>
                                <TextBlock Margin="6, 4, 0, 0" Width="Auto" Text="{Binding Data.RemainingTime}" ToolTip="{Binding Data.RemainingTime}"  Foreground="#8F9598" FontSize="14" FontWeight="Bold" ></TextBlock>
                            </StackPanel>

                            <!-- 这里应该根据什么搜索？-->
                            <!--<Comp:SearchTextBox x:Name="seBond" Grid.Column="0"  Height="24" Width="200" Margin="4,0,0,0"  HorizontalAlignment="Left"  Visibility="Hidden" AfterSearch="seBond_AfterSearch"/>-->

                            <!--<Button x:Name="btnDelete" HorizontalAlignment="Right" Grid.Column="4" FontSize="{StaticResource FontSize-16}" Content="✕" Width="24" Height="24" 
                                    Style="{StaticResource CardDelteButtonStyle}"  Margin="0, 0, 5, 2" Command="{Binding DelteCommand}" Visibility="Visible"></Button>-->
                            <!--<StackPanel  Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" >
                                <CheckBox Margin="0,0,0,2" x:Name="btnFixFloatButton" Style="{StaticResource FixFloatButtonStyle}" Checked="btnFixFloatButton_Checked" Unchecked="btnFixFloatButton_Checked"></CheckBox>
                                <Button Width="14" Height="14" x:Name="btnShutDown" Margin="8, 0, 0, 2" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" ToolTip="关闭" />
                            </StackPanel>-->
                        </Grid>
                    </Border>

                    <!--<Comp:SearchEditUI x:Name="seSearch" Height="28" Visibility="{Binding PriceModel.SearchVisibility}" SearchChanged="SeSearch_SearchChanged"></Comp:SearchEditUI>-->
                </Grid>
            </Border>

            <local:QuotationPart x:Name="quotationPart" Grid.Row="1" Grid.RowSpan="2"/>

            <Grid Grid.Row="3" Margin="0 2 0 0" Background="#141414">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="EditBtn" Width="16" Height="16" Margin="8 0 8 0" Style="{StaticResource EditButton}" Click="EditBtn_Click"/>
                    <TextBlock Text="{Binding Data.IntentionId}" Width="135" Foreground="#F9C152" TextTrimming="CharacterEllipsis" ToolTip="{Binding Data.IntentionId}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Data.InstitutionName}" Width="80" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding Data.InstitutionName}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Data.TraderName}" Width="60" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding Data.TraderName}" VerticalAlignment="Center"/>
                </StackPanel>
                 <TextBlock Grid.Row="1"  Text="{Binding BaseInfo}" Margin="8 0 0 0" Foreground="#FB943C" Width="264" TextTrimming="CharacterEllipsis" ToolTip="{Binding BaseInfo}" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="4" Margin="0 2 0 0" Background="#141414">
                <TextBlock Text="{Binding Data.Text, StringFormat={}原文 : {0}}" Margin="8 0 0 0" Foreground="#A0A0A0" Width="264" TextTrimming="CharacterEllipsis" ToolTip="{Binding Data.Text}" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="5" Margin="0 2 0 0">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#2E2E2E" Offset="0"/>
                        <GradientStop Color="#141414" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="收益率" Foreground="#A0A0A0"/>
                        <TextBlock Text="{Binding Data.Price, StringFormat={}{0:0.00##}}" Margin="4 0 0 0" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" FlowDirection="RightToLeft" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="净价" Foreground="#A0A0A0"/>
                        <TextBlock Text="{Binding Data.NetPrice, StringFormat={}{0:0.00##}}" Margin="4 0 0 0" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <Viewbox x:Name="vb" Width="50" Height="50" Grid.Column="1" Grid.RowSpan="2">
                        <Comp:WaveProgressControl x:Name="progress" Value="{Binding Data.CompleteRate}" MaxValue="100" Height="150" Width="150" Style="{StaticResource WaveProgressStyle}"/>
                    </Viewbox>
                    

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PNL" Foreground="#A0A0A0"/>
                        <TextBlock Text="{Binding Data.PNL, StringFormat={}{0:0.00}rmb}" Margin="4 0 0 0" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="时长" Foreground="#A0A0A0"/>
                        <TextBlock Text="{Binding Data.RunningTime, Converter={StaticResource MmQuoteTimeConvertor}}" Margin="4 0 0 0" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Comp:HoverButton Width="54" Height="24" HorizontalAlignment="Left"
                                          Command="{Binding DofirmOrderCommand}"  CommandParameter="全部"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                           PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                            <WrapPanel Height="12">
                                <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Text="全部" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                            </WrapPanel>
                        </Comp:HoverButton>
                        <Comp:HoverButton Width="54" Height="24" Margin="2 0 0 0" HorizontalAlignment="Left"
                                          Command="{Binding DofirmOrderCommand}"  CommandParameter="1000"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                            <WrapPanel Height="12">
                                <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Text="1000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                            </WrapPanel>
                        </Comp:HoverButton>
                        <Comp:HoverButton Width="54" Height="24" Margin="2 0 0 0" HorizontalAlignment="Left"
                                          Command="{Binding DofirmOrderCommand}"  CommandParameter="3000"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                            <WrapPanel Height="12">
                                <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Text="3000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                            </WrapPanel>
                        </Comp:HoverButton>
                        <Comp:HoverButton Width="54" Height="24" Margin="2 0 0 0" HorizontalAlignment="Left"
                                          Command="{Binding DofirmOrderCommand}"  CommandParameter="5000"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                            <WrapPanel Height="12">
                                <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Text="5000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                            </WrapPanel>
                        </Comp:HoverButton>
                        <Comp:HoverButton Width="54" Height="24" Margin="2 0 0 0" HorizontalAlignment="Left"
                                          Command="{Binding DofirmOrderCommand}"  CommandParameter="报价"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                            <WrapPanel Height="12">
                                <Image Source="/STC.WorkTable.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Text="报价" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                            </WrapPanel>
                        </Comp:HoverButton>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid Grid.Row="6" MinHeight="120" Style="{StaticResource DefaultDataGrid}" HeadersVisibility="None"
                      ItemsSource="{Binding IntentionOrderViewSource.View}" SelectionChanged="DataGrid_SelectionChanged"
                      SelectedItem="{Binding SelectIntentionOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ContextMenuOpening="orderMenu_ContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="orderMenu" Style="{StaticResource DefaultContextMenu}">
                        <MenuItem x:Name="miCancel" Header="撤销" Style="{StaticResource DefaultMenuItem}" Click="MiCancel_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="意向" Width="Auto" MinWidth="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <!--<TextBlock x:Name="firmflag" Text="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag'}">
                                                </TextBlock>-->
                                    <Button x:Name="firmbtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Style="{StaticResource SelfFirmButton}" Visibility="Collapsed">
                                    </Button>
                                    <Button x:Name="nonfirmbtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        Style="{StaticResource SelfNonFirmButton}" Visibility="Collapsed">
                                    </Button>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FirmFlag}" Value="1"/>
                                            <!--<Condition Binding="{Binding IsPoint}" Value="0"/>-->
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FirmFlag}" Value="0"/>
                                            <!--<Condition Binding="{Binding IsPoint}" Value="0"/>-->
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="代码" Width="Auto" MinWidth="70" Binding="{Binding SecurityId}"/>
                    <DataGridTextColumn Header="方向" Width="Auto" MinWidth="40" CellStyle="{StaticResource ColumnColorStyle}"
                                        Binding="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"/>
                    <DataGridTextColumn Header="报价" Width="Auto" MinWidth="48" Binding="{Binding Price, StringFormat={}{0:0.00##}}"/>
                    <DataGridTextColumn Header="报量" Width="Auto" MinWidth="48" Binding="{Binding Qty, StringFormat={}{0:0}}"/>
                    <DataGridTemplateColumn Header="渠道" Width="48" MinWidth="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayVenues}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayVenues}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <ListBox x:Name="VenuesLv" Grid.Row="7" Background="Transparent" VerticalAlignment="Center" 
                     SelectionMode="Extended" SelectionChanged="VenuesLv_SelectionChanged" PreviewMouseDown="VenuesLv_PreviewMouseDown"
                     Visibility="{Binding BtnVisibility}">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>

                <ListBoxItem Content="国际" Style="{StaticResource VenuesListBoxItemStyle}" Width="54"/>
                <ListBoxItem Content="国利" Style="{StaticResource VenuesListBoxItemStyle}" Width="54" Margin="2 0 0 0"/>
                <ListBoxItem Content="平安" Style="{StaticResource VenuesListBoxItemStyle}" Width="54" Margin="2 0 0 0"/>
                <ListBoxItem Content="信唐" Style="{StaticResource VenuesListBoxItemStyle}" IsSelected="True" Width="54" Margin="2 0 0 0"/>
                <ListBoxItem Content="中诚" Style="{StaticResource VenuesListBoxItemStyle}" Width="54" Margin="2 0 0 0"/>
                <ListBoxItem Content="XBOND" Style="{StaticResource VenuesListBoxItemStyle}" Width="139" Margin="0 1 0 0"/>
                <ListBoxItem Content="内部" Style="{StaticResource VenuesListBoxItemStyle}" Width="139" Margin="1 1 0 0"/>
            </ListBox>

            <StackPanel Grid.Row="8" Orientation="Horizontal" Visibility="{Binding BtnVisibility}">
                <Comp:HoverButton Width="31" Height="24" HorizontalAlignment="Left" Content="+5" BorderThickness="1"
                                          Command="{Binding EditPriceCommand}"  CommandParameter="+5"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="#370F11"
                                           BorderBrush="#370F11"
                                           Foreground="#FF3F44 "
                                           PressBackground="#3E1A1A" 
                                           PressBorderBrush="#FF3F44 "
                                           HoverBackground="#3E1A1A" 
                                           HoverBorderBrush="#3E1A1A"/>
                <Comp:HoverButton Width="27" Height="24" HorizontalAlignment="Left" Content="+1" BorderThickness="1"
                                          Command="{Binding EditPriceCommand}"  CommandParameter="+1"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="#370F11"
                                           BorderBrush="#370F11"
                                           Foreground="#FF3F44 "
                                           PressBackground="#3E1A1A" 
                                           PressBorderBrush="#FF3F44 "
                                           HoverBackground="#3E1A1A" 
                                           HoverBorderBrush="#3E1A1A"/>
                <Comp:HoverButton Width="35" Height="24" HorizontalAlignment="Left" Content="+0.5" BorderThickness="1"
                                          Command="{Binding EditPriceCommand}"  CommandParameter="+0.5"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="#370F11"
                                           BorderBrush="#370F11"
                                           Foreground="#FF3F44 "
                                           PressBackground="#3E1A1A" 
                                           PressBorderBrush="#FF3F44 "
                                           HoverBackground="#3E1A1A" 
                                           HoverBorderBrush="#3E1A1A"/>
                <Comp:HoverButton Width="47" Height="24" HorizontalAlignment="Left" Content="+0.25" BorderThickness="1"
                                          Command="{Binding EditPriceCommand}"  CommandParameter="+0.25"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="#370F11"
                                           BorderBrush="#370F11"
                                           Foreground="#FF3F44 "
                                           PressBackground="#3E1A1A" 
                                           PressBorderBrush="#FF3F44 "
                                           HoverBackground="#3E1A1A" 
                                           HoverBorderBrush="#3E1A1A"/>

                <Comp:HoverButton Width="47" Height="24" HorizontalAlignment="Left" Content="-0.25" Margin="1 0 0 0" BorderThickness="1"
                                          Command="{Binding EditPriceCommand}"  CommandParameter="-0.25"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="#0A2420"
                                           BorderBrush="#0A2420"
                                           Foreground="#00B563"
                                           PressBackground="#193D37" 
                                           PressBorderBrush="#00B563"
                                           HoverBackground="#193D37" 
                                           HoverBorderBrush="#193D37"/>
                <Comp:HoverButton Width="35" Height="24" HorizontalAlignment="Left" Content="-0.5" BorderThickness="1"
                                          Command="{Binding EditPriceCommand}"  CommandParameter="-0.5"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="#0A2420"
                                           BorderBrush="#0A2420"
                                           Foreground="#00B563"
                                           PressBackground="#193D37" 
                                           PressBorderBrush="#00B563"
                                           HoverBackground="#193D37" 
                                           HoverBorderBrush="#193D37"/>
                <Comp:HoverButton Width="27" Height="24" HorizontalAlignment="Left" Content="-1" BorderThickness="1"
                                          Command="{Binding EditPriceCommand}"  CommandParameter="-1"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="#0A2420"
                                           BorderBrush="#0A2420"
                                           Foreground="#00B563"
                                           PressBackground="#193D37" 
                                           PressBorderBrush="#00B563"
                                           HoverBackground="#193D37" 
