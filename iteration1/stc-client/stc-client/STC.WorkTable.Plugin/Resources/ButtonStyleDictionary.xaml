<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="STC.SkinStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- 双边批量导入按钮样式-->
    <Style TargetType="{x:Type Button}" x:Key="ImportButton2">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                            <Border.Background>
                                <ImageBrush ImageSource="/STC.WorkTable.Plugin;component/Images/导入.png"/>
                            </Border.Background>
                        </Border>
                        <Grid>
                            <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.WorkTable.Plugin;component/Images/导入hover.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Control.Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.WorkTable.Plugin;component/Images/导入p.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 双边批量导出按钮样式-->
    <Style TargetType="{x:Type Button}" x:Key="ExportButton2">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                            <Border.Background>
                                <ImageBrush ImageSource="/STC.WorkTable.Plugin;component/Images/导出.png"/>
                            </Border.Background>
                        </Border>
                        <Grid>
                            <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.WorkTable.Plugin;component/Images/导出hover.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Control.Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/STC.WorkTable.Plugin;component/Images/导出p.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>