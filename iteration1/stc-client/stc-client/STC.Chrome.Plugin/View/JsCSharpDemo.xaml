<UserControl x:Class="STC.Chrome.Plugin.JsCSharpDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Chrome.Plugin"
             xmlns:CommView ="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d"
             Background="Transparent"  Width="320" Height="300"  UseLayoutRounding = "True" SnapsToDevicePixels = "True" IsHitTestVisible = "True">
    <Grid Background="Transparent">
         <Grid.RowDefinitions>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <StackPanel Margin="20 10 10 10" Grid.Row="1" Height="auto">
            <TextBox Text="TagGroupSelection, STCTagGroupDeal" Foreground="Black"/>
            <TextBlock Text="Key:" Margin="0,5,0,0" Foreground="Wheat"/>
            <CommView:WatermarkTextBox x:Name="UsernameBox" Height="30" VerticalContentAlignment="Center"  WaterMark="例如:TagGroupSelection, STCTagGroupDeal" Foreground="White" ToolTip="Key不能为空"/>
                <TextBlock Text="Value:" Margin="0,10,0,0" Foreground="Wheat"/>
                <CommView:WatermarkTextBox x:Name="PasswordBox" Height="30"  VerticalContentAlignment="Center" WaterMark="例如:220220.IB" Foreground="White"/>
                <TextBlock Text="目标窗口:" Margin="0,10,0,0" Foreground="Wheat"/>
                <ComboBox x:Name="cmbTarget"  Style="{DynamicResource DailanBlueGreenOrangeComboBoxStyle}" Height="24" Padding="4 0 0 0"></ComboBox>
        </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button Content="GetFQSetAction" FontSize="8" Height="24" Width="60" Margin="4,0,4,0" Style="{DynamicResource GraySlateButtonStyle}" x:Name="btnfq" Click="btnfq_Click" ToolTip="发送init"/>
            <Button Content="GetFQChangeBond" FontSize="8" Height="24" Width="60" Margin="4,0,4,0" Style="{DynamicResource GraySlateButtonStyle}" x:Name="btnChangeBond" Click="btnChangeBond_Click"/>
            <Button Content="FinQToken" Height="24" Width="60" Margin="0,0,4,0" Style="{DynamicResource GraySlateButtonStyle}" x:Name="btnfqtoken" Click="btnfqtoken_Click" ToolTip="发送token"/>
            <Button Content="ReSet" Height="24" Width="60" Margin="4,0,4,0" Style="{DynamicResource GraySlateButtonStyle}" x:Name="btnCancel" Click="btnCancel_Click" ToolTip="清空Key,Value"/>
            <Button Content="发送" Height="24" Width="50" Style="{DynamicResource  BlueGreenStyle}" x:Name="btnConfirm" Click="btnConfirm_Click" ToolTip="Common.Handler.Base.BaseHandler.Instance.PublishAppMsg(new PResult() { Code = 'pubJS', Info1 = target, Info2 = key, Info3 = value });"/>
            </StackPanel>
    </Grid>
</UserControl>
