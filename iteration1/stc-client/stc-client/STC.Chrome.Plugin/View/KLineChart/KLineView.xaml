<UserControl x:Class="STC.Chrome.Plugin.View.KLineChart.KLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpf="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:local="clr-namespace:STC.Chrome.Plugin.View.KLineChart"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" SizeChanged="UserControl_SizeChanged">


    <UserControl.Resources>
        <ResourceDictionary>


            <!-- 编辑按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="EditButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/STC.Chrome.Plugin;component/Images/stc_icon_edit_normal.png"/>
                                    </Border.Background>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Chrome.Plugin;component/Images/stc_icon_edit_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Chrome.Plugin;component/Images/stc_icon_edit_press.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                               
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Chrome.Plugin;component/Images/stc_icon_edit_disable.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#101010">

        <Grid.RowDefinitions>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <!--<Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>-->

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3">
            <Image x:Name="igFavorite" Source="{Binding FavoriteSource}" Width="18" Height="18" Margin="10,0,0,0" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
            <Grid Width="210" Margin="10,0,0,0">
                <comp:SearchTextBox x:Name="seBond"  Height="18"  Visibility="Hidden" AfterSearch="seBond_AfterSearch" />
                <Border CornerRadius="3">
                    <Label x:Name="lbCode" Background="Transparent" Margin="0, 2, 0, 0" 
                           MouseLeftButtonDown="lbCode_MouseLeftButtonDown" MouseEnter="lbCode_MouseEnter" MouseLeave="lbCode_MouseLeave">
                        <StackPanel x:Name="spCode" Orientation="Horizontal" Margin="0">
                            <TextBlock x:Name="tbBondId" Text="{Binding SecurityID}" Foreground="#FFFFFF" Width="83" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,4,0">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}">
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="tbBondName" Text="{Binding Symbol}" Margin="10,0,0,0" Foreground="#FFFFFF" Width="70" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}">
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Label>
                </Border>
            </Grid>
            <Button x:Name="Edit_Btn" Width="12" Height="12" Margin="10,0,0,0" Style="{StaticResource EditButton}" Click="Edit_Btn_Click"/>
        </StackPanel>



        <!--<Button Content="刷新" Width="40" Height="30" Click="Reload_Click" Grid.Column="0" ToolTip="强制重新加载忽略缓存"/>

            <TextBox x:Name="txtBoxAddress" Height="30" Margin="5, 0, 5, 0" Text="{Binding Address, ElementName=Browser, FallbackValue=www.google.com}" Grid.Column="1" FontSize="12" BorderBrush="Gray" BorderThickness="1">

            </TextBox>

            <Button Content="查看源码"  Width="60" Height="30" Command="{Binding WebBrowser.ViewSourceCommand, ElementName=Browser}" Grid.Column="2" ToolTip="查看源代码" />
            <Button Content="显示开发者工具" Width="100" Height="30" Click="ShowDevTools_Click" Grid.Column="3" ToolTip="显示开发者工具"/>
            --><!--Button Style="{DynamicResource Button.CallJs}" x:Name="btn_CallJS" Click="Button_Click" Grid.Column="7" ToolTip="C#端调用网页端的Js演示"/--><!--

        </Grid>-->
            

        <Border Grid.Row="1" BorderBrush="Transparent" BorderThickness="0,1" Background="Transparent">
            <wpf:ChromiumWebBrowser x:Name="Browser" Address="" >
            </wpf:ChromiumWebBrowser>
        </Border>
    </Grid>
</UserControl>
