<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Prefer assemblies just rebuilt from this checkout over supplied binary snapshots. -->
    <AssemblySearchPaths>$(OutputPath);$(MSBuildThisFileDirectory)..\client\bin;$(AssemblySearchPaths)</AssemblySearchPaths>
  </PropertyGroup>
</Project>
