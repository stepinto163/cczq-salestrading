{
  "Version": 1,
  "Id": "14-watchlist-notification-read",
  "Name": "关注报价提醒到达并标记已读",
  "Description": "P1：API 仅准备独立关注分组及偏好；报价创建确认和提醒已读通过正式 UI，结束恢复偏好并删除分组。",
  "Steps": [
    {
      "Name": "准备独立关注夹具",
      "Action": "notification.prepare",
      "Parameters": {
        "securityId": "${securityId}"
      }
    },
    {
      "Name": "精确报价输入并识别",
      "Action": "parse",
      "Parameters": {
        "text": "${securityId} 2.5 1 bid +1",
        "expectedRows": "1"
      }
    },
    {
      "Name": "勾选识别预览",
      "Action": "parse.select",
      "Parameters": {
        "row": "1",
        "selected": "true",
        "expectedCount": "1"
      }
    },
    {
      "Name": "确认精确报价",
      "Action": "parse.confirm",
      "Parameters": {
        "expectedCount": "1"
      }
    },
    {
      "Name": "核对本例提醒并点击已读",
      "Action": "notification.read",
      "Parameters": {}
    }
  ]
}
