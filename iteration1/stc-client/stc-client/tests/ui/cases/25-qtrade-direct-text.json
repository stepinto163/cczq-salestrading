{
  "Version": 1,
  "Id": "25-qtrade-direct-text",
  "Name": "QT单聊文本意向发布",
  "Description": "向真实 PRL 发送测试意向，须以收件人的 STC 账户登录。需要 STC_UI_QTRADE_PUBLISH=1 和 STC_UI_INTAKE_TOKEN。核对实际 FIX 接收、待确认、确认入行情；只清理当前用户本例报价，不删除 QT 消息及其他收件人报价。",
  "Steps": [
    {
      "Name": "发布并核对真实接收报价",
      "Action": "qtrade.publish",
      "Parameters": {
        "appId": "107090227",
        "senderQtAccount": "2881631456",
        "receiverQtAccount": "3004468043",
        "receiverLogin": "adrian",
        "routingType": "58",
        "routingId": "3004468043",
        "mode": "TEXT",
        "securityId": "240210.IB",
        "symbol": "24国开10",
        "price": "${uniquePrice}",
        "expectedRows": "1"
      }
    },
    {
      "Name": "确认报价并核对行情",
      "Action": "qtrade.confirmPublished",
      "Parameters": {
        "contactName": "李继存",
        "institutionName": "长城证券股份有限公司"
      }
    }
  ]
}
