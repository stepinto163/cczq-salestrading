{
  "Version": 1,
  "Id": "05-settlement-update",
  "Name": "清算速度修改后保存",
  "Description": "P0：T+0 改 T+1，确认实际持久化字段和修改后状态。",
  "Steps": [
    {
      "Name": "精确报价输入并识别",
      "Action": "parse",
      "Parameters": {
        "text": "${securityId} 2.5 1 bid +0",
        "expectedRows": "1"
      }
    },
    {
      "Name": "勾选识别预览",
      "Action": "parse.select",
      "Parameters": {
        "row": "1",
        "selected": "true",
        "expectedCount": "1"
      }
    },
    {
      "Name": "确认精确报价",
      "Action": "parse.confirm",
      "Parameters": {
        "expectedCount": "1"
      }
    },
    {
      "Name": "5. 核对方向、数量和清算",
      "Action": "quote.fields",
      "Parameters": {
        "side": "1",
        "settlType": "1",
        "quantity": "1"
      }
    },
    {
      "Name": "打开报价管理修改表单并填写",
      "Action": "management.edit",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.51",
        "quantity": "2",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "保存报价修改",
      "Action": "management.save",
      "Parameters": {}
    },
    {
      "Name": "8. 核对状态和价格",
      "Action": "quote.assert",
      "Parameters": {
        "status": "ACTIVE",
        "price": "2.51"
      }
    },
    {
      "Name": "9. 核对方向、数量和清算",
      "Action": "quote.fields",
      "Parameters": {
        "side": "1",
        "settlType": "2",
        "quantity": "2"
      }
    }
  ],
  "Page": "03 报价管理/01 今日报价",
  "Feature": "02 修改与校验",
  "Priority": "P0"
}
