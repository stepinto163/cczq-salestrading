{
  "Version": 1,
  "Id": "05-settlement-update",
  "Name": "清算速度修改后保存",
  "Description": "P0：T+0 改 T+1，确认实际持久化字段和修改后状态。",
  "Steps": [
    {
      "Name": "1. 打开手工报价",
      "Action": "manual.open",
      "Parameters": {}
    },
    {
      "Name": "2. 填写报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.5",
        "quantity": "1",
        "side": "1",
        "settlType": "1"
      }
    },
    {
      "Name": "3. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "保存待确认"
      }
    },
    {
      "Name": "4. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "确认"
      }
    },
    {
      "Name": "5. 核对方向、数量和清算",
      "Action": "quote.fields",
      "Parameters": {
        "side": "1",
        "settlType": "1",
        "quantity": "1"
      }
    },
    {
      "Name": "6. 填写报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.51",
        "quantity": "2",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "7. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "保存修改"
      }
    },
    {
      "Name": "8. 核对状态和价格",
      "Action": "quote.assert",
      "Parameters": {
        "status": "ACTIVE",
        "price": "2.51"
      }
    },
    {
      "Name": "9. 核对方向、数量和清算",
      "Action": "quote.fields",
      "Parameters": {
        "side": "1",
        "settlType": "2",
        "quantity": "2"
      }
    }
  ]
}
