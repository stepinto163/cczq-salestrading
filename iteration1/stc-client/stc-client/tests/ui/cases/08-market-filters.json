{
  "Version": 1,
  "Id": "08-market-filters",
  "Name": "行情中心侧栏过滤与重置",
  "Description": "P0：自建有效报价，真实区间和搜索控件验证消失、恢复、清除。",
  "Steps": [
    {
      "Name": "精确报价输入并识别",
      "Action": "parse",
      "Parameters": {
        "text": "${securityId} 2.5 1 bid +1",
        "expectedRows": "1"
      }
    },
    {
      "Name": "勾选识别预览",
      "Action": "parse.select",
      "Parameters": {
        "row": "1",
        "selected": "true",
        "expectedCount": "1"
      }
    },
    {
      "Name": "确认精确报价",
      "Action": "parse.confirm",
      "Parameters": {
        "expectedCount": "1"
      }
    },
    {
      "Name": "5. 核对行情页推送",
      "Action": "market.assert",
      "Parameters": {}
    },
    {
      "Name": "6. 输入区间并核对筛选结果",
      "Action": "sidebar.range",
      "Parameters": {
        "page": "market",
        "field": "bidPrice",
        "min": "3",
        "max": "4",
        "visible": "false"
      }
    },
    {
      "Name": "7. 输入区间并核对筛选结果",
      "Action": "sidebar.range",
      "Parameters": {
        "page": "market",
        "field": "bidPrice",
        "min": "2.5",
        "max": "2.5",
        "visible": "true"
      }
    },
    {
      "Name": "8. 清除过滤并核对恢复",
      "Action": "sidebar.reset",
      "Parameters": {
        "page": "market"
      }
    },
    {
      "Name": "9. 输入关键词并核对筛选结果",
      "Action": "sidebar.search",
      "Parameters": {
        "page": "market",
        "text": "UI-ABSENT-BOND-938172",
        "visible": "false"
      }
    },
    {
      "Name": "10. 清除过滤并核对恢复",
      "Action": "sidebar.reset",
      "Parameters": {
        "page": "market"
      }
    }
  ],
  "Page": "02 行情中心/03 利率全部",
  "Feature": "01 筛选",
  "Priority": "P0"
}
