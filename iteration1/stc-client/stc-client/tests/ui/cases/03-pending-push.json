{
  "Version": 1,
  "Id": "03-pending-push",
  "Name": "待确认报价实时展示",
  "Description": "通过API创建明确标记的待确认夹具，核对报价确认页的真实推送；结束后删除本例报价。",
  "Steps": [
    {
      "Name": "通过API准备待确认夹具（非UI录入）",
      "Action": "fixture.pending",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.6000",
        "quantity": "1",
        "side": "2",
        "settlType": "2"
      }
    },
    {
      "Name": "核对确认页显示本例报价",
      "Action": "pending.assert",
      "Parameters": {}
    }
  ]
}
