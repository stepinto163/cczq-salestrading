{
  "Version": 1,
  "Id": "03-pending-push",
  "Name": "待确认报价实时展示",
  "Description": "接收人为当前登录用户（须有inf1 QT映射），发送人为用例配置的QT账号。通过真实QT结构化发布、FIX接收形成待确认报价；验证实时推送；结束后清理本例报价。",
  "Steps": [
    {
      "Name": "通过真实QT发布并接收待确认报价",
      "Action": "qtrade.publish",
      "Parameters": {
        "appId": "107090227",
        "senderQtAccount": "2881631456",
        "groupId": "",
        "mode": "STRUCTURED",
        "securityId": "${securityId}",
        "symbol": "24国开10",
        "price": "${uniquePrice}",
        "expectedRows": "1"
      }
    },
    {
      "Name": "核对确认页显示本例报价",
      "Action": "pending.assert",
      "Parameters": {}
    }
  ],
  "Page": "01 报价录入/01 报价确认",
  "Feature": "01 推送与分组",
  "Priority": "P0"
}
