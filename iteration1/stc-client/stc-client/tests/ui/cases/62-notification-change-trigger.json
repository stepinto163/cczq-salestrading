{
  "Version": 1,
  "Id": "62-notification-change-trigger",
  "Name": "报价变更驱动提醒，不重弹同券未变报价",
  "Description": "真实 UI 新建两笔同券报价，新增/修改只弹对应版本；撤销其中一笔不重弹另一笔；手动刷新不弹存量。自动清理两笔报价及关注配置。",
  "Steps": [
    {
      "Name": "准备关注分组",
      "Action": "notification.prepare",
      "Parameters": {
        "securityId": "${securityId}"
      }
    },
    {
      "Name": "核对新增、修改、撤销和刷新提醒语义",
      "Action": "notification.lifecycle",
      "Parameters": {
        "securityId": "${securityId}"
      }
    }
  ],
  "Page": "02 行情中心/06 报价提醒",
  "Feature": "02 变更驱动与去重",
  "Priority": "P0"
}
