{
  "Version": 1,
  "Id": "22-account-groups",
  "Name": "关注债券与筛选分组：账户持久化和过滤",
  "Description": "通过真实管理弹窗创建关注组和筛选组，验证基础资料识别、保存重读、组合过滤、清除、取消、重命名、移除债券、并发版本冲突及删除。仅清理本例分组及报价。",
  "Steps": [
    {
      "Name": "1. 打开手工报价",
      "Action": "manual.open",
      "Parameters": {}
    },
    {
      "Name": "2. 填写报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.5",
        "quantity": "1",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "3. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "保存待确认"
      }
    },
    {
      "Name": "4. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "确认"
      }
    },
    {
      "Name": "5. 核对行情页推送",
      "Action": "market.assert",
      "Parameters": {}
    },
    {
      "Name": "6. 管理账户分组",
      "Action": "groups.manage",
      "Parameters": {}
    }
  ]
}