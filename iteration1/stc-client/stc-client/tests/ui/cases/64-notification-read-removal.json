{
  "Version": 1,
  "Id": "64-notification-read-removal",
  "Name": "提醒：同券成员移除保留已读",
  "Description": "两笔同券报价合并提醒，经 UI 标记已读；撤销 A 后 B 保持已读且不重弹；编辑 B 后产生新未读提醒。",
  "Page": "02 行情中心/06 报价提醒",
  "Feature": "02 变更驱动与去重",
  "Priority": "P0",
  "Steps": [
    {
      "Name": "准备独立关注分组",
      "Action": "notification.prepare",
      "Parameters": {
        "securityId": "${securityId}"
      }
    },
    {
      "Name": "提醒：同券成员移除保留已读",
      "Action": "notification.read-survives-removal",
      "Parameters": {
        "securityId": "${securityId}"
      }
    }
  ]
}
