{
  "Version": 1,
  "Id": "11-preview-selection-toolbar",
  "Name": "批量工具栏只修改勾选报价",
  "Description": "P0：只选第一条，方向按钮不修改第二条；删除后选中计数回零。",
  "Steps": [
    {
      "Name": "1. 识别文本",
      "Action": "parse",
      "Parameters": {
        "text": "${securityId} bid 2.5 1000\n${securityId} bid 2.6 2000",
        "expectedRows": "2"
      }
    },
    {
      "Name": "2. 勾选或取消报价",
      "Action": "parse.select",
      "Parameters": {
        "row": "1",
        "selected": "true",
        "expectedCount": "1"
      }
    },
    {
      "Name": "3. 点击预览工具栏",
      "Action": "parse.click",
      "Parameters": {
        "button": "Ofr"
      }
    },
    {
      "Name": "4. 逐字段核对预览行",
      "Action": "parse.row",
      "Parameters": {
        "row": "1",
        "securityId": "${securityId}",
        "side": "Ofr",
        "price": "2.5",
        "quantity": "1000"
      }
    },
    {
      "Name": "5. 逐字段核对预览行",
      "Action": "parse.row",
      "Parameters": {
        "row": "2",
        "securityId": "${securityId}",
        "side": "Bid",
        "price": "2.6",
        "quantity": "2000"
      }
    },
    {
      "Name": "6. 点击预览工具栏",
      "Action": "parse.click",
      "Parameters": {
        "button": "删除"
      }
    },
    {
      "Name": "7. 核对剩余预览和选中数量",
      "Action": "parse.count",
      "Parameters": {
        "rows": "1",
        "selected": "0"
      }
    },
    {
      "Name": "8. 逐字段核对预览行",
      "Action": "parse.row",
      "Parameters": {
        "row": "1",
        "securityId": "${securityId}",
        "side": "Bid",
        "price": "2.6",
        "quantity": "2000"
      }
    }
  ],
  "Page": "01 报价录入/02 精确报价",
  "Feature": "05 选择与批量编辑",
  "Priority": "P0"
}
