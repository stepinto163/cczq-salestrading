{
  "Version": 1,
  "Id": "06-invalid-price-recovery",
  "Name": "非法价格拒绝后修正重试",
  "Description": "P0：非法输入明确报错，不改变已有报价；修正后能继续保存。",
  "Steps": [
    {
      "Name": "1. 打开手工报价",
      "Action": "manual.open",
      "Parameters": {}
    },
    {
      "Name": "2. 填写报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.5",
        "quantity": "1",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "3. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "保存待确认"
      }
    },
    {
      "Name": "4. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "确认"
      }
    },
    {
      "Name": "5. 填写报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "not-a-price",
        "quantity": "1",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "6. 核对拒绝提示和版本不变",
      "Action": "manual.reject",
      "Parameters": {
        "button": "保存修改",
        "message": "价格必须为数字"
      }
    },
    {
      "Name": "7. 核对状态和价格",
      "Action": "quote.assert",
      "Parameters": {
        "status": "ACTIVE",
        "price": "2.5"
      }
    },
    {
      "Name": "8. 填写报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.6",
        "quantity": "1",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "9. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "保存修改"
      }
    },
    {
      "Name": "10. 核对状态和价格",
      "Action": "quote.assert",
      "Parameters": {
        "status": "ACTIVE",
        "price": "2.6"
      }
    }
  ]
}
