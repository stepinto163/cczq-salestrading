{
  "Version": 1,
  "Id": "06-invalid-price-recovery",
  "Name": "非法价格拒绝后修正重试",
  "Description": "P0：非法输入明确报错，不改变已有报价；修正后能继续保存。",
  "Steps": [
    {
      "Name": "精确报价输入并识别",
      "Action": "parse",
      "Parameters": {
        "text": "${securityId} 2.5 1 bid +1",
        "expectedRows": "1"
      }
    },
    {
      "Name": "勾选识别预览",
      "Action": "parse.select",
      "Parameters": {
        "row": "1",
        "selected": "true",
        "expectedCount": "1"
      }
    },
    {
      "Name": "确认精确报价",
      "Action": "parse.confirm",
      "Parameters": {
        "expectedCount": "1"
      }
    },
    {
      "Name": "打开报价管理修改表单并填写",
      "Action": "management.edit",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "not-a-price",
        "quantity": "1",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "核对拒绝提示与版本不变",
      "Action": "management.reject",
      "Parameters": {
        "button": "保存修改",
        "message": "价格必须为数字"
      }
    },
    {
      "Name": "7. 核对状态和价格",
      "Action": "quote.assert",
      "Parameters": {
        "status": "ACTIVE",
        "price": "2.5"
      }
    },
    {
      "Name": "打开报价管理修改表单并填写",
      "Action": "management.edit",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.6",
        "quantity": "1",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "保存报价修改",
      "Action": "management.save",
      "Parameters": {}
    },
    {
      "Name": "10. 核对状态和价格",
      "Action": "quote.assert",
      "Parameters": {
        "status": "ACTIVE",
        "price": "2.6"
      }
    }
  ],
  "Page": "03 报价管理/01 今日报价",
  "Feature": "02 修改与校验",
  "Priority": "P0"
}
