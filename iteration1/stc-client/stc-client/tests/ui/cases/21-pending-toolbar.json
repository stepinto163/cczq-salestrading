{
  "Version": 1,
  "Id": "21-pending-toolbar",
  "Name": "报价确认：批量工具栏全控件回归",
  "Description": "P0：两条独立测试报价，验证勾选范围、方向、固定步进与Enter调整、价格/清算、CRM下拉、五个旗标及互斥、确认持久化和删除；清理本例报价。",
  "Steps": [
    {
      "Name": "1. 打开手工报价",
      "Action": "manual.open",
      "Parameters": {}
    },
    {
      "Name": "2. 填写测试报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.5",
        "quantity": "1000",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "3. 保存待确认",
      "Action": "manual.click",
      "Parameters": {
        "button": "保存待确认"
      }
    },
    {
      "Name": "4. 核对待确认显示",
      "Action": "pending.assert",
      "Parameters": {}
    },
    {
      "Name": "5. 打开手工报价",
      "Action": "manual.open",
      "Parameters": {}
    },
    {
      "Name": "6. 填写测试报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.5",
        "quantity": "1000",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "7. 保存待确认",
      "Action": "manual.click",
      "Parameters": {
        "button": "保存待确认"
      }
    },
    {
      "Name": "8. 核对待确认显示",
      "Action": "pending.assert",
      "Parameters": {}
    },
    {
      "Name": "9. 核对全部工具栏控件",
      "Action": "pending.toolbar",
      "Parameters": {}
    }
  ]
}
