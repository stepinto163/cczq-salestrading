{
  "Version": 1,
  "Id": "20-smart-recommendation",
  "Name": "智能推荐：证据、反馈与字号回归",
  "Description": "P0：创建并确认一条报价，在真实STC行情表选中它，验证推荐加载、依据展开、方向/日期切换及反馈持久化及正式STC宿主中的字号；仅清理本例报价，历史证据与测试用户反馈按产品规则保留。",
  "Steps": [
    {
      "Name": "1. 打开手工报价",
      "Action": "manual.open",
      "Parameters": {}
    },
    {
      "Name": "2. 填写报价",
      "Action": "manual.fill",
      "Parameters": {
        "securityId": "${securityId}",
        "price": "2.5",
        "quantity": "1",
        "side": "1",
        "settlType": "2"
      }
    },
    {
      "Name": "3. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "保存待确认"
      }
    },
    {
      "Name": "4. 操作报价",
      "Action": "manual.click",
      "Parameters": {
        "button": "确认"
      }
    },
    {
      "Name": "5. 核对行情页推送",
      "Action": "market.assert",
      "Parameters": {}
    },
    {
      "Name": "6. 核对推荐及证据交互",
      "Action": "recommendation.assert",
      "Parameters": {}
    },
    {
      "Name": "7. 核对推荐面板字号",
      "Action": "recommendation.typography",
      "Parameters": {}
    }
  ]
}
