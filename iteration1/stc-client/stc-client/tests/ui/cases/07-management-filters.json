{
  "Version": 1,
  "Id": "07-management-filters",
  "Name": "报价管理侧栏过滤与重置",
  "Description": "P0：自建有效报价，真实区间和搜索控件验证消失、恢复、清除。",
  "Steps": [
    {
      "Name": "精确报价输入并识别",
      "Action": "parse",
      "Parameters": {
        "text": "${securityId} 2.5 1 bid +1",
        "expectedRows": "1"
      }
    },
    {
      "Name": "勾选识别预览",
      "Action": "parse.select",
      "Parameters": {
        "row": "1",
        "selected": "true",
        "expectedCount": "1"
      }
    },
    {
      "Name": "确认精确报价",
      "Action": "parse.confirm",
      "Parameters": {
        "expectedCount": "1"
      }
    },
    {
      "Name": "5. 核对管理页推送",
      "Action": "management.assert",
      "Parameters": {}
    },
    {
      "Name": "筛选前选中报价，验证刷新清除旧操作目标",
      "Action": "management.select",
      "Parameters": {}
    },
    {
      "Name": "6. 输入区间并核对筛选结果",
      "Action": "sidebar.range",
      "Parameters": {
        "page": "mgmt",
        "field": "bidPrice",
        "min": "3",
        "max": "4",
        "visible": "false"
      }
    },
    {
      "Name": "7. 输入区间并核对筛选结果",
      "Action": "sidebar.range",
      "Parameters": {
        "page": "mgmt",
        "field": "bidPrice",
        "min": "2.5",
        "max": "2.5",
        "visible": "true"
      }
    },
    {
      "Name": "8. 清除过滤并核对恢复",
      "Action": "sidebar.reset",
      "Parameters": {
        "page": "mgmt"
      }
    },
    {
      "Name": "9. 输入关键词并核对筛选结果",
      "Action": "sidebar.search",
      "Parameters": {
        "page": "mgmt",
        "text": "UI-ABSENT-BOND-938172",
        "visible": "false"
      }
    },
    {
      "Name": "10. 清除过滤并核对恢复",
      "Action": "sidebar.reset",
      "Parameters": {
        "page": "mgmt"
      }
    }
  ],
  "Page": "03 报价管理/01 今日报价",
