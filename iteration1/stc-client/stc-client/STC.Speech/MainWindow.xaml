<Window x:Class="STC.Speech.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Speech"
        mc:Ignorable="d" AllowsTransparency="True" Background="Transparent" 
        Title="成交播报" Height="280" Width="400" OpacityMask="White" ResizeMode="CanResize" Loaded="btnLoad" 
        WindowStyle="None" WindowState="Normal" WindowStartupLocation="CenterScreen" BorderThickness="0" Opacity="1"   MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="10,10,10,10">
        <Border.Background>
            <ImageBrush ImageSource="./images/stc_image_loginguanli_bg.png">

            </ImageBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="50">
                <TextBlock Width="150" Height="35" Margin="-240,0,0,0" Foreground="#FFFFFF" FontSize="20px">语音播报  V1.0.0</TextBlock>
                <Button Background="Transparent" Height="25" Width="25" Padding="0,-5,0,0" FontSize="25px" Foreground="#FFFFFF" Margin="365,0,0,8" BorderBrush="{x:Null}" Click="Button_Click">×</Button>
                <Button Background="Transparent" Height="25" Width="25" Foreground="#FFFFFF" Margin="315,0,0,8" BorderBrush="{x:Null}" Click="btnMin_Click">—</Button>
            </Grid>
            <Grid Grid.Row="1" Height="180">

                <Button Background="#238F7E" Height="30" Width="130" Name="startPlay" Click="starts" >立即启动</Button>
                <Button Background="#238F7E" Height="30" Width="130" Name="endPlay" Click="ends" Foreground="#FFEBC8" >正在播放中...</Button>
            </Grid>
            <Grid Grid.Row="2" Height="50">
                <TextBlock Width="75" Height="35" Padding="0,5,0,0" Margin="-300,0,0,0" Foreground="#FFFFFF" FontSize="17px">连接状态:</TextBlock>
                <TextBlock Width="200" Height="35" Padding="0,5,0,0" Margin="0,0,0,0" Foreground="#FFFFFF" FontSize="17px" Name="states"></TextBlock>
            </Grid>
        </Grid>
    </Border>



</Window>
