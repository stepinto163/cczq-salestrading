<Window x:Class="BDB.Trade.Plugin.View.Order.SendPointPriceViewLite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="提交意向" Height="318" Width="395" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" BorderThickness="1" BorderBrush="#0C4F44" ContentRendered="Window_ContentRendered" Initialized="Window_Initialized" KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="ButtonSendPriceBrush" StartPoint="0.6,0" EndPoint="0.6,1">
                <GradientStop Color="#E63034" Offset="0"/>
                <GradientStop Color="#971F21" Offset="1"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="TextBlockForGround" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>

            <SolidColorBrush x:Key="SelectItemBorderBrush" Color="#FFF9C152"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectItemBackground" Color="#FF9300"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectItemForeground" Color="#000000"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBorder" Color="#136C5E"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBackground" Color="#193D37"></SolidColorBrush>


            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Border" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Border" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Foreground" Color="#FEEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Border" Color="#00D198"/>
            <SolidColorBrush x:Key="ListBoxItem.Normal.Border" Color="#193D37"/>

            <ControlTemplate x:Key="AmountTextBox" TargetType="{x:Type TextBox}">
                <Border x:Name="Border"
                        Background="#FF7D00"
                        BorderBrush="#FF9200"
                        CornerRadius="2"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      Grid.Column="0"
                                      BorderThickness="0"
                                      VerticalAlignment="Stretch"
                                      x:Name="PART_ContentHost" />
                        <TextBlock Margin="0, 0, 3, 0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                                Width="10"
                                Height="{TemplateBinding Height}"
                                Text="万"/>

                    </Grid>
                </Border>
            </ControlTemplate>

            <ControlTemplate x:Key="PriceTextBox"
                             TargetType="{x:Type TextBox}">
                <Border x:Name="Border"
                        Background="#FF7D00"
                        BorderBrush="#FF9200"
                        CornerRadius="2"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      Grid.Column="0"
                                      BorderThickness="0"
                                      VerticalAlignment="Stretch"
                                      x:Name="PART_ContentHost" />
                        <TextBlock Margin="0, 0, 3, 0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                                Width="10"
                                Height="{TemplateBinding Height}"
                                Text="%"/>

                    </Grid>
                </Border>
            </ControlTemplate>

            <Style TargetType="{x:Type Button}" x:Key="BidButton">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Orange5}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"   Background="{TemplateBinding Background}"   
                            CornerRadius="2, 2, 0, 0"/>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="background" Value="{StaticResource ColorBrush.Orange6}"/>
                                </Trigger>
                                <!--<Trigger Property="IsMouseOver" Value="false">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Transparent}"/>
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Orange6}"/>
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Orange6}"/>
                                </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="OfrButton">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Blue8}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"   Background="{TemplateBinding Background}"   
                            CornerRadius="2, 2, 0, 0"/>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                       Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="background" Value="{StaticResource ColorBrush.Blue9}"/>
                                </Trigger>
                                <!--<Trigger Property="IsMouseOver" Value="false">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Transparent}"/>
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Blue9}"/>
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Blue9}"/>
                                </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="XBondButton">
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray13}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue10}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"   
                            CornerRadius="2, 2, 0, 0"/>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                       Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Blue8}"/>
                                    <!--<Setter Property="BorderBrush" TargetName="background" Value="{DynamicResource {x:Static SystemColors.HighlightBrush}}"/>-->
                                </Trigger>
                                <!--<Trigger Property="IsMouseOver" Value="false">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Transparent}"/>
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Blue8}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="BorderThickness" TargetName="background" Value="0"/>
                                    <Setter Property="BorderBrush" TargetName="background" Value="{StaticResource ColorBrush.Gray13}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DropShadowEffect x:Key="BidEffect" Color="#FF7D00" ShadowDepth="3" Direction="90" BlurRadius="5" RenderingBias="Quality"/>
            <DropShadowEffect x:Key="OfrEffect" Color="#009AFF" ShadowDepth="3" Direction="90" BlurRadius="5" RenderingBias="Quality"/>


            <LinearGradientBrush x:Key="BidLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#5E2E09" Offset="0"/>
                <GradientStop Color="#090E0E" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="OfrLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#073754" Offset="0"/>
                <GradientStop Color="#090E0E" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="listBoxItemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding SendPriceItem.DefaultItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding SendPriceItem.DirectionItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                <Setter Property="FontSize" Value="12"/>
                <!--<Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>-->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="BorkerTextStyle" TargetType="{x:Type TextBox}">
                <Border x:Name="SourceTraderBorder" BorderBrush="Transparent" Background="{StaticResource TPSC.ColorBrush}" BorderThickness="1"  Width="40"  Height="16" CornerRadius="6">
                    <TextBlock x:Name="SourceTraderText"  Foreground="{StaticResource DefaultForegroup.ColorBrush}" Text="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}"  FontFamily="PingFang SC" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger  Binding="{Binding Venues}" Value="TPSC">
                        <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                        <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}" Value="CTTJ">
                        <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                        <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}"  Value="CNEX">
                        <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                        <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}"  Value="CCTB">
                        <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                        <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}"  Value="PTCN">
                        <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                        <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent" >
                                <Border.Background>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_dropdownarrow_normal.png"/>
                                </Border.Background>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>-->
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="Button" x:Key="DatePickBtnStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent" >
                                <Border.Background>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_dropdownarrow_normal.png"/>
                                </Border.Background>
                                <!--<TextBlock Text="∨" Foreground="#FFF1DA" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>-->
                                <!--∧-->
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--数量和增加减少-->
            <Style TargetType="{x:Type Button}" x:Key="AmountButtonStyle">
                <Setter Property="Background" Value="#0A0F0E"/>
                <Setter Property="BorderBrush" Value="#0A0F0E"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#193D37"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#2CAB97 "/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="#0A0F0E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#0A0F0E"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="{x:Type Button}" x:Key="SettleBoxButtonStyle">
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"   Background="{TemplateBinding Background}"   
                            CornerRadius="2">
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Gray14}">
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Gray14}">
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="Control.Background" TargetName="background" Value="{Binding SendPriceItem.BorderBH}">
                                    </Setter>
                                    <Setter Property="Foreground" Value="#000000">
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--报价或需求-->
            <Style x:Key="SendPriceButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#136C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#2CAB97 "/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--报价或需求-->
            <Style x:Key="CancelPriceButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#3C3C3C"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderBrush" Value="#515151"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#515151"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#788187"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="#3C3C3C"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#515151"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--清算速度 +0 远 按钮-->
            <Style x:Key="SendPriceFilterListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!--<Setter Property="Padding" Value="0"/>-->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <!--<Setter Property="Padding" Value="10,0,10,0"/>-->
                <Setter Property="Width" Value="40"/>
                <Setter Property="Background" Value="#172422"/>
                <Setter Property="Margin" Value="1, 0, 0, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" BorderThickness="0, 1, 0, 0" VerticalAlignment="Center" Margin="1,0,0,0" 
                                BorderBrush="#193D37"  Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="Cp" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedInactive.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedActive.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedInactive.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedActive.Background}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{DynamicResource ListBoxItem.SelectedActive.Foreground}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--价格和数量-->
            <Style x:Key="SelfSendPriceTextBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#0B0C0C"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderBrush" Value="#0B0C0C"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="#0B0C0C" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="false"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                        <Condition Property="Tag" Value="1"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="Background" Value="#30009AFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                        <Condition Property="Tag" Value="0"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="Background" Value="#16FF7D00"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="true"/>
                                        <Condition Property="Tag" Value="1"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="Background" Value="#30009AFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="true"/>
                                        <Condition Property="Tag" Value="0"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="Background" Value="#16FF7D00"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="{Binding MaxPriceAreaHeight,Mode=TwoWay}"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#0A0F0E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>

            <!--<FrameCustomUI:HorseRaceLampView x:Name="horseRaceLampView" Height="23" Grid.Column="1"></FrameCustomUI:HorseRaceLampView>-->
            <TextBlock Grid.Row="0" Margin="10, 0, 0, 0" Height="16" HorizontalAlignment="Left" FontSize="{StaticResource SmallContentFontSize}">
                <Run Text="向" Foreground="#FFFFEBC8"></Run><Run Text="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}"  Foreground="#FFEBC8"/><Run Text="提交意向" Foreground="#FFEBC8"></Run>
                <Run Text="{Binding BidOrOfr}"  Foreground="{Binding SendPriceItem.BorderBH}"  FontWeight="Bold" />
                <Run Text="{Binding Security}" Foreground="#F9C152"  FontWeight="Bold" />
                <Run Text="{Binding ChsSecurity}" Foreground="#F9C152"  FontWeight="Bold" />
            </TextBlock>
            <Button Width="16" Height="16" Grid.Column="2" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
        </Grid>
        <!--Bid Ofr 按钮，待清理-->
        <Grid Grid.Row="1" Background="{StaticResource ColorBrush.Gray13}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="97*"/>
                <ColumnDefinition Width="21*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Button IsEnabled="{Binding BidButtonEnable}" Content="Bid" Command="{Binding BidCommand}" Grid.Column="2" Width="120" Height="30" Style="{StaticResource BidButton}" Background="{Binding SendPriceItem.BidBG}" >
            </Button>
            <Button IsEnabled="{Binding OfrButtonEnable}" Content="Ofr" Command="{Binding OfrCommand}"  Grid.Column="3" Width="120" Height="30" Style="{StaticResource OfrButton}" Background="{Binding SendPriceItem.OfrBG}">
                <!--<Button.Effect>
                    <DropShadowEffect Color="#89C9FF" BlurRadius="24" Direction="0" ShadowDepth="0"/>
                </Button.Effect>-->
            </Button>

            <Button IsEnabled="False" Content="{Binding SendPriceType}" Command="{Binding XBondCommand}" Grid.Column="4" Style="{StaticResource XBondButton}"></Button>

            <!--<Button Content="&gt;&gt; X-bond报价" Grid.Column="4" Foreground="{StaticResource ColorBrush.Blue10}" Background="Transparent" FontSize="12" />-->
        </Grid>

        <Border Grid.Row="2" BorderThickness="0, 0, 0, 0" BorderBrush="{Binding SendPriceItem.BorderBH}" Background="{Binding SendPriceItem.BorderBG}">
            <Grid ShowGridLines="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <!--详细信息-->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Margin="10, 0, 0, 0" Width="40" Height="16" Foreground="White" FontSize="11" HorizontalContentAlignment="Center" Template="{DynamicResource BorkerTextStyle}"></TextBox>
                    <StackPanel Grid.Row="0"  Grid.Column="1" Margin="4, 0, 0, 0" Height="16"  Orientation="Horizontal">
                        <TextBlock FontSize="{StaticResource SmallContentFontSize}" Text="{Binding OrderInfoTipLimit}" ToolTip="{Binding OrderInfoTip}" MaxWidth="286"  Foreground="#FFEBC8"  FontWeight="Bold" />
                        <TextBlock Text=" "  FontWeight="Bold"/>
                        <TextBlock Text="{Binding ChsPriceValid}"  FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChsPriceValid}"  Value="有效">
                                            <Setter Property="Foreground" Value="#21DF1F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ChsPriceValid}"  Value="无效">
                                            <Setter Property="Foreground" Value="#FF0000" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.RowSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <!--最优价-->
                        <Grid Grid.Column="0" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="10"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="市场最优" Grid.Row="0"  Margin="10,5,0,0" Grid.Column="0" HorizontalAlignment="Right"  Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Grid.Row="0"  Grid.Column="1" HorizontalAlignment="Right" Margin="6, 0, 0, 0">
                                <!--<TextBlock Text="{Binding SendPriceItem.BestBidInt}" Foreground="{StaticResource ColorBrush.Orange7}"  Margin="0, 2, 0, 0" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SendPriceItem.BestBidFloat}" Foreground="{StaticResource ColorBrush.Orange7}"  FontSize="12" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>-->
                                <TextBlock Text="{Binding AllBestBid}" Foreground="{Binding AllBestBidForground}"  FontSize="12" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!--<Rectangle Grid.Column="2" Width="1" Height="18" Stroke="{StaticResource ColorBrush.While}" Margin="6, 0, 0, 0"/>-->
                            <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Center"  Margin="4, 0, 0, 0">
                                <TextBlock Text="|" Foreground="#788187"  FontSize="12" TextAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="3" HorizontalAlignment="Left" Margin="4, 0, 0, 0">
                                <!--<TextBlock Text="{Binding SendPriceItem.BestOfrInt}" Foreground="{StaticResource ColorBrush.Blue8}"  Margin="0, 2, 0, 0" FontSize="12" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SendPriceItem.BestOfrFloat}" Foreground="{StaticResource ColorBrush.Blue8}"  FontSize="12" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"/>-->
                                <TextBlock Text="{Binding AllBestOfr}" Foreground="{Binding AllBestOfrForground}"  FontSize="12" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>


                        <TextBox x:Name="PriceTxt" Grid.Row="1" PreviewTextInput="TextBox_PreviewTextInput"  Width="144" Height="49" input:InputMethod.IsInputMethodEnabled="False"
                             ContextMenu="{x:Null}"  Tag="{Binding OfrOrBid, Mode=TwoWay}"
                             FontSize="24" BorderThickness="2" BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}" Text="{Binding CustomPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="10, 0, 0, 0" IsReadOnly="True" Style="{DynamicResource SelfSendPriceTextBox}" HorizontalContentAlignment="Center">
                        </TextBox>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="%" HorizontalAlignment="Right"  Foreground="{StaticResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="0, 30, 0, 0" Width="16"/>

                        <Grid Grid.Column="1" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4"></RowDefinition>
                                <RowDefinition Height="24"></RowDefinition>
                                <RowDefinition Height="24"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Button x:Name="btnAddPrice" Padding="0,-2,0,0" Margin="4,0,0,1" Grid.Row="1" TabIndex="-1" Width="32" Height="24" Content="+" IsEnabled="False"  Command="{Binding AddPriceCommand}" Style="{StaticResource AmountButtonStyle}" FontSize="12"/>
                            <Button x:Name="btnReducePrice" Padding="0,-3,0,0"  Margin="4,1,0,0"  Grid.Row="2" TabIndex="-1" Width="32" Height="24" Content="-" IsEnabled="False"   Command="{Binding ReducePriceCommand}" Style="{StaticResource AmountButtonStyle}"  FontSize="12"/>
                        </Grid>
                    </Grid>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="36"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <ListBox  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" SelectionMode="Single" Margin="8,0, 0, 0" 
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 Height="26" 
                                 Background="Transparent" MinWidth="130"
                                 BorderThickness="0"
                                 FontSize="12"  SelectedIndex="{Binding SetAmountTxtIndex, Mode=TwoWay}"
                                 VerticalAlignment="Center" HorizontalAlignment="Left" 
                                 BorderBrush="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem Width="46" Height="20" Content="2000" Style="{DynamicResource SendPriceFilterListBoxItemStyle}" Background="#0A0F0E"/>
                                <ListBoxItem Width="46" Height="20" Content="3000" Style="{DynamicResource SendPriceFilterListBoxItemStyle}" Background="#0A0F0E"/>
                                <ListBoxItem Width="46" Height="20" Content="5000" Style="{DynamicResource SendPriceFilterListBoxItemStyle}" Background="#0A0F0E"/>
                            </ListBox>
                        </Grid>

                        <TextBox   Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" x:Name="AmountTxt" Width="144" Height="49" FontSize="24" BorderThickness="2"  input:InputMethod.IsInputMethodEnabled="False"
                             PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown"  ContextMenu="{x:Null}" 
                             BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"  Text="{Binding AmountText, Mode=TwoWay}" Margin="9, 0, 0, 0" 
                             Tag="{Binding OfrOrBid, Mode=TwoWay}" Style="{DynamicResource SelfSendPriceTextBox}"   HorizontalContentAlignment="Center" TextChanged="AmountTxt_TextChanged"/>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="万" HorizontalAlignment="Right"  Foreground="{StaticResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="0,30,2,0" Width="16"/>
                        <Grid Grid.Column="1" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4"></RowDefinition>
                                <RowDefinition Height="24"></RowDefinition>
                                <RowDefinition Height="24"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Button x:Name="btnAddAmout" Padding="0,-2,0,0" Margin="4,0,0,0" Grid.Row="1" TabIndex="-1" Width="32" Height="24" Content="+" Command="{Binding AddAmountCommand}" Style="{StaticResource AmountButtonStyle}" FontSize="12" VerticalAlignment="Top"/>
                            <Button x:Name="btnReduceAmout" Padding="0,-3,0,0"  Margin="4,1,0,0"  Grid.Row="2" TabIndex="-1" Width="32" Height="24" Content="-" Command="{Binding ReduceAmountCommand}" Style="{StaticResource AmountButtonStyle}"  FontSize="12"/>
                        </Grid>
                    </Grid>

                </StackPanel>

                <!--清算速度 标题-->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="清算速度：" Margin="12, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="#788187" FontSize="12" />
                </Grid>

                <!--清算速度-->
                <Grid Grid.Row="6">
                    <WrapPanel>
                        <ListBox x:Name="LstSettleBox" 
                         FontSize="12"  SelectedIndex="{Binding SettleBoxIndex, Mode=TwoWay}"
                         SelectionMode="Single" Margin="10,4, 0, 6">
                            <ListBox.Template>
                                <ControlTemplate TargetType="{x:Type ListBox}">
                                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <WrapPanel Orientation="Horizontal" IsItemsHost="True">
                                        </WrapPanel>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </WrapPanel>
                </Grid>

                <!--愿意等待-->
                <Border  Grid.Row="7"  BorderThickness="0, 0, 0, 0">
                    <Grid Margin="0,1,0,-1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*"></ColumnDefinition>
                            <ColumnDefinition Width="65*"></ColumnDefinition>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"  VerticalAlignment="Center" Text="愿意等待"  Margin="10, 3, 0, 0" 
                                  Height="20"   
                                  FontSize="{StaticResource SmallContentFontSize}" Background="{StaticResource ColorBrush.Transparent}"
                                  Foreground="{StaticResource ColorBrush.Gray14}"></TextBlock>

                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0"  Grid.ColumnSpan="3"  Margin="10,-6,0,0">

                            <Component:NumericUpDown  NumericValue="{Binding IocOutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  PreviewKeyDown="TextBox_PreviewKeyDown"  ContextMenu="{x:Null}" DecimalLength="0"  Width="51" Height="24"  RangeValue="5"  MaxValue="300" MinValue="1"  ToolTip="输入范围:1-300秒" Margin="4,8" ValueChanged="NumericUpDown_ValueChanged"></Component:NumericUpDown>

                            <TextBlock Text="秒" Grid.Column="2" TextAlignment="Center" VerticalAlignment="Center" Margin="5, 0, 0, 0"  
                                    Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12"/>

                            <ListBox Grid.Column="0" SelectionMode="Single" Margin="10,4, 0, 6" 
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 Height="26" 
                                 Background="Transparent" MinWidth="130"
                                 BorderThickness="0"
                                 FontSize="12"  SelectedIndex="{Binding SetTimeOutIndex, Mode=TwoWay}"
                                 VerticalAlignment="Center" HorizontalAlignment="Left" 
                                 BorderBrush="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem x:Name="btnSetTimeOut20"  Width="32" Height="24"  Content="20" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                                <ListBoxItem x:Name="btnSetTimeOut30" Width="32" Height="24" Content="30" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                                <ListBoxItem x:Name="btnSetTimeOut60"  Width="32" Height="24" Content="60" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!--提交-->
        <Border Grid.Row="3" BorderThickness="0, 1, 0, 1" BorderBrush="#0C4F44" Background="{StaticResource ColorBrush.Gray13}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="64"></ColumnDefinition>
                    <ColumnDefinition Width="102"></ColumnDefinition>
                    <ColumnDefinition Width="10"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="*请详细确认以上信息" HorizontalAlignment="Left" 
                           Foreground="#FFEBC8" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Width="113"/>

                <Button Grid.Row="0" Grid.Column="1"  Margin="0,-2,2,0" Content="取消" Command="{Binding CancelCommand}" FontSize="12"
                        Style="{DynamicResource CancelPriceButton}" Width="60" Height="24" HorizontalAlignment="Right"/>
                <Button Grid.Row="0" Grid.Column="2" Margin="2,-2,0,0" Content="提交" IsEnabled="{Binding SendPriceEnable,Mode=TwoWay,Converter={StaticResource booleanConvertor}}"  Command="{Binding OkCommand}" FontSize="12" 
                        Style="{DynamicResource SendPriceButton}" Width="100" Height="24" />

            </Grid>
        </Border>
    </Grid>
</Window>
