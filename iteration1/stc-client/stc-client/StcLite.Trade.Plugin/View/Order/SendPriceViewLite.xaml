                    <Button x:Name="OfrBtn" Content="Ofr" Command="{Binding OfrCommand}" Tag="{Binding IsBidSelect,Mode=TwoWay}"  Grid.Column="1" Margin="0,0,8,0"  Width="188" Height="30" Style="{StaticResource OfrButton}" Background="{Binding SendPriceItem.OfrBG}">
                        <!--<Button.Effect>
                        <DropShadowEffect Color="#89C9FF" BlurRadius="24" Direction="0" ShadowDepth="0"/>
                    </Button.Effect>-->
                    </Button>
                </Grid>
                <!--<Button Content="&gt;&gt; X-bond报价" Grid.Column="4" Foreground="{StaticResource ColorBrush.Blue10}" Background="Transparent" FontSize="12" />-->
            </Border>

            <Border Grid.Row="2" BorderThickness="2, 0, 2, 0" x:Name="Border_Left3" BorderBrush="#0C4F44" Background="{Binding SendPriceItem.BorderBG}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
