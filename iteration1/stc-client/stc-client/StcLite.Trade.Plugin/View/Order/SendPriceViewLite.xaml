                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <!--最优价-->
                            <Grid Grid.Column="0" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="10"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="市场最优" Grid.Row="0"  Margin="10,5,0,0" Grid.Column="0" HorizontalAlignment="Right"  Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Grid.Row="0"  Grid.Column="1" HorizontalAlignment="Right" Margin="6, 0, 0, 0">
                                    <!--<TextBlock Text="{Binding SendPriceItem.BestBidInt}" Foreground="{StaticResource ColorBrush.Orange7}"  Margin="0, 2, 0, 0" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SendPriceItem.BestBidFloat}" Foreground="{StaticResource ColorBrush.Orange7}"  FontSize="12" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>-->
                                    <TextBlock Text="{Binding AllBestBid}" Foreground="{Binding AllBestBidForground}"  FontSize="12" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!--<Rectangle Grid.Column="2" Width="1" Height="18" Stroke="{StaticResource ColorBrush.While}" Margin="6, 0, 0, 0"/>-->
                                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Center"  Margin="4, 0, 0, 0">
                                    <TextBlock Text="|" Foreground="#788187"  FontSize="12" TextAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="3" HorizontalAlignment="Left" Margin="4, 0, 0, 0">
                                    <!--<TextBlock Text="{Binding SendPriceItem.BestOfrInt}" Foreground="{StaticResource ColorBrush.Blue8}"  Margin="0, 2, 0, 0" FontSize="12" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SendPriceItem.BestOfrFloat}" Foreground="{StaticResource ColorBrush.Blue8}"  FontSize="12" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"/>-->
                                    <TextBlock Text="{Binding AllBestOfr}" Foreground="{Binding AllBestOfrForground}"  FontSize="12" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="PriceTxt" Grid.Row="1" PreviewTextInput="TextBox_PreviewTextInput"  Width="144" Height="49" input:InputMethod.IsInputMethodEnabled="False"
                                 PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"  Tag="{Binding OfrOrBid, Mode=TwoWay}"
                                 FontSize="24" BorderThickness="2" BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}" Text="{Binding CustomPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="10, 0, 0, 0" Style="{DynamicResource SelfSendPriceTextBox}" HorizontalContentAlignment="Center">
                            </TextBox>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="%" HorizontalAlignment="Right"  Foreground="{StaticResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="0, 30, 0, 0" Width="16"/>

                            <Grid Grid.Column="1" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"></RowDefinition>
                                    <RowDefinition Height="24"></RowDefinition>
                                    <RowDefinition Height="24"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Button x:Name="btnAddPrice" Padding="0,-2,0,0" Margin="4,0,0,1" Grid.Row="1" TabIndex="-1" Width="32" Height="24" Content="+" Command="{Binding AddPriceCommand}" Style="{StaticResource AmountButtonStyle}" FontSize="12"/>
                                <Button x:Name="btnReducePrice" Padding="0,-3,0,0"  Margin="4,1,0,0"  Grid.Row="2" TabIndex="-1" Width="32" Height="24" Content="-" Command="{Binding ReducePriceCommand}" Style="{StaticResource AmountButtonStyle}"  FontSize="12"/>
                            </Grid>
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="36"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <ListBox  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" SelectionMode="Single" Margin="8,0, 0, 0" 
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 Height="26" 
                                 Background="Transparent" MinWidth="130"
                                 BorderThickness="0"
                                 FontSize="12"  SelectedIndex="{Binding SetAmountTxtIndex, Mode=TwoWay}"
                                 VerticalAlignment="Center" HorizontalAlignment="Left" 
                                 BorderBrush="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem Width="48" Height="20" Content="2000" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"  Background="#0A0F0E"/>
                                <ListBoxItem Width="48" Height="20" Content="3000" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"  Background="#0A0F0E"/>
                                <ListBoxItem Width="48" Height="20" Content="5000" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"  Background="#0A0F0E"/>
                            </ListBox>
                        </Grid>

                            <TextBox   Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Width="146" x:Name="AmountTxt" Height="49" FontSize="24" BorderThickness="2"  input:InputMethod.IsInputMethodEnabled="False"
                                 PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" TextChanged="AmountTxt_TextChanged"
                                 BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"  Text="{Binding CustomAmout, Mode=TwoWay}" Margin="4,3,32,4" 
                                 Tag="{Binding OfrOrBid, Mode=TwoWay}" Style="{DynamicResource SelfSendPriceTextBox}"   HorizontalContentAlignment="Center"/>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="万" HorizontalAlignment="Right"  Foreground="{StaticResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="0,30,2,0" Width="16"/>
                            <Grid Grid.Column="1" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"></RowDefinition>
                                    <RowDefinition Height="24"></RowDefinition>
                                    <RowDefinition Height="24"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Button x:Name="btnAddAmout" Padding="0,-2,0,0" Margin="2,0,0,1" Grid.Row="1" TabIndex="-1" Width="32" Height="24" Content="+" Command="{Binding AddAmountCommand}" Style="{StaticResource AmountButtonStyle}" FontSize="12"/>
                                <Button x:Name="btnReduceAmout" Padding="0,-3,0,0"  Margin="2,1,0,0"  Grid.Row="2" TabIndex="-1" Width="32" Height="24" Content="-" Command="{Binding ReduceAmountCommand}" Style="{StaticResource AmountButtonStyle}"  FontSize="12"/>
                            </Grid>
                        </Grid>

                    </StackPanel>

                    <!--清算速度 标题-->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="清算速度：" Margin="12, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="#788187" FontSize="12" />
                    </Grid>

                    <!--清算速度-->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="SettlTypeCombox" Grid.Column="2" Width="60" Tag="{Binding AddOneOpenedTag}"  Text="{Binding AddOneShowText}"  Margin="12, 1, 0, 5"  Height="24" Padding="4, 3, 0, 0" 
                                Style="{DynamicResource SelfFilterComboxStyle}" SelectedIndex="{Binding SettleBoxIndex2,Mode=TwoWay}" >
                                <ComboBoxItem Content="+1"></ComboBoxItem>
                                <ComboBoxItem Content="今+1"></ComboBoxItem>
                                <ComboBoxItem Content="明+0"></ComboBoxItem>
                            </ComboBox>
                            <ListBox x:Name="SettlTypeListBox" Grid.Column="0" SelectionMode="Single" Margin="0, 0, 0, 4" 
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden" Visibility="{Binding SettleBoxVisibility}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                             Height="26" 
                             Background="Transparent" MinWidth="126"
                             BorderThickness="0"
                             FontSize="12" SelectedIndex="{Binding SettleBoxIndex, Mode=TwoWay}" 
                             VerticalAlignment="Center" HorizontalAlignment="Left" 
                             BorderBrush="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem x:Name="lbOne" Width="0" Height="24" Content="+1"  Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                                <ListBoxItem x:Name="lbTomOne" Width="60" Height="24"  Content="+0" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                                <ListBoxItem x:Name="lbOther" Width="60" Height="24" Content="远" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                            </ListBox>

                            <DatePicker x:Name="datePicker" Grid.Column="1" Width="90" Height="24" Margin="8, 0, 0, 6"
                                    SelectedDate="{Binding SelectDate,Mode=TwoWay}" Visibility="{Binding SendPriceItem.DateVisible}"  Style="{DynamicResource DatePickerStyle}">
                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="IsReadOnly" Value="True"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>

                            <ComboBox x:Name="cbSettle" Grid.Column="2" Width="48"  Margin="4,0,0,6"  Height="24" Padding="4, 3, 0, 0" SelectedIndex="{Binding ComboBoxSelectIndex,Mode=TwoWay}" 
                                  Visibility="{Binding SendPriceItem.SettleTypeVisible}"  Style="{DynamicResource ComboBoxStyle2}">
                                <ComboBoxItem Content="T+0" Tag="1"></ComboBoxItem>
                                <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" BorderThickness="2, 1, 2, 1" x:Name="Border_Left4" BorderBrush="#0C4F44" Background="{StaticResource ColorBrush.Gray13}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"></RowDefinition>
                        <RowDefinition Height="36"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Button Grid.Column="2" Grid.Row="0" Margin="368,-24,0,6" Content=">>" x:Name="btn_Expand" Tag="Collapsed" Padding="6,-1,0,0" Style="{DynamicResource ExpandButton}"  Command="{Binding ExpandCommand}"  Foreground="#FFEBC8" Width="26" Height="24" />
                    <Grid Grid.Row="0">
                        <TextBlock Grid.Row="0" Text="有效时长：" Margin="12, 12, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="#788187" FontSize="12" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal"  Grid.Column="0">
                            <ComboBox x:Name="cbSettle2" Grid.Column="2" Width="60"  Margin="12,0,0,0"  Height="24" Padding="4, 3, 0, 0" 
                                Style="{DynamicResource PriceComboBox}" SelectedIndex="{Binding ValidSelectIndex,Mode=TwoWay}">
                                <ComboBoxItem Content="默认" Tag="1"></ComboBoxItem>
                                <ComboBoxItem Content="时长" Tag="2"></ComboBoxItem>
                                <ComboBoxItem Content="时点" Tag="3"></ComboBoxItem>
                            </ComboBox>
                            <TextBlock Grid.Row="0" Margin="10, 0, 0, 0"  Height="16" HorizontalAlignment="Left" Grid.Column="0"  FontSize="12"  Visibility="{Binding DefaultValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                <Run Text="每日" Foreground="{StaticResource ColorBrush.Gray14}" />
                                <Run Text="6:00、12:00、16:30" Foreground="#F9C152"/>
                                <Run Text="自动撤回"  Foreground="{StaticResource ColorBrush.Gray14}"/>
                            </TextBlock>
                            <!--时长-->
                            <StackPanel Orientation="Horizontal" Height="24" Grid.Column="0"  Margin="6, 0, 0, 0"  Visibility="{Binding HourValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                <Component:WatermarkTextBox WaterMark="" ContextMenu="{x:Null}" Tag="1" MaxLength="3" x:Name="ValidMinute" PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" Text="{Binding ValidMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputMethod.IsInputMethodEnabled="False" Width="28"  Height="24" BorderBrush="#193D37"  Padding="0, 0, 0, 0" Style="{StaticResource SendPriceTimeTextBox}">
                                    <TextBox.ToolTip>
                                        <ToolTip Content="输入范围:0-500分钟"></ToolTip>
                                    </TextBox.ToolTip>
                                </Component:WatermarkTextBox>
                                <TextBlock Grid.Row="0" Text="分" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                                <Component:WatermarkTextBox  WaterMark="" ContextMenu="{x:Null}"  Margin="6,0,0, 0" Tag="0"  MaxLength="2"  x:Name="ValidSecond"   PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0"  Style="{StaticResource SendPriceTimeTextBox}">
                                    <TextBox.ToolTip>
                                        <ToolTip Content="输入范围:0-60"></ToolTip>
                                    </TextBox.ToolTip>
                                </Component:WatermarkTextBox>
                                <TextBlock Grid.Row="0" Text="秒"  Height="16"  Margin="6, 0, 0, 0" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="后失效" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                            </StackPanel>
                            <!--时点-->
                            <StackPanel Orientation="Horizontal" Height="24"  Grid.Column="0"  Margin="10, 0, 0, 0" Visibility="{Binding TimeValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                <Component:WatermarkTextBox  WaterMark="时" ContextMenu="{x:Null}" Tag="2" MaxLength="2" x:Name="ValidTimeHour"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False" Width="28" Height="24" BorderBrush="#193D37"  Padding="0, 0, 0, 0" Style="{StaticResource SendPriceTimeTextBox}">
                                    <TextBox.ToolTip>
                                        <ToolTip Content="输入范围:0-24"></ToolTip>
                                    </TextBox.ToolTip>
                                </Component:WatermarkTextBox>
                                <TextBlock Grid.Row="0" Text=":"  Margin="6,0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                                <Component:WatermarkTextBox WaterMark="分" ContextMenu="{x:Null}"  Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="ValidTimeMinute"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0"  Style="{StaticResource SendPriceTimeTextBox}">
                                    <TextBox.ToolTip>
                                        <ToolTip Content="输入范围:0-60"></ToolTip>
                                    </TextBox.ToolTip>
                                </Component:WatermarkTextBox>
                                <TextBlock Grid.Row="0" Text=":"   Margin="6, 0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                                <Component:WatermarkTextBox WaterMark="秒" ContextMenu="{x:Null}" Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="ValidTimeSecond"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0"  Style="{StaticResource SendPriceTimeTextBox}">
                                    <TextBox.ToolTip>
                                        <ToolTip Content="输入范围:0-60"></ToolTip>
                                    </TextBox.ToolTip>
                                </Component:WatermarkTextBox>
                                <TextBlock Grid.Column="1" Text="失效" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition Height="38"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding BrokerWarning}" Margin="12, 10, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="#788187" FontSize="12" />
                        <CheckBox IsChecked="{Binding DirectionCheck, Mode=TwoWay}"  Grid.Row="0" Width="50" IsEnabled="{Binding DirectionEnable}" Visibility="Collapsed"
                                  Foreground="{StaticResource ColorBrush.While}" FontSize="12"
                                  Style="{StaticResource CheckBoxThemeColor}" Command="{Binding AppointCommand}"
                                 Content="指定"></CheckBox>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="29*"></ColumnDefinition>
                                <ColumnDefinition Width="107*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="12, 0, 0, 0"  Grid.Column="0" Grid.ColumnSpan="2">
                                <!--<ListBox x:Name="lbDirect" IsEnabled="True"  SelectionMode="Extended" ItemsSource="{Binding DirectionItems}" ItemContainerStyle="{StaticResource itemContainStyle}"
                                 BorderBrush="Transparent" Background="Transparent" SelectionChanged="LbDirect_SelectionChanged">
                                    -->
                                <!--SelectedIndex="{Binding SendPriceItem.ChannelIndex}">-->
                                <!--
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <ListBoxItem Width="60" Height="24"  FontSize="12"></ListBoxItem>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>-->
                                <Comp:PriceBrokerFilterView x:Name="lbDirect"  DefaultSelectItem="{Binding DefaultSelectItem, Mode=TwoWay}" LockOtherNotSelectItem="{Binding LockOtherNotSelectItem,Mode=TwoWay}" VerticalAlignment="Center"  HorizontalAlignment="Left" Visibility="Visible"  FilterDicChanged="LbDirect_SelectionChanged"  />
                            </StackPanel>

                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" BorderThickness="2, 0, 2, 2" x:Name="Border_Left5" CornerRadius="0,0,4,4" BorderBrush="#0C4F44" Background="{StaticResource ColorBrush.Gray13}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"></ColumnDefinition>
                            <ColumnDefinition Width="60"></ColumnDefinition>
                            <ColumnDefinition Width="4"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="10"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0" Margin="12,0,0,0" Text="*请详细确认以上信息" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextBlockForeColor}" FontSize="12" VerticalAlignment="Center"/>

                        <TextBlock Visibility="Collapsed" Grid.Row="1" Text="{Binding SendPriceItem.CustomQty}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextBlockForeColor}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" />

                        <TextBlock Visibility="Collapsed" Grid.Row="2" Text="{Binding SendPriceItem.MarketQty}"  HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextBlockForeColor}" FontSize="12" VerticalAlignment="Center" Margin="2,0,8,0"/>

                        <Button Grid.Column="1" Grid.Row="0" Margin="0,0,0,0"  Content="取消" Command="{Binding CancelCommand}" FontSize="12" Foreground="{DynamicResource TextBlockForeColor}" 
                            Style="{DynamicResource CancelPriceButton}"  Width="60" Height="24"/>
                        <Button Grid.Column="3" Grid.Row="0" Margin="0,0,0,0" Content="发布" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding OkCommand}" FontSize="12" Style="{DynamicResource SendPriceButton}" Width="100" Height="24"/>

                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--行情窗口 Visibility="{Binding CardViewVisibility}"  BorderBrush="#0C4F44"-->
        <Grid  Background="Transparent" Grid.Column="1" Visibility="{Binding CardViewVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="280"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#0C4F44" Margin="-1,0,0,0"  x:Name="Border_Right1" BorderThickness="1,2,2,0" Padding="1,1,1,0"  CornerRadius="4,4,0,0"  Background="#0A0F0E">
                <local:PriceView x:Name="dgPrice"></local:PriceView>
            </Border>

            <Border Grid.Row="1" BorderBrush="#0C4F44" Margin="-1,0,0,0"  x:Name="Border_Right2" BorderThickness="2,0,2,2"  CornerRadius="0,0,4,4" Padding="1,0,1,1"  Background="#0A0F0E">
                <local:MarketOrderView x:Name="dgMarket"></local:MarketOrderView>
            </Border>
        </Grid>
    </Grid>
</Window>
