                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#2CAB97"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="2"></Setter>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="1"/>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#136C5E"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#2CAB97"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                                
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="1"/>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#193D37"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="0"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#172422"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#172422"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

