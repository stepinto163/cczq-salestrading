<Window x:Class="StcLite.Trade.Plugin.View.Order.SendPriceWarnView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="报价注意" d:DesignHeight="207" d:DesignWidth="413" Height="207" Width="413" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" Loaded="window_Loaded" BorderThickness="1" BorderBrush="#A0A0A0">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/StcLite.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DefalutTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            
        </ResourceDictionary>
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Border BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Black}" CornerRadius="2"
                Background="{StaticResource ColorBrush.Gray18}" Visibility="{Binding SuccessVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="[报价成功]" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Green15}" FontSize="12"></TextBlock>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="您的报价 " Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>

                    <TextBlock Text=" 已报价成功 " Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>

                </StackPanel>

            </Grid>
        </Border>


        <Grid Background="{StaticResource ColorBrush.Gray13}" Visibility="{Binding FailVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="23"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{Binding ShowTitleBG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title}" Width="48" Margin="10, 4, 0, 0" FontWeight="Bold"
                               Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource SmallContentFontSize}"/>
                <Button Width="16" Height="16" Grid.Column="2" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
            </Grid>

            <Border VerticalAlignment="Stretch" Grid.Row="1" BorderThickness="1, 0, 1, 1" BorderBrush="{Binding ShowBdBG}" Background="{Binding ShowBG}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0" Background="{Binding ShowBG}">
                        <StackPanel x:Name="spRisk" Grid.Row="0" Orientation="Vertical">
                            <!--<local:SendPriceRiskView />-->
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">


                        <Button HorizontalAlignment="Center" Margin="{Binding CancelBtnThickness}" Content="取消" Command="{Binding CloseCommand}" 
                            Height="24" Width="60" Foreground="#FFFFFF" Style="{StaticResource SmallCancelBtnStyle}"></Button>
                        <Button x:Name="btnOk" Visibility="{Binding OkVisibility}" HorizontalAlignment="Center" Margin="{Binding OkBtnThickness}" Content="已确认，发出" Command="{Binding OkCommand}" 
                            Height="24" Width="100" Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}"></Button>

                    </Grid>

                </Grid>
            </Border>
        </Grid>
       
    </Grid>
</Window>
