    </UserControl.Resources>

    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="70*"></RowDefinition>
            <RowDefinition Height="10"></RowDefinition>
            <RowDefinition Height="30*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="9"></ColumnDefinition>
            <ColumnDefinition Width="340"></ColumnDefinition>
        </Grid.ColumnDefinitions>

         <!--水平分割-->
        <Button x:Name="btnHor" Grid.Row="2" Grid.Column="0" Width="40" Height="6" Content="∨" Padding="0, -3, 0, 0" FontSize="9" Style="{StaticResource SplitButtonStyle}"
                Margin="0, 1, 0, 1" Panel.ZIndex="1" Click="BtnHor_Click"  Visibility="Collapsed"></Button>

        <GridSplitter x:Name="gsHor" ResizeDirection="Rows" Grid.Row="2" Grid.Column="0" Background="{StaticResource GreenButton.Static.Background}" Margin="0, 1, 0, 1"
                      Foreground="{StaticResource GreenButton.Static.Foreground}" Style="{StaticResource HorGridSplitter}"  Visibility="Collapsed"/>

        <!--垂直分割-->
        <Button x:Name="btnVer" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Width="8" Height="40" Padding="0, 0, 0, 0" Margin="1, 0, 1, 0" Content=">" 
                FontSize="8" Style="{StaticResource SplitButtonStyle}"  Panel.ZIndex="1" Click="BtnVer_Click"  Visibility="Collapsed"></Button>
        <GridSplitter x:Name="gsVer" Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Background="{StaticResource GreenButton.Static.Background}" Margin="1, 0, 0, 1"
                      Foreground="{StaticResource GreenButton.Static.Foreground}" Style="{StaticResource VerGridSplitter}" Visibility="Collapsed"/>

        <!--工具栏-->
        <StackPanel x:Name="spSearch" Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="1" Margin="0, 6, 0, 0">
            <Button x:Name="btnCustomAdd" Grid.Column="2" FontSize="12" Width="69" Height="24" Content="+分组" Margin="4, 0, 0, 0" Command="{Binding AddGroupCommand}"
                    Style="{StaticResource AddButtonStyle}"></Button>

            <Button x:Name="AddBondsBtn" Content="+ 导入" Width="69" Height="24" Margin="4 0 0 0" Style="{StaticResource AddButtonStyle}" Click="AddBondsBtn_Click"/>
            <Button x:Name="DistinctBondsBtn" Content="去重" Width="69" Height="24" Margin="4 0 0 0" Style="{StaticResource AddButtonStyle}" Click="DistinctBondsBtn_Click"/>
            <Button x:Name="ExportBtn" ToolTip="导出当前页面债券列表" Width="24" Height="24" Margin="4 0 0 0" Style="{StaticResource CopyButton}" Click="ExportBtn_Click"/>
            <Button x:Name="AdjustBondsBtn" Content="整理" ToolTip="一键排版" Visibility="Collapsed" Width="69" Height="24" Margin="4 0 0 0" Style="{StaticResource AddButtonStyle}" Click="AdjustBondsBtn_Click"/>

            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Comp:CustomSettleView x:Name="sfvSettle" Grid.Column="0" FilterDicChanged="SettleFilterView_FilterDicChanged" Margin="4, 0, 0, 0"></Comp:CustomSettleView>

                <Comp:CustomeAllBrokerFilterView x:Name="allBroker" Grid.Column="1" FilterDicChanged="allBroker_FilterDicChanged" Margin="0, 0, 0, 0"></Comp:CustomeAllBrokerFilterView>


            </Grid>


            <Button x:Name="btnCustomerSettle" Width="40" Height="24" Visibility="Collapsed" Foreground="#FFEBC8" FontSize="{StaticResource FontSize-12}" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"
                    Margin="2,0,0,0" Click="BtnCustomerSettle_Click" Background="#172422" BorderBrush="#FF963D"  Style="{DynamicResource SettleButtonStyle}" />

            <Button x:Name="Bid_OrderBtn" Visibility="Collapsed" Content="Bid" Width="64" Height="24" Foreground="#FFEBC8" FontSize="{StaticResource FontSize-12}" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"
                    Margin="10,0,0,0" Click="Bid_OrderBtn_Click" Background="#D76900" BorderBrush="#FF963D"  Style="{DynamicResource OrderButtonStyle}" />

            <Button x:Name="Ofr_OrderBtn" Visibility="Collapsed" Content="Ofr" Width="64" Height="24" Foreground="#FFEBC8" FontSize="{StaticResource FontSize-12}"
                    Margin="10,0,0,0" Click="Ofr_OrderBtn_Click" Background="#0069AF" BorderBrush="#89C9FF" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"
                        Style="{DynamicResource OrderButtonStyle}"/>

            <Component:SearchTextBox Width="160" Margin="12, 0, 0, 0" Height="22" Visibility="Collapsed"></Component:SearchTextBox>

            <Button Content="添加债券" Width="60" Height="22" Margin="8, 0, 0, 0" Style="{StaticResource GreenButtonStyle}" Visibility="Collapsed" Command="{Binding AddBondCommand}"></Button>
            <!--<Button Content="更多筛选" Width="60" Height="22" Margin="8, 0, 0, 0" Style="{StaticResource GreenButtonStyle}"></Button>-->

        </StackPanel>

        <!--工具栏右-->
        <Grid Grid.Row="0" HorizontalAlignment="Right" Grid.ColumnSpan="3" Panel.ZIndex="1">

            <StackPanel Orientation="Horizontal" Margin="0, 2, 5, 0">

                <Button x:Name="btnSearch" Visibility="Collapsed" Style="{StaticResource SearchButton}" Width="24" Height="24" Margin="0, 0, 4, 0" Click="BtnSearch_Click"></Button>

                <Comp:SearchEditUI x:Name="seSearch" Height="24" Width="190" Visibility="Collapsed" SearchChanged="SeSearch_SearchChanged" Margin="0, 0, 4, 0"></Comp:SearchEditUI>


                <Button Style="{StaticResource SortButton}" Width="24" ToolTip="排序" Height="24" Margin="0, 0, 4, 0" Visibility="Collapsed"></Button>
                <Button x:Name="btnFilter" Visibility="Collapsed" Style="{StaticResource NewFilterButton}" ToolTip="筛选" Width="24" Height="24" Click="Button_Click"></Button>
                
                <TextBlock Visibility="Collapsed" Text="排序:" Margin="8,0,0,0" Foreground="{StaticResource GrayButton.Disabled.Foreground}" FontSize="{StaticResource FontSize-12}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Font.MicrosoftYaHei}"></TextBlock>

                <ComboBox x:Name="CancelAll_CBC" Visibility="Collapsed" Width="80" Height="22" Margin="8,0,5,0"  HorizontalAlignment="Right" Background="#193D37"
                      Style="{StaticResource CustomComboBoxStyle}">
                    <ComboBoxItem Content="自定义" IsSelected="True" Style="{StaticResource CloseAllComboBoxStyle}">

                    </ComboBoxItem>
                    <ComboBoxItem Content="一键撤量化订单" Style="{StaticResource CloseAllComboBoxStyle}" >

                    </ComboBoxItem>
                </ComboBox>


                <Rectangle Width="1" Height="18" Fill="#3C3C3C" HorizontalAlignment="Right" Margin="8,0,0,0" Visibility="Collapsed"/>



                <Border x:Name="lbPirceBorder" BorderBrush="#315850" BorderThickness="1" CornerRadius="2" Height="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="cbList" IsChecked="True" Tag="0"
                                  Click="TitleBorker_Click"
                                  Foreground="#8F9598"
                                  Style="{StaticResource cbList}" Width="20" Height="20" />
                        <RadioButton x:Name="cbChart" Grid.Column="1" Tag="1"
                                  Click="TitleBorker_Click"
                                  Foreground="#8F9598"
                                  Style="{StaticResource cbChart}" Width="20" Height="20" />
                    </Grid>
                </Border>


                <RadioButton x:Name="rbCardMode" Width="20" Height="24" ToolTip="卡片模式" Foreground="White" Content="卡" HorizontalAlignment="Right" Visibility="Visible"
                             Margin="2,0,0,0"  Checked="RbCardMode_Checked" Style="{StaticResource CardMode_RadioButton}" Click="RbCardMode_Click"/>
                <RadioButton x:Name="rbListMode" Width="20" Height="24" ToolTip="表格模式" Foreground="White" Content="列" HorizontalAlignment="Right" Visibility="Visible"
                             Margin="2,0,0,0" Checked="RbListMode_Checked" Style="{StaticResource ListMode_RadioButton}" Click="RbListMode_Click"/>

                <Button x:Name="btnPopup" ToolTip="弹出" Width="20" Height="20" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PopupButton}"
                        Visibility="Collapsed"
                        Command="{StaticResource PopupWindowCommand}" CommandParameter="{x:Static command:PopupTypeEnum.HomePage}"/>
            </StackPanel>
        </Grid>

        <!--标签页-->
        <dragablz:TabablzControl x:Name="tcPlugin" ConsolidateOrphanedItems="True" Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="3" SelectedItem="{Binding SelectTab}"
                                     Style="{StaticResource CustomTabablzControlStyle}" Background="Transparent" BorderThickness="0"  
                             ShowDefaultCloseButton="True" SelectionChanged="tcPlugin_SelectionChanged">


            <!--<TabItem IsSelected="True" Header="Tab No.1">
                <Trade:TestView/>
            </TabItem>-->

            <!--<TabItem  Header="Tab No.2">

            </TabItem>-->

        </dragablz:TabablzControl>

        <!--行情小窗-->
        <Border x:Name="borderPriceView" Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Margin="0, 5, 2, 2" CornerRadius="2" BorderBrush="#136C5E" BorderThickness="1" Background="#0A0F0E"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="204*"/>
                    <ColumnDefinition Width="115*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="298"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <!--<Trade:PriceView x:Name="priceView" Grid.Row="0" Margin="2, 3, 2, 2" Grid.ColumnSpan="2" MinHeight="298" Height="Auto"></Trade:PriceView>-->
                <Card:PriceAndOrderView x:Name="priceView" Grid.Row="0" Grid.ColumnSpan="2" MinHeight="298" Height="Auto"
                                         Grid.RowSpan="2" CardMode="AloneWindow"></Card:PriceAndOrderView>

                <!--Chart:LinePage Grid.Row="1" Visibility="Collapsed" Grid.ColumnSpan="2"></Chart:LinePage-->
                <!--<Trade:MarketOrderView x:Name="marketView" Grid.Row="1"  Margin="2, 3, 2, 2" Grid.ColumnSpan="3" ></Trade:MarketOrderView>-->
                <!--<Chat:ChatView x:Name="chatView"  Grid.Row="2" Margin="2,3,2,2" Visibility="Visible" Grid.ColumnSpan="3"></Chat:ChatView>--> 
            </Grid>
        </Border>



        <Border x:Name="borderPostionView" Grid.Row="3" Margin="2, 0, 0, 0" CornerRadius="2" BorderBrush="#136C5E" BorderThickness="1, 1, 1, 1" Background="#0A0F0E"
                Visibility="Collapsed">
            <!--Position:PositionView Height="241" VerticalAlignment="Bottom"></Position:PositionView-->
        </Border>

        <fUI:LoadingMask x:Name="positionloadMask" Visibility="Visible" Grid.ColumnSpan="3" Grid.RowSpan="4"></fUI:LoadingMask>
    </Grid>
</UserControl>
