<UserControl x:Class="BDB.Trade.Plugin.View.TradeMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View"
             mc:Ignorable="d" 
             xmlns:Component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:Comp="clr-namespace:BDB.Trade.Plugin.Component"
             xmlns:Chart="clr-namespace:BDB.Trade.Plugin.View.Chart"
             xmlns:Chat="clr-namespace:BDB.Trade.Plugin.View.Chat"
             xmlns:Position="clr-namespace:BDB.Trade.Plugin.View.Position"
             xmlns:Trade="clr-namespace:BDB.Trade.Plugin.View.Trade"
             xmlns:Card="clr-namespace:BDB.Trade.Plugin.View.Trade.Card"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:dragablz="clr-namespace:Dragablz;assembly=MDT.ThirdParty.Control"
             xmlns:command = "clr-namespace:BDB.Trade.Plugin.Command"
             xmlns:comm = "clr-namespace:BDB.Trade.Plugin.Command"
             d:DesignHeight="850" d:DesignWidth="1100" Background="#000000" SizeChanged="UserControl_SizeChanged"
             x:Name="tradeMainView">

    <!--xmlns:command="clr-namespace:BDB.Common;assembly=BDB.Common.Command"-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ToggleButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/RadioButtonStyleDictionary.xaml"/>

                <ResourceDictionary Source="/MDT.ThirdParty.Control;component/Themes/InnerThemes.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ListBoxStyleDictinary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <comm:PopupWindowCommand x:Key="PopupWindowCommand"/>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>



            <Style x:Key="CloseAllComboBoxStyle" TargetType="ComboBoxItem">
                <Setter Property="MinHeight" Value="20"></Setter>
                <Setter Property="MinWidth" Value="60"></Setter>
                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                <Setter Property="FontSize" Value="12"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Name="Back" Background="#193D37"  BorderThickness="0" BorderBrush="#193D37">
                                <!--<i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonDown">
                                        <command:ExecuteCommandAction Command="{Binding DataContext.CancelAllOrdersCommand,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ComboBoxItem}}}" >
                                            <command:ExecuteCommandAction.CommandParameter>
                                                <MultiBinding Converter="{StaticResource  MultiBindingConverter}">
                                                    <MultiBinding.Bindings>
                                                        <Binding ElementName="CancelAll_CBC"/>
                                                        <Binding ElementName="cp" Path="Content"/>
                                                    </MultiBinding.Bindings>
                                                </MultiBinding>
                                            </command:ExecuteCommandAction.CommandParameter>
                                        </command:<Unknown>>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>-->
                                <ContentPresenter x:Name="cp" ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,5,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#A0A0A0"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="templateRoot" SnapsToDevicePixels="true" Background="Transparent" BorderBrush="#515151" BorderThickness="0,0,0,0">
                                <Border x:Name="splitBorder" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0" HorizontalAlignment="Center" BorderThickness="0" BorderBrush="Transparent">
                                    <!--<Path x:Name="arrow"  VerticalAlignment="Center"  HorizontalAlignment="Center"  Fill="#FFFFFF" Data="M0,0 L6,0 3,4 z"/>-->

                                    <TextBlock x:Name="arrow" Text="v" Foreground="{StaticResource TextBox.Static.Foreground}" Padding="6, 3, 0, 0"></TextBlock>

                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--鼠标移过-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Foreground" TargetName="arrow" Value="#FFFFFF"/>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                </Trigger>
                                <!--<MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                    -->
                                <!--<Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>-->
                                <!--
                                </MultiDataTrigger>-->
                                <!--鼠标按下-->
                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter Property="Foreground" TargetName="arrow" Value="#FFFFFF"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                    <!--<Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>-->
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--Combox-->
            <Style TargetType="ComboBox" x:Key="CustomComboBoxStyle">
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="24"></Setter>
                            <Setter Property="MinWidth" Value="60"></Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextBox.Static.Foreground}"></Setter>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Back" Background="{StaticResource TextBox.MouseOver.Background}"  BorderThickness="0,0,0,0" Padding="2, 0, 0, 0">
                                            <ContentPresenter ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                                <Setter TargetName="Back" Property="BorderThickness" Value="1"></Setter>
                                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource TextBox.MouseOver.Border}"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="bdTextBox"   Grid.Column="0" BorderThickness="0, 1, 0, 0" BorderBrush="#193D37" Background="#193D37"
                                  Text="{TemplateBinding Text}" Foreground="{StaticResource TextBox.Static.Foreground}" FontSize="12" Padding="2, 3, 0, 0">
                                </TextBox>
                                <Border Grid.Column="0" CornerRadius="2" BorderThickness="0, 1, 0, 0" BorderBrush="#193D37">
                                    <TextBlock MouseDown="TextBlock_MouseDown"></TextBlock>
                                </Border>
                                <Border x:Name="bdToggle" Grid.Column="1" BorderThickness="0, 1, 0, 0" BorderBrush="#193D37" Margin="0, 0, 0, 0" Background="#193D37" CornerRadius="0, 2, 2, 0">
                                    <ToggleButton x:Name="tbArrow" Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"></ToggleButton>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" Background="#193D37" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdTextBox" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="bdToggle" Property="Background" Value="#136C5E"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--Button Style-->
            <Style x:Key="AddButtonStyle" TargetType="{x:Type Button}">

                <Setter Property="Background" Value="#325850"/>
                <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="10"></DropShadowEffect>
                                </Border.Effect>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#193D37"/>
                                    <!--<Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#136C5E"/>
                                    <!--<Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>-->
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource BlueButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource BlueButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource BlueButton.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <!--绿色样式-->
            <Style x:Key="SplitButtonStyle" TargetType="{x:Type Button}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="#136C5E"/>
                <!--<Setter Property="BorderBrush" Value="#00D198"/>-->
                <Setter Property="Foreground" Value="{StaticResource GreenButton.Static.Foreground}"/>
                <Setter Property="BorderThickness" Value="0, 0, 0, 0"/>
                <!--<Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="80"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#146C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#2CAB97"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#1C4B43"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Pressed.Border}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource RedButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource RedButton.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="cbList"
           TargetType="RadioButton">
                <Setter Property="Width"
                Value="24" />
                <Setter Property="Padding" Value="0, 0, 0, 2"/>
                <Setter Property="Height"
                Value="20" />
                <Setter Property="Background"
                Value="#121A19" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">

                            <Grid>
                                <Border x:Name="border" Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}" 
