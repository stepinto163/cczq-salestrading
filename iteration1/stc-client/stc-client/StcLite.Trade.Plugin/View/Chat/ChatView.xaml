<UserControl x:Class="BDB.Trade.Plugin.View.Chat.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:Comp="clr-namespace:BDB.Trade.Plugin.Component"
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Chat"
             mc:Ignorable="d" 
             Width="283" Height="268">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:ChatBubbleSelector x:Key="chatBubbleSelector"/>

            <!--Broker消息样式-->
            <DataTemplate x:Key="chatSelf">
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Canvas Width="8" Height="8" Margin="0,0,0,0"  HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent">
                            <Path x:Name="path1" Stroke="#3C3C3C" StrokeThickness="0" Fill="#3C3C3C">
                                <Path.Data>
                                    <PathGeometry Figures="M 8,0 L 0,8,8,8"/>
                                </Path.Data>
                            </Path>
                        </Canvas>
                        
                        <Border x:Name="border1" Grid.Column="1" CornerRadius="2,2,2,0" BorderBrush="#3C3C3C" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,2,0" Background="#3C3C3C" HorizontalAlignment="Left" Padding="5,0,5,0"  MinHeight="22" MinWidth="16">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Content}" VerticalAlignment="Center" Foreground="#FFEBC8"  Margin="0,4,0,0"  LineHeight="22"  MaxWidth="227" Padding="4,0,4,0"  FontSize="13px" FontFamily="Microsoft YaHei" FontWeight="Medium"/>
                        </Border>

                        <Ellipse x:Name="clock_img" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="3,0,0,0" Width="12" Visibility="Visible"  Height="12" Fill="Red"  ToolTip="{Binding ErrorMessage}"/>
                        <TextBlock x:Name="clock_1"  Text="!" FontSize="11" Margin="0,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Black" FontWeight="Black" ToolTip="{Binding ErrorMessage}"></TextBlock>

                        <TextBlock x:Name="timeRemain"  TextWrapping="Wrap" Text="{Binding TimeRemain}" VerticalAlignment="Center" Foreground="#F9C152"  Margin="2,2,0,2" FontSize="13px" FontFamily="Microsoft YaHei"/>
                        <!--Image x:Name="clock_img" VerticalAlignment="Center" Height="12" Width="12" Margin="2,0,0,0" Source="/STC.Common;component/Images/stc_icon_info_seleted.png"  Visibility="Visible"  ToolTip="{Binding ErrorMessage}"/-->
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                        <Setter TargetName="clock_img" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="clock_1" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding TimeRemain}" Value="">
                        <Setter TargetName="timeRemain" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="path1" Property="Fill" Value="#3C3C3C" />
                        <Setter TargetName="border1" Property="Background" Value="#3C3C3C" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--Trader收到消息样式-->
            <DataTemplate x:Key="chatBroker">
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        
                        <TextBlock x:Name="timeRemain"  TextWrapping="Wrap" Text="{Binding TimeRemain}" VerticalAlignment="Center" Foreground="#F9C152"  Margin="2,2,0,2" FontSize="13px" FontFamily="Microsoft YaHei"/>
                        
                        <Ellipse x:Name="clock_img" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2,0,0,0" Width="12" Visibility="Visible" Height="12" Fill="Red"  ToolTip="{Binding ErrorMessage}"/>
                        <TextBlock x:Name="clock_1" Text="!" FontSize="11" Margin="0,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Black" FontWeight="Black"  ToolTip="{Binding ErrorMessage}"></TextBlock>

                        <!--Image x:Name="clock_img" VerticalAlignment="Center" Height="12" Width="12" Source="/STC.Common;component/Images/stc_icon_info_seleted.png"  Visibility="Visible"   ToolTip="{Binding ErrorMessage}"/-->
                        
                        <Border x:Name="border1"  CornerRadius="2,2,0,2" BorderBrush="#193D37"  Background="#193D37" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4,0,0,0" Padding="5,0,5,0"  MinHeight="22" MinWidth="16">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Content}" VerticalAlignment="Center"  Foreground="#FFEBC8"  Margin="0,4,0,0" LineHeight="22" MaxWidth="219" Padding="4,0,4,0" FontSize="13px" FontFamily="Microsoft YaHei" FontWeight="Medium"/>
                        </Border>

                        <Canvas Width="8" Height="8"  HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent">
                            <Path x:Name="path1" Stroke="#193D37" StrokeThickness="1" Fill="#193D37">
                                <Path.Data>
                                    <PathGeometry Figures="M 0,8 L 0,0,8,8"/>
                                </Path.Data>
                            </Path>
                        </Canvas>
                        
                    </StackPanel>
                </Grid>
                
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                        <Setter TargetName="clock_img" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="clock_1" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding TimeRemain}" Value="">
                        <Setter TargetName="timeRemain" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="path1" Property="Fill" Value="#193D37" />
                        <Setter TargetName="border1" Property="Background" Value="#193D37"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--接收时间样式-->
            <DataTemplate x:Key="chatTime">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="border1" CornerRadius="0" Background="Transparent" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,2,0,2" Padding="0,0,0,0"  MinHeight="12"  MinWidth="50">
                        <TextBlock TextWrapping="Wrap" Text="{Binding Content}" Foreground="#969696" FontFamily="Microsoft YaHei" FontSize="11px"/>
                    </Border>
                </Grid>
            </DataTemplate>

            <!--ToolTip的样式-->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Padding" Value="4,2,4,2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="FontFamily" Value="ArialMT"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderBrush" Value="#308376"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border x:Name="Root" CornerRadius="1" BorderThickness="{TemplateBinding BorderThickness}" Background="#FFFFFFFF" BorderBrush="{TemplateBinding BorderBrush}">
                                <Border BorderBrush="#FFFFFFFF" BorderThickness="0" CornerRadius="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <Border.Resources>
                                        <Storyboard x:Key="Visible State"/>
                                        <Storyboard x:Key="Normal State"/>
                                    </Border.Resources>
                                    <ContentPresenter
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Cursor="{TemplateBinding Cursor}"
                              Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!--TextBox输入框-->
            <Style x:Key="ChatTextBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#172422"/>
                <Setter Property="BorderBrush" Value="#193D37"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    <TextBlock x:Name="Message" VerticalAlignment="Center" TextAlignment="Left" HorizontalAlignment="Left" Foreground="#788187" Visibility="Hidden"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                                    <Setter TargetName="Message" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="1"/>
                                    <Setter Property="Foreground"  Value="#788187"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#172422"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2CAB97"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#193D37"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2CAB97"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!-- SaveButton-->
            <Style x:Key="SendPriceButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#136C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#2CAB97 "/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--ListBoxItem-->
            <Style TargetType="{x:Type ListBoxItem}" x:Key="listViewItemStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="true">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            
            <!--滚动条颜色、圆角等设置-->
            <Style x:Key="ChatScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <!--滚动条颜色和圆角设置-->
                            <Rectangle Name="thumbRect" Fill="#193D37" RadiusX="3" RadiusY="3"/>
                            <!--鼠标拉动滚动条时的颜色-->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Fill" Value="#136C5E" TargetName="thumbRect" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="VerticalScrollBarPageButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="Background" Value="#0A0F0E"/>
                <Setter Property="Focusable" Value="false"/>
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Rectangle Fill="#0A0F0E" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChatScrollBarStyle" TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="#0A0F0E"/>
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                <!--滚动条宽度-->
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <!--滚动条背景色-->
                            <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true" Width="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{DynamicResource VerticalScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{DynamicResource VerticalScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{DynamicResource ChatScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Track x:Name="PART_Track"  IsEnabled="{TemplateBinding IsMouseOver}">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource HorizontalScrollBarPageButton}"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource HorizontalScrollBarPageButton}"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollBarThumb}" />
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 右下角的占位颜色 -->
                                <Rectangle x:Name="Corner" Grid.Column="1" Fill="Transparent" Grid.Row="1"/>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" Grid.Column="0" Margin="{TemplateBinding Padding}" Grid.Row="0"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Grid.Row="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}" Style="{DynamicResource ChatScrollBarStyle}"/>
                                <ScrollBar x:Name="PART_HorizontalScrollBar" AutomationProperties.AutomationId="HorizontalScrollBar" Cursor="Arrow" Grid.Column="0" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0" Orientation="Horizontal" Grid.Row="1" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportWidth}" Style="{DynamicResource ChatScrollBarStyle}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Border BorderBrush="#172422" BorderThickness="0,1,0,0" Background="{StaticResource MainFrame.Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="8" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
            </Grid>

            <Border BorderBrush="#172422" BorderThickness="0,0.5,0,0" Margin="8,0,8,0" Background="{StaticResource MainFrame.Background}"/>

            <Comp:ChatBrokerFilterView x:Name="lbDirect" Grid.Row="1" Margin="8,0,8,0" DefaultSelectItem="{Binding DefaultSelectItem, Mode=TwoWay}" LockOtherNotSelectItem="{Binding LockOtherNotSelectItem,Mode=TwoWay}" VerticalAlignment="Center" Height="16" HorizontalAlignment="Left" Visibility="Visible"  FilterDicChanged="lbDirect_FilterDicChanged"/>
            
            <ListBox Grid.Row="2" ItemTemplateSelector="{StaticResource chatBubbleSelector}" ItemsSource="{Binding Messages}" 
                 SelectedIndex="{Binding SelectedMessage}" BorderThickness="0" BorderBrush="#D3D3D3" Background="#0A0F0E"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource listViewItemStyle}"></Style>
                </ListBox.ItemContainerStyle>
                <!-- 绑定自定义行为 -->
                <i:Interaction.Behaviors>
                    <local:AutoScrollBehavior />
                </i:Interaction.Behaviors>
            </ListBox>
            <Grid Grid.Row="3" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="textBox" TextWrapping="Wrap" Text="{Binding TxtMessage,UpdateSourceTrigger=PropertyChanged}" 
                     CaretBrush="Green" BorderThickness="1" FontSize="12" Padding="5,0,0,0" Margin="0,0,0,1" MinHeight="22" MaxHeight="150" 
                     ScrollViewer.VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Style="{DynamicResource ChatTextBox}">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="2"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button x:Name="btnClear" Content="C" Style="{DynamicResource SendPriceButton}" Margin="5,1,0,1" Command="{Binding ClearMessage}" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1" VerticalAlignment="Center" Width="24"></Button>
                <Button x:Name="btnSend" Content="发送" Style="{DynamicResource SendPriceButton}" Margin="5,1,0,1" Command="{Binding SendMessage}" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="2" VerticalAlignment="Center" Width="60">
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
