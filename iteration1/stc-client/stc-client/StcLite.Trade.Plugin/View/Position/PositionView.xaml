                        <!--<DataGridTextColumn Binding="{Binding DealingQty}" Header="已处理(万元)" Width="Auto" MinWidth="80"/>-->
                        <DataGridTextColumn Binding="{Binding ExecQty,Converter={StaticResource numConvertor}}" Header="已确认(万元)" Width="Auto" MinWidth="80" CellStyle="{StaticResource DataGridTextCenterStyle}"/>
                        <DataGridTextColumn Binding="{Binding PartySubName}" Header="本方交易员" Width="Auto" MinWidth="80" CellStyle="{StaticResource DataGridTextCenterStyle}"/>

                        <!--<DataGridTextColumn Binding="{Binding OrdType}" Header="报价方式" Width="Auto"  MinWidth="70"/>-->
                        <!--DataGridTextColumn Binding="{Binding Veneues,ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" Header="报价方式" Width="Auto" MinWidth="50"/-->
                        <!--DataGridTextColumn Binding="{Binding CrossVenues,ConverterParameter=crossvenues, Converter={StaticResource EnumTypeConvertor}}" Header="撮合范围" Width="Auto"  MinWidth="70"/-->

                        <!--DataGridTextColumn Binding="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}" 
                                                    ClipboardContentBinding="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}" 
                                                    Header="渠道" Width="Auto" MinWidth="70" CellStyle="{StaticResource DataGridTextCenterStyle}"/-->
                        <DataGridTemplateColumn  ClipboardContentBinding="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}" 
                                                    Header="渠道" Width="Auto" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border  x:Name="SourceTraderBorder" BorderBrush="Transparent" Background="{StaticResource TPSC.ColorBrush}"  BorderThickness="1"  Width="40"  Height="16" CornerRadius="6">
                                        <TextBlock x:Name="SourceTraderText"   Foreground="{StaticResource DefaultForegroup.ColorBrush}" Text="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}"  FontFamily="PingFang SC" FontSize="12"  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Venues}" Value="TPSC">
                                            <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                                            <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Venues}" Value="CTTJ">
                                            <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                                            <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Venues}" Value="CNEX">
                                            <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                                            <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Venues}" Value="CCTB">
                                            <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                                            <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Venues}" Value="PTCN">
                                            <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                                            <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!---DataGridTextColumn Binding="{Binding SelfSelectVenues,Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}" Header="渠道" Width="Auto"  MinWidth="70"/-->

                        <!--<DataGridTextColumn Binding="{Binding VenuesSelectF}" Header="VenuesSelectF" Width="Auto"  MinWidth="70"/>
                        <DataGridTextColumn Binding="{Binding VenuesRdmNum}" Header="VenuesRdmNum" Width="Auto"  MinWidth="70"/>
                        <DataGridTextColumn Binding="{Binding SelfSelectVenues}" Header="SelfSelectVenues" Width="Auto"  MinWidth="70"/>-->

                        <DataGridTextColumn Binding="{Binding STCCode}" Header="BDB订单号" Width="Auto"  MinWidth="135" CellStyle="{StaticResource DataGridTextCenterStyle}"/>
                        <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" Header="订单更新时间" Width="Auto" MinWidth="60"
                                            HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" 
                                            CellStyle="{StaticResource DataGridTextCenterStyle}"/>

                        <!--DataGridTextColumn Binding="{Binding RejectText}" Header="原因" Width="Auto"  MinWidth="70"/-->
                    </DataGrid.Columns>
                </Comp:CustomExecDataGrid>
            </TabItem>

            <!--我的持仓-->
            <!--<TabItem Visibility="Collapsed" x:Name="MyPositions_TabItem" Header="我的持仓" Width="100">
                <DataGrid x:Name="MyPositions_dataGrid" Style="{StaticResource DefaultDataGrid}"/>
            </TabItem>-->

        </dragablz:TabablzControl>

        <!--<local:MyExecutionsFilterPanel x:Name="myExecutionsFilterPanel" Height="20" VerticalAlignment="Top"  Margin="220,2,0,0" Visibility="Collapsed"/>-->
        <Grid VerticalAlignment="Top" Margin="320,6,0,0" Height="24" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="24"/>
                <!--<ColumnDefinition Width="10"/>-->
            </Grid.ColumnDefinitions>
            <!--Modi:cyc date:20210406 Memo:不再使用-->
            <!--local:MyOrdersFilterPanel x:Name="myOrderFilter" VerticalAlignment="Center" HorizontalAlignment="Left" FilterDicChanged="myOrderFilter_FilterDicChanged" Visibility4CancelAllBtn="Visible" Visibility4ResendBtn="Collapsed"/-->
            <!--local:MyExecutionsFilterPanel x:Name="myExeFilter" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Hidden" FilterDicChanged="myExeFilter_FilterDicChanged"/-->
            <!--local:MyOrdersFilterPanel x:Name="myCancelOrderFilter" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Hidden" FilterDicChanged="myCancelOrderFilter_FilterDicChanged" Visibility4CancelAllBtn="Collapsed" Visibility4ResendBtn="Visible"/>-->
            <StackPanel x:Name="myOrderFilter" Orientation="Horizontal" Grid.Column="0" Visibility="Collapsed" >
                <CheckBox x:Name="lbAllOrder" Margin="5, 0, 0, 0" Width="50"  IsChecked="{Binding SearchAllCheck, Mode=TwoWay}" Content="全部"  FontSize="12"  Style="{StaticResource CheckBoxThemeColor}" />
                <CheckBox x:Name="lbPointOrder" Margin="5, 0, 0, 0" Width="50" IsChecked="{Binding SearchRequireCheck, Mode=TwoWay}" Grid.Column="2" Content="需求" FontSize="12"  Style="{StaticResource CheckBoxThemeColor}" />
                <CheckBox x:Name="lbPriceOrder"  Margin="5, 0, 0, 0"  Width="50" IsChecked="{Binding SearchOrderCheck, Mode=TwoWay}" VerticalAlignment="Center" Grid.Column="3" Content="意向" FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CheckBoxThemeColor}"/>
            </StackPanel>
            <Comp:PositionBrokerFilterView x:Name="myExeFilter" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Visible" FilterDicChanged="myExeFilter_FilterDicChanged"/>
            <StackPanel x:Name="myCancelOrderFilter" Orientation="Horizontal" Grid.Column="0" Visibility="Collapsed" >
                <CheckBox x:Name="lbCancelAllOrder" Margin="5, 0, 0, 0" Width="50"  IsChecked="{Binding SearchCancelAllCheck, Mode=TwoWay}" Content="全部"  FontSize="12"  Style="{StaticResource CheckBoxThemeColor}" />
                <CheckBox x:Name="lbCancelPointOrder" Margin="5, 0, 0, 0" Width="50" IsChecked="{Binding SearchCancelRequireCheck, Mode=TwoWay}" Grid.Column="2" Content="需求" FontSize="12"  Style="{StaticResource CheckBoxThemeColor}" />
                <CheckBox x:Name="lbCancelPriceOrder"  Margin="5, 0, 0, 0"  Width="50" IsChecked="{Binding SearchCancelOrderCheck, Mode=TwoWay}" VerticalAlignment="Center" Grid.Column="3" Content="意向" FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CheckBoxThemeColor}"/>
            </StackPanel>
            <Component:SearchTextBox x:Name="Search_TextBox" Grid.Column="1" HorizontalAlignment="Left" 
                                 SearchText="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Width="144" Height="24" Margin="0,-2,0,0" />
            <Button x:Name="btnHistory" Content="历史查询" Grid.Column="2" Width="60" Height="24" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource GreenButtonStyle}" Click="btnHistory_Click"/>
            <Button x:Name="btnFullScreen" Grid.Column="3" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PopupButton}" Visibility="Collapsed" />
        </Grid>

    </Grid>
</UserControl>
