<UserControl x:Class="BDB.Trade.Plugin.View.Position.CrossQtyPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Position"
             xmlns:comp="clr-namespace:BDB.Trade.Plugin.Component"
             xmlns:Component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:vm="clr-namespace:BDB.Trade.Plugin.ViewModel"
             mc:Ignorable="d" 
             FontSize="12"
             Foreground="{DynamicResource DefaultForegroup.ColorBrush}" MaxHeight="507"
             d:DesignHeight="235" d:DesignWidth="557" BorderBrush="#A0A0A0" BorderThickness="1">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridCell_PreviewMouseLeftButtonDown"/>
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True" BorderBrush="{DynamicResource DataGridCellBorderBrush}" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="已成交">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        
                    </Setter.Value>
                </Setter>
            </Style>
            <vm:CrossQtyPopupViewModel x:Key="crossQtyPopupViewModel"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.DataContext>
        <StaticResourceExtension ResourceKey="crossQtyPopupViewModel"/>
    </UserControl.DataContext>
    <Grid Background="{StaticResource MainBackgroup.ColorBrush}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition />
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <DockPanel.Background>
                <LinearGradientBrush EndPoint="0.5,0.971" StartPoint="0.5,0.042">
                    <GradientStop Color="#4E4E4E" Offset="0"/>
                    <GradientStop Color="#282828" Offset="1"/>
                </LinearGradientBrush>
            </DockPanel.Background>
            <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                <TextBlock x:Name="SecurityID_TB" Text="{Binding SecurtityID}" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="Symbol_TB" Text="{Binding Symbol}" VerticalAlignment="Center" FontWeight="Bold" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Margin="0,0,10,0" Orientation="Horizontal">
                <TextBlock x:Name="STCCode_Tag_TB" Text="BDB订单号：" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="STCCode_TB" Text="{Binding STCCode}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="CrossQtyDataGrid" Grid.Row="1" ItemsSource="{Binding CrossDv}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}" CellStyle="{StaticResource DataGridCellStyle1}"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#1E1E1E" VerticalGridLinesBrush="#1E1E1E"
                  Foreground="#FFFFFF" BorderThickness="0" Background="#141414" RowHeight="30" RowBackground="#141414"
                          AutoGenerateColumns="False" HeadersVisibility="Column"
                          AllowDrop="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          CanUserResizeRows="False" CanUserSortColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.IsDeferredScrollingEnabled="True" 
                  BeginningEdit="CrossQtyDataGrid_BeginningEdit"
                          PreparingCellForEdit="DataGrid_PreparingCellForEdit">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="状态" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="Status_TB" Text="{Binding Status}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="已成交">
                                    <Setter TargetName="Status_TB" Property="Foreground" Value="#42B574"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="匹配中">
                                    <Setter TargetName="Status_TB" Property="Foreground" Value="#ED6D00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="报价">
                                    <Setter TargetName="Status_TB" Property="Foreground" Value="#E63034"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="blocknum" Binding="{Binding blocknum}" MinWidth="60"/>-->
                <DataGridTemplateColumn Header="子订单号" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="Status_TB" Text="{Binding OrderID}" VerticalAlignment="Center" Margin="5,0,0,0" ToolTip="{Binding OrderID}" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="渠道" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="Status_TB" Text="{Binding Venues,Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues_exe'}"  VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="价格(%)" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="Price_TB"  Text="{Binding Price_Display}" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Orange}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DataContext.Side, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" Value="2">
                                    <Setter TargetName="Price_TB" Property="Foreground" Value="{StaticResource ColorBrush.Blue}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                       
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="净价(元)" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Status_TB" Text="{Binding NetPrice,Converter={StaticResource numConvertor}}" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Bold"/>
                                <Button x:Name="EidtBtn" Width="12" Height="12" Grid.Column="1" Style="{StaticResource  EditButton}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DisplayBtn}" Click="EidtBtn_Click"/>
                                
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <Component:NumericUpDown x:Name="Edit_NetPrice_TXT" NumericValue="{Binding Edit_NetPrice,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinValue="0" MaxValue="999999999999" DecimalLength="4" RangeValue="0.0001" Margin="3" KeyDown="Edit_NetPrice_TXT_KeyDown"/>
                                <Button x:Name="OKBtn" Width="12" Height="12" Grid.Column="1" Style="{StaticResource SaveButton}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OKBtn_Click"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="量(万)" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Status_TB" Text="{Binding Qty}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <Border x:Name="oco_icon" Grid.Column="1" Width="18" Height="18" CornerRadius="2" BorderThickness="0" Background="#E63034">
                                    <TextBlock Text="oco" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="已成交">
                                    <Setter TargetName="oco_icon" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="已成交:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock Text="{Binding ExeQty}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock Text="/" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalQty}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
