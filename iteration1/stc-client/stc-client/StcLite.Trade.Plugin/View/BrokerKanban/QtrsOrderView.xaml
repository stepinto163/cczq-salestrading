<UserControl x:Class="BDB.Trade.Plugin.View.BrokerKanban.QtrsOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.BrokerKanban"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:Component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             Initialized="UserControl_Initialized"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="990">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ToggleButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/MDT.ThirdParty.Control;component/Themes/InnerThemes.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            
            <ContextMenu x:Key="CopyContextMenu" Style="{StaticResource DefaultContextMenu}" ContextMenuOpening="UserControl_ContextMenuOpening">
                <MenuItem x:Name="copyRow" Header="复制要素" Style="{StaticResource DefaultMenuItem}" Click="copyRow_Click"/>
            </ContextMenu>
            
            <!--DefaultDataGrid 样式-->
            <Style x:Key="QueryDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            
            <!--DataGridCell 样式-->
            <Style x:Key="SumColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellStyleCenterStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatusColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ordStatus}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ordStatus}" Value="4">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ordStatus}" Value="8">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ordStatus}" Value="C">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="mainPositionDetailGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition Height="32"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel  Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Background="#202020">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"></RowDefinition>
                    <RowDefinition Height="2"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0"  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,0,0,0">
                    <TextBlock FontStyle="Normal" Margin="0,4,0,0" Foreground="{StaticResource RedButton.Static.Foreground}" FontFamily="Microsoft YaHei" FontWeight="SemiBold" FontSize="12">
                        <Run Text="需求意向("></Run>
                        <Run Text="{Binding RowCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Run>
                        <Run Text=")"></Run>
                    </TextBlock>
                </StackPanel>
                <Border BorderBrush="#136C5E " BorderThickness="2" Width="72"  Background="#136C5E " Grid.Row="1" Grid.Column="0" Margin="9,0,0,0"></Border>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Background="#202020">
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal"  HorizontalAlignment="Right" Background="#202020">
            <Button x:Name="btnFullScreen"  Width="12" Height="12" Margin="0, 0, 4, 0" Style="{StaticResource PopupButton}" Command="{Binding FullScreenCommand}"/>
        </StackPanel>
        
        <StackPanel  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Background="Transparent">
            
        </StackPanel>
        <StackPanel  Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"  Background="Transparent">
            <Component:SearchTextBox x:Name="Search_TextBox"  Margin="0, 0, 4, 0" HorizontalAlignment="Left" 
                                 SearchText="{Binding SecurityId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Width="144" Height="24"/>
            <Button x:Name="btnExport" Style="{StaticResource ExportButton}"  Command="{Binding ExportCsvCommand}" Width="12" Height="12" Margin="2, 0, 4, 0"></Button>
            <Button x:Name="btnHistory" Style="{StaticResource HistoryButton}"  Command="{Binding HistoryCommand}"  Width="12" Height="12" Margin="0, 0, 4, 0"></Button>
        </StackPanel>

        <!--筛选面板-->
        <local:QtrsOrderFilterPanel x:Name="diFilterPanel"  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,0,0,0" Background="Transparent" FilterDicChanged="diFilterPanel_FilterDicChanged"/>

        <DataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="MyOrders" ItemsSource="{Binding Mv.View, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{DynamicResource DefaultDataGridForQuery}" LoadingRow="emsDataGrid_LoadingRow" ClipboardCopyMode="None" 
                                  SelectedItem="{Binding SelectedDI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionUnit="FullRow" SelectionMode="Extended"
                                  MouseRightButtonDown="MyOrders_dataGrid_MouseRightButtonDown"
                                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="Auto" Header="序号" MinWidth="40" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="方向" Binding="{Binding side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Width="0.7*" MinWidth="40" 
                                    CellStyle="{StaticResource SumColorStyle}" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}"
                                    ClipboardContentBinding="{Binding side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" />
                <DataGridTextColumn Header="代码" Binding="{Binding securityID}" Width="*" CanUserSort="True" MinWidth="78" HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}"/>
                <!--<DataGridTextColumn Header="类型" Binding="{Binding securityType}" Width="Auto" CanUserSort="True"/>-->
                <DataGridTextColumn Header="简称"  Binding="{Binding symbol}" Width="*" CanUserSort="True" MinWidth="90" HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}"/>
                <DataGridTextColumn Header="清算速度" Binding="{Binding settlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}"
                                                    ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                   Width="0.6*" MinWidth="70"/>
                <!--<DataGridTextColumn Header="意向" Width="1*" MinWidth="64"/>-->
                <DataGridTextColumn Header="收益率（%）" Binding="{Binding yield, Converter={StaticResource numConvertor}, ConverterParameter='1'}" MinWidth="80" Width="0.5*" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" CellStyle="{StaticResource SumColorStyle}"/>
                <DataGridTextColumn Header="数量（万元）" Binding="{Binding orderQty, Converter={StaticResource numConvertor},ConverterParameter='3'}" Width="0.5*" CanUserSort="True" MinWidth="90"  HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" CellStyle="{StaticResource SumColorStyle}"/>
                <DataGridTextColumn Header="已确认量（万元）"  Binding="{Binding cumQty, Converter={StaticResource numConvertor},ConverterParameter='3'}" Width="0.4*" CanUserSort="True" MinWidth="90"  HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" CellStyle="{StaticResource SumColorStyle}"/>
                <DataGridTemplateColumn Header="经纪商" Width="Auto" MinWidth="50" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border  x:Name="SourceTraderBorder" BorderBrush="Transparent" Background="{StaticResource TPSC.ColorBrush}"  BorderThickness="1"  Width="40"  Height="16" CornerRadius="6">
                                <TextBlock x:Name="SourceTraderText" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Text="{Binding venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}"  FontFamily="PingFang SC" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding venues}" Value="TPSC">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding venues}" Value="CTTJ">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding venues}" Value="CNEX">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding venues}" Value="CCTB">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding venues}" Value="PTCN">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="类型"  Width="40"/>
                <DataGridTextColumn Header="渠道"  Width="40"/>-->
                <DataGridTextColumn Header="状态" Binding="{Binding ordStatus,ConverterParameter=ordstatus,Converter={StaticResource EnumTypeConvertor}}"
                                    CellStyle="{StaticResource StatusColumnColorStyle}"  HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" Width="0.6*" MinWidth="60"/>
                <DataGridTextColumn Header="本方交易员" Binding="{Binding deliverToSubID}" Width="*" MinWidth="70" HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}"/>
                <DataGridTextColumn Header="订单序号"  Binding="{Binding orderID}" Width="1.5*" MinWidth="86" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" CellStyle="{StaticResource CellStyleCenterStyle}"/>
                <DataGridTextColumn Header="备注"  Binding="{Binding comment}" Width="*" MinWidth="60" HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}"/>
                <DataGridTextColumn Header="更新时间"  Binding="{Binding sendingTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}"  Width="Auto" MinWidth="80"  HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" CellStyle="{StaticResource CellStyleCenterStyle}"/>
                <!--<DataGridTextColumn Header="成交单号"  Binding="{Binding  dealID}" Width="1.5*" MinWidth="86" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" CellStyle="{StaticResource CellStyleCenterStyle}"/>-->
            </DataGrid.Columns>
        </DataGrid>
        <fUI:LoadingMask x:Name="positionMainMask" Visibility="Collapsed" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" ></fUI:LoadingMask>

    </Grid>
</UserControl>
