<UserControl x:Class="BDB.Trade.Plugin.View.UserSetting.NewUserSettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:Component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        xmlns:Custom="clr-namespace:BDB.Python.Plugin.View.Setting"
        xmlns:local="clr-namespace:BDB.Trade.Plugin.View.UserSetting"
        xmlns:CommonUI ="clr-namespace:BDB.Common.View.UI"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800" Margin="20,0,20,20"
        Background="#172422">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TextBlockForGround" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>

            <SolidColorBrush x:Key="SelectItemBorderBrush" Color="#FFF9C152"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectItemBackground" Color="#FF9300"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectItemForeground" Color="#000000"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBorder" Color="#136C5E"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBackground" Color="#193D37"></SolidColorBrush>
            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Border" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Border" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Foreground" Color="#FEEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Border" Color="#00D198"/>
            <SolidColorBrush x:Key="ListBoxItem.Normal.Border" Color="#193D37"/>


            <!--功能选择-->
            <Style x:Key="SendPriceFilterListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!--<Setter Property="Padding" Value="0"/>-->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <!--<Setter Property="Padding" Value="10,0,10,0"/>-->
                <Setter Property="Width" Value="48"/>
                <Setter Property="Margin" Value="0, 0, 0, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="#193D37" CornerRadius="2" BorderThickness="0, 1, 0, 0" VerticalAlignment="Center" Margin="0,0,0,0" 
                                BorderBrush="#136C5E"  Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="Cp" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedInactive.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedActive.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="#FF9300"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="#F9C152"/>
                                    <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="#0A0F0E"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Cp" Value="#788187"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--每个子项目标题样式-->
            <Style x:Key="TxtBlockTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#F9C152"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
            </Style>

            <Style x:Key="TxtBlockDetail" TargetType="{x:Type TextBlock}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#788187"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,8,0,0"/>
                
            </Style>

            <!--ToolTip的样式-->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Padding" Value="4,2,4,2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="FontFamily" Value="ArialMT"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderBrush" Value="#308376"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border x:Name="Root" CornerRadius="1" BorderThickness="{TemplateBinding BorderThickness}" Background="#FFFFFFFF" BorderBrush="{TemplateBinding BorderBrush}">
                                <Border BorderBrush="#FFFFFFFF" BorderThickness="0" CornerRadius="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <Border.Resources>
                                        <Storyboard x:Key="Visible State"/>
                                        <Storyboard x:Key="Normal State"/>
                                    </Border.Resources>
                                    <ContentPresenter
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Cursor="{TemplateBinding Cursor}"
                              Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- Info按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="InfoButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/STC.Common;component/Images/stc_operation_history_dark_disabled.png"/>
                                    </Border.Background>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_info_seleted.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_info_seleted.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_delet_disable.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--CheckBox的样式-->
            <Style x:Key="CheckAllForDelete" TargetType="CheckBox">
                <Style.Resources>
                    <SolidColorBrush x:Key="CheckForDelete.Static.Background" Color="#0F0F0F"/>
                    <SolidColorBrush x:Key="CheckForDelete.Static.Border" Color="#136C5E"/>
                    <SolidColorBrush x:Key="CheckForDelete.MouseOver.Background" Color="#136C5E"/>
                    <SolidColorBrush x:Key="CheckForDelete.MouseOver.Border" Color="#136C5E"/>
                    <SolidColorBrush x:Key="CheckForDelete.MouseOver.Glyph" Color="#FFEBC8"/>
                    <SolidColorBrush x:Key="CheckForDelete.Disabled.Background" Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="CheckForDelete.Disabled.Border" Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="CheckForDelete.Disabled.Glyph" Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="CheckForDelete.Pressed.Background" Color="#FF9300"/>
                    <SolidColorBrush x:Key="CheckForDelete.Pressed.Border" Color="#FF9300"/>
                    <SolidColorBrush x:Key="CheckForDelete.Pressed.Glyph" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckForDelete.Static.Glyph" Color="#136C5E"/>
                </Style.Resources>
                <Setter Property="Background" Value="{DynamicResource CheckForDelete.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CheckForDelete.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Margin" Value="21,4,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="checkBoxBorder" CornerRadius="1" Height="12" Width="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid x:Name="markGrid" Margin="-1">
                                        <Path x:Name="optionMark"  Data="M0.1,6 3.2,7.5 7.5,2 7.0,0.2 3.2,5.2 1,4 0.2,4 z" Fill="Black" Opacity="0" Stretch="None"/>
                                        <Rectangle x:Name="indeterminateMark" Fill="{DynamicResource CheckForDelete.Static.Border}" Opacity="0"/>
                                    </Grid>
                                </Border>

                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.MouseOver.Background}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource CheckForDelete.MouseOver.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource CheckForDelete.MouseOver.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Disabled.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource CheckForDelete.Disabled.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource CheckForDelete.Disabled.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Pressed.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource CheckForDelete.Pressed.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource CheckForDelete.Pressed.Glyph}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="0"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource CheckForDelete.Pressed.Border}"/>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Pressed.Border}"></Setter>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource CheckForDelete.Pressed.Border}"></Setter>
                                    <!--<Setter Property="BorderThickness" TargetName="checkBoxBorder" Value="0"/>-->
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="0"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--TextBox输入框-->
            <Style x:Key="SendPriceTimeTextBox" TargetType="{x:Type Component:WatermarkTextBox}">
                <Setter Property="Background" Value="#172422"/>
                <Setter Property="BorderBrush" Value="#FF9300"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Component:WatermarkTextBox}">
                            <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    <TextBlock x:Name="Message" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#788187" Text="{TemplateBinding WaterMark}" Visibility="Hidden"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                                    <Setter TargetName="Message" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="1"/>
                                    <Setter Property="Foreground"  Value="#788187"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#172422"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2CAB97"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#193D37"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2CAB97"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!--FillContent-->
            <Border Grid.Column="1" BorderThickness="0">
                <!--<StackPanel Visibility="{Binding VisibilityRisk,Mode=TwoWay}">-->
                <StackPanel Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="单笔报量" Style="{StaticResource TxtBlockTitle}"></TextBlock>
                        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_qtyCheck"  IsChecked="{Binding qtyCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}"  Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <Component:WatermarkTextBox x:Name="txt_qtyMin" WaterMark="" Text="{Binding qtyMin,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  PreviewTextInput ="txt_qtyMin_PreviewTextInput" PreviewKeyDown="txt_qtyMin_PreviewKeyDown"  ContextMenu="{x:Null}"  Width="48" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0"  Margin="6,0,0, 0"  MinWidth="3" MaxLength="8"  InputMethod.IsInputMethodEnabled="False"  Style="{StaticResource SendPriceTimeTextBox}">
                                <TextBox.ToolTip>
                                    <ToolTip Content="输入框允许输入范围[100，10000000]"></ToolTip>
                                </TextBox.ToolTip>
                            </Component:WatermarkTextBox>
                            <TextBlock Grid.Row="0" Text="万" Style="{DynamicResource TxtBlockDetail}"/>
                            <TextBlock Grid.Row="0" Text="&lt;= 单笔报量 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:WatermarkTextBox x:Name="txt_qtyMax"  WaterMark=""  ContextMenu="{x:Null}"  Text="{Binding qtyMax,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  PreviewTextInput ="txt_qtyMin_PreviewTextInput" PreviewKeyDown="txt_qtyMin_PreviewKeyDown"  Width="54" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0"  Margin="6,0,0, 0"  MinWidth="3" MaxLength="8" InputMethod.IsInputMethodEnabled="False"  Style="{StaticResource SendPriceTimeTextBox}">
                                <TextBox.ToolTip>
                                    <ToolTip Content="输入框允许输入范围[100，10000000]"></ToolTip>
                                </TextBox.ToolTip>
                            </Component:WatermarkTextBox>
                            <TextBlock Grid.Row="0" Text="万" Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                        
                        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock  Text="中债估值偏离" Style="{StaticResource TxtBlockTitle}"></TextBlock>
                            <Button x:Name="tip_img"  Height="16" Width="16" Style="{StaticResource InfoButton}" FontSize="10" IsEnabled="{Binding EnabledBtn}" ToolTip="若无权限设置不生效"/>
                        </DockPanel>

                        <DockPanel Grid.Row="4" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_chinaBidCheck" IsChecked="{Binding chinaBidCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}"  Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <TextBlock Text="中债估值 Bid 最大偏离度 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:NumericUpDown  x:Name="txt_chinaBid" Width="48" Height="24" TextAlignment="Left" Margin="4,0,0,0"  Foreground="#FFEBC8"  NumericValue="{Binding chinaBid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  ContextMenu="{x:Null}" DecimalLength="2"  RangeValue="0.25"  MaxValue="1000" MinValue="0" AdjustDecimalLength="True"  ToolTip="输入框允许输入范围[0，1000]"></Component:NumericUpDown>
                            <TextBlock Text="bp"  Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                        <DockPanel Grid.Row="5" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_chinaOfrCheck" IsChecked="{Binding chinaOfrCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}" Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <TextBlock Text="中债估值 Ofr 最大偏离度 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:NumericUpDown  x:Name="txt_chinaOfr"  Width="48" Height="24" TextAlignment="Left"  Margin="4,0,0,0" Foreground="#FFEBC8" NumericValue="{Binding chinaOfr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  ContextMenu="{x:Null}" DecimalLength="2"  RangeValue="0.25"  MaxValue="1000" MinValue="0" AdjustDecimalLength="True"  ToolTip="输入框允许输入范围[0，1000]"></Component:NumericUpDown>
                            <TextBlock Text="bp"  Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="市场最优偏离" Style="{StaticResource TxtBlockTitle}"></TextBlock>

                        <DockPanel Grid.Row="7" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_marketBidCheck"  IsChecked="{Binding marketBidCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}" Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <TextBlock Text="市场最优 Bid 最大偏离度 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:NumericUpDown x:Name="txt_marketBid" Width="48" Height="24" TextAlignment="Left" Margin="4,0,0,0" Foreground="#FFEBC8" NumericValue="{Binding marketBid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  ContextMenu="{x:Null}" DecimalLength="2"  RangeValue="0.25"  MaxValue="1000" MinValue="0"  AdjustDecimalLength="True"  ToolTip="输入框允许输入范围[0，1000]"></Component:NumericUpDown>
                            <TextBlock Text="bp"  Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                        <DockPanel Grid.Row="8" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_marketOfrCheck"  IsChecked="{Binding marketOfrCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}" Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <TextBlock Text="市场最优 Ofr 最大偏离度 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:NumericUpDown  x:Name="txt_marketOfr"   Width="48" Height="24" TextAlignment="Left" Margin="4,0,0,0" Foreground="#FFEBC8" NumericValue="{Binding marketOfr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  ContextMenu="{x:Null}" DecimalLength="2"  RangeValue="0.25"  MaxValue="1000" MinValue="0" AdjustDecimalLength="True"  ToolTip="输入框允许输入范围[0，1000]"></Component:NumericUpDown>
                            <TextBlock Text="bp"  Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                        <TextBlock Grid.Row="9" Grid.ColumnSpan="3" Text="市场最优倒挂偏离" Style="{StaticResource TxtBlockTitle}"></TextBlock>
                        <DockPanel Grid.Row="10" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_dropAwayFromBidCheck"  IsChecked="{Binding dropAwayFromBidCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}" Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <TextBlock Text="市场最优 Bid 最大倒挂偏离度 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:NumericUpDown x:Name="txt_dropAwayFromBid" Width="48" Height="24"  TextAlignment="Left" Margin="4,0,0,0" Foreground="#FFEBC8" NumericValue="{Binding dropAwayFromBid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  ContextMenu="{x:Null}" DecimalLength="2"  RangeValue="0.25"  MaxValue="1000" MinValue="0" AdjustDecimalLength="True"  ToolTip="输入框允许输入范围[0，1000]"></Component:NumericUpDown>
                            <TextBlock Text="bp"  Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                        <DockPanel Grid.Row="11" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_dropAwayFromOfrCheck" IsChecked="{Binding dropAwayFromOfrCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}" Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <TextBlock Text="市场最优 Ofr 最大倒挂偏离度 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:NumericUpDown  x:Name="txt_dropAwayFromOfr"  Width="48" Height="24"  TextAlignment="Left" Margin="4,0,0,0" Foreground="#FFEBC8" NumericValue="{Binding dropAwayFromOfr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  ContextMenu="{x:Null}" DecimalLength="2"  RangeValue="0.25"  MaxValue="1000" MinValue="0" AdjustDecimalLength="True"  ToolTip="输入框允许输入范围[0，1000]"></Component:NumericUpDown>
                            <TextBlock Text="bp"  Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                        
                        <TextBlock Grid.Row="12" Grid.ColumnSpan="3" Text="最新成交偏离" Style="{StaticResource TxtBlockTitle}"></TextBlock>
                        <DockPanel Grid.Row="13" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_excutOrderBidCheck" IsChecked="{Binding excutOrderBidCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}" Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <TextBlock Text="最新成交 Bid 最大偏离度 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:NumericUpDown  x:Name="txt_excutOrderBid" Width="48" Height="24" TextAlignment="Left" Margin="4,0,0,0" Foreground="#FFEBC8"  NumericValue="{Binding excutOrderBid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  ContextMenu="{x:Null}" DecimalLength="2"  RangeValue="0.25"  MaxValue="1000" MinValue="0"  AdjustDecimalLength="True" ToolTip="输入框允许输入范围[0，1000]"></Component:NumericUpDown>
                            <TextBlock Text="bp"  Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                        <DockPanel Grid.Row="14" Grid.ColumnSpan="3"  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox x:Name="chk_excutOrderOfrCheck" IsChecked="{Binding excutOrderOfrCheck, Mode=TwoWay,Converter={StaticResource booleanConvertor}}" Style="{DynamicResource CheckAllForDelete}"></CheckBox>
                            <TextBlock Text="最新成交 Ofr 最大偏离度 &lt;="  Style="{DynamicResource TxtBlockDetail}"/>
                            <Component:NumericUpDown  x:Name="txt_excutOrderOfr"  Width="48" Height="24" TextAlignment="Left" Margin="4,0,0,0" Foreground="#FFEBC8"  NumericValue="{Binding excutOrderOfr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  ContextMenu="{x:Null}" DecimalLength="2"  RangeValue="0.25"  MaxValue="1000" MinValue="0"  AdjustDecimalLength="True" ToolTip="输入框允许输入范围[0，1000]"></Component:NumericUpDown>
                            <TextBlock Text="bp"  Style="{DynamicResource TxtBlockDetail}"/>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--<Border Grid.Column="1" BorderThickness="0" Visibility="{Binding VisibilityExcel,Mode=TwoWay}">-->
            <Border Grid.Column="1" x:Name="BorderExcelLayout" BorderThickness="0" Visibility="Collapsed" >
                <!--<localExcel:ExcelView x:Name="psExcelLayout"></localExcel:ExcelView>-->
            </Border>


            <Border Grid.Column="1" x:Name="BorderPriceLayout" BorderThickness="0" Visibility="Visible">
                <local:PageSetQuotation x:Name="psPriceLayout"></local:PageSetQuotation>
            </Border>

            <Border Grid.Column="1" x:Name="BorderPythonLayout" BorderThickness="0" Visibility="Collapsed">
                <Custom:PythonView x:Name="pythonView"></Custom:PythonView>
            </Border>

            <Border Grid.Column="1" x:Name="BorderMsgLayout" BorderThickness="0" Visibility="Collapsed">
                <CommonUI:MsgAlertSettingView x:Name="msgAlertSettingView"/>
            </Border>
            
        </Grid>

        <!--确定按钮-->
        <Border Grid.Row="2" BorderThickness="0" BorderBrush="#A0A0A0" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="32"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="确定" Command="{Binding OkCommand}" Visibility="{Binding VisibilityOK}" FontSize="12" Style="{DynamicResource SendPriceButton}" IsEnabled="{Binding SaveIsEnable, Mode=TwoWay}"  BorderThickness="0,1,0,0"  Width="80" Height="24"/>
                </StackPanel>
            </Grid>
        </Border>


    </Grid>
</UserControl>
