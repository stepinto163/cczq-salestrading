<Comp:WindowBase
             x:Class="BDB.Trade.Plugin.View.Trade.ConditionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Trade"
             xmlns:Comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Title="更多筛选" Height="220" Width="490" ResizeMode="NoResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen" BorderThickness="1" BorderBrush="#136C5E">

    <Comp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ListBoxStyleDictinary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Comp:WindowBase.Resources>



    <Grid Background="{StaticResource Window.Backgroud}">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="45"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68"></ColumnDefinition>
                <ColumnDefinition Width="60"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Text="经纪商：" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource FontSize-12}"
                       Foreground="{StaticResource Textblock.Foreground.HOLC.Gray}"></TextBlock>


            <TextBlock Text="类型：" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource FontSize-12}"
                       Foreground="{StaticResource Textblock.Foreground.HOLC.Gray}"></TextBlock>

            <TextBlock Text="剩余期限：" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource FontSize-12}"
                       Foreground="{StaticResource Textblock.Foreground.HOLC.Gray}"></TextBlock>

            <ListBox x:Name="lbtBroker" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" FontSize="10" ItemContainerStyle="{StaticResource MainFilterListBoxItemStyle}" SelectionMode="Extended" 
                     Background="Transparent" VerticalAlignment="Center" Margin="0, 0, 0, 0" SelectionChanged="LbtBroker_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>

                <ListBoxItem Content="全部" Margin="0, 0, 8, 0" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}" IsSelected="True"/>

                <ListBoxItem Content="国利" Visibility="Collapsed" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="国际" Visibility="Collapsed" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="平安" Visibility="Collapsed" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="信唐" Visibility="Collapsed" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="中诚" Visibility="Collapsed" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
            </ListBox>

            <ListBox x:Name="lbBondType" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"  FontSize="10" SelectionMode="Extended" Background="Transparent" VerticalAlignment="Center" 
                     Margin="0, 0, 0, 0" SelectionChanged="LbBondType_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>

                <ListBoxItem Content="全部" Margin="0, 0, 8, 0" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}" IsSelected="True"/>


                <ListBoxItem Content="国债" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="央票" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="地方债" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="金融债" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}"/>
            </ListBox>


            <ListBox x:Name="lbRemaingTime" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"  FontSize="10" SelectionMode="Extended" Background="Transparent" VerticalAlignment="Center" 
                     Margin="0, 0, 0, 0" SelectionChanged="LbRemaingTime_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>

                <ListBoxItem Content="全部" Margin="0, 0, 8, 0" Width="56" Height="24" Style="{StaticResource MainFilterListBoxItemStyle}" IsSelected="True"/>


                <ListBoxItem Content="0~1Y" Width="56" Height="24"  Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="1~3Y" Width="56" Height="24"  Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="3~5Y" Width="56" Height="24"  Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="5~7Y" Width="56" Height="24"  Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="7~10Y" Width="56" Height="24"  Style="{StaticResource MainFilterListBoxItemStyle}"/>
                <ListBoxItem Content="&gt;10Y" Width="56" Height="24"  Style="{StaticResource MainFilterListBoxItemStyle}"/>
            </ListBox>
            
        </Grid>


        <Border Grid.ColumnSpan="2" Grid.Row="1" BorderBrush="#0A0F0E" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="16, 0, 16, 0" HorizontalAlignment="Center">
                
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}" 
                            Click="btnCancel_Click" Margin="30, 0, 0, 0">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource Green2ButtonStyle}" Command="{Binding OkCommand}"
                        Click="btnOK_Click" >确定</Button>
            </StackPanel>

        </Border>

    </Grid>
</Comp:WindowBase>
