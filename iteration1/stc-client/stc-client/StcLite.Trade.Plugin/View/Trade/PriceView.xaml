<UserControl x:Class="BDB.Trade.Plugin.View.Trade.PriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Trade"
             xmlns:Comp="clr-namespace:BDB.Trade.Plugin.Component"
             mc:Ignorable="d" 
             d:DesignHeight="294" d:DesignWidth="283" MinWidth="285">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ContextMenu x:Key="OrderContextMenu" Style="{StaticResource DefaultContextMenu}">
                <MenuItem x:Name="miSendPrice" Header="报价" Style="{StaticResource DefaultMenuItem}" Click="OrderMenuItme_Click"/>
            </ContextMenu>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <ControlTemplate x:Key="QuotationList_DataGridCellTemplate" TargetType="{x:Type DataGridCell}">
                <Border BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                    <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="Height" Value="40"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="QuotationList_DataGridCellStyle_left" TargetType="{x:Type DataGridCell}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                <!--<Setter Property="Height" Value="{Binding RowHeight}"/>-->
                <!--<Setter Property="Height" Value="24"/>-->
                <!--<Setter Property="Template" Value="{StaticResource QuotationList_DataGridCellTemplate}"/>-->
                
                <Style.Triggers>

                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Bid.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bid.MouseOver.BorderBrush}"/>

                    </MultiTrigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bid.Selected.Backgroud}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bid.Selected.BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Trigger>

                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource MainFrame.Background}"/>
                    </Trigger>
                </Style.Triggers>

            </Style>


            <Style x:Key="BidDataGridRowStyle" TargetType="{x:Type DataGridRow}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="24"/>
                <!--<EventSetter Event="MouseDoubleClick" Handler="BidDataGrid_MouseDoubleClick"/>
                -->
                <!--<EventSetter Event="MouseRightButtonDown" Handler="BidDataGrid_MouseRightButtonDown"/>-->
                <!--
                <EventSetter Event="MouseRightButtonUp" Handler="DataGrid_MouseRightButtonUp"/>-->
                <Style.Triggers>

                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                    </Trigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Bid.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bid.MouseOver.BorderBrush}"/>

                    </MultiTrigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bid.Selected.Backgroud}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bid.Selected.BorderBrush}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="Height" Value="40"/>
                    </DataTrigger>
                </Style.Triggers>

            </Style>
            <!--<Style x:Key="OfrDataGridRowStyle" TargetType="{x:Type DataGridRow}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="24"/>
                -->
            
            <Style x:Key="Card_DataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Template" Value="{StaticResource QuotationList_DataGridCellTemplate}"/>
            </Style>

            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"></Setter>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <!--<Setter Property="Height" Value="{Binding RowHeight}"/>-->
                <!--<Setter Property="Height" Value="24"/>-->
                <!--<Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.Zero.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.One.ColorBrush}"/>
                    </Trigger>
                </Style.Triggers>-->
            </Style>

            <Style x:Key="CardDataGrid" TargetType="DataGrid">
                <!--<Setter Property="CanUserSortColumns" Value="False"/>-->
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="Cell"/>
                <!-- 不需要虚拟模式 -->
                <!--<Setter Property="EnableRowVirtualization" Value="False"/>-->
                <!-- 不需要边框 -->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="VirtualizingPanel.IsContainerVirtualizable" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
                <Setter Property="BorderBrush" Value="{StaticResource DataGridColumnHeaderBorderBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
                <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}"/>
                <Setter Property="CellStyle" Value="{StaticResource QuotationList_DataGridCellStyle_left}"/>
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            </Style>

            <Style x:Key="BorderStyle" TargetType="{x:Type Border}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#FF9300"/>
                    </Trigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="BidBrokerBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BidBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BidBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                    <!--<DataTrigger Binding="{Binding FirmFlag}" Value="1">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_shandian_14x14.png"/>
                        <Setter Property="ToolTip" Value="firm"/>
                    </DataTrigger>-->
                </Style.Triggers>
            </Style>


            <Style x:Key="BidBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BidBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BidBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                    <!--<DataTrigger Binding="{Binding FirmFlag}" Value="1">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_shandian_14x14.png"/>
                        <Setter Property="ToolTip" Value="firm"/>
                    </DataTrigger>-->
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OfrBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OfrBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                    <!--<DataTrigger Binding="{Binding FirmFlag}" Value="1">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_shandian_14x14.png"/>
                        <Setter Property="ToolTip" Value="firm"/>
                    </DataTrigger>-->
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrBrokerBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OfrBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OfrBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                    <!--<DataTrigger Binding="{Binding FirmFlag}" Value="1">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_shandian_14x14.png"/>
                        <Setter Property="ToolTip" Value="firm"/>
                    </DataTrigger>-->
                </Style.Triggers>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="2" BorderBrush="{StaticResource Border.Bottom.Background}" BorderThickness="0, 0, 0, 1" Background="{StaticResource MainFrame.Background}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"></RowDefinition>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="2">

                <Grid>
                    <Border x:Name="bdSecurity" Style="{StaticResource BorderStyle}" Visibility="{Binding BondGridVisibility}" BorderThickness="0" MouseLeftButtonDown="Border_MouseLeftButtonDown">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="30"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBlock Margin="6, 2, 0, 0" Grid.Column="0" Text="{Binding Security}" Foreground="{StaticResource LogDefaultFontBrush}" Height="25" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="{StaticResource FontSize-14}" ></TextBlock>
                            <TextBlock Margin="10, 2, 0, 0" Grid.Column="1" Text="{Binding SymbolName}" Foreground="{StaticResource LogDefaultFontBrush}"  Height="25" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="{StaticResource FontSize-14}" ></TextBlock>
                            <TextBlock Margin="10, 2, 0, 0" Grid.Column="2" Text="{Binding RemainingTime}" Height="25" VerticalAlignment="Center" Foreground="{StaticResource Textblock.Foreground.Gray}" HorizontalAlignment="Left" FontSize="{StaticResource FontSize-14}" ></TextBlock>

                            <Button x:Name="btnDelete" HorizontalAlignment="Right" Grid.Column="4" FontSize="{StaticResource FontSize-16}" Content="✕" Width="24" Height="24" 
                                    Style="{StaticResource CardDelteButtonStyle}" Margin="0, 0, 5, 2" Click="Button_Click"></Button>

                        </Grid>
                    </Border>

                    <Button Width="80" Height="24" Content="+添加债券" Command="{Binding AddCommand}" Visibility="{Binding AddBondVisibility}" Style="{StaticResource Green2ButtonStyle}"/>

                    <Comp:SearchEditUI x:Name="seSearch" Height="28" Visibility="{Binding SearchVisibility}" SearchChanged="SeSearch_SearchChanged"></Comp:SearchEditUI>

                </Grid>

            </Border>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="24"></ColumnDefinition>
                        <ColumnDefinition Width="30"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding LastExecSideBrush}" Text="{Binding LastExecSideShow}" FontSize="{StaticResource FontSize-10}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextBox.Static.Foreground}" Text="{Binding LastExecSource}" FontSize="{StaticResource FontSize-10}"/>

                    <TextBlock Text="{Binding LastExecPrice}" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="2" FontSize="{StaticResource FontSize-18}" Foreground="{Binding LastExecBrush}"/>

                    <TextBlock Text="{Binding LastExecPriceBP}" ToolTip="{Binding LastExecPriceBP}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 4, 0, 0" Grid.RowSpan="2" FontSize="{StaticResource FontSize-10}" Foreground="{Binding LastExecBrush}"/>
                    <TextBlock Text="{Binding LastExecDirection}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0, 0, 0, 0" Grid.RowSpan="2" FontSize="{StaticResource FontSize-10}" Foreground="{Binding LastExecBrush}"/>


                </Grid>
                <Comp:SettleFilterView HorizontalAlignment="Right" Margin="0, 0, 5, 0" x:Name="settleFilter" Grid.Column="2" Visibility="{Binding BondGridVisibility}"
                                       FilterDicChanged="SettleFilterView_FilterDicChanged"></Comp:SettleFilterView>

                <Grid Grid.Column="2" HorizontalAlignment="Right" Margin="0, 0, 5, 0" Visibility="{Binding AddBondVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0, 0, 2, 0" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="20" Height="20"></Border>
                    <Border Grid.Column="1" Margin="0, 0, 2, 0" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="20" Height="20"></Border>
                    <Border Grid.Column="2" Margin="0, 0, 2, 0" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="20" Height="20"></Border>
                    <Border Grid.Column="3" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="20" Height="20"></Border>
                    
                </Grid>
                
            </Grid>


            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142*"></ColumnDefinition>
                    <ColumnDefinition Width="123*"></ColumnDefinition>
                    <ColumnDefinition Width="18*"/>
                </Grid.ColumnDefinitions>

                <!--<Border x:Name="bdBid" Grid.Column="0" Margin="2, 0, 0, 0" BorderThickness="1" BorderBrush="{StaticResource Border.Background}">-->
                <Border x:Name="bdBid" Grid.Column="0" Margin="2, 0, 0, 0" BorderThickness="1" BorderBrush="{Binding UpSideBdBrush}" Background="{Binding UpSideBgBrush}" MouseRightButtonUp="BdBid_MouseRightButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35*"></ColumnDefinition>
                            <ColumnDefinition Width="65*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Polygon x:Name="BidArrow" Margin="1, 1, 0, 0" Grid.Column="0" Visibility="{Binding BidArrowVisibilly}" Stroke="{Binding BidArrowStroke}" Fill="{Binding BidArrowFill}" 
                                 Points="0,0 0,10 10,0" VerticalAlignment="Top" HorizontalAlignment="Left" ToolTip="{Binding BidArrowToolTxt}">
                        </Polygon>

                        <TextBlock Grid.Column="0" Text="{Binding BestBidAmount}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BestBidAmount}" Width="35" Height="22" HorizontalAlignment="Right" Margin="0, 20, 5, 0" FontSize="{StaticResource FontSize-12}" 
                               VerticalAlignment="Center" Foreground="{Binding AmountBrush}" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}"></TextBlock>

                        <TextBlock Grid.Column="1" Text="{Binding BestBid, Converter={StaticResource numConvertor}}" Height="25" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="{StaticResource FontSize-20}" 
                               Foreground="{Binding BidBrush}" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}"></TextBlock>

                    </Grid>
                </Border>


                <!--<Border x:Name="bdOfr" Grid.Column="1" Margin="0, 0, 2, 0" BorderThickness="1" BorderBrush="{StaticResource Border.Background}">-->
                <Border x:Name="bdOfr" Grid.Column="1" Margin="0, 0, 2, 0" BorderThickness="1" BorderBrush="{Binding UpSideBdBrush}" Background="{Binding UpSideBgBrush}" Grid.ColumnSpan="2" MouseRightButtonUp="BdOfr_MouseRightButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65*"></ColumnDefinition>
                            <ColumnDefinition Width="35*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0" Foreground="{Binding OfrBrush}" Text="{Binding BestOfr, Converter={StaticResource numConvertor}}" Height="25" VerticalAlignment="Center" HorizontalAlignment="Right" 
                                   FontSize="{StaticResource FontSize-20}" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}"></TextBlock>

                        <TextBlock Grid.Column="1" Text="{Binding BestOfrAmount}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BestOfrAmount}" Foreground="{Binding AmountBrush}" Width="35" Height="22" HorizontalAlignment="Left" TextAlignment="Right"
                               Margin="5, 20, 0, 0" FontSize="{StaticResource FontSize-12}" VerticalAlignment="Center" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}"></TextBlock>

                        <Polygon x:Name="OfrArrow" Grid.Column="1" Margin="1, 1, 0, 0" Visibility="{Binding OfrArrowVisibilly}" Stroke="{Binding OfrArrowStroke}" Fill="{Binding OfrArrowFill}" 
                                 Points="0,0 10,0 10,10" HorizontalAlignment="Right"  ToolTip="{Binding OfrArrowToolTxt}"/>


                    </Grid>
                </Border>


                <!--<Border Grid.Column="0" Grid.ColumnSpan="2" Width="53" Height="24" HorizontalAlignment="Center" VerticalAlignment="Bottom"  
                        Background="{StaticResource TextBox.Static.Background}" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource Border.Background}">-->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Width="45" Height="24" HorizontalAlignment="Center" VerticalAlignment="Bottom"  
                        Background="{StaticResource MainFrame.Background}" CornerRadius="2" BorderThickness="1" BorderBrush="{Binding UpSideBdBrush}" Margin="119,0,101,0">
                    <!--<Border Margin="1" BorderThickness="1" BorderBrush="{StaticResource Border.Background}">-->
                    <Border Margin="1" BorderThickness="1" BorderBrush="{Binding UpSideBdBrush}" Background="{Binding UpSideBdBrush}">
                        <TextBlock  Text="{Binding BestPriceBP}" TextAlignment="Center" Padding="0, 0, 0, 0" Foreground="{Binding AmountBrush}" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"
                                    FontSize="{StaticResource FontSize-11}" VerticalAlignment="Center" ToolTip="{Binding BestPriceBP}" TextTrimming="CharacterEllipsis"></TextBlock>
                    </Border>

                </Border >

            </Grid>


            <Comp:BrokerFilterView x:Name="brokerFilter" Grid.Row="3" Margin="0 , 2, 0, 2" Visibility="{Binding BondGridVisibility}" FilterDicChanged="BrokerFilterView_FilterDicChanged"></Comp:BrokerFilterView>

            <Grid Grid.Row="3" Margin="2, 2, 5, 2" Visibility="{Binding AddBondVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="44" Height="16"></Border>
                <Border Grid.Column="1" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="44" Height="16"></Border>
                <Border Grid.Column="2" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="44" Height="16"></Border>
                <Border Grid.Column="3" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="44" Height="16"></Border>
                <Border Grid.Column="4" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="44" Height="16"></Border>
                <Border Grid.Column="5" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="44" Height="16"></Border>
                <Border Grid.Column="6" CornerRadius="2" Background="{StaticResource Border.Background.NoData}" Width="44" Height="16"></Border>
            </Grid>



            <Grid Grid.Row="4" Visibility="{Binding AllVisibility}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgBid" Grid.Column="0" Grid.Row="1" ItemsSource="{Binding BidTableView}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" Style="{StaticResource CardDataGrid}"
                     Margin="2, 0, 1, 0" MouseDoubleClick="DgBid_MouseDoubleClick" VerticalScrollBarVisibility="Hidden"  SelectionUnit="Cell" Background="#0A0F0E"
                          HeadersVisibility="None" HorizontalScrollBarVisibility="Hidden" LostFocus="DgBid_LostFocus" RowHeaderWidth="0" RowHeight="26"
                  >

                    <DataGrid.Columns>

                        <DataGridTemplateColumn x:Name="bid"  Width="50*">

                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="#0A0F0E"/>
                                    <Setter Property="ContentTemplate">

                                        <Setter.Value>

                                            <DataTemplate>


                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition></ColumnDefinition>
                                                        <ColumnDefinition></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Bid.Vol" Grid.Column="0" Foreground="#788187" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15, 0, 0, 0"></TextBlock>
                                                    <TextBlock Text="Bid" Grid.Column="1" Foreground="#788187" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0, 0, 20, 0"></TextBlock>

                                                </Grid>

                                            </DataTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="gridBg">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" x:Name="cdSettle"></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Canvas x:Name="bidCornerMarket" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                ToolTip="{Binding BidCornerMarketText}" Margin="0, 0, 0, 0">

                                            <Path Stroke="Black" StrokeThickness="0" Fill="{StaticResource Bid.textblock.foreground}">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathGeometry.Figures>
                                                            <PathFigure StartPoint="8,0" IsClosed="True">
                                                                <LineSegment Point="0,0" />
                                                                <LineSegment Point="0,8" />
                                                            </PathFigure>
                                                        </PathGeometry.Figures>
                                                    </PathGeometry>
                                                </Path.Data>
                                            </Path>


                                        </Canvas>


                                        <TextBlock Text="{Binding ShowSettleType}" ToolTip="{Binding BidCornerMarketText}" Visibility="{Binding HeadVisibility}"
                                                   Foreground="{StaticResource TextBox.Static.Foreground}" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   Margin="0, 0, 0, 0"></TextBlock>

                                        <TextBlock x:Name="tbBidAmount" Text="{Binding BidAmount}" ToolTip="{Binding BidCornerMarketText}" Foreground="{StaticResource TextBox.Static.Foreground}" 
                                                   Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10, 0, 0, 0"></TextBlock>

                                        <Grid Grid.Column="2" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0, 0, 5, 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>

                                            <!--<TextBlock x:Name="tbBid" Text="{Binding Bid}" Grid.Column="0" ToolTip="{Binding Bid}" Foreground="{StaticResource Bid.textblock.foreground}" ></TextBlock>-->
                                            <TextBlock x:Name="tbBid" Text="{Binding Bid, Converter={StaticResource numConvertor}}" TextTrimming="CharacterEllipsis" Grid.Column="0" ToolTip="{Binding Bid}"  ></TextBlock>

                                            <Image x:Name="imsgBidStar" Grid.Column="1" Width="10" Height="10" Margin="2, 0, 0, 0" Style="{StaticResource BidBargainFlagStyle}"/>


                                        </Grid>

                                    </Grid>


                                    <DataTemplate.Triggers>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding TradePermissionFlag}" Value="1" />
                                                <Condition Binding="{Binding Bid, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="False"/>
                                                <Condition Binding="{Binding AllIsNullFlag, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>

                                            <Setter TargetName="gridBg" Property="Background" Value="{StaticResource Bid.Selected.BorderBrush-30%}"/>

                                        </MultiDataTrigger>

                                        <DataTrigger Binding="{Binding AllIsNullFlag, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="True">
                                            <Setter TargetName="tbBid" Property="Foreground" Value="{StaticResource Bid.textblock.foreground}"/>
                                            <Setter TargetName="tbBidAmount" Property="Foreground" Value="{StaticResource TextBox.Static.Foreground}"/>
                                            
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding AllIsNullFlag, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="False">
                                            <Setter TargetName="tbBid" Property="Foreground" Value="{StaticResource Separator.ColorBrush}"/>
                                            <Setter TargetName="tbBidAmount" Property="Foreground" Value="{StaticResource Separator.ColorBrush}"/>
                                            <Setter TargetName="gridBg" Property="Background" Value="{StaticResource MainFrame.Background}"/>
                                        </DataTrigger>


                                        <!--<DataTrigger Binding="{Binding DataContext.Security, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" Value="">
                                            <Setter TargetName="tbBid" Property="Foreground" Value="{StaticResource Separator.ColorBrush}"/>
                                            <Setter TargetName="tbBidAmount" Property="Foreground" Value="{StaticResource Separator.ColorBrush}"/>
                                        </DataTrigger>-->

                                        <DataTrigger Binding="{Binding BidCornerMarket}" Value="1">
                                            <Setter TargetName="bidCornerMarket" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ShowSettleColumnFlag}" Value="1">
                                            <Setter TargetName="cdSettle" Property="Width" Value="20"/>
                                        </DataTrigger>

                                    </DataTemplate.Triggers>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn  x:Name="ofr"  Width="50*">

                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="#0A0F0E"/>
                                    <Setter Property="ContentTemplate">

                                        <Setter.Value>

                                            <DataTemplate>


                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition></ColumnDefinition>
                                                        <ColumnDefinition></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Ofr" Grid.Column="0" HorizontalAlignment="Left" Foreground="#788187" VerticalAlignment="Center" Margin="20, 0, 0, 0"></TextBlock>

                                                    <TextBlock Text="Ofr.Vol" Grid.Column="1" HorizontalAlignment="Right" Foreground="#788187" VerticalAlignment="Center" Margin="0, 0, 20, 0"></TextBlock>

                                                </Grid>

                                            </DataTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid x:Name="gridBg">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition Width="12"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>

                                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center"  Grid.Column="0" Margin="6, 0, 0, 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="tbOfr" Text="{Binding Ofr, Converter={StaticResource numConvertor}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Ofr}" Grid.Column="0" ></TextBlock>

                                            <Image x:Name="imgOfrStar" Grid.Column="1" Width="10" Height="10" Margin="2, 0, 0, 0" Style="{StaticResource OfrBargainFlagStyle}"/>

                                        </Grid>


                                        <TextBlock x:Name="tbOfrAmount"  Text="{Binding OfrAmount}" ToolTip="{Binding OfrCornerMarketText}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                   Grid.Column="1" Margin="0, 0, 15, 0"></TextBlock>
                                        

                                        <Canvas x:Name="ofrCornerMarket" Grid.Column="2" ToolTip="{Binding OfrCornerMarketText}" Visibility="Collapsed"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0, 0, -2, 0" Width="10" >

                                            <Path Stroke="Black" StrokeThickness="0" Fill="{StaticResource Ofr.Selected.BorderBrush}">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathGeometry.Figures>
                                                            <PathFigure StartPoint="0,0" IsClosed="True">
                                                                <LineSegment Point="8,0" />
                                                                <LineSegment Point="8,8" />
                                                            </PathFigure>
                                                        </PathGeometry.Figures>
                                                    </PathGeometry>
                                                </Path.Data>
                                            </Path>


                                        </Canvas>

                                    </Grid>

                                    <DataTemplate.Triggers>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding TradePermissionFlag}" Value="1" />
                                                <Condition Binding="{Binding Ofr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="False"/>
                                                <Condition Binding="{Binding AllIsNullFlag, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>

                                            <Setter TargetName="gridBg" Property="Background" Value="{StaticResource Bid.Selected.BorderBrush-30%}"/>

                                        </MultiDataTrigger>


                                        <DataTrigger Binding="{Binding AllIsNullFlag, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="True">
                                            <Setter TargetName="tbOfr" Property="Foreground" Value="{StaticResource ColorBrush.Blue_firm}"/>
                                            <Setter TargetName="tbOfrAmount" Property="Foreground" Value="{StaticResource TextBox.Static.Foreground}"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding AllIsNullFlag}" Value="1">
                                            <Setter TargetName="tbOfr" Property="Foreground" Value="{StaticResource Separator.ColorBrush}"/>
                                            <Setter TargetName="tbOfrAmount" Property="Foreground" Value="{StaticResource Separator.ColorBrush}"/>
                                            <Setter TargetName="gridBg" Property="Background" Value="{StaticResource MainFrame.Background}"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding OfrCornerMarket}" Value="1">
                                            <Setter TargetName="ofrCornerMarket" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>




                    </DataGrid.Columns>

                </DataGrid>


                <Grid Grid.Row="0" Visibility="{Binding BrokerVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="2" Height="60" Background="{StaticResource Bid.Selected.BorderBrush-16%}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"></RowDefinition>
                                <RowDefinition Height="25"></RowDefinition>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <!--<TextBlock Text="Bid" Grid.Row="0" Margin="0, 2, 0, 0" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{StaticResource Bid.textblock.foreground}" TextAlignment="Center" FontSize="{StaticResource FontSize-12}"></TextBlock>-->

                            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0, 3, 0, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding BidPrice, Converter={StaticResource numConvertor}}" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource Bid.textblock.foreground}" TextAlignment="Center" FontSize="{StaticResource FontSize-24}"></TextBlock>
                                <Image x:Name="imsgBidStar" Grid.Row="1" Grid.Column="1" Width="10" Height="10" Margin="2, 0, 0, 0" Style="{StaticResource BidBrokerBargainFlagStyle}"/>
                            </Grid>

                            <TextBlock Text="{Binding BidTxt}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0, 3, 0, 0" Foreground="{StaticResource Button.Static.Foreground}" TextAlignment="Center" 
                           FontSize="{StaticResource FontSize-12}" ToolTip="{Binding BidTxt}"  TextTrimming="CharacterEllipsis" MaxWidth="140"></TextBlock>


                            <Canvas x:Name="bidCornerMarket" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                ToolTip="{Binding BidCornerMarketText}" Margin="1, 0, 0, 0">

                                <Path Stroke="Black" StrokeThickness="0" Fill="{StaticResource Bid.textblock.foreground}">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathGeometry.Figures>
                                                <PathFigure StartPoint="8,0" IsClosed="True">
                                                    <LineSegment Point="0,0" />
                                                    <LineSegment Point="0,8" />
                                                </PathFigure>
                                            </PathGeometry.Figures>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>


                            </Canvas>

                        </Grid>
                    </Border>


                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="2" Height="60" Background="{StaticResource Ofr.Selected.BorderBrush-16%}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"></RowDefinition>
                                <RowDefinition Height="25"></RowDefinition>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <!--<ColumnDefinition Width="10"></ColumnDefinition>-->
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <!--<TextBlock Text="Ofr" Grid.Row="0" Margin="0, 2, 0, 0" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{StaticResource Ofr.Selected.BorderBrush}" TextAlignment="Center" FontSize="{StaticResource FontSize-12}"></TextBlock>-->

                            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0, 3, 0, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding OfrPrice, Converter={StaticResource numConvertor}}" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource Ofr.Selected.BorderBrush}" TextAlignment="Center" FontSize="{StaticResource FontSize-24}"></TextBlock>

                                <Image x:Name="imsgOfrStar" Grid.Row="1" Grid.Column="1" Width="10" Height="10" Margin="2, 0, 0, 0" Style="{StaticResource OfrBrokerBargainFlagStyle}"/>



                            </Grid>

                            <TextBlock Text="{Binding OfrTxt}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0, 3, 0, 0" Foreground="{StaticResource Button.Static.Foreground}" TextAlignment="Center" 
                           FontSize="{StaticResource FontSize-12}" ToolTip="{Binding OfrTxt}" TextTrimming="CharacterEllipsis" MaxWidth="140"></TextBlock>


                            <Canvas x:Name="ofrCornerMarket" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                ToolTip="{Binding BidCornerMarketText}" Margin="1, 0, 0, 0">

                                <Path Stroke="Black" StrokeThickness="0" Fill="{StaticResource Bid.textblock.foreground}">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathGeometry.Figures>
                                                <PathFigure StartPoint="8,0" IsClosed="True">
                                                    <LineSegment Point="0,0" />
                                                    <LineSegment Point="0,8" />
                                                </PathFigure>
                                            </PathGeometry.Figures>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>


                            </Canvas>

                        </Grid>
                    </Border>



                </Grid>

            </Grid>
        </Grid>

    </Border>

</UserControl>
