<UserControl x:Class="BDB.Trade.Plugin.View.Trade.PriceTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Trade"
             xmlns:Comp="clr-namespace:BDB.Trade.Plugin.Component"
             xmlns:CommonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:Utils="clr-namespace:STC.Common.Utils;assembly=STC.Common"
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ContextMenuStyleDictionary.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="templateRoot" SnapsToDevicePixels="true" Background="Transparent" BorderBrush="#515151" BorderThickness="0,0,0,0">
                                <Border x:Name="splitBorder" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0" HorizontalAlignment="Center" BorderThickness="0" BorderBrush="Transparent">
                                    <!--<Path x:Name="arrow"  VerticalAlignment="Center"  HorizontalAlignment="Center"  Fill="#FFFFFF" Data="M0,0 L6,0 3,4 z"/>-->

                                    <TextBlock x:Name="arrow" Text="v" Foreground="{StaticResource TextBox.Static.Foreground}" Padding="0, 3, 0, 0"></TextBlock>
                                    
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--鼠标移过-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Foreground" TargetName="arrow" Value="#FFFFFF"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                    <!--<Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>-->
                                </MultiDataTrigger>
                                <!--鼠标按下-->
                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter Property="Foreground" TargetName="arrow" Value="#FFFFFF"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                    <!--<Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>-->
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            

            <!--Combox-->
            <Style TargetType="ComboBox" x:Key="CustomComboBoxStyle">
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="30"></Setter>
                            <Setter Property="MinWidth" Value="30"></Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextBox.Static.Foreground}"></Setter>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Back" Background="{StaticResource TextBox.MouseOver.Background}"  BorderThickness="0,0,0,0">
                                            <ContentPresenter ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Center"></ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                                <Setter TargetName="Back" Property="BorderThickness" Value="0, 0, 0, 1"></Setter>
                                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource BlueButton.MouseOver.Border}"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="bdTextBox"   Grid.Column="0" BorderThickness="0" Background="Transparent" Grid.ColumnSpan="2" Width="{TemplateBinding Width}"
                                  Text="{TemplateBinding Text}" Foreground="{StaticResource TextBox.Static.Foreground}" FontSize="12" Padding="2, 5, 0, 0">
                                </TextBox>
                                <Border Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0" BorderBrush="#193D37" CornerRadius="2">
                                    <Grid>
                                        <TextBlock MouseDown="TextBlock_MouseDown"></TextBlock>
                                        <Polygon Margin="0, 0, 2, 2" Grid.Column="0" Stroke="Transparent" Fill="#8F9598" Points="0,6 6,0 6,6" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>

                                    </Grid>
                                </Border>
                                <Border x:Name="tbToggle" Visibility="Collapsed" Grid.Column="1" BorderThickness="0" BorderBrush="#193D37" CornerRadius="0, 2, 2, 0">
                                    <ToggleButton x:Name="tbArrow" Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"></ToggleButton>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Width="{TemplateBinding Width}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdTextBox" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="tbToggle" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="tbToggle" Property="BorderThickness" Value="0, 0, 0, 1"></Setter>
                                    <Setter TargetName="tbToggle" Property="BorderBrush" Value="{StaticResource BlueButton.MouseOver.Border}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                            
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BidTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource Font.MicrosoftYaHei}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSize-12}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange_firm}"/>
            </Style>

            <Style x:Key="OfrTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource Font.MicrosoftYaHei}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSize-12}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue_firm}"/>
            </Style>


            <Style x:Key="DataGridRowStyle" TargetType="{x:Type DataGridRow}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <!--<Setter Property="BorderThickness" Value="1"/>-->
                <Setter Property="Height" Value="30"/>
                <!--<EventSetter Event="MouseRightButtonDown" Handler="BidDataGrid_MouseRightButtonDown"/>-->
                <!--<EventSetter Event="MouseRightButtonUp" Handler="DataGrid_MouseRightButtonUp"/>-->
                <Style.Triggers>

                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.Zero.ColorBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.One.ColorBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                    </Trigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <!--<Setter Property="Background" Value="{StaticResource Bid.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bid.MouseOver.BorderBrush}"/>-->

                        <Setter Property="Background" Value="#0A2420"/>
                        <Setter Property="BorderBrush" Value="#0A2420"/>
                        
                        
                    </MultiTrigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <Trigger Property="IsSelected" Value="True">
                        <!--<Setter Property="Background" Value="{StaticResource Bid.Selected.Backgroud}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bid.Selected.BorderBrush}"/>-->
                        <Setter Property="Background" Value="#193D37"/>
                        <Setter Property="BorderBrush" Value="#193D37"/>
                    </Trigger>
                   
                </Style.Triggers>

            </Style>

            <Style x:Key="DataGridCellStylesss" TargetType="{x:Type DataGridCell}">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 居中 -->
            <Style x:Key="CustomeDataGridTextCenterStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStylesss}">
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                <!--<Setter Property="BorderThickness" Value="0, 0, 1, 0"/>
                <Setter Property="BorderBrush" Value="#0A0F0E"/>-->
            </Style>

            <Style x:Key="CustomeDataGridColumnHeaderCenterStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderCenterStyle}">
                <Setter Property="Background" Value="#0A0F0E"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="2" BorderBrush="#136C5E" BorderThickness="1" Margin="1" Background="#0A0F0E">
        <Grid>

            <Grid.RowDefinitions>
                <!--<RowDefinition Height="35"></RowDefinition>-->
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <!--<Comp:BrokerSettleFilterView x:Name="lbFilter" Margin="10, 0, 0, 0" Grid.Row="0" FilterDicChanged="LbFilter_FilterDicChanged"></Comp:BrokerSettleFilterView>-->

            <CommonComp:ExDataGrid x:Name="dgData" GridLinesVisibility="Vertical" Style="{StaticResource DefaultDataGrid}" SelectionMode="Single" Grid.Row="1" ItemsSource="{Binding PriceTableView}"
                      SelectedItem="{Binding SelectedItem_Symbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ColumnHeaderStyle="{StaticResource CustomeDataGridColumnHeaderCenterStyle}" Margin="10, 10, 0, 0"  HorizontalContentAlignment="Stretch"
                      CellStyle="{StaticResource CustomeDataGridTextCenterStyle}" RowStyle="{StaticResource DataGridRowStyle}"
                      SelectionChanged="DataGrid_SelectionChanged" MouseRightButtonDown="DgData_MouseRightButtonDown" AllowDrop="True" 
                                  FixedDisplayColumns="增删,代码" >
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="dgMenu" Style="{DynamicResource DefaultContextMenu}" Opened="dgMenu_Opened">
                        <MenuItem x:Name="miSendPrice" Header="报价" Style="{StaticResource DefaultMenuItem}" Click="OrderMenuItme_Click"/>
                        <MenuItem x:Name="miEdit" Header="编辑" Style="{StaticResource DefaultMenuItem}" Click="MenuItem_Click"/>
                        <MenuItem x:Name="miCancel" Header="撤销" Style="{StaticResource DefaultMenuItem}" Click="MiCancel_Click"/>
                        <!--<MenuItem x:Name="miSort" Header="自定义排序" Style="{StaticResource DefaultMenuItem}" Click="MiSort_Click"/>-->
                        <MenuItem x:Name="CopySecurityIDMenu" Header="复制代码" Style="{DynamicResource DefaultMenuItem}" Click="CopySecurityIDMenu_Click"/>
                        <MenuItem x:Name="CopySymbolNameMenu" Header="复制简称" Style="{DynamicResource DefaultMenuItem}" Click="CopySymbolNameMenu_Click"/>
                        <MenuItem x:Name="CopySingleClickMenu" Header="复制行情(单击)" Style="{DynamicResource DefaultMenuItem}" Click="CopySingleClickMenu_Click"/>
                        <MenuItem x:Name="CopyDoubleClickMenu" Header="速点复制(双击)" Style="{DynamicResource DefaultMenuItem}" Click="CopyDoubleClick_Click"/>
                        <MenuItem x:Name="CopyCtrlSingleClickMenu" Header="生成意向(ctrl+单击)" Style="{DynamicResource DefaultMenuItem}" Click="CopyCtrlSingleClickMenu_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Resources>

                    <Style x:Key="CustomerHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                        <!--<Setter Property="Foreground" Value="#788187"/>-->
                        <!--<Setter Property="Foreground" Value="{StaticResource TextBox.Static.Foreground}"/>-->
                        <Setter Property="Foreground" Value="#A0A0A0"/>
                        <Setter Property="Background" Value="#0A0F0E"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment"  Value="Center"/>
                        <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                        <Setter Property="Padding" Value="5,0,5,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  VerticalAlignment ="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter x:Name="content" Grid.Column="0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                        HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                                        VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"/>


                                                <Border x:Name="SortArrow" Grid.Column="1" Width="10" Height="10.5" HorizontalAlignment="Right" Visibility="Collapsed">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="/STC.Common;component/Images/stclite-asc.png"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="1" Height="12" BorderBrush="#3C3C3C" BorderThickness="0 0 1 0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="content" Property="TextBlock.Foreground" Value="#00D198"/>
                                            <Setter TargetName="SortArrow" Property="Background">
                                                <Setter.Value>
                                                    <ImageBrush ImageSource="/STC.Common;component/Images/stclite-desc.png"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="content" Property="TextBlock.Foreground" Value="#00D198"/>
                                            
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTemplateColumn Utils:DataGridUtil.Name="增删" Width="30" CanUserSort="False">

                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">

                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="ContentTemplate">

                                    <Setter.Value>

                                        <DataTemplate>


                                            <Grid>
                                                <Button x:Name="btnAddBond" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize-14}" Content="➕" Width="32" Height="20" 
                                    Style="{StaticResource AddButtonStyle}" Click="BtnAddBond_Click" ToolTip="添加" Margin="0 ,0 ,0 ,2"></Button>

                                            </Grid>

                                        </DataTemplate>

                                    </Setter.Value>

                                </Setter>

                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>



                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="一" Style="{StaticResource GreenButtonStyle}" ToolTip="删除" Margin="-5, 0, 0, 0"  
                                         Width="30" Height="30" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"  CommandParameter="{Binding SecurityDbID}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding SecurityID}" HeaderStyle="{StaticResource CustomerHeaderStyle}" Header="代码" Width="Auto" MinWidth="90" Foreground="{StaticResource TextBox.Static.Foreground}"
                                    FontSize="{StaticResource FontSize-12}" ClipboardContentBinding="{Binding SecurityID}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource CustomeDataGridTextCenterStyle}">
                                <EventSetter Event="MouseDoubleClick" Handler="dgData_MouseDoubleClick"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>


                    </DataGridTextColumn>

                    <DataGridTemplateColumn Utils:DataGridUtil.Name="清算速度" MinWidth="30" CanUserSort="False">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="cbSettle" Grid.Column="2" Width="30"  Height="30" Margin="-5, 0, 0, 0" Padding="0, 3, 0, 0" Text="{Binding SettleType}" FontSize="{StaticResource FontSize-12}"
                                Style="{StaticResource CustomComboBoxStyle}" SelectedIndex="0" SelectionChanged="CbSettle_SelectionChanged" Foreground="{StaticResource TextBox.Static.Foreground}">
                                    <ComboBoxItem Content="全" Tag="1" PreviewMouseDown="ComboBoxItem_PreviewMouseDown"></ComboBoxItem>
                                    <ComboBoxItem Content="+0" Tag="2" PreviewMouseDown="ComboBoxItem_PreviewMouseDown"></ComboBoxItem>
                                    <ComboBoxItem Content="+1" Tag="3" PreviewMouseDown="ComboBoxItem_PreviewMouseDown"></ComboBoxItem>
                                    <ComboBoxItem Content="远" Tag="4" PreviewMouseDown="ComboBoxItem_PreviewMouseDown"></ComboBoxItem>
                                </ComboBox>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsShowSettle}" Value="0">
                                        <Setter TargetName="cbSettle" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding Symbol}" Header="简称" Foreground="{StaticResource TextBox.Static.Foreground}" Width="Auto" MinWidth="85" FontSize="{StaticResource FontSize-12}" ClipboardContentBinding="{Binding Symbol}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource CustomeDataGridTextCenterStyle}">
                                <EventSetter Event="MouseDoubleClick" Handler="dgData_MouseDoubleClick"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn Binding="{Binding RemaingingTime}"  SortMemberPath="RemaingingTimeConvert" HeaderStyle="{StaticResource CustomerHeaderStyle}" FontSize="{StaticResource FontSize-12}" Foreground="{StaticResource TextBox.Static.Foreground}" ClipboardContentBinding="{Binding RemaingingTime}" Header="剩余期限" Width="Auto" MinWidth="40">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding BondType}"  Foreground="{StaticResource TextBox.Static.Foreground}" Header="类型" Width="Auto" MinWidth="52" FontSize="{StaticResource FontSize-12}" ClipboardContentBinding="{Binding Symbol}"/>


                    <!--<DataGridTemplateColumn Header="MyBid" MinWidth="92" Visibility="Collapsed">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="35"></ColumnDefinition>
                                        <ColumnDefinition MinWidth="45"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MyBidQty}" Grid.Column="0" Style="{StaticResource BidTextBlockStyle}"/>
                                    <TextBlock Text="{Binding MyBid}" Grid.Column="1" Style="{StaticResource BidTextBlockStyle}"/>
                                    <TextBlock x:Name="tbLimitTime" Grid.Column="2" Text="{Binding MyBidLimitTime}" Visibility="Collapsed" Style="{StaticResource BidTextBlockStyle}"/>

                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MyBidLimitTimeFlag}" Value="1">
                                        <Setter TargetName="tbLimitTime" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->


                    <DataGridTemplateColumn Header="最优Bid" MinWidth="123" SortMemberPath="BidBestSort">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="bdUpSideBid" BorderThickness="0" MinWidth="122" Height="30" Margin="-5,0,0,0" Background="Transparent">
                                    <Grid x:Name="bid_area">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Polygon x:Name="BidArrow" Margin="0, 0, 0, 0" Grid.Column="0" Stroke="#FF7D00" Fill="#30FF7D00" Points="0,0 0,10 10,0" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                        <TextBlock x:Name="tbBidBestQty" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" Grid.Column="1" Margin="3, 0, 0, 0" Text="{Binding BidBestQty}" HorizontalAlignment="Left" Style="{StaticResource BidTextBlockStyle}"/>
                                        <TextBlock x:Name="tbBidBest"  TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"  Grid.Column="2" Text="{Binding BidBest}" HorizontalAlignment="Left" Style="{StaticResource BidTextBlockStyle}" FontWeight="Bold"/>


                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            
                                            <Border x:Name="Bid_T0"  CornerRadius="2" Width="16" Height="16" Background="#193D37" VerticalAlignment="Center" Margin="3,0,0,0" Visibility="Collapsed">
                                                <TextBlock Text="+0"  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize-10}" Foreground="#FFFFFF"
                                                       Padding="0, 0, 2, 0"/>
                                            </Border>
                                            <Border x:Name="Bid_yuan" CornerRadius="2" Width="16" Height="16" Background="#193D37" VerticalAlignment="Center" Visibility="Collapsed" Margin="3,0,0,0">
                                                <TextBlock Text="远"  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize-10}" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border x:Name="Bid_T1"  Grid.Column="0" CornerRadius="2" Width="16" Height="16" Background="#193D37" VerticalAlignment="Center" Margin="3,0,0,0" Visibility="Collapsed">
                                                <TextBlock Text="+1"  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSize-10}" Foreground="#FFFFFF"/>
                                            </Border>
                                        </StackPanel>
                                        
                                        
                                        
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!--是否倒挂-->
                                    <DataTrigger Binding="{Binding UpSide}" Value="1">
                                        <Setter TargetName="bdUpSideBid" Property="BorderThickness" Value="1, 1, 1, 1"/>
                                        <Setter TargetName="bdUpSideBid" Property="BorderBrush" Value="{StaticResource Textblock.Foreground.Red-60%}"/>
                                        <Setter TargetName="bdUpSideBid" Property="Background" Value="{StaticResource Border.Background.UpSide}"/>

