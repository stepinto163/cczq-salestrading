<comp:WindowBase x:Class="BDB.Price.Plugin.View.Trade.RecognizeIntentionQuoteWin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Price.Plugin.View.Trade"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" Title="批量导入" Width="700" Height="500" WindowStartupLocation="CenterScreen"
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
             d:DesignHeight="450" d:DesignWidth="800" BorderThickness="1" BorderBrush="#136C5E"  Background="#171F1F">
    <comp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/TabControlStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--<comCon:BooleanConvertor x:Key="booleanConvertor"/>
            <comCon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <comCon:DaysOffStrConverter x:Key="DaysOffCon"/>
            <comCon:NumberConvertor x:Key="numConvertor"/>
            <Con:SubStringConverter x:Key="subStringConverter"/>
            <comCon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <comCon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>-->



            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="SideTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="SelfVGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{DynamicResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Rectangle Width="1" Height="12" Stroke="#515151" Margin="0,0,2,0"/>
                                    <Rectangle Width="1" Height="12" Stroke="#515151" Margin="-2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 居中 -->
            <Style x:Key="SelfDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="SelfDataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Right"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="SelfDataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>


            <Style x:Key="GroupComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Focusable" Value="false"/>
                <Setter Property="ClickMode" Value="Press"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="templateRoot" SnapsToDevicePixels="true" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <Border x:Name="splitBorder" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="{TemplateBinding Padding}" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
                                    <Path x:Name="arrow"  Stroke="#FEEBC8" StrokeThickness="1" Data="M 6,10 L 10,15 L 14,10"/>

                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--鼠标移过-->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#F9C152"/>
                                </MultiDataTrigger>
                                <!--鼠标按下-->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#F9C152"/>
                                </MultiDataTrigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Stroke" TargetName="arrow" Value="#788187"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GroupComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="MinHeight" Value="20"></Setter>
                <Setter Property="MinWidth" Value="60"></Setter>
                <Setter Property="Foreground" Value="#FEEBC8"></Setter>
                <Setter Property="FontSize" Value="12"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Grid Name="Back" Background="Transparent" Height="{TemplateBinding Height}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="{Binding Source}" TextBlock.TextAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"></ContentPresenter>
                                <Path x:Name="optionMark" Grid.Column="1" Width="20" Data="F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z " 
                                      Fill="#F9C152" Opacity="0" Stretch="None" Visibility="Visible" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#F9C152"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#F9C152"/>
                                    <Setter TargetName="optionMark" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="GroupComboBoxTemplate" TargetType="{x:Type ComboBox}">
                <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition MinWidth="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" Placement="Bottom">
                        <Themes:SystemDropShadowChrome x:Name="shadow" Color="Transparent" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                            <Border x:Name="dropDownBorder" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" CornerRadius="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="AddGroup" Content="+新建分组" Style="{StaticResource DefaultButtonStyle}" HorizontalContentAlignment="Left" Background="#121A19" Click="AddGroup_Click"/>
                                    <Line X1="0" Y1="0" X2="88" Y2="0" Stroke="#263735" Width="88" Height="1" VerticalAlignment="Bottom"/>
                                    <ScrollViewer x:Name="DropDownScrollViewer" Grid.Row="1" Margin="0 4 0 0">
                                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="opaqueRect" Fill="{Binding Background, ElementName=dropDownBorder}" Height="{Binding ActualHeight, ElementName=dropDownBorder}" Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                                
                            </Border>
                        </Themes:SystemDropShadowChrome>
                    </Popup>
                    <ToggleButton x:Name="toggleButton" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.ColumnSpan="2" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource GroupComboBoxToggleButton}" Padding="0 -2 4 0"/>
                    <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                        <Setter Property="Margin" TargetName="shadow" Value="0,0,5,5"/>
                        <Setter Property="Color" TargetName="shadow" Value="#71000000"/>
                    </Trigger>
                    <Trigger Property="HasItems" Value="false">
                        <Setter Property="Height" TargetName="dropDownBorder" Value="95"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsGrouping" Value="true"/>
                            <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                    </MultiTrigger>
                    <Trigger Property="ScrollViewer.CanContentScroll" SourceName="DropDownScrollViewer" Value="false">
                        <Setter Property="Canvas.Top" TargetName="opaqueRect" Value="{Binding VerticalOffset, ElementName=DropDownScrollViewer}"/>
                        <Setter Property="Canvas.Left" TargetName="opaqueRect" Value="{Binding HorizontalOffset, ElementName=DropDownScrollViewer}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsDropDownOpen" Value="True"/>
                            <Condition SourceName="PART_Popup" Property="IsMouseOver" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="toggleButton" Property="BorderBrush" Value="#00CDAD"></Setter>
                        <Setter TargetName="toggleButton" Property="BorderThickness" Value="1"></Setter>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsDropDownOpen" Value="True"/>
                            <Condition SourceName="PART_Popup" Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="toggleButton" Property="BorderBrush" Value="#00CDAD"></Setter>
                        <Setter TargetName="toggleButton" Property="BorderThickness" Value="1"></Setter>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <!--Combox-->
            <Style x:Key="GroupNonEditableComboBoxStyle" TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="#121A19"/>
                <Setter Property="BorderBrush" Value="#325850"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Padding" Value="6,0,5,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template" Value="{StaticResource GroupComboBoxTemplate}"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource GroupComboBoxItemStyle}"/>
            </Style>

        </ResourceDictionary>
    </comp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="197" MinWidth="197" x:Name="LeftRow"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TabControl x:Name="recogTypeTC" Grid.RowSpan="2" Style="{StaticResource TabControlStyle1}"  Background="#172422" Padding="0" BorderThickness="0" AllowDrop="True" DragDrop.DragEnter="TabControl_DragEnter" DragDrop.Drop="TabControl_Drop" PreviewKeyDown="img_PreviewKeyDown">
            <TabItem x:Name="textTI" Header="原文" Width="96.5" Style="{StaticResource TabItemStyle_Button}" Foreground="#FFEBC8" Background="#325850">
                <Border Margin="4 0 2 0" BorderBrush="#325850" BorderThickness="1">
                    <ScrollViewer x:Name="svTxt" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <comp:WatermarkTextBox x:Name="contentTxt"  WaterMark="请粘贴债券信息&#x000A;如: &#x000A;230210&#x000A;23国开03&#x000A;21光明房产MTN001&#x000A;010504.SH&#x000A;(支持多支债券;不同债券需分行)" VerticalContentAlignment="Top"
                             BorderThickness="0" Background="#0C0F0E" Foreground="#FFEBC8" FontWeight="SemiBold"
                             AcceptsReturn="True" TextWrapping="Wrap"></comp:WatermarkTextBox>
                    </ScrollViewer>
                </Border>
               

            </TabItem>
            <TabItem x:Name="ImageTI" Header="图片" Width="96.5" Style="{DynamicResource TabItemStyle_Button}" Visibility="{Binding ParserImageVisibility}">
                <Image  x:Name="img"  Focusable="True" Stretch="None"  AllowDrop="True" DragDrop.DragEnter="TabControl_DragEnter" DragDrop.Drop="TabControl_Drop" PreviewKeyDown="img_PreviewKeyDown"/>
            </TabItem>
        </TabControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="4">
            <Button x:Name="btnClear" Width="80" Height="24" Style="{DynamicResource GrayButtonStyle}" 
                    Background="#4A4D4C" Foreground="#FFEBC8" FontWeight="SemiBold"
                    Click="btnClear_Click" BorderThickness="0 1 0 0" Margin="4 0 0 0">清除</Button>
            <Button x:Name="btnRecognize" Width="109" Height="24" Margin="4,0,0,0" Style="{DynamicResource GradientGreenButtonStyle}"
                        Click="btnRecognize_Click"  Foreground="#FFEBC8" FontWeight="SemiBold" BorderThickness="0 1 0 0">识别</Button>
        </StackPanel>

        <!--分割-->
        <GridSplitter x:Name="gridSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SelfVGridSplitterStyle2}" DragCompleted="gridSplitter_DragCompleted"/>

        <DataGrid x:Name="dg" Grid.Column="2" Grid.RowSpan="2" Margin="0 0 4 0"
                      ItemsSource="{Binding ViewSource.View}"
                      SelectedItem="{Binding SelectedItem_Recognize,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource DefaultDataGrid}" SelectionMode="Single" IsReadOnly="False"
                   LoadingRow="DataGrid_LoadingRow" 
                   UnloadingRow="DataGrid_UnloadingRow">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SelfDataGridColumnHeaderLeftStyle}">
                    <!--<Setter Property="Foreground" Value="#3B9078"/>
                    <Setter Property="Background" Value="#172422"/>-->
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="checkedColumn" MinWidth="40" Width="40" MaxWidth="40" HeaderStyle="{StaticResource SelfDataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="CheckBox_All"
                                                    IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Style="{StaticResource GreenDefaultCheckBoxStyle}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{StaticResource GreenDefaultCheckBoxStyle}"></CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="序号" Width="Auto" MinWidth="40" MaxWidth="80" IsReadOnly="True"  HeaderStyle="{StaticResource SelfDataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="No_TB" Text="{Binding No}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="#8F9598" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="代码" MinWidth="80" Width="100" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="SecurityIDTB" Text="{Binding SecurityId}" Foreground="#F9C152"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecurityId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="名称" MinWidth="80" Width="100" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Symbol" Text="{Binding Symbol}"  Foreground="#F9C152" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Symbol}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="剩余期限" Width="Auto" MinWidth="105" SortMemberPath="TimeToMaturity_Convert">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding TimeToMaturity}" FontWeight="SemiBold">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Text}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <Border x:Name="DayOff_Tag" BorderBrush="#C29B4E" BorderThickness="1" CornerRadius="2" Background="#C29B4E" Margin="2 0 0 0" >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="休" Background="Black" Foreground="#C29B4E" FontSize="10" FontWeight="Bold" Padding="1"/>
                                            <TextBlock Text="{Binding TimeToMaturityToWorkDay, Converter={StaticResource DaysOffCon}}" Grid.Column="1" Foreground="Black" FontSize="10" FontWeight="Bold" Padding="1"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding TimeToMaturityToWorkDay, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="DayOff_Tag" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="中债估值" Width="auto" MinWidth="80" SortMemberPath="CCDCValuation">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CCDCValuation,Converter={StaticResource numConvertor}}"  FontWeight="SemiBold"/>
                                <!--<Image x:Name="DataInfo" Source="/STC.Common;component/Images/icon 更多信息.png" Margin="10 0 0 0" Width="12" Height="12" Visibility="Collapsed" ToolTip="{Binding CCDCValuation_Date}"/>-->
                            </StackPanel>
                            <!--<DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowLastWorkDay}" Value="!">
                                    <Setter Property="Visibility" TargetName="DataInfo" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>-->
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>


        <Grid Grid.Row="3" Grid.Column="2">

            <TextBlock x:Name="CountStr" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8 0 0 0" FontSize="12" >
                <Run Foreground="#A0A0A0" Text="共计 "/><Run Foreground="#F9C152" Text="{Binding DataCount}"/><Run Foreground="#A0A0A0" Text=" 已选 "/><Run Foreground="#F9C152" Text="{Binding SelectedCount}"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                <TextBlock Text="添加至" Foreground="#8F9598" VerticalAlignment="Center"/>
                <ComboBox x:Name="groupCB" Width="96" Height="24" Style="{StaticResource GroupNonEditableComboBoxStyle}" Margin="4 0 0 0"
                          VerticalContentAlignment="Center" MaxDropDownHeight="300"
                          ItemsSource="{Binding GroupDic}" SelectedValuePath="GroupId" DisplayMemberPath="GroupName" SelectedItem="{Binding SelectedGroup,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Button x:Name="clear_button" Width="80" Height="24" Style="{DynamicResource GrayButtonStyle}" 
                    Background="#4A4D4C" Foreground="#FFEBC8" FontWeight="SemiBold" Click="clear_button_Click" BorderThickness="0 1 0 0" Margin="8 0 0 0">清空</Button>
                <Button x:Name="ok_button" Width="112" Height="24" Margin="4 0 4 0" Foreground="#FFEBC8" FontWeight="SemiBold"
                        Style="{DynamicResource GradientGreenButtonStyle}" Click="ok_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" BorderThickness="0 1 0 0">确定</Button>
            </StackPanel>
        </Grid>
    </Grid>
</comp:WindowBase>
