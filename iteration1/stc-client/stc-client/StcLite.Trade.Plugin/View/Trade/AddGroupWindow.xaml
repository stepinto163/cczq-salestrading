<comp:WindowBase x:Class="BDB.Trade.Plugin.View.Trade.AddGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Trade"
        xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Title="新增分组" Height="164" Width="316" ResizeMode="CanResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen" BorderThickness="1" BorderBrush="#136C5E"  Background="#171F1F">
    <comp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </comp:WindowBase.Resources>
    <Grid FocusManager.FocusedElement="{Binding ElementName=groupname_txt}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <TextBlock Text="分组名称: " VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16, 5, 0, 0"/>

        <TextBox x:Name="groupname_txt" Margin="16, 0, 16, 15" Height="24" Grid.Row="1" Style="{StaticResource  STCDefaultBoxStyle}" TextChanged="groupname_txt_TextChanged"/>

        <TextBlock x:Name="error_tb"  Grid.ColumnSpan="2" Grid.Row="0" Foreground="#E63034" VerticalAlignment="Top"  Margin="95,10,40,0"/>
        
        <Border Grid.ColumnSpan="2" Grid.Row="2" BorderBrush="#0A0F0E" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource Green2ButtonStyle}"
                        Click="btnOK_Click" IsDefault="True">确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</comp:WindowBase>
