<UserControl x:Class="BDB.Trade.Plugin.View.Trade.Card.BrokerPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Trade.Card"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="276" MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave" Margin="0, 0, 0, 0"
             BorderThickness="0, 0, 0, 1" BorderBrush="#263735"
             DataContextChanged="UserControl_DataContextChanged">

    <!--<UserControl.LayoutTransform>
        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
    </UserControl.LayoutTransform>-->
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <Style x:Key="BorderStyle" TargetType="Border">

                <Setter Property="Opacity" Value="0.5"/>

                <Style.Triggers>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>

                </Style.Triggers>
            </Style>
            

            <Style x:Key="BidBrokerBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BidBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BidBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="BidBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BidBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BidBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OfrBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OfrBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrCornorStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OfrBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_cornor_right.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OfrBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OfrBrokerBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OfrBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OfrBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- ToolTip Style -->
            <Style x:Key="BrokerToolTip" TargetType="ToolTip">
                <Setter Property="Background" Value="#21322F"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Grid>
                                <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                    <ContentPresenter ContentSource="Content"
                                              Margin="8,4,8,4"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Top"/>
                                </Border>
                                <Thumb x:Name="Thumb" Template="{x:Null}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


