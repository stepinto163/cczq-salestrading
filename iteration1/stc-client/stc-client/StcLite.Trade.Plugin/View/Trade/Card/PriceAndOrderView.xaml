                                </Button.Style>
                            </Button>

                            <Button x:Name="btnEdit" Grid.Column="2" Width="16" Height="16" Style="{StaticResource EditButtonStyle}" Visibility="{Binding PriceModel.EditVisibility}"
                                    Command="{Binding EditCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0, 0, 0, 8"></Button>

                            <Button x:Name="btnPop" Grid.Column="2" Width="16" Height="16" Style="{StaticResource PopButtonStyle}" Visibility="{Binding PriceModel.PopVisibility}"
                                    Command="{Binding PopCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0, 0, 0, 8"></Button>
                            <!--<Button x:Name="btnPop" Grid.Column="0" Width="16" Height="16" Style="{StaticResource PopButtonStyle}" Visibility="Collapsed"
                                    Command="{Binding PopCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5, 0, 0, 8"></Button>-->

                            <Button x:Name="btnDelete" Grid.Column="3" FontSize="{StaticResource FontSize-12}" Content="✕" Padding="0, 0, 3, 0"
                                    Style="{StaticResource CardDelteButtonStyle}"  Margin="0, 0, 0, 8" Command="{Binding DelteCommand}"
                                    Visibility="{Binding PriceModel.BondGridVisibility}" Width="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Height="16" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></Button>

                        </Grid>
                    </Border>

                    <!--<Button Width="80" Height="24" Content="+添加债券" Click="AddButton_Click" Visibility="{Binding PriceModel.AddBondVisibility}" Style="{StaticResource Green2ButtonStyle}"/>-->

                    <Comp:SearchEditUI x:Name="seSearch" Height="20" Margin="0, -3, 2, 2" Visibility="{Binding PriceModel.SearchVisibility}" 
                                       AfterDeleted="seSearch_AfterDeleted" 
                                       SearchChanged="SeSearch_SearchChanged" LostFocus="seSearch_LostFocus"></Comp:SearchEditUI>


                </Grid>

            </Border>


            <Grid Grid.Row="1" x:Name="BestExec" MouseLeftButtonDown="BestExec_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="8, -12, 2, 0" Visibility="{Binding PriceModel.BondGridVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" Margin="-2 -4 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding PriceModel.LastExecPriceBP}" Padding="3, 0, 3, 0" Foreground="{Binding PriceModel.LastExecBpBrush}" ToolTip="{Binding PriceModel.LastExecPriceBP_ToolTip}"
                               Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}"
                               FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}" VerticalAlignment="Center" 
                               Foreground="{Binding PriceModel.LastExecSideBrush}" 
                               Text="{Binding PriceModel.LastExecSideShow}" FontSize="12" Visibility="{Binding PriceModel.SettleVisibility}"
                               FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource TextBox.Static.Foreground}"
                               FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}" FontWeight="SemiBold" FontSize="11" Margin="4, 0, 0, 0"
                               Text="{Binding PriceModel.LastExecSource}" Visibility="{Binding PriceModel.SymbolNameVisibilly}">
                        <!--<TextBlock.LayoutTransform>
                            <ScaleTransform ScaleX="1.3" ScaleY="1.4"/>
                        </TextBlock.LayoutTransform>-->
                        </TextBlock>
                    </Grid>
                    
                    
                    <!--<TextBlock Text="{Binding PriceModel.LastExecPrice}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{StaticResource FontSize-22}"
                               Foreground="{StaticResource Textblock.Foreground.Red}" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}" FontWeight="Bold"/>-->

                    

                    <TextBlock Text="{Binding PriceModel.LastExecPrice}" Margin="0" Grid.Column="0" HorizontalAlignment="Left" 
                               VerticalAlignment="Center" FontSize="20"
                               Foreground="{Binding PriceModel.LastExecBpBrush}" FontFamily="{StaticResource Font.MicrosoftYaHei.Bold}" 
                               FontWeight="SemiBold"/>
                    
                </Grid>
                

                <!--<Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0, 4, 11, 2" Visibility="{Binding PriceModel.IndexVisibility}">-->
                <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="0, 4, 11, 2">
                    <!--<Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>-->

                    <Grid Visibility="{Binding PriceModel.OHLCVisibility}"  Margin="0, -12, -7, 0" >
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"></ColumnDefinition>
                            <ColumnDefinition Width="*" MinWidth="35"></ColumnDefinition>
                            <ColumnDefinition Width="Auto" MinWidth="2"></ColumnDefinition>
                            <ColumnDefinition Width="10"></ColumnDefinition>
                            <ColumnDefinition Width="*" MinWidth="35"></ColumnDefinition>
                            <ColumnDefinition Width="Auto" MinWidth="2"></ColumnDefinition>
                            <ColumnDefinition Width="10"></ColumnDefinition>
                            <ColumnDefinition Width="*" MinWidth="35"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="中债" Foreground="{StaticResource Gray-1}" FontSize="{StaticResource FontSize-11}" FontWeight="SemiBold" 
                                   Grid.Column="0" Grid.Row="0" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}" Visibility="{Binding PriceModel.FutureVisibility}"></TextBlock>
                        <TextBlock Grid.Column="1"  Grid.Row="0" Text="{Binding PriceModel.CDCValue}" MinWidth="30" Margin="2, 0, 0, 0" Foreground="{StaticResource Yellow-2}" 
                                   Width="48" FontSize="{StaticResource FontSize-11}" LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"
                                   Visibility="{Binding PriceModel.FutureVisibility}"></TextBlock>

                        <TextBlock Text="中证" Foreground="{StaticResource Gray-1}" FontSize="{StaticResource FontSize-11}" FontWeight="SemiBold" 
                                   Grid.Column="0"  Grid.Row="1" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}" Visibility="{Binding PriceModel.FutureVisibility}"></TextBlock>
                        <TextBlock Grid.Column="1"  Grid.Row="1" Text="{Binding PriceModel.CsiValue}" MinWidth="30" Margin="2, 0, 0, 0" Foreground="{StaticResource Yellow-2}"
                                   FontSize="{StaticResource FontSize-11}" LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"
                                   Visibility="{Binding PriceModel.FutureVisibility}"></TextBlock>

                        <TextBlock Text="昨" Foreground="{StaticResource Gray-1}" FontSize="{StaticResource FontSize-11}" FontWeight="SemiBold" 
                                   Grid.Column="3" Grid.Row="0" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>
                        <TextBlock Grid.Column="4"  Grid.Row="0" Text="{Binding PriceModel.PreClose}" MinWidth="30" Margin="2, 0, 0, 0" Foreground="{StaticResource Yellow-2}" 
                                   Width="48" FontSize="{StaticResource FontSize-11}" LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>


                        <TextBlock Text="高" Foreground="{StaticResource Gray-1}" FontSize="{StaticResource FontSize-11}" FontWeight="SemiBold" 
                                   Grid.Column="6"  Grid.Row="0" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>
                        <TextBlock Grid.Column="7"  Grid.Row="0" Text="{Binding PriceModel.High}" MinWidth="30" Margin="2, 0, 0, 0" Foreground="{StaticResource Yellow-2}"
                                   FontSize="{StaticResource FontSize-11}" LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>

                        <TextBlock Text="开" Foreground="{StaticResource Gray-1}" FontSize="{StaticResource FontSize-11}" FontWeight="SemiBold" 
                                   Grid.Column="3"  Grid.Row="1" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>
                        <TextBlock Grid.Column="4" Grid.Row="1" Text="{Binding PriceModel.OpenPrice}" MinWidth="30" Margin="2, 0, 0, 0" Foreground="{StaticResource Yellow-2}"
                                   FontSize="{StaticResource FontSize-11}" LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>


                        <TextBlock Text="低" Foreground="{StaticResource Gray-1}" FontSize="{StaticResource FontSize-11}" FontWeight="SemiBold" 
                                   Grid.Column="6" Grid.Row="1" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>
                        <TextBlock Grid.Column="7" Grid.Row="1" Text="{Binding PriceModel.Low}" MinWidth="30" Margin="2, 0, 0, 0" Foreground="{StaticResource Yellow-2}"
                                   FontSize="{StaticResource FontSize-11}" LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>

                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Visibility="Collapsed">

                        <TextBlock Text="今开" Foreground="{StaticResource Gray-1}" FontSize="{StaticResource FontSize-10}" 
                                   LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>
                        <TextBlock Text="{Binding PriceModel.OpenPrice}" MinWidth="30" Margin="2, 0, 0, 0" Foreground="{StaticResource Yellow-2}"
                                   Width="48" FontSize="{StaticResource FontSize-10}" LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"></TextBlock>
                        <TextBlock Text="昨结" Foreground="{StaticResource Gray-1}" LineHeight="16" FontWeight="SemiBold" FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}" FontSize="{StaticResource FontSize-10}"></TextBlock>
