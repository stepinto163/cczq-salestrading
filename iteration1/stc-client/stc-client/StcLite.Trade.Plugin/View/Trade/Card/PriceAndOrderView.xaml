<UserControl x:Class="BDB.Trade.Plugin.View.Trade.Card.PriceAndOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Trade.Card"
             xmlns:Comp="clr-namespace:BDB.Trade.Plugin.Component"
             xmlns:Trade="clr-namespace:BDB.Trade.Plugin.View.Trade"
             mc:Ignorable="d" 
             d:DesignHeight="372" d:DesignWidth="284" DataContextChanged="UserControl_DataContextChanged">
             <!--d:DesignHeight="366" d:DesignWidth="283">-->

    <!--<UserControl.LayoutTransform>
        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
    </UserControl.LayoutTransform>-->


    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ContextMenu x:Key="OrderContextMenu" Style="{StaticResource DefaultContextMenu}">
                <MenuItem x:Name="miSendPrice" Header="报价" Style="{StaticResource DefaultMenuItem}" Click="OrderMenuItme_Click"/>
            </ContextMenu>


            <Style x:Key="BidBrokerBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.BidBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                        <Setter Property="Height" Value="25"/>
                        <Setter Property="Width" Value="25"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriceModel.BidBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                        <Setter Property="Height" Value="25"/>
                        <Setter Property="Width" Value="25"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="OfrBrokerBargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.OfrBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="意向价"/>
                        <Setter Property="Height" Value="25"/>
                        <Setter Property="Width" Value="25"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriceModel.OfrBrokerBargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.Common;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                        <Setter Property="Height" Value="25"/>
                        <Setter Property="Width" Value="25"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>

        
    </UserControl.Resources>

    <!--<Border x:Name="bdFirst" CornerRadius="2" BorderThickness="2" BorderBrush="#28403C" Margin="2"
            Background="{StaticResource MainFrame.Background}">-->
    <Border x:Name="bdFirst" CornerRadius="2" BorderThickness="0" BorderBrush="{StaticResource Green-1}" Margin="2"
            Background="#172422">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
                <RowDefinition Height="{Binding PriceModel.BrokerConditionHeight}"></RowDefinition>
                <RowDefinition Height="{Binding PriceModel.BestPriceHeight}"></RowDefinition>
                <!--<RowDefinition Height="20"></RowDefinition>-->
                <RowDefinition Height="{Binding PriceModel.BrokerPriceShowHeight}"></RowDefinition>
                <!--<RowDefinition Height="180"></RowDefinition>-->
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>




            <Border x:Name="bdTitle" Grid.Row="0" Margin="8, 0, 4, 0" MouseLeftButtonDown="bdTitle_MouseLeftButtonDown">

                <Grid>
                    <Border x:Name="bdSecurity"  BorderThickness="0" MouseLeftButtonDown="Border_MouseLeftButtonDown" Visibility="{Binding PriceModel.BondGridVisibility}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="spTitle" Orientation="Horizontal" Grid.Column="0" MouseDown="Grid_MouseDown" MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave">
                                <TextBlock Grid.Column="0" Text="{Binding PriceModel.Security}" Foreground="#F9C152"
                                       Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" 
                                           FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}"
                                               FontWeight="Bold" LineHeight="24"
                                           FontSize="{StaticResource FontSize-17}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PriceModel.ToolTipTxt}">
                                </TextBlock>
                                <TextBlock Margin="8, 6, 0, 0" Grid.Column="1" Text="{Binding PriceModel.SymbolName}" Foreground="#F9C152"
                                       Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="{StaticResource FontSize-13}" FontWeight="Normal"
                                           FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}" LineHeight="24"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PriceModel.ToolTipTxt}"></TextBlock>
                                <TextBlock Margin="8, 7, 0, 2" Grid.Column="2" Text="{Binding PriceModel.RemainingTime}" Height="24" VerticalAlignment="Center" FontWeight="Normal"
                                       Foreground="{StaticResource Gray-1}" HorizontalAlignment="Left" FontSize="{StaticResource FontSize-13}" 
                                           FontFamily="{StaticResource Font.MicrosoftYaHeiSemibold}" Visibility="{Binding PriceModel.SymbolNameVisibilly}" LineHeight="24"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding PriceModel.ToolTipTxt}"></TextBlock>
                                <!--<Button x:Name="QBLinkBtn" Margin="2, 0, 0, 6" Click="QBLinkBtn_Click" Style="{StaticResource QBLinkButton}" Width="16" Height="16" Padding="2" VerticalAlignment="Center"/>-->

                            </StackPanel>

                            <Button x:Name="MsgBtn" Grid.Column="1" Width="16" Height="16" Visibility="{Binding PriceModel.MarketIndicatorVisibility}"
                                    Command="{Binding MsgCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5, 0, 0, 8">
                                <Button.Style>
