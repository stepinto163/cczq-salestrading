<UserControl x:Class="BDB.Trade.Plugin.View.Trade.Card.BrokerFillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View.Trade.Card"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="263">

    <UserControl.Resources>

        <Style x:Key="CbRoundAllStyle"
           TargetType="CheckBox">
            <Setter Property="Width"
                Value="60" />
            <Setter Property="Height"
                Value="22" />
            <Setter Property="Background"
                Value="#172422" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Name="border"
                            CornerRadius="2"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter Name="content"
                                          ContentSource="Content"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          TextBlock.FontSize="12"
                                          TextBlock.Foreground="#FFEBC8" />
                        </Border>
                        <!--<ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="#FF9200" />
                            <Setter TargetName="content"
                                    Property="TextBlock.Foreground"
                                    Value="#000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>-->
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    
    
    
    
    <Grid Margin="5,0" Visibility="Visible" x:Name="gdTitle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32*" />
            <ColumnDefinition Width="58*" />
            <ColumnDefinition Width="58*" />
            <ColumnDefinition Width="58*" />
            <ColumnDefinition Width="58*" />
            <ColumnDefinition Width="58*" />
        </Grid.ColumnDefinitions>
        <CheckBox Content="All" x:Name="cbAll"
                              Background="#003F35"
                              Foreground="White"
                              Style="{StaticResource CbRoundAllStyle}" Width="Auto" Height="Auto" />

        <CheckBox Content="国际" Grid.Column="1" x:Name="Borker1" 
                              Foreground="White" 
                              Style="{StaticResource CbRoundAllStyle}" Width="Auto" Height="Auto" />

        <CheckBox Content="国利" Grid.Column="2" x:Name="Borker2" 
                              Foreground="White"
                              Style="{StaticResource CbRoundAllStyle}" Width="Auto" Height="Auto" />

        <CheckBox Content="中诚" Grid.Column="3" x:Name="Borker3"
                              Foreground="White"
                              Style="{StaticResource CbRoundAllStyle}" Width="Auto" Height="Auto" />

        <CheckBox Content="信唐" Grid.Column="4" x:Name="Borker4" 
                              Foreground="White"
                              Style="{StaticResource CbRoundAllStyle}" Width="Auto" Height="Auto" />

        <CheckBox Content="平安" Grid.Column="5" x:Name="Borker5" 
                              Foreground="White"
                              Style="{StaticResource CbRoundAllStyle}" Width="Auto" Height="Auto" />
    </Grid>
</UserControl>
