<UserControl x:Class="BDB.Trade.Plugin.View.HistoryDealsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View"
             xmlns:ViewModel="clr-namespace:BDB.Trade.Plugin.ViewModel" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" 
             xmlns:customeUI="clr-namespace:BDB.Trade.Plugin.CustomeUI"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:utils="clr-namespace:BDB.Trade.Plugin.Utils"
             xmlns:command ="clr-namespace:BDB.Trade.Plugin.Command"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1500" Initialized="UserControl_Initialized" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/TextBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="true"/>
            </Style>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" MouseEnter="ContentPresenter_MouseEnter">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="VenueColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Venues}" Value="ODM">
                        <Setter Property="Foreground" Value="{StaticResource Deal.XBond.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}" Value="TPSC">
                        <Setter Property="Foreground" Value="{StaticResource Deal.TPSC.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}" Value="CTTJ">
                        <Setter Property="Foreground" Value="{StaticResource Deal.CTTJ.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}" Value="CNEX">
                        <Setter Property="Foreground" Value="{StaticResource Deal.CNEX.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}" Value="CCTB">
                        <Setter Property="Foreground" Value="{StaticResource Deal.CCTB.ColorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Venues}" Value="PTCN">
                        <Setter Property="Foreground" Value="{StaticResource Deal.PTCN.ColorBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="textBlock" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="VGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{StaticResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <Rectangle Width="12" Height="1" Stroke="{StaticResource DefaultForegroup.ColorBrush}" Margin="0,2,0,2"/>
                                    <Rectangle Width="12" Height="1" Stroke="{StaticResource DefaultForegroup.ColorBrush}" Margin="0,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--CheckBox的样式-->
            <Style x:Key="SelfFilterListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!--<Setter Property="Padding" Value="0"/>-->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <!--<Setter Property="Padding" Value="10,0,10,0"/>-->
                <Setter Property="Width" Value="64"/>
                <Setter Property="Margin" Value="1, 0, 0, 1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="#172422" CornerRadius="2" BorderThickness="0, 1, 0, 0" VerticalAlignment="Center" Margin="1,0,0,0"  
                            BorderBrush="{StaticResource ListBoxItem.Normal.Border}"  Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}"
                            SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="Cp" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}"  TextElement.FontFamily="PingFang SC" 
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.MouseOver.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedActive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBoxItem.SelectedActive.Border}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource ListBoxItem.SelectedActive.Foreground}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--HistoryCombox-->
            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="templateRoot" SnapsToDevicePixels="true" Background="Transparent" BorderBrush="#515151" BorderThickness="0,0,0,0">
                                <Border x:Name="splitBorder" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0,0,2,0" HorizontalAlignment="Center" BorderThickness="0" BorderBrush="Transparent">
                                    <!--<TextBlock x:Name="arrow" Text="v" Foreground="{StaticResource TextBox.Static.Foreground}" Background="#172422" Padding="6, 3, 0, 0"></TextBlock>-->
                                    <Path  x:Name="arrow" Data="M 6,10 L 10,15 L 14,10" SnapsToDevicePixels="False"  Stroke="#788187" StrokeThickness="1"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--鼠标移过-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Stroke" TargetName="arrow" Value="#FFFFFF"/>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                </Trigger>
                                <!--<MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                    -->
                                <!--<Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>-->
                                <!--
                                </MultiDataTrigger>-->
                                <!--鼠标按下-->
                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter Property="Stroke" TargetName="arrow" Value="#788187"/>
                                    <Setter Property="Background" TargetName="templateRoot"  Value="#172422" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" TargetName="templateRoot" Value="#136C5E"/>
                                    <!--<Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>-->
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--Combox-->
            <Style TargetType="ComboBox" x:Key="HistoryCombox">
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="24"></Setter>
                            <Setter Property="MinWidth" Value="48"></Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextBox.Static.Foreground}"></Setter>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Back" Background="{StaticResource TextBox.MouseOver.Background}"  BorderThickness="0,0,0,0" Padding="6, 0, 0, 0">
                                            <ContentPresenter ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Left" ></ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                                <Setter TargetName="Back" Property="BorderThickness" Value="1"></Setter>
                                                <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="bdTextBox" IsReadOnly="True"  Grid.Column="0" BorderThickness="1, 1, 0, 1" BorderBrush="#193D37" Background="#172422" Text="{TemplateBinding Text}" Foreground="{StaticResource TextBox.Static.Foreground}" FontSize="12" Padding="0, 4, 0, 0">
                                </TextBox>
                                <Border x:Name="bdToggle" Grid.Column="1" BorderThickness="0, 1, 1, 1" BorderBrush="#193D37" Margin="0, 0, 0, 0" Background="#193D37" CornerRadius="0, 2, 2, 0">
                                    <ToggleButton x:Name="tbArrow" Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" ></ToggleButton>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" Background="#172422" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdTextBox" Property="Background" Value="#172422"></Setter>
                                    <Setter TargetName="bdToggle" Property="Background" Value="#172422"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <local:HistoryDealFilterPanel x:Name="historyDealsFilter" DealsFilterDicChanged="historyDealsFilter_FilterDicChanged"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ComboBox x:Name="comboBox" Margin="20,0,0,0" Width="105"  Height="24" 
                          VerticalAlignment="Center" SelectedIndex="0" 
                          Style="{DynamicResource HistoryCombox}"
                          SelectionChanged="comboBox_SelectionChanged" IsEditable="False">
                    <ComboBoxItem Content="BDB成交单号" Tag="1"/>
                    <ComboBoxItem Content="BDB订单号" Tag="2"/>
                    <ComboBoxItem Content="债券代码" Tag="3"/>
                    <ComboBoxItem Content="对手方" Tag="4"/>
                </ComboBox>
                <TextBox Width="130" Height="18" Padding="5, 0, 0, 0" 
                         Style="{StaticResource HistoryTextBoxStyle}" 
                         x:Name="textBox"
                         Margin="5,0"
                         KeyDown="textBox_KeyDown"
                         TextChanged="textBox_TextChanged"
                         input:TextCompositionManager.PreviewTextInput="textBox_PreviewTextInput"
                         input:TextCompositionManager.PreviewTextInputUpdate="textBox_PreviewTextInputUpdate"/>
                <Button x:Name="btnFullScreen" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource ExportButton}" Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" x:Name="Executions_dataGrid" Style="{StaticResource DefaultDataGridForQuery}"
                ItemsSource="{Binding ExecutionsDV,UpdateSourceTrigger=PropertyChanged}" 
                LoadingRow="Executions_dataGrid_LoadingRow" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" Header="序号" MinWidth="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="BDB成交单号" Width="4*" Binding="{Binding ExecID}"/>
                <!--<DataGridTextColumn Binding="{Binding Venues,Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues_exe'}" 
                                    Header="渠道" Width="2*" CellStyle="{StaticResource VenueColumnColorStyle}"/>-->
                <DataGridTemplateColumn  ClipboardContentBinding="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}"  Header="渠道" Width="Auto" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border  x:Name="SourceTraderBorder" BorderBrush="Transparent" Background="{StaticResource TPSC.ColorBrush}"  BorderThickness="1"  Width="40"  Height="16" CornerRadius="6">
                                <TextBlock x:Name="SourceTraderText" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Text="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venuesorder'}"  FontFamily="PingFang SC" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Venues}" Value="TPSC">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Venues}" Value="CTTJ">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Venues}" Value="CNEX">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Venues}" Value="CCTB">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Venues}" Value="PTCN">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                                    <Setter Property="BorderBrush" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--<DataGridComboBoxColumn ItemsSource="{x:Static ViewModel:HistoryDealsViewModel.VenuesItemSource}" 
                                                SelectedValueBinding="{Binding Venues}" 
                                                SelectedValuePath="Key" DisplayMemberPath="Value"  
                                                Header="渠道" Width="1.5*"/>-->
                <DataGridTextColumn Header="外部成交单号" Width="4*" Binding="{Binding ClOrdID}"/>
                <DataGridComboBoxColumn ItemsSource="{x:Static ViewModel:HistoryDealsViewModel.SideItemSource}" 
                                                SelectedValueBinding="{Binding Side}" 
                                                ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                SelectedValuePath="Key" DisplayMemberPath="Value"  
                                                Header="方向" Width="1.5*" CellStyle="{StaticResource ColumnColorStyle}" IsReadOnly="True"/>

                <DataGridTextColumn Binding="{Binding SecurityID}" Header="债券代码" Width="Auto" MinWidth="85" FontWeight="SemiBold" ClipboardContentBinding="{Binding SecurityID}" HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}" CellStyle="{StaticResource DataGridTextLeftStyle}"/>
                <DataGridTextColumn Binding="{Binding Symbol}" Header="债券简称" Width="Auto" MinWidth="85" FontWeight="SemiBold" ClipboardContentBinding="{Binding Symbol}"  HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}" CellStyle="{StaticResource DataGridTextLeftStyle}"/>

                <!--<DataGridTextColumn Header="成交价(%)" Width="2*" Binding="{Binding LastPx,StringFormat={}{0:N4}}" CellStyle="{StaticResource ColumnColorStyle}"/>-->
                <DataGridTextColumn Binding="{Binding LastPx, Converter={StaticResource numConvertor}}" Header="成交价(%)" Width="2.5*" CellStyle="{StaticResource ColumnColorStyle}"/>

                <DataGridTextColumn Header="净价" Width="2*" Binding="{Binding NetPrice, Converter={StaticResource numConvertor}}" FontWeight="SemiBold" SortMemberPath="NetPrice1" CellStyle="{StaticResource ColumnColorStyle}"/>


                <DataGridTextColumn Header="成交量(万元)" Width="2*"  Binding="{Binding LastQty}"  CellStyle="{StaticResource DataGridTextCenterStyle}"/>
                <DataGridTextColumn Header="交易日期" Width="2*" Binding="{Binding TradeDate,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}"  CellStyle="{StaticResource DataGridTextCenterStyle}" />

                <DataGridTextColumn Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                                    ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                                    Header="清算速度" Width="Auto" MinWidth="70">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridTextCenterStyle}">
                            <Setter Property="ToolTip" Value="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>


                <DataGridTemplateColumn Header="对手方" Width="3*" ClipboardContentBinding="{Binding CounterPartyName}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPartyName}" TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="对手交易员" Width="1.5*" ClipboardContentBinding="{Binding CounterPartySubName}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPartySubName}" TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="成交时间" Width="2*" Binding="{Binding ExecutionTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}"  CellStyle="{StaticResource DataGridTextCenterStyle}"/>
                <DataGridTemplateColumn Header="同步状态" Width="2*" ClipboardContentBinding="{Binding SyncStatus, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='synchflag'}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock x:Name="syncStatusTB" Text="{Binding SyncStatus, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='synchflag'}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SyncStatus}" Value="C">
                                    <Setter TargetName="syncStatusTB" Property="Foreground" Value="#FB943C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SyncStatus}" Value="S">
                                    <Setter TargetName="syncStatusTB" Property="Foreground" Value="#E63034"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="全价(元)" Width="Auto" MinWidth="80" Binding="{Binding DirtyPrice,StringFormat={}{0:N4}}"/>-->
                
                <!--<DataGridTextColumn Header="结算金额(元)" Width="Auto" MinWidth="80" Binding="{Binding DeliveryAmount,StringFormat={}{0:N2}}"/>
                
                <DataGridTextColumn Header="成交编号" Width="Auto" MinWidth="150" Binding="{Binding ExecID}"/>
                
                <DataGridTextColumn Header="本方交易员" Width="Auto" MinWidth="80" Binding="{Binding PartySubName}"/>-->
                <!--<DataGridTextColumn Header="创建日期" Binding="{Binding createDate,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}"
                                         Width="2*" MinWidth="70"/>-->
                <DataGridTextColumn Header="BDB订单号" Width="4*" Binding="{Binding StrategyOrderId}"  CellStyle="{StaticResource DataGridTextCenterStyle}"/>
                <DataGridTextColumn Header="对手订单号" Width="4*" Binding="{Binding RefOrderID}"  CellStyle="{StaticResource DataGridTextCenterStyle}"/>
                <DataGridTextColumn Header="备注" Width="2*" Binding="{Binding Remark}"  CellStyle="{StaticResource DataGridTextCenterStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
        <customeUI:PageControl x:Name="pageControl" Grid.Row="2" HorizontalAlignment="Right" 
                               PageChanged="pageControl_PageChanged" 
                               Visibility="{Binding PageVisible,Converter={StaticResource visibilityConvertor}}"/>

        <fUI:LoadingMask x:Name="loadMask" Visibility="Collapsed" Grid.RowSpan="3" Grid.Row="0"></fUI:LoadingMask>
    </Grid>
</UserControl>
