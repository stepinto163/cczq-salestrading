<UserControl x:Class="BDB.Trade.Plugin.View.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.View"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="1200" 
        Background="#282828" DataContextChanged="UserControl_DataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/RadioButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" MouseEnter="ContentPresenter_MouseEnter">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="textBlock" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <RadioButton x:Name="ordersRB" 
                             Style="{StaticResource BoxRadioButton}" Margin="5,0,5,0" 
                             IsChecked="True"
                             Click="ordersRB_Click">历史需求</RadioButton>
                <RadioButton x:Name="dealsRB" 
                             Style="{StaticResource BoxRadioButton}" 
                             Margin="0,0,5,0"
                             Click="dealsRB_Click">历史已成</RadioButton>
                <RadioButton x:Name="messagesRB" 
                             Style="{StaticResource BoxRadioButton}" Margin="0,0,5,0"
                             Click="messagesRB_Click">历史消息</RadioButton>
            </StackPanel>
            <Button Grid.Column="2" x:Name="PopupBtn" Style="{StaticResource PopupButton}" HorizontalAlignment="Right" Width="12" Height="12"/>
            <!--Command="{x:Static utils:CommonUtils.PopupWindowCommand}" CommandParameter="{x:Static command:PopupTypeEnum.HistoryRecords}"/>-->
        </Grid>
        <Frame Name="historyFrame" NavigationUIVisibility="Hidden" Grid.Row="1">
            <Frame.Content>
                <Grid>
                </Grid>
            </Frame.Content>
        </Frame>
        <!--<TabControl Grid.Row="1" x:Name="tabControl" Background="#141414"  BorderThickness="0" >
            --><!--我的订单--><!--
            <TabItem x:Name="Orders_TabItem" Header="历史订单" Visibility="Collapsed">
                <local:HistoryOrderView/>
            </TabItem>
            <TabItem x:Name="Deals_TabItem" Header="历史成交" Visibility="Collapsed">
                <local:HistoryDealsView/>
            </TabItem>
            <TabItem Header="风控记录" Visibility="Collapsed">
                <local:HistoryRiskView/>
            </TabItem>
            <TabItem Header="历史消息" Visibility="Collapsed">
                <local:HistoryMsgView/>
            </TabItem>
            <TabItem Header="历史代办" Visibility="Collapsed">
                <local:HistoryAgencyView/>
            </TabItem>
        </TabControl>-->
    </Grid>
</UserControl>
