<UserControl x:Class="BDB.Trade.Plugin.CustomUI.MsgDetailUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.CustomUI"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="360">

    <UserControl.Resources>
        <ResourceDictionary>


            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NoticeUrgebtButton" TargetType="Button">
                <Setter Property="Width" Value="50" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_urgebt_noraml.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_urgebt_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_urgebt_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoticeWarntButton" TargetType="Button">
                <Setter Property="Width" Value="50" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_warning_normal.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_warning_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_warning_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoticeNormalButton" TargetType="Button">
                <Setter Property="Width" Value="50" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_normal_normal.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_normal_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_iamge_noticewidget_normal_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Name="TabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Width" Value="100"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Background" Value="Transparent"/>
                <!--<Setter Property="Foreground" Value="#FFEBC8"/>-->
                <Setter Property="Margin" Value="0, 0, 0, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <!--Width="120px" Height="30px"  Background="#21322F" Foreground="#FFEBC8"-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid>
                                <Border x:Name="Border"  Margin="0" Background="Transparent"  CornerRadius="2,2,2,2" BorderThickness="0" >
                                    <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Center" 
                                                  ContentSource="Header" 
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                   Margin="0,0,0,5"
                                                  
                                                  RecognizesAccessKey="True">
                                        <ContentPresenter.LayoutTransform>
                                            <RotateTransform Angle="0" />
                                        </ContentPresenter.LayoutTransform>
                                    </ContentPresenter>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Border" Property="BorderThickness" Value="1"/>-->
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource ColorBrush.Black8}"></Setter>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ColorBrush.Red7}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource ColorBrush.White2}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <!--<Setter Property="Panel.ZIndex" Value="100"/>-->
                                    <!--<Setter TargetName="Border" Property="TextBlock.Foreground" Value="#6E2022">-->
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                                    <!--<Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FFA200" Offset="0"/>
                                                <GradientStop Color="#F76B1C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>-->
                                    <!--</Setter>-->
                                    <!--<Setter Property="Foreground" Value="#FFEBC8"/>-->
                                    <!--<Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2" />-->
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Background" Value="Silver"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="Black" />
                                    -->
                                <!--<Setter Property="Foreground" Value="#FFEBC8"/>-->
                                <!--
                                </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0, 3, 0, 0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Background}"
                                    BorderThickness="1">

                                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Green}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <!--<Setter Property="AutoGenerateColumns" Value="False"/>-->
                <!--<Setter Property="BorderThickness" Value="0"/>-->
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <!--<Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>-->
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" >
                            <Setter Property="BorderThickness" Value="0"/>
                            <!--<Setter Property="ToolTipService.ToolTip" Value="{Binding ToolText}"/>-->
                            <Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{Binding ShowBorderBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="20"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="lbCondition" Margin="10, 10, 0, 10" Grid.ColumnSpan="2" Grid.Column="0" HorizontalAlignment="Left"
                          Grid.Row="0"           
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Height="26" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         FontSize="12"              
                         SelectionMode="Single"
                         VerticalAlignment="Bottom" 
                         BorderBrush="Transparent"   
                         SelectionChanged="lbCondition_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem x:Name="lbAll" Width="60" Height="20" IsSelected="True" Style="{StaticResource ListBoxItemStyle}" Content="全部"/>
            <ListBoxItem x:Name="lbUrgent" Width="60" Height="20"  Style="{StaticResource ListBoxItemStyle}" Content="紧急" />
            <ListBoxItem x:Name="ofrThree" Width="60" Height="20" Style="{StaticResource ListBoxItemStyle}" Content="重要"/>
            <ListBoxItem x:Name="ofrFour" Width="60" Height="20"  Style="{StaticResource ListBoxItemStyle}" Content="一般" />
        </ListBox>

        <Button x:Name="btnbatchClear" Click="btnbatchClear_Click" Content="批量清除" Width="60" Height="19 " Margin="0, 0, 20, 0" FontSize="12" Background="#136C5E" Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}"
                Grid.Column="1" HorizontalAlignment="Right"></Button>


        <Button x:Name="btnHistory" Style="{StaticResource ImageTimeButton}" Click="btnHistory_Click" Visibility="Collapsed" Grid.Column="1" Width="15" Height="15" HorizontalAlignment="Right"></Button>

        <DataGrid x:Name="dgMsg" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" MouseDoubleClick="DgMsg_MouseDoubleClick" MouseUp="dgMsg_MouseUp"
                                  Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0" HeadersVisibility="None" Margin="0, 0, 0, 0"
                  ScrollViewer.CanContentScroll="True" AllowDrop="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="False"
                   ItemsSource="{Binding}"
                 Style="{StaticResource DataGridStyle}"
                                  >
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding ShowBG}" Margin="0, 1 , 0, 0" Height="Auto">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition Height="{Binding CloseByHeight}"></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition Height="30"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="73"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel  Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                                        <Ellipse x:Name="elli" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4 ,10, 0, 0" Width="5" Visibility="{Binding ReadMsgVisible}"  Height="5" Fill="#11A0FF" />
                                        <TextBlock Text="{Binding HeaderTitle}" Margin="6, 10, 0, 0" HorizontalAlignment="Left" FontSize="{StaticResource SmallContentFontSize}" Foreground="{Binding MsgForegroundBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  FontWeight="{Binding MsgFontWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <TextBlock Visibility="{Binding UpdateTimeVisibility}" Text="{Binding UpdateTime}" Grid.Column="1" Grid.Row="0" Margin="0, 10, 10, 0" Foreground="{StaticResource ColorBrush.Gray14}"  FontSize="10">
                                    </TextBlock>
                                    <!--<TextBlock Grid.ColumnSpan="2" HorizontalAlignment="Right" Visibility="{Binding TimeOutTxtVisibility}" Grid.Column="1" Grid.Row="0" Margin="0, 10, 10, 0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="10">
                                    
                                        <Run Text="倒计时" Foreground="{StaticResource ColorBrush.Gray14}"></Run>
                                        <Run Text="{Binding TimeOutTxt}" Foreground="{StaticResource ColorBrush.Red7}"/>

                                    </TextBlock>-->

                                    <Border Grid.ColumnSpan="2" HorizontalAlignment="Right" Visibility="{Binding TimeOutTxtVisibility}" Grid.Column="1" Grid.Row="0" Margin="0, 5, 20, 0" CornerRadius="2" 
                                            Background="{StaticResource ColorBrush.Gray22}" MinWidth="40">
                                        <TextBlock TextAlignment="Right" Visibility="{Binding TimeOutTxtVisibility}" Padding="0, 2,2,0">
                            
                                            <Run Text="{Binding TimeOutTxt}" Foreground="{StaticResource ColorBrush.Red16}" FontSize="22" FontWeight="Bold"></Run>
                                            <Run Text="s" Foreground="{StaticResource ColorBrush.Red7}"/>

                                        </TextBlock>
                                    </Border>



                                    <TextBlock Text="{Binding CloseBy}" Visibility="{Binding CloseByVisibility}" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" FontSize="{StaticResource SmallContentFontSize}" Foreground="{StaticResource ColorBrush.While}"
                                                               FontWeight="Bold" Margin="10, 5, 0, 0" />
                                    <TextBlock Text="{Binding Content}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" HorizontalAlignment="Left" FontSize="{StaticResource SmallContentFontSize}" Foreground="{Binding MsgForegroundBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                               FontWeight="{Binding MsgFontWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="10, 3, 3, 0" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Content}"/>
                                    <Grid Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Margin="0, 0, 10, 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding StatusWidth}"></ColumnDefinition>
                                            <ColumnDefinition Width="101"></ColumnDefinition>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition Width="Auto" MinWidth="60"></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Status}" Width="{Binding StatusWidth}" Visibility="Collapsed" Grid.Column="0" Grid.Row="0" FontSize="{StaticResource SmallContentFontSize}"
                                                                   Margin="10, 3, 0, 0" Foreground="{Binding ShowStatusBG}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding ValueTime}" Width="101" Visibility="{Binding ValueTimeVisibility}" Grid.Column="1" Grid.Row="0" Foreground="{StaticResource ColorBrush.PaleGrey}" FontSize="{StaticResource SmallContentFontSize}"
                                                                    HorizontalAlignment="Left"/>


                                        <Button x:Name="btnPopDeal" Command="{Binding DataContext.PopKnowCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" 
                                            HorizontalAlignment="Left" Grid.Column="3" Grid.Row="0" Click="BtnPopDeal_Click"
                                            Margin="0 , 0, 12, 3" Width="20" Height="20" Style="{StaticResource MainPageNoticeKnowButton}" Visibility="{Binding PopDealVisibility}">
                                            <Button.ToolTip>
                                                <ToolTip Content="快速成交" Background="{StaticResource ColorBrush.Gray15}" Height="24" Foreground="{StaticResource ColorBrush.white}" 
                                                    FontSize="10"></ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button x:Name="btnPopKnow" Command="{Binding DataContext.PopKnowCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" 
                                            HorizontalAlignment="Right" Grid.Column="3" Grid.Row="0" Click="btnKnow_Click"
                                            Margin="0 , 0, 12, 3" Width="20" Height="20" Style="{StaticResource MainPageNoticeCloseButton}" Visibility="{Binding PopRefuseVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <Button.ToolTip>
                                                <ToolTip Content="拒绝" Background="{StaticResource ColorBrush.Gray15}" Height="24" Foreground="{StaticResource ColorBrush.white}" 
                                                    FontSize="10"></ToolTip>
                                            </Button.ToolTip>
                                        </Button>


                                        <Button x:Name="btnBDBKnow" Visibility="{Binding BDBVisiblitity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding BtnShowTxt}" Grid.Column="3" Grid.Row="0" Margin="0 , 0, 2, 3"  Width="60" Height="20" 
                                                                Click="btnKnow_Click" Foreground="{StaticResource ColorBrush.While}" Style="{StaticResource SmallCancelBtnStyle}"/>
                                        <Button x:Name="btnKnow" Visibility="{Binding KnowVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding BtnShowTxt}" Grid.Column="3" Grid.Row="0" Margin="0 , 0, 2, 3"  Width="60" Height="20" 
                                                                Click="btnKnow_Click" Foreground="{StaticResource ColorBrush.While}" Style="{StaticResource SmallCancelBtnStyle}"/>

                                        <Button x:Name="btnCopy" Content="复制" Visibility="{Binding BDBVisiblitity}" Margin="2, 0, 2, 3" 
                                                                Click="btnCopy_Click" Foreground="{StaticResource ColorBrush.While}" Width="60" Height="18" Grid.Column="4" Grid.Row="0" Style="{StaticResource SmallConfirmBtnStyle}"/>

                                        <Button x:Name="btnOpenBook" Content="行情小窗" Visibility="{Binding BDBVisiblitity}" Margin="2, 0, 2, 3" 
                                                                Click="btnOpenBook_Click" Foreground="{StaticResource ColorBrush.While}" Width="60" Height="18" Grid.Column="5" Grid.Row="0" Style="{StaticResource SmallConfirmBtnStyle}"/>

                                        <Button x:Name="btnDeal" Content="{Binding BtnDealShowTxt}" Visibility="{Binding DealVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2, 0, 2, 3" 
                                                                Click="btnDeal_Click" Foreground="{StaticResource ColorBrush.While}" Width="60" Height="18" Grid.Column="6" Grid.Row="0" Style="{StaticResource SmallConfirmBtnStyle}"/>

                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>
