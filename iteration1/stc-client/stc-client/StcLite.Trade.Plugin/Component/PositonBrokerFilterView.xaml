<UserControl x:Class="BDB.Trade.Plugin.Component.PositionBrokerFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.Component"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="365">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="lbBroker" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="LbBroker_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate>
                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ControlTemplate>
            </ListBox.Template>
            <ListBoxItem Content="全部" MinWidth="55" x:Name="All"  Visibility="Visible" Tag="ALL" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True" />
            <ListBoxItem Content="国利" Tag="TPSC" MinWidth="55" Visibility="Collapsed" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="国际" Tag="CNEX" MinWidth="55" Visibility="Collapsed" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="中诚" Tag="CCTB" MinWidth="55" Visibility="Collapsed" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="平安" Tag="PTCN" MinWidth="55" Visibility="Collapsed" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="信唐" Tag="CTTJ" MinWidth="55" Visibility="Collapsed" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
        </ListBox>
    </Grid>
</UserControl>
