<UserControl x:Class="BDB.Trade.Plugin.Component.SearchEditUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.Component"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="300">
    <UserControl.Resources>

        <ControlTemplate x:Key="CloseButtonTemplate"
                         TargetType="Button">
                <Border CornerRadius="2"
                    Background="#904804">
                    <Label Padding="0"
                       Margin="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                        <Label.Content>
                        <Image Source="/STC.Common;component/Images/005.png"
                               Width="9"
                               Height="9" />
                        </Label.Content>
                    </Label>
                </Border>
            </ControlTemplate>

            <VisualBrush x:Key="HintPositionText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 0, 0, 0" HorizontalAlignment="Stretch" Width="300" VerticalAlignment="Stretch" Background="#0B0C0C" FontSize="12" Foreground="#3C3C3C" Text="请输入代码"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <ControlTemplate x:Key="navSearchTextBox"
                         TargetType="TextBox">
                <Border Name="Border"
                    Background="#FF9300"
                    BorderBrush="#FF9300"
                    CornerRadius="2"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Margin="5,-0,5,0"
                                  Grid.Column="0"
                                  BorderThickness="0"
                                  VerticalAlignment="Stretch"
                                  x:Name="PART_ContentHost" />
                        <Button Name="btDelete"
                            Grid.Column="1"
                            Margin="5,0"
                            Width="12"
                            Height="12"
                            Visibility="Collapsed"
                            Template="{StaticResource CloseButtonTemplate}"
                            Click="Button_Click">
                        </Button>

                    </Grid>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="#3C3C3C"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="true"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Border" Property="Background" Value="{StaticResource HintPositionText}"/>
                    </MultiTrigger>

                    <Trigger Property="IsMouseOver" Value="true">
                        <Setter TargetName="Border" Property="BorderBrush" Value="#FF9300"/>
                    </Trigger>

                    <Trigger Property="IsKeyboardFocused" Value="true">
                        <Setter TargetName="Border" Property="BorderBrush" Value="#FF9300"/>
                        <Setter TargetName="Border" Property="Background" Value="#FF9300"/>
                    </Trigger>

                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsKeyboardFocused" Value="false"/>
                        <Condition Property="Text" Value=""/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Border" Property="Background" Value="{StaticResource HintPositionText}"/>

                    <Setter TargetName="Border" Property="BorderBrush" Value="#193D37"/>
                    <Setter TargetName="Border" Property="Background" Value="#0A0F0E"/>

                </MultiTrigger>


            </ControlTemplate.Triggers>

            </ControlTemplate>

            <ControlTemplate x:Key="GridVScrollThumb2"
                         TargetType="{x:Type Thumb}">
                <Grid Name="grid"
                  Background="Transparent">
                    <Rectangle Name="rect"
                           Width="4"
                           Height="auto"
                           MinHeight="30"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Fill="#136C5E"
                           RadiusX="2"
                           RadiusY="2"
                           Margin="0,0" />
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="GridVScrollBar2"
                         TargetType="{x:Type ScrollBar}">
                <Border Background="Transparent"
                    Width="{TemplateBinding Width}"
                    Padding="0"
                    Margin="0,0,0,0">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track"
                           Focusable="False"
                           Margin="0"
                           ViewportSize="NaN"
                           IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                   Margin="0"
                                   Padding="0"
                                   Template="{StaticResource GridVScrollThumb2}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </Border>
            </ControlTemplate>

            <ControlTemplate x:Key="OnlyVScrollViewerTemplate"
                         TargetType="ScrollViewer">
                <Grid x:Name="Grid"
                  Background="{TemplateBinding Background}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                    </Grid.ColumnDefinitions>

                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        CanHorizontallyScroll="False"
                                        CanVerticallyScroll="False"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Content="{TemplateBinding Content}"
                                        Grid.Column="0"
                                        Margin="{TemplateBinding Padding}" />
                    <ScrollBar x:Name="PART_VerticalScrollBar"
                           AutomationProperties.AutomationId="VerticalScrollBar"
                           Cursor="Arrow"
                           Grid.Column="1"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           Minimum="0"
                           Margin="-4,0,0,0"
                           Width="8"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Template="{DynamicResource GridVScrollBar2}" />
                </Grid>
            </ControlTemplate>

            <Style x:Key="SearchListBoxStyle"
               TargetType="ListBox">
                <!--<Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Grid>
                            <Border CornerRadius="10"
                                    x:Name="Bd"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="1"
                                    SnapsToDevicePixels="true">
                                <ScrollViewer Focusable="false"
                                              Padding="{TemplateBinding Padding}"
                                              Template="{DynamicResource ScrollViewerControlTemplate1}">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>-->
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid Name="grid"
                              Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90*" />
                                    <ColumnDefinition Width="90*" />
                                    <ColumnDefinition Width="60*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0">
                                    <TextBlock Foreground="#FFEBC8"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Margin="0"
                                           Text="{Binding Prefix}" />
                                    <TextBlock Foreground="#F9C152"
                                           FontSize="12"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="0"
                                           Text="{Binding KeyWord}" />
                                    <TextBlock Foreground="#FFEBC8"
                                           FontSize="12"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="0"
                                           Text="{Binding Suffix}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,0">
                                    <TextBlock Foreground="#FFEBC8"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Margin="0"
                                           Text="{Binding Sn_Prefix}"/>
                                    <TextBlock Foreground="#F9C152"
                                           FontSize="12"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="0"
                                           Text="{Binding Sn_KeyWord}"/>
                                    <TextBlock Foreground="#FFEBC8"
                                           FontSize="12"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="0"
                                           Text="{Binding Sn_Suffix}"/>
                                </StackPanel>
                                <Label Grid.Column="2"
                                   Padding="0"
                                   Margin="0,0,0,0"
                                   FontSize="12"
                                   Foreground="#FFEBC8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Content="{Binding LeftTenor}" />
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

    </UserControl.Resources>
    <Grid>
        <TextBox x:Name="navSearch"
                 Margin="0" Height="24"
                 TextChanged="navSearch_TextChanged"
                 Template="{StaticResource navSearchTextBox}"
                 Background="Transparent"
                 FontSize="14"
                 FontFamily="MicrosoftYaHeiSemibold"
                 FontWeight="Bold"
                 VerticalContentAlignment="Center"
                 Foreground="#000000" 
                 Text=""
                
                 VerticalAlignment="Center"
                 PreviewKeyDown="navSearch_PreviewKeyDown"
                 GotFocus="NavSearch_GotFocus"
                 LostFocus="navSearch_LostFocus"/>

        <!--CharacterCasing="Upper"-->
        <local:NonTopmostPopup x:Name="navSearchPopup"
                    IsTopmost="False"
               StaysOpen="False"
               Placement="Bottom"
               Margin="0,0,0,0"
               Width="{Binding ActualWidth, ElementName=navSearch}"
                MinWidth="245"            
               PlacementTarget="{Binding ElementName=navSearch}">
            <Grid SnapsToDevicePixels="True">
                <Border Margin="0,0,0,0"
                        BorderThickness="0"
                        Background="#193D37"/>
                <ListBox x:Name="navSearchListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.ScrollChanged="navSearchListBox_ScrollChanged"
                         SelectionChanged="navSearchListBox_SelectionChanged"
                         MouseLeftButtonUp="navSearchListBox_MouseLeftButtonDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Style="{StaticResource SearchListBoxStyle}"
                         MaxHeight="156">
                    <ListBox.Resources>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Template"
                                    Value="{StaticResource OnlyVScrollViewerTemplate}" />
                        </Style>
                        <Style x:Key="{x:Type ListBoxItem}"
                               TargetType="ListBoxItem">
                            <Setter Property="SnapsToDevicePixels"
                                    Value="true" />
                            <Setter Property="OverridesDefaultStyle"
                                    Value="true" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Name="Border"
                                                Padding="3,3"
                                                SnapsToDevicePixels="true">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     SourceName="Border"
                                                     Value="true">
                                                <Setter TargetName="Border"
                                                        Property="Background"
                                                        Value="#224F48" />
                                            </Trigger>
                                            <Trigger Property="IsSelected"
                                                     Value="true">
                                                <Setter TargetName="Border"
                                                        Property="Background"
                                                        Value="#224F48" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                </ListBox>
            </Grid>
        </local:NonTopmostPopup>
    </Grid>
</UserControl>
