<UserControl x:Class="BDB.Trade.Plugin.Component.BrokerFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.Component"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="365" SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <ListBox x:Name="lbBroker" Background="Transparent" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" SelectionMode="Single" 
                 SelectionChanged="LbBroker_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate>
                    <WrapPanel Background="{TemplateBinding Background}" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ControlTemplate>
            </ListBox.Template>
            <ListBoxItem Content="All" x:Name="All"  Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True" />

            <ListBoxItem Content="国利" Visibility="Visible" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="国际" Visibility="Visible" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="中诚" Visibility="Visible" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="平安" Visibility="Visible" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="信唐" Visibility="Visible" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="上田" Visibility="Visible" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
        </ListBox>
    </Grid>
</UserControl>
