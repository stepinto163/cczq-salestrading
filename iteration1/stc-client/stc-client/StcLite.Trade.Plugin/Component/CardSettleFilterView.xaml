<UserControl x:Class="BDB.Trade.Plugin.Component.CardSettleFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BDB.Trade.Plugin.Component"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="210">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/StcLiteSkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BDB/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <ListBox x:Name="lbSettle" Margin="2, 0, 0, 0" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="LbSettle_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate>
                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ControlTemplate>
            </ListBox.Template>
           
            <ListBoxItem Content="+0" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="+1"  Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="远"  Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="全" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True" />
        </ListBox>
    </Grid>
</UserControl>
