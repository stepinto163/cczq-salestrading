<UserControl x:Class="STC.Rfq.Plugin.View.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Rfq.Plugin.View"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:homepage ="clr-namespace:STC.Rfq.Plugin.View.HomePage"
             xmlns:conv="clr-namespace:STC.Rfq.Plugin.Convertor" 
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common" Initialized="MM_MainView_Initialized"
             DataContextChanged="MM_MainView_DataContextChanged"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--字体-->
            <FontFamily x:Key="Font.MicrosoftYaHei">Microsoft YaHei</FontFamily>
            <FontFamily x:Key="Font.MicrosoftYaHei.Bold">MicrosoftYaHei-Bold</FontFamily>
            <FontFamily x:Key="Font.MicrosoftYaHeiSemibold">MicrosoftYaHeiSemibold</FontFamily>
            <!--字体大小-->
            <SolidColorBrush x:Key="BorderBrush" Color="#282828"></SolidColorBrush>
            <SolidColorBrush x:Key="GridBackGround" Color="#0A0F0E"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockForeColor" Color="#FFFFFF"></SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ColorBrush.Orange6" Color="#FF963D"></SolidColorBrush>
            <SolidColorBrush x:Key="ColorBrush.Blue8" Color="#009AFF"></SolidColorBrush>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!--<ColumnDefinition Width="8"/>-->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        
         <homepage:HomePageTabControl x:Name="GroupTabControl" Grid.Row="1" Grid.Column="0" Background="#141414" BorderBrush="#282828" Tag="100" SelectionChanged="GroupTabControl_SelectionChanged">
        </homepage:HomePageTabControl>

