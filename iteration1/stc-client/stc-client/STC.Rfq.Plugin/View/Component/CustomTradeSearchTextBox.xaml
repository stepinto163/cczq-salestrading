<UserControl x:Class="STC.Rfq.Plugin.View.Component.CustomTradeSearchTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Rfq.Plugin.View.Component"
             mc:Ignorable="d" 
             d:DesignHeight="18" d:DesignWidth="120"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Mm.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Mm.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mm.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mm.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <!-- 搜索文本框 -->
            <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{StaticResource SearchTextBox.Backgroud.ColorBrush}"/>
                <Setter Property="Width" Value="375"/>
                <Setter Property="FontFamily" Value="MicroSoft YaHei"/>
                <Setter Property="Foreground" Value="{StaticResource TextBox.Focus.Foreground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <!--<Setter Property="FocusVisualStyle" Value="{x:Null}"/>-->
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="1" BorderThickness="1" Padding="6, 0, 0, 0" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <!--<Setter TargetName="border" Property="Background" Value="#172422"/>-->
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#FF7D00"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="false"/>
                                        <Condition Property="Text" Value=""/>
                                    </MultiTrigger.Conditions>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{StaticResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <TextBox x:Name="SearchTermTextBox" BorderBrush="#0A0F0E" Style="{StaticResource SearchTextBoxStyle}" 
                 SelectionBrush="#009AFF"
                 VerticalContentAlignment="Center" 
                 MaxLength="60"
                 TextChanged="SearchTermTextBox_TextChanged"
                 PreviewKeyDown="tbSearch_PreviewKeyDown"
                 KeyDown="tbSearch_KeyDown"
                 GotFocus="tbSearch_GotFocus"
                 LostFocus="tbSearch_LostFocus"
                 input:TextCompositionManager.PreviewTextInput="tbTraderAInfoChange_PreviewTextInput"
                  input:TextCompositionManager.PreviewTextInputUpdate="tbTraderAInfoChange_PreviewTextInputUpdate"/>
        <TextBlock x:Name="HintTextBox" IsHitTestVisible="False" Text="搜索债券代码..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,-1,0,0" Foreground="{StaticResource TextBox.Static.Border}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchTermTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
        </TextBlock>
        <Popup x:Name="popBondCode" PlacementTarget="{Binding ElementName=SearchTermTextBox}" StaysOpen="False" MaxHeight="300"
                   PopupAnimation="Slide" AllowsTransparency="False">
            <Border BorderBrush="#282828" BorderThickness="1" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="搜索债券" FontSize="12" Background="{StaticResource DefaultBackgroup.ColorBrush}" Foreground="{StaticResource DefaultForegroup.ColorBrush}"/>
                    <!--{StaticResource DefaultBackgroup.ColorBrush}-->
                    <DataGrid x:Name="dgBondCode" Grid.Row="1"
                        ItemsSource="{Binding}" 
                        HeadersVisibility="None"
                        BorderThickness="0"       
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.CanContentScroll="True"
                        Margin="0" 
                        Width="360"
                        MouseUp="dgBondCode_MouseUp"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  >

                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Style>
                            <StaticResource ResourceKey="DefaultDataGrid"/>
                        </DataGrid.Style>
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Bond_ID}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Short_Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                              </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding RemaingingTime}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" 
                                                Foreground="{StaticResource DefaultForegroup.ColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" >
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>

            </Border>

        </Popup>

    </Grid>
</UserControl>
