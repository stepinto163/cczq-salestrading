                <DataGridTemplateColumn  Header="Ofr有效日期" Width="74" MinWidth="74">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock x:Name="textBlock" Text="{Binding validDateOfr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding validDateOfr}" Value="">
                                    <Setter TargetName="textBlock" Property="Text" Value="不限"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Header="Ofr重发阈值" Width="74" MinWidth="74">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock x:Name="textBlock" Text="{Binding resendThresholdOfr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextTrimming="CharacterEllipsis" Foreground="#D7D7D7">
                                </TextBlock>
                                <TextBlock x:Name="textunit" Text=" bp"></TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding resendThresholdOfr}" Value="">
                                    <Setter TargetName="textBlock" Property="Text" Value="--"/>
                                    <Setter TargetName="textunit" Property="Text" Value=""/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding resendThresholdOfr}" Value="0">
                                    <Setter TargetName="textBlock" Property="Text" Value="--"/>
                                    <Setter TargetName="textunit" Property="Text" Value=""/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding resendThresholdOfr}" Value="0.0000">
                                    <Setter TargetName="textBlock" Property="Text" Value="--"/>
                                    <Setter TargetName="textunit" Property="Text" Value=""/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>



                <DataGridTemplateColumn Header="剩余期限" Width="90" MinWidth="90" MaxWidth="120" HeaderStyle="{StaticResource MMDataGridColumnHeaderCenterStyle}" SortMemberPath="RemaingingTime_convert">
