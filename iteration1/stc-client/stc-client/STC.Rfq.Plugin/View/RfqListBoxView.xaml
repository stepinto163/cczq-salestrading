<UserControl x:Class="STC.Rfq.Plugin.View.RfqListBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Rfq.Plugin.View"
             xmlns:comp ="clr-namespace:STC.Rfq.Plugin.View.Component"
             xmlns:homepage="clr-namespace:STC.Rfq.Plugin.View.HomePage"
             xmlns:conv="clr-namespace:STC.Rfq.Plugin.Convertor" 
             xmlns:viewmodel="clr-namespace:STC.Rfq.Plugin.ViewModel"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" Padding="0 4 0 0"
             FontSize="12"
             d:DesignHeight="562" d:DesignWidth="2000">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Rfq.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Rfq.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Rfq.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Rfq.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Rfq.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Rfq.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Rfq.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Rfq.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:MmStatusConvertor x:Key="MmStatusConvertor"/>
            <conv:MMQuoteTimeConvertor x:Key="MmQuoteTimeConvertor"/>
            <conv:NumberConvertor x:Key="numConvertor"/>
            <conv:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <conv:BooleanConvertor x:Key="BooleanConvertor"/>
            <!--<conv:MMStatusToolTipConverter x:Key="MMStatusToolTipConverter"/>-->

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="SwitchRadioButtonSytle" TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="#3C3C3C"/>
                <Setter Property="BorderBrush" Value="#3C3C3C"/>
                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                <Setter Property="Padding" Value="0"></Setter>
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="Height" Value="auto"></Setter>
                <Setter Property="SnapsToDevicePixels" Value="true"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid x:Name="grid"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  ClipToBounds="True" >
                                <Rectangle x:Name="ButtonStock"  Fill="{TemplateBinding Background}" Stroke="Gray"  RadiusX="1" RadiusY="1" Margin="0,0,0,0" StrokeThickness="0"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"  Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Grid>
                            <!--触发器：设置选中状态符号-->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <!--<Setter Property="BorderThickness" Value="0"/>-->
                                    <!--<Setter Property="BorderBrush" Value="#FF37A22D"/>-->
                                    <Setter Property="Background" Value="#136C5E"></Setter>
                                    <Setter Property="Foreground" Value="White"></Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Opacity" Value="0.6"></Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" TargetName="grid" ></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 居中 -->
            <Style x:Key="MMDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderCenterStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 1 0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="MMDataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderRightStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 1 0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="MMDataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 1 0"/>
            </Style>

            <!--<ContextMenu x:Key="settingColumnContextMenu" Style="{StaticResource DefaultContextMenu}">
                <MenuItem x:Name="settingColumn" Header="表头设置" Style="{StaticResource DefaultMenuItem}" Click="settingColumn_Click"/>
            </ContextMenu>-->

            <!--全撤-->
            <Style x:Key="SelfCancelButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#282828"/>
                <Setter Property="Foreground" Value="#D7D7D7"/>
                <Setter Property="BorderBrush" Value="#515151"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#1C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#515151"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#788187"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="#3C3C3C"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#515151"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HoverButton" TargetType="{x:Type comp:HoverButton}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type comp:HoverButton}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="{Binding CornerRadius,RelativeSource={RelativeSource Mode=TemplatedParent}}" BorderBrush="{TemplateBinding OutBorderBrush}" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="{Binding CornerRadius,RelativeSource={RelativeSource Mode=TemplatedParent}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="{Binding CornerRadius,RelativeSource={RelativeSource Mode=TemplatedParent}}" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{Binding HoverBackground,RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{Binding HoverBorderBrush,RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{Binding PressBackground,RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{Binding PressBorderBrush,RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource GrayButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource GrayButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource GrayButton.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="128"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0"  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Button x:Name="btn_AddBond" Width="80" Height="22" Grid.Column="0" Content="添加债券" Style="{StaticResource SelfCancelButton}" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="#D7D7D7"  Background="#282828" FontSize="12" FontWeight="SemiBold" FontFamily="MicroSoft YaiHei" Command="{Binding AddBondCommand}"/>
            <Button x:Name="btn_QuoteIdentify" Width="80" Height="22" Grid.Column="0" Content="识别文本" Style="{StaticResource SelfCancelButton}" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="#D7D7D7"  Background="#282828" FontSize="12" FontWeight="SemiBold" FontFamily="MicroSoft YaiHei" Command="{Binding QuoteIdentifyCommand}" Visibility="Collapsed"/>
            <Button x:Name="btn_Import" Width="80" Height="22" Grid.Column="0" Content="导入" Style="{StaticResource SelfCancelButton}" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="#D7D7D7"  Background="#282828" FontSize="12" FontWeight="SemiBold" FontFamily="MicroSoft YaiHei" Command="{Binding ImportCommand}"/>
            <Button x:Name="btn_Export" Width="80" Height="22" Grid.Column="0" Content="导出" Style="{StaticResource SelfCancelButton}" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="#D7D7D7"  Background="#282828" FontSize="12" FontWeight="SemiBold" FontFamily="MicroSoft YaiHei" Command="{Binding ExportCommand}"/>
        </StackPanel>
        <commComp:SearchTextBox x:Name="Search_TextBox" Grid.Column="1" SearchText="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"  Width="120" Height="18" FontSize="12" HorizontalAlignment="Right"/>

        <!--SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedIndex="{Binding SelectedIndex, Mode=OneWayToSource}"-->
        <commComp:ExDataGrid x:Name="MMListView" Grid.Row="1" Grid.ColumnSpan="2"
                  SelectedItem="{Binding SelectedStg}"  
                  ItemsSource="{Binding Mv.View}"
                  Style="{StaticResource DefaultDataGrid}"
                  ColumnHeaderStyle="{StaticResource MMDataGridColumnHeaderLeftStyle}" SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="60" Header="回复" HeaderStyle="{StaticResource MMDataGridColumnHeaderLeftStyle}" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!--<CheckBox x:Name="Selected_Chk" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"  Style="{StaticResource DefaultCheckBoxStyle}"  Margin="4 0 0 0"/>-->
                                <CheckBox x:Name="enableChk" IsChecked="{Binding enable,Mode=TwoWay,Converter={StaticResource BooleanConvertor}}"  Style="{StaticResource  SwitchMMCheckBoxStyle}" Height="16" Width="34" Foreground="#3C3C3C" 
                                          PreviewMouseLeftButtonDown="CheckBox_PreviewMouseLeftButtonDown" 
                                          Margin="4 0 0 0" IsTabStop="False"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RemainingTime}" Value="不可用">
                                    <Setter TargetName="enableChk" Property="IsEnabled" Value="false"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" >
                                <Button x:Name="configBtn"  Width="16" Height="16"  Margin="0,0,5,0" Style="{StaticResource MainPageImageSettingButton}"
                                        Command="{Binding DataContext.ConfigCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"  CommandParameter="{Binding id}"/>
                                <Button Foreground="#A0A0A0" Width="16" Height="16" Margin="0,0,5,0" ToolTip="删除" HorizontalAlignment="Center" Style="{StaticResource DeleteButton}"
                                        Click="del_btn_Click" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="代码" Width="90" MinWidth="90" MaxWidth="150" Binding="{Binding securityid}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="简称" Width="90" MinWidth="90" MaxWidth="200" Binding="{Binding symbol}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="清算速度" Width="90" MinWidth="90" MaxWidth="150" Binding="{Binding settltype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_rfq'}"/>
                
                <DataGridTemplateColumn  Header="有效方向" Width="42" MinWidth="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock x:Name="textBlock" Text="{Binding validSide, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding validSide}" Value="All">
                                    <Setter TargetName="textBlock" Property="Text" Value="不限"/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="#D7D7D7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding validSide}" Value="1">
                                    <Setter TargetName="textBlock" Property="Text" Value="Bid"/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding validSide}" Value="2">
                                    <Setter TargetName="textBlock" Property="Text" Value="Ofr"/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="{StaticResource ColorBrush.Blue}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Header="Bid重发阈值" Width="74" MinWidth="74">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock x:Name="textBlock" Text="{Binding resendThresholdBid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextTrimming="CharacterEllipsis" Foreground="#D7D7D7">
                                </TextBlock>
                                <TextBlock x:Name="textunit" Text=" bp"></TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding resendThresholdBid}" Value="">
                                    <Setter TargetName="textBlock" Property="Text" Value="--"/>
                                    <Setter TargetName="textunit" Property="Text" Value=""/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding resendThresholdBid}" Value="0">
                                    <Setter TargetName="textBlock" Property="Text" Value="--"/>
                                    <Setter TargetName="textunit" Property="Text" Value=""/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding resendThresholdBid}" Value="0.0000">
                                    <Setter TargetName="textBlock" Property="Text" Value="--"/>
                                    <Setter TargetName="textunit" Property="Text" Value=""/>
                                    <Setter TargetName="textBlock" Property="Foreground" Value="#4A4D4C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Header="Bid有效日期" Width="74" MinWidth="74">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock x:Name="textBlock" Text="{Binding validDateBid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding validDateBid}" Value="">
                                    <Setter TargetName="textBlock" Property="Text" Value="不限"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="我的Bid" Width="160" MinWidth="135" MaxWidth="200" HeaderStyle="{StaticResource MMDataGridColumnHeaderRightStyle}" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <TextBlock x:Name="textBlock" Text="我的Bid"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid x:Name="mybidParty" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label x:Name="priceLevelLabel" Grid.Column="0" Content="{Binding MyBidLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden"
                                           Foreground="#FFFFFF" FontSize="10" HorizontalContentAlignment="Left" Width="Auto"  VerticalAlignment="Center"/>
                                <Border x:Name="BestCFETS_ISResverse"  Grid.Column="1" Visibility="Collapsed" BorderThickness="1" BorderBrush="#9B2125" Background="#370F11"/>
                                <StackPanel Orientation="Horizontal"  Grid.Column="1" Margin="5,0,0,0">
                                    <Border x:Name="SourceTraderBorder" Height="16" Width="16"  VerticalAlignment="Center">
                                        <TextBlock x:Name="SourceTraderText" Foreground="{StaticResource DefaultForegroup.ColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="myBidQty" Grid.Column="0" Content="{Binding MyBidQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#FFFFFF" FontSize="10" HorizontalContentAlignment="Right" Width="Auto"  VerticalAlignment="Center"/>
                                        <TextBlock Text="kw" Grid.Column="1" Foreground="#FFFFFF" Height="Auto" Width="Auto"  Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="myBid" Grid.Column="1" Text="{Binding MyBid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource numConvertor}}" Foreground="#FB943C" FontSize="14" FontWeight="Bold" Margin="0,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding strategyTypeBid}" Value="Defend">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="#136C5E" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="防"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding strategyTypeBid}" Value="Algorithm">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="#136C5E" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="算"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding strategyTypeBid}" Value="API">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="#136C5E" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="接"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding strategyTypeBid}" Value="Manual">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="#B03131" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="手"/>
                                </DataTrigger>
                                <!--没有价格-->
                                <DataTrigger Binding="{Binding MyBid}" Value="100000000">
                                    <Setter TargetName="myBid" Property="Text" Value="--"/>
                                </DataTrigger>
                                <!--没有报量-->
                                <DataTrigger Binding="{Binding MyBidQty}" Value="0">
                                    <Setter TargetName="myBidQty" Property="Content" Value="--"/>
                                </DataTrigger>
                                <!--高亮-->
                                <DataTrigger Binding="{Binding MyBid_Highlight}" Value="1">
                                    <Setter TargetName="mybidParty" Property="Background" Value="#4CED6D00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMyBidDiffPx}" Value="1">
                                    <Setter TargetName="BestCFETS_ISResverse" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MyBidLevelVisible}" Value="1">
                                    <Setter TargetName="priceLevelLabel" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="我的Ofr" Width="160" MinWidth="135" MaxWidth="200" HeaderStyle="{StaticResource MMDataGridColumnHeaderLeftStyle}"  CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="textBlock" Text="我的Ofr" Margin="2,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid x:Name="myOfrParty" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="15"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BestCFETS_ISResverse" Grid.Column="0" Visibility="Collapsed" BorderThickness="1" BorderBrush="#9B2125" Background="#370F11"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,5,0">
                                    <TextBlock x:Name="myOfr" Grid.Column="1" Text="{Binding MyOfr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource numConvertor}}" Foreground="#58B3FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"  HorizontalAlignment="Right"/>
                                    <Grid HorizontalAlignment="Right">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Label x:Name="myOfrQty" Grid.Column="0" Content="{Binding MyOfrQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#FFFFFF" FontSize="10"  Width="Auto" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <TextBlock Text="kw" Grid.Column="1"  Foreground="#FFFFFF" Width="Auto" Margin="0,0,4,0"  FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Grid>
                                    <Border x:Name="SourceTraderBorder" Height="16" Width="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <TextBlock x:Name="SourceTraderText" Foreground="{StaticResource DefaultForegroup.ColorBrush}" VerticalAlignment="Center"  HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <Label x:Name="priceLevelLabel" Grid.Column="1" Content="{Binding MyOfrLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden"
                                           Foreground="#FFFFFF" FontSize="10" HorizontalContentAlignment="Right" Width="Auto"  VerticalAlignment="Center"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding strategyTypeOfr}" Value="Defend">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="#136C5E" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="防"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding strategyTypeOfr}" Value="Algorithm">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="#136C5E" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="算"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding strategyTypeOfr}" Value="API">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="#136C5E" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="接"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding strategyTypeOfr}" Value="Manual">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="#B03131" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="手"/>
                                </DataTrigger>
                                <!--没有价格-->
                                <DataTrigger Binding="{Binding MyOfr}" Value="100000000">
                                    <Setter TargetName="myOfr" Property="Text" Value="--"/>
                                </DataTrigger>
                                <!--没有报量-->
                                <DataTrigger Binding="{Binding MyOfrQty}" Value="0">
                                    <Setter TargetName="myOfrQty" Property="Content" Value="--"/>
                                </DataTrigger>
                                <!--高亮-->
                                <DataTrigger Binding="{Binding MyOfr_Highlight}" Value="1">
                                    <Setter TargetName="myOfrParty" Property="Background" Value="#4C0098FF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMyOfrDiffPx}" Value="1">
                                    <Setter TargetName="BestCFETS_ISResverse" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MyOfrLevelVisible}" Value="1">
                                    <Setter TargetName="priceLevelLabel" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
