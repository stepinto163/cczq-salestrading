                               Style="{StaticResource CommonCheckBoxStyle}"
                               Background="{StaticResource ColorBrush.Transparent}"                                               
                               Foreground="{StaticResource ColorBrush.While}"
                               HorizontalAlignment="Right"></CheckBox>
                    <TextBlock Text="当己方报价与市场最优点差&lt;=" Grid.Column="2" VerticalAlignment="Center" 
