                             ContextMenu="{x:Null}"                                                 
                             Text="{Binding BncMoniValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalAlignment="Center" VerticalAlignment="Center"                                                  
                             input:InputMethod.IsInputMethodEnabled="False" 
