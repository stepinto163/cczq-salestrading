                               FontSize="{StaticResource SmallContentFontSize}" 
                               Style="{StaticResource CommonCheckBoxStyle}"
                               Background="{StaticResource ColorBrush.Transparent}"                                               
                               Foreground="{StaticResource ColorBrush.While}"
                               HorizontalAlignment="Right"></CheckBox>
                    <TextBlock Text="当己方报价与市场最优点差&lt;=" Grid.Column="2" VerticalAlignment="Center" 
                               Foreground="{StaticResource ColorBrush.White2}" 
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Left"/>
                    <TextBox Margin="0, 0, 5, 0" 
                             Grid.Column="3" Grid.Row="0" Width="110" Height="20" 
                             IsEnabled="{Binding BcoMoniEnable}"                                                  
                             PreviewKeyDown="TextBox_PreviewKeyDown" 
                             ContextMenu="{x:Null}"                                                 
                             Text="{Binding BcoMoniValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             HorizontalAlignment="Center" VerticalAlignment="Center"                                                  
                             input:InputMethod.IsInputMethodEnabled="False" 
                             PreviewTextInput="TextBox_PreviewTextInput" 
                             BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray15}"                                             
                             Style="{StaticResource DefaultTextBoxStyle}" 
                             Background="{StaticResource ColorBrush.Black7}"                             
                             Foreground="{StaticResource ColorBrush.Yellow}" FontSize="12"></TextBox>

                    <TextBlock Grid.Column="4" Grid.Row="0" Text="bp时,背景高亮提醒" VerticalAlignment="Center" 
                               Foreground="{StaticResource ColorBrush.White2}" FontSize="12"/>
                </Grid>-->
            </Grid>
            <Grid  Grid.Row="1" Visibility="{Binding DealCloseEnable,UpdateSourceTrigger=PropertyChanged}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="策略报单出现成交后表现" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Bottom" Foreground="#788187" FontSize="14" FontWeight="Bold"/>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="154"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="dealCloseAllChk" 
                              IsChecked="{Binding DealCloseAll,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                              Style="{StaticResource  SwitchMMCheckBoxStyle}" Height="16" Width="34" Foreground="#3C3C3C" 
                              HorizontalAlignment="Left"
                              Margin="10 0 0 0" />
                    <TextBlock Grid.Column="1" Text="当前用户全部策略全撤全停" 
                               VerticalAlignment="Center" Foreground="{StaticResource ColorBrush.White2}"
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Left"/>
                    <Image Grid.Column="2" Source="/STC.Mm.Plugin;component/Images/MM_Warn.png" HorizontalAlignment="Left" Width="16" Height="16" Margin="1,0,0,0">
                        <Image.ToolTip>
                            <Grid>
                                <TextBlock FontSize="14"  TextWrapping="Wrap" Text="打开这一开关，如果当前用户的双&#13;边策略出现成交，当前用户所有双&#13;边策略自动关闭并撤单。"/>
                            </Grid>
                        </Image.ToolTip>
                    </Image>
                </Grid>
                <commComp:ExDataGrid x:Name="GroupListView" Grid.Row="2"
                          ItemsSource="{Binding DealCloseGroupObjs,UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DefaultDataGrid}" RowHeaderWidth="0" Margin="0 10 0 0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" MinWidth="150">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="分组内策略全撤全停" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="enableChk" 
                                                  IsChecked="{Binding DealCloseGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                                                  Style="{StaticResource  SwitchMMCheckBoxStyle}" 
                                                  Height="16" Width="34" Foreground="#3C3C3C" 
                                                  Margin="4 0 0 0" IsTabStop="False" 
                                                  IsEnabled="{Binding GroupCheckEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <!--<DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RemainingTime}" Value="不可用">
                                            <Setter TargetName="enableChk" Property="IsEnabled" Value="false"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>-->
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="分组名" Width="*" MinWidth="100" Binding="{Binding GroupName}"/>
                    </DataGrid.Columns>
                </commComp:ExDataGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
