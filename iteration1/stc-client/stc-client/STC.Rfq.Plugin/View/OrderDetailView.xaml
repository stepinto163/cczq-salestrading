                                    <CheckBox x:Name="algoBaseEnable_chk" Grid.Row="1" Grid.Column="9" Grid.ColumnSpan="2" Margin="0,0,0,0" Style="{StaticResource DefaultCheckBoxStyle}" Content="使用基准券" Foreground="#A0A0A0 " VerticalAlignment="Center" HorizontalAlignment="Left" 
                                    IsChecked="{Binding Data.algoBaseEnable, Converter={StaticResource booleanConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Padding="0,0,0,0" Click="algoBaseEnable_chk_Click"/>
                                    <comp:NoBtnSearchTextBox x:Name="bond_txt" Grid.Row="1" Grid.Column="10" Grid.ColumnSpan="2" Width="68" Height="24" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="#3C3C3C" Foreground="Red"
                                    SearchText="{Binding Data.algoBaseSecurityId, Mode =TwoWay, UpdateSourceTrigger=PropertyChanged}" AfterSearch="bond_txt_AfterSearch" ValueChanged="bond_txt_ValueChanged" HintText="" LostFocus="bond_txt_LostFocus" ListMarketFilter="CIB">
                                    </comp:NoBtnSearchTextBox>
                                    <!--算法报价-自定义-->
                                    <TextBox x:Name="algoMidPrice_tb" Tag="algoMidPrice"  Grid.Row="2" Grid.Column ="3" Grid.ColumnSpan="3" PreviewTextInput="TextBox_PreviewTextInput"  Width="60" Height="24" InputMethod.IsInputMethodEnabled="False"
                                            PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" HorizontalAlignment="Left" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" VerticalAlignment="Center"
                                            Foreground="#FFFFFF" BorderBrush="#3C3C3C" BorderThickness="1" ToolTip="输入范围：[0,1000]"
                                            Visibility="{Binding Data.algoMidPriceVisible, Converter={StaticResource visibilityConvertor}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="12" Focusable="True"  Text="{Binding Data.algoMidPrice,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MyDefaultTextBoxStyle}" TextChanged="TextBox_TextChanged">
                                    </TextBox>
                                    <!--参考中间价详情-->
                                    <TextBlock x:Name="algoMidDetail_tb" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="5" Foreground="#A0A0A0 " VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Visibility="{Binding Data.algoMidDetailVisible, Converter={StaticResource visibilityConvertor}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                           Width="Auto" Text="{Binding Data.algoMidDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Text, ElementName=algoMidDetail_tb}"/>
                                    <!--中债估值详情-->
                                    <TextBlock x:Name="algoCDCDetail_tb" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="5" Foreground="#A0A0A0 " VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Visibility="{Binding Data.algoCDCDetailVisible, Converter={StaticResource visibilityConvertor}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                           Width="Auto" Text="{Binding Data.algoCDCDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Text, ElementName=algoCDCDetail_tb}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="算法偏离" Foreground="#A0A0A0 " VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBox x:Name="algoDeviation_tb" Grid.Row="3" Grid.Column="5" Style="{StaticResource defaultBPTextBox}" 
                                         Foreground="#FFFFFF" BorderThickness="1" Width="60" HorizontalContentAlignment="Center" Height="24" TextChanged="TextBox_TextChanged" Focusable="True" 
                                         Tag="algoDeviation" VerticalAlignment="Center" HorizontalAlignment="Left" ContextMenu="{x:Null}" ToolTip="输入范围：[-1000.00，1000.00]"
                                         InputMethod.IsInputMethodEnabled="False"  Text="{Binding Data.algoDeviation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown">
                                    </TextBox>
                                    <TextBlock Grid.Row="3" Grid.Column="9" Grid.ColumnSpan="2" Margin="4,0,0,0" Text="算法点差" Foreground="#A0A0A0 " VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="algoSpread_tb" Grid.Row="3" Grid.Column="11" Style="{StaticResource defaultBPTextBox}" 
                                         Foreground="#FFFFFF" Padding="0,0,0,0" BorderThickness="1" Width="60" HorizontalContentAlignment="Center" Height="24" TextChanged="TextBox_TextChanged" Focusable="True" 
                                         Tag="algoSpread" VerticalAlignment="Center" HorizontalAlignment="Right" ContextMenu="{x:Null}" ToolTip="输入范围：(0，1000.00]。注意，点差必须大于0"
                                         InputMethod.IsInputMethodEnabled="False" Text="{Binding Data.algoSpread, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown">
                                    </TextBox>
                                </Grid>
                            </Border>

                            <!--接口报价-->
                            <Border BorderBrush="#282828" Grid.Row="4" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition  Width="56"/>
                                        <ColumnDefinition  Width="62"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="接口报价" Foreground="#D7D7D7"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="MicroSoft YaHei" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Bid" Foreground="#FB943C"  FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Height="Auto" Width="20"/>
                                    <TextBlock Grid.Row="0" Grid.Column="9" Text="Ofr" Foreground="#58B3FF "  FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="apiBid_tb" Grid.Row="0" Grid.Column="5" Text="{Binding Data.apiBid, Converter={StaticResource FormatDigitConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#FB943C " VerticalAlignment="Center" Margin="0,0,0,0" HorizontalAlignment="Left" Width="Auto"/>
                                    <TextBlock x:Name="apiOfr_tb" Grid.Row="0" Grid.Column="11" Text="{Binding Data.apiOfr, Converter={StaticResource FormatDigitConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#58B3FF " VerticalAlignment="Center" Margin="28,0,0,0" HorizontalAlignment="Left" Width="Auto"/>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="接口报量" Foreground="#A0A0A0"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Bid" Foreground="#FB943C"  FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" Height="Auto" Width="20"/>
                                    <TextBlock Grid.Row="1" Grid.Column="9" Text="Ofr" Foreground="#58B3FF "  FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="5"  HorizontalAlignment="Right" VerticalAlignment="Center" Width="Auto">
                                <Run Text="{Binding Data.apiBidQty, Converter={StaticResource FormatZeroConverter}}" Foreground="#A0A0A0" FontSize="12"></Run>
                                <Run Text="kw" Foreground="#A0A0A0"  FontSize="12"></Run>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="11"  HorizontalAlignment="Right" VerticalAlignment="Center" Width="Auto">
                                <Run Text="{Binding Data.apiOfrQty, Converter={StaticResource FormatZeroConverter}}" Foreground="#A0A0A0" FontSize="12"></Run>
                                <Run Text="kw" Foreground="#A0A0A0"  FontSize="12"></Run>
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="接口状态" Foreground="#A0A0A0"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="4" Text="{Binding Data.apiStatus, Converter={StaticResource FormatZeroConverter}}" Foreground="#A0A0A0"  FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </comp:ExtendedScrollViewer>
            </StackPanel>
            <!--确认取消按钮区域-->
            <Grid Grid.Row="2" Background="#1E1E1E">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"></ColumnDefinition>
                        <ColumnDefinition Width="62"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="160"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource SelfCancelButton}" Grid.Column="1" Width="60" Height="24" Content="取消" Foreground="#FFFFFF" Command="{Binding CancelBtnCommand}"/>
                    <Button Style="{StaticResource SendPriceButton}" Grid.Column="2" Width="100" Height="24" Content="确认" Foreground="#FFFFFF" Margin="4,0,0,0" Command ="{Binding ConfirmBtnCommand}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>

</Window>
