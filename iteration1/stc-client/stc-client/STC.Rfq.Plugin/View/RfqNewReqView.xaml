<Window x:Class="STC.Rfq.Plugin.View.RfqNewReqView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Rfq.Plugin.View"
        xmlns:Component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Title="请求回复" Height="392" Width="397"  WindowStartupLocation="CenterScreen" ResizeMode="NoResize" AllowsTransparency ="True"
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Deactivated="Window_Deactivated"
        Topmost="True"  BorderThickness="0" Background="Transparent"  BorderBrush="#0C4F44">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TextBlockForeColor" Color="#FFFFFF"></SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
            <!--文本框-->
            <SolidColorBrush x:Key="TextBox.Static.Border" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Static.Background" Color="#172422"/>
            <SolidColorBrush x:Key="TextBox.Static.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="TextBox.MouseOver.Foreground" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#FF9300"/>
            <SolidColorBrush x:Key="TextBox.Focus.Background" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="TextBox.Focus.Foreground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextBox.Disable.Border" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="TextBox.Disable.Background" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="TextBox.Disable.Foreground" Color="#A0A0A0"/>

            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBorder" Color="#136C5E"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBackground" Color="#193D37"></SolidColorBrush>

            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Border" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Border" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Foreground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Border" Color="#238F7E"/>
            <SolidColorBrush x:Key="ListBoxItem.Normal.Border" Color="#193D37"/>

            <SolidColorBrush x:Key="MainFormBackground" Color="#0A0F0E"/>
            <SolidColorBrush x:Key="LostFocusBorderBrush" Color="#282828"/>
            <SolidColorBrush x:Key="GetFocusBorderBrush" Color="#8F9598"/>


            <LinearGradientBrush x:Key="BidLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#56FF7D00" Offset="0"/>
                <GradientStop Color="#00FF7D00" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="OfrLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#56009AFF" Offset="0"/>
                <GradientStop Color="#00009AFF" Offset="1"/>
            </LinearGradientBrush>
            
            <!--数量和增加减少-->
            <Style TargetType="{x:Type Button}" x:Key="AddAmountButtonStyle">
                <Setter Property="Background" Value="{StaticResource LostFocusBorderBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LostFocusBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="2,2,0,0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="out_border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="out_border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <!--数量减少-->
            <Style TargetType="{x:Type Button}" x:Key="DecreaseAmountButtonStyle">
                <Setter Property="Background" Value="{StaticResource LostFocusBorderBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LostFocusBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="0,0,2,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="out_border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="out_border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--展开Button-->
            <Style x:Key="ExpandButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="FontFamily" Value="KaiTi"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="0" BorderBrush="#4C000000" BorderThickness="0,0,0,0" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="12,0,0,12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1.5,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#136C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#2CAB97 "/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource TextBlockForeground}"/>
                                    <Setter Property="TextElement.FontWeight" TargetName="contentPresenter" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource LightGrayButton.Pressed.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource LightGrayButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource LightGrayButton.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--取消-->
            <Style x:Key="SelfCancelButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#3C3C3C"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderBrush" Value="#515151"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#515151"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#788187"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="#3C3C3C"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#515151"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--价格和数量-->
            <Style x:Key="SelfSendPriceTextBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#0B0C0C"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextBox.Disable.Border}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{DynamicResource TextBox.Disable.Border}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="false"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=BorderBH,UpdateSourceTrigger=PropertyChanged}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="true"/>
                                        <Condition Property="Tag" Value="1"/>
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="BorderBrush"  Value="{Binding Path=BorderBH,UpdateSourceTrigger=PropertyChanged}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                    <Setter Property="SelectionBrush" Value="#0082D8"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="true"/>
                                        <Condition Property="Tag" Value="0"/>
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="BorderBrush"  Value="{Binding Path=BorderBH,UpdateSourceTrigger=PropertyChanged}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                    <Setter Property="SelectionBrush" Value="#0082D8"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            
            <!--报价或需求-->
            <Style x:Key="SendPriceButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#282828" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#136C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#2CAB97 "/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--报价有效时长输入框-->
            <Style x:Key="SendPriceTimeTextBox" TargetType="{x:Type Component:WatermarkTextBox}">
                <Setter Property="Background" Value="#172422"/>
                <Setter Property="BorderBrush" Value="#FF9300"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Component:WatermarkTextBox}">
                            <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    <TextBlock x:Name="Message" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#788187" Text="{TemplateBinding WaterMark}" Visibility="Hidden"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                                    <Setter TargetName="Message" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#172422"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9300"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#FF9300"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9300"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="PriceComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="splitBorder" Height="24" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0" HorizontalAlignment="Center"  BorderThickness="0" BorderBrush="Transparent">
                                <!--TextBlock x:Name="arrow" Text="v" Foreground="#788187" Background="Transparent" Padding="6, 3, 0, 0" FontFamily="Calibri" FontSize="14"/-->
                                <Path  x:Name="arrow" Data="M 6,10 L 10,15 L 14,10" SnapsToDevicePixels="False"  Stroke="#788187" StrokeThickness="1"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="arrow" Property="Stroke" Value="#FFEBC8"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </Style>

            <!--有效时长Combox-->
            <Style TargetType="ComboBox" x:Key="PriceComboBox">
                <Setter Property="Height" Value="24"></Setter>
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="IsReadOnly" Value="True"></Setter>
                <Setter Property="IsDropDownOpen" Value="False"></Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="24"></Setter>
                            <Setter Property="MinWidth" Value="56"></Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"></Setter>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="popBack" BorderBrush="#193D37" Background="#193D37" BorderThickness="0,0,0,1" CornerRadius="0">
                                            <Canvas>
                                                <ContentPresenter Canvas.Right="20" Canvas.Top="4"  ContentSource="{Binding Source}" ></ContentPresenter>
                                            </Canvas>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="popBack" Property="Background" Value="#136C5E"></Setter>
                                                <Setter TargetName="popBack" Property="BorderBrush" Value="#2CAB97"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Name="Back"  BorderBrush="#136C5E"  Background="#193D37" BorderThickness="0,1,0,0" CornerRadius="2">
                                    <Border Name="InerBack"  BorderBrush="#193D37"  Background="Transparent" BorderThickness="0,0,0,1"  CornerRadius="2">
                                        <Canvas>
                                            <TextBox x:Name="bdTextBox"  Canvas.Right="18"   Canvas.Top="4"  BorderThickness="0"  Background="Transparent" Text="{TemplateBinding Text}" Foreground="{StaticResource TextBlockForeground}" FontSize="12">
                                            </TextBox>
                                            <ToggleButton x:Name="tbArrow" Canvas.Right="1"  Canvas.Bottom="0"  Canvas.Top="0" Style="{StaticResource PriceComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"></ToggleButton>
                                        </Canvas>
                                    </Border>
                                </Border>
                                <Border>
                                    <TextBlock x:Name="bdTextBlock" MouseDown="bdTextBlock_MouseDown"></TextBlock>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="0,0,0,0" BorderThickness="0,0,0,0" Background="#172422" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#2CAB97"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="2"></Setter>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#136C5E"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#2CAB97"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#193D37"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="397"></ColumnDefinition>
            <ColumnDefinition Width="290"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--下单窗口-->
        <Grid  Background="Transparent" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="188"/>
                <RowDefinition Height="134"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>
            <!--标题区-->
            <Border BorderThickness="2,2,2,0" x:Name="Border_Left1" Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="{Binding BorderBrush}"  Background="{StaticResource LostFocusBorderBrush}">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="24"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" x:Name="TitleIcon" Stretch="Uniform" Height="28" Margin="0,-4,0,0"/>
                    <TextBlock  Grid.Column="1" x:Name="TopTitle" Text="{Binding TopTitle}" Foreground="#FFFFFF" FontSize="14" FontFamily="Microsoft YaiHei" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"></TextBlock>
                    <Button Width="18" Height="18" Grid.Column="2" Margin="0,0,-2,0" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
                </Grid>
            </Border>
            <!--价格区-->
            <Border Grid.Row="1" BorderThickness="2, 0, 2, 0" x:Name="Border_Left3" BorderBrush="{Binding BorderBrush}" Background="{StaticResource MainFormBackground}">
                <Grid  Background="{Binding BorderBG}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="124"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>
                    <!--价格区-->
                    <Border BorderThickness="0, 0, 0, 1" BorderBrush="#000000" Grid.Row="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="8"></RowDefinition>
                                <RowDefinition Height="30"></RowDefinition>
                                <RowDefinition Height="6"></RowDefinition>
                                <RowDefinition Height="24"></RowDefinition>
                                <RowDefinition Height="40"></RowDefinition>
                                <RowDefinition Height="11"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12"></ColumnDefinition>
                                <ColumnDefinition Width="128"></ColumnDefinition>
                                <ColumnDefinition Width="20"></ColumnDefinition>
                                <ColumnDefinition Width="114"></ColumnDefinition>
                                <ColumnDefinition Width="8"></ColumnDefinition>
                                <ColumnDefinition Width="100"></ColumnDefinition>
                                <ColumnDefinition Width="12"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock  Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" Margin="12, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18"  FontFamily="MicroSoft YaHei" FontWeight="Bold">
                                <!--<Run Text="{Binding RfqODD.SecurityID, Mode=TwoWay}"   Foreground="#F9C152"/>
                                <Run Text="{Binding RfqODD.Symbol, Mode=TwoWay}" Foreground="#F9C152"/>-->
                                <Component:CustomTradeSearchTextBox x:Name="Search_TextBox" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="1"
                                    SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Top"  BorderBrush="{StaticResource MainFormBackground}" Width="226"  Height="30"/>
                            </TextBlock>
                            

                            <TextBlock  Grid.Row="1"  Grid.Column="5" Margin="0, 0, 0, 0" Height="16" HorizontalAlignment="Left" FontSize="14"  Foreground="#F9C152"  FontFamily="MicroSoft YaHei" FontWeight="Medium">
                                <Run Text="请求量：" Foreground="{StaticResource TextBox.Disable.Foreground}" FontSize="12"/>
                                <Run Text="{Binding RfqODD.OrderQty2, Mode=TwoWay}"/>
                                <Run Text="kw"/>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal" Grid.Row="3"  Grid.Column="1">
                                <TextBlock Text="最优：" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource TextBox.Disable.Foreground}" FontFamily="MicroSoft YaHei"  FontSize="12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="2, 0, 0, 0">
                                    <TextBlock Text="{Binding SendPriceItem.BestBidInt}" Foreground="{StaticResource ColorBrush.Orange7}" Margin="0, 0, 0, 0" FontSize="12" FontWeight="Bold" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SendPriceItem.BestBidFloat}" Foreground="{StaticResource ColorBrush.Orange7}" FontSize="12" Margin="0,0,0,0" FontWeight="Bold" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  Margin="4, 0, 0, 0">
                                    <TextBlock Text="|" Foreground="#788187"  FontSize="12" TextAlignment="Center" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="2, 0, 0, 0">
                                    <TextBlock Text="{Binding SendPriceItem.BestOfrInt}" Foreground="{StaticResource ColorBrush.Blue8}" Margin="0, 0, 0, 0" FontSize="12" FontWeight="Bold" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SendPriceItem.BestOfrFloat}" Foreground="{StaticResource ColorBrush.Blue8}" Margin="0,0,0,0" FontSize="12" FontWeight="Bold" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="净价：" Grid.Row="3"  Grid.Column="3" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource TextBox.Disable.Foreground}" FontFamily="MicroSoft YaHei" FontSize="12"/>
                            <TextBlock Text="回复量：" Grid.Row="3"  Grid.Column="5" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource TextBox.Disable.Foreground}" FontFamily="MicroSoft YaHei" FontSize="12"/>
                            
                            <!--价格-->
                            <TextBox  Grid.Row="4" Grid.Column="1" x:Name="PriceTxt" Height="40"  Margin="0, 0, 0, 0" Padding="0,6,34,0" PreviewTextInput="TextBox_PreviewTextInput"  PreviewKeyDown="TextBox_PreviewKeyDown" 
                                     ContextMenu="{x:Null}"  FontSize="24" BorderThickness="1"  BorderBrush="{Binding BorderBH, Mode=TwoWay}" FontFamily="Roboto-Bold"
                                     Text="{Binding CustomPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelfSendPriceTextBox}" Foreground="White"  
                                     SelectionBrush="{Binding BorderBH, Mode=TwoWay}" TextAlignment="Right" Background="{StaticResource BackgroundBrush}"/>

                            <!--价格 + - -->
                            <Grid  Grid.Row="4" Grid.Column="1" Margin="99,1,0,1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"></RowDefinition>
                                    <RowDefinition Height="20"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Button x:Name="btnAddPrice"    Padding="0,0,0,0"  Margin="2,0,0,1" Grid.Row="0" Width="24" Height="20" Content="+" Command="{Binding AddPriceCommand}" Style="{StaticResource AddAmountButtonStyle}" FontSize="12"/>
                                <Button x:Name="btnReducePrice" Padding="0,0,0,0"  Margin="2,1,0,0"  Grid.Row="1" Width="24" Height="20" Content="-" Command="{Binding ReducePriceCommand}" Style="{StaticResource DecreaseAmountButtonStyle}"  FontSize="12"/>
                            </Grid>

                            <TextBlock x:Name="PriceTxtPercent" Grid.Row="4" Grid.Column="1" Text="%"  Foreground="{StaticResource ColorBrush.Gray14}"  Background="Transparent" FontSize="10" Margin="64, 24, 0, 0"  Width="10" Height="16"/>

                            <TextBlock Grid.Row="4" Grid.Column="2" Foreground="{StaticResource ColorBrush.While}"  Width="14" Height="14" Margin="-2,0,0,0" TextAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Background>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_icon_linked_normal.png"/>
                                </TextBlock.Background>
                            </TextBlock>
                            
                            <!--净价-->
                            <TextBox  Grid.Row="4" Grid.Column="3" x:Name="netPrice" Height="40"  Padding="0,6,0,0"
                                     ContextMenu="{x:Null}"  FontSize="24" BorderThickness="1"   BorderBrush="{Binding BorderBH, Mode=TwoWay}"  FontFamily="Roboto-Bold" PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown"
                                     Text="{Binding NetPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelfSendPriceTextBox}" Foreground="White"  
                                     SelectionBrush="{Binding BorderBH, Mode=TwoWay}" TextAlignment="Right" Background="{StaticResource BackgroundBrush}"/>
                           
                            <!--回复量-->
                            <TextBox  Grid.Row="4" Grid.Column="5" x:Name="AmountTxt" Height="40" Padding="0,6,30,0" FontFamily="Roboto-Bold"
                                     ContextMenu="{x:Null}"  FontSize="24" BorderThickness="1"  BorderBrush="{Binding BorderBH, Mode=TwoWay}" PreviewTextInput="TextBox_PreviewTextInput"  PreviewKeyDown="TextBox_PreviewKeyDown" 
                                     Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SelfSendPriceTextBox}" Foreground="White"  
                                     SelectionBrush="{Binding BorderBH, Mode=TwoWay}" TextAlignment="Center" Background="{StaticResource BackgroundBrush}"/>
                            
                            <!--量 + - -->
                            <Grid  Grid.Row="4" Grid.Column="5" Margin="72,1,0,1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"></RowDefinition>
                                    <RowDefinition Height="20"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Button  x:Name="btnAddAmout"     TabIndex="-1" Margin="2,0,0,1" Grid.Row="0" Width="24" Height="20" Content="+" Command="{Binding AddAmountCommand}"    Style="{StaticResource AddAmountButtonStyle}" FontSize="12"/>
                                <Button  x:Name="btnReduceAmout" TabIndex="-1" Margin="2,1,0,0" Grid.Row="1" Width="24" Height="20" Content="-" Command="{Binding ReduceAmountCommand}"  Style="{StaticResource DecreaseAmountButtonStyle}"  FontSize="12"/>
                            </Grid>
                            
                            <TextBlock Grid.Row="4"  Grid.Column="5" Margin="32,20,2,0" Width="16" Height="16" x:Name="AmountTxtKw" Text="kw"  Foreground="{StaticResource ColorBrush.Gray14}"  Background="Transparent" FontSize="12" />
                            
                        </Grid>
                    </Border>
                    <!--有效时长区-->
                    <Border BorderThickness="0, 0, 0, 1" BorderBrush="#000000" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="8"></RowDefinition>
                                <RowDefinition Height="24"></RowDefinition>
                                <RowDefinition Height="24"></RowDefinition>
                                <RowDefinition Height="12"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12"></ColumnDefinition>
                                <ColumnDefinition Width="222"></ColumnDefinition>
                                <ColumnDefinition Width="160"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="回复有效时长:" Grid.Row="1"  Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource TextBox.Disable.Foreground}" FontFamily="MicroSoft YaHei"  FontSize="12"/>
                            <TextBlock Text="请求有效时长:" Grid.Row="1"  Grid.Column="2" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource TextBox.Disable.Foreground}" FontFamily="MicroSoft YaHei"  FontSize="12"/>
                            
                            <TextBlock  Grid.Row="2"  Grid.Column="5" Margin="0, 0, 0, 0" Height="16" HorizontalAlignment="Left" FontSize="14"  Foreground="#F9C152"  FontFamily="MicroSoft YaHei" FontWeight="Medium">
                                <Run Text="{Binding RfqODD.ShowRemainSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </TextBlock>

                            <Grid Grid.Row="2" Grid.Column="1">
                                <StackPanel Orientation="Horizontal"  Grid.Column="0">
                                    <ComboBox x:Name="cbSettle2" Width="60"  Margin="0,0,0,0"  Height="24" Padding="4, 3, 0, 0" Style="{DynamicResource PriceComboBox}" SelectedIndex="0" IsEnabled="False">
                                        <ComboBoxItem Content="时长" Tag="2"></ComboBoxItem>
                                    </ComboBox>
                                    <!--时长-->
                                    <StackPanel Orientation="Horizontal" Height="24" Grid.Column="0"  Margin="6, 0, 0, 0"  Visibility="Visible">
                                        <Component:WatermarkTextBox WaterMark="" ContextMenu="{x:Null}" Tag="1" MaxLength="3" x:Name="ValidMinute" PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" Text="{Binding ValidMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputMethod.IsInputMethodEnabled="False" Width="24"  Height="24" BorderBrush="#193D37"  Padding="0, 0, 0, 0" Style="{StaticResource SendPriceTimeTextBox}">
                                            <TextBox.ToolTip>
                                                <ToolTip Content="输入范围:[0-500]分钟"></ToolTip>
                                            </TextBox.ToolTip>
                                        </Component:WatermarkTextBox>
                                        <TextBlock Grid.Row="0" Text="分" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                                        <Component:WatermarkTextBox  WaterMark="" ContextMenu="{x:Null}"  Margin="6,0,0, 0" Tag="3"  MaxLength="2"  x:Name="ValidSecond"   PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="24" Height="24"  BorderBrush="#193D37"  Padding="0, 0, 0, 0"  Style="{StaticResource SendPriceTimeTextBox}">
                                            <TextBox.ToolTip>
                                                <ToolTip Content="输入范围:[0-60)"></ToolTip>
                                            </TextBox.ToolTip>
                                        </Component:WatermarkTextBox>
                                        <TextBlock Grid.Row="0" Text="秒"  Height="16"  Margin="6, 0, 0, 0" HorizontalAlignment="Left" Grid.Column="0" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text=", 后失效" Margin="0, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <!--信息区-->
            <Border Grid.Row="2" BorderThickness="2, 0, 2, 0" x:Name="Border_Left4" BorderBrush="{Binding BorderBrush}" Background="{StaticResource MainFormBackground}">
                <Grid  Background="{Binding MainFormBackground}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"></RowDefinition>
                        <RowDefinition Height="24"></RowDefinition>
                        <RowDefinition Height="24"></RowDefinition>
                        <RowDefinition Height="16" ></RowDefinition>
                        <RowDefinition Height="24"></RowDefinition>
                        <RowDefinition Height="24"></RowDefinition>
                        <RowDefinition Height="8"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="12"></ColumnDefinition>
                        <ColumnDefinition Width="116"></ColumnDefinition>
                        <ColumnDefinition Width="106"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="12"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="对手方:" Grid.Row="1"  Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource GetFocusBorderBrush}" FontFamily="MicroSoft YaHei"  FontSize="12"/>
                    <TextBlock Text="对手方交易员:" Grid.Row="1"  Grid.Column="2" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource GetFocusBorderBrush}" FontFamily="MicroSoft YaHei"  FontSize="12"/>
                    <TextBlock Text="交易日期:" Grid.Row="1"  Grid.Column="3" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource GetFocusBorderBrush}" FontFamily="MicroSoft YaHei"  FontSize="12"/>
                    <TextBlock Text="渠道:" Grid.Row="4"  Grid.Column="1" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource GetFocusBorderBrush}" FontFamily="MicroSoft YaHei"  FontSize="12"/>
                    <TextBlock Text="结算方式:" Grid.Row="4"  Grid.Column="2" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource GetFocusBorderBrush}" FontFamily="MicroSoft YaHei"  FontSize="12"/>
                    <TextBlock Text="清算类型 / 速度:" Grid.Row="4"  Grid.Column="3" Margin="0,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="{StaticResource GetFocusBorderBrush}" FontFamily="MicroSoft YaHei"  FontSize="12"/>

                    <TextBlock  Grid.Row="2" Grid.Column="1" Margin="0, 2, 0, 0" Grid.RowSpan="2" Text="{Binding RfqODD.CounterPartyName, Mode=TwoWay}"   Foreground="#D7D7D7" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14"  FontFamily="MicroSoft YaHei" FontWeight="Bold" TextWrapping="Wrap">
                          
                    </TextBlock>

                    <TextBlock  Grid.Row="2" Grid.Column="2" Margin="0, 2, 0, 0" Grid.RowSpan="2" Text="{Binding RfqODD.CounterPartySubName, Mode=TwoWay}" Foreground="#D7D7D7" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14"  FontFamily="MicroSoft YaHei" FontWeight="Bold"  TextWrapping="Wrap">
                    </TextBlock>

                    <TextBlock  Grid.Row="2" Grid.Column="3" Margin="0, 2, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14"  FontFamily="MicroSoft YaHei" FontWeight="Bold">
                                <Run Text="{Binding RfqODD.TradeDate, Mode=TwoWay}"  Foreground="#D7D7D7"/>
                    </TextBlock>

                    <TextBlock  Grid.Row="5" Grid.Column="1" Margin="0, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14"  FontFamily="MicroSoft YaHei" FontWeight="Bold">
                                <Run Text="{Binding RfqODD.Venues,ConverterParameter=rfqvenues, Converter={StaticResource EnumTypeConvertor}}"   Foreground="#D7D7D7"/>
                    </TextBlock>

                    <TextBlock  Grid.Row="5" Grid.Column="2" Margin="0, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14"  FontFamily="MicroSoft YaHei" FontWeight="Bold">
                                <Run Text="{Binding RfqODD.DeliveryType,ConverterParameter=deliverytype, Converter={StaticResource EnumTypeConvertor}}"   Foreground="#D7D7D7"/>
                    </TextBlock>

                    <TextBlock  Grid.Row="5" Grid.Column="3" Margin="0, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14"  FontFamily="MicroSoft YaHei" FontWeight="Bold">
                        <Run Text="{Binding RfqODD.ClearingMethod, ConverterParameter=clearingmethod, Converter={StaticResource EnumTypeConvertor}}" Foreground="#D7D7D7"/>        
                        <Run Text=" / "   Foreground="#D7D7D7"/>
                        <Run Text="{Binding RfqODD.SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" Foreground="#D7D7D7"/>
                    </TextBlock>
                </Grid>
            </Border>
            <!--按钮区-->
            <Border Grid.Row="4" BorderThickness="2, 1, 2, 2" x:Name="Border_Left5" CornerRadius="0,0,4,4" BorderBrush="{Binding BorderBrush}" Background="{StaticResource MainFormBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition Width="60"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="60"></ColumnDefinition>
                            <ColumnDefinition Width="4"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="10"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Grid.Row="0" Margin="0,0,0,0" x:Name="btnCancel" Content="撤销" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding CancelOrderCommand}" FontSize="12"
                            Style="{DynamicResource SendPriceButton}" Foreground="{DynamicResource TextBlockForeground}" Width="60" Height="24"/>
                        
                        <Button Grid.Column="3" Grid.Row="0" Margin="0,0,0,0"  Content="取消" Command="{Binding CancelCommand}" FontSize="12" Foreground="{DynamicResource TextBlockForeground}" 
                            Style="{DynamicResource SelfCancelButton}"  Width="60" Height="24"/>
                        <Button Grid.Column="5" Grid.Row="0" Margin="0,0,0,0" x:Name="btnOk" Content="确定" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding ConfirmOrderCommand}" FontSize="12"
                            Style="{DynamicResource SendPriceButton}" Foreground="{DynamicResource TextBlockForeground}" Width="100" Height="24"/>

                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <!--展开-->
        <Button Margin="366,30,0,0" Content=">>" x:Name="btn_Expand" Tag="Collapsed" IsEnabled="False" Padding="6,-1,0,0"  Width="26" Height="24"  Style="{DynamicResource ExpandButton}"  Command="{Binding ExpandCommand}"  Foreground="{StaticResource TextBlockForeground}"/>
    </Grid>
</Window>
