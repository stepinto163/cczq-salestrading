                                <TextBlock Grid.Row="6" Grid.Column="5" Text="%" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>

                            </Grid>


                        </Border>
                    </StackPanel>
