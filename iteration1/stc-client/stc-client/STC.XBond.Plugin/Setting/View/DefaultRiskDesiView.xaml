                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="5" Text="%" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,5,0" Text="信用债:" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>
                                <CheckBox Grid.Row="4" Grid.Column="1"  
                                          IsChecked="{Binding DefaultRiskItem.CBidDefautlCheck, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"                                               
                                           VerticalAlignment="Center" Margin="0, 5, 0, 0" BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" Foreground="{StaticResource ColorBrush.While}" Content="默认" ></CheckBox>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="中债估值 Bid 最大偏离度 ≤  "  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" Margin="1,0,1,0" VerticalAlignment="Center"></TextBlock>
                                <TextBox Grid.Row="4" Grid.Column="3" Margin="2,0,0,0" PreviewTextInput="DeviationTextBox_PreviewTextInput" Style="{StaticResource RiskTextBox}" input:InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding DefaultRiskItem.CBid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource decimalConverter}}" Background="{StaticResource ColorBrush.Black9}"></TextBox>
                                <StackPanel Grid.Row="4" Grid.Column="4" Height="32" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="︿" Style="{StaticResource SignButton}"
                                                Command="{Binding AddCBidCommand}"/>
                                        <Button Grid.Row="2"  Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="﹀" Style="{StaticResource SignButton}"
                                                Command="{Binding DownCBidCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.Column="5" Text="%" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>

                                <CheckBox Grid.Row="6" Grid.Column="1" 
                                          IsChecked="{Binding DefaultRiskItem.COfrDefautlCheck, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"                                               
