                                <TextBlock Grid.Row="2" Grid.Column="2" Text="中债估值 Ofr 最大偏离度 ≤ "  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" Margin="1,0,1,0" VerticalAlignment="Center"></TextBlock>
                                <TextBox Grid.Row="2" Grid.Column="3" Margin="2,0,0,0" PreviewTextInput="DeviationTextBox_PreviewTextInput" Style="{StaticResource RiskTextBox}" input:InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding DefaultRiskItem.IOfr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource decimalConverter}}" Background="{StaticResource ColorBrush.Black9}"></TextBox>
                                <StackPanel Grid.Row="2" Grid.Column="4" Height="32" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="︿" Style="{StaticResource SignButton}"
