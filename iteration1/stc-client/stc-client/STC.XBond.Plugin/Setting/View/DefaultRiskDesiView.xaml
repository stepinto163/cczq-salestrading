                        <Border Grid.Column="1" Height="auto" BorderBrush="{StaticResource ColorBrush.Gray19}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="120"></ColumnDefinition>
                                    <ColumnDefinition Width="30"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="120"></ColumnDefinition>
                                    <ColumnDefinition Width="30"></ColumnDefinition>
                                    <ColumnDefinition Width="20"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"></RowDefinition>
                                    <RowDefinition Height="5"></RowDefinition>
                                    <RowDefinition Height="30"></RowDefinition>
                                </Grid.RowDefinitions>
                                <TextBlock  Text="单笔报价量:" Margin="0,0,5,0" Grid.Column="0" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>
                                <TextBox Margin="2,0,0,0" PreviewTextInput="TextBox_PreviewTextInput" Grid.Column="1" 
                                         Style="{StaticResource RiskTextBox}" input:InputMethod.IsInputMethodEnabled="False"
                                         Text="{Binding DefaultRiskItem.IQtyMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="{StaticResource ColorBrush.Black9}"
                                         ></TextBox>
                                <StackPanel Grid.Column="2" Height="32" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="︿" Command="{Binding AddCommand}" Style="{StaticResource SignButton}"/>
                                        <Button Grid.Row="2"  Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="﹀" Command="{Binding DownCommand}" Style="{StaticResource SignButton}"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="万 ≤ 利率债 ≤ "  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" Margin="1,0,1,0" VerticalAlignment="Center"/>

                                <TextBox Grid.Column="4" Margin="2,0,0,0" PreviewTextInput="TextBox_PreviewTextInput" Style="{StaticResource RiskTextBox}" input:InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding DefaultRiskItem.IQtyMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Black9}"></TextBox>

                                <StackPanel Grid.Column="5" Height="32" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="︿" Style="{StaticResource SignButton}"
                                                Command="{Binding AddIQtyMaxCommand}"/>
                                        <Button Grid.Row="2"  Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="﹀" Style="{StaticResource SignButton}"
                                                Command="{Binding DownIQtyMaxCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="万"  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="2,0,0,0" PreviewTextInput="TextBox_PreviewTextInput" Style="{StaticResource RiskTextBox}" input:InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding DefaultRiskItem.CQtyMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Black9}"></TextBox>
                                <StackPanel Grid.Row="2" Grid.Column="2" Height="32" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="︿" Style="{StaticResource SignButton}"
                                                Command="{Binding AddCQtyMinCommand}"/>
                                        <Button Grid.Row="2"  Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="﹀" Style="{StaticResource SignButton}"
                                                Command="{Binding DownCQtyMinCommand}"/>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="3" Text="万 ≤ 信用债 ≤ "  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>

                                <TextBox Grid.Row="2" Grid.Column="4" Margin="2,0,0,0" PreviewTextInput="TextBox_PreviewTextInput" Style="{StaticResource RiskTextBox}" input:InputMethod.IsInputMethodEnabled="False"
                                                    Text="{Binding DefaultRiskItem.CQtyMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ColorBrush.Black9}"></TextBox>
                                <StackPanel Grid.Row="2" Grid.Column="5" Height="32" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="︿" Style="{StaticResource SignButton}"
                                                Command="{Binding AddCQtyMaxCommand}"/>
                                        <Button Grid.Row="2"  Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="﹀" Style="{StaticResource SignButton}"
                                                Command="{Binding DownCQtyMaxCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="6" Text="万"  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
                <Rectangle Grid.Row="1" Width="auto" Margin="10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Height="1" Fill="{StaticResource Separator.ColorBrush}" />
                <Grid Grid.Row="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="估值偏离"  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.Gray14}" FontSize="10"></TextBlock>
