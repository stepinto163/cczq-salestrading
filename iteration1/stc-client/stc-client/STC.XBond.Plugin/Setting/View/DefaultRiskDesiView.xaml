                                <StackPanel Grid.Row="0" Grid.Column="4" Height="32" HorizontalAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
