                                <TextBox Margin="2,0,0,0" 
                                         Grid.Column="3" Style="{StaticResource RiskTextBox}" 
                                         input:InputMethod.IsInputMethodEnabled="False"
                                         Text="{Binding DefaultRiskItem.IBid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource decimalConverter}}" 
