                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="0"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="︿" Style="{StaticResource SignButton}"
                                                Command="{Binding AddCOfrCommand}"/>
                                        <Button Grid.Row="2"  Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="﹀" Style="{StaticResource SignButton}"
