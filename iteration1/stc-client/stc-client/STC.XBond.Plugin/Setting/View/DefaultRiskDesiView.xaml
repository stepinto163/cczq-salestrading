                                        <Button Grid.Row="2"  Width="30" Height="15" Background="{StaticResource ColorBrush.Gray15}" Foreground="{StaticResource ColorBrush.While}" Content="﹀" Style="{StaticResource SignButton}"
                                                Command="{Binding DownIBidCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="%" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.White2}" VerticalAlignment="Center"></TextBlock>

                                <CheckBox Grid.Row="2" Grid.Column="1" 
                                          IsChecked="{Binding DefaultRiskItem.IOfrDefautlCheck,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                                               
