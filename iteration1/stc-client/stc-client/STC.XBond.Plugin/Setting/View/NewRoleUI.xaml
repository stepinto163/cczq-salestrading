<Window x:Class="STC.XBond.Plugin.Setting.View.NewRoleUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.Setting.View"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowState="Normal" WindowStyle="None"
        Title="NewRoleUI" Height="163" Width="300">
    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Setting/Resources/ChanelStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DefaultTextBox" TargetType="{x:Type TextBox}">
                <Style.Resources>
                    <VisualBrush x:Key="HintText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                        <VisualBrush.Visual>
                            <TextBlock x:Name="tbVisual" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontSize="12" Foreground="#A0A0A0" Text="角色名"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Style.Resources>

                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Yellow}"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>

                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="1" BorderThickness="1" BorderBrush="#3C3C3C" Background="#0E1A18">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#172422"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#FF7D00"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#000"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="false"/>
                                        <Condition Property="Text" Value=""/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource HintText}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource ColorBrush.Gray18}" BorderThickness="1">
        <Grid Background="{StaticResource ColorBrush.Gray13}">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource ColorBrush.Gray18}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="新增角色" Width="48" Margin="10, 5, 0, 0" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}" 
                           Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource SmallContentFontSize}"/>
                <Button Name="btClose" Click="btClose_Click" Width="16" Height="16" Grid.Column="2"  IsCancel="True" Style="{StaticResource ImageCloseButton}" />
            </Grid>
            <Border Grid.Row="1" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"></RowDefinition>
                        <RowDefinition Height="24"></RowDefinition>

                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"></ColumnDefinition>
                        <ColumnDefinition Width="130"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"  Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="输入角色名：" Grid.Row="1" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" Foreground="{StaticResource ColorBrush.While}" FontSize="12"></TextBlock>
                        <TextBox x:Name="tbRole" Width="100" Height="20" Style="{StaticResource DefaultTextBox}" PreviewTextInput="tbWeight_PreviewTextInput"  Text="{Binding Weight, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"   
                                        Margin="2,-10,0,0"  KeyDown="tbWeight_KeyDown" >
                            <TextBox.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,18,0">
                        <CheckBox x:Name="checkrole"  IsChecked="{Binding DefaultCheck, Mode=TwoWay}" VerticalAlignment="Center"
                               BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"
                              FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" FontSize="{StaticResource SmallContentFontSize}" 
                              Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" Foreground="{StaticResource ColorBrush.While}" 
                              Content="复制已有角色权限" Click="checkrole_Click" ></CheckBox>
                        <ComboBox x:Name="comRoles" HorizontalAlignment="Left" Width="100" Height="24" Visibility="Hidden" Padding="0, 3, 0, 0" Margin="16,0,0,0" 
        SelectedValuePath="Key"
                  DisplayMemberPath="Value" Style="{StaticResource ComboBoxStyle}">
                              
                         
                            <!--SelectedValue="{Binding rolename, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" -->
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Background="{StaticResource ColorBrush.Gray13}">

                <Button Grid.Column="3" Content="确认" Click="Button_Click" Width="100" Height="24" Margin="0, 0, 20, 0" FontSize="12" Background="#E63034" Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}"/>

            </Border>


        </Grid>
    </Border>
</Window>
