<UserControl x:Class="STC.XBond.Plugin.Setting.View.RiskHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.Setting.View"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="1500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Setting/Resources/XBondDataGrid.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/QuoteStyle.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Setting/Resources/ChanelStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridTextLeftStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontFamily" Value="{StaticResource NotoSansDisplya-SemiBold}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemHeight="30">
            <DatePicker x:Name="dpFrom" Width="120px" FontFamily="{StaticResource DefaultFont}" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center"></DatePicker>
            <TextBlock x:Name="tbTo" Margin="10" VerticalAlignment="Center"  HorizontalAlignment="Left">-</TextBlock>
            <DatePicker x:Name="dpTo" Width="120" FontFamily="{StaticResource DefaultFont}" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center"></DatePicker>
            <TextBlock x:Name="RiskLbl" Text="风控类型:" VerticalAlignment="Center" Margin="20,0,5,0" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="RiskListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="提醒" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="2次提醒" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="禁止" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            </ListBox>
            <TextBlock x:Name="StyleLbl" Text="方式:" VerticalAlignment="Center" Margin="20,0,5,0" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="StyleListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="手工" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="IDB" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="量化" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            </ListBox>
            <TextBlock x:Name="QuoteTypeLbl" Text="报价类型:" VerticalAlignment="Center" Margin="20,0,5,0" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="QuoteTypeListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="firm" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="nonfirm" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            </ListBox>
            <CheckBox IsChecked="{Binding DefaultCheck, Mode=TwoWay}" VerticalAlignment="Center" Grid.Row="0" Margin="0, 5, 0, 0" BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"  FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" Foreground="{StaticResource ColorBrush.While}" Content="包含&lt;取消报价&gt;" ></CheckBox>
            <ComboBox Margin="20,0,0,0" Width="80"  Height="24" Padding="0, 3, 0, 0" SelectedIndex="{Binding SendPriceItem.ComboBoxSelectIndex,Mode=TwoWay}" Visibility="{Binding SendPriceItem.SettleTypeVisible}"  Style="{DynamicResource ComboBoxStyle}">
                <ComboBoxItem Content="STC订单号" Tag="1"></ComboBoxItem>
                <ComboBoxItem Content="债权代码" Tag="2"></ComboBoxItem>
                <ComboBoxItem Content="交易员" Tag="3"></ComboBoxItem>
            </ComboBox>
            <TextBox Width="80" Height="24" Padding="5, 0, 0, 0" 
                              Style="{StaticResource DefaultTextBoxStyle}" Text="{Binding CustomPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0">
            </TextBox>
            <Button Margin="20,0,0,0" x:Name="RiskSearchBtn" Content="搜索" Style="{DynamicResource DefaultButtonStyle}" Width="60" Height="24" Command="{Binding DelCommand}"/>
            <Button x:Name="RiskExportBtn" Content="导出" Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Right" Width="60" Height="24" Margin="20,0,0,0"/>
        </WrapPanel>
        <DataGrid x:Name="RHDataGrid" Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding RiskParaView}" Style="{StaticResource DefaultManageDataGrid}" SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding symbol}" Header="STC订单号" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="债券代码" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="方向" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="意向" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="报价(%)" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="数量(万)" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="交易日期" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="清算速度" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="方式" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="撮合范围" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="渠道" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="触发时间" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="风控类型" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="指标" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="指标值" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="指标限额" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="指标来源" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding symbol}" Header="操作结果" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>
            </DataGrid.Columns>
        </DataGrid>
        <!--<Button x:Name="TPAddBtn" Grid.Row="1" Content="新增" Style="{DynamicResource RedButtonStyle}" HorizontalAlignment="Right" Width="60" Height="24" Margin="10,0,10,0" Command="{Binding AddCommand}"/>
                    <Button x:Name="TPDeleteBtn" Grid.Row="1" Content="删除" Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Right" Width="60" Height="24" Margin="0,0,80,0" Command="{Binding DelCommand}"/>-->
    </Grid>
</UserControl>
