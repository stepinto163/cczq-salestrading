<UserControl x:Class="STC.XBond.Plugin.Setting.View.RiskDesignatedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.Setting.View"
             xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="1000" Initialized="UserControl_Initialized" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Setting/Resources/XBondDataGrid.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Setting/Resources/ChanelStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridTextLeftStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontFamily" Value="{StaticResource NotoSansDisplya-SemiBold}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dataGrid" Grid.Row="0" AutoGenerateColumns="False" ItemsSource="{Binding RiskParaView}" Style="{StaticResource DefaultManageDataGrid}" SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="债券代码" Width="auto" MinWidth="120" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="债券代码"/>
                                <TextBlock x:Name="textBlock1" />
                                <TextBlock />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding SecurityID}" VerticalAlignment="Center"></TextBlock>
                                <Component:CustomSearchTextBox x:Name="SearchBond_TextBox" 
                                                               HorizontalAlignment="Stretch" 
                                                               Grid.Column="0" Margin="5, 0, 0, 0" 
                                                               SearchText="{Binding SecurityID,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                               VerticalAlignment="Top" Width="120" Height="24" 
                                                               IsEnabled="{Binding EditEnable}"
                                                               Visibility="{Binding SaveBtnVisible}"
                                                               ValueChanged="SearchBond_TextBox_ValueChanged"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="简称" Width="auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="简称"/>
                                <TextBlock />
                                <TextBlock />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="SymbolTB" Text="{Binding Symbol}" HorizontalAlignment="Center" Foreground="{StaticResource DefaultForegroup.ColorBrush}" FontFamily="{StaticResource NotoSansDisplya-Regular}" FontSize="{StaticResource SmallContentFontSize}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="最后修改时间" Width="auto" MinWidth="120" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="最后修改时间"/>
                                <TextBlock x:Name="textBlock1" />
                                <TextBlock />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="UpdateTimeTB" Text="{Binding UpdateTime}" HorizontalAlignment="Center" Foreground="{StaticResource DefaultForegroup.ColorBrush}" FontFamily="{StaticResource NotoSansDisplya-Regular}" FontSize="{StaticResource SmallContentFontSize}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="单笔报量" Width="auto" MinWidth="126" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0">
                                <TextBlock x:Name="textBlock" Text="单笔报量" HorizontalAlignment="Center"/>
                                <TextBlock Text="警戒值" HorizontalAlignment="Center"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"></ColumnDefinition>
                                        <ColumnDefinition Width="5"></ColumnDefinition>
                                        <ColumnDefinition Width="60"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="textBlockup" Text="上限(万)"/>
                                    <Rectangle Grid.Column="1" Width="1" Height="16" Fill="{StaticResource Separator.ColorBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="textBlock1"  Text="下限(万)" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding QtyMax}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox x:Name="QtyMax_TB" 
                                             Text="{Binding QtyMax,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             Height="24"
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}"
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Qty_TB_PreviewTextInput"/>
                                </Grid>
                                <Rectangle Grid.Column="1" Width="1" Height="30" Fill="{StaticResource Separator.ColorBrush}" HorizontalAlignment="Center" />
                                <Grid Grid.Column="2">

                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding QtyMin}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox x:Name="QtyMin_TB" 
                                             Text="{Binding QtyMin,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Height="24"
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}"
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Qty_TB_PreviewTextInput"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="市场最优 偏离度" Width="auto" MinWidth="105" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Left" >
                                <TextBlock x:Name="textBlock" Text="市场最优 偏离度" HorizontalAlignment="Center"/>
                                <TextBlock Text="(警戒值)" HorizontalAlignment="Center"/>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                        <ColumnDefinition Width="5"></ColumnDefinition>
                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="marketBidtb" Text="Bid(%)" />
                                    <Rectangle Grid.Column="1" Width="1" Height="16" Fill="{StaticResource Separator.ColorBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="marketOfrtb"  Text="Ofr(%)"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding MarketBid}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox x:Name="MarketBid_TB" 
                                             Text="{Binding MarketBid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Height="24"
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}"
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Price_TB_PreviewTextInput"/>
                                </Grid>
                                <Rectangle Grid.Column="1" Width="1" Height="30" Fill="{StaticResource Separator.ColorBrush}" HorizontalAlignment="Center" />
                                <Grid Grid.Column="2">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding MarketOfr}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox x:Name="MarketOfr_TB" 
                                             Text="{Binding MarketOfr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Height="24"
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}"
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Price_TB_PreviewTextInput"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="市场最优 倒挂偏离度%" Width="auto" MinWidth="105" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Left" >
                                <TextBlock x:Name="textBlock" Text="市场最优 倒挂偏离度%" HorizontalAlignment="Center"/>
                                <TextBlock Text="(禁止值)" HorizontalAlignment="Center"/>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                        <ColumnDefinition Width="5"></ColumnDefinition>
                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bid(%)" />
                                    <Rectangle Grid.Column="1" Width="1" Height="16" Fill="{StaticResource Separator.ColorBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Ofr(%)"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding DropAwayFromBid}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox x:Name="DropBid_TB" 
                                             Text="{Binding DropAwayFromBid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Height="24" 
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}"
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Price_TB_PreviewTextInput"/>
                                </Grid>
                                <Rectangle Grid.Column="1" Width="1" Height="30" Fill="{StaticResource Separator.ColorBrush}" HorizontalAlignment="Center" />
                                <Grid Grid.Column="2">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding DropAwayFromOfr}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox x:Name="DropOfr_TB" 
                                             Text="{Binding DropAwayFromOfr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Height="24"
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}"
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Price_TB_PreviewTextInput"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="中债估值 偏离度%" Width="auto" MinWidth="105" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock x:Name="textBlock" Text="市场价格" HorizontalAlignment="Center"/>
                                <TextBlock HorizontalAlignment="Center"/>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                        <ColumnDefinition Width="5"></ColumnDefinition>
                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bid(%)" />
                                    <Rectangle Grid.Column="1" Width="1" Height="16" Fill="{StaticResource Separator.ColorBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="Ofr(%)"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding Bid}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox x:Name="Bid_TB" 
                                             Text="{Binding Bid,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Height="24" 
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}" 
                                             Visibility="{Binding SaveBtnVisible}"/>
                                </Grid>
                                <Rectangle Grid.Column="1" Width="1" Height="30" Fill="{StaticResource Separator.ColorBrush}" HorizontalAlignment="Center" />
                                <Grid Grid.Column="2">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding Ofr}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox x:Name="Ofr_TB" 
                                             Text="{Binding Ofr,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             HorizontalContentAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Height="24" 
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}" 
                                             Visibility="{Binding SaveBtnVisible}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="40" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="editBtn" Grid.Column="0" BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource EditButton}" Visibility="{Binding EditBtnVisible ,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                <Button Grid.Row="0" BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource SaveButton}" Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                <Button Grid.Column="1" BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CancelButton}" Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="ImportBtn" Grid.Row="1" Content="导入" Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Left" Width="60" Height="24" Margin="10,0,0,0"/>
        <Button x:Name="ExportBtn" Grid.Row="1" Content="导出" Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Left" Width="60" Height="24" Margin="80,0,0,0"/>
        <Button x:Name="AddBtn" Grid.Row="1" Content="新增" Style="{DynamicResource RedButtonStyle}" HorizontalAlignment="Right" Width="60" Height="24" Margin="10,0,10,0" Command="{Binding AddCommand}"/>
        <Button x:Name="DeleteBtn" Grid.Row="1" Content="删除" Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Right" Width="60" Height="24" Margin="0,0,80,0" Command="{Binding DelCommand}"/>
    </Grid>
</UserControl>
