<Window x:Class="STC.XBond.Plugin.Setting.View.SettingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component"
        xmlns:local="clr-namespace:STC.XBond.Plugin.Setting.View"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowState="Normal" WindowStyle="None"
        Title="SettingView" Height="500" Width="800" MouseLeftButtonDown="Window_MouseLeftButtonDown"  Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Setting/Resources/ChanelStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid>
                                <Label x:Name="lbl" Foreground="#FFFFFF"  Grid.Column="1" FontSize="12" FontFamily="Tomaha" Padding="0">
                                    <Label.Content>
                                        <TextBlock  Name="Border" Margin="0,0,5,0" Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"/>
                                    </Label.Content>
                                </Label>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="100" />
                                    <Setter TargetName="Border" Property="Foreground" Value="#E63034" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="23"/>
            <RowDefinition Height="20"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ColorBrush.Gray18}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="系统设置" Width="48" Margin="10, 4, 0, 0" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}" 
                       Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource SmallContentFontSize}"/>
            <Button Width="16" Height="16" Grid.Column="2" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" Click="Window_Closed" />
        </Grid>
        <Grid Grid.Row="1" Background="{StaticResource ColorBrush.Gray18}"/>
        <Grid Grid.Row="2">
            <TabControl x:Name="Setting_tabControl" TabStripPlacement="Left"  Style="{StaticResource TabControlStyle2}" SelectedIndex="1" Background="{StaticResource MainBackgroup.ColorBrush}" >
                <TabItem x:Name="tab1" Header="用户管理" Width="130" Height="30" FontSize="10" Foreground="#A0A0A0" IsEnabled="False" Margin="30,0,0,0">
                </TabItem>
                <TabItem x:Name="tab11" Header="账号管理" Width="130" Height="30" Margin="30,0,0,0" Foreground="#FFFFFF">
                </TabItem>
                <TabItem x:Name="tab12" Header="角色权限设置" Width="130" Height="30" Margin="30,0,0,0" Foreground="#FFFFFF">
                    <local:RoleRightsAnagementView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></local:RoleRightsAnagementView>
                </TabItem>
                <TabItem x:Name="tab2" Header="机构设置" FontSize="10" Foreground="#A0A0A0" IsEnabled="False" Width="130" Height="30" Margin="30,0,0,0"/>
                <TabItem x:Name="tab21" Header="渠道设置" Width="130" Height="30" Margin="30,0,0,0" Foreground="#FFFFFF">
                    <local:ChanelSettingView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></local:ChanelSettingView>
                </TabItem>
                <TabItem x:Name="tab22" Header="风控参数" Width="130" Height="30" Margin="30,0,0,0" Foreground="#FFFFFF">
                    <local:RiskParaView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></local:RiskParaView>
                </TabItem>
                <TabItem x:Name="tab3" Header="业务监控" FontSize="10" Foreground="#A0A0A0" IsEnabled="False" Width="130" Height="30" Margin="30,0,0,0"/>
                <TabItem x:Name="tab31" Header="X-bond订阅表" Width="130" Margin="30,0,0,0" Foreground="#FFFFFF">
                    <local:XBondSubView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
