<UserControl x:Class="STC.XBond.Plugin.Setting.View.PartyPositionRiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.Setting.View"
             xmlns:Component="clr-namespace:STC.XBond.Plugin.Setting.Component" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="700" Loaded="UserControl_Loaded" Initialized="UserControl_Initialized">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Setting/Resources/XBondDataGrid.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Setting/Resources/ChanelStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridTextLeftStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontFamily" Value="{StaticResource NotoSansDisplya-SemiBold}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="TPDataGrid" Grid.Row="0" AutoGenerateColumns="False" ItemsSource="{Binding PartyRiskParaView}" Style="{StaticResource DefaultManageDataGrid}" SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="STC账号" Width="Auto" MinWidth="120" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="STC账号"/>
                                <TextBlock x:Name="textBlock1" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding STCAccount}" Margin="5, 0, 0, 0" ></TextBlock>
                                <Component:STCAccountSearchTextBox x:Name="SearchAccount_TextBox" 
                                                               HorizontalAlignment="Stretch" 
                                                               Grid.Column="0" Margin="5, 0, 0, 0" 
                                                               SearchText="{Binding STCAccount,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                               VerticalAlignment="Center" Height="24" 
                                                               IsEnabled="{Binding EditEnable}"
                                                               Visibility="{Binding SaveBtnVisible}"
                                                               ValueChanged="SearchAccount_TextBox_ValueChanged"
                                                                   Width="120"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="用户姓名" Width="Auto" MinWidth="80" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="用户姓名"/>
                                <TextBlock x:Name="textBlock1" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UserName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource DefaultForegroup.ColorBrush}" FontFamily="{StaticResource NotoSansDisplya-Regular}" FontSize="{StaticResource SmallContentFontSize}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="部门" Width="Auto" MinWidth="45" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="部门"/>
                                <TextBlock x:Name="textBlock1" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Dept,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource DefaultForegroup.ColorBrush}" FontFamily="{StaticResource NotoSansDisplya-Regular}" FontSize="{StaticResource SmallContentFontSize}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="最后修改时间" Width="Auto" MinWidth="120" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="最后修改时间"/>
                                <TextBlock x:Name="textBlock1" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="UpdateTimeTB" Text="{Binding UpdateTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource DefaultForegroup.ColorBrush}" FontFamily="{StaticResource NotoSansDisplya-Regular}" FontSize="{StaticResource SmallContentFontSize}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="利率债多头合计" Width="Auto" MinWidth="120" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="利率债多头合计" HorizontalAlignment="Center"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="textBlockup" Text="极端值(万)"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding InterestRateLongExtremeValue}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox Text="{Binding InterestRateLongExtremeValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}" 
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Qty_TB_PreviewTextInput"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="利率债空头合计" Width="Auto" MinWidth="120" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="利率债空头合计" HorizontalAlignment="Center"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="textBlockup" Text="极端值(万)"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" >
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding InterestRateShortExtremeValue}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox Text="{Binding InterestRateShortExtremeValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}"
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Qty_TB_PreviewTextInput"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="信用债规模" Width="Auto" MinWidth="120" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TextBlock x:Name="textBlock" Text="信用债规模" HorizontalAlignment="Center"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="textBlockup" Text="极端值(万)"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock  Visibility="{Binding EditBtnVisible}" Text="{Binding CreditExtremeValue}" VerticalAlignment="Center"></TextBlock>
                                    <TextBox Text="{Binding CreditExtremeValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                             IsEnabled="{Binding EditEnable}" 
                                             Style="{StaticResource RiskTextBox}"
                                             Visibility="{Binding SaveBtnVisible}"
                                             input:InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="Qty_TB_PreviewTextInput"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="Auto" MinWidth="40" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="editBtn" Grid.Column="0" BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource EditButton}" Visibility="{Binding EditBtnVisible ,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                <Button Grid.Row="0" BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource SaveButton}" Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                <Button Grid.Column="1" BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CancelButton}" Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="TPAddBtn" Grid.Row="1" Content="新增" Style="{DynamicResource RedButtonStyle}" HorizontalAlignment="Right" Width="60" Height="24" Margin="10,0,10,0" Command="{Binding AddCommand}"/>
        <Button x:Name="TPDeleteBtn" Grid.Row="1" Content="删除" Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Right" Width="60" Height="24" Margin="0,0,80,0" Command="{Binding DelCommand}"/>
    </Grid>
</UserControl>
