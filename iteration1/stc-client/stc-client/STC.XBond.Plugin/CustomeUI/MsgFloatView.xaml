<UserControl x:Class="STC.XBond.Plugin.CustomeUI.MsgFloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.CustomeUI"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             mc:Ignorable="d" 
             d:DesignHeight="330" d:DesignWidth="344" Width="344">

    <UserControl.Resources>
        <ResourceDictionary>


            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>-->
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="DataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,0,0,2"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border x:Name="innerboard" BorderThickness="0">
                                               <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="true">
                                                <Setter Property="BorderThickness" TargetName="innerboard" Value="1"/>
                                                <Setter Property="Margin" TargetName="innerboard" Value="0,0,0,0"/>
                                                <Setter Property="CornerRadius" TargetName="innerboard" Value="4"/>
                                                <Setter Property="BorderBrush" TargetName="innerboard" Value="{Binding ShowBorderBrush,Mode=OneWay}"/>
                                                <Setter Property="Background" TargetName="innerboard"  Value="Transparent"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <Storyboard x:Key="sbFloat" Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                <ColorAnimation 
                From="#50E63034" To="#20E63034" Duration="00:01:00" />
            </Storyboard>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="dgMsg" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" MouseDoubleClick="DgMsg_MouseDoubleClick" MouseUp="dgMsg_MouseUp"
                                  Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0" HeadersVisibility="None"
                  ScrollViewer.CanContentScroll="True" AllowDrop="True" LoadingRow="DgMsg_LoadingRow"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                                VirtualizingPanel.IsVirtualizing="False" VirtualizingPanel.ScrollUnit="Pixel"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="False" 
                   ItemsSource="{Binding ShowData}"
                 Style="{StaticResource DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="330">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:FloatDetailView x:Name="floatDetailView" Margin="0, 0, 0, 0"></local:FloatDetailView>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</UserControl>
