<Window x:Class="STC.XBond.Plugin.CustomeUI.NofirmView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.CustomeUI"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="NofirmView" Height="263" Width="352" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" AllowsTransparency ="True" BorderThickness="0">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Button}" x:Key="XBondButton">
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray13}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue10}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"   
                            CornerRadius="2, 2, 0, 0"/>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                       Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Blue8}"/>
                                    <!--<Setter Property="BorderBrush" TargetName="background" Value="{DynamicResource {x:Static SystemColors.HighlightBrush}}"/>-->
                                </Trigger>
                                <!--<Trigger Property="IsMouseOver" Value="false">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Transparent}"/>
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Blue8}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="BorderThickness" TargetName="background" Value="0"/>
                                    <Setter Property="BorderBrush" TargetName="background" Value="{StaticResource ColorBrush.Gray13}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="listBoxItemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding SendPriceItem.DefaultItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="radBase" TargetType="RadioButton">
                <Setter Property="IsChecked" Value="{Binding Path=IsSelected,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="outElli" Width="16" Height="16" Grid.Column="0" Fill="{StaticResource ColorBrush.Gray15}"></Ellipse>
                                <Ellipse x:Name="middleElli" Width="10" Height="10" Grid.Column="0" Fill="{StaticResource ColorBrush.Gray13}"></Ellipse>
                                <Ellipse x:Name="innerElli" Width="8" Height="8" Grid.Column="0" Fill="{StaticResource ColorBrush.Gray13}"></Ellipse>

                                <TextBlock  Grid.Column="1" Text="{TemplateBinding Content}" Padding="2, 3, 0, 0"></TextBlock>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter TargetName="outElli" Property="Fill" Value="{StaticResource ColorBrush.Red7}"/>
                                    <Setter TargetName="middleElli" Property="Fill" Value="{StaticResource ColorBrush.Gray13}"/>
                                    <Setter TargetName="innerElli" Property="Fill" Value="{StaticResource ColorBrush.Red14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="16"/>
                <!--<Setter Property="Width" Value="80"/>
                <Setter Property="Height" Value="24"/>-->
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <!--<Setter Property="IsEnabled" Value="{Binding SendPriceItem.DirectionItemEnable}"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">

                            <RadioButton Content="{TemplateBinding Content}" FontSize="{StaticResource BigContentFontSize}" Background="{StaticResource ColorBrush.Transparent}" 
                              Foreground="{StaticResource ColorBrush.While}" Margin="10, 5, 0, 0" Style="{StaticResource radBase}"></RadioButton>

                            <!--<CheckBox VerticalAlignment="Center" Margin="0, 3, 0, 0" BorderThickness="2" 
                              BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"  Content="{TemplateBinding Content}"
                              FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" 
                              Foreground="{StaticResource ColorBrush.While}"></CheckBox>-->

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="XBondButtong" TargetType="{x:Type Button}">
                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"  Background="{TemplateBinding Background}"    
                            CornerRadius="1">

                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                </Border>
            </ControlTemplate>


            <Style x:Key="BidRadioStyle" TargetType="RadioButton">
                <Setter Property="Margin" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">

                            <Border x:Name="_borderChecked" CornerRadius="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <Border.Background>
                                    <ImageBrush ImageSource="../Images/stc_button_nonfirm_disable.png"/>
                                </Border.Background>
                            </Border>
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="_borderChecked">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_button_nonfirm_normal.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" TargetName="_borderChecked">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_button_nonfirm_disable.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CheckBoxThemeColor" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="_borderOne" CornerRadius="5" Background="#3C3C3C" Width="12" Height="12" Margin="{TemplateBinding Margin}">
                                    <Border x:Name="_borderTwo" CornerRadius="4" Background="#3C3C3C" Width="8" Height="8" Margin="{TemplateBinding Margin}">
                                        <Border x:Name="_borderThree" CornerRadius="3" Background="#141414" Width="6" Height="6" Margin="{TemplateBinding Margin}">

                                        </Border>
                                    </Border>
                                </Border>
                                <ContentPresenter Grid.Column="1" x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" TargetName="_borderOne" Value="#E63034"/>
                                    <Setter Property="Background" TargetName="_borderTwo" Value="#141414"/>
                                    <Setter Property="Background" TargetName="_borderThree" Value="#E63034"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Background" TargetName="_borderOne" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="_borderTwo" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="_borderThree" Value="#141414"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Border BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Red7}">


        <Grid Background="{StaticResource ColorBrush.Gray13}">
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource ColorBrush.Gray18}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Nonfirm点价待确认" Margin="10, 3, 0, 0" FontWeight="Bold" 
                       Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource SmallContentFontSize}"/>
                <Button Width="16" Height="16" Grid.Column="2" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
            </Grid>

            <Border Grid.Row="1" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}">
                <Grid Margin="20, 7, 20, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="待确认" Margin="0, 13, 0, 0" FontWeight="Bold"
                            Foreground="{StaticResource ColorBrush.Orange5}" FontSize="{StaticResource NormalContentFontSize}"/>

                        <Border Grid.ColumnSpan="2" HorizontalAlignment="Right" Visibility="{Binding TimeOutTxtVisibility}" Grid.Column="1" Grid.Row="0" Margin="0, 8, 0, 0" CornerRadius="2" 
                                            Background="{StaticResource ColorBrush.Gray22}" MinWidth="40">
                            <TextBlock TextAlignment="Right" Visibility="{Binding TimeOutTxtVisibility}" Padding="0, 2,2,0">
                            
                                            <Run Text="{Binding OutTime}" Foreground="{StaticResource ColorBrush.Red16}" FontSize="22" FontWeight="Bold"></Run>
                                            <Run Text="s" Foreground="{StaticResource ColorBrush.Red7}"/>

                            </TextBlock>
                        </Border>


                        <!--<StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Grid.Column="2" Text="倒计时" Margin="0, 13, 3, 0" HorizontalAlignment="Right"
                                Foreground="{StaticResource ColorBrush.Gray14}" FontSize="{StaticResource SmallContentFontSize}"/>

                            <TextBlock Grid.Column="3" Text="{Binding OutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0, 13, 0, 0" HorizontalAlignment="Right"
                                Foreground="{StaticResource ColorBrush.Red7}" FontSize="{StaticResource SmallContentFontSize}"/>
                        </StackPanel>-->
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 5, 0, 0">
                        <TextBlock Text="{Binding Side}" Margin="0, 13, 3, 0" Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource NormalContentFontSize}"/>
                        <TextBlock Text="{Binding GoodCode}" Margin="0, 13, 3, 0" Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource NormalContentFontSize}"/>
                        <TextBlock Text="{Binding Price}" Margin="0, 13, 3, 0" Foreground="{Binding PriceBrush}" FontSize="{StaticResource NormalContentFontSize}"/>

                        <Border Height="24" Width="100" CornerRadius="1" Margin="10, 5, 0, 0" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray19}" Background="{StaticResource ColorBrush.Black9}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="22"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="tbAmount" Grid.Column="0" Style="{StaticResource DefaultTextBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                         IsEnabled="{Binding FirmGridEnable}" Text="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="{StaticResource ColorBrush.Black9}" ToolTip="{Binding LimitToolTxt}"></TextBox>

                                <TextBlock Grid.Column="1" Text="万" Margin="0, 4, 3, 0" HorizontalAlignment="Right" Background="{StaticResource ColorBrush.Black9}"
                                    Foreground="{StaticResource ColorBrush.Gray14}" FontSize="{StaticResource SmallContentFontSize}"/>

                            </Grid>

                            

                        </Border>

                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="对方：" Margin="0, 18, 3, 0" Foreground="{StaticResource ColorBrush.White2}" FontSize="{StaticResource SmallContentFontSize}"/>
                       <TextBlock Text="{Binding CounterSubPartySideAmount}" Margin="0, 18, 3, 0" Foreground="{Binding CounterSubPartySideAmountBrush}" FontSize="{StaticResource SmallContentFontSize}"/>
                        <TextBlock Text="{Binding CounterSubPartyAmount}" Margin="0, 18, 3, 0" Foreground="{StaticResource ColorBrush.White2}" FontSize="{StaticResource SmallContentFontSize}"/>
                        <TextBlock Text="{Binding CounterSubPartyName}" MinWidth="60" Margin="0, 18, 3, 0" Foreground="{StaticResource ColorBrush.White2}" FontSize="{StaticResource SmallContentFontSize}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <TextBlock Text="我的：" Margin="0, 8, 3, 0" Foreground="{StaticResource ColorBrush.White2}" FontSize="{StaticResource SmallContentFontSize}"/>
                        <TextBlock Text="{Binding CounterSubSideAmount}" Margin="0, 8, 3, 0" Foreground="{Binding CounterSubSideAmountBrush}" FontSize="{StaticResource SmallContentFontSize}"/>
                        <TextBlock Text="{Binding CounterSubAmount}" Margin="0, 8, 3, 0" Foreground="{StaticResource ColorBrush.White2}" FontSize="{StaticResource SmallContentFontSize}"/>
                        <TextBlock Text="{Binding CounterPartyName}" MinWidth="60" Margin="0, 8, 3, 0" Foreground="{StaticResource ColorBrush.White2}" FontSize="{StaticResource SmallContentFontSize}"/>

                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45*"/>
                    <ColumnDefinition Width="55*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnRefuse" Grid.Column="0" Content="拒绝" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding RefuseCommand}" FontSize="12"
                            Foreground="#FFFFFF" Background="{StaticResource ColorBrush.Gray15}" Style="{StaticResource SmallConfirmBtnStyle}" Width="60" Height="24" HorizontalAlignment="Right"  Margin="0, 0, 10, 0"/>


                <Button x:Name="btnCommit" Grid.Column="1" Content="提交" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding CommitCommand}" FontSize="12"
                            Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}" Width="100" Height="24" HorizontalAlignment="Left"  Margin="0, 0, 0, 0"/>

            </Grid>

        </Grid>

    </Border>
</Window>
