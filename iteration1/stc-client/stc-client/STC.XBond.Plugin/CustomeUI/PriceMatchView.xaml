<Window x:Class="STC.XBond.Plugin.CustomeUI.PriceMatchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:local="clr-namespace:STC.XBond.Plugin.CustomeUI"
        mc:Ignorable="d"
          Title="价格匹配" Height="322" Width="700" WindowStartupLocation="CenterScreen" AllowsTransparency ="True"
        WindowState="Normal" WindowStyle="None" BorderThickness="1" BorderBrush="#A0A0A0">
    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>-->
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

           
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*" MinHeight="124"/>
            <!--<RowDefinition Height="70"/>-->
            <RowDefinition Height="{Binding RowHeight}"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"></TextBlock>
            <TextBlock Text="价格匹配" Width="48" Margin="10, 4, 0, 0" FontWeight="Bold" 
                       Foreground="{DynamicResource ColorBrush.While}" FontSize="{DynamicResource SmallContentFontSize}"/>
            <Button Grid.Column="2" Command="{Binding CancelCommand}" IsCancel="True" Style="{DynamicResource DrpImageCloseButton}" Height="24" Width="24" Background="{DynamicResource BackgroundBrush}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="20, 0, 0, 0" Orientation="Horizontal" >
            <TextBlock Text="{Binding ContentStart}" HorizontalAlignment="Left" VerticalAlignment="Center"   
                       Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>
            <!--<TextBlock Margin="5, 0, 0, 0" Text="{Binding TotalAmount}" HorizontalAlignment="Left" VerticalAlignment="Center"   Foreground="{StaticResource ColorBrush.While}" FontSize="12"/>

            <TextBlock Margin="5, 0, 5, 0" Text="{Binding FirmType}" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ColorBrush.Red7}"
                        Foreground="{StaticResource ColorBrush.While}" FontSize="12"/>-->
            <!--<TextBlock Text="{Binding ContentEnd}" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource ColorBrush.While}" FontSize="12"/>-->
            <!--<TextBlock Visibility="{Binding ContentEndVisibility}" Text="，请确认firm量" HorizontalAlignment="Left" VerticalAlignment="Center"   Foreground="{DynamicResource ColorBrush.While}" FontSize="12"/>-->

        </StackPanel>

        <DataGrid x:Name="dgData" Grid.Row="2"  Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}"  Margin="20, 0, 20, 0"  Background="{DynamicResource DefaultBackgroup.ColorBrush}" ItemsSource="{Binding GridDatas}" MouseDoubleClick="DataGrid_MouseDoubleClick">

            <DataGrid.ContextMenu>
                <ContextMenu Style="{DynamicResource DefaultContextMenu}" Opened="ContextMenu_Opened">
                    <MenuItem x:Name="StartQQBtn" Header="弹出QQ" Style="{DynamicResource DefaultMenuItem}" Click="StartQQBtn_Click" />
                    <MenuItem x:Name="StartQQ2Btn" Header="议价" Style="{DynamicResource DefaultMenuItem}" Click="StartQQ2Btn_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
            <Style TargetType="{x:Type DataGridRow}">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MainListTitleBackgroup.ColorBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>


            <DataGrid.Columns>

                <DataGridTemplateColumn Width="28" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="CheckBox_All" PreviewMouseLeftButtonDown="CheckBox_All_PreviewMouseLeftButtonDown"
                                      VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,0,0" 
                                      IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      Style="{DynamicResource GreenBlueCheckedNormalCheckBox}"  Height="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding EnabledBtn}"
                                                Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" BorderBrush="{DynamicResource SlateGrayButton.MouseOver.Background}" Background="{DynamicResource DefaultBackgroup.ColorBrush}" Height="12"></CheckBox>
                            <DataTemplate.Triggers>
                                <DataTrigger  Binding="{Binding ShowDeleteBtn}" Value="2">
                                    <Setter TargetName="Selected_Chk" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding Sort}" CellStyle="{DynamicResource DataGridTextRightStyle}" MinWidth="40"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12">
                    
                </DataGridTextColumn>

                <!--<DataGridTextColumn  Binding="{Binding Price}" MinWidth="60" Header="报价(%)" FontWeight="Bold"  FontSize="12">
                    
                </DataGridTextColumn>-->


                <DataGridTemplateColumn MinWidth="60" Header="报价(%)">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <TextBlock Text="{Binding Price}" Foreground="{Binding PriceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Grid.Column="0" FontWeight="Bold"  FontSize="12"></TextBlock>
                                
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>



                <DataGridTextColumn Binding="{Binding FirmType}" MinWidth="60" Header="类型"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12">
                    
                </DataGridTextColumn>

                <DataGridTemplateColumn MinWidth="60" Header="量(万元)">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Amount}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Grid.Column="0"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>
                                <Border x:Name="whole" Grid.Column="1" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="{DynamicResource TextBox.Focus.Border}" BorderThickness="0" Margin="0,0,0,0">
                                    <TextBlock Text="整" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                                    <Setter TargetName="whole" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                        
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn Binding="{Binding DealSettle}" MinWidth="80" Header="处理后清算速度"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"/>
                <DataGridTextColumn Binding="{Binding Settle}" MinWidth="80" Header="原始清算速度"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"/>


                <DataGridTextColumn Binding="{Binding Source}" MinWidth="80" Header="来源"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"
                                    >

                </DataGridTextColumn>

                <DataGridTemplateColumn MinWidth="100" Header="点价量(万元)">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="26"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" IsEnabled="{Binding EnabledBtn}" Text="{Binding PointAmount}" Style="{DynamicResource DrpPriceAmountEditTextBox}"  Background="{DynamicResource ColorBrush.Black7}" Padding="5, 0, 0, 0"
                                    Foreground="{DynamicResource ColorBrush.While}" FontSize="12" input:InputMethod.IsInputMethodEnabled="False" TextChanged="TextBox_TextChanged"
                                         PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" Tag="3" Height="20"></TextBox>

                                <Button TabIndex="-1" Width="22" Height="10" Grid.Column="1" Grid.Row="0" Margin="0, 1, 0, 1" IsEnabled="{Binding EnabledBtn}"
                                                    Content="^" Foreground="#D7D7D7" Background="{DynamicResource ColorBrush.Gray2}" BorderThickness="0"
                                                    Padding="0, -1, 0, 0" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"  CommandParameter="{Binding Id}" Style="{DynamicResource DrpAddButton}"/>
                                <Button TabIndex="-1" Width="22" Height="10" Grid.Column="1" Grid.Row="1" Margin="1, 1, 1, 1" IsEnabled="{Binding EnabledBtn}"
                                                    Content="v" Foreground="#D7D7D7" FontWeight="ExtraLight"  Background="{DynamicResource ColorBrush.Gray2}" BorderThickness="0"
                                                    Padding="1, -4, 0, 0"    Command="{Binding DataContext.DownCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"   CommandParameter="{Binding Id}" Style="{DynamicResource DrpAddButton}"/>
                            </Grid>
                            
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            
        </DataGrid>

        <Grid Grid.Row="3" Visibility="{Binding RemarkVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Remark}" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="0"  
                       Foreground="{DynamicResource ColorBrush.While}" FontSize="12" Margin="20, 0, 0, 0"/>
            <TextBlock Text="（此处外部渠道不包括X-bond）" Visibility="{Binding RemarkOtherVisibility}" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1"  
                       Foreground="{DynamicResource ColorBrush.While}" FontSize="12" Margin="20, 0, 0, 0"/>
        </Grid>

        <!--<Border Grid.Row="3" BorderThickness="0, 1, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Visibility="{Binding FirmBorder}">-->
        <Border Grid.Row="3" BorderThickness="0, 1, 0, 1" BorderBrush="{DynamicResource ColorBrush.Gray20}" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="20, 0, 0, 0">
                    <TextBlock Text="匹配到" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="10"></TextBlock>
                    <TextBlock Margin="2, 0, 2, 0" Text="{Binding OutChannelNum}" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="10"></TextBlock>
                    <TextBlock Text="家外部渠道" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="10"></TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="55, 0, 0, 0">
                    <TextBlock Text="随机" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>
                    <TextBox PreviewTextInput="TextBox_PreviewTextInput" Margin="2, 0, 2, 0" Width="20" Text="{Binding RandomNum}" HorizontalAlignment="Center"
                             PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                             VerticalAlignment="Center" 
                             Tag="1" Style="{DynamicResource DefaultTextBoxStyle}" Background="{DynamicResource ColorBrush.Black7}" input:InputMethod.IsInputMethodEnabled="False"
                             Foreground="{DynamicResource ColorBrush.While}" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray15}" FontSize="12"></TextBox>
                    <TextBlock Text="家渠道，以及" HorizontalAlignment="Center" VerticalAlignment="Center"  
                               Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>
                    <CheckBox IsChecked="{Binding CheckOut}" Tag="{Binding CheckOutChannelTag}" Content="{Binding OutChannel}" Margin="5, 0, 5, 0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="2"  BorderBrush="{DynamicResource ColorBrush.Gray15}" 
                               FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource CommonCheckBoxStyle}" Background="{DynamicResource ColorBrush.Transparent}" Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                    <!--<TextBlock Text="X-BOND，国利" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{StaticResource ColorBrush.While}" FontSize="12"></TextBlock>-->

                </StackPanel>

            </Grid>

        </Border>

        <!--<Border Grid.Row="3" BorderThickness="0, 1, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Visibility="{Binding NonFirmBorder}">-->
        <Border Grid.Row="3" BorderThickness="0, 1, 0, 1" BorderBrush="{DynamicResource ColorBrush.Gray20}" Visibility="Collapsed">
            <Grid>
                
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="55, 0, 0, 0">
                    <TextBlock Text="已确认量 " HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>
                    <TextBox PreviewTextInput="TextBox_PreviewTextInput" Margin="2, 0, 2, 0" Width="80" Height="20" Text="{Binding CustomAmount, Mode=TwoWay}" 
                             PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" input:InputMethod.IsInputMethodEnabled="False"
                             Tag="2" Style="{DynamicResource DefaultTextBoxStyle}" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray15}" Background="{DynamicResource ColorBrush.Black7}" Padding="5, 0, 0, 0"
                              Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBox>
                    <TextBlock Text=" 万 /" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>
                    <TextBlock Text="{Binding TotalAmount}" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>
                    <TextBlock Text=" 万" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>

                </StackPanel>

            </Grid>

        </Border>

        <Border Grid.Row="4" BorderThickness="0, 0, 0, 1" BorderBrush="{Binding BorderBrush,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="65"></ColumnDefinition>
                    <ColumnDefinition Width="125"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!--<TextBlock Grid.Column="0" Text="{Binding ErrorTxt}" Visibility="{Binding ErrorVisibility}" Margin="20, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="{StaticResource ColorBrush.Red7}" FontSize="12"></TextBlock>-->

                <TextBlock Grid.Column="0" Visibility="{Binding CheckAmountErrorVisibility}" Margin="20, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12">
                    <Run>报价总量:</Run>
                    <Run Text="{Binding MatchTotal}"/>
                    <Run>万,点价总量:</Run>
                    <Run x:Name="pointTotalRun" Text="{Binding PointTotal}" Foreground="{Binding WarningColor}"/>
                    <Run>万</Run>
                </TextBlock>
                <TextBlock Grid.Column="0" Text="{Binding ErrorTxt}" Visibility="{Binding ErrorVisibility}" Margin="20, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>

                <Button x:Name="btnCancel" Grid.Column="1" Content="取消" Command="{Binding CloseCommand}" Width="60" Height="24" FontSize="12"  Foreground="{DynamicResource DefaultGridForground}"
                        Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0,1,0,0"/>

                <!--<Button x:Name="btnCancel" Grid.Column="1" Content="取消" Command="{Binding CloseCommand}" Width="60" Height="24" FontSize="12" Background="#3C3C3C" Foreground="#FFFFFF" 
                        Style="{StaticResource SmallCancelBtnStyle}" Visibility="{Binding CancelVisibility}"/>-->
                <Button x:Name="btnSendPrice" Grid.Column="2" Content="报价" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding OkCommand}" Width="100" Height="24" 
                        Margin="0, 0, 20, 0" FontSize="12" Style="{DynamicResource BlueGreenStyle}"   Foreground="{DynamicResource DefaultGridForground}" BorderThickness="0 1 0 0"/>
                <!--Visibility="{Binding CancelVisibility}"/>--><!--
                <Button Grid.Column="2" Content="确定" Command="{Binding ConfirmCommand}" Width="100" Height="24" Margin="0, 0, 20, 0" FontSize="12" Background="#136C5E" 
                        Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}" Visibility="{Binding ConfirmVisibility}"/>-->

            </Grid>
        </Border>

    </Grid>
</Window>
