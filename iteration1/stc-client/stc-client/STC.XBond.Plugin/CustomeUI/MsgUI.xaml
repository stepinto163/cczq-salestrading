<UserControl x:Class="STC.XBond.Plugin.CustomUI.MsgUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.CustomeUI"
             xmlns:CustomUI="clr-namespace:STC.XBond.Plugin.CustomUI"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="358" Width="358" MouseLeftButtonDown="UserControl_MouseLeftButtonDown">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>-->
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NoticeUrgebtButton" TargetType="Button">
                <Setter Property="Width" Value="65" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_urgebt_noraml.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_urgebt_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_urgebt_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoticeWarntButton" TargetType="Button">
                <Setter Property="Width" Value="65" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_warning_normal.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_warning_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_warning_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoticeNormalButton" TargetType="Button">
                <Setter Property="Width" Value="65" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_normal_normal.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_normal_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_iamge_noticewidget_normal_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Name="TabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Width" Value="100"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Background" Value="{DynamicResource MidnightBlueSilverBrush}"/>
                <!--<Setter Property="Foreground" Value="#FFEBC8"/>-->
                <Setter Property="Margin" Value="0, 0, 0, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <!--Width="120px" Height="30px"  Background="#21322F" Foreground="#FFEBC8"-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid>
                                <Border x:Name="BorderTab"  Margin="0" Background="{TemplateBinding Background}"  CornerRadius="2,2,2,2" BorderThickness="0" >
                                    <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Center" 
                                                  ContentSource="Header" 
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                   Margin="0,0,0,5"
                                                  
                                                  RecognizesAccessKey="True">
                                        <ContentPresenter.LayoutTransform>
                                            <RotateTransform Angle="0" />
                                        </ContentPresenter.LayoutTransform>
                                    </ContentPresenter>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource ColorBrush.White2}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="Bold"/>
                                    <!--<Setter TargetName="Border" Property="BorderThickness" Value="1"/>-->
                                    <!--<Setter TargetName="BorderTab" Property="Background" Value="{DynamicResource TabItem.Selected.Background}"></Setter>-->
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="BorderTab" Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter TargetName="BorderTab" Property="BorderBrush" Value="{DynamicResource TabItem.Selected.Border}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource ColorBrush.White2}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource ColorBrush.Gray14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="Background" Value="{DynamicResource ColorBrush.Gray15}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0, 3, 0, 0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Background}"
                                    BorderThickness="1">

                                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ColorBrush.Red7}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <!--<Setter Property="AutoGenerateColumns" Value="False"/>-->
                <!--<Setter Property="BorderThickness" Value="0"/>-->
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <!--<Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>-->
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" >
                            <Setter Property="BorderThickness" Value="0"/>
                            <!--<Setter Property="ToolTipService.ToolTip" Value="{Binding ToolText}"/>-->
                            <Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{Binding ShowBorderBrush, Mode=OneWay}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--<Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>-->

            <Style x:Key="MeTableControl" TargetType="{x:Type TabControl}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource MidnightBlueSilverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid x:Name="templateRoot" ClipToBounds="true" SnapsToDevicePixels="true" KeyboardNavigation.TabNavigation="Local">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColumnDefinition0"/>
                                    <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowDefinition0" Height="26"/>
                                    <RowDefinition x:Name="RowDefinition1" Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- TabItem Headers -->
                                <TabPanel x:Name="headerPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" IsItemsHost="true"  Background="{DynamicResource MidnightBlueSilverBrush}"  KeyboardNavigation.TabIndex="1">

                                </TabPanel>
                                <Border x:Name="contentPanel" Grid.Row="1"  Grid.Column="0" BorderBrush="Transparent" BorderThickness="0" Background="{TemplateBinding Background}"  KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                               
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="TextElement.Foreground" TargetName="templateRoot" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                                    <Setter Property="Background" TargetName="headerPanel" Value="{DynamicResource TabItem.Unselected.Background}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="0" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <Button x:Name="btnMsg" Style="{DynamicResource NoticeNormalButton}" Click="btnMsg_Click" MouseDoubleClick="btnMsg_MouseDoubleClick"></Button>
        <Popup x:Name="popMsg" PlacementTarget="{Binding ElementName=btnMsg}" Visibility="Collapsed"
                   StaysOpen="False" Width="344" MaxHeight="530" MouseDown="popMsg_MouseDown" MouseLeave="popMsg_MouseLeave"
                   AllowsTransparency="True">
                <local:MsgFloatView x:Name="msgFloatView"></local:MsgFloatView>
            <!--<Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <CustomUI:MsgFloatUI x:Name="firtMsg" Grid.Row="0" Visibility="Collapsed" Margin="0, 2, 0, 0" OnStoryboardComplete="OnStoryboardComplete"></CustomUI:MsgFloatUI>
                <CustomUI:MsgFloatUI x:Name="secondMsg" Grid.Row="1" Visibility="Collapsed" Margin="0, 2, 0, 0" OnStoryboardComplete="OnStoryboardComplete"></CustomUI:MsgFloatUI>
                <CustomUI:MsgFloatUI x:Name="threeMsg" Grid.Row="2" Visibility="Collapsed" Margin="0, 2, 0, 0" OnStoryboardComplete="OnStoryboardComplete"></CustomUI:MsgFloatUI>
            </Grid>-->
            
        </Popup>


        <Border x:Name="borderMain" BorderBrush="{DynamicResource ColorBrush.Gray18}" BorderThickness="1" Visibility="Collapsed" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown">
            <Grid x:Name="gMsg" Background="{DynamicResource MidnightBlueSilverBrush}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="20"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="20"></ColumnDefinition>
                    <ColumnDefinition Width="20"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TabControl x:Name="tcPlugin" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="6" Style="{DynamicResource MeTableControl}"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}" BorderThickness="0"  FontWeight="Bold" FontSize="12px" >

                    <TabItem x:Name="tabDo" Header="待办事项" Foreground="#FFEBC8" >
                        <CustomUI:MsgDetailUI x:Name="dealMsgUI" Margin="0, 0, 0, -1"></CustomUI:MsgDetailUI>
                    </TabItem>

                    <TabItem x:Name="tabMsgNotice" Header="消息提醒">
                        <CustomUI:MsgDetailUI x:Name="msgUI" Margin="0, 0, 0, -1"></CustomUI:MsgDetailUI>
                    </TabItem>
                    
                </TabControl>
                <!--BDB 关闭所有条件 -->
                <Button x:Name="btnSubscribe"  Grid.Column="2" Style="{DynamicResource SvgUnSubscribeBtn}" Foreground="{DynamicResource DefaultGridForground}" ToolTip="关闭所有条件"  Width="20" Height="20" Click="btnCloseAllMsgSetting_Click"/>

                <!--<Button x:Name="btnRestPopWin"  Grid.Column="3" Style="{DynamicResource ReSetSettingButton}" ToolTip="复位浮窗" Margin="1 0 0 0" Width="20" Height="20" Click="btnRestPopWin_Click"></Button>-->
                
                <Button x:Name="btnSetting"  Grid.Column="4" Style="{DynamicResource MainPageSettingButton}" ToolTip="提醒设置" Width="20" Height="20" Click="btnSetting_Click"></Button>

                <Button x:Name="btnClose" Style="{DynamicResource MainPageCloseButton}" MinHeight="10" MinWidth="10" Grid.Column="5" Width="20" Height="20" Background="{DynamicResource MidnightBlueSilverBrush}"
                        Click="btnClose_Click" IsCancel="True"></Button>

            </Grid>
        </Border>
    </Grid>
</UserControl>
