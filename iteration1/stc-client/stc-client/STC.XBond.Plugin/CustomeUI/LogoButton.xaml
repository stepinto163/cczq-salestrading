<UserControl x:Class="STC.XBond.Plugin.CustomUI.LogoButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Frame.CustomUI"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Width="189" Height="46">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DataGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternationCount" Value="1"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Margin" Value="0,0,0,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Height" Value="60"/>
                            <Setter Property="Background" Value="{StaticResource ColorBrush.Black7}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell" >
                        <Setter Property="BorderThickness" Value="0"/>
                        <!--<Setter Property="ToolTipService.ToolTip" Value="{Binding ToolText}"/>-->
                            <Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ColorBrush.Black8}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ColorBrush.Black8}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    
    <Grid>
        <Button x:Name="btnMenu" Style="{StaticResource MainPageImageMenuButton}" Click="btnMenu_Click" PreviewMouseDown="popMenu_PreviewMouseDown"/>

        <Popup x:Name="popMenu" PlacementTarget="{Binding ElementName=btnMenu}"
                   StaysOpen="False" Width="220" MaxHeight="420" Placement="Bottom" HorizontalOffset="30" 
                   PopupAnimation="Slide" AllowsTransparency="False">
            <Grid Background="{StaticResource ColorBrush.Black7}">
                <DataGrid x:Name="dgMenu" Margin="20 , 0, 20, 0"
                                  Background="Transparent"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"  
                                  MouseUp="dgMenu_MouseUp"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  Style="{StaticResource DataGridStyle}"
                          >
                    <DataGrid.Resources>
                        <Style x:Key="tbStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>

                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"></ColumnDefinition>
                                            <ColumnDefinition Width="120"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Margin="0" Width="60" Height="60">
                                            <TextBlock.Background>
                                                <ImageBrush ImageSource="{Binding Path=ShowImageSource}"></ImageBrush>
                                            </TextBlock.Background>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Path=Txt}" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold" Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource NormalContentFontSize}"></TextBlock>
                                    </Grid>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
