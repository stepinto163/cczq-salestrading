<UserControl x:Class="STC.XBond.Plugin.CustomUI.MsgFloatUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.CustomUI"
             mc:Ignorable="d" 
             d:DesignHeight="75" d:DesignWidth="300" Unloaded="UserControl_Unloaded" 
             MouseLeave="UserControl_MouseLeave" PreviewMouseDown="UserControl_PreviewMouseDown">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <Storyboard x:Key="sbFloat" Completed="Storyboard_Completed" Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                <ColorAnimation 
                From="#282828" To="#50282828" Duration="00:00:02" />
            </Storyboard>
            
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Border Width="300" x:Name="border" BorderThickness="1">
            <Grid x:Name="grid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition ></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="tbContentType" Text="test" Grid.Column="0" Grid.Row="0" Margin="10, 10, 0, 0" HorizontalAlignment="Left" 
                           FontSize="12"  Height="18"
                           FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Content}"/>
                <Grid Grid.Column="1" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition ></ColumnDefinition>
                        <ColumnDefinition ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="tbStatus"  Text="status" Width="50" Grid.Column="0" Grid.Row="0" FontSize="10"
                            Margin="0, 10, 0, 0" Visibility="{Binding StatusVisibility}"/>
                    <TextBlock x:Name="tbValuetime"  Text="203:0230:00" Width="101" Visibility="{Binding ValueTimeVisibility}" Margin="0, 10, 0, 0" 
                               Grid.Column="1" Grid.Row="0"
                               FontSize="10">
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="tbUpdatetime"  Text="4645646" Grid.Column="0" Grid.Row="3" Margin="10, 3, 10, 0" 
                            FontSize="10"/>
                <TextBlock Text="gdgdfgdg" x:Name="tbCloseBy" Visibility="Collapsed"
                           Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" FontSize="{StaticResource SmallContentFontSize}" 
                           FontWeight="Bold" Margin="10, 0, 0, 0" />

                <TextBlock x:Name="tbContent" Text="dgdfgdfgdfg" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" HorizontalAlignment="Left" 
                           FontSize="{StaticResource SmallContentFontSize}" 
                                                                Margin="10, 0, 0, 0" />
                <Grid Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Margin="20, 0 ,0 ,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"></ColumnDefinition>
                        <ColumnDefinition Width="72"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    
                    <Button x:Name="btnPopKnow" Click="btnPopKnow_Click" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right"
                            Margin="2 , 13, 0, 0" Width="20" Height="20" Style="{StaticResource MainPageNoticeCloseButton}">
                        <Button.ToolTip>
                            <ToolTip Content="知道了" Background="{StaticResource ColorBrush.Gray15}" Width="50" Height="24" Foreground="{StaticResource ColorBrush.white}" 
                                     FontSize="10"></ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <Button x:Name="btnPopDeal" Click="btnPopDeal_Click" Style="{StaticResource MainPageNoticeDealButton}" HorizontalAlignment="Right"
                            Margin="2 , 13, 35, 0" Width="20" Height="20" Grid.Column="1" Grid.Row="0">
                        <Button.ToolTip>
                            <ToolTip Content="去处理" Background="{StaticResource ColorBrush.Gray15}" Width="50" Height="24" Foreground="{StaticResource ColorBrush.white}" 
                                     FontSize="10"></ToolTip>
                        </Button.ToolTip>
                    </Button>

                    <Button x:Name="btnLook" Click="btnLook_Click" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right"
                            Margin="2 , 13, 35, 0" Width="20" Height="20" Style="{StaticResource MainPageNoticeLookButton}">
                        <Button.ToolTip>
                            <ToolTip Content="查看" Background="{StaticResource ColorBrush.Gray15}" Width="50" Height="24" Foreground="{StaticResource ColorBrush.white}" 
                                     FontSize="10"></ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
