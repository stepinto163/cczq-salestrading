<UserControl x:Class="STC.XBond.Plugin.CustomeUI.ValetDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.XBond.Plugin.CustomeUI"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="510" Height="140" Width="570" Margin="0, 3, 0, 0" >

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <TextBox Text="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, StringFormat=yyy-MM-dd}"
                                     BorderThickness="0" Background="{StaticResource ColorBrush.Gray15}" FontSize="12" 
                                     Foreground="{StaticResource ColorBrush.While}" Padding="0, 5, 0, 0" TextAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DatePickStyleBtns" TargetType="{x:Type Button}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent">
                                <Border.Background>
                                    <ImageBrush ImageSource="../Images/stc_button_dropdownarrow_normal.png"/>
                                </Border.Background>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>-->
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            
            <Style x:Key="DatePickerStyle" TargetType="{x:Type DatePicker}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="IsTodayHighlighted" Value="True"/>
                <Setter Property="SelectedDateFormat" Value="Short"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint=".5,0" StartPoint=".5,1">
                            <GradientStop Color="#FFA3AEB9" Offset="0"/>
                            <GradientStop Color="#FF8399A9" Offset="0.375"/>
                            <GradientStop Color="#FF718597" Offset="0.375"/>
                            <GradientStop Color="#FF617584" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DatePicker}">
                            <Border x:Name="PART_Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <!--<VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        -->
                                <!--<VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PART_DisabledVisual"/>
                                            </Storyboard>
                                        </VisualState>-->
                                <!--
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>-->
                                <Grid x:Name="PART_Root" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid.Resources>
                                        <SolidColorBrush x:Key="DisabledBrush" Color="#A5FFFFFF"/>
                                        <ControlTemplate x:Key="DropDownButtonTemplate" TargetType="{x:Type Button}">
                                            <Grid>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualStateGroup.Transitions>
                                                            <VisualTransition GeneratedDuration="0"/>
                                                            <VisualTransition GeneratedDuration="0:0:0.1" To="MouseOver"/>
                                                            <VisualTransition GeneratedDuration="0:0:0.1" To="Pressed"/>
                                                        </VisualStateGroup.Transitions>
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Duration="0" To="#FF448DCA" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Storyboard.TargetName="Background"/>
                                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[3].(GradientStop.Color)" Storyboard.TargetName="BackgroundGradient">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="#7FFFFFFF"/>
                                                                </ColorAnimationUsingKeyFrames>
                                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)" Storyboard.TargetName="BackgroundGradient">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="#CCFFFFFF"/>
                                                                </ColorAnimationUsingKeyFrames>
                                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)" Storyboard.TargetName="BackgroundGradient">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="#F2FFFFFF"/>
                                                                </ColorAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Storyboard.TargetName="Background">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="#FF448DCA"/>
                                                                </ColorAnimationUsingKeyFrames>
                                                                <DoubleAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Highlight">
                                                                    <SplineDoubleKeyFrame KeyTime="0" Value="1"/>
                                                                </DoubleAnimationUsingKeyFrames>
                                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)" Storyboard.TargetName="BackgroundGradient">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="#EAFFFFFF"/>
                                                                </ColorAnimationUsingKeyFrames>
                                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[2].(GradientStop.Color)" Storyboard.TargetName="BackgroundGradient">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="#C6FFFFFF"/>
                                                                </ColorAnimationUsingKeyFrames>
                                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[3].(GradientStop.Color)" Storyboard.TargetName="BackgroundGradient">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="#6BFFFFFF"/>
                                                                </ColorAnimationUsingKeyFrames>
                                                                <ColorAnimationUsingKeyFrames BeginTime="0" Duration="00:00:00.001" Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)" Storyboard.TargetName="BackgroundGradient">
                                                                    <SplineColorKeyFrame KeyTime="0" Value="#F4FFFFFF"/>
                                                                </ColorAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled"/>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Grid Background="#11FFFFFF" FlowDirection="LeftToRight" HorizontalAlignment="Center" Height="18" Margin="0" VerticalAlignment="Center" Width="19">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20*"/>
                                                        <ColumnDefinition Width="20*"/>
                                                        <ColumnDefinition Width="20*"/>
                                                        <ColumnDefinition Width="20*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="23*"/>
                                                        <RowDefinition Height="19*"/>
                                                        <RowDefinition Height="19*"/>
                                                        <RowDefinition Height="19*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border x:Name="Highlight" BorderBrush="#FF45D6FA" BorderThickness="1" Grid.ColumnSpan="4" CornerRadius="0,0,1,1" Margin="-1" Opacity="0" Grid.Row="0" Grid.RowSpan="4"/>
                                                    <Border x:Name="Background" BorderBrush="#FFFFFFFF" BorderThickness="1" Background="#FF1F3B53" Grid.ColumnSpan="4" CornerRadius=".5" Margin="0,-1,0,0" Opacity="1" Grid.Row="1" Grid.RowSpan="3"/>
                                                    <Border x:Name="BackgroundGradient" BorderBrush="#BF000000" BorderThickness="1" Grid.ColumnSpan="4" CornerRadius=".5" Margin="0,-1,0,0" Opacity="1" Grid.Row="1" Grid.RowSpan="3">
                                                        <Border.Background>
                                                            <LinearGradientBrush EndPoint=".7,1" StartPoint=".7,0">
                                                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                                <GradientStop Color="#F9FFFFFF" Offset="0.375"/>
                                                                <GradientStop Color="#E5FFFFFF" Offset="0.625"/>
                                                                <GradientStop Color="#C6FFFFFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Rectangle Grid.ColumnSpan="4" Grid.RowSpan="1" StrokeThickness="1">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush EndPoint="0.3,-1.1" StartPoint="0.46,1.6">
                                                                <GradientStop Color="#FF4084BD"/>
                                                                <GradientStop Color="#FFAFCFEA" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                        <Rectangle.Stroke>
                                                            <LinearGradientBrush EndPoint="0.48,-1" StartPoint="0.48,1.25">
                                                                <GradientStop Color="#FF494949"/>
                                                                <GradientStop Color="#FF9F9F9F" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Stroke>
                                                    </Rectangle>
                                                    <Path Grid.ColumnSpan="4" Grid.Column="0" Data="M11.426758,8.4305077 L11.749023,8.4305077 L11.749023,16.331387 L10.674805,16.331387 L10.674805,10.299648 L9.0742188,11.298672 L9.0742188,10.294277 C9.4788408,10.090176 9.9094238,9.8090878 10.365967,9.4510155 C10.82251,9.0929432 11.176106,8.7527733 11.426758,8.4305077 z M14.65086,8.4305077 L18.566387,8.4305077 L18.566387,9.3435936 L15.671368,9.3435936 L15.671368,11.255703 C15.936341,11.058764 16.27293,10.960293 16.681133,10.960293 C17.411602,10.960293 17.969301,11.178717 18.354229,11.615566 C18.739157,12.052416 18.931622,12.673672 18.931622,13.479336 C18.931622,15.452317 18.052553,16.438808 16.294415,16.438808 C15.560365,16.438808 14.951641,16.234707 14.468243,15.826504 L14.881817,14.929531 C15.368796,15.326992 15.837872,15.525723 16.289043,15.525723 C17.298809,15.525723 17.803692,14.895514 17.803692,13.635098 C17.803692,12.460618 17.305971,11.873379 16.310528,11.873379 C15.83071,11.873379 15.399232,12.079271 15.016094,12.491055 L14.65086,12.238613 z" Fill="#FF2F2F2F" HorizontalAlignment="Center" Margin="4,3,4,3" Grid.Row="1" Grid.RowSpan="3" RenderTransformOrigin="0.5,0.5" Stretch="Fill" VerticalAlignment="Center"/>
                                                    <Ellipse Grid.ColumnSpan="4" Fill="#FFFFFFFF" HorizontalAlignment="Center" Height="3" StrokeThickness="0" VerticalAlignment="Center" Width="3"/>
                                                    <Border x:Name="DisabledVisual" BorderBrush="#B2FFFFFF" BorderThickness="1" Grid.ColumnSpan="4" CornerRadius="0,0,.5,.5" Opacity="0" Grid.Row="0" Grid.RowSpan="4"/>
                                                </Grid>
                                            </Grid>
                                        </ControlTemplate>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Button x:Name="PART_Button" Grid.Column="1" Width="25" Style="{StaticResource DatePickStyleBtns}"  Click="PART_Button_Click" Foreground="{StaticResource ColorBrush.While}" BorderThickness="0" Background="{StaticResource ColorBrush.Gray15}">

                                    </Button>
                                    <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Style="{StaticResource DatePickerTextBoxStyle}"/>
                                    <Grid x:Name="PART_DisabledVisual" Grid.ColumnSpan="2" Grid.Column="0" IsHitTestVisible="False" Opacity="0" Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#A5FFFFFF" RadiusY="1" Grid.Row="0" RadiusX="1"/>
                                        <Rectangle Grid.Column="1" Fill="#A5FFFFFF" Height="24" Margin="0" RadiusY="1" Grid.Row="0" RadiusX="1" Width="19"/>
                                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}" StaysOpen="False"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="false">
                                    <Setter Property="Foreground" TargetName="PART_TextBox" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </DataTrigger>


                                <!--<Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="PART_Border" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="DefalutTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Style>

            <Style x:Key="DataTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent" >
                                <Border.Background>
                                    <ImageBrush ImageSource="../Images/stc_button_dropdownarrow_normal.png"/>
                                </Border.Background>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>-->
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox" x:Key="ComboBoxStyle">
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="24"></Setter>
                            <Setter Property="MinWidth" Value="60"></Setter>
                            <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"></Setter>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Back" Background="{StaticResource ColorBrush.Gray15}"  BorderThickness="0,0,0,0" Padding="2, 0, 0, 0">
                                            <ContentPresenter ContentSource="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                                <Setter TargetName="Back" Property="BorderThickness" Value="1"></Setter>
                                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid Background="#3C3C3C">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBox  Grid.Column="0" BorderThickness="0" Background="{StaticResource ColorBrush.Gray15}"
                                  Text="{TemplateBinding Text}" Foreground="{StaticResource ColorBrush.While}" FontSize="12" Padding="2, 5, 0, 0">
                                </TextBox>
                                <Border  Grid.Column="0" BorderThickness="0" BorderBrush="#3C3C3C" CornerRadius="1">
                                    <TextBlock MouseDown="TextBlock_MouseDown"></TextBlock>
                                </Border>
                                <Border Grid.Column="1" BorderThickness="0" BorderBrush="#3C3C3C" CornerRadius="1">
                                    <ToggleButton Style="{StaticResource ComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"></ToggleButton>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource ColorBrush.Green3}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <VisualBrush x:Key="HintInstText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="客户机构名"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <VisualBrush x:Key="HintYieldText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="收益率(%)"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <VisualBrush x:Key="HintExchangeText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="客户交易员"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <VisualBrush x:Key="HintQtyText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="交易量"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <VisualBrush x:Key="HintPositionText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="席位号"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <ControlTemplate x:Key="InstTextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="false"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="border" Property="Background" Value="{StaticResource HintInstText}"/>
                    </MultiTrigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="YieldTextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="false"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="border" Property="Background" Value="{StaticResource HintYieldText}"/>
                    </MultiTrigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="ExTextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="false"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="border" Property="Background" Value="{StaticResource HintExchangeText}"/>
                    </MultiTrigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>


            <ControlTemplate x:Key="TextBoxQty" TargetType="{x:Type TextBox}">
                <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="false"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="border" Property="Background" Value="{StaticResource HintQtyText}"/>
                    </MultiTrigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="TextBoxPosition" TargetType="{x:Type TextBox}">
                <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="false"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="border" Property="Background" Value="{StaticResource HintPositionText}"/>
                    </MultiTrigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>



        </ResourceDictionary>
    </UserControl.Resources>

    <Border Height="140" Grid.Row="2" BorderThickness="0, 1, 0, 0" BorderBrush="{StaticResource ColorBrush.Gray20}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35*"></RowDefinition>
                <RowDefinition Height="65*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Button  Grid.Column="0" Width="18" Height="18" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10, 15, 0, 0" Content="-" Style="{StaticResource SmallConfirmBtnStyle}"
                     Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Gray15}" Click="Button_Click"></Button>

            <StackPanel Grid.Row="0" Orientation="Horizontal"  Grid.Column="1" Margin="0, 5, 0, 5">
                <CheckBox IsChecked="{Binding RemarksCheck, Mode=TwoWay}" Margin="15, 0, 2, 0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="2"  BorderBrush="{StaticResource ColorBrush.Gray15}" 
                               FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" Foreground="{StaticResource ColorBrush.While}"></CheckBox>
                <!--<TextBlock Text="备注" Style="{StaticResource DataTextBlockStyle}" VerticalAlignment="Center"/>-->

                <TextBox IsEnabled="{Binding RemarksCheck}" Visibility="{Binding PositionVisibility}" Width="55" Height="24" Margin="2, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource TextBoxPosition}"
                              Text="{Binding PostionTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Foreground="{StaticResource ColorBrush.While}" 
                         Background="{StaticResource ColorBrush.Black8}"
                             PreviewTextInput="tbAmount_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}"/>



                <ComboBox x:Name="cbSendPriceType" IsEnabled="{Binding RemarksCheck}" Visibility="{Binding SendPriceTypeVisibility}"   Height="24" SelectedIndex="0"  Width="55" SelectedItem="{Binding SendPriceType}"
                          Style="{StaticResource NonEditableComboBoxStyle}" Padding="2, 5, 0, 0">
                    <ComboBoxItem Content="待定" Tag="60"/>
                    <ComboBoxItem Content="发对话" Tag="1"/>
                    <ComboBoxItem Content="收对话" Tag="30"/>
                    <ComboBoxItem Content="发请求" Tag="4"/>
                    <ComboBoxItem Content="收请求" Tag="50"/>
                </ComboBox>



                <TextBox IsEnabled="{Binding RemarksCheck}" Width="70" Height="24" Margin="5, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource InstTextBoxControlTemplate1}"
                               Text="{Binding ClientInstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}" >
                </TextBox>
                <TextBox IsEnabled="{Binding ExchangeTxtEnable}" Width="70" Height="24" Margin="2, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource ExTextBoxControlTemplate1}"
                              Text="{Binding ClientExchanger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}"/>

                <TextBox IsEnabled="{Binding RemarksCheck}" Width="65" Height="24" Margin="2, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource YieldTextBoxControlTemplate1}"
                              Text="{Binding Yield, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}"
                         PreviewTextInput="tbYield_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}"/>

                
                <TextBox IsEnabled="{Binding RemarksCheck}" Width="55" Height="24" Margin="2, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource TextBoxQty}"
                              Text="{Binding ClientQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}"
                         PreviewTextInput="tbAmount_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}"/>

                <DatePicker x:Name="datePicker" Grid.Column="1" Width="95" Height="24" Margin="2, 0, 1, 0" IsEnabled="{Binding RemarksCheck}"
                                SelectedDate="{Binding SelectDate,Mode=TwoWay}"  Style="{DynamicResource DatePickerStyle}">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                <ComboBox x:Name="cbSettle" Grid.Column="2" Width="60"  IsEnabled="{Binding RemarksCheck}" Height="24" Padding="2, 3, 0, 0" SelectedIndex="{Binding SelectSetle}"  Style="{DynamicResource ComboBoxStyle}">
                    <ComboBoxItem Content="T+0" Tag="1"></ComboBoxItem>
                    <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>
                </ComboBox>

            </StackPanel>


            <Grid Grid.Row="1" Margin="10, 5, 20, 10" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <!--<TextBlock Text="操作：" Style="{StaticResource DefalutTextBlockStyle}" VerticalAlignment="Center"/>-->
                    <CheckBox IsChecked="{Binding PriceCheck, Mode=TwoWay}" Margin="5, 0, 5, 0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="2"  BorderBrush="{StaticResource ColorBrush.Gray15}" 
                                       Content="来自IDB"
                                      FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" Foreground="{StaticResource ColorBrush.While}"></CheckBox>
                    <ComboBox x:Name="cbIDB" IsEnabled="{Binding PriceCheck}" Grid.Column="2" Width="334"  Height="24" Padding="0, 3, 0, 0" SelectedItem="{Binding ComboxSelectedItem, Mode=TwoWay}"
                                          Style="{DynamicResource ComboBoxStyle}" ItemsSource="{Binding ComboxDatas}"
                                          DisplayMemberPath="ShowTxt" SelectedValuePath="NoMDEntry">
                        <!--<ComboBoxItem Content="T+0" Tag="1"></ComboBoxItem>
                                    <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>-->
                    </ComboBox>

                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0, 5, 0, 0" Visibility="{Binding IdbVisibility}">

                    <!--<CheckBox IsChecked="{Binding IdbRemarksCheck, Mode=TwoWay}" Margin="5, 0, 2, 0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="2"  BorderBrush="{StaticResource ColorBrush.Gray15}" 
                               FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" Foreground="{StaticResource ColorBrush.While}"></CheckBox>-->
                    <!--<TextBlock Text="备注" Style="{StaticResource DataTextBlockStyle}" VerticalAlignment="Center"/>-->

                    <TextBox IsEnabled="{Binding IdbRemarksCheck}" Visibility="{Binding IdbPositionVisibility}" Width="55" Height="24" Margin="26, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource TextBoxPosition}"
                              Text="{Binding IdbPostionTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Foreground="{StaticResource ColorBrush.While}" 
                         Background="{StaticResource ColorBrush.Black8}"
                             PreviewTextInput="tbAmount_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}"/>



                    <ComboBox x:Name="cbIdbSendPriceType" IsEnabled="{Binding IdbRemarksCheck}" Visibility="{Binding IdbSendPriceTypeVisibility}"   Height="24" SelectedIndex="0"  Width="55" SelectedItem="{Binding IdbSendPriceType}"
                          Style="{StaticResource NonEditableComboBoxStyle}" Padding="2, 5, 0, 0" Margin="26, 0, 0, 0">
                        <ComboBoxItem Content="待定" Tag="60"/>
                        <ComboBoxItem Content="发对话" Tag="1"/>
                        <ComboBoxItem Content="收对话" Tag="30"/>
                        <ComboBoxItem Content="发请求" Tag="4"/>
                        <ComboBoxItem Content="收请求" Tag="50"/>
                    </ComboBox>


                    <TextBox IsEnabled="{Binding IdbRemarksCheck}" Width="70" Height="24" Margin="5, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource InstTextBoxControlTemplate1}"
                               Text="{Binding IdbClientInstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}" >
                    </TextBox>

                    <TextBox IsEnabled="{Binding IdbExchangeTxtEnable}" Width="70" Height="24" Margin="2, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource ExTextBoxControlTemplate1}"
                              Text="{Binding IdbClientExchanger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}"/>


                    <TextBox IsEnabled="{Binding IdbRemarksCheck}" Width="65" Height="24" Margin="2, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource YieldTextBoxControlTemplate1}"
                              Text="{Binding IdbYield, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}"
                             PreviewTextInput="tbYield_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}"/>

                    
                    <TextBox IsEnabled="{Binding IdbRemarksCheck}" Width="55" Height="24" Margin="2, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource TextBoxQty}"
                              Text="{Binding IdbClientQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}"
                             PreviewTextInput="tbAmount_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}"/>


                    <DatePicker x:Name="idbDatePicker" Grid.Column="1" Width="95" Height="24" Margin="2, 0, 1, 0" IsEnabled="{Binding IdbRemarksCheck}"
                                SelectedDate="{Binding IdbSelectDate,Mode=TwoWay}"  Style="{DynamicResource DatePickerStyle}">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="IsReadOnly" Value="True"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>

                    <ComboBox x:Name="cbIdbSettle" Grid.Column="2" Width="60"  IsEnabled="{Binding IdbRemarksCheck}" Height="24" Padding="2, 3, 0, 0" SelectedIndex="{Binding IdbSelectSetle}"  Style="{DynamicResource ComboBoxStyle}">
                        <ComboBoxItem Content="T+0" Tag="1"></ComboBoxItem>
                        <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>
                    </ComboBox>

                </StackPanel>

            </Grid>


           
        </Grid>


    </Border>
</UserControl>
