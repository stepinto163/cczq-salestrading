<Window x:Class="STC.XBond.Plugin.CustomeUI.PriceMatchNewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.XBond.Plugin.CustomeUI"
        xmlns:Comp="clr-namespace:STC.XBond.Plugin.View.Order"
             mc:Ignorable="d" Background="Transparent"
             d:DesignHeight="470" d:DesignWidth="462" Height="470" Width="462"  WindowState="Normal"  WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        AllowsTransparency ="True" 
         WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="2" x:Name="Border_Left1" Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="#3C3C3C"  Background="#0A0F0E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="53"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{Binding BgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="16"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="7, 5, 0, 0" Height="24" Width="48" Text="价格匹配" Foreground="#FFFFFF" FontSize="{StaticResource SmallContentFontSize}"/>
                <Button  Grid.Column="2" Width="16" Height="16" Margin="0, 2, 3, 0" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="4, 5, 0, 0" Text="{Binding BatchPointPriceDomain.SecurityId}" Foreground="#F9C152" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontWeight="SemiBold" FontSize="{StaticResource FontSize-16}"></TextBlock>

                    <TextBlock Grid.Column="1" Margin="4, 5, 0, 0" Height="24" Text="{Binding BatchPointPriceDomain.Side}" Foreground="{Binding BatchPointPriceDomain.SideBrush}"
                           FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                           FontWeight="Black"  FontSize="{StaticResource FontSize-16}"></TextBlock>

                    <TextBlock Grid.Column="2" Margin="4, 5, 0, 0" Text="{Binding BatchPointPriceDomain.Price}" Foreground="#F9C152" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontWeight="SemiBold" FontSize="{StaticResource FontSize-16}"></TextBlock>
                    <TextBlock Grid.Column="3" Margin="4, 5, 0, 0" Text="{Binding BatchPointPriceDomain.Qty}" Foreground="#F9C152" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontWeight="SemiBold" FontSize="{StaticResource FontSize-16}"></TextBlock>
                    <Image x:Name="bargainFlag_Img" Grid.Column="4" Width="14" Height="14" Source="/STC.XBond.Plugin;component/Images/stc_tag_list_shandian_14x14.png"/>
                </Grid>

                <Comp:PriceTableView Grid.Row="1"></Comp:PriceTableView>
            </Grid>

            <Border Grid.Row="2" BorderThickness="0, 1, 0, 0" BorderBrush="{StaticResource ColorBrush.Gray15}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="16"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="62"></ColumnDefinition>
                        <ColumnDefinition Width="110"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="16, 0, 0, 0" Text="{Binding BatchPointPriceDomain.ClickQty}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource FontFamily.Roboto}" FontSize="{StaticResource FontSize-24}"
                               Foreground="{Binding BatchPointPriceDomain.SideBrush}"></TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding BatchPointPriceDomain.MatchTotalQty}" Margin="0, 0, 5, 0" FontFamily="{StaticResource FontFamily.Roboto}" FontSize="{StaticResource FontSize-18}" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                    <TextBlock Grid.Column="2" Text="kw" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{StaticResource FontSize-12}" FontFamily="{StaticResource FontFamily.Roboto}"
                               Foreground="{StaticResource ColorBrush.Gray14}"></TextBlock>

                    <Button Grid.Column="4"  Margin="0,0,2,0" Content="取消" Command="{Binding CancelCommand}" FontSize="12"
                        Style="{StaticResource CancelPriceButton}" Width="60" Height="24" HorizontalAlignment="Right"/>
                    <Button Grid.Column="5" Margin="2,0,0,0" Content="{Binding BatchPointPriceDomain.SendPriceTxt}"  Command="{Binding OkCommand}" FontSize="12" HorizontalAlignment="Left"
                        Style="{StaticResource SendPriceButton}" Width="100" Height="24" />

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
