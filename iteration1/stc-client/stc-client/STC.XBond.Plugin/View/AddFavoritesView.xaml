<comp:WindowBase x:Class="STC.XBond.Plugin.View.AddFavoritesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.View"
        xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Title="债券分组管理" Width="400" SizeToContent="Height" ResizeMode="NoResize">
    <comp:WindowBase.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->

            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <ItemsPanelTemplate x:Key="ItemsPanelTemplate_Groups">
                <!--<VirtualizingStackPanel IsItemsHost="True"/>-->
                <WrapPanel  Orientation="Horizontal" IsItemsHost="True"/>
            </ItemsPanelTemplate>
            <DataTemplate x:Key="DataTemplate_group">
                <Grid>
                    <CheckBox Content="{Binding GroupName}" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              Width="150" Height="30" Foreground="#A0A0A0" Padding="10,0,0,0"  Style="{DynamicResource DefaultCheckBoxStyle}"/>
                </Grid>

            </DataTemplate>
            <ControlTemplate x:Key="ListBoxControlTemplate" TargetType="{x:Type ListBox}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <WrapPanel Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ScrollViewer>
            </ControlTemplate>
        </ResourceDictionary>
    </comp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <ListBox Margin="30" ItemsSource="{Binding GroupsList}" Background="Transparent" ItemsPanel="{DynamicResource ItemsPanelTemplate_Groups}" ItemTemplate="{DynamicResource DataTemplate_group}" Template="{DynamicResource ListBoxControlTemplate}">
            <ListBox.Resources>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                    <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                    <Setter Property="Foreground" Value="#A0A0A0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Grid MinHeight="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Bd" Grid.Column="1" CornerRadius="1" VerticalAlignment="Center" BorderBrush="Transparent" 
                                            BorderThickness="0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="Cp" 
                                                          TextElement.FontSize="{TemplateBinding FontSize}" 
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
        </ListBox>
        <Border Grid.Row="1" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
                <Button x:Name="btnAddGroup" Width="100" Height="24" Style="{DynamicResource BlueGreenStyle}"
                            Click="btnAddGroup_Click">新建关注组</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnOK_Click" >确定</Button>
                <Button x:Name="btnCancel" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnCancel_Click" >取消</Button>
            </StackPanel>

        </Border>
    </Grid>
</comp:WindowBase>
