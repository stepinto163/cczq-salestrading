<UserControl x:Class="STC.XBond.Plugin.View.HistoryOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:ViewModel="clr-namespace:STC.XBond.Plugin.ViewModel" 
             xmlns:customeUI="clr-namespace:STC.XBond.Plugin.CustomeUI"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" 
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:fcon="clr-namespace:STC.XBond.Plugin.Convertor"
             xmlns:utils="clr-namespace:STC.XBond.Plugin.Utils"
             xmlns:command ="clr-namespace:STC.XBond.Plugin.Command"
             xmlns:component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1200" Initialized="UserControl_Initialized" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <sys:String x:Key="TimeFormatHHMMSS">HH:mm:ss</sys:String>
            <sys:String x:Key="TimeFormatYYYYMMDD">yyyy-MM-dd</sys:String>
            <!--yyyy-MM-dd-->
            <sys:String x:Key="TimeFormatMMDDHHMM">MM-dd HH:mm</sys:String>
            <!--MM-dd HH:mm-->
            <sys:String x:Key="TimeFormatYYYYMMDD2">yyyyMMdd</sys:String>

            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:SettleTypeConvertor x:Key="settleTypeConvertor"/>
            <fcon:TreasuryFutureConvertor x:Key="treasuryFutureConverter"/>
            <fcon:BondFieldConvertor x:Key="bondFieldConverter"/>
            <fcon:FormatDateTimeConvertor x:Key="FormatDateTimeConvertor"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="True"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            </Style>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StatusColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ExecType}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ExecType}" Value="4">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ExecType}" Value="8">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StatusColumnColorStyle2" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ExecType2}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ExecType2}" Value="4">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ExecType2}" Value="8">
                        <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" MouseEnter="ContentPresenter_MouseEnter">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="textBlock" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="VGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{DynamicResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <Rectangle Width="12" Height="1" Stroke="{StaticResource DefaultForegroup.ColorBrush}" Margin="0,2,0,2"/>
                                    <Rectangle Width="12" Height="1" Stroke="{StaticResource DefaultForegroup.ColorBrush}" Margin="0,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <local:HistoryFilterPanel x:Name="historyOrderFilter" FilterDicChanged="historyOrderFilter_FilterDicChanged"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ComboBox x:Name="orderComboBox" Margin="20,0,0,0" Width="90"  Height="18" 
                          VerticalAlignment="Center" SelectedIndex="0" 
                          Style="{DynamicResource NonEditableComboBoxStyle}"
                          SelectionChanged="orderComboBox_SelectionChanged">
                    <ComboBoxItem Content="STC订单号" Tag="1"/>
                    <ComboBoxItem Content="债券代码" Tag="2"/>
                    <ComboBoxItem Content="债券简称" Tag="3"/>
                </ComboBox>
                <TextBox Width="130" Height="18" Padding="5, 0, 0, 0" 
                         Style="{StaticResource HistoryTextBoxStyle}" 
                         x:Name="orderTextBox"
                         Margin="5,0"
                         KeyDown="orderTextBox_KeyDown"
                         TextChanged="orderTextBox_TextChanged"
                         LostFocus="orderTextBox_LostFocus"
                         input:TextCompositionManager.PreviewTextInput="orderTextBox_PreviewTextInput"
                         input:TextCompositionManager.PreviewTextInputUpdate="orderTextBox_PreviewTextInputUpdate"/>
                <Button x:Name="btnExport" Width="24" Height="24" 
                        HorizontalAlignment="Left" VerticalAlignment="Center" 
                        Style="{DynamicResource ExportButton}" 
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>
            <component:ExDataGrid Grid.Row="1" x:Name="History_Orders_dataGrid" ItemsSource="{Binding OrdersDV,UpdateSourceTrigger=PropertyChanged}" 
                      SelectedItem="{Binding SelectedItem_Orders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource DefaultDataGrid}" LoadingRow="Orders_dataGrid_LoadingRow"
                      MouseDoubleClick="Orders_dataGrid_MouseDoubleClick"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Standard"
                      ScrollViewer.IsDeferredScrollingEnabled="True" RowHeaderWidth="0" DefaultHideColumns="报价(权%),Ofr报价(权%)">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="auto" MaxWidth="80" Header="序号" MinWidth="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridComboBoxColumn ItemsSource="{x:Static ViewModel:HistoryOrderViewModel.SideItemSource}" 
                                                    SelectedValueBinding="{Binding Side}" 
                                                    ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                    SelectedValuePath="Key" DisplayMemberPath="Value"  
                                                    Header="方向" Width="auto" MaxWidth="70" CellStyle="{StaticResource ColumnColorStyle}" IsReadOnly="True" MinWidth="40"/>
                    <DataGridTextColumn Binding="{Binding SecurityID}" Header="代码" Width="auto" MaxWidth="120" FontWeight="SemiBold" MinWidth="90"/>
                    <DataGridTextColumn Binding="{Binding Symbol}" Header="简称" Width="auto" MaxWidth="170" FontWeight="SemiBold" MinWidth="140"/>
                    <DataGridTextColumn Binding="{Binding BookName}" Header="组合" Width="Auto" FontWeight="SemiBold"/>
                    <DataGridTextColumn ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                        Header="清算速度" Width="Auto" MinWidth="70" MaxWidth="100">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource settleTypeConvertor}" ConverterParameter="settletype_tooltip" >
                                            <Binding Path="MarketIndicator"/>
                                            <Binding Path="SettlType"/>
                                            <Binding Path="SecurityID"/>
                                        </MultiBinding>
                                    </Setter.Value>                                    
                                </Setter>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource settleTypeConvertor}" ConverterParameter="settletype_myOrder" >
                                <Binding Path="MarketIndicator"/>
                                <Binding Path="SettlType"/>
                                <Binding Path="SecurityID"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="意向" Width="auto" MaxWidth="70" MinWidth="40" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}"
                                            ClipboardContentBinding="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag'}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding STCCode}" Header="STC单号" Width="auto" MaxWidth="170" MinWidth="140"/>
                    <DataGridTextColumn Binding="{Binding TimeInForce}" Header="类型" Width="auto" MaxWidth="110" MinWidth="80"/>
                    <DataGridTextColumn Binding="{Binding ExecType,ConverterParameter=ordstatus, 
                        Converter={StaticResource EnumTypeConvertor}}" 
                        Header="状态" Width="auto" MaxWidth="96"
                        CellStyle="{StaticResource StatusColumnColorStyle}" MinWidth="66"/>
                    <DataGridTextColumn Binding="{Binding SendOrderType}" Header="执行类型" Width="Auto"  MinWidth="80"/>

                    <DataGridTextColumn Header="报价(%)" Width="auto" MaxWidth="85" MinWidth="55" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Price">
                                <Binding Path="Yield" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Price" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="报价(原)" Width="auto" MaxWidth="96" MinWidth="66" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Price">
                                <Binding Path="Price" />
                                <Binding Path="MarketIndicator" />
                                <!--<Binding Source="Price" />-->
                                <Binding Path="MinChange" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="报价(权%)" Width="auto" MaxWidth="96" MinWidth="66" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Price">
                                <Binding Path="YieldToExecution" />
                                <Binding Path="MarketIndicator" />
                                <!--<Binding Source="Price" />-->
                                <Binding Path="MinChange" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding NetPrice,StringFormat={}{0:N4}}" Header="净价(元)" Width="auto" MaxWidth="100" MinWidth="70" FontWeight="SemiBold" SortMemberPath="NetPrice1"/>
                    <!--<DataGridTextColumn Binding="{Binding WholeFlag, ConverterParameter=wholeflag, Converter={StaticResource EnumTypeConvertor}}" Header="整量" Width="Auto" MinWidth="80"/>-->
                    <DataGridTemplateColumn Header="报量(万元)" Width="auto" MaxWidth="100" MinWidth="70" CellStyle="{StaticResource DataGridCellStyle1}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Amount">
                                                <Binding Path="Qty" />
                                                <Binding Path="MarketIndicator" />
                                                <Binding Source="Amount" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Border x:Name="wholeTag" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed">
                                        <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                                        <Setter TargetName="wholeTag" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="报量(手)" Width="Auto" MinWidth="50" MaxWidth="80">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Amount">
                                <Binding Path="Qty" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Amount" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <!--<DataGridTextColumn Binding="{Binding DealingQty}" Header="已处理(万元)" Width="Auto" MinWidth="80"/>-->
                    <DataGridTextColumn Header="已成交(万元)" Width="Auto" MinWidth="70" MaxWidth="100">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Amount">
                                <Binding Path="ExecQty" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Amount" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="已成交(手)" Width="Auto" MinWidth="60" MaxWidth="90">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Amount">
                                <Binding Path="ExecQty" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Amount" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding OffsetFlag}" Header="开平标志" Width="Auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTextColumn Binding="{Binding HedgeFlag}" Header="投机套保" Width="Auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTextColumn Binding="{Binding CapAccount}" Header="资金账号" Width="Auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTextColumn Binding="{Binding ExecType2,ConverterParameter=ordstatus, 
                        Converter={StaticResource EnumTypeConvertor}}" 
                        Header="Ofr状态" Width="Auto" MinWidth="55" MaxWidth="85"
                        CellStyle="{StaticResource StatusColumnColorStyle2}"/>
                    <DataGridTextColumn Binding="{Binding Yield2,Converter={StaticResource numConvertor},ConverterParameter=''}" Header="Ofr报价(%)" Width="Auto" MinWidth="66" MaxWidth="96" Foreground="{DynamicResource ColorBrush.Blue}"/>
                    <DataGridTextColumn Header="Ofr报价(原)" Width="auto" MaxWidth="96" MinWidth="66" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Price">
                                <Binding Path="Price2" />
                                <Binding Path="MarketIndicator" />
                                <!--<Binding Source="Price" />-->
                                <Binding Path="MinChange" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ofr报价(权%)" Width="auto" MaxWidth="96" MinWidth="66" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Price">
                                <Binding Path="YieldToExecution2" />
                                <Binding Path="MarketIndicator" />
                                <!--<Binding Source="Price" />-->
                                <Binding Path="MinChange" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding NetPrice2,StringFormat={}{0:N4}}" Header="Ofr净价(元)" Width="auto" MinWidth="66" MaxWidth="96" FontWeight="SemiBold" SortMemberPath="NetPrice3"/>
                    <DataGridTextColumn Binding="{Binding Qty2}" Header="Ofr报量(万元)" Width="Auto" MinWidth="60" MaxWidth="90" CellStyle="{StaticResource DataGridCellStyle1}">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ExecQty2}" Header="Ofr已成交(万元)" Width="Auto" MinWidth="90" MaxWidth="120"/>

                    <DataGridTextColumn Binding="{Binding MyDealer}" Header="本方交易员" Width="Auto" MinWidth="70" MaxWidth="100"/>

                    <DataGridTemplateColumn Header="备注" Width="Auto" MinWidth="140" IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding OrdRejReason}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OrdRejReason}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Veneues,ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" Header="报价方式" Width="auto" MinWidth="55" MaxWidth="85"/>
                    <DataGridTextColumn Binding="{Binding CrossVenues,ConverterParameter=crossvenues, Converter={StaticResource EnumTypeConvertor}}" Header="撮合范围" Width="auto" MinWidth="55" MaxWidth="85"/>

                    <DataGridTemplateColumn Header="渠道" Width="auto" MinWidth="80" MaxWidth="110" IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding VenuesSelectDisplay}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding VenuesSelectDisplay}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding QuantID}" Header="策略名" Width="auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTextColumn Header="创建日期" Binding="{Binding createDate,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}"
                                         Width="auto" MinWidth="80" MaxWidth="110"/>

                    <!--<DataGridTextColumn Binding="{Binding VenuesSelectF}" Header="VenuesSelectF" Width="Auto"  MinWidth="70"/>
                            <DataGridTextColumn Binding="{Binding VenuesRdmNum}" Header="VenuesRdmNum" Width="Auto"  MinWidth="70"/>
                            <DataGridTextColumn Binding="{Binding SelfSelectVenues}" Header="SelfSelectVenues" Width="Auto"  MinWidth="70"/>-->
                    <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}" Header="最后更新日期" Width="auto" MinWidth="80" MaxWidth="110"/>
                    <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" Header="最后更新时间" Width="auto" MinWidth="80" MaxWidth="110"/>
                    <DataGridTemplateColumn Header="投组账户" Width="auto" MinWidth="70" MaxWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="#FFFFFF" 
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}-{1}">
                                            <Binding Path="AccountId"/>
                                            <Binding Path="AccountName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding BBVol}" Header="BB-Vol(万)" Width="auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTextColumn Binding="{Binding BBPx}" Header="BB-Px(%)" Width="auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTextColumn Binding="{Binding BOVol}" Header="BO-Vol(万)" Width="auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTextColumn Binding="{Binding BOPx}" Header="BO-Px(%)" Width="auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTemplateColumn Width="auto" MaxWidth="30" MinWidth="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Expander Style="{StaticResource DefaultExpander}" 
                                                            x:Name="expander" 
                                                            IsExpanded="{Binding IsExpanded}" 
                                                            Expanded="Expander_Expanded" 
                                                            Collapsed="Expander_Collapsed" 
                                                            BorderThickness="0">
                                </Expander>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </component:ExDataGrid>
            <!--<component:PageUI  Grid.Row="2" HorizontalAlignment="Right"/>-->
            <component:PageControl x:Name="pageControl" Grid.Row="2" HorizontalAlignment="Right" 
                                   PageChanged="pageControl_PageChanged" 
                                   Visibility="{Binding PageVisible,Converter={StaticResource visibilityConvertor}}"/>
            <fUI:LoadingMask x:Name="loadMask" Visibility="Collapsed" Grid.RowSpan="3" Grid.Row="0"></fUI:LoadingMask>
        </Grid>
        <GridSplitter x:Name="gridSplitter" Grid.Row="1" Background="{DynamicResource MainBackgroup.ColorBrush}" Style="{DynamicResource VGridSplitterStyle2}"/>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="STC订单号：" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
                <TextBlock x:Name="stcCodeTextBox" Grid.Column="1" Width="160"  Height="18" 
                         VerticalAlignment="Center" 
                         Text="{Binding SelectSTCCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                                             
                         KeyDown="TextBox_KeyDown" IsEnabled="False" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}">
                </TextBlock>
                <Button Grid.Column="3" Style="{DynamicResource ExportButton}" HorizontalAlignment="Right" Width="24" Height="24" Command="{Binding EMSExportCommand}"/>
            </Grid>
            <local:HistoryEMSFilterPanel x:Name="EMSFilterPanel" Grid.Row="1" Grid.Column="0" FilterDicChanged="EMSFilterPanel_FilterDicChanged"/>
            <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal">
                <ComboBox x:Name="emsOrderCombox" Margin="20,0,0,0" Width="90"  Height="18" 
                          VerticalAlignment="Center" 
                          SelectedIndex="0" 
                          Style="{DynamicResource NonEditableComboBoxStyle}"
                          SelectionChanged="emsOrderCombox_SelectionChanged">
                    <ComboBoxItem Content="STC订单号" Tag="1" IsSelected="True"/>
                    <ComboBoxItem Content="债券代码" Tag="2"/>
                    <ComboBoxItem Content="债券简称" Tag="3"/>
                </ComboBox>
                <TextBox x:Name="emsOrderTextBox" Width="130" Height="18" Padding="5, 0, 0, 0" 
                         Style="{DynamicResource HistoryTextBoxStyle}" 
                         Margin="5,0"
                         KeyDown="emsOrderTextBox_KeyDown"
                         TextChanged="emsOrderTextBox_TextChanged"
                         input:TextCompositionManager.PreviewTextInput="emsOrderTextBox_PreviewTextInput"
                         input:TextCompositionManager.PreviewTextInputUpdate="emsOrderTextBox_PreviewTextInputUpdate"/>
                <Button Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource PopupButton}" Visibility="Collapsed"/>

            </StackPanel>
            <component:ExDataGrid Grid.Row="2" Grid.ColumnSpan="3" x:Name="History_EmsOrders_DataGrid" ItemsSource="{Binding EMSOrdersDV}" 
                      Style="{DynamicResource DefaultDataGrid}" VirtualizingStackPanel.VirtualizationMode="Standard"
                      LoadingRow="emsDataGrid_LoadingRow" RowHeaderWidth="0" DefaultHideColumns="报价(权%),Ofr报价(权%)">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="auto" Header="序号" MinWidth="50" MaxWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type DataGridRow}}, Path=Header}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridComboBoxColumn ItemsSource="{x:Static ViewModel:MyTraderViewModel.SideItemSource}" 
                                                SelectedValueBinding="{Binding Side, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                SelectedValuePath="Key" DisplayMemberPath="Value"  
                                                Header="方向" Width="auto" MinWidth="40" MaxWidth="70" CellStyle="{StaticResource ColumnColorStyle}" IsReadOnly="True"/>
                    <DataGridTextColumn Binding="{Binding SecurityID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="代码" Width="auto" FontWeight="SemiBold" MinWidth="90" MaxWidth="120"/>
                    <DataGridTextColumn Binding="{Binding Symbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="简称" Width="auto" FontWeight="SemiBold" MinWidth="140" MaxWidth="170"/>
                    <DataGridTextColumn Binding="{Binding BookName}" Header="组合" Width="Auto" FontWeight="SemiBold"/>
                    <DataGridTextColumn ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                        Header="清算速度" Width="Auto" MinWidth="70" MaxWidth="100">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource settleTypeConvertor}" ConverterParameter="settletype_tooltip" >
                                            <Binding Path="MarketIndicator"/>
                                            <Binding Path="SettlType"/>
                                            <Binding Path="SecurityID"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource settleTypeConvertor}" ConverterParameter="settletype_myOrder" >
                                <Binding Path="MarketIndicator"/>
                                <Binding Path="SettlType"/>
                                <Binding Path="SecurityID"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="意向" Width="auto" MinWidth="40" MaxWidth="70" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}" 
                                            ClipboardContentBinding="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag'}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding StrategyOrderId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="STC单号" Width="auto" MinWidth="140" MaxWidth="170"/>
                    <DataGridTextColumn Binding="{Binding STCCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="外部订单" Width="auto" MinWidth="140" MaxWidth="170"/>
                    <!--<DataGridTextColumn Binding="{Binding ExecID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="STC成交单" Width="4*"/>-->
                    <DataGridTextColumn Binding="{Binding TimeInForce, Mode=TwoWay, 
                        UpdateSourceTrigger=PropertyChanged}" Header="类型" Width="auto" MinWidth="80" MaxWidth="110"/>
                    <DataGridTextColumn Binding="{Binding ExecType,ConverterParameter=ordstatus, 
                        Converter={StaticResource EnumTypeConvertor}, Mode=TwoWay, 
                        UpdateSourceTrigger=PropertyChanged}" Header="状态" Width="auto" MinWidth="66" MaxWidth="96"
                        CellStyle="{StaticResource StatusColumnColorStyle}"/>

                    <DataGridTextColumn Header="报价(%)" Width="auto" MinWidth="55" MaxWidth="85" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Price">
                                <Binding Path="Yield" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Price" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="报价(原)" Width="auto" MinWidth="66" MaxWidth="96" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Price">
                                <Binding Path="Price" />
                                <Binding Path="MarketIndicator" />
                                <!--<Binding Source="Price" />-->
                                <Binding Path="MinChange" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="报价(权%)" Width="auto" MinWidth="55" MaxWidth="85" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Price">
                                <Binding Path="YieldToExecution" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Price" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding NetPrice,StringFormat={}{0:N4}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="净价(元)" Width="auto" MaxWidth="100" MinWidth="70"  FontWeight="SemiBold" SortMemberPath="NetPrice1"/>
                    <!--<DataGridTextColumn Binding="{Binding WholeFlag, ConverterParameter=wholeflag, Converter={StaticResource EnumTypeConvertor}}" Header="整量" Width="Auto" MinWidth="80"/>-->
                    <DataGridTemplateColumn Header="报量(万元)" Width="auto" MinWidth="70" MaxWidth="100" CellStyle="{StaticResource DataGridCellStyle1}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Amount">
                                                <Binding Path="Qty" />
                                                <Binding Path="MarketIndicator" />
                                                <Binding Source="Amount" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Border x:Name="wholeTag" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed">
                                        <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                                        <Setter TargetName="wholeTag" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="报量(手)" Width="Auto" MinWidth="50" MaxWidth="80">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Amount">
                                <Binding Path="Qty" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Amount" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <!--<DataGridTextColumn Binding="{Binding DealingQty}" Header="已处理(万元)" Width="Auto" MinWidth="80"/>-->
                    <DataGridTextColumn Header="已成交(万元)" Width="auto" MinWidth="70" MaxWidth="100">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Amount">
                                <Binding Path="ExecQty" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Amount" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="已成交(手)" Width="auto" MinWidth="60" MaxWidth="90">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Amount">
                                <Binding Path="ExecQty" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Amount" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding OffsetFlag}" Header="开平标志" Width="Auto" MinWidth="80" MaxWidth="110"/>
                    <DataGridTextColumn Binding="{Binding HedgeFlag}" Header="投机套保" Width="Auto" MinWidth="80" MaxWidth="110"/>
                    <DataGridTextColumn Binding="{Binding CapAccount}" Header="资金账号" Width="Auto" MinWidth="80" MaxWidth="110"/>
                    
                    <DataGridTextColumn Binding="{Binding ExecType2,ConverterParameter=ordstatus, 
                        Converter={StaticResource EnumTypeConvertor}}" 
                        Header="Ofr状态" Width="auto" MinWidth="55" MaxWidth="85"
                        CellStyle="{StaticResource StatusColumnColorStyle2}"/>
                    <DataGridTextColumn Binding="{Binding Yield2,Converter={StaticResource numConvertor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ConverterParameter=''}" Header="Ofr报价(%)" Width="auto" MinWidth="66" MaxWidth="96" Foreground="{DynamicResource ColorBrush.Blue}"/>

                    <DataGridTextColumn Header="Ofr报价(原)" Width="auto" MinWidth="66" MaxWidth="96" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Price">
                                <Binding Path="Price2" />
                                <Binding Path="MarketIndicator" />
                                <!--<Binding Source="Price" />-->
                                <Binding Path="MinChange" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ofr报价(权%)" Width="auto" MinWidth="55" MaxWidth="85" CellStyle="{StaticResource ColumnColorStyle}">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Price">
                                <Binding Path="YieldToExecution2" />
                                <Binding Path="MarketIndicator" />
                                <Binding Source="Price" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding NetPrice2,StringFormat={}{0:N4}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Ofr净价(元)" Width="auto" MinWidth="66" MaxWidth="96" FontWeight="SemiBold" SortMemberPath="NetPrice3"/>
                    <DataGridTextColumn Binding="{Binding Qty2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Ofr报量(万元)" Width="auto" MinWidth="60" MaxWidth="90" CellStyle="{StaticResource DataGridCellStyle1}">
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ExecQty2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Ofr已成交(万元)" Width="auto" MinWidth="90" MaxWidth="110"/>

                    <DataGridTextColumn Header="渠道" Width="auto" MinWidth="80" MaxWidth="110">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="venues_exe" >
                                <Binding Path="Veneues"/>
                                <Binding Path="MarketIndicator"/>
                                <Binding Source="venues_exe"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding MyDealer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="本方交易员" Width="auto" MinWidth="70" MaxWidth="100"/>
                    <DataGridTemplateColumn Header="备注" Width="auto" MinWidth="140" MaxWidth="170" IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding OrdRejReason}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OrdRejReason}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  
                    <!--<DataGridTextColumn Binding="{Binding OrdType}" Header="报价方式" Width="Auto"  MinWidth="70"/>-->
                    <DataGridTextColumn Binding="{Binding Strategyordervenues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="报价方式" Width="auto" MinWidth="55" MaxWidth="85"/>
                    <DataGridTextColumn Binding="{Binding QuantID}" Header="策略名" Width="auto" MinWidth="60" MaxWidth="90"/>
                    <DataGridTextColumn Header="创建日期" Binding="{Binding createDate,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}"
                                         Width="auto" MinWidth="80" MaxWidth="110"/>

                    <!--<DataGridTextColumn Binding="{Binding CrossVenues,ConverterParameter=crossvenues, Converter={StaticResource EnumTypeConvertor}}" Header="撮合范围" Width="Auto"  MinWidth="70"/>

                                <DataGridTextColumn Binding="{Binding VenuesSelectDisplay}" Header="渠道" Width="Auto"  MinWidth="70"/>-->

                    <!--<DataGridTextColumn Binding="{Binding VenuesSelectF}" Header="VenuesSelectF" Width="Auto"  MinWidth="70"/>
                        <DataGridTextColumn Binding="{Binding VenuesRdmNum}" Header="VenuesRdmNum" Width="Auto"  MinWidth="70"/>
                        <DataGridTextColumn Binding="{Binding SelfSelectVenues}" Header="SelfSelectVenues" Width="Auto"  MinWidth="70"/>-->
                    <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="最后更新日期" Width="auto" MinWidth="80" MaxWidth="110">

                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="最后更新时间" Width="auto" MinWidth="80" MaxWidth="110"/>
                </DataGrid.Columns>
            </component:ExDataGrid>
            <component:PageControl x:Name="EMSPageControl" Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Right" 
                               PageChanged="EMSPageControl_PageChanged"
                               Visibility="{Binding EMSPageVisible,Converter={StaticResource visibilityConvertor}}"/>
            <fUI:LoadingMask x:Name="emsloadMask" Visibility="Collapsed" Grid.RowSpan="3" Grid.Row="0" Grid.ColumnSpan="3"></fUI:LoadingMask>
        </Grid>
        
    </Grid>
</UserControl>
