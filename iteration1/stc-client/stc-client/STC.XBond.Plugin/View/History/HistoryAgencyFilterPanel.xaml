<UserControl x:Class="STC.XBond.Plugin.View.HistoryAgencyFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="1200">
    <!--<UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>-->
    <Grid>
        <StackPanel Orientation="Horizontal" Height="30">
            <DatePicker x:Name="dpFrom" Width="120px" Height="24" Style="{DynamicResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" SelectedDateChanged="dpFrom_SelectedDateChanged"></DatePicker>
            <TextBlock  Text="-" Margin="5,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"></TextBlock>
            <DatePicker x:Name="dpTo" Width="120" Height="24" Style="{DynamicResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" SelectedDateChanged="dpTo_SelectedDateChanged"></DatePicker>
            <TextBlock  Text="程度:" Margin="10,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"></TextBlock>

            <ListBox x:Name="ListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource CommonFilterListBoxItemStyle}" IsSelected="True" Width="80" HorizontalContentAlignment="Center"/>
                <!--<ListBoxItem Content="紧急" Style="{StaticResource CommonFilterListBoxItemStyle}" Width="80" HorizontalContentAlignment="Center"/>-->
                <ListBoxItem Content="重要" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="80" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="一般" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="80" HorizontalContentAlignment="Center"/>
            </ListBox>

        </StackPanel>
    </Grid>
</UserControl>
