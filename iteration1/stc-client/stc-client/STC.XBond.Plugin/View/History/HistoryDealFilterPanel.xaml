<UserControl x:Class="STC.XBond.Plugin.View.HistoryDealFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="1200">
    <!--<UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>-->
    <Grid>
        <StackPanel Orientation="Horizontal" Height="30">
            <DatePicker x:Name="dpFrom" Width="120px" Height="24" Style="{DynamicResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" 
                        SelectedDateChanged="dpFrom_SelectedDateChanged"></DatePicker>
            <TextBlock  Text="-" Margin="5,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"></TextBlock>
            <DatePicker x:Name="dpTo" Width="120" Height="24" Style="{DynamicResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" 
                        SelectedDateChanged="dpTo_SelectedDateChanged"></DatePicker>

            <TextBlock x:Name="ContractTypeLbl" Text="合约种类:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="ContractTypeListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="ContractTypeListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource CommonFilterListBoxItemStyle}" IsSelected="True" />
                <ListBoxItem Content="债券" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="期货" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="IRS" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
            </ListBox>
            <ListBox x:Name="ListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource CommonFilterListBoxItemStyle}" IsSelected="True" Width="70" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="Tradebook" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="70" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="XBOND" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="70" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="双边" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="70" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="国利" Style="{DynamicResource CommonFilterListBoxItemStyle}" Margin="10,0,0,0" Width="40" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="信唐" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="40" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="平安" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="40" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="国际" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="40" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="中诚" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="40" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="上田" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="40" HorizontalContentAlignment="Center"/>
            </ListBox>
            <TextBlock x:Name="tbCodeType" Text="债券类型:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="lbCodeType" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="LbCodeType_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource CommonFilterListBoxItemStyle}" IsSelected="True" />
                <ListBoxItem Content="利率" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="信用" Style="{DynamicResource CommonFilterListBoxItemStyle}"/>
            </ListBox>
            <!--<CheckBox Grid.Row="4" Grid.Column="1"                                                 
                      VerticalAlignment="Center" 
                      Margin="10, 5, 0, 0" BorderThickness="2" 
                      BorderBrush="{StaticResource ColorBrush.Gray15}" 
                      Height="20"   
                      FontSize="{StaticResource SmallContentFontSize}" 
                      Style="{StaticResource CommonCheckBoxStyle}" 
                      Background="{StaticResource ColorBrush.Transparent}" 
                      Foreground="{StaticResource ColorBrush.While}" 
                      Content="待处理" 
                      Click="CheckBox_Click"></CheckBox>-->

        </StackPanel>    
    </Grid>
</UserControl>
