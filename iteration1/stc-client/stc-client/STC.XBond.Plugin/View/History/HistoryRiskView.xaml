<UserControl x:Class="STC.XBond.Plugin.View.HistoryRiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:ViewModel="clr-namespace:STC.XBond.Plugin.ViewModel" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" 
             xmlns:customeUI="clr-namespace:STC.XBond.Plugin.CustomeUI"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:utils="clr-namespace:STC.XBond.Plugin.Utils"
             xmlns:command ="clr-namespace:STC.XBond.Plugin.Command"
             xmlns:CommonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:fcon="clr-namespace:STC.XBond.Plugin.Convertor"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="1500" Initialized="UserControl_Initialized" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <sys:String x:Key="TimeFormatHHMMSS">HH:mm:ss</sys:String>
            <sys:String x:Key="TimeFormatYYYYMMDD">yyyy-MM-dd</sys:String>
            <!--yyyy-MM-dd-->
            <sys:String x:Key="TimeFormatMMDDHHMM">MM-dd HH:mm</sys:String>
            <!--MM-dd HH:mm-->
            <sys:String x:Key="TimeFormatYYYYMMDD2">yyyyMMdd</sys:String>

            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:SettleTypeConvertor x:Key="settleTypeConvertor"/>
            <fcon:TreasuryFutureConvertor x:Key="treasuryFutureConverter"/>
            <fcon:BondFieldConvertor x:Key="bondFieldConverter"/>
            <fcon:FormatDateTimeConvertor x:Key="FormatDateTimeConvertor"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="true"/>
            </Style>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="risktypeColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Type}" Value="3">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Red7}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}" BasedOn="{DynamicResource DataGridCellStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" MouseEnter="ContentPresenter_MouseEnter">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="textBlock" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="VGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{DynamicResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <Rectangle Width="12" Height="1" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" Margin="0,2,0,2"/>
                                    <Rectangle Width="12" Height="1" Stroke="{DynamicResource DefaultForegroup.ColorBrush}" Margin="0,0,0,2"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid Background="#141414">

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <local:HistoryRiskFilter x:Name="historyFilter" RiskFilterDicChanged="historyFilter_RiskFilterDicChanged"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ComboBox x:Name="comboBox" Margin="20,0,0,0" Width="90"  Height="18" 
                          VerticalAlignment="Center" SelectedIndex="0" 
                          Style="{DynamicResource NonEditableComboBoxStyle}"
                          SelectionChanged="comboBox_SelectionChanged">
                    <ComboBoxItem Content="STC订单号" Tag="1"/>
                    <ComboBoxItem Content="债券代码" Tag="2"/>
                </ComboBox>
                <TextBox Width="130" Height="18" Padding="5, 0, 0, 0" 
                         Style="{DynamicResource HistoryTextBoxStyle}" 
                         x:Name="textBox"
                         Margin="5,0"
                         KeyDown="textBox_KeyDown"
                         TextChanged="textBox_TextChanged"
                         LostFocus="textBox_LostFocus"
                         input:TextCompositionManager.PreviewTextInput="textBox_PreviewTextInput"
                         input:TextCompositionManager.PreviewTextInputUpdate="textBox_PreviewTextInputUpdate"/>
                <Button x:Name="btnFullScreen" Width="24" Height="24" HorizontalAlignment="Left" 
                        VerticalAlignment="Center" Style="{DynamicResource ExportButton}"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>
        <CommonComp:ExDataGrid Grid.Row="1" x:Name="Risk_dataGrid" Style="{DynamicResource DefaultDataGrid}"
                ItemsSource="{Binding RiskDV}" 
                  LoadingRow="Risk_dataGrid_LoadingRow" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="STC订单号" Width="200" IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding Orderid}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Orderid}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Securityid}" Header="债券代码" Width="100" IsReadOnly="True" CanUserSort="False"/>
                <DataGridComboBoxColumn ItemsSource="{x:Static ViewModel:HistoryRiskViewModel.SideItemSource}" 
                                                SelectedValueBinding="{Binding Side}" 
                                                ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                SelectedValuePath="Key" DisplayMemberPath="Value"  
                                                Header="方向" Width="40" CellStyle="{StaticResource ColumnColorStyle}" IsReadOnly="True"/>
               
                <DataGridTextColumn Binding="{Binding Firmflag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag'}" Header="意向" Width="50" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding Price}" Header="报价(%)" Width="100" IsReadOnly="True" CanUserSort="False" CellStyle="{StaticResource ColumnColorStyle}"/>
                <DataGridTextColumn Binding="{Binding Orderqty}" Header="数量(万元)" Width="100" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding Tradedate,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}" 
                                    Header="交易日期" Width="80" IsReadOnly="True" CanUserSort="False"/>
                <!--<DataGridTextColumn Binding="{Binding Settltype}" Header="清算速度" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>-->
                <DataGridTextColumn Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                    ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                    Header="清算速度" Width="Auto" MinWidth="70">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                            <Setter Property="ToolTip" Value="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <!--<DataGridTextColumn Binding="{Binding Venues}" Header="方式" Width="Auto" MinWidth="80" IsReadOnly="True" CanUserSort="False"/>-->
                <DataGridComboBoxColumn ItemsSource="{x:Static ViewModel:HistoryRiskViewModel.VenuesItemSource}" 
                                                SelectedValueBinding="{Binding Venues}" 
                                                SelectedValuePath="Key" DisplayMemberPath="Value"  
                                                ClipboardContentBinding="{Binding Venues,Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues'}"
                                                Header="方式" Width="50" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="撮合范围" Width="120" IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding Crossvenues,ConverterParameter=crossvenues, Converter={StaticResource EnumTypeConvertor}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Crossvenues,ConverterParameter=crossvenues, Converter={StaticResource EnumTypeConvertor}}"  TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="渠道" Width="100" IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding VenuesSelectDisplay}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding VenuesSelectDisplay}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Quantid}" Header="策略名" Width="70" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding Createtime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" 
                                    Header="触发时间" Width="60" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding Type,Converter={StaticResource EnumTypeConvertor},ConverterParameter='risktype'}" 
                                    Header="风控类型" Width="80" IsReadOnly="True" CanUserSort="False"
                                    CellStyle="{StaticResource risktypeColumnColorStyle}"/>
                <DataGridTemplateColumn Header="指标" Width="250" IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding Indicator}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Indicator}" Foreground="{DynamicResource ColorBrush.Red7}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="指标值" Width="100" IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding Indicatorvalue}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Indicatorvalue}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="指标限额" Width="100"  IsReadOnly="True" CanUserSort="False" ClipboardContentBinding="{Binding Indicatorlimitvalue}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Indicatorlimitvalue}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Indicatorsource}" Header="指标来源" Width="60" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding Result}" Header="操作结果" Width="100" IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Binding="{Binding Updatetime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" 
                                    Header="操作时间" Width="60" IsReadOnly="True" CanUserSort="False"/>
            </DataGrid.Columns>
        </CommonComp:ExDataGrid>
        <CommonComp:PageControl x:Name="pageControl" Grid.Row="2" HorizontalAlignment="Right" 
                               PageChanged="pageControl_PageChanged" 
                               Visibility="{Binding PageVisible,Converter={StaticResource visibilityConvertor}}"/>

        <fUI:LoadingMask x:Name="loadMask" Visibility="Collapsed" Grid.RowSpan="3" Grid.Row="0"></fUI:LoadingMask>
    </Grid>
</UserControl>
