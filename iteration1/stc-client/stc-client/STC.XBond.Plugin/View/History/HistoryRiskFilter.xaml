<UserControl x:Class="STC.XBond.Plugin.View.HistoryRiskFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             mc:Ignorable="d" 
             d:DesignHeight="24" d:DesignWidth="1200">
    <!--<UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>-->
    <Grid>
        <StackPanel Orientation="Horizontal" Height="30">
            <DatePicker x:Name="dpFrom" Width="120px"  Height="24" 
                        Style="{DynamicResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" 
                        SelectedDateChanged="dpFrom_SelectedDateChanged"></DatePicker>
            <TextBlock  Text="-" Margin="5,0,5,0" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"></TextBlock>
            <DatePicker x:Name="dpTo" Width="120"  Height="24" Style="{DynamicResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" SelectedDateChanged="dpTo_SelectedDateChanged"></DatePicker>
            <TextBlock x:Name="RiskLbl" Text="风控类型:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="RiskListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="RiskListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource CommonFilterListBoxItemStyle}" IsSelected="True" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="提醒" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="2次提醒" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="65" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="禁止" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
            </ListBox>
            <TextBlock x:Name="StyleLbl" Text="方式:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="StyleListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="StyleListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource CommonFilterListBoxItemStyle}" IsSelected="True" Width="60" HorizontalContentAlignment="Center"/>
                <!--<ListBoxItem Content="人工" Style="{StaticResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>-->
                <ListBoxItem Content="内部" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="做市" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="IDB" Visibility="Collapsed" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="量化" Visibility="Collapsed" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
            </ListBox>
            <TextBlock x:Name="QuoteTypeLbl" Text="报价类型:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="QuoteTypeListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="QuoteTypeListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{DynamicResource CommonFilterListBoxItemStyle}" IsSelected="True" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="firm" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="60" HorizontalContentAlignment="Center"/>
                <ListBoxItem Content="nonfirm" Style="{DynamicResource CommonFilterListBoxItemStyle}" Width="70" HorizontalContentAlignment="Center"/>
            </ListBox>
            <CheckBox x:Name="checkBox" Grid.Row="4" Grid.Column="1"                                                 
                      VerticalAlignment="Center" 
                      Margin="10, 5, 0, 0" BorderThickness="1" 
                      BorderBrush="{DynamicResource ColorBrush.Gray15}"
                      Height="16"
                      FontSize="{DynamicResource SmallContentFontSize}" 
                      Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                      Background="{DynamicResource ColorBrush.Transparent}" 
                      Foreground="{DynamicResource ColorBrush.While}" 
                      Content="包含&lt;取消订单&gt;" 
                      Click="CheckBox_Click"></CheckBox>
        </StackPanel>
    </Grid>
</UserControl>
