<UserControl x:Class="STC.XBond.Plugin.View.Book.MarketUnderlineEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Book"
              xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:component="clr-namespace:STC.XBond.Plugin.View.Component"
                       mc:Ignorable="d" Height="30" FontSize="12" MinWidth="600"
             d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        </ResourceDictionary>


    </UserControl.Resources>
    <DockPanel>
        <!--标题-->
        <ComboBox x:Name="panelTypeCbc" ItemsSource="{Binding PanelTypeDic}" 
                      SelectedValue="{Binding PanelType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Key"
                      DisplayMemberPath="Value"
                      Style="{StaticResource NonEditableComboBoxStyle}" 
                      Width="80" Height="24" Margin="10,0,0,0" VerticalContentAlignment="Center"
                      DockPanel.Dock="Left">
            <!--让SelectionChanged事件触发ChangePanelTypeCommand命令-->
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding DataContext.ChangePanelTypeCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, Mode=FindAncestor}}" 
                                           CommandParameter="{Binding ElementName=panelTypeCbc}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>
        <!--自营 账号-->
        <StackPanel x:Name="tradeMethodSP" Orientation="Horizontal">
            <component:WatermarkTextBox Visibility="{Binding PositionVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                                        VerticalAlignment="Center"
                                        Text="{Binding TradeMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        PreviewTextInput="WatermarkTextBox_PreviewTextInput"
                                        PreviewKeyDown="WatermarkTextBox_PreviewKeyDown"
                                        input:InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}" WaterMark="席位号"
                                        HorizontalAlignment="Stretch" 
                                        Margin="4,0,0,0"
                                        Height="24"
                                        Width="70"/>

            <ComboBox x:Name="comTradeMethod" 
                      Text="{Binding TradeMethod, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                      Visibility="{Binding SendPriceTypeVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                      Style="{StaticResource NonEditableComboBoxStyle}"
                      VerticalContentAlignment="Center"
                      Width="70"  Height="24" SelectedIndex="0"
                      Margin="4,0,0,0"
                      HorizontalAlignment="Stretch">
                <ComboBoxItem Content="待定" Tag="60"/>
                <ComboBoxItem Content="发对话" Tag="1"/>
                <ComboBoxItem Content="收对话" Tag="30"/>
                <ComboBoxItem Content="发请求" Tag="4"/>
                <ComboBoxItem Content="收请求" Tag="50"/>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding MarketTradeMethodChangeCommand}" CommandParameter="{Binding ElementName=comTradeMethod}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
        </StackPanel>
        <component:WatermarkTextBox x:Name="counterPartNameTB" Width="65" Height="24" Margin="4,0,0,0" VerticalContentAlignment="Center" 
                  Text="{Binding Name,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 WaterMark="机构名"/>
        <component:WatermarkTextBox x:Name="counterPartSubNameTB" Width="95" Height="24" Margin="4,0,0,0" VerticalContentAlignment="Center" 
                 Text="{Binding SubName,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding SubNameVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                 WaterMark="交易员"/>
        <!--价格-->
        <component:WatermarkTextBox x:Name="fieldTB" Width="50" Height="24" Margin="4,0,0,0" VerticalContentAlignment="Center" 
                 Text="{Binding Yield, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" WaterMark="成交价"
                  PreviewTextInput="TextBox_PreviewTextInput" Tag="2" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False"/>
        <!--数量-->
        <component:WatermarkTextBox x:Name="QtyTB" Width="50" Height="24" Margin="4,0,0,0" VerticalContentAlignment="Center" 
                  Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" WaterMark="成交量" TextChanged="QtyTB_TextChanged"
                 PreviewTextInput="TextBox_PreviewTextInput" Tag="1" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False"/>
        <!--清算速度-->
        <DatePicker x:Name="datePicker" Grid.Column="1" Width="90" Height="24" Margin="4, 0, 0, 0"
                                SelectedDate="{Binding SelectDate,Mode=TwoWay}" Style="{DynamicResource SettlTypeDatePickerStyle}">
            <DatePicker.Resources>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="IsReadOnly" Value="True"/>
                </Style>
            </DatePicker.Resources>
        </DatePicker>
        <ComboBox x:Name="cbSettle" Grid.Column="2" Width="50"  Height="24" VerticalContentAlignment="Center" Margin="1,0,0,0" 
                  SelectedIndex="{Binding ComboBoxSelectIndex,Mode=TwoWay}" 
                   Style="{StaticResource NonEditableComboBoxStyle}">
            <ComboBoxItem Content="T+0" Tag="1"></ComboBoxItem>
            <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>
        </ComboBox>
        <!--备注-->
        <component:WatermarkTextBox  x:Name="remarks" Width="50" Height="24" Margin="10,0,0,0" VerticalContentAlignment="Center" 
                  Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" WaterMark="备注"/>
        
	<Button x:Name="delBtn" Width="18" Height="18" Margin="0,0,10,0" DockPanel.Dock="Right" Style="{StaticResource DeleteButton}"  Visibility="{Binding DelBtnVisibility}"
            Command="{Binding DataContext.DelCounterPartCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, Mode=FindAncestor}}"
            CommandParameter="{Binding ElementName=delBtn}"/>

        <TextBlock Width="30"/>
    </DockPanel>
</UserControl>
