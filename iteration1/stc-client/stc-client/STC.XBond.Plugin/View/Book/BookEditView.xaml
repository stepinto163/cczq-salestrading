<component:WindowBase x:Class="STC.XBond.Plugin.View.Book.BookEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.View"
        xmlns:component="clr-namespace:STC.XBond.Plugin.View.Component"
        xmlns:book="clr-namespace:STC.XBond.Plugin.View.Book"
        xmlns:selecotr="clr-namespace:STC.XBond.Plugin.View.TemplateSelector"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:comp="clr-namespace:STC.XBond.Plugin.View.Component"
        xmlns:CustomUI="clr-namespace:STC.Frame.CustomUI;assembly=STC.Frame"
        mc:Ignorable="d" FontSize="12" SizeToContent="Height"
        Title="{Binding BlockNum, StringFormat='{}交易包  {0}'}" MinHeight="374" MaxHeight="650" Width="1430"  
                      Closing="WindowBase_Closing">
    <component:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <LinearGradientBrush x:Key="BuyBGBrush" EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#095789" Offset="0"/>
                <GradientStop Color="#141414" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="BuyColor" Color="#009AFF"/>
            <SolidColorBrush x:Key="BuyInnerColor" Color="#89C9FF"/>

            <LinearGradientBrush x:Key="SellBGBrush" EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#ED6D00" Offset="0"/>
                <GradientStop Color="#141414" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SellColor" Color="#ED6D00"/>
            <SolidColorBrush x:Key="SellInnerColor" Color="#ED6D00"/>

            <!--Side RadioButton Style-->
            <SolidColorBrush x:Key="RadioButton.Static.Background" Color="#3C3C3C"/>
            <SolidColorBrush x:Key="RadioButton.Static.Border" Color="#515151"/>
            <Style x:Key="SideRadioButtonStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}">
                                    </Border>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter"  Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource RadioButton.Static.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RadioButton.Static.Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </component:WindowBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition MinHeight="240"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--header部分-->
        <!--线上执行，渠道执行-->
        <Border BorderBrush="{Binding BorderBrush}" BorderThickness="0,2,0,0"  Grid.ColumnSpan="2" Height="60" Visibility="{Binding OnlineVisibility}">
            <Grid x:Name="Header_Part" Background="{Binding BGBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!--买入卖出标题-->
                <Grid Width="120" Height="40" Grid.RowSpan="2">
                    <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent">
                        <Border x:Name="border" CornerRadius="1" BorderBrush="{Binding InnerBorderBrush}" BorderThickness="0,1,0,0" Background="{Binding BorderBrush}">
                        </Border>
                    </Border>
                    <TextBlock Text="{Binding SideDisplay}"  VerticalAlignment="Center"  HorizontalAlignment="Center" Foreground="#FFFFFF"/>
                </Grid>
                <!--<Button x:Name="Bid_OrderBtn" Grid.RowSpan="2" Content="{Binding Side}" Width="120" Height="40" Foreground="White" Margin="10"
                     Background="#ED6D00" BorderBrush="#FF963D"  Style="{DynamicResource OrderButtonStyle}" />-->

                <TextBlock Grid.Column="1" Grid.Row="0" Margin="10,12,10,0" Text="债券代码/名称" Foreground="#A0A0A0"  FontSize="10"></TextBlock>
                <TextBlock Grid.Column="1" Grid.Row="1"  Margin="10,0,10,10" Foreground="#FFFFFF"><Run Text="{Binding SecurityID}"/>   <Run Text="{Binding Symbol}"/></TextBlock>

                <TextBlock Grid.Column="2" Grid.Row="0" Margin="10,12,10,0" Text="价格" Foreground="#A0A0A0" FontSize="10"/>
                <TextBlock Grid.Column="2" Grid.Row="1"  Margin="10,0,10,10" Text="{Binding Yield}" Foreground="#FFFFFF"/>

                <TextBlock Grid.Column="3" Grid.Row="0" Margin="10,12,10,0" Text="量(万)" Foreground="#A0A0A0" FontSize="10"/>
                <TextBox x:Name="TotalSize" Grid.Column="3" Grid.Row="1" Height="24" Width="100" Margin="10,-12,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                         BorderBrush="{Binding BorderBrush}" BorderThickness="2" Background="#0B0C0C" Foreground="#FFFFFF" 
                         Text="{Binding Qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="TextBox_PreviewTextInput" Tag="1" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False"/>
                <TextBlock Grid.Column="3" Grid.Row="1"  HorizontalAlignment="Right"  Margin="0,0,15,10" Text="万" Foreground="#FFFFFF"/>

                <TextBlock Grid.Column="4" Grid.Row="0" Margin="10,12,10,0" Text="清算速度" Foreground="#A0A0A0" FontSize="10"/>
                <TextBlock Grid.Column="4" Grid.Row="1"  Margin="10,0,10,10" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" Foreground="#FFFFFF" />

                <TextBlock Grid.Column="5" Grid.Row="0" Margin="10,12,10,0" Text="最后发送" Foreground="#A0A0A0" FontSize="10"/>
                <TextBlock Grid.Column="5" Grid.Row="1"  Margin="10,0,10,10" Text="{Binding LstSendTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatMMDDHHMM}}" Foreground="#FF9201" />
            </Grid>
        </Border>
        <!--线下补入-->
        <Border BorderBrush="{Binding BorderBrush}" BorderThickness="0,2,0,0"  Grid.Row="1" Grid.ColumnSpan="2" MinHeight="60" Height="Auto" Visibility="{Binding UnderlineVisibility}">
            <Grid x:Name="Header_Underline_Part" Background="{Binding BGBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
               
                <!--买入卖出标题-->
                <Grid Width="120" Height="40" Grid.RowSpan="2" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Width="60" Height="40" Style="{DynamicResource SideRadioButtonStyle}" 
                                 Content="买入" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#FFFFFF"
                                 Background="{StaticResource BuyColor}" BorderBrush="{StaticResource BuyInnerColor}" IsChecked="{Binding BuyIsCheck,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <RadioButton Width="60" Height="40" Style="{DynamicResource SideRadioButtonStyle}" Grid.Column="1"
                                 Content="卖出" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#FFFFFF"
                                 Background="{StaticResource SellColor}" BorderBrush="{StaticResource SellInnerColor}" IsChecked="{Binding SellIsCheck,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!--<Button x:Name="Bid_OrderBtn" Grid.RowSpan="2" Content="{Binding Side}" Width="120" Height="40" Foreground="White" Margin="10"
                     Background="#ED6D00" BorderBrush="#FF963D"  Style="{DynamicResource OrderButtonStyle}" />-->

                <TextBlock Grid.Column="1" Grid.Row="1" Margin="10,12,10,5" Text="债券代码/名称" Foreground="#A0A0A0"  FontSize="10"></TextBlock>
                <!--<TextBlock Grid.Column="1" Grid.Row="1"  Margin="10,0,10,10" Foreground="#FFFFFF"><Run Text="{Binding SecurityID}"/>   <Run Text="{Binding Symbol}"/></TextBlock>-->
                <comp:SearchTextBox x:Name="SecurityID" Grid.Column="1" Grid.Row="2"  Height="24" Width="100" Margin="10,-12,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                    SearchText="{Binding SecurityID,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    HintText="搜索..." ValueChanged="SecurityID_ValueChanged"
                         BorderBrush="{Binding BorderBrush}" BorderThickness="2" Background="#0B0C0C" Foreground="#FFFFFF" AfterSearch="SecurityID_AfterSearch"
                                    MouseOverBorderBrush="{Binding BorderBrush}" FocusBorderBrush="{Binding BorderBrush}"/>
                <TextBlock x:Name="Symbol_TB" Grid.Column="1" Grid.Row="2"  Margin="116,0,0,10" Foreground="#FFFFFF"  Text="{Binding Symbol}" TextTrimming="CharacterEllipsis"></TextBlock>
                

                <TextBlock Grid.Column="2" Grid.Row="1" Margin="10,12,10,0" Text="价格" Foreground="#A0A0A0" FontSize="10"/>
                <TextBlock Grid.Column="2" Grid.Row="2"  Margin="10,0,10,10" Text="(参见对手方)" Foreground="#FFFFFF"/>

                <TextBlock Grid.Column="3" Grid.Row="1" Margin="10,12,10,5" Text="量(万)" Foreground="#A0A0A0" FontSize="10"/>
                <TextBox Grid.Column="3" Grid.Row="2" Height="24" Width="100" Margin="10,-12,0,0" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                         BorderBrush="{Binding BorderBrush}" BorderThickness="2" Background="#0B0C0C" Foreground="#FFFFFF" 
                         Text="{Binding Qty,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="TextBox_PreviewTextInput" Tag="1" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False"/>
                <TextBlock Grid.Column="3" Grid.Row="2"  HorizontalAlignment="Right"  Margin="0,0,15,10" Text="万" Foreground="#FFFFFF"/>

                <TextBlock Grid.Column="4" Grid.Row="1" Margin="10,12,10,0" Text="清算速度" Foreground="#A0A0A0" FontSize="10"/>
                <!--清算速度-->
                <TextBlock Grid.Column="4" Grid.Row="2"  Margin="10,0,10,10" Text="(参见对手方)" Foreground="#FFFFFF"/>

                <!--<TextBlock Grid.Column="4" Grid.Row="1"  Margin="10,0,10,10" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" Foreground="#FFFFFF" />-->

                <TextBlock Grid.Column="5" Grid.Row="1" Margin="10,12,10,0" Text="最后发送" Foreground="#A0A0A0" FontSize="10"/>
                <TextBlock Grid.Column="5" Grid.Row="2"  Margin="10,0,10,10" Text="{Binding LstSendTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatMMDDHHMM}}" Foreground="#FF9201" />
            </Grid>
        </Border>
        <!-- 本方 -->
        <Border Grid.Row="2" Grid.Column="0" BorderBrush="#323232" BorderThickness="1,1,0,1">
            <Grid Background="#141414">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="本方" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="10,0,0,0" />
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{Binding SelfQtyBrush}" Margin="0,0,10,0" >
                        已补充 : <Run Text="{Binding SelfQty}"/>/<Run Text="{Binding QtyLong}"></Run>
                    </TextBlock>
                </DockPanel>
                <!--本方列表-->
                <ListBox x:Name="SelfItemsControl"   Grid.Row="1"  ItemsSource="{Binding SelfList}" 
                         SelectedItem="{Binding SelfSelectedItem}" Padding="0" Background="Transparent"
                         BorderThickness="0">
                    <ListBox.Resources>
                        <DataTemplate x:Key="IDB_PART">
                            <book:IDBEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="MARKET_PART">
                            <book:MarketEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="BROKER_PART">
                            <book:BrokerEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="SELF_PART">
                            <book:SelfEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="IDB_UNDERLINE_PART">
                            <book:IDBUnderlineEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="MARKET_UNDERLINE_PART">
                            <book:MarketUnderlineEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="BROKER_UNDERLINE_PART">
                            <book:BrokerUnderlineEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="SELF_UNDERLINE_PART">
                            <book:SelfUnderlineEditPanel/>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplateSelector>
                        <selecotr:BookEditControlTemplateSelector/>
                    </ListBox.ItemTemplateSelector>
                </ListBox>
            </Grid>
        </Border>

        <!-- 对手方 -->
        <Border Grid.Row="2" Grid.Column="1" BorderBrush="#323232" BorderThickness ="1">
            <Grid Background="#141414">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition/>
                    <RowDefinition Height="54"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock Text="对手方" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="10,0,0,0" />
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{Binding CounterPartyQtyBrush}" Margin="0,0,10,0" >
                        已补充 : <Run Text="{Binding CounterPartQty}"/>/<Run Text="{Binding QtyLong}"/>
                    </TextBlock>
                </DockPanel>


                <ListBox x:Name="CounterParttemsControl"  ItemsSource="{Binding CounterPartList}" Grid.Row="1"
                         SelectedItem="{Binding CounterPartySelectedItem,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="0" Background="Transparent"
                         BorderThickness="0">
                    <ListBox.Resources>
                        <DataTemplate x:Key="IDB_PART">
                            <book:IDBEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="MARKET_PART">
                            <book:MarketEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="BROKER_PART">
                            <book:BrokerEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="SELF_PART">
                            <book:SelfEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="IDB_UNDERLINE_PART">
                            <book:IDBUnderlineEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="MARKET_UNDERLINE_PART">
                            <book:MarketUnderlineEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="BROKER_UNDERLINE_PART">
                            <book:BrokerUnderlineEditPanel/>
                        </DataTemplate>
                        <DataTemplate x:Key="SELF_UNDERLINE_PART">
                            <book:SelfUnderlineEditPanel/>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplateSelector>
                        <selecotr:BookEditControlTemplateSelector/>
                    </ListBox.ItemTemplateSelector>
                </ListBox>

                <Button Content="添加对手方" Grid.Row="2" Width="80" Height="24" Margin="10,0,0,0" 
                       Visibility="{Binding CounterPartyAddVisibility}"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource GrayButtonStyle}"
                        Command="{Binding AddCounterPartCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="#323232" BorderThickness="1,0,1,1">
            <Grid x:Name="Bottom_Part" Background="#141414">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}" 
                                Click="btnCancel_Click">取消</Button>
                    <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}" 
                            Click="btnOK_Click" >提交</Button>
                </StackPanel>
                <TextBlock Text="{Binding UpdateTime, StringFormat='{} 最后更新    {0}',Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatMMDDHHMM}}" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </Grid>
        </Border>

       
    </Grid>
</component:WindowBase>
