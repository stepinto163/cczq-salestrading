<UserControl x:Class="STC.XBond.Plugin.View.Book.MarketEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Book"
             mc:Ignorable="d" Height="30" FontSize="12" MinWidth="600"
             d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>
    <DockPanel>
        <!--标题-->
        <Border Background="#146C5E" CornerRadius="2" Width="40" Height="16" Margin="10,0,0,0">
            <TextBlock Text="市场" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <!--用户名-->
        <TextBlock  Foreground="#FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center" Width="180">
            <Run Text="{Binding Name}"/> - <Run Text="{Binding SubName}"/>
        </TextBlock>

        <!--价格-->
        <TextBlock x:Name="fieldTB" Width="60"  Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Yield,StringFormat={}{0:N4}}" Foreground="{StaticResource ColorBrush.Blue10}"/>
        <!--数量-->
        <TextBlock x:Name="QtyTB" Width="60" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Qty}" Foreground="#FFFFFF"/>
        <!--清算速度-->
        <TextBlock x:Name="SettleTB" Width="80" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding SettlType,Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" Foreground="#FFFFFF"/>

        <!--报价-->
        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" DockPanel.Dock="Right" Foreground="#FFFFFF">
                ( 报价：<Run Text="{Binding Yield,StringFormat={}{0:N4}}"/> )
        </TextBlock>
    </DockPanel>
</UserControl>