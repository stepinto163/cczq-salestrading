<UserControl x:Class="STC.XBond.Plugin.View.Book.SubDealTypeFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
              FontSize="12" Height="24" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Height="16">
        <TextBlock x:Name="SubBookTypeLbl" Text="类型:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A0A0A0"/>

        <ListBox x:Name="SubBookTypeListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="SubBookTypeListBox_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate>
                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ControlTemplate>
            </ListBox.Template>
            <ListBoxItem Content="全部" x:Name="All" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
            <ListBoxItem Content="内部划转" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="成交" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
        </ListBox>
    </StackPanel>
</UserControl>
