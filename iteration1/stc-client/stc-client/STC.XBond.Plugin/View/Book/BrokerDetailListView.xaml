<component:WindowBase x:Class="STC.XBond.Plugin.View.Book.BrokerDetailListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
            xmlns:component="clr-namespace:STC.XBond.Plugin.View.Component"
                       xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" Title="经纪商成交单"
             ResizeMode="NoResize"
             Height="370" Width="930" Background="#1E1E1E" BorderThickness="1" BorderBrush="#A0A0A0">
    <component:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

        </ResourceDictionary>
    </component:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <DataGrid Margin="5,10,5,0" BorderThickness="1" BorderBrush="#323232" Style="{StaticResource DefaultDataGrid}" ItemsSource="{Binding Datas}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="80" ClipboardContentBinding="{Binding SourceTrader,Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues'}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="Selected_Chk" Checked="Selected_Chk_Checked" Unchecked="Selected_Chk_Unchecked" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                                <Border x:Name="SourceTraderBorder" Background="{StaticResource TPSC.ColorBrush}" CornerRadius="2" Height="16" Width="40" HorizontalAlignment="Left" Margin="5,0,0,0">
                                    <TextBlock x:Name="SourceTraderText" Foreground="{StaticResource DefaultForegroup.ColorBrush}" Text="国利" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SourceTrader}" Value="TPSC">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource TPSC.ColorBrush}" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="国利"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SourceTrader}" Value="CTTJ">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CTTJ.ColorBrush}" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="信唐"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SourceTrader}" Value="CNEX">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CNEX.ColorBrush}" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="国际"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SourceTrader}" Value="CCTB">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource CCTB.ColorBrush}" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="中诚"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SourceTrader}" Value="PTCN">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource PTCN.ColorBrush}" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="平安"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SourceTrader}" Value="UEDA">
                                    <Setter Property="Background" TargetName="SourceTraderBorder" Value="{StaticResource UEDA.ColorBrush}" />
                                    <Setter Property="Text" TargetName="SourceTraderText" Value="上田"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="成交单号" Binding="{Binding ExecID}" Width="160"/>-->
                <DataGridTemplateColumn Header="成交单号"  Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis" >
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>    
                                    <Run Text="{Binding ExecID}"/>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="匹配码" Binding="{Binding MatchCode}" Width="60"/>
                <DataGridTextColumn Header="创建日期" Binding="{Binding createDate,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatYYYYMMDD}}"
                                        Width="Auto" MinWidth="80"/>
                <DataGridTextColumn Header="成交价" Binding="{Binding LastPrice}" Width="80"/>
                <DataGridTextColumn Header="成交量" Binding="{Binding LastQty}" Width="80"/>
                <DataGridTextColumn Header="剩余量" Binding="{Binding LeavesQty}" Width="80"/>
                <DataGridTemplateColumn Header="匹配量" Width="80" ClipboardContentBinding="{Binding MatchQty}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="MatchQty_TB" Text="{Binding MatchQty}"/>
                                <component:WatermarkTextBox x:Name="MatchQty_Txt" WaterMark="匹配量" Text="{Binding MatchQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                                                            PreviewTextInput="TextBox_PreviewTextInput" Tag="1" PreviewKeyDown="TextBox_PreviewKeyDown" input:InputMethod.IsInputMethodEnabled="False"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter TargetName="MatchQty_TB" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="MatchQty_Txt" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="清算速度" Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_broker'}" Width="80"/>
                
                <DataGridTemplateColumn Header="对手方前台账户名"  Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                                <TextBlock TextTrimming="CharacterEllipsis" >
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                    </TextBlock.ToolTip>    
                                    <Run Text="{Binding CounterPart}"/>    <Run Text="{Binding CounterPartSubName}"/>
                                </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.ClipboardContentBinding>
                        <MultiBinding ConverterParameter=" {0} {1}"
                            Converter="{StaticResource StringFormatConverter}">
                            <Binding Path="CounterPart"/>
                            <Binding Path="CounterPartSubName"/>
                        </MultiBinding>
                    </DataGridTemplateColumn.ClipboardContentBinding>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#FFFFFF">
            已选择：<Run Text="{Binding SelectedQty}"/>/<Run Text="{Binding TotalQty}"/>
        </TextBlock>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#323232" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}" 
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}" 
                        Click="btnOK_Click" IsDefault="True" >选择</Button>
            </StackPanel>

        </Border>
    </Grid>
</component:WindowBase>
