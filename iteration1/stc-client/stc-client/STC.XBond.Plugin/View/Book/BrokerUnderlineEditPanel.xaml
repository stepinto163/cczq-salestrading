<UserControl x:Class="STC.XBond.Plugin.View.Book.BrokerUnderlineEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Book"
               xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                 mc:Ignorable="d" FontSize="12" MinWidth="600" Height="204"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DockPanel Background="#1E1E1E">
            <!--标题-->
            <ComboBox x:Name="panelTypeCbc" ItemsSource="{Binding PanelTypeDic}" 
                      SelectedValue="{Binding PanelType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Key"
                      DisplayMemberPath="Value"
                   
                      Style="{StaticResource NonEditableComboBoxStyle}" 
                      Width="80" Height="24" Margin="10,0,0,0" VerticalContentAlignment="Center"
                      DockPanel.Dock="Left">
                <!--让SelectionChanged事件触发ChangePanelTypeCommand命令-->
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding DataContext.ChangePanelTypeCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, Mode=FindAncestor}}" 
                                               CommandParameter="{Binding ElementName=panelTypeCbc}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>
            <!--idb 账号-->
            <ComboBox x:Name="brokerCbc" ItemsSource="{Binding VenuesSource}" Style="{StaticResource NonEditableComboBoxStyle}" 
                      SelectedValuePath="Key" 
                      SelectedItem="{Binding BrokerItem}"
                      DisplayMemberPath="Value"
                      Width="160" Height="24" Margin="4,0,0,0" VerticalContentAlignment="Center"
                      DockPanel.Dock="Left">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding DataContext.BrokerChangeCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, Mode=FindAncestor}}" 
                                               CommandParameter="{Binding ElementName=brokerCbc}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <!--删除按钮-->
            <Button x:Name="delBtn" Width="18" Height="18" Margin="0,0,10,0" DockPanel.Dock="Right" Style="{StaticResource DeleteButton}"  Visibility="{Binding DelBtnVisibility}"
                    Command="{Binding DataContext.DelCounterPartCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}, Mode=FindAncestor}}"
                    CommandParameter="{Binding ElementName=delBtn}"/>

            <!--占位-->
            <TextBlock/>
        </DockPanel>

        <local:BrokerEditSubPanel Grid.Row="1"/>
    </Grid>

</UserControl>
