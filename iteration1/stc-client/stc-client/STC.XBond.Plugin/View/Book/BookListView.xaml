<UserControl x:Class="STC.XBond.Plugin.View.Book.BookListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Book"
             xmlns:customeUI="clr-namespace:STC.XBond.Plugin.CustomeUI"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1420" Initialized="UserControl_Initialized">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid  Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--上半部分-->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <DockPanel>
                <DatePicker x:Name="dpFrom" Width="120px" Height="24" DockPanel.Dock="Left" Margin="5,0,0,0"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource DefaultDatePickerStyle}" 
                            SelectedDate="{Binding MainFromDateTime}"
                            DisplayDate="{Binding MainFromDateTime}"
                            DisplayDateStart="{Binding MainFromDateTime}"
                            DisplayDateEnd="{Binding MainFromDateTime}">
                </DatePicker>
                <TextBlock  Text="-" Margin="5,0,5,0" DockPanel.Dock="Left" VerticalAlignment="Center"
                            Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
                <DatePicker x:Name="dpTo" Width="120"  Height="24"  DockPanel.Dock="Left"
                            VerticalContentAlignment="Center"
                            
                            Style="{StaticResource DefaultDatePickerStyle}" 
                            SelectedDate="{Binding MainFromDateTime}"
                            DisplayDate="{Binding MainFromDateTime}"
                            DisplayDateStart="{Binding MainFromDateTime}"
                            DisplayDateEnd="{Binding MainFromDateTime}">
                </DatePicker>
                <TextBlock  Text="状态: " Margin="20,0,5,0" DockPanel.Dock="Left" VerticalAlignment="Center"  HorizontalAlignment="Right" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
                <ComboBox x:Name="bookStateComboBox" Width="90"  Height="18" DockPanel.Dock="Left"
                          VerticalContentAlignment="Center" SelectedIndex="0" 
                          Style="{StaticResource NonEditableComboBoxStyle}"
                          SelectionChanged="bookStateComboBox_SelectionChanged">
                    <ComboBoxItem Content="全部" Tag="ALL"/>
                    <!--<ComboBoxItem Content="未完成" Tag="INCOMPLETE"/>-->
                    <!--<ComboBoxItem Content="NEW" Tag="20"/>-->
                    <ComboBoxItem Content="更新中" Tag="21"/>
                    <!--<ComboBoxItem Content="完成" Tag="COMPLETE"/>-->
                    <ComboBoxItem Content="已完成" Tag="22"/>
                    <ComboBoxItem Content="异常" Tag="23"/>
                    <ComboBoxItem Content="已删除" Tag="24"/>
                    <!--<ComboBoxItem Content="异常完成" Tag="8"/>-->
                </ComboBox>
                <local:BookTerminalFilterPanel x:Name="bookTerminalFilterPanel" Margin="20,0,0,0" DockPanel.Dock="Left" FilterDicChanged="BookTerminalFilterPanel_FilterDicChanged"/>

                <Button x:Name="btnExport" Width="12" Height="12" Margin="10,0,10,0" DockPanel.Dock="Right"
                    Style="{StaticResource ExportButton}" IsEnabled="{Binding ExportEnabled}"
                    Command="{Binding ExportCommand}"/>
                <Button x:Name="btnUnderline" Margin="10,0,0,0" DockPanel.Dock="Right"
                                                Visibility="{Binding ShowOps}"
                    Content="线下成交" Style="{StaticResource GrayButtonStyle}"
                    Command="{Binding UnderlineCommand}"/>
                <local:BookInputFilterPanel  Margin="20,0,0,0" DockPanel.Dock="Right" 
                                             FilterType="{Binding MainSearchTextFilterType,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             SearchText="{Binding MainSearchText,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock />
            </DockPanel>

            <commComp:ExDataGrid Grid.Row="1" x:Name="MainBooks_dataGrid" ItemsSource="{Binding MainCurrentPageDV,UpdateSourceTrigger=PropertyChanged}" 
                    SelectedItem="{Binding SelectedItem_MainBooks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource DefaultDataGrid}" 
                    MouseDoubleClick="Books_dataGrid_MouseDoubleClick" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="交易包号"  Binding="{Binding blocknum}" Width="Auto" MinWidth="70"/>
                    <DataGridTemplateColumn Header="包状态" ClipboardContentBinding="{Binding exectype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='exectype'}" 
                                                     Width="Auto" MinWidth="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock x:Name="execText" Visibility="Visible" Text="{Binding exectype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='exectype'}"></TextBlock>
                                    <Grid Margin="2,0,0,0">
                                        <Image x:Name="exectipText" Visibility="Collapsed" Width="16" Height="16" ToolTip="{Binding Info7}" Source="/STC.Frame;component/Images/stc_icon_info_seleted.png">
                                        </Image>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding exectype}" Value="20">
                                        <Setter TargetName="execText" Property="Foreground" Value="#ED6D00"/>
                                        <Setter TargetName="execText"  Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="exectipText"  Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding exectype}" Value="22">
                                        <Setter TargetName="execText" Property="Foreground" Value="#307950"/>
                                        <Setter TargetName="execText"  Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="exectipText"  Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding exectype}" Value="23">
                                        <Setter TargetName="execText" Property="Foreground" Value="#DA2E38"/>
                                        <Setter TargetName="execText"  Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="exectipText"  Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTip}" Value="0">
                                        <Setter TargetName="execText"  Property="Visibility" Value="Visible"/>
                                        <!--<Setter TargetName="execRegular"  Property="Visibility" Value="Visible"/>-->
                                        <Setter TargetName="exectipText"  Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="发送状态" Binding="{Binding syncflag, Converter={StaticResource EnumTypeConvertor},ConverterParameter='syncflag'}" 
                                                    ClipboardContentBinding="{Binding syncflag, Converter={StaticResource EnumTypeConvertor},ConverterParameter='syncflag'}" 
                                                     Width="Auto" MinWidth="50">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridTextLeftStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding syncflag}" Value="21">
                                        <Setter Property="Foreground" Value="#ED6D00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding syncflag}" Value="22">
                                        <Setter Property="Foreground" Value="#307950"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding syncflag}" Value="23">
                                        <Setter Property="Foreground" Value="#DA2E38"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="Auto" MinWidth="88" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="SendBtn" Height="16" Width="42" Content="发送" Style="{StaticResource GrayButtonStyle2}" FontSize="10"
                                            Visibility="{Binding DataContext.ShowOps, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                            IsEnabled="{Binding OpsEnabled}"
                                                Command="{Binding DataContext.SendCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"
                                            Margin="0,0,4,0"/>
                                    <Button x:Name="EditBtn" Height="14" Width="14" Style="{StaticResource EditButton}" FontSize="10"
                                            Visibility="{Binding DataContext.ShowOps, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                             IsEnabled="{Binding OpsEnabled}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"
                                            Margin="0,0,4,0"/>
                                    <Button x:Name="DeleteBtn" Height="14" Width="14" Style="{StaticResource DeleteButton}" FontSize="10"
                                            Visibility="{Binding DataContext.ShowOps, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                             IsEnabled="{Binding OpsEnabled}"
                                                Command="{Binding DataContext.DelCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="方向" Binding="{Binding side,Converter ={StaticResource EnumTypeConvertor},ConverterParameter='side'}"  Width="Auto" MinWidth="40" />
                    <DataGridTextColumn Header="代码" Binding="{Binding securityid}" Width="Auto" MinWidth="85" Foreground="#F9C152"/>
                    <DataGridTextColumn Header="简称" Binding="{Binding symbol}" Width="Auto" MinWidth="85"  Foreground="#F9C152"/>
                    <DataGridTextColumn Header="本方交易员" Binding="{Binding partysubname}"  Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="对手交易机构名称" Binding="{Binding counterpartyname}"  Width="Auto" MinWidth="105" />
                    <DataGridTextColumn Header="对手交易员" Binding="{Binding counterpartysubname}" Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="收益率" Binding="{Binding yield}" Width="Auto" MinWidth="60"  />
                    <DataGridTextColumn Header="量(万)" Binding="{Binding ParentFlagQty}"  Width="Auto" MinWidth="80" />
                    <DataGridTextColumn Header="清算速度" Binding="{Binding settltype}"
                                        ClipboardContentBinding="{Binding settltype}" 
                                        Width="Auto" MinWidth="70" SortMemberPath="settldate">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="ToolTip" Value="{Binding settltype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="交易日期" Binding="{Binding tradeDate}"
                                        Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="交割日期" Binding="{Binding settldate}"
                                         Width="Auto" MinWidth="70"/>

                    <DataGridTextColumn Header="创建日期" Binding="{Binding createDate}"
                                         Width="Auto" MinWidth="70"/>

                    <DataGridTextColumn Header="STC成交单号" Binding="{Binding execid}"
                                         Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="STC成交价" Binding="{Binding price}"  Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="成交方式" Binding="{Binding terminal, Converter={StaticResource EnumTypeConvertor},ConverterParameter='terminal'}" 
                                                    ClipboardContentBinding="{Binding terminal, Converter={StaticResource EnumTypeConvertor},ConverterParameter='terminal'}" 
                                                     Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="笔数" Binding="{Binding num}" Width="Auto" MinWidth="40"/>
                    <DataGridTextColumn Header="最后更新人" Binding="{Binding closeby}"/>
                    <DataGridTextColumn Header="最后更新时间" Binding="{Binding updatetime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatMMDDHHMM}}"
                                         Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="最后发送时间" Binding="{Binding sendtime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatMMDDHHMM}}"
                                        Width="Auto" MinWidth="80"/>
                    <DataGridTemplateColumn Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Expander Style="{StaticResource DefaultExpander}" 
                                                            x:Name="expander" 
                                                            IsExpanded="{Binding IsExpanded}" 
                                                            Expanded="Expander_Expanded" 
                                                            Collapsed="Expander_Collapsed" 
                                                            BorderThickness="0">
                                </Expander>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </commComp:ExDataGrid>
            <!--<component:PageUI  Grid.Row="2" HorizontalAlignment="Right"/>-->
            <customeUI:PageControl x:Name="pageControl" Grid.Row="2" HorizontalAlignment="Right" PageSize="200"
                                   TotalCount="{Binding TotalCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                CurrentPageNum="{Binding CurrentPageNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   PageChanged="pageControl_PageChanged"
                                Visibility="{Binding PageVisible,Converter={StaticResource visibilityConvertor}}"/>
            <fUI:LoadingMask x:Name="loadMask" Visibility="{Binding LoadMaskVisiblity}" Grid.RowSpan="3" Grid.Row="0"></fUI:LoadingMask>

        </Grid>
        <Border  BorderBrush="#282828" BorderThickness="1" />
        <!--分割栏-->
        <GridSplitter x:Name="gridSplitter" Grid.Row="1" Background="#141414" Style="{StaticResource HGridSplitterStyle2}"/>
        <!--下半部分-->

        <Grid Grid.Row="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#282828">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="交易包号:" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
                <TextBlock x:Name="blockNumTextBox" Grid.Column="1" Width="160"  Height="18" 
                         VerticalAlignment="Center" 
                         Text="{Binding SelectBlockNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource QuotationList.SubTitle.Foreground}">
                </TextBlock>
            </Grid>
            <DockPanel Grid.Row="1">
                <local:SubDealTypeFilterPanel x:Name="subBookTypeFilterPanel"  Margin="20,0,0,0" FilterDicChanged="subBookTypeFilterPanel_FilterDicChanged"/>

                <Button  Style="{StaticResource ExportButton}" Margin="0,0,10,0" DockPanel.Dock="Right" Width="12" Height="12" Command="{Binding SubExportCommand}"
                         IsEnabled="{Binding SubExportEnabled}"/>
                <!--<local:BookInputFilterPanel  Margin="20,0,0,0" DockPanel.Dock="Right" 
                                             FilterType="{Binding SubSearchTextFilterType,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             SearchText="{Binding SubSearchText,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                -->
                <TextBlock/>
            </DockPanel>

            <commComp:ExDataGrid Grid.Row="2" x:Name="emsDataGrid" ItemsSource="{Binding SubCurrentPageDV}" 
                      Style="{StaticResource DefaultDataGrid}"  RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="交易包号"  Binding="{Binding blocknum}" Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="成交单号"  Binding="{Binding execid}"  Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="类型"  Binding="{Binding dealtype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='dealtype'}"
                                         ClipboardContentBinding="{Binding dealtype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='dealtype'}" 
                                        Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="方向" Binding="{Binding side,Converter ={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Width="Auto" MinWidth="40" />
                    <DataGridTextColumn Header="代码" Binding="{Binding securityid}" Width="Auto" MinWidth="85" Foreground="#F9C152"/>
                    <DataGridTextColumn Header="简称" Binding="{Binding symbol}" Width="Auto" MinWidth="85"  Foreground="#F9C152"/>
                    <DataGridTextColumn Header="收益率" Binding="{Binding yield,Converter={StaticResource numConvertor}}" Width="Auto" MinWidth="60"  />
                    <DataGridTextColumn Header="净价" Binding="{Binding netprice,Converter={StaticResource numConvertor}}" Width="Auto" MinWidth="60"  />
                    <!--<DataGridTextColumn Header="全价" Binding="{Binding dirtyPrice,Converter={StaticResource numConvertor}}" Width="Auto" MinWidth="60"  />-->
                    <DataGridTextColumn Header="量(万)" Binding="{Binding qty}" Width="Auto" MinWidth="80" />
                    <DataGridTextColumn Header="清算速度" Binding="{Binding settltype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"
                                        ClipboardContentBinding="{Binding settltype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                        Width="Auto" MinWidth="70" SortMemberPath="settldate">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="ToolTip" Value="{Binding settltype, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="交易日期" Binding="{Binding tradeDate}"
                                        Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="交割日期" Binding="{Binding settldate}"
                                         Width="Auto" MinWidth="70"/>

                    <DataGridTextColumn Header="创建日期" Binding="{Binding createDate}"
                                         Width="Auto" MinWidth="70"/>

                    <DataGridTextColumn Header="本方交易员" Binding="{Binding partysubname}"  Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="对手交易机构名称" Binding="{Binding counterpartyname}"  Width="Auto" MinWidth="105" />
                    <DataGridTextColumn Header="对手交易员" Binding="{Binding counterpartysubname}" Width="Auto" MinWidth="70"/>
                    <DataGridTextColumn Header="最后更新人" Binding="{Binding closeby}"/>
                    <DataGridTextColumn Header="最后更新时间" Binding="{Binding updatetime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatMMDDHHMM}}"
                                         Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="最后发送时间" Binding="{Binding sendtime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatMMDDHHMM}}"
                                        Width="Auto" MinWidth="80"/>

                    <!--<DataGridTextColumn Header="成交笔数" Binding="{Binding num}"/>
                    <DataGridTextColumn Header="STC成交单号" Binding="{Binding execid}"/>
                    <DataGridTextColumn Header="STC成交价" Binding="{Binding price}"/>-->

                </DataGrid.Columns>
            </commComp:ExDataGrid>
            <!--<customeUI:PageControl x:Name="SubBookPageControl" Grid.Row="3" HorizontalAlignment="Right" 
                               PageChanged="SubBookPageControl_PageChanged" Grid.Column="1"/>-->
            <fUI:LoadingMask x:Name="subloadMask" Visibility="{Binding SubloadMaskVisiblity}" Grid.RowSpan="3" Grid.Row="0"></fUI:LoadingMask>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#282828" BorderThickness="1" />
    </Grid>
</UserControl>
