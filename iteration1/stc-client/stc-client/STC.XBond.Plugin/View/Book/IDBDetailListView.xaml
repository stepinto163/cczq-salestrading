<component:WindowBase x:Class="STC.XBond.Plugin.View.Book.IDBDetailListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:component="clr-namespace:STC.XBond.Plugin.View.Component"
             mc:Ignorable="d" Title="代客IDB订单"
             ResizeMode="NoResize"
             Height="370" Width="789" Background="#1E1E1E"
                      Closed="WindowBase_Closed" BorderThickness="1" BorderBrush="#A0A0A0">
    <component:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </component:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <DataGrid Margin="5,10,5,0" BorderThickness="1" BorderBrush="#323232" Style="{StaticResource DefaultDataGrid}" ItemsSource="{Binding Datas.DefaultView}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="Selected_Chk" Checked="Selected_Chk_Checked" Unchecked="Selected_Chk_Unchecked" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                                <Border Background="#2D5D96" CornerRadius="2" Width="40" Height="16" Margin="10,0,0,0">
                                    <TextBlock Text="IDB" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="订单号"  Width="120" ClipboardContentBinding="{Binding MDEntryID}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MDEntryID}"  TextTrimming="CharacterEllipsis" ToolTip="{Binding MDEntryID}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="订单摘要"  Width="200" ClipboardContentBinding="{Binding Remark}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Remark}"  TextTrimming="CharacterEllipsis" ToolTip="{Binding Remark}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="成交价" Binding="{Binding LastPrice}" Width="80"/>
                <DataGridTextColumn Header="成交量" Binding="{Binding LastQty}" Width="80"/>
                <DataGridTextColumn Header="清算速度" Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" Width="80"/>
                <DataGridTemplateColumn Header="对手方前台账户名"  Width="120" ClipboardContentBinding="{Binding CounterPart}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPart}"  TextTrimming="CharacterEllipsis" ToolTip="{Binding CounterPart}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#FFFFFF">
            已选择：<Run Text="{Binding SelectedQty}"/>/<Run Text="{Binding TotalQty}"/>
        </TextBlock>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#323232" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}" 
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}" 
                        Click="btnOK_Click" >选择</Button>
            </StackPanel>

        </Border>
    </Grid>
</component:WindowBase>
