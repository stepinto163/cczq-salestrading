<UserControl x:Class="STC.XBond.Plugin.View.Book.BookTerminalFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             mc:Ignorable="d" 
             FontSize="12" Height="24"
             d:DesignHeight="24" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Height="16">
        <TextBlock x:Name="BookExeTypeLbl" Text="成交方式:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A0A0A0"/>

        <ListBox x:Name="BookExeTypeListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="BookExeTypeListBox_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate>
                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ControlTemplate>
            </ListBox.Template>
            <ListBoxItem x:Name="All" Content="全部" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
            <ListBoxItem Content="线上执行" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="渠道执行" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="线下补录" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
        </ListBox>
    </StackPanel>
</UserControl>
