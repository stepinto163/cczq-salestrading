<UserControl x:Class="STC.XBond.Plugin.View.Book.BookInputFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" 
             mc:Ignorable="d" 
             FontSize="12" Height="24"
             d:DesignHeight="24" d:DesignWidth="230">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
        <ComboBox x:Name="bookComboBox" Width="120"  Height="18" 
                          VerticalContentAlignment="Center" SelectedIndex="0" 
                          Style="{StaticResource NonEditableComboBoxStyle}"
                          SelectionChanged="bookComboBox_SelectionChanged">
            <ComboBoxItem Content="交易包号" Tag="BlockNum"/>
            <ComboBoxItem Content="STC成交单号" Tag="ExeID"/>
            <ComboBoxItem Content="方向" Tag="Side"/>
            <ComboBoxItem Content="债券代码" Tag="SecurityID"/>
            <ComboBoxItem Content="交易员" Tag="UserName"/>
        </ComboBox>
        <TextBox Width="130" Height="18" Padding="5, 0, 0, 0" 
                         Style="{StaticResource STCDefaultBoxStyle}" 
                         x:Name="bookTextBox"
                         Margin="5,0"
                         KeyDown="bookTextBox_KeyDown"
                         TextChanged="bookTextBox_TextChanged"/>

    </StackPanel>
</UserControl>
