<UserControl x:Class="STC.XBond.Plugin.View.Book.BrokerEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Book"
                     mc:Ignorable="d" FontSize="12" MinWidth="600" Height="204"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Background="#1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <!--标题-->
            <Border Grid.Column="0" Background="#2E58DB" CornerRadius="2" Width="40" Height="16" Margin="10,0,0,0">
                <TextBlock Text="经纪商" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!--idb 账号-->
            <Border  Grid.Column="1" x:Name="SourceTraderBorder" Background="{Binding Broker, Converter={StaticResource venuesColorConvertor}}" CornerRadius="2" Height="16" Width="40" Margin="10,0,0,0">
                <TextBlock x:Name="SourceTraderText" Foreground="#FFFFFF" Text="{Binding Broker,Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues_exe'}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <ComboBox  Grid.Column="2" x:Name="brokerCbc" ItemsSource="{Binding marketSource}" Visibility="Collapsed" Width="180" Height="24" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
            <Image  Grid.Column="4" x:Name="exectipBtn" Visibility="{Binding IsTipVis}" Width="16" Height="16" 
                   ToolTip="{Binding Info7}" Source="/STC.Frame;component/Images/stc_icon_info_seleted.png"
                   HorizontalAlignment="Right"
                    Margin="0,0,5,0">
            </Image>
            <!--报价-->
            <TextBlock   Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="#FFFFFF" Visibility="{Binding PriceVisibility}">
                ( 成交价：<Run Text="{Binding LastPx,StringFormat={}{0:N4}}"/> )
            </TextBlock>
        </Grid>

        <local:BrokerEditSubPanel Grid.Row="1"/>
    </Grid>

</UserControl>