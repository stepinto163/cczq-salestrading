<Window x:Class="STC.XBond.Plugin.View.VenuesLookView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.View"
        mc:Ignorable="d"
        Title="渠道执行-查看" Width="500" Height="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" BorderThickness="1" BorderBrush="#A0A0A0">
    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DefalutTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
            </Style>

            <Style x:Key="DataTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent" >
                                <Border.Background>
                                    <ImageBrush ImageSource="../Images/stc_button_dropdownarrow_normal.png"/>
                                </Border.Background>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>-->
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <VisualBrush x:Key="HintInstText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="客户机构名"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <VisualBrush x:Key="HintYieldText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="收益率(%)"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <VisualBrush x:Key="HintExchangeText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="客户交易员"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <ControlTemplate x:Key="InstTextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="false"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="border" Property="Background" Value="{StaticResource HintInstText}"/>
                    </MultiTrigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="YieldTextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="false"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="border" Property="Background" Value="{StaticResource HintYieldText}"/>
                    </MultiTrigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="ExTextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </Border>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                    </Trigger>

                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="false"/>
                            <Condition Property="Text" Value=""/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="border" Property="Background" Value="{StaticResource HintExchangeText}"/>
                    </MultiTrigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>




        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource ColorBrush.Gray13}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ColorBrush.Gray18}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"></TextBlock>
            <TextBlock Text="{Binding WinTitle}" Width="48" Padding="0, 15, 0, 0" Margin="10, 4, 0, 0" FontWeight="Bold"
                       Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource SmallContentFontSize}"/>

            <TextBlock Text="{Binding ExecId}" Padding="0, 15, 0, 0" Grid.Column="2" HorizontalAlignment="Right"  Margin="0, 4, 10, 0" FontWeight="Bold"
                       Foreground="{StaticResource ColorBrush.While}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource SmallContentFontSize}">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding ExecVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border  Grid.Row="0" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Margin="20, 0, 20, 0">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"></ColumnDefinition>
                        <ColumnDefinition Width="15*"></ColumnDefinition>
                        <ColumnDefinition Width="15*"></ColumnDefinition>
                        <ColumnDefinition Width="20*"></ColumnDefinition>
                        <ColumnDefinition Width="20*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="代码" Style="{StaticResource DefalutTextBlockStyle}"/>
                    <TextBlock Grid.Row="1" Margin="0,-8,0,0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Grid.Column="0" Text="{Binding GoodsCode}" Style="{StaticResource DataTextBlockStyle}" Height="14"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="简称" Style="{StaticResource DefalutTextBlockStyle}"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" Margin="0,-8,0,0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Text="{Binding Shortname}" Style="{StaticResource DataTextBlockStyle}" Height="14"/>


                </Grid>
            </Border>

            <Border  Grid.Row="1" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Margin="20, 0, 20, 0">
                <StackPanel x:Name="spExeOrder" Orientation="Vertical">

                </StackPanel>
            </Border>

        </Grid>


        <Grid Grid.Row="1" Visibility="{Binding FailVisibility}" Margin="20, 0, 20, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28*"/>
                <RowDefinition Height="32*"/>

                <RowDefinition Height="35*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <TextBlock Grid.Row="0" Grid.Column="0" Text="订单号" Style="{StaticResource DefalutTextBlockStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" Text="{Binding ExecOrder.OrderId}" Style="{StaticResource DataTextBlockStyle}" Height="14">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="方向" Style="{StaticResource DefalutTextBlockStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="0,10,0,0" Text="{Binding ExecOrder.Side}" Foreground="{Binding ExecOrder.SideBrush}" Style="{StaticResource DataTextBlockStyle}" Height="14"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="类型" Style="{StaticResource DefalutTextBlockStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Margin="0,10,0,0" Text="{Binding ExecOrder.FirmType}" Style="{StaticResource DataTextBlockStyle}" Height="14"/>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="报价" Style="{StaticResource DefalutTextBlockStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Top" Margin="0,10,0,0" Text="{Binding ExecOrder.Price}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTextBlockStyle}" Height="14">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>

            <TextBlock Grid.Row="0" Grid.Column="4" Text="量" Style="{StaticResource DefalutTextBlockStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Top" Margin="0,10,0,0" Text="{Binding ExecOrder.Amount}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTextBlockStyle}" Height="14">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="5" Text="清算速度" Style="{StaticResource DefalutTextBlockStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="5" VerticalAlignment="Top" Margin="0,10,0,0" Text="{Binding ExecOrder.Settle}" TextTrimming="CharacterEllipsis" Style="{StaticResource DataTextBlockStyle}" Height="14">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal">
                <TextBlock  Text="{Binding FailTxt}" Style="{StaticResource DefalutTextBlockStyle}" VerticalAlignment="Center" Margin="50, 0, 10, 0"/>
                <TextBlock  Text="{Binding Reason}" Style="{StaticResource DefalutTextBlockStyle}" VerticalAlignment="Center" Margin="10, 0, 0, 0"/>
            </StackPanel>

        </Grid>

        <Button Grid.Row="3" Content="确定" Command="{Binding OkCommand}" IsCancel="True" Width="100" Height="24" Margin="0, 0, 20, 0" FontSize="12" Background="#136C5E" Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}"/>

    </Grid>
</Window>
