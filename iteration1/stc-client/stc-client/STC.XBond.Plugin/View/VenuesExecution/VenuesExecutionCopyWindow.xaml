<Window x:Name="window" x:Class="STC.XBond.Plugin.View.VenuesExecutionCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.View"
        mc:Ignorable="d"
         MinHeight="100" WindowStartupLocation ="CenterScreen"
        Title="VenuesExecutionCopyWindow" 
        WindowStyle="None" Background="{x:Null}" AllowsTransparency="True"  Loaded="window_Loaded"
        Window.SizeToContent="WidthAndHeight" BorderThickness="1" BorderBrush="#A0A0A0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Storyboard x:Key="Storyboard_load">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="window">
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

        </ResourceDictionary>
    </Window.Resources>
    <!--<Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Storyboard_load}"/>
        </EventTrigger>
    </Window.Triggers>-->
    <Grid Background="#1E1E1E" >
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="tbTitle" Text="报价已复制" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="2秒后消失" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A0A0A0"/>
        </DockPanel>
        <!--<RichTextBox Grid.Row="1" Background="Transparent" MinHeight="20" MaxHeight="500" Width="230" BorderThickness="0"
                     Margin="20,16,20,16"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
            <FlowDocument x:Name="fdRiskContent" >
                
            </FlowDocument>
        </RichTextBox>-->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="tbRefer" Grid.Column="0" Text="Refer" Visibility="Collapsed" Foreground="#FFFFFF" Margin="10,0,0,22" VerticalAlignment="Center" Width="30" HorizontalAlignment="Left"/>
            <ListBox x:Name="copyList"  Grid.Column="1" Background="Transparent" MinHeight="20" MaxHeight="500" Width="350" BorderThickness="0"
                     Margin="20,16,20,16" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ItemTemplate="{DynamicResource DataTemplate1}">
                <ListBox.Resources>
                    <DataTemplate x:Key="DataTemplate1">
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,20,0" >
                            <TextBlock x:Name="Side_TB"
                                       Text="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}" Foreground="{Binding SideBrush}">
                                
                            </TextBlock>
                            <TextBlock x:Name="SecutiryID_TB" Text="{Binding SecurityID}" Foreground="#FFFFFF" Margin="5,0,0,0"/>
                            <TextBlock x:Name="FirmFlag_TB" Text="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='firmflag'}" Foreground="#FFFFFF" Margin="5,0,0,0"/>
                            <TextBlock x:Name="Px_TB" Text="{Binding Px, StringFormat='{}{0:N4}%'}" Foreground="#FFFFFF" Margin="5,0,0,0"/>
                            <TextBlock x:Name="Qty_TB" Text="{Binding Qty}" Foreground="#FFFFFF" Margin="5,0,0,0"/>
                            <TextBlock x:Name="SettlType_TB" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype'}" Foreground="#FFFFFF" Margin="5,0,0,0"/>
                            <TextBlock x:Name="Venues" Text="{Binding Venues, StringFormat='{}（{0} ', Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues'}" Foreground="#FFFFFF" Margin="5,0,0,0"/>
                            <TextBlock x:Name="No" Text="{Binding No, StringFormat='{}{0}）'}" Foreground="#FFFFFF" Margin="5,0,0,0"/>
                            <TextBlock x:Name="tbBondInfo" Text="{Binding BondInfo}" Foreground="#FFFFFF" Margin="5,0,0,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>

                        </StackPanel>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </Grid>
        
    </Grid>
</Window>
