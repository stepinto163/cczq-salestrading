<UserControl x:Class="STC.XBond.Plugin.View.VenuesExecutionFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             mc:Ignorable="d" Height="25">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal">
            <ListBox x:Name="VenuesListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="VenuesListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="国际" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="国利" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="平安" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="信唐" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="中诚" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            </ListBox>

            <TextBlock Text="状态：" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="StatusListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="StatusListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="待处理" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="处理中" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="已成交" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="撤销中" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="已撤销" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <!--<ListBoxItem Content="待撤销" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>-->
                <!--<ListBoxItem Content="部分成交" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>-->
                <!--<ListBoxItem Content="异常" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>-->
            </ListBox>

            <ListBox x:Name="IsOCOListBox"  Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="IsOCOListBox_SelectionChanged" Margin="32,0,0,0">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="独家Firm" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <!--<ListBoxItem Content="非独家Firm" Style="{StaticResource CommonFilterListBoxItemStyle}"/>-->
            </ListBox>

            <ListBox x:Name="lbMyOperation"  Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="LbMyOperation_SelectionChanged" Margin="32,0,0,0">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="全部" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True"/>
                <ListBoxItem Content="我的" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="未指定" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            </ListBox>

            <Button Content="批量复制" Margin="32, 0, 5, 0" Height="19" Style="{StaticResource RedButtonStyle}" Click="Button_Click"></Button>
        </StackPanel>
    </Grid>
</UserControl>
