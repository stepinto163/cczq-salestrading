<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component"
             x:Class="STC.XBond.Plugin.View.XBondView"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <!-- 上半部分 -->
        <Border BorderBrush="{StaticResource MainBackgroup.ColorBrush}" BorderThickness="1">
            <!--X-bond做市-->
            <local:BondList x:Name="bondList"/>
        </Border>


        <!-- 下半部分 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource MainBackgroup.ColorBrush}"  BorderThickness="1">
            <!--我的交易-->
            <local:MyTrading x:Name="myTrading"/>
        </Border>
    </Grid>
</UserControl>
