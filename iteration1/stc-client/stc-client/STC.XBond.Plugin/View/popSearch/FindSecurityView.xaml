<UserControl x:Class="STC.XBond.Plugin.View.popSearch.FindSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.popSearch"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="360" Background="#0F0F0F">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="True"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock x:Name="tbTitle" Foreground="#F9C152" Margin="5" FontFamily="{StaticResource DefaultFont}" FontSize="14" Text="搜索债券"></TextBlock>
        <DataGrid x:Name="dgResult"
                  Grid.Row="1"
                  Background="#0F0F0F"
                  ItemsSource="{Binding}" 
                  HeadersVisibility="None"
                  BorderThickness="0"       
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  Margin="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  MouseDoubleClick="dgResult_MouseDoubleClick"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" Style="{StaticResource DefaultDataGrid}">
            <DataGrid.Resources>
                <Style x:Key="tbStyle" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Bond_ID}" Width="1*" >
                    <DataGridTextColumn.ElementStyle >
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="Padding" Value="10,0,0,0"></Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent">
                                <TextBlock Grid.Column="0" Height="22" Text="{Binding Short_Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForeground}"
                                                TextTrimming="CharacterEllipsis" >
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding RemaingingTime}" Width="1*"  ElementStyle="{StaticResource tbStyle}" ></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBox x:Name="tbSearch" Grid.Row="2" Margin="5"
                 FontFamily="{StaticResource DefaultFont}" 
                 Height="22px"
                 Style="{StaticResource DefaultTextBoxStyle}"
                 KeyDown="tbSearch_KeyDown"
                 PreviewKeyDown="tbSearch_PreviewKeyDown"
                 TextChanged="tbSearch_TextChanged"
                 ContextMenu="{x:Null}">
        </TextBox>
    </Grid>
</UserControl>
