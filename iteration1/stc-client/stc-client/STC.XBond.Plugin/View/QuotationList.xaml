                <Setter Property="MinHeight" Value="18"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="Background" Value="{StaticResource PriceButtonDefaultBackground}"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>



