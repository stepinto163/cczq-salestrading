<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:ViewModel="clr-namespace:STC.XBond.Plugin.ViewModel"
             x:Class="STC.XBond.Plugin.View.QuotationList"
             xmlns:command ="clr-namespace:STC.XBond.Plugin.Command"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="1014" ContextMenuOpening="UserControl_ContextMenuOpening">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <!--<Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource DefaultContextMenu}"/>
            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource DefaultMenuItem}"/>-->

            <ContextMenu x:Key="OrderContextMenu" Style="{DynamicResource DefaultContextMenu}" ContextMenuOpening="UserControl_ContextMenuOpening">
                <MenuItem x:Name="miSendPrice" Header="报价" Style="{DynamicResource DefaultMenuItem}" Click="OrderMenuItme_Click"/>
                <MenuItem x:Name="miSendDrp" Header="定向回价" Style="{DynamicResource DefaultMenuItem}" Click="miSendDrp_Click"/>
                <MenuItem x:Name="miEdit" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="MenuItem_Click"/>
                <MenuItem x:Name="miCancel" Header="撤销" Style="{DynamicResource DefaultMenuItem}" Click="MiCancel_Click"/>
            </ContextMenu>

            <Style x:Key="QuotationList_DataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{DynamicResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{DynamicResource DataGridColumnHeaderBackground}"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Bid_QuotationList_DataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{DynamicResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{DynamicResource DataGridColumnHeaderBackground}"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ControlTemplate x:Key="QuotationList_DataGridCellTemplate" TargetType="{x:Type DataGridCell}">
                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                    <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="Height" Value="40"/>
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <Style x:Key="QuotationList_DataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Template" Value="{DynamicResource QuotationList_DataGridCellTemplate}"/>
            </Style>
            <Style x:Key="QuotationList_DataGridCellStyle_left" TargetType="{x:Type DataGridCell}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="TextBlock.TextAlignment" Value="Left"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Template" Value="{DynamicResource QuotationList_DataGridCellTemplate}"/>
            </Style>
            <Style x:Key="EnlargeFontSizeElementStyle_Bid" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange_firm}"/> 
                <Setter Property="FontWeight" Value="Bold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="FontSize" Value="18"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <!--<Setter Property="Foreground" Value="{StaticResource Text.Foreground.NoPermission}"/>-->
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>

                    <!--<DataTrigger Binding="{Binding FirmFlag}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange_nofirm}"/>
                    </DataTrigger>-->
                </Style.Triggers>
            </Style>
            <Style x:Key="EnlargeFontSizeElementStyle_Ofr" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue_firm}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="FontSize" Value="18"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <!--<Setter Property="Foreground" Value="{StaticResource Text.Foreground.NoPermission}"/>-->
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>

                    <!--<DataTrigger Binding="{Binding FirmFlag}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue_nofirm}"/>
                    </DataTrigger>-->
                </Style.Triggers>
            </Style>
            <Style x:Key="QtyStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                <!--<Style.Triggers>
                    <DataTrigger Binding="{Binding FirmFlag}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource DataGrid.SubTitle.Foreground}"/>
                    </DataTrigger>
                </Style.Triggers>-->
            </Style>
            <Style x:Key="TotalQtyStyle" TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="Text" Value=""/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="需请示"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FirmFlag}" Value="1">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_shandian_14x14.png"/>
                        <Setter Property="ToolTip" Value="firm"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="QuotationList_DataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <!-- 不需要虚拟模式 -->
                <!--<Setter Property="EnableRowVirtualization" Value="False"/>-->
                <!-- 不需要边框 -->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="VirtualizingStackPanel.IsVirtualizing"  Value="True"/>
                <Setter Property="VirtualizingStackPanel.VirtualizationMode"  Value="Recycling"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="AllowDrop" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserSortColumns" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="False"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource DefaultAlternatingRowBackground.ColorBrush}"/>

            </Style>
            <Style x:Key="bid_quotation_list_style" BasedOn="{StaticResource QuotationList_DataGridStyle}" TargetType="{x:Type DataGrid}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGrid}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="DG_ScrollViewer" Focusable="false">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>

                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!--<Button Command="{x:Static DataGrid.SelectAllCommand}" Focusable="false" Style="{DynamicResource {ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}}" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.All}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Width="{Binding CellsPanelHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>-->

                                                <ScrollContentPresenter
						                            x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="1" 
                                                    Grid.ColumnSpan="2" 
						                            Grid.Row="1"
						                            CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                                <DataGridColumnHeadersPresenter
						                            x:Name="PART_ColumnHeadersPresenter"
                                                    Grid.Column="2" 
                                                    Grid.Row="0"
						                            Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>

                                                <Grid 
                                                    Grid.Column="2" 
                                                    Grid.Row="2">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ScrollBar x:Name="PART_HorizontalScrollBar"
						                                    Grid.Column="1"
						                                    Maximum="{TemplateBinding ScrollableWidth}"
						                                    Orientation="Horizontal"
						                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
							                                Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
							                                ViewportSize="{TemplateBinding ViewportWidth}"/>
                                                </Grid>
                                                <ScrollBar 
						                            x:Name="PART_VerticalScrollBar"
                                                    Margin="0,40,0,0"
                                                    Grid.ColumnSpan="3" 
                                                    Grid.Row="1" 
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Stretch"
						                            Orientation="Vertical"
						                            Maximum="{TemplateBinding ScrollableHeight}"
						                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
						                            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
						                            ViewportSize="{TemplateBinding ViewportHeight}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>
            <Style x:Key="ofr_quotation_list_style" BasedOn="{StaticResource QuotationList_DataGridStyle}" TargetType="{x:Type DataGrid}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGrid}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="DG_ScrollViewer" Focusable="false">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!--<Button Command="{x:Static DataGrid.SelectAllCommand}" Focusable="false" Style="{DynamicResource {ComponentResourceKey ResourceId=DataGridSelectAllButtonStyle, TypeInTargetAssembly={x:Type DataGrid}}}" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.All}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Width="{Binding CellsPanelHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>-->

                                                <DataGridColumnHeadersPresenter
						                            x:Name="PART_ColumnHeadersPresenter"
                                                    Grid.Column="1" 
                                                    Grid.Row="0"
						                            Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>

                                                <ScrollContentPresenter
						                            x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0" 
                                                    Grid.ColumnSpan="2" 
						                            Grid.Row="1"
						                            CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                               
                                                <Grid 
                                                    Grid.Column="1" 
                                                    Grid.Row="2">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ScrollBar x:Name="PART_HorizontalScrollBar"
						                                    Grid.Column="1"
						                                    Maximum="{TemplateBinding ScrollableWidth}"
						                                    Orientation="Horizontal"
						                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
							                                Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
							                                ViewportSize="{TemplateBinding ViewportWidth}"/>
                                                </Grid>
                                                <ScrollBar 
						                            x:Name="PART_VerticalScrollBar"
                                                    Margin="0,40,0,0"
                                                    Grid.ColumnSpan="3" 
                                                    Grid.Row="1" 
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Stretch"
						                            Orientation="Vertical"
						                            Maximum="{TemplateBinding ScrollableHeight}"
						                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
						                            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
						                            ViewportSize="{TemplateBinding ViewportHeight}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>
            <DataTemplate x:Key="TotalQty_DataTemplate" >
                <Grid>
                    <TextBlock x:Name="TotalQty_TB" Text="{Binding TotalQty}" Foreground="{DynamicResource DefaultForegroup.ColorBrush}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="Text" TargetName="TotalQty_TB" Value=""/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <Setter Property="Foreground" TargetName="TotalQty_TB" Value="{DynamicResource Text.Foreground.NoPermission}"/>
                        <Setter Property="FontFamily" TargetName="TotalQty_TB" Value="Roboto" />
                        <Setter Property="FontWeight" TargetName="TotalQty_TB" Value="Normal" />
                        <Setter Property="FontStyle" TargetName="TotalQty_TB" Value="Italic" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="Bid_Source_DataTemplate">
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        
                    </Grid.ColumnDefinitions>
