                               Foreground="{Binding PartySubName,Converter={StaticResource venuesColorConvertor}}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, ElementName=DealerName}"/>-->
                    <TextBlock x:Name="DealerName" Text="{Binding CustomerSource}"
                               Foreground="{Binding PartySubName,Converter={StaticResource venuesColorConvertor}}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, ElementName=DealerName}"/>
                    <Border x:Name="isMeBorder" CornerRadius="2" BorderThickness="1" BorderBrush="#515151" Width="16" Height="16" Visibility="Collapsed" Margin="5,0,0,0" Grid.Column="1">
                        <TextBlock Text="我" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <Border x:Name="userTag" Width="16" Height="16" ToolTip="{Binding InstitutionName}" Visibility="Collapsed" Grid.Column="2" Margin="5,0,0,0">
                        <Border.Background>
                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_icon_people_normal.png"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ShowTrader}" Value="1">
                        <Setter TargetName="userTag" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMe}" Value="true">
                        <Setter TargetName="isMeBorder" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    
                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <Setter TargetName="DealerName" Property="Foreground" Value="{StaticResource Text.Foreground.NoPermission}"/>
