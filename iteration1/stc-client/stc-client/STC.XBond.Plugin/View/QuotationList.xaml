            <DataTemplate x:Key="Tag_DataTemplate_LeftToRight">
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                    <Border x:Name="whole" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="{DynamicResource TextBox.Focus.Border}" BorderThickness="0" Margin="4,0,0,0">
                        <TextBlock Text="整" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                    </Border>
                    <Border x:Name="T0" CornerRadius="2" Width="16" Height="16" Background="#6E2022" BorderThickness="0" Margin="4,0,0,0">
                        <Border.Visibility>
                            <MultiBinding Converter="{StaticResource multiVisibilityConverter}">
                                <Binding Path="MarketIndicator" />
                                <Binding Path="SettlType" />
                                <Binding Path="SecurityID" />
                                <Binding Path="VenueTypeGW" />
                            </MultiBinding>
                        </Border.Visibility>
                        <TextBlock Text="+0" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                    </Border>
