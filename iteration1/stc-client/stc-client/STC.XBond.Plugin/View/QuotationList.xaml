                                    <MultiDataTrigger.Setters>
                                        <Setter TargetName="trycalc" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
