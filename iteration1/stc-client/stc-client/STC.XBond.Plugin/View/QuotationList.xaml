            <Style x:Key="BidDataGridRowStyle" TargetType="{x:Type DataGridRow}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="30"/>
                <EventSetter Event="MouseDoubleClick" Handler="BidDataGrid_MouseDoubleClick"/>
                <!--<EventSetter Event="MouseRightButtonDown" Handler="BidDataGrid_MouseRightButtonDown"/>-->
                <EventSetter Event="MouseRightButtonUp" Handler="DataGrid_MouseRightButtonUp"/>
                <Style.Triggers>

                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                    </Trigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Bid.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bid.MouseOver.BorderBrush}"/>

                    </MultiTrigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Bid.Selected.Backgroud}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Bid.Selected.BorderBrush}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="Height" Value="40"/>
                    </DataTrigger>
                </Style.Triggers>
                
            </Style>
            <Style x:Key="OfrDataGridRowStyle" TargetType="{x:Type DataGridRow}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="30"/>
                <EventSetter Event="MouseDoubleClick" Handler="OfrDataGrid_MouseDoubleClick"/>
                <!--<EventSetter Event="MouseRightButtonDown" Handler="OfrDataGrid_MouseRightButtonDown"/>-->
                <EventSetter Event="MouseRightButtonUp" Handler="DataGrid_MouseRightButtonUp"/>
                <Style.Triggers>

                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                        <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                    </Trigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Ofr.MouseOver.Background}"/>
                        <Setter Property="Background" Value="{StaticResource Ofr.MouseOver.BorderBrush}"/>
                    </MultiTrigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Ofr.Selected.Backgroud}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Ofr.Selected.BorderBrush}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="Height" Value="40"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
            <!--清算速度 +0 远 按钮-->
