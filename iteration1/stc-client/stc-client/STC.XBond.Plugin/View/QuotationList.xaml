                                    <Image x:Name="bargainFlag_Img" Width="14" Height="14" Style="{StaticResource BargainFlagStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="bid_InComplete_NetPriceColumn" Header="元" Width="2.8*" MinWidth="120"  Visibility="Collapsed">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource Bid_QuotationList_DataGridColumnHeaderStyle}">
                                <Setter Property="Margin" Value="16,0,0,0"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Column="1">
                                        <TextBlock Style="{StaticResource EnlargeFontSizeElementStyle_Bid}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource numConvertor3}">
                                                    <Binding Path="NetPrice" />
                                                    <Binding Path="MarketIndicator" />
                                                    <Binding Path="MinChange" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                            <TextBlock.ToolTip>
                                                <MultiBinding Converter="{StaticResource numConvertor3}">
                                                    <Binding Path="NetPrice" />
                                                    <Binding Path="MarketIndicator" />
                                                    <Binding Path="MinChange" />
                                                </MultiBinding>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <Border x:Name="exerciseflagBorder" CornerRadius="2" Width="16" Height="16" Background="#136C5E" BorderThickness="0" Margin="2,0,0,0">
                                            <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource  pricetypeexerciseflagconvertor}">
                                                        <Binding Path="PriceType" />
                                                        <Binding Path="ExerciseFlag" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Border.Visibility>
                                                <MultiBinding Converter="{StaticResource  pricetypeexerciseflagvisibleconvertor}">
                                                    <Binding Path="PriceType" />
                                                    <Binding Path="ExerciseFlag" />
                                                </MultiBinding>
                                            </Border.Visibility>
                                        </Border>
                                    </StackPanel>
                                    <!--<TextBlock Text="{Binding FirmFlag, Converter={StaticResource FirmFlagConvertor}}" Margin="2,0,0,0" Width="6"
                                           Foreground="#FFFFFF" />-->
                                    <Image x:Name="bargainFlag_Img" Width="14" Height="14" Style="{StaticResource BargainFlagStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel Orientation="Vertical"  Grid.Row="3" Grid.Column="3" Visibility="{Binding ShowImcompletePanel}" Height="60">
            <DataGrid x:Name="OfrIncompleteDataGrid" GotFocus="OfrIncompleteDataGrid_GotFocus"
                  ItemsSource="{Binding OfrIncompleteQuotations}"
                  ColumnHeaderStyle="{StaticResource QuotationList_DataGridColumnHeaderStyle}"
                  Style="{StaticResource ofr_quotation_list_style}"
                  CellStyle="{StaticResource QuotationList_DataGridCellStyle}"
                  RowStyle="{DynamicResource OfrDataGridRowStyle}"
                  HeadersVisibility ="None"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  BorderThickness="0,2,0,0" BorderBrush="#0A2420">

                <DataGrid.Columns>

                    <!-- ofr -->
                    <DataGridTemplateColumn x:Name="Ofr_Incomplete_NetPriceColumn" Header="元" Width="2.8*" MinWidth="120"  Visibility="Collapsed">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource QuotationList_DataGridColumnHeaderStyle}">
                                <Setter Property="Margin" Value="0,0,16,0"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border x:Name="exerciseflagBorder" CornerRadius="2" Width="16" Height="16" Background="#136C5E" BorderThickness="0" Margin="2,0,0,0">
                                            <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource  pricetypeexerciseflagconvertor}">
                                                        <Binding Path="PriceType" />
                                                        <Binding Path="ExerciseFlag" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Border.Visibility>
                                                <MultiBinding Converter="{StaticResource  pricetypeexerciseflagvisibleconvertor}">
                                                    <Binding Path="PriceType" />
                                                    <Binding Path="ExerciseFlag" />
                                                </MultiBinding>
                                            </Border.Visibility>
                                        </Border>
                                        <TextBlock Style="{StaticResource EnlargeFontSizeElementStyle_Ofr}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource numConvertor3}">
                                                    <Binding Path="NetPrice" />
                                                    <Binding Path="MarketIndicator" />
                                                    <Binding Path="MinChange" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                            <TextBlock.ToolTip>
                                                <MultiBinding Converter="{StaticResource numConvertor3}">
                                                    <Binding Path="NetPrice" />
                                                    <Binding Path="MarketIndicator" />
                                                    <Binding Path="MinChange" />
                                                </MultiBinding>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </StackPanel>
                                    <!--<TextBlock Text="{Binding FirmFlag, Converter={StaticResource FirmFlagConvertor}}" Margin="2,0,0,0" Width="6"
                                           Foreground="#FFFFFF" />-->
                                    <Image x:Name="bargainFlag_Img" Width="14" Height="14" Style="{StaticResource BargainFlagStyle}" Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="Ofr_Incomplete_YieldColumn" Header="%" Width="2.8*" MinWidth="120" Visibility="Visible">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource QuotationList_DataGridColumnHeaderStyle}">
                                <Setter Property="Margin" Value="0,0,16,0"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Yield,StringFormat={}{0:0.00##}}"
                                               Style="{StaticResource EnlargeFontSizeElementStyle_Ofr}"
                                                   ToolTip="{Binding Yield,StringFormat={}{0:0.00##}}" 
                                                   TextTrimming="CharacterEllipsis"></TextBlock>
                                    </StackPanel>
                                    <Image x:Name="bargainFlag_Img" Width="14" Height="14" Style="{StaticResource BargainFlagStyle}" Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="Ofr_Incomplete_YieldToExecutionColumn" Header="%" Width="2.8*" MinWidth="120" Visibility="Visible">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource QuotationList_DataGridColumnHeaderStyle}">
                                <Setter Property="Margin" Value="0,0,16,0"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding YieldToExecution,StringFormat={}{0:0.00##}}"
                                               Style="{StaticResource EnlargeFontSizeElementStyle_Ofr}"
                                                   ToolTip="{Binding YieldToExecution,StringFormat={}{0:0.00##}}" 
                                                   TextTrimming="CharacterEllipsis"></TextBlock>
                                    </StackPanel>
                                    <Image x:Name="bargainFlag_Img" Width="14" Height="14" Style="{StaticResource BargainFlagStyle}" Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="2*" CellTemplate="{StaticResource Qty_DataTemplate}">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource QuotationList_DataGridColumnHeaderStyle}">
                                <Setter Property="Margin" Value="0,0,10,0"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.HeaderAmount,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay,RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                    </DataGridTemplateColumn>
                    <!--<DataGridTextColumn Binding="{Binding FirmFlag, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='firmflag'}" Width="1*" 
                                        CellStyle="{StaticResource QuotationList_DataGridCellStyle_left}" 
                                        ElementStyle="{StaticResource QtyStyle}"/>-->
                    <DataGridTemplateColumn Width="60" CellTemplate="{StaticResource Tag_DataTemplate_LeftToRight}" />

                    <DataGridTemplateColumn Header="来源" Width="2*" 
                                        CellTemplate="{StaticResource Source_DataTemplate}"/>
                    <!--<DataGridTextColumn Binding="{Binding Time,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" 
                                        Header="时间" Width="70"  
                                    Foreground="{StaticResource DataGrid.SubTitle.Foreground}"/>-->
                    <DataGridTextColumn Binding="{Binding Time}" 
                                        Header="时间" Width="70"  
                                    Foreground="{StaticResource DataGrid.SubTitle.Foreground}"/>
                    <DataGridTextColumn Header="累计" Width="2*" Visibility="{Binding Data.ShowSum,Source={StaticResource proxy}}"
                                    Foreground="{StaticResource DefaultForegroup.ColorBrush}"/>
                    <DataGridTextColumn Width="10" MinWidth="0"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
