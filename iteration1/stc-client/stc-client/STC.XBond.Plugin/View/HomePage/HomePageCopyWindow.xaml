<Window x:Class="STC.XBond.Plugin.View.HomePage.HomePageCopyWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.HomePage"
             mc:Ignorable="d" 
          
        MinHeight="100" WindowStartupLocation ="CenterScreen"
         WindowStyle="None" Background="{x:Null}" AllowsTransparency="True"  Loaded="window_Loaded"
        Window.SizeToContent="WidthAndHeight" BorderThickness="1" BorderBrush="#A0A0A0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Storyboard x:Key="Storyboard_load">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="window">
                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

        </ResourceDictionary>
    </Window.Resources>
    <!--<Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource Storyboard_load}"/>
        </EventTrigger>
    </Window.Triggers>-->
    <Grid Background="#1E1E1E" >
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="tbTitle" Text="报价已复制" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="2秒后消失" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#A0A0A0"/>
        </DockPanel>
        <TextBlock x:Name="tbRefer" Grid.Row="1" Grid.ColumnSpan="2" Foreground="#FFFFFF" Margin="20,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
    </Grid>
</Window>
