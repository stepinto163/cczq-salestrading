<TabControl x:Class="STC.XBond.Plugin.View.HomePage.HomePageTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.HomePage"
             xmlns:comp="clr-namespace:STC.XBond.Plugin.View.Component"
             xmlns:homepage="clr-namespace:STC.XBond.Plugin.View.HomePage"
             xmlns:interactions="http://schemas.microsoft.com/expression/2010/interactions"
             xmlns:interactivity="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:utils="clr-namespace:STC.XBond.Plugin.Utils"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:command ="clr-namespace:STC.XBond.Plugin.Command"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" Style="{DynamicResource HomePageTabControlStyle}">
    <TabControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <fcon:MultiBindingConverter x:Key="MultiBindingConverter"/>
            <SolidColorBrush x:Key="TabItem.Selected.Background2" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TabItem.Selected.Border2" Color="#ACACAC"/>
            <Style x:Key="HomePageTabControlStyle" TargetType="{x:Type TabControl}">
                <Setter Property="Padding" Value="2"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource TabItem.Selected.Background2}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TabItem.Selected.Border2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <Grid x:Name="templateRoot" ClipToBounds="true" SnapsToDevicePixels="true" KeyboardNavigation.TabNavigation="Local">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColumnDefinition0"/>
                                    <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                                    <RowDefinition x:Name="RowDefinition1" Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="mainGrid" Height="24" Grid.Row="0" SizeChanged="Grid_SizeChanged" Background="{DynamicResource MidnightBlueSilverBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- left button -->
                                    <Border x:Name="LeftBtn_Area" Visibility="Visible" Grid.Row="0" Grid.Column="0" BorderThickness="0" BorderBrush="#282828" Background="Transparent" HorizontalAlignment="Left" Panel.ZIndex="2">
                                        <Border.CacheMode>
                                            <BitmapCache SnapsToDevicePixels="True"/>
                                        </Border.CacheMode>
                                        <RepeatButton Focusable="False" Content="&lt;" Foreground="#FFFFFF" BorderThickness="0" Background="Transparent" x:Name="PART_ScrollButtonLeft" Click="ButtonScrollLeft_Click"/>
                                    </Border>
                                    <!-- tabpanel -->
                                    <comp:CustomScrollViewer HorizontalScrollBarVisibility="Hidden"  Grid.Row="0" Grid.Column="1" CanMouseWheel="True" Orientation="Horizontal" IsInertiaEnabled="True"	IsDeferredScrollingEnabled="True" x:Name="PART_OverflowScrollviewer"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto" Focusable="False"  BorderThickness="0" Padding="0">
                                        <Border Background="Transparent" BorderThickness="0,0,0,0" BorderBrush="#282828" Name="PART_HeaderBorder">
                                            <homepage:HomePageTabPanel MinHeight="24" TabItemHeight="24" x:Name="PART_HeaderPanel" HorizontalAlignment="Left" Background="Transparent" IsItemsHost="true" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1">
                                                <interactivity:Interaction.Behaviors>
                                                    <interactions:FluidMoveBehavior AppliesTo="Children" Duration="{Binding FluidMoveDuration,ElementName=PART_HeaderPanel}">
                                                        <interactions:FluidMoveBehavior.EaseX>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </interactions:FluidMoveBehavior.EaseX>
                                                    </interactions:FluidMoveBehavior>
                                                </interactivity:Interaction.Behaviors>
                                            </homepage:HomePageTabPanel>
                                        </Border>
                                    </comp:CustomScrollViewer>
                                    <!-- right button-->
                                    <Border x:Name="RightBtn_Area" Grid.Row="0" Grid.Column="2" BorderThickness="0" BorderBrush="#282828" Background="Transparent" HorizontalAlignment="Right">
                                        <Border.CacheMode>
                                            <BitmapCache SnapsToDevicePixels="True"/>
                                        </Border.CacheMode>
                                        <StackPanel Orientation="Horizontal">
                                            <RepeatButton Focusable="False" BorderThickness="0" Visibility="Visible" Content="&gt;" Foreground="#FFFFFF" Background="Transparent" x:Name="PART_ScrollButtonRight" Click="ButtonScrollRight_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <!--<TabPanel x:Name="headerPanel" Background="Transparent" Grid.Column="1" IsItemsHost="true" Grid.Row="0" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>-->
                                    <!-- 加号部分-->
                                    <Canvas Grid.Column="3">
                                        <Rectangle Margin="0,4,0,4" Width="1" Height="16" Fill="#3C3C3C"/>
                                        <Button x:Name="AddGroupBtn" Margin="10,6,0,6" Width="12" Height="12" Style="{DynamicResource MainPageImageAddButton}" Click="AddGroupBtn_Click"/>
                                    </Canvas>
                                    
                                    
                                    
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Column="5">
                                        <Button x:Name="importBtn" Width="12" Height="12" Style="{DynamicResource ImportButton}" Margin="16,0,0,0" Click="importBtn_Click" Visibility="Collapsed"/>
                                        <Button x:Name ="popupBtn" Width="12" Height="12" Style="{DynamicResource PopupButton}" Margin="12,0,16,0" Visibility="Collapsed"
                                                 Command="{x:Static utils:WindowKeyHelper.popupWindowCommand}">
                                            <Button.CommandParameter>
                                                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                                    <MultiBinding.Bindings>
                                                        <Binding Source="{x:Static command:PopupTypeEnum.HomePage}" Mode="OneWay"/>
                                                        <Binding ElementName="popupBtn"/>
                                                    </MultiBinding.Bindings>
                                                </MultiBinding>
                                            </Button.CommandParameter>
                                        </Button>
                                    </StackPanel>
                                </Grid>


                                <Border x:Name="contentPanel" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.Column="0" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="1" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="TextElement.Foreground" TargetName="templateRoot" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding ScrollableWidth, ElementName= PART_OverflowScrollviewer}" Value="0">
                                    <Setter Property="Visibility" TargetName="LeftBtn_Area" Value="Hidden"/>
                                    <Setter Property="Visibility" TargetName="RightBtn_Area" Value="Hidden"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </TabControl.Resources>
</TabControl>
