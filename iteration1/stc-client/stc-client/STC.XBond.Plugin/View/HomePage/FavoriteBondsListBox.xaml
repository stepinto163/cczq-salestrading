                                </Grid>
                                <!--<ProgressBar Grid.Row="1" Background="#1E1E1E" Foreground="#58B3FF" Value="{Binding BestOfrQty}" Maximum="30000"   BorderThickness="0"/>-->

                            </Grid>
                            <DataTemplate.Triggers>

                                <!--最优ofr报价，清算速度显示-->
                                <DataTrigger Binding="{Binding BestOfrSettlTypeTag}" Value="1">
                                    <Setter TargetName="Ofr_T0" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BestOfrYuanSettlTypeTag}" Value="1">
                                    <Setter TargetName="Ofr_yuan" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- 小三角标记 -->
                                <!-- 本机构有报价，且本人有报价 -->
                                <DataTrigger Binding="{Binding BestOfrFlagType}" Value="1">
                                    <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OfrArrow" Property="Stroke" Value = "#009AFF"/>
                                    <Setter TargetName="OfrArrow" Property="Fill" Value = "#009AFF"/>
                                    <Setter TargetName="OfrArrow" Property="ToolTip" Value="本人有报价"/>
                                </DataTrigger>
                                <!-- 本人有报价 -->
                                <DataTrigger Binding="{Binding BestOfrFlagType}" Value="2">
                                    <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OfrArrow" Property="Stroke" Value = "#009AFF"/>
                                    <!--<Setter TargetName="OfrArrow" Property="Stroke" Value="transparent"/>-->
                                    <Setter TargetName="OfrArrow" Property="ToolTip" Value="本人有报价"/>
                                </DataTrigger>
                                <!-- 本机构有报价 -->
                                <DataTrigger Binding="{Binding BestOfrFlagType}" Value="3">
                                    <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OfrArrow" Property="Stroke" Value="{DynamicResource TextBox.Focus.Border}"/>
                                    <Setter TargetName="OfrArrow" Property="Fill" Value="{DynamicResource TextBox.Focus.Border}"/>
                                    <Setter TargetName="OfrArrow" Property="ToolTip" Value="本机构有报价"/>
                                </DataTrigger>
                                <!--市场最优和我的订单相同时-->
                                <DataTrigger Binding="{Binding IsOfrSame}" Value="1">
                                    <Setter TargetName="OfrArrow" Property="Stroke" Value = "#009AFF"/>
                                    <Setter TargetName="OfrArrow" Property="Fill" Value = "#4C009AFF"/>
                                    <Setter TargetName="ofr_area" Property="Background" Value="#4C0098FF"/>
                                    <Setter TargetName="OfrArrow" Property="ToolTip" Value="本人有报价，且为市场最优"/>
                                </DataTrigger>
                                <!--没有价格-->
                                <DataTrigger Binding="{Binding BestOfrPrice}" Value="-1">
                                    <Setter TargetName="ofrpx_right_tb" Property="Text" Value="--"/>
                                    <Setter TargetName="ofrpx_left_tb" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <!--闪电显示-->
                                <DataTrigger Binding="{Binding IsAllFirm_Ofr}" Value="1">
                                    <Setter TargetName="ofr_shandian" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <!--+0和远 显示多-->
                                        <Condition Binding="{Binding BestOfrSettlTypeTag}" Value="1"/>
                                        <Condition Binding="{Binding BestOfrYuanSettlTypeTag}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter TargetName="duo" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Ofr_T0" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Ofr_yuan" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>

                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

