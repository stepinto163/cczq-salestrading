                <DataGridTemplateColumn x:Name="bestBidPx_column" Header="最优Bid (%)    " Width="170" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" SortMemberPath="BestBidPrice">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <!--<RowDefinition Height="3"/>-->
                                </Grid.RowDefinitions>

                                <Grid x:Name="bid_area">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Polygon x:Name="BidArrow" Grid.Column="0" Stroke="#FFFFFF" Fill="#FB943C" Points="0,0 0,10 10,0" HorizontalAlignment="Left" Visibility="Collapsed"/>

                                    <Border x:Name="Bid_yuan" Grid.Column="1" CornerRadius="2" Width="18" Height="18" Background="#3C3C3C" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                                        <TextBlock Text="远"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border x:Name="Bid_T0"  Grid.Column="1" CornerRadius="2" Width="18" Height="18" Background="#6E2022" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="2,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="+0"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    </Border>
                                    <Border x:Name="duo" Grid.Column="1" CornerRadius="2" Width="18" Height="18" Visibility="Collapsed" Background="#6E2022" BorderThickness="0" Margin="4,0,0,0">
                                        <TextBlock Text="多" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8" />
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding BestBidQty, Converter={StaticResource numConvertor},ConverterParameter=1}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,5,0">
                                        <Image x:Name="bid_shandian" Height="14" Width="14" Source="/STC.XBond.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Visibility="Collapsed"/>
                                        <TextBlock x:Name="bidpx_left_tb" Padding="0,0,0,0" Text="{Binding BestBidPx_Left}" VerticalAlignment="Center" Foreground="#FB943C" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock x:Name="bidpx_right_tb" Padding="0" Text="{Binding BestBidPx_Right}" VerticalAlignment="Center" Foreground="#FB943C" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <!--<ProgressBar Grid.Row="1" Grid.Column="1" FlowDirection="RightToLeft" Background="#1E1E1E" Foreground="#FB943C" Value="{Binding BestBidQty}" Maximum="30000" BorderThickness="0"/>-->
                            </Grid>
                            <DataTemplate.Triggers>

                                <!--最优bid报价，清算速度显示-->
                                <DataTrigger Binding="{Binding BestBidSettlTypeTag}" Value="1">
                                    <Setter TargetName="Bid_T0" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BestBidYuanSettlTypeTag}" Value="1">
                                    <Setter TargetName="Bid_yuan" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- 小三角标记 -->
                                <!-- 本机构有报价，且本人有报价 -->
                                <DataTrigger Binding="{Binding BestBidFlagType}" Value="1">
                                    <Setter TargetName="BidArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="BidArrow" Property="Stroke" Value = "#FF7D00"/>
                                    <Setter TargetName="BidArrow" Property="Fill" Value = "#FF7D00"/>
                                    <Setter TargetName="BidArrow" Property="ToolTip" Value="本人有报价"/>
                                </DataTrigger>
                                <!-- 本人有报价 -->
                                <DataTrigger Binding="{Binding BestBidFlagType}" Value="2">
                                    <Setter TargetName="BidArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="BidArrow" Property="Stroke" Value = "#FF7D00"/>
                                    <!--<Setter TargetName="BidArrow" Property="Stroke" Value="transparent"/>-->
                                    <Setter TargetName="BidArrow" Property="ToolTip" Value="本人有报价"/>
                                </DataTrigger>
                                <!-- 本机构有报价 -->
                                <DataTrigger Binding="{Binding BestBidFlagType}" Value="3">
                                    <Setter TargetName="BidArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="BidArrow" Property="Stroke" Value="{DynamicResource TextBox.Focus.Border}"/>
                                    <Setter TargetName="BidArrow" Property="Fill" Value="{DynamicResource TextBox.Focus.Border}"/>
                                    <Setter TargetName="BidArrow" Property="ToolTip" Value="本机构有报价"/>
                                </DataTrigger>
                                <!--市场最优和我的订单相同时-->
                                <DataTrigger Binding="{Binding IsBidSame}" Value="1">
                                    <Setter TargetName="bid_area" Property="Background" Value="#4CED6D00"/>
                                    <Setter TargetName="BidArrow" Property="Stroke" Value = "#FF7D00"/>
                                    <Setter TargetName="BidArrow" Property="Fill" Value = "#4CFF7D00"/>
                                    <Setter TargetName="BidArrow" Property="ToolTip" Value="本人有报价，且为市场最优"/>
                                </DataTrigger>
                                <!--没有价格-->
                                <DataTrigger Binding="{Binding BestBidPrice}" Value="-1">
                                    <Setter TargetName="bidpx_right_tb" Property="Text" Value="--"/>
                                    <Setter TargetName="bidpx_left_tb" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <!--闪电显示-->
                                <DataTrigger Binding="{Binding IsAllFirm_Bid}" Value="1">
                                    <Setter TargetName="bid_shandian" Property="Visibility" Value="Visible"/>
                                </DataTrigger>


                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <!--+0和远 显示多-->
                                        <Condition Binding="{Binding BestBidSettlTypeTag}" Value="1"/>
                                        <Condition Binding="{Binding BestBidYuanSettlTypeTag}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter TargetName="duo" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Bid_T0" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Bid_yuan" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>

                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="    最优Ofr (%)" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
