                <DataGridTextColumn Header="类型" Width="52" Binding="{Binding BondType}"/>

                <DataGridTemplateColumn Header="MyBid" Width="{Binding NoRightWidth, Mode=OneWay}" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding MyBidQty}" FontFamily="Roboto" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" 
                                           HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding MyBidQty}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MyBid}" FontFamily="Roboto" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" 
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding MyBid}"/>


                            </Grid>
