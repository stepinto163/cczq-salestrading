                                        <Image x:Name="ofr_shandian" Height="14" Width="14" Source="/STC.XBond.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding BestOfrQty, Converter={StaticResource numConvertor},ConverterParameter=1}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>

                                    <Border x:Name="Ofr_T0"  Grid.Column="2" CornerRadius="2" Width="18" Height="18" Background="#6E2022" VerticalAlignment="Center" HorizontalAlignment="Right"  Margin="0,0,2,0" Visibility="Collapsed">
                                        <TextBlock Text="+0"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    </Border>
                                    <Border x:Name="Ofr_yuan" Grid.Column="2" CornerRadius="2" Width="18" Height="18" Background="#3C3C3C" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                                        <TextBlock Text="远"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border x:Name="duo" Grid.Column="2" CornerRadius="2" Width="18" Height="18" Visibility="Collapsed" Background="#6E2022" BorderThickness="0" Margin="4,0,0,0">
                                        <TextBlock Text="多" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8" />
                                    </Border>


                                    <Polygon x:Name="OfrArrow"  Grid.Column="3" Grid.RowSpan="2" Stroke="#FFFFFF" Fill="#58B3FF" Points="0,0 10,0 10,10" HorizontalAlignment="Right" Visibility="Collapsed"/>

                                </Grid>
                                <!--<ProgressBar Grid.Row="1" Background="#1E1E1E" Foreground="#58B3FF" Value="{Binding BestOfrQty}" Maximum="30000"   BorderThickness="0"/>-->

                            </Grid>
                            <DataTemplate.Triggers>

                                <!--最优ofr报价，清算速度显示-->
                                <DataTrigger Binding="{Binding BestOfrSettlTypeTag}" Value="1">
                                    <Setter TargetName="Ofr_T0" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BestOfrYuanSettlTypeTag}" Value="1">
                                    <Setter TargetName="Ofr_yuan" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- 小三角标记 -->
                                <!-- 本机构有报价，且本人有报价 -->
                                <DataTrigger Binding="{Binding BestOfrFlagType}" Value="1">
                                    <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OfrArrow" Property="Stroke" Value = "#009AFF"/>
                                    <Setter TargetName="OfrArrow" Property="Fill" Value = "#009AFF"/>
                                    <Setter TargetName="OfrArrow" Property="ToolTip" Value="本人有报价"/>
                                </DataTrigger>
                                <!-- 本人有报价 -->
                                <DataTrigger Binding="{Binding BestOfrFlagType}" Value="2">
                                    <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OfrArrow" Property="Stroke" Value = "#009AFF"/>
                                    <!--<Setter TargetName="OfrArrow" Property="Stroke" Value="transparent"/>-->
                                    <Setter TargetName="OfrArrow" Property="ToolTip" Value="本人有报价"/>
                                </DataTrigger>
                                <!-- 本机构有报价 -->
                                <DataTrigger Binding="{Binding BestOfrFlagType}" Value="3">
                                    <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OfrArrow" Property="Stroke" Value="{DynamicResource TextBox.Focus.Border}"/>
                                    <Setter TargetName="OfrArrow" Property="Fill" Value="{DynamicResource TextBox.Focus.Border}"/>
                                    <Setter TargetName="OfrArrow" Property="ToolTip" Value="本机构有报价"/>
                                </DataTrigger>
                                <!--市场最优和我的订单相同时-->
                                <DataTrigger Binding="{Binding IsOfrSame}" Value="1">
                                    <Setter TargetName="OfrArrow" Property="Stroke" Value = "#009AFF"/>
                                    <Setter TargetName="OfrArrow" Property="Fill" Value = "#4C009AFF"/>
                                    <Setter TargetName="ofr_area" Property="Background" Value="#4C0098FF"/>
                                    <Setter TargetName="OfrArrow" Property="ToolTip" Value="本人有报价，且为市场最优"/>
                                </DataTrigger>
                                <!--没有价格-->
                                <DataTrigger Binding="{Binding BestOfrPrice}" Value="-1">
                                    <Setter TargetName="ofrpx_right_tb" Property="Text" Value="--"/>
                                    <Setter TargetName="ofrpx_left_tb" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <!--闪电显示-->
                                <DataTrigger Binding="{Binding IsAllFirm_Ofr}" Value="1">
                                    <Setter TargetName="ofr_shandian" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <!--+0和远 显示多-->
                                        <Condition Binding="{Binding BestOfrSettlTypeTag}" Value="1"/>
                                        <Condition Binding="{Binding BestOfrYuanSettlTypeTag}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter TargetName="duo" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Ofr_T0" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Ofr_yuan" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>

                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="MyOfr" Width="{Binding NoRightWidth, Mode=OneWay}" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding MyOfr}" FontFamily="Roboto" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" 
                                           HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding MyOfr}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MyOfrQty}" FontFamily="Roboto" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" 
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding MyOfrQty}"/>


                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Header="最新成交价" Width="200" SortMemberPath="LastMarketPx">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="10"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Display_LastMarketPx}"/>

                                <!--渠道-->
                                <Border Grid.Column="1" Width="40" Height="16" x:Name="bdVenue" BorderBrush="{Binding LastMarketPx_Venues,Converter={StaticResource venuesColorConvertor}}" 
                                        Background="{Binding LastMarketPx_Venues,Converter={StaticResource venuesColorConvertor}}" CornerRadius="2"
                                        Visibility="Visible" Margin="2">
                                    <TextBlock  Text="{Binding LastMarketPx_Venues, ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#FFFFFF" Style="{DynamicResource SourceTraderStyle}"/>
                                </Border>


                                <!--<TextBlock Grid.Column="1" x:Name="DealerName" Text="{Binding LastMarketPx_Venues, ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" Foreground="{Binding LastMarketPx_Venues, Converter={StaticResource venuesColorConvertor}}" />-->


                                <Border x:Name="last_T0" Grid.Column="2" CornerRadius="2" Width="18" Height="18" Background="#6E2022" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <TextBlock Text="+0"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                </Border>
                                <Border x:Name="last_yuan" Grid.Column="2" CornerRadius="2" Width="18" Height="18" Background="#3C3C3C" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <TextBlock Text="远"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <!--最优最新成交报价，清算速度显示-->
                                <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="T+0">
                                    <Setter TargetName="last_T0" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="明天+1">
                                    <Setter TargetName="last_yuan" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="远期">
                                    <Setter TargetName="last_yuan" Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding LastMarketPx_Venues, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="bdVenue" Property="Visibility" Value="Collapsed"></Setter>
                                </DataTrigger>

                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="中债估值" Width="140" Binding="{Binding Valuation, Converter={StaticResource numConvertor}}"/>

            </DataGrid.Columns>
        </commonComp:ExDataGrid>

        <fUI:LoadingMask x:Name="loadMask" Visibility="{Binding MaskVisibility}" Grid.RowSpan="3"/>
    </Grid>
</UserControl>
