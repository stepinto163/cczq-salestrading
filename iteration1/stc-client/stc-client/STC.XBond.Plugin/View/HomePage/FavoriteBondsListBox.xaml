            </Style>

            <GridView x:Key="List_View" ColumnHeaderContainerStyle="{DynamicResource Left_GridViewColumnHeader}" AllowsColumnReorder="False">

                <!--<GridViewColumn x:Name="gcDelete" Width="25" HeaderContainerStyle="{StaticResource Center_GridViewColumnHeader}">-->
                <GridViewColumn x:Name="gcDelete1" Width="45" HeaderContainerStyle="{DynamicResource Button_GridViewColumnHeader}">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center">
                                <Button Content="一" Foreground="#A0A0A0" Width="24" Margin="0, 0, 6, 0" Height="24" ToolTip="删除" HorizontalAlignment="Center" Style="{DynamicResource GreenDeleteButtonStyle}" Click="del_btn_Click"/>
                            </Grid>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn Width="80">
                    <GridViewColumn.Header>
                        <GridViewColumnHeader Content="债券代码" Tag="0">
                        </GridViewColumnHeader>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Grid.Column="0" TextAlignment="Left" HorizontalAlignment="Left" Text="{Binding securityID}" FontFamily="Roboto" Foreground="#FFFFFF" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>

                <GridViewColumn Width="80">
                    <GridViewColumn.Header>
                        <GridViewColumnHeader Content="债券简称" Tag="0">
                        </GridViewColumnHeader>
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Grid.Column="1" TextAlignment="Left" HorizontalAlignment="Left" Text="{Binding symbol}" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" 
                                           FontFamily="Microsoft YaHei" TextTrimming="CharacterEllipsis" ToolTip="{Binding symbol}"/>
                                    
                                <Grid Background="Transparent" HorizontalAlignment="Left" Height="6" x:Name="grd_2" Visibility="Collapsed">
                                    <Grid.Resources>
                                        <Style x:Key="rec" TargetType="Rectangle">
                                            <Setter Property="Width" Value="2"/>
                                            <Setter Property="Height" Value="2"/>
                                            <Setter Property="Fill" Value="{DynamicResource TextBox.Focus.Border}"/>
                                        </Style>
                                        <PowerEase x:Key="powerEase" Power="3" EasingMode="EaseInOut"/>
                                    </Grid.Resources>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" Storyboard.TargetProperty="Height">
                                                    <DoubleAnimation Storyboard.TargetName="rec1" To="10" BeginTime="0:0:0.0" Duration="0:0:0.5" EasingFunction="{StaticResource powerEase}" AutoReverse="True"/>
                                                    <DoubleAnimation Storyboard.TargetName="rec2" To="10" BeginTime="0:0:0.2" Duration="0:0:0.5" EasingFunction="{StaticResource powerEase}" AutoReverse="True"/>
                                                    <DoubleAnimation Storyboard.TargetName="rec3" To="10" BeginTime="0:0:0.4" Duration="0:0:0.5" EasingFunction="{StaticResource powerEase}" AutoReverse="True"/>
                                                    <DoubleAnimation Storyboard.TargetName="rec4" To="10" BeginTime="0:0:0.6" Duration="0:0:0.5" EasingFunction="{StaticResource powerEase}" AutoReverse="True"/>
                                                    <DoubleAnimation Storyboard.TargetName="rec5" To="10" BeginTime="0:0:0.8" Duration="0:0:0.5" EasingFunction="{StaticResource powerEase}" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="10"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Name="rec1" Grid.Column="0" Style="{StaticResource rec}"/>
                                    <Rectangle Name="rec2" Grid.Column="1" Style="{StaticResource rec}"/>
                                    <Rectangle Name="rec3" Grid.Column="2" Style="{StaticResource rec}"/>
                                    <Rectangle Name="rec4" Grid.Column="3" Style="{StaticResource rec}"/>
                                    <Rectangle Name="rec5" Grid.Column="4" Style="{StaticResource rec}"/>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding symbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Value="">
                                    <Setter TargetName="grd_2" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                       </DataTemplate>

                    </GridViewColumn.CellTemplate>

                </GridViewColumn>

                <!--<GridViewColumn Header="剩余期限" Width="90" DisplayMemberBinding="{Binding RemainingTime}"/>-->

