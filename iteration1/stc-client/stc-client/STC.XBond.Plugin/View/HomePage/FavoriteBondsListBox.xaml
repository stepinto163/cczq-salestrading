<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.HomePage"
             xmlns:view="clr-namespace:STC.XBond.Plugin.View"
             xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:homepage="clr-namespace:STC.XBond.Plugin.ViewModel.HomePage"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             x:Class="STC.XBond.Plugin.View.HomePage.FavoriteBondsListBox"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
             mc:Ignorable="d" 
             FontSize="12"
             d:DesignHeight="562" d:DesignWidth="1430" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <fcon:MultiBindingConverter x:Key="MultiBindingConverter"/>
            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <fcon:VenuesColorConvertor x:Key="venuesColorConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            
            <ContextMenu x:Key="settingColumnContextMenu" Style="{StaticResource DefaultContextMenu}">
                <MenuItem x:Name="settingColumn" Header="表头设置" Style="{StaticResource DefaultMenuItem}" Click="settingColumn_Click"/>
            </ContextMenu>

            <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="TextElement.FontWeight" TargetName="contentPresenter" Value="ExtraBold"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="TextElement.FontWeight" TargetName="contentPresenter" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="Gray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="{x:Static GridView.GridViewScrollViewerStyleKey}" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultGridViewScrollViewerStyle}"/>
            <Style x:Key="FocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Card 样式 -->
            <DataTemplate x:Key="Card_DataTemplate">
                <Grid>
                    <Grid.RowDefinitions>
                        <!--top-->
                        <RowDefinition Height="31"/>
                        <!--bottom-->
                        <RowDefinition Height="35"/>
                        <!--center-->
                        <RowDefinition Height="27"/>
                        <!--spinbar-->
                        <RowDefinition Height="3"/>
                        <!--blank-->
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--第一行-->
                    <TextBlock Grid.ColumnSpan="3" Text="{Binding symbol}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#A0A0A0" FontSize="10" FontWeight="Bold"/>
                    <Label Grid.ColumnSpan="3" Content="{Binding securityID}" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                    <Button x:Name="del_btn" Grid.ColumnSpan="3" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource DeleteButton}" Click="del_btn_Click"
                            Visibility="{Binding IsSelected, Converter={StaticResource visibilityConvertor}, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                    <!--第二行-->
                    <Grid  x:Name="bid_area" Grid.Row="1" >
                        <Polygon x:Name="BidArrow" Stroke="#FFFFFF" Fill="#FB943C" Points="0,0 0,10 10,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,5,0">
                            <Border x:Name="Bid_yuan" CornerRadius="2" Width="18" Height="18" Background="#3C3C3C" VerticalAlignment="Center"  Margin="0,0,12,0" Visibility="Collapsed">
                                <TextBlock Text="远"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="Bid_T0" CornerRadius="2" Width="18" Height="18" Background="#6E2022" VerticalAlignment="Center"  Margin="0,0,12,0" Visibility="Collapsed">
                                <TextBlock Text="+0"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                            </Border>
                            <Image x:Name="bid_shandian" Height="14" Width="14" Source="/STC.XBond.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Visibility="Collapsed"/>
                            <TextBlock x:Name="bidpx_left_tb" Padding="0,2,0,0" Text="{Binding BestBidPx_Left}" VerticalAlignment="Center" Foreground="#FB943C" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="bidpx_right_tb" Padding="0" Text="{Binding BestBidPx_Right}" VerticalAlignment="Center" Foreground="#FB943C" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="ofr_area" Grid.Row="1" Grid.Column="2">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal"  Margin="5,0,0,0">
                            <TextBlock x:Name="ofrpx_left_tb" Padding="0,0,0,2" Text="{Binding BestOfrPx_Left}" VerticalAlignment="Bottom" Foreground="#58B3FF" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="ofrpx_right_tb" Padding="0" Text="{Binding BestOfrPx_Right}" VerticalAlignment="Bottom" Foreground="#58B3FF" FontSize="24" FontWeight="Bold"/>
                            <Image x:Name="ofr_shandian" Height="14" Width="14" Source="/STC.XBond.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Visibility="Collapsed"/>
                            <Border x:Name="Ofr_yuan" CornerRadius="2" Width="18" Height="18" Background="#3C3C3C" VerticalAlignment="Center"  Margin="12,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="远"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="Ofr_T0" CornerRadius="2" Width="18" Height="18" Background="#6E2022" VerticalAlignment="Center"  Margin="12,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="+0"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                        <Polygon x:Name="OfrArrow" Stroke="#FFFFFF" Fill="#58B3FF" Points="0,0 10,0 10,10" HorizontalAlignment="Right" Visibility="Collapsed"/>
                    </Grid>

                    <!--第三行-->
                    <TextBlock Text="{Binding BestBidQty, Converter={StaticResource numConvertor}}" Grid.Row="2" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding BestOfrQty, Converter={StaticResource numConvertor}}" Grid.Row="2" Grid.Column="2" Foreground="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                    <!--第四行-->
                    <ProgressBar Grid.Row="3" AllowDrop="False" FlowDirection="RightToLeft" Background="#141414" Foreground="#FB943C" Value="{Binding BestBidQty}" Maximum="30000"  BorderThickness="0"/>
                    <ProgressBar Grid.Row="3" Grid.Column="2" AllowDrop="False" Background="#141414" Foreground="#58B3FF" Value="{Binding BestOfrQty}" Maximum="30000"  BorderThickness="0"/>
                    <!--第六行-->
                    <Border  Grid.Row="5"  Grid.ColumnSpan="3" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="{Binding RemainingTime}" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="10" d:LayoutOverrides="TopMargin, BottomMargin"/>
                            <TextBlock Text="{Binding BondType}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FFFFFF" FontSize="10"/>
                        </Grid>
                    </Border>
                    <!--第七行-->
                    <Border  Grid.Row="6"  Grid.ColumnSpan="3" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="最新市场成交" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="10" d:LayoutOverrides="TopMargin, BottomMargin"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border x:Name="last_yuan" CornerRadius="2" Width="18" Height="18" Background="#3C3C3C" VerticalAlignment="Center"  Margin="0,0,20,0" Visibility="Collapsed">
                                    <TextBlock Text="远"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="last_T0" CornerRadius="2" Width="18" Height="18" Background="#6E2022" VerticalAlignment="Center"  Margin="0,0,20,0" Visibility="Collapsed">
                                    <TextBlock Text="+0"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                </Border>
                                <TextBlock Text="{Binding LastMarketPx_Venues, ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" Foreground="{Binding LastMarketPx_Venues, Converter={StaticResource venuesColorConvertor}}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                                <TextBlock Text="{Binding Display_LastMarketPx}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>

                        </Grid>
                    </Border>
                    <!--第八行-->
                    <Border  Grid.Row="7"  Grid.ColumnSpan="3" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="中债估值" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="10" d:LayoutOverrides="TopMargin, BottomMargin"/>
                            <TextBlock Text="{Binding Valuation, Converter={StaticResource numConvertor}}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <!--市场最优和我的订单相同时-->
                    <DataTrigger Binding="{Binding IsBidSame}" Value="1">
                        <Setter TargetName="bid_area" Property="Background" Value="#4CED6D00"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOfrSame}" Value="1">
                        <Setter TargetName="ofr_area" Property="Background" Value="#4C0098FF"/>
                    </DataTrigger>
                    <!--最优bid报价，清算速度显示-->
                    <DataTrigger Binding="{Binding BestBidSettlTypeTag}" Value="1">
                        <Setter TargetName="Bid_T0" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BestBidYuanSettlTypeTag}" Value="1">
                        <Setter TargetName="Bid_yuan" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <!--最优ofr报价，清算速度显示-->
                    <DataTrigger Binding="{Binding BestOfrSettlTypeTag}" Value="1">
                        <Setter TargetName="Ofr_T0" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BestOfrYuanSettlTypeTag}" Value="1">
                        <Setter TargetName="Ofr_yuan" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <!--最优最新成交报价，清算速度显示-->
                    <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="T+0">
                        <Setter TargetName="last_T0" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="明天+1">
                        <Setter TargetName="last_yuan" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="远期">
                        <Setter TargetName="last_yuan" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <!-- 小三角标记 -->
                    <!-- 本机构有报价，且本人有报价 -->
                    <DataTrigger Binding="{Binding BestBidFlagType}" Value="1">
                        <Setter TargetName="BidArrow" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="BidArrow" Property="ToolTip" Value="本机构有报价，且本人有报价"/>
                    </DataTrigger>
                    <!-- 本人有报价 -->
                    <DataTrigger Binding="{Binding BestBidFlagType}" Value="2">
                        <Setter TargetName="BidArrow" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="BidArrow" Property="Stroke" Value="transparent"/>
                        <Setter TargetName="BidArrow" Property="ToolTip" Value="本人有报价"/>
                    </DataTrigger>
                    <!-- 本机构有报价 -->
                    <DataTrigger Binding="{Binding BestBidFlagType}" Value="3">
                        <Setter TargetName="BidArrow" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="BidArrow" Property="Stroke" Value="{DynamicResource TextBox.Focus.Border}"/>
                        <Setter TargetName="BidArrow" Property="Fill" Value="{DynamicResource TextBox.Focus.Border}"/>
                        <Setter TargetName="BidArrow" Property="ToolTip" Value="本机构有报价"/>
                    </DataTrigger>

                    <!-- 本机构有报价，且本人有报价 -->
                    <DataTrigger Binding="{Binding BestOfrFlagType}" Value="1">
                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="OfrArrow" Property="ToolTip" Value="本机构有报价，且本人有报价"/>
                    </DataTrigger>
                    <!-- 本人有报价 -->
                    <DataTrigger Binding="{Binding BestOfrFlagType}" Value="2">
                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="OfrArrow" Property="Stroke" Value="transparent"/>
                        <Setter TargetName="OfrArrow" Property="ToolTip" Value="本人有报价"/>
                    </DataTrigger>
                    <!-- 本机构有报价 -->
                    <DataTrigger Binding="{Binding BestOfrFlagType}" Value="3">
                        <Setter TargetName="OfrArrow" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="OfrArrow" Property="Stroke" Value="{DynamicResource TextBox.Focus.Border}"/>
                        <Setter TargetName="OfrArrow" Property="Fill" Value="{DynamicResource TextBox.Focus.Border}"/>
                        <Setter TargetName="OfrArrow" Property="ToolTip" Value="本机构有报价"/>
                    </DataTrigger>

                    <!--没有价格-->
                    <DataTrigger Binding="{Binding BestBidPrice}" Value="-1">
                        <Setter TargetName="bidpx_right_tb" Property="Text" Value="--"/>
                        <Setter TargetName="bidpx_left_tb" Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BestOfrPrice}" Value="-1">
                        <Setter TargetName="ofrpx_right_tb" Property="Text" Value="--"/>
                        <Setter TargetName="ofrpx_left_tb" Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                    <!--闪电显示-->
                    <DataTrigger Binding="{Binding IsAllFirm_Bid}" Value="1">
                        <Setter TargetName="bid_shandian" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAllFirm_Ofr}" Value="1">
                        <Setter TargetName="ofr_shandian" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            
            <Style x:Key="Card_ListViewItemStyle" TargetType="{x:Type ListViewItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Margin" Value="3"/>

                <Setter Property="Width" Value="{Binding ActualWidth, ConverterParameter=5, Converter={StaticResource WidthConvertor}, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}, Mode=FindAncestor}}"/>
                <Setter Property="Height" Value="210"/>
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu  Style="{StaticResource DefaultContextMenu}" Foreground="White">
                            <MenuItem Header="复制 &lt;bid&gt;" Command="{x:Static homepage:FavoriteBondsListBoxViewModel.CopyBidCommand}" CommandParameter="{Binding}"/>
                            <MenuItem Header="复制 &lt;ofr&gt;" Command="{x:Static homepage:FavoriteBondsListBoxViewModel.CopyOfrCommand}" CommandParameter="{Binding}"/>
                            <MenuItem Header="复制 &lt;双边&gt;" Command="{x:Static homepage:FavoriteBondsListBoxViewModel.CopyDoubleCommand}" CommandParameter="{Binding}"/>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource Item.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Item.MouseOver.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource Item.SelectedInactive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Item.SelectedInactive.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource Item.SelectedActive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Item.SelectedActive.Border}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>
            <local:PlainView x:Key="cardView"
                   ItemTemplate="{StaticResource Card_DataTemplate}" 
                   ItemContainerStyle="{StaticResource Card_ListViewItemStyle}"/>

            <!--列表形式-->
            <Style x:Key="GridViewColumnHeaderGripper" TargetType="{x:Type Thumb}">
                <Setter Property="Width" Value="18" />
                <Setter Property="Background" Value="#0F0F0F"/>
                <Setter Property="Cursor" Value="SizeWE"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border Padding="{TemplateBinding Padding}" Background="Transparent" >
                                <Rectangle HorizontalAlignment="Center"
                                     Width="1"
                                     Fill="{TemplateBinding Background}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Center_GridViewColumnHeader" TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{DynamicResource DataGridColumnHeaderBackground}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                            <Grid Background="{TemplateBinding Background}">
                                <!--<VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).
                    (GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                Storyboard.TargetName="HeaderBorder">
                                                    <EasingColorKeyFrame KeyTime="0"
                                         Value="{StaticResource ControlMouseOverColor}" />
                                                </ColorAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>-->
                                <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      Margin="5,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="HeaderContent"
                                                        Margin="0,0,0,1"
                                                        RecognizesAccessKey="True"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <Path x:Name="SortArrow"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"                                           
                                                Width="8" Height="6" Margin="2,0,0,0"
                                                Stretch="Fill" Opacity="0.5" Fill="{TemplateBinding Foreground}"
                                                RenderTransformOrigin="0.5,0.4"
                                                Visibility="Collapsed"
                                                Data="M0,0 L1,0 0.5,1 z"/>

                                </Grid>
                                <Thumb x:Name="PART_HeaderGripper"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,-9,0"
                                         Style="{StaticResource GridViewColumnHeaderGripper}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="homepage:SortDirectionManager.SortDirection" Value="Ascending">
                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SortArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="homepage:SortDirectionManager.SortDirection" Value="Descending">
                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="Button_GridViewColumnHeader" TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{DynamicResource DataGridColumnHeaderBackground}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        
                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                            <Grid Background="{TemplateBinding Background}">
                                
                                <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      Margin="5,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnAddBond" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Content="➕" Width="24" Height="24" 
                                    Style="{StaticResource AddButtonStyle}" Click="BtnAddBond_Click" ToolTip="添加"></Button>

                                    <!--<ContentPresenter x:Name="HeaderContent"
                                                        Margin="0,0,0,1"
                                                        RecognizesAccessKey="True"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>-->
                                    <Path x:Name="SortArrow"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"                                           
                                                Width="8" Height="6" Margin="2,0,0,0"
                                                Stretch="Fill" Opacity="0.5" Fill="{TemplateBinding Foreground}"
