                                </Grid.RowDefinitions>

                                <Grid x:Name="ofr_area">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="10"/>
