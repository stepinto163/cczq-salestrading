                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding MyOfrQty}"/>


                            </Grid>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>


                <GridViewColumn Header="最新成交价" Width="200">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="10"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Display_LastMarketPx}"/>

                                <!--渠道-->
                                <Border Grid.Column="1" Width="40" Height="16" x:Name="bdVenue" BorderBrush="{Binding LastMarketPx_Venues,Converter={StaticResource venuesColorConvertor}}" 
                                        Background="{Binding LastMarketPx_Venues,Converter={StaticResource venuesColorConvertor}}" CornerRadius="2"
                                        Visibility="Visible" Margin="2">
                                    <TextBlock  Text="{Binding LastMarketPx_Venues, ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#FFFFFF" Style="{DynamicResource SourceTraderStyle}"/>
                                </Border>


                                <!--<TextBlock Grid.Column="1" x:Name="DealerName" Text="{Binding LastMarketPx_Venues, ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" Foreground="{Binding LastMarketPx_Venues, Converter={StaticResource venuesColorConvertor}}" />-->
                                
                                
                                <Border x:Name="last_T0" Grid.Column="2" CornerRadius="2" Width="18" Height="18" Background="#6E2022" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <TextBlock Text="+0"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                </Border>
                                <Border x:Name="last_yuan" Grid.Column="2" CornerRadius="2" Width="18" Height="18" Background="#3C3C3C" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <TextBlock Text="远"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <!--最优最新成交报价，清算速度显示-->
                                <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="T+0">
                                    <Setter TargetName="last_T0" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="明天+1">
                                    <Setter TargetName="last_yuan" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastSettlTypeTag}" Value="远期">
                                    <Setter TargetName="last_yuan" Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding LastMarketPx_Venues, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="bdVenue" Property="Visibility" Value="Collapsed"></Setter>
                                </DataTrigger>
                                
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="中债估值" Width="140" DisplayMemberBinding="{Binding Valuation, Converter={StaticResource numConvertor}}"/>
                <!--<GridViewColumn x:Name="operation_column" Header="操作" Width="60" HeaderContainerStyle="{StaticResource Center_GridViewColumnHeader}">
