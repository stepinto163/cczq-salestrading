<UserControl x:Class="STC.XBond.Plugin.View.SendPriceRiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             mc:Ignorable="d"  MinHeight="100" Width="420">
    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DefalutTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{Binding ShowBorderBG}" BorderThickness="0, 0, 0, 1">
        <Grid Margin="50 0 50 0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" Text="{Binding RiskName}" FontWeight="Bold"  Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Grid.ColumnSpan="2">
                <TextBlock Text="您的报价" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
                <TextBlock Visibility="{Binding RiskVisibility}" Text="，已触发" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
                <TextBlock Text="2倍" Width="35" TextAlignment="Center" Visibility="{Binding TwoVisibility}"
                           Foreground="{StaticResource ColorBrush.Red7}" FontSize="16" FontWeight="Bold"></TextBlock>
                <TextBlock Visibility="{Binding RiskVisibility}" Text="{Binding RiskType}" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>

                <TextBlock Visibility="{Binding ParamVisibility}" Text="，将无法发送到以下渠道：" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>

            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0, 5, 0, 0" VerticalAlignment="Top"  TextWrapping="Wrap" Text="{Binding RiskReason}"
                       Foreground="{StaticResource ColorBrush.Red7}" FontSize="12" FontWeight="Bold"></TextBlock>

            <Grid Grid.Row="3" Grid.Column="1" Height="40" Visibility="{Binding RiskPromptVisibility}">
                <TextBlock  
                       Text="请检查要素，并联系风控人员确认" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="4" Grid.Column="1" Height="40" Visibility="{Binding ConfirmWarnVisiblity}">
                <Button x:Name="CancelBtn"  Content="取消" 
                        Command="{Binding DataContext.CancelSingleWarnCommnad, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}, Mode=FindAncestor}}"
                        CommandParameter="{Binding ElementName=CancelBtn}"
                            Height="24" Width="60" FontSize="12" Foreground="#FFFFFF" Style="{StaticResource SmallCancelBtnStyle}"></Button>
                <Button x:Name="btnOk" Margin="5 0 0 0"
                        Command="{Binding DataContext.ConfirmSingleWarnCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}, Mode=FindAncestor}}"
                        CommandParameter="{Binding ElementName=btnOk}"
                        Content="已确认，发出" 
                            Height="24" Width="100" Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}"></Button>
            </StackPanel>
            <Grid Grid.Row="5" Grid.Column="1" Height="40" Visibility="{Binding StateVisibility}">
                <TextBlock HorizontalAlignment="Right"
                       Text="{Binding State}" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
