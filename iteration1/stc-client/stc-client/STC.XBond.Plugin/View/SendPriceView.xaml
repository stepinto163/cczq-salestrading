                                        <TextBlock Text="选择&lt;指定渠道&gt;，将在系统留痕，可能需要承担罚金"></TextBlock>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>-->

                            </StackPanel>

                        </Grid>

                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Background="{StaticResource ColorBrush.Gray13}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48*"></ColumnDefinition>
                        <ColumnDefinition Width="65"></ColumnDefinition>
                        <ColumnDefinition Width="52*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="70"></ColumnDefinition>
                            <ColumnDefinition Width="110"></ColumnDefinition>
                            <ColumnDefinition Width="15"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Right">
                            <TextBlock Grid.Row="0" Text="*请详细确认以上信息：" HorizontalAlignment="Right"
                           Foreground="{StaticResource ColorBrush.While}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>

                            <TextBlock Grid.Row="1" Text="{Binding SendPriceItem.CustomQty}" HorizontalAlignment="Right"
                           Foreground="{StaticResource ColorBrush.While}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" />

                            <TextBlock Grid.Row="2" Text="{Binding SendPriceItem.MarketQty}"  HorizontalAlignment="Right"
                           Foreground="{StaticResource ColorBrush.While}" FontSize="12" VerticalAlignment="Center" Margin="2,0,8,0"/>

                        </StackPanel>


                        <Button Grid.Column="1" Grid.Row="1" Content="取消" Command="{Binding CancelCommand}" FontSize="12" Background="#3C3C3C" Foreground="#FFFFFF" 
                        Style="{StaticResource SmallCancelBtnStyle}" Width="60" Height="24"/>
                        <Button Grid.Column="2" Grid.Row="1" Content="报价" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding OkCommand}" FontSize="12" Background="#136C5E" 
                        Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}" Width="100" Height="24"/>

                    </Grid>




                </Grid>
            </Border>

        </Grid>

        <!--行情窗口 Visibility="{Binding CardViewVisibility}"  BorderBrush="#0C4F44"-->
        <Grid  Background="Transparent" Grid.Column="1" Visibility="{Binding CardViewVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="488"></RowDefinition>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#0C4F44" Margin="0,0,0,0"  x:Name="Border_Right1" BorderThickness="1,2,2,0" Padding="1,1,1,0"  CornerRadius="4,4,0,0"  Background="#0A0F0E">
                <card:PriceAndOrderView x:Name="dgPrice"></card:PriceAndOrderView>
            </Border>
        </Grid>
    </Grid>
</Window>
