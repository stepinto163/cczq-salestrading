<UserControl x:Class="STC.XBond.Plugin.View.TradeBookView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.View"
        xmlns:com="clr-namespace:STC.Common.View.Card;assembly=STC.Common"
        xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        xmlns:convert="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
        xmlns:utils="clr-namespace:STC.XBond.Plugin.Utils"
        xmlns:command ="clr-namespace:STC.XBond.Plugin.Command"
        mc:Ignorable="d" d:DesignHeight="256" d:DesignWidth="1300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <convert:BooleanConvertor x:Key="booleanConvertor"></convert:BooleanConvertor>
            <convert:ReverseBooleanConvertor x:Key="reverseBooleanConvertor"></convert:ReverseBooleanConvertor>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="FilterPanelStyle" TargetType="UserControl">
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <UserControl x:Key="Float_CCDCValuaDate" FontWeight="Normal">
                <UserControl.Template>
                    <ControlTemplate TargetType="{x:Type UserControl}">
                        <Border Name="Border" BorderThickness="1" CornerRadius="2" Background="{DynamicResource Tooltip.Background}" BorderBrush="{DynamicResource Tooltip.BorderBrush}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Grid Margin="6">
                                <TextBlock Text="{Binding CCDCValuaDate}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </UserControl.Template>
            </UserControl>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="33"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="885" Width="70*"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="343"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3">
            <Image Source="{Binding IsFavorite, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='favoriteicon', Mode=TwoWay}" Width="18" Height="18" Margin="10,0,0,0" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
            <Grid Width="210" Margin="10,0,0,0">
                <comp:SearchTextBox x:Name="seBond"  Height="18"  Visibility="Hidden" AfterSearch="seBond_AfterSearch" IsMagnifierMode="False"
                                    FocusBorderBrush="{DynamicResource TextBox.Focus.Border}" MouseOverBorderBrush="{DynamicResource TextBox.MouseOver.Border}"/>
                <Border CornerRadius="3">
                    <Label x:Name="lbCode" Background="Transparent" Margin="0, 2, 0, 0" 
                           MouseLeftButtonDown="lbCode_MouseLeftButtonDown" MouseEnter="lbCode_MouseEnter" MouseLeave="lbCode_MouseLeave">
                        <StackPanel x:Name="spCode" Orientation="Horizontal" Margin="0">
                            <TextBlock x:Name="tbBondId" Text="{Binding SecurityID}" Foreground="{DynamicResource DefaultForegroup.ColorBrush}" Width="83" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,4,0">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}">
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="tbBondName" Text="{Binding Symbol}" Margin="10,0,0,0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}" Width="70" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="{Binding ShowCCDC}">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}">
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Label>
                </Border>
            </Grid>
            <Button x:Name="Edit_Btn" Width="12" Height="12" Margin="10,0,0,0" Style="{DynamicResource EditButton}" Click="Edit_Btn_Click"/>
            <TextBlock x:Name="BondOtherInfo" Foreground="#FAC246" FontFamily="Microsoft YaHei" FontSize="14px" Margin="14,6,0,0" Visibility="{Binding ShowCCDC}">
                <Run Text="{Binding RemainingTime}"></Run>
                <Run Text="  "></Run>
                <Run Text="{Binding CN_Short_Name}"></Run>
                <Run Text="  "></Run>
                <Run Text="{Binding Coupon_Rate_Current}"></Run>
                <Run Text="  "></Run>
                <Run Text="{Binding CCDCValuationShow}"></Run>
            </TextBlock>
            <!--<Image x:Name="DataInfo" Source="/STC.Common;component/Images/icon 更多信息.png" Margin="10 -2 0 0" Width="12" Height="12" Visibility="{Binding ShowLastWorkDayVisible}" ToolTip="{Binding CCDCValuaDate}">-->
            <Grid x:Name="InfoPart" MouseEnter="InfoPart_MouseEnter" MouseLeave="InfoPart_MouseLeave" Margin="10 -2 0 0" Width="20" Height="20" Visibility="{Binding ShowLastWorkDayVisible}">
                <Image x:Name="DataInfo" Source="/STC.Common;component/Images/icon 更多信息.png" Width="12" Height="12">
                </Image>
            </Grid>
            
            <StackPanel Orientation="Horizontal" Margin="10 0 0 0" Visibility="{Binding ShowExeRadioVisible}">
                <RadioButton x:Name="exeRd" Content="行权" Height="20" Width="32" FontWeight="Bold" 
                             IsChecked="{Binding CheckExeRadio}"
                             Checked="RadioButton_Checked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                            <Setter Property="Background" Value="#0B0C0C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                                <Border x:Name="border" CornerRadius="12 0 0 12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                                    <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="Center" Margin="2 0 0 0" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Background" Value="{DynamicResource ColorBrush.Orange5}"/>
                                    </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" Value="{DynamicResource ColorBrush.Orange5}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="marRd" Content="到期" Height="20" Width="32" FontWeight="Bold" 
                                 IsChecked="{Binding CheckMarRadio}"
                                 Checked="RadioButton_Checked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton">
                            <Setter Property="Background" Value="#0B0C0C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type RadioButton}">
                                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                                <Border x:Name="border" CornerRadius="0 12 12 0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                                    <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="Center" Margin="0 0 2 0" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Background" Value="{DynamicResource ColorBrush.Orange5}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" Value="{DynamicResource ColorBrush.Orange5}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
            </StackPanel>
        </StackPanel>
        <Button x:Name="PopupBtn"  Grid.ColumnSpan="3" Style="{DynamicResource PopupButton}" HorizontalAlignment="Right" Width="12" Height="12" Margin="0,0,20,0"
                Command="{x:Static utils:WindowKeyHelper.popupWindowCommand}">
            <Button.CommandParameter>
                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                    <MultiBinding.Bindings>
                        <Binding Source="{x:Static command:PopupTypeEnum.TradeBook}" Mode="OneWay"/>
                        <Binding ElementName="tbBondId" Path="Text"/>
                    </MultiBinding.Bindings>
                </MultiBinding>
            </Button.CommandParameter>
        </Button>

        <!--<local:QuotationFilterPanel x:Name="FilterPanel" Grid.ColumnSpan="3" ValueChanged="QuotationFilterPanel_ValueChanged" 
                                    FilterDicChanged="FilterPanel_FilterDicChanged"/>-->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource DefaultBackgroup.ColorBrush}">
            <local:QuotationList  x:Name="QList"/>
        </Border>
        <!-- gridSplitter -->
        <!--<GridSplitter x:Name="gridSplitter" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                      Background="{StaticResource MainBackgroup.ColorBrush}"
                      Style="{StaticResource VGridSplitterStyle2}"/>-->
        <Border Grid.Row="1" Grid.Column="2"  Background="{DynamicResource DefaultBackgroup.ColorBrush}">
            <TextBlock x:Name="textBlock"  Grid.Row="1" Grid.Column="2"  Margin="10,0,0,0" VerticalAlignment="Center" Text="最近成交"
                   Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                   FontWeight="SemiBold"
                   FontSize="{DynamicResource NormalContentFontSize}" />
        </Border>

        <com:MarketCardOrderView  Grid.Row="2" Grid.Column="2" Width="Auto" x:Name="LastExecutions"/>
    </Grid>
</UserControl>
