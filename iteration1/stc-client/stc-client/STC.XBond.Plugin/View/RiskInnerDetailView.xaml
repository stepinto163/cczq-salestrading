<UserControl x:Class="STC.XBond.Plugin.View.RiskInnerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" MinWidth="100">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DataTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="GrayTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <ProgressBar Margin="10, 10, 0, 0" BorderThickness="0" Height="Auto" VerticalAlignment="Stretch"  Width="30" Grid.Row="0" Visibility="{Binding ProcessVisibility}" Value="{Binding ProcessVal}"
                              Background="{StaticResource ColorBrush.Gray13}" Foreground="{Binding ProcessBrush}" Orientation="Vertical"/>

        <!--<ProgressBar Margin="10, 10, 0, 0" BorderThickness="0" Height="Auto" VerticalAlignment="Stretch"  Width="30" Grid.Row="0" Visibility="Collapsed" Value="{Binding ProcessVal}"
                             Background="{StaticResource ColorBrush.Gray13}" Foreground="{Binding ProcessBrush}" Orientation="Vertical"/>-->

        <Grid Grid.Column="0" Visibility="{Binding LimitVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30*"></RowDefinition>
                <RowDefinition Height="52*"></RowDefinition>
                <RowDefinition Height="24*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="27"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LimitTwo}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource GrayTextBlockStyle}"></TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LimitOne}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource GrayTextBlockStyle}"></TextBlock>


            <Rectangle Margin="37, 10, 0, 0" Grid.Row="0" Grid.Column="1" Height="Auto" Width="30" VerticalAlignment="Stretch" Fill="{StaticResource ColorBrush.Gray13}"></Rectangle>


            <Border x:Name="bdLimit" Margin="37, 0, 0, 0"  Grid.Row="1" Grid.Column="1" Height="Auto" VerticalAlignment="Stretch" Width="30" Background="{StaticResource ColorBrush.Gray13}" 
                                       BorderBrush="{StaticResource ColorBrush.Gray15}" BorderThickness="0, 1, 0, 1" SizeChanged="bdLimit_SizeChanged"></Border>


            <TextBlock VerticalAlignment="Bottom" Grid.Row="1" Grid.Column="1" Height="24" Width="30" Background="{StaticResource ColorBrush.Green14}" Margin="{Binding LimitMargin}"/>
            <!--<TextBlock Margin="37, 0, 0, 2" VerticalAlignment="Bottom" Grid.Row="1" Grid.Column="1" Height="24" Width="30" Background="{StaticResource ColorBrush.Green14}"/>-->

            <Rectangle Margin="37, 0, 0, 0" Grid.Row="3" Grid.Column="1" Height="Auto" VerticalAlignment="Stretch" Width="30" Fill="{StaticResource ColorBrush.Gray13}"></Rectangle>


        </Grid>



        <TextBlock Margin="10, 5, 0, 0" Grid.Row="1" Text="{Binding BottomTitle}" FontSize="12" HorizontalAlignment="Center" Style="{StaticResource DataTextBlockStyle}"></TextBlock>
        <TextBlock Margin="10, 0, 0, 0" Grid.Row="2" Text="{Binding Num}" Foreground="{Binding NumBrush}" FontSize="20" HorizontalAlignment="Center" Style="{StaticResource DataTextBlockStyle}"></TextBlock>
        <TextBlock Margin="10, -16, 0, 0" Grid.Row="3" Text="{Binding Total}" HorizontalAlignment="Center" Style="{StaticResource GrayTextBlockStyle}"></TextBlock>


    </Grid>
</UserControl>
