<UserControl x:Class="STC.XBond.Plugin.View.MyTrading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:Component="clr-namespace:STC.Common.View.Component;assembly=STC.Common" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:ViewModel="clr-namespace:STC.XBond.Plugin.ViewModel"
             xmlns:fcon="clr-namespace:STC.XBond.Plugin.Convertor"
             mc:Ignorable="d" 
             d:DesignHeight="256" d:DesignWidth="1000"
             Initialized="UserControl_Initialized" ContextMenuOpening="UserControl_ContextMenuOpening">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <fcon:TreasuryFutureConvertor x:Key="treasuryFutureConverter"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" MouseEnter="ContentPresenter_MouseEnter">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--下划线TabItem-->
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Background" Value="{DynamicResource MainSplitterBackgroup.ColorBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TabItem.Unselected.Foreground}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                                <Border x:Name="Border" Background="Transparent" CornerRadius="2,2,2,2" BorderThickness="0,0,0,2" BorderBrush="{TemplateBinding Background}">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite"
                                                      HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      Margin="{TemplateBinding Padding}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                      VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                      ContentSource="Header" 
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                      TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                      TextBlock.FontSize="{TemplateBinding FontSize}"
                                                      RecognizesAccessKey="True">
                                            <ContentPresenter.LayoutTransform>
                                                <RotateTransform Angle="0" />
                                            </ContentPresenter.LayoutTransform>
                                        </ContentPresenter>
                                        <Ellipse x:Name="elli" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10 ,4, 0, 0" Width="5" Visibility="{TemplateBinding Tag, Converter={StaticResource SettleVisibilityConvertor}}" Height="5" Fill="#FF3C3C" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="Top"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TabItem.Selected.Border}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{DynamicResource TabItem.Static.Border}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.FontWeight" Value="SemiBold"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--ToolTip的样式-->
            <!--<Style TargetType="ToolTip">
                <Setter Property="Background" Value="#282828"/>
                <Setter Property="Padding" Value="4,2,4,2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="ArialMT"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderBrush" Value="#8F9598"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border x:Name="Root" CornerRadius="2" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}">
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <Border.Resources>
                                        <Storyboard x:Key="Visible State"/>
                                        <Storyboard x:Key="Normal State"/>
                                    </Border.Resources>
                                    <ContentPresenter
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Cursor="{TemplateBinding Cursor}"
                              Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>-->

            <!-- FrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Polygon Fill="#FFB60E" Points="6 -5.31777997e-15 0 7.42857143 4 7.42857143 2 13 8 5.57142857 3.99658203 5.57142857"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- NoFrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfNonFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="NF" Foreground="White">
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="myTradeGrid">
        <TabControl x:Name="TradeInfo_tabControl" Background="{DynamicResource BackgroundBrush}" Style="{DynamicResource TabControlStyle1}" SelectionChanged="TradeInfo_tabControl_SelectionChanged" MinHeight="60">
            <!--我的订单-->
            <TabItem x:Name="MyOrders_TabItem" Header="{Binding TotalCountOrderHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110" Tag="{Binding IsMyOrdersShowRedDot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <Grid Background="{DynamicResource MainBackgroup.ColorBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <commComp:SearchTextBox HorizontalAlignment="Right" Margin="0 0 33 0"
                                 SearchText="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Width="120" Height="18" IsFuzzy="True"
                                 FocusBorderBrush="{DynamicResource TextBox.Focus.Border}" MouseOverBorderBrush="{DynamicResource TextBox.MouseOver.Border}"/>
                    <Button x:Name="HistoryButton_MyOrder" Width="24" Height="24" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource HistoryButton}" Click="btnHistory_Click"/>

                    <local:MyOrdersFilterPanel x:Name="myOrderFilter" VerticalAlignment="Center" HorizontalAlignment="Left" FilterDicChanged="myOrderFilter_FilterDicChanged" Visibility4CancelAllBtn="Visible" Visibility4ResendBtn="Collapsed" VisibilityManualBtn="Collapsed" Margin="0,-2,0,0" />

                    <Component:CustomExecDataGrid x:Name="MyOrders_dataGrid" ItemsSource="{Binding MyOrdersDV}" Grid.Row="1"
                                SelectedItem="{Binding SelectedItem_MyOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource DefaultDataGrid}" 
                                                  DefaultHideColumns="组合,报量(手),已成交(手),开平标志,投机套保,资金账号,策略名,投组账户,报价(权%)"
                                SizeChanged="MyOrders_dataGrid_SizeChanged" 
                                                MouseRightButtonDown="MyOrders_dataGrid_MouseRightButtonDown" Grid.ColumnSpan="3">
                        <Component:CustomExecDataGrid.ContextMenu>
                            <ContextMenu Style="{DynamicResource DefaultContextMenu}" ContextMenuOpening="UserControl_ContextMenuOpening">
                                <MenuItem Header="复制" Style="{DynamicResource DefaultMenuItem}" Click="copyRow_Click"/>
                                <MenuItem Header="复制单号" Style="{DynamicResource DefaultMenuItem}" Click="copySTCCode_Click"/>
                                <MenuItem x:Name="ManualBtn" Header="线下成交" Style="{DynamicResource DefaultMenuItem}"  Click="EnterTransaction_Click"/>
                                <MenuItem x:Name="StartQQBtn" Header="弹出QQ" Style="{DynamicResource DefaultMenuItem}" Click="StartQQBtn_Click" />
                                <MenuItem x:Name="StartQQ2Btn" Header="议价" Style="{DynamicResource DefaultMenuItem}" Click="StartQQ2Btn_Click" />
                            </ContextMenu>
                        </Component:CustomExecDataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选择" Width="32" CanUserResize="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="CheckBox_All" PreviewMouseLeftButtonDown="CheckBox_All_PreviewMouseLeftButtonDown" 
                                                    IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"  Margin="6,0,0,0" Height="12"
                                                    Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" BorderBrush="{DynamicResource GraySlateButton.Static.Border}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding EnabledBtn}" Margin="5,0,0,0" Height="12"
                                            Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" BorderBrush="{DynamicResource GraySlateButton.Static.Border}"></CheckBox>
                                        <DataTemplate.Triggers>
                                            <DataTrigger  Binding="{Binding ShowDeleteBtn}" Value="2">
                                                <Setter TargetName="Selected_Chk" Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AlgoName}" Value="DQ">
                                                <Setter TargetName="Selected_Chk" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding QuoteType}" Value="virtual">
                                                <Setter TargetName="Selected_Chk" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding QuoteType}" Value="irs">
                                                <Setter TargetName="Selected_Chk" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="客户机构" Width="Auto" MinWidth="70" SortMemberPath="InstitutionName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="InsName_display" Foreground="#FFFFFF" Text="{Binding InstitutionName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstitutionName}"></TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="客户名" Width="Auto"  MinWidth="70" SortMemberPath="TraderName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="TrdNameLb_display" Foreground="#FFFFFF" Text="{Binding TraderName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TraderName}"></TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Header="方向" Width="Auto" MinWidth="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="countTB_Side" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"  FontWeight="Bold" Foreground="{DynamicResource ColorBrush.Orange}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Side}" Value="2">
                                                <Setter Property="Foreground" TargetName="countTB_Side" Value="{DynamicResource ColorBrush.Blue}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding SecurityID}" Header="代码" Width="Auto" MinWidth="85" FontWeight="SemiBold" ClipboardContentBinding="{Binding SecurityID}" Foreground="#C29B4E"/>
                            <DataGridTemplateColumn Header="简称" Width="Auto" MinWidth="85" ClipboardContentBinding="{Binding Symbol}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="TrdNameLb_display" Foreground="#C29B4E" Text="{Binding Symbol}"  FontWeight="SemiBold"  Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"></TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Binding="{Binding BookName}" Header="组合" Width="Auto" FontWeight="SemiBold"/>

                            <DataGridTemplateColumn Header="操作" Width="60" HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button x:Name="DelBtn"  Width="26" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Content="撤" Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}"
                                                Command="{Binding DataContext.DelOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                IsEnabled="{Binding EnabledBtn}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown" FontSize="12"
                                                        Padding="1" Style="{ DynamicResource GraySlateButtonStyle}" BorderThickness="0 1 0 0" >
                                            </Button>
                                            
                                            <Button x:Name="EditBtn"  Width="26" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="3,0,0,0"
                                                Content="改" Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}" FontSize="12"
                                                Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                IsEnabled="{Binding EnabledBtn}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"
                                                        Padding="1" Style="{ DynamicResource GraySlateButtonStyle}" BorderThickness="0 1 0 0">
                                            </Button>

                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding AlgoName}" Value="DQ">
                                                <Setter TargetName="EditBtn" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="DelBtn" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EnableDRPBtn}" Value="False">
                                                <Setter TargetName="EditBtn" Property="IsEnabled" Value="False"/>
                                                <Setter TargetName="DelBtn" Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger  Binding="{Binding IsPoint}" Value="1">
                                                <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="DelBtn" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Veneues}" Value="CTP">
                                                <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTemplateColumn Header="报价(%)" Width="Auto"  MinWidth="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txt_pricePercent">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Price">
                                                    <Binding Path="Yield" />
                                                    <Binding Path="MarketIndicator" />
                                                    <Binding Source="Price" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Yield}" Value="">
                                                <Setter TargetName="txt_pricePercent" Property="TextBlock.Text" Value="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="报价(原)" Width="Auto" MinWidth="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txt_priceSource">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Price">
                                                    <Binding Path="Price" />
                                                    <Binding Path="MarketIndicator" />
                                                    <Binding Path="MinChange" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Price}" Value="">
                                                <Setter TargetName="txt_priceSource" Property="TextBlock.Text" Value="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding NetPrice, Converter={StaticResource numConvertor}}" Header="净价(元)" Width="Auto" MinWidth="60" FontWeight="SemiBold"/>
                            <!--<DataGridTextColumn Binding="{Binding WholeFlag, ConverterParameter=wholeflag, Converter={StaticResource EnumTypeConvertor}}" Header="整量" Width="Auto" MinWidth="80"/>-->
                            <!--<DataGridTextColumn Binding="{Binding warningStatus}" Header="warningStatus" Width="Auto" MinWidth="80">
                            </DataGridTextColumn>-->
                            <DataGridTemplateColumn Header="报量(万元)" Width="Auto" MinWidth="80" CellStyle="{StaticResource DataGridCellStyle1}"
                                                    ClipboardContentBinding="{Binding Qty}" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Border x:Name="warningTag" Background="Transparent" Width="6" Height="6" CornerRadius="3" DockPanel.Dock="Left"></Border>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Amount">
                                                        <Binding Path="Qty" />
                                                        <Binding Path="MarketIndicator" />
                                                        <Binding Source="Amount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Border x:Name="wholeTag" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed">
                                                <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding warningStatus}" Value="1">
                                                <Setter TargetName="warningTag" Property="Background" Value="#F9C152"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                                                <Setter TargetName="wholeTag" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="报量(手)" Width="Auto" MinWidth="80" CellStyle="{StaticResource DataGridCellStyle1}"
                                                    ClipboardContentBinding="{Binding Qty}" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Border x:Name="warningTag" Background="Transparent" Width="6" Height="6" CornerRadius="3" DockPanel.Dock="Left"></Border>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Amount">
                                                        <Binding Path="Qty" />
                                                        <Binding Path="MarketIndicator" />
                                                        <Binding Source="Amount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding warningStatus}" Value="1">
                                                <Setter TargetName="warningTag" Property="Background" Value="#F9C152"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--<DataGridTextColumn Binding="{Binding DealingQty}" Header="已处理(万元)" Width="Auto" MinWidth="80"/>-->
                            <DataGridTextColumn ClipboardContentBinding="{Binding SettleType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                Header="清算速度" Width="Auto" Binding="{Binding SettleType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}"  MinWidth="40" SortMemberPath="SettlDate">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                        <Setter Property="ToolTip">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource settleTypeConvertor}" ConverterParameter="settletype_tooltip" >
                                                    <Binding Path="MarketIndicator"/>
                                                    <Binding Path="SettleType"/>
                                                    <Binding Path="SecurityID"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="意向" Width="Auto" MinWidth="50" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <!--<TextBlock x:Name="firmflag" Text="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag'}">
                                            </TextBlock>-->
                                            <Button x:Name="firmbtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Style="{StaticResource SelfFirmButton}" Visibility="Collapsed">
                                            </Button>
                                            <Button x:Name="nonfirmbtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Style="{StaticResource SelfNonFirmButton}" Visibility="Collapsed">
                                            </Button>
                                            <TextBlock Foreground="#00FFD6" x:Name="point_txt" Visibility="Collapsed" >
                                                <Run Text=" ("></Run><Run Text="{Binding RemainSeconds,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="Medium" FontFamily="Roboto"> </Run><Run Text="s)"></Run>
                                            </TextBlock>
                                            <Button x:Name="clock_img" Height="18" Width="18" Margin="0,0,0,0" VerticalAlignment="Center" 
                                                    Style="{DynamicResource HistoryButton}" IsEnabled="True"  ToolTip="{Binding RemainingTime}" MouseEnter="clock_img_MouseEnter" MouseLeave="clock_img_MouseLeave">
                                            </Button>
