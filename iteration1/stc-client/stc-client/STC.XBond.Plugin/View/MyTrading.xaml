                                                <Setter TargetName="txt_priceSource" Property="TextBlock.Text" Value="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <DataGridTextColumn Binding="{Binding NetPrice, Converter={StaticResource numConvertor}}" Header="净价(元)" Width="Auto" MinWidth="60" FontWeight="SemiBold"/>
                        <!--DataGridTextColumn Binding="{Binding WholeFlag, ConverterParameter=wholeflag, Converter={StaticResource EnumTypeConvertor}}" Header="整量" Width="Auto" MinWidth="80"/-->
                        <DataGridTemplateColumn Header="报量(万元)" Width="Auto" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                 <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Amount">
				                                    <Binding Path="Qty" />
				                                    <Binding Path="MarketIndicator" />
													<Binding Source="Amount" />
				                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                            <Border x:Name="wholeTag" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed">
                                            <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                                            <Setter TargetName="wholeTag" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="报量(手)" Width="Auto" MinWidth="80">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Amount">
                                    <Binding Path="Qty" />
                                    <Binding Path="MarketIndicator" />
									<Binding Source="Amount" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <!--<DataGridTextColumn Binding="{Binding DealingQty}" Header="已处理(万元)" Width="Auto" MinWidth="80"/>-->
                        <DataGridTextColumn Header="已成交(万元)" Width="Auto" MinWidth="80">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Amount">
                                    <Binding Path="ExecQty" />
                                    <Binding Path="MarketIndicator" />
									<Binding Source="Amount" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="已成交(手)" Width="Auto" MinWidth="80">
                            <DataGridTextColumn.Binding>
                                <MultiBinding Converter="{StaticResource treasuryFutureConverter}" ConverterParameter="Amount">
                                    <Binding Path="ExecQty" />
                                    <Binding Path="MarketIndicator" />
									<Binding Source="Amount" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding OffsetFlag}" Header="开平标志" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Binding="{Binding HedgeFlag}" Header="投机套保" Width="Auto" MinWidth="80"/>
                        <DataGridTextColumn Binding="{Binding CapAccount}" Header="资金账号" Width="Auto" MinWidth="80"/>

                        <DataGridTextColumn Binding="{Binding PartySubName}" Header="本方交易员" Width="Auto" MinWidth="80"/>

                        <!--<DataGridTextColumn Binding="{Binding OrdType}" Header="报价方式" Width="Auto"  MinWidth="70"/>-->
                        <DataGridTextColumn Binding="{Binding Veneues,ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" Header="报价方式" Width="Auto" MinWidth="50"/>
                        <DataGridTextColumn Binding="{Binding CrossVenues,ConverterParameter=crossvenues, Converter={StaticResource EnumTypeConvertor}}" Header="撮合范围" Width="Auto"  MinWidth="70"/>
                        <DataGridTextColumn Binding="{Binding QuantID}" Header="策略名" Width="Auto"  MinWidth="70"/>
                        <DataGridTextColumn Binding="{Binding VenuesSelectDisplay}" Header="渠道" Width="Auto"  MinWidth="70"/>

                        <!--<DataGridTextColumn Binding="{Binding VenuesSelectF}" Header="VenuesSelectF" Width="Auto"  MinWidth="70"/>
                        <DataGridTextColumn Binding="{Binding VenuesRdmNum}" Header="VenuesRdmNum" Width="Auto"  MinWidth="70"/>
                        <DataGridTextColumn Binding="{Binding SelfSelectVenues}" Header="SelfSelectVenues" Width="Auto"  MinWidth="70"/>-->

                        <DataGridTextColumn Binding="{Binding STCCode}" Header="STC单号" Width="Auto"  MinWidth="135"/>
                        <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" Header="最后更新时间" Width="Auto" MinWidth="60"
                                            Foreground="{DynamicResource DataGrid.SubTitle.Foreground}" 
                                            HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}" 
                                            CellStyle="{DynamicResource DataGridTextRightStyle}"/>
                        <DataGridTemplateColumn Header="客户机构" Width="Auto" MinWidth="70" SortMemberPath="InstitutionName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="InsName_display" Foreground="#FFFFFF" Text="{Binding InstitutionName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstitutionName}"></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="客户名" Width="Auto"  MinWidth="70" SortMemberPath="TraderName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="TrdNameLb_display" Foreground="#FFFFFF" Text="{Binding TraderName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TraderName}"></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="投组账户" Width="Auto" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="#FFFFFF" 
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}-{1}">
                                                <Binding Path="AccountId"/>
                                                <Binding Path="AccountName"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="报价(权%)" Width="Auto"  MinWidth="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="txt_pricePercent">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource bondFieldConverter}" ConverterParameter="Price">
                                                    <Binding Path="YieldToExecution" />
                                                    <Binding Path="MarketIndicator" />
                                                    <Binding Source="Price" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding YieldToExecution}" Value="">
                                                <Setter TargetName="txt_pricePercent" Property="TextBlock.Text" Value="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                </commComp:ExDataGrid>
                </Grid>
            </TabItem>

            <!--Rfq-->
            <TabItem x:Name="MyRfq_TabItem" Visibility="Collapsed" Header="{Binding RfqHeader,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110" Tag="{Binding IsRfqShowRedDot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            </TabItem>

            <!--我的持仓-->
            <TabItem Visibility="Collapsed" x:Name="MyPositions_TabItem" Header="我的持仓" Width="110">
                <commComp:ExDataGrid x:Name="MyPositions_dataGrid" Style="{DynamicResource DefaultDataGrid}"/>
            </TabItem>

        </TabControl>

        <!--<local:MyExecutionsFilterPanel x:Name="myExecutionsFilterPanel" Height="20" VerticalAlignment="Top"  Margin="220,2,0,0" Visibility="Collapsed"/>-->
        <Grid VerticalAlignment="Top" x:Name="RightPanel" Margin="310,2,0,0" Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
                <!--<ColumnDefinition Width="10"/>-->
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#3C3C3C" RadiusY="1" RadiusX="1" StrokeThickness="1" Margin="4,4,0,4" Width="1"/>
            <TextBlock x:Name="myOrdersTB" Grid.Column="1" FontStyle="Normal" Foreground="#A0A0A0" FontFamily="Microsoft YaHei" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Run Text="共"></Run>
                <Run Text="{Binding TotalCount4MyOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text=" 条记录， 其中Bid "></Run>
                <Run Text="{Binding TotalCount4MyBidOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text="条，Ofr "></Run>
                <Run Text="{Binding TotalCount4MyOfrOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text="条"></Run>
            </TextBlock>
            <TextBlock x:Name="myExesTB" Grid.Column="1" FontStyle="Normal" Foreground="#A0A0A0" FontFamily="Microsoft YaHei" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                <Run Text="共"></Run>
                <Run Text="{Binding TotalCount4MyExes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text=" 条记录， 其中Bid "></Run>
                <Run Text="{Binding TotalCount4MyBidExes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text="条，Ofr "></Run>
                <Run Text="{Binding TotalCount4MyOfrExes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text="条"></Run>
            </TextBlock>
            <TextBlock x:Name="myCancelOrdersTB" Grid.Column="1" FontStyle="Normal" Foreground="#A0A0A0" FontFamily="Microsoft YaHei" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                <Run Text="共"></Run>
                <Run Text="{Binding TotalCount4MyCancelOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text=" 条记录， 其中Bid "></Run>
                <Run Text="{Binding TotalCount4MyBidCancelOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text="条，Ofr "></Run>
                <Run Text="{Binding TotalCount4MyOfrCancelOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="White"></Run>
                <Run Text="条"></Run>
            </TextBlock>
            <Frame x:Name="myRfqFilter" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Left">
            </Frame>
            <Button x:Name="btnFullScreen" Grid.Column="2" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource PopupButton}" />
        </Grid>
    </Grid>
</UserControl>
