<Window x:Class="STC.XBond.Plugin.View.UpdateUserPassUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.View"
        mc:Ignorable="d" 
        Title="修改密码" Height="180" Width="335"  WindowStartupLocation="CenterScreen" ResizeMode="NoResize" BorderThickness="1" BorderBrush="#A0A0A0"
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" Closed="Window_Closed" Background="#141414" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#282828" BorderThickness="1">
        <Grid Background="{StaticResource ColorBrush.Gray13}">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource ColorBrush.Gray18}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="修改密码" Width="48" Margin="10, 5, 0, 0" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}" 
                           Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource SmallContentFontSize}"/>
                <Button Width="16" Height="16" Grid.Column="2"  Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
            </Grid>

            <Border Visibility="{Binding CommonVisible}" Grid.Row="1" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>

                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"></ColumnDefinition>
                        <ColumnDefinition Width="130"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"  Orientation="Horizontal" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="原密码：" Grid.Column="0" 
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" 
                                       FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                       Foreground="{StaticResource ColorBrush.While}" 
                                       FontSize="12"></TextBlock>
                            <PasswordBox x:Name="tbPassword"  Grid.Column="1" Width="100" Height="20" 
                                         Background="{StaticResource ColorBrush.Gray13}"                                        
                                         FontSize="14px" BorderBrush="#3C3C3C"                                     
                                         VerticalAlignment="Bottom" VerticalContentAlignment="Center" Foreground="#FFFFFF " 
                                         Margin="2,-3,0,7"  KeyDown="tbWeight_KeyDown"                                     
                                         Style="{StaticResource DefaultPasswordBoxStyle}" BorderThickness="1"
                                         HorizontalAlignment="Left"></PasswordBox>
                            <StackPanel Grid.Column="2">
                                <TextBlock HorizontalAlignment="Left" 
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                           Foreground="{StaticResource ColorBrush.While}" 
                                           FontSize="10"></TextBlock>
                                <TextBlock Text="密码不正确"
                                           Visibility="{Binding ErrorPassVisible}"
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Bottom"
                                           FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                           Foreground="{StaticResource ColorBrush.Red11}" 
                                           FontSize="10"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"  Orientation="Horizontal" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="新密码：" 
                                       Grid.Column="0" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                       Foreground="{StaticResource ColorBrush.While}" 
                                       FontSize="12"></TextBlock>
                            <PasswordBox x:Name="newPassword" Grid.Column="1" 
                                         HorizontalAlignment="Left" 
                                         Width="100" Height="20" 
                                         Background="{StaticResource ColorBrush.Gray13}"                                          
                                         FontSize="14px" BorderBrush="#3C3C3C"                                    
                                         VerticalAlignment="Bottom" VerticalContentAlignment="Center" 
                                         Foreground="#FFFFFF " Margin="2,-3,0,7"  KeyDown="tbWeight_KeyDown"                                     
                                         Style="{StaticResource DefaultPasswordBoxStyle}" BorderThickness="1"></PasswordBox>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="(6-16个字符，区分大小写)"
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                           Foreground="{StaticResource ColorBrush.While}" 
                                           FontSize="10"></TextBlock>
                                <TextBlock Text="{Binding PassErrorText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                           Visibility="{Binding PassErrorVisible}"
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Bottom"
                                           FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                           Foreground="{StaticResource ColorBrush.Red11}" 
                                           FontSize="10"></TextBlock>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"  Orientation="Horizontal" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="重复新密码："  
                                       Grid.Column="0" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                       Foreground="{StaticResource ColorBrush.While}" FontSize="12"></TextBlock>
                            <PasswordBox x:Name="confirmPassword" Grid.Column="1" 
                                         HorizontalAlignment="Left" Width="100" Height="20" 
                                         Background="{StaticResource ColorBrush.Gray13}"                                       
                                         FontSize="14px" BorderBrush="#3C3C3C"                                     
                                         VerticalAlignment="Bottom" VerticalContentAlignment="Center" Foreground="#FFFFFF " 
                                         Margin="2,-3,0,7"  KeyDown="tbWeight_KeyDown"                                     
                                         Style="{StaticResource DefaultPasswordBoxStyle}" BorderThickness="1"></PasswordBox>
                            <StackPanel Grid.Column="2">
                                <TextBlock HorizontalAlignment="Left" 
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                           Foreground="{StaticResource ColorBrush.While}" 
                                           FontSize="10"></TextBlock>
                                <TextBlock Text="2次输入密码不一致"
                                           Visibility="{Binding ConfirmErrorVisible}"
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Bottom"
                                           FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                           Foreground="{StaticResource ColorBrush.Red11}" 
                                           FontSize="10"></TextBlock>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <Border  Visibility="{Binding CommonVisible}" Grid.Row="2" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Background="{StaticResource ColorBrush.Gray13}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <Button Name="btOK" Grid.Column="0" Content="提交" 
                            HorizontalAlignment="Right"
                            IsCancel="True" IsDefault="True"  
                            Click="btOK_Click" 
                            Width="100" Height="24" 
                            Margin="0, 0, 20, 0" FontSize="12"
                            Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}"/>
                    <Button Name="btCancel"                            
                            HorizontalAlignment="Left"
                            Grid.Column="1" Content="取消" IsCancel="True" 
                            IsDefault="True" 
                            Click="btCancel_Click"  
                            Width="100" Height="24"
                            FontSize="12"
                            Style="{StaticResource SmallCancelBtnStyle}"/>

                </Grid>

            </Border>
            <Border Visibility="{Binding SuccessVisible}" Grid.Row="1" Grid.RowSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="密码修改完成" 
                               HorizontalAlignment="Right" 
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                       Foreground="{StaticResource ColorBrush.While}" 
                                       FontSize="12" Margin="0,0,20,0"></TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="(2秒后自动关闭该窗口)"
                               HorizontalAlignment="Left" 
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" 
                                       Foreground="{StaticResource ColorBrush.While}" 
                                       FontSize="10"></TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
