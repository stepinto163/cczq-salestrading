<UserControl x:Class="STC.XBond.Plugin.View.MyExecutionsFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:Component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d"  FontSize="12" Height="24">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ContractType" Text="合约:" VerticalAlignment="Center" Margin="7,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="ContractTypeListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="ContractTypeListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="ALL" Style="{DynamicResource FilterListBoxItemDodgerBlueAllStyle}" IsSelected="True" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="债券" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="40" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="期货" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="40" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="IRS" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="40" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
            </ListBox>

            <TextBlock x:Name="tbCodeType" Text="债券类型:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <ListBox x:Name="lbCodeType" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="LbCodeType_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="ALL" Style="{DynamicResource FilterListBoxItemDodgerBlueAllStyle}" IsSelected="True" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="利率" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="40" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="信用" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="40" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
            </ListBox>


            <TextBlock x:Name="VenuesLbl" Text="交易场所:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <!--<ListBox x:Name="VenuesListBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="VenuesListBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="ALL" x:Name="All" Style="{DynamicResource FilterListBoxItemDodgerBlueAllStyle}" IsSelected="True" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="Tradebook" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="70" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="X-Bond" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="56" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="双边" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="56" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>

                <ListBoxItem Content="ALL" x:Name="AllBroker" Style="{DynamicResource FilterListBoxItemDodgerBlueAllStyle}" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="10,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="国际" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="国利" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="平安" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="信唐" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="中诚" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="上田" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
            </ListBox>-->
            <Component:MultiSelectComboBox x:Name="VenuesMscb" HorizontalAlignment="Left" 
                                                Width="100" Height="22" Background="Black" 
                                                DefaultText="全部" Tag="StrategyStauts" 
                                                FilterDicChanged="VenuesMscb_FilterDicChanged"/>

            <TextBlock x:Name="SyncStatusLbl" Text="同步状态:" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
            <!--<ListBox x:Name="SyncStatusBox" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="SyncStatusBox_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="ALL" Style="{DynamicResource FilterListBoxItemDodgerBlueAllStyle}" IsSelected="True" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="已发送" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="56" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
                <ListBoxItem Content="待处理" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="56" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,0" BorderThickness="0 1 0 0"/>
            </ListBox>-->
            <Component:MultiSelectComboBox x:Name="SyncStatusMscb" HorizontalAlignment="Left" 
                                                Width="100" Height="22" Background="Black" 
                                                DefaultText="全部" Tag="StrategyStauts" 
                                                FilterDicChanged="SyncStatusMscb_FilterDicChanged"/>
        </StackPanel>

    </Grid>
</UserControl>
