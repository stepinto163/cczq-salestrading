<UserControl x:Class="STC.XBond.Plugin.View.Risk.RiskLimitDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Risk"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="700" Height="22" Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="90"></ColumnDefinition>
            <ColumnDefinition Width="90"></ColumnDefinition>
            <ColumnDefinition Width="90"></ColumnDefinition>
            <ColumnDefinition Width="90"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding RiskTitle}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="60" Margin="10, 0, 0, 0" 
                   FontWeight="Bold" Foreground="{StaticResource ColorBrush.While}" FontSize="12"/>

        <TextBlock Grid.Column="1" Text="{Binding RealtimeVal}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10, 0, 0, 0" 
                   FontWeight="Bold" Foreground="{StaticResource ColorBrush.Green14}" FontSize="12"/>

        <Border Grid.Column="2" Grid.ColumnSpan="4" Background="{Binding ProcessBgBrush}"></Border>
        <!--<Border Grid.Column="2" Grid.ColumnSpan="4" Background="{StaticResource ColorBrush.Gray13}"></Border>-->

        <TextBlock Grid.Column="2" Text="{Binding LimitOne}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0, 0, 5, 0"
                    Foreground="{StaticResource ColorBrush.Gray14}" FontSize="10"/>

        <Rectangle Grid.Column="2"  Height="20" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource ColorBrush.Gray15}"></Rectangle>

        <Rectangle Grid.Column="3"  Height="20" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource ColorBrush.Gray15}" Panel.ZIndex="1"></Rectangle>

        <TextBlock Grid.Column="5" Text="{Binding LimitTwo}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5, 0, 0, 0"
                    Foreground="{StaticResource ColorBrush.Gray14}" FontSize="10"/>

        <Rectangle Grid.Column="5"  Height="20" Width="1" HorizontalAlignment="Left" VerticalAlignment="Stretch" Fill="{StaticResource ColorBrush.Gray15}"></Rectangle>

        <TextBlock Grid.Column="6" Text="{Binding Limit}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5, 0, 0, 0" TextTrimming="CharacterEllipsis" 
                    Foreground="{StaticResource ColorBrush.While}" FontSize="12">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>
        
        <TextBlock Grid.Column="7" Text="{Binding Source}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0, 0, 10, 0"
                    Foreground="{StaticResource ColorBrush.While}" FontSize="12"/>

        <!--<Rectangle Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="20" Width="30" Fill="{StaticResource ColorBrush.Green14}" Margin="{Binding LimitMargin}"/>-->
        <Rectangle Grid.Column="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="20" Width="30" Fill="{Binding CursorBrush}" Margin="{Binding LimitMargin}"/>
    </Grid>
</UserControl>
