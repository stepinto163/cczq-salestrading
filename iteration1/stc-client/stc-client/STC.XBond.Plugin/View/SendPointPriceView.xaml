                            <CheckBox x:Name="lbAddOneNotLimit" IsEnabled="False"  Margin="10, 0, 0, 0" Style="{StaticResource CheckBoxThemeColor}" Width="60" IsChecked="{Binding AddOneNotLimitCheck, Mode=TwoWay}" Content="+1不限"  Foreground="{StaticResource ColorBrush.While}" FontSize="12"></CheckBox>

                            <CheckBox x:Name="lbAddOneToday" IsEnabled="False"  Margin="10, 0, 0, 0" Style="{StaticResource CheckBoxThemeColor}" Width="55" IsChecked="{Binding AddOneTodayCheck, Mode=TwoWay}" Content="今+1" Foreground="{StaticResource ColorBrush.While}" FontSize="12"></CheckBox>

                            <CheckBox x:Name="lbAddOneTomorrow" IsEnabled="False" IsChecked="{Binding AddOneTomorrowCheck, Mode=TwoWay}" VerticalAlignment="Center" Margin="10, 0, 0, 0" Width="55"
                              Content="明+0" FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CheckBoxThemeColor}" Foreground="{StaticResource ColorBrush.While}"></CheckBox>

                        </StackPanel>

                    <ListBox x:Name="lbSpotSettle" Grid.Column="0" SelectionMode="Extended" Margin="10, 0, 0, 0" 
                             ScrollViewer.VerticalScrollBarVisibility="Hidden" Visibility="{Binding SpotSettleBoxVisibility}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Height="26" 
                         Background="Transparent" MinWidth="130"
                         BorderThickness="0"
                         FontSize="12"          SelectedIndex="{Binding SpotSettleBoxIndex, Mode=TwoWay}"    
                         VerticalAlignment="Center" HorizontalAlignment="Left" 
                         BorderBrush="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem IsEnabled="False"  Width="60" Height="24"  Content="T+1" Style="{StaticResource ListBoxItemStyle}"/>
                        <ListBoxItem IsEnabled="False" Width="60" Height="24" Content="T+0" Style="{StaticResource ListBoxItemStyle}"/>
                    </ListBox>

                    <DatePicker x:Name="datePicker" Grid.Column="1" Width="100" Height="24" Margin="10, 0, 0, 0" SelectedDate="{Binding SelectDate}" Visibility="{Binding SendPriceItem.DateVisible}" Text="{Binding SendPriceItem.CustomSettleDate, Mode=TwoWay}" Style="{DynamicResource DatePickerStyle}"/>
                    <ComboBox IsEnabled="False" Grid.Column="2" Width="60"  Height="24" Padding="0, 3, 0, 0" SelectedIndex="{Binding ComboBoxSelectIndex,Mode=TwoWay}" Visibility="{Binding SendPriceItem.SettleTypeVisible}" Text="{Binding SendPriceItem.SettleType, Mode=TwoWay}" Style="{DynamicResource ComboBoxStyle}">
                        <ComboBoxItem Content="T+0" Tag="1"></ComboBoxItem>
                        <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>
                    </ComboBox>


                    <ListBox Grid.Column="3" SelectionMode="Extended" Margin="10, 0, 0, 0" Visibility="Collapsed"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Height="26" 
                         Background="Transparent" SelectedIndex="{Binding SendPriceItem.AmountBoxIndex, Mode=TwoWay}"
                         BorderThickness="0" 
                         FontSize="12"              MinWidth="130"
                         VerticalAlignment="Center" HorizontalAlignment="Left" 
                         BorderBrush="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem IsEnabled="False" Width="60" Height="24"  Content="否" Style="{StaticResource ListBoxItemStyle}"/>
                        <ListBoxItem IsEnabled="False" Width="60" Height="24" Content="是" Style="{StaticResource ListBoxItemStyle}"/>
                    </ListBox>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Visibility="Collapsed" Grid.Row="3" BorderThickness="0, 1, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Background="{StaticResource ColorBrush.Gray13}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition Width="60"></ColumnDefinition>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="撮合渠道：" Margin="10, 0, 0, 0" VerticalAlignment="Center" HorizontalAlignment="Left"  Foreground="{StaticResource ColorBrush.While}" FontSize="12" />
                <CheckBox Style="{StaticResource CheckBoxThemeColor}" IsChecked="{Binding CheckAll, Mode=TwoWay}" Width="45" Grid.Column="1" Content="所有"   Foreground="{StaticResource ColorBrush.While}" FontSize="12"></CheckBox>

                <CheckBox  Style="{StaticResource CheckBoxThemeColor}" IsChecked="{Binding CheckInner, Mode=TwoWay}" Width="55" Grid.Column="2" Content="仅内部"   Foreground="{StaticResource ColorBrush.While}" FontSize="12"></CheckBox>

            </Grid>
        </Border>

        <Border Grid.Row="4" BorderThickness="0, 1, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Background="{StaticResource ColorBrush.Gray13}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding LockTimeOutHeight}"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48*"></ColumnDefinition>
                    <ColumnDefinition Width="65"></ColumnDefinition>
                    <ColumnDefinition Width="52*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                        BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Background="{StaticResource ColorBrush.Gray13}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding LockTimeOutCheck, Mode=TwoWay}" VerticalAlignment="Center" Margin="5, 3, 0, 0" Grid.Column="0" BorderThickness="2" 
                              BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"   
                              FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}"
                              Foreground="{StaticResource ColorBrush.While}" Content="愿意匹配Nonfirm并等待"></CheckBox>

                        <TextBox Tag="3" Style="{StaticResource DefaultTextBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" Width="40" Height="21" Margin="8, 0, 0, 0" Padding="5, 0, 0, 0"
                                     Text="{Binding IocOutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"
                             Background="{StaticResource ColorBrush.Black10}" ToolTip="输入范围:1-300秒"></TextBox>

                        <TextBlock Text="秒" Grid.Column="2" TextAlignment="Center" VerticalAlignment="Center" Margin="5, 0, 0, 0"  
                               Foreground="{StaticResource ColorBrush.While}" FontSize="12"/>

                    </StackPanel>
                </Border>
                

                <TextBlock Grid.Row="1" Grid.Column="0" Text="*请详细确认以上信息" HorizontalAlignment="Left" 
                           Foreground="{StaticResource ColorBrush.While}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Width="113"/>

                <Button Grid.Row="1" Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" FontSize="12" Background="#3C3C3C" Foreground="#FFFFFF" 
                        Style="{StaticResource SmallCancelBtnStyle}" Width="60" Height="40"/>
                <Button Grid.Row="1" Grid.Column="2" Content="报价" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding OkCommand}" FontSize="12" Background="#136C5E" 
                        Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}" Width="200" Height="40"/>
                
            </Grid>
        </Border>

    </Grid>
</Window>
