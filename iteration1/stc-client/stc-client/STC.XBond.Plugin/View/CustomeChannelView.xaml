<UserControl x:Class="STC.XBond.Plugin.View.CustomeChannelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="90" d:DesignWidth="300" Background="#141414">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="listBoxItemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="IsSelected" Value="{Binding Checked}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Red7}"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>
                                
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="CheckBoxThemeColor" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="_borderOne" CornerRadius="5" Background="#3C3C3C" Width="12" Height="12" Margin="{TemplateBinding Margin}">
                                    <Border x:Name="_borderTwo" CornerRadius="4" Background="#3C3C3C" Width="8" Height="8" Margin="{TemplateBinding Margin}">
                                        <Border x:Name="_borderThree" CornerRadius="3" Background="#141414" Width="6" Height="6" Margin="{TemplateBinding Margin}">

                                        </Border>
                                    </Border>
                                </Border>
                                <ContentPresenter Grid.Column="1" x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" TargetName="_borderOne" Value="#136C5E"/>
                                    <Setter Property="Background" TargetName="_borderTwo" Value="#141414"/>
                                    <Setter Property="Background" TargetName="_borderThree" Value="#136C5E"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Background" TargetName="_borderOne" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="_borderTwo" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="_borderThree" Value="#141414"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Content" Value="{Binding Name}"/>
            <Setter Property="IsSelected" Value="{Binding Checked}"/>
            <Setter Property="BorderThickness" Value="0"/>
                <!--<Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="border" Property="Background" Value="{Binding BgColor}"></Setter>
                                <!--Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>-->
                            </Trigger>

                            <Trigger Property="IsSelected" Value="false">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="true">
                                <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource ColorBrush.Gray13}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="0"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <CheckBox x:Name="cbNotOut" Grid.Row="0" Grid.Column="0" Width="90" Checked="cbNotOut_Checked" IsChecked="{Binding IsSendOut, Mode=TwoWay}"
                              BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20" 
                               FontSize="{StaticResource SmallContentFontSize}" 
                              Style="{StaticResource CheckBoxThemeColor}" Background="{StaticResource ColorBrush.Transparent}" 
                              Foreground="{StaticResource ColorBrush.While}" Content="不发送外部" ></CheckBox>


        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" ></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="cbDefault" Grid.Column="0" IsChecked="{Binding DefaultChecked, Mode=TwoWay}" VerticalAlignment="Center" Checked="cbDefault_Checked"
                              BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"  Width="50"
                               FontSize="{StaticResource SmallContentFontSize}" 
                              Style="{StaticResource CheckBoxThemeColor}" Background="{StaticResource ColorBrush.Transparent}" Foreground="{StaticResource ColorBrush.While}" 
                              Content="默认" ></CheckBox>

            <ListBox x:Name="lbFirstLevel" Grid.Column="1" SelectionMode="Extended" Margin="0, 0, 0, 0" 
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Height="26" ItemContainerStyle="{StaticResource itemContainStyle}"
                         Width="Auto" Background="{StaticResource ColorBrush.Gray13}"
                         BorderThickness="0" ItemsSource="{Binding DefaultFirstItemData}"
                         FontSize="12"              
                         VerticalAlignment="Center" HorizontalAlignment="Left" SelectedItem=""
                         BorderBrush="Transparent" >

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <!--<ListBoxItem Width="60" Height="24"  Content="X-bond" Style="{StaticResource ListBoxItemStyle}"/>-->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ListBoxItem Width="60" Height="24" FontSize="12"  
                                 Style="{StaticResource itemContainStyle}" Foreground="{StaticResource ColorBrush.While}"></ListBoxItem>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>


            <ListBox x:Name="lbSecondLevel" Grid.Column="2" SelectionMode="Extended" Margin="0, 0, 0, 0" 
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Height="26" ItemContainerStyle="{StaticResource itemContainStyle}"
                         BorderThickness="0" ItemsSource="{Binding DefaultSecondItemData}"
                         FontSize="12"              Width="Auto" Background="{StaticResource ColorBrush.Gray13}"
                         VerticalAlignment="Center" HorizontalAlignment="Left" SelectedItem=""
                         BorderBrush="Transparent" >

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <!--<ListBoxItem Width="60" Height="24"  Content="X-bond" Style="{StaticResource ListBoxItemStyle}"/>-->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ListBoxItem Width="60" Height="24" FontSize="12"  
                                  Foreground="{StaticResource ColorBrush.While}"></ListBoxItem>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>


            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox x:Name="tbRandomNum" Text="{Binding DataContext.RandomNum, Mode=TwoWay}" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput"
                                 Width="50" Height="24" Margin="5, 0, 5, 0" Padding="0, 3, 0, 0" Template="{DynamicResource TextBoxControlTemplate1}"
                                 Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}" >
                    <TextBox.Resources>
                        <ControlTemplate x:Key="TextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock Text="家渠道 (共{0}家)"  Foreground="{StaticResource ColorBrush.While}" VerticalAlignment="Center"
                           FontSize="12" Margin="2, 0, 2, 0"></TextBlock>
            </StackPanel>

        </Grid>


        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" ></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="cbDirection" Grid.Row="3" Grid.Column="0" IsChecked="{Binding DirectionChecked, Mode=TwoWay}" 
                      VerticalAlignment="Center" BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20" Width="50"
                               FontSize="{StaticResource SmallContentFontSize}" Checked="cbDirection_Checked"
                              Style="{StaticResource CheckBoxThemeColor}" Background="{StaticResource ColorBrush.Transparent}"
                              Foreground="{StaticResource ColorBrush.While}" Content="指定"></CheckBox>

            <ListBox x:Name="lbDirect"  Grid.Column="1" SelectionMode="Extended" ItemsSource="{Binding DirectionItemData}"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden" Width="Auto" Background="{StaticResource ColorBrush.Gray13}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                              BorderBrush="Transparent" 
                     ItemContainerStyle="{StaticResource itemContainStyle}"
                             >

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ListBoxItem Width="60" Height="24"  FontSize="12" ></ListBoxItem>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>

    </Grid>

</UserControl>
