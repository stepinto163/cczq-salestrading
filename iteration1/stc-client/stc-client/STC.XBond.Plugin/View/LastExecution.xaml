<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component" 
             x:Class="STC.XBond.Plugin.View.LastExecution"
             xmlns:vm ="clr-namespace:STC.XBond.Plugin.ViewModel"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400" Initialized="MarketExecution_Initialized">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridTextLeftStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="X">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Side}" Value="Z">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Green}" />
                    </DataTrigger>
                </Style.Triggers>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource DefaultBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="33" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="textBlock" Margin="10,0,0,0" VerticalAlignment="Center" Text="最近成交"
                   Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                   FontWeight="SemiBold"
                   FontSize="14" />

        <commComp:ExDataGrid x:Name="lastExecution_dataGrid" Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding FilteredMarketExecutions.View}" 
                 Style="{DynamicResource DefaultDataGrid}" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}" 
                                        Header="方向" Width="Auto" MinWidth="40" CellStyle="{DynamicResource ColumnColorStyle}"/>
                <DataGridTemplateColumn Width="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="/STC.XBond.Plugin;component/Images/stc_icon_favorite_seleted.png" Height="16" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowStar}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding SecurityID}" Header="代码" Width="Auto" MinWidth="85"/>
                <DataGridTextColumn Binding="{Binding ExecutePricePercent_Display, Converter={StaticResource numConvertor}}" SortMemberPath="ExecutePricePercent" Header="成交价(%)" Width="Auto" MinWidth="80" CellStyle="{StaticResource ColumnColorStyle}"/>

                <DataGridTemplateColumn Header="来源" Width="Auto" MinWidth="60"  CanUserSort="True" SortMemberPath="SourceTrader">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="SourceTraderBorder" Background="{Binding SourceTrader,Converter={StaticResource venuesColorConvertor}}"  CornerRadius="2" Height="16" Width="40" HorizontalAlignment="Left">
                                <TextBlock x:Name="SourceTraderText" Foreground="{StaticResource DefaultForegroup.ColorBrush}" 
                                           Text="{Binding SourceTrader, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='venuesxb'}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource SourceTraderStyle}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- Binding="{Binding Path=CreateTime,StringFormat=‘yyyy年MM月dd日 HH:mm:ss‘}" -->
                <DataGridTextColumn Binding="{Binding Time, Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" Header="时间"  Width="Auto" MinWidth="60" CanUserSort="True" SortMemberPath="Time" HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridTextRightStyle}">
                            <Setter Property="Foreground" Value="{StaticResource DataGrid.SubTitle.Foreground}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </commComp:ExDataGrid>
    </Grid>
</UserControl>
