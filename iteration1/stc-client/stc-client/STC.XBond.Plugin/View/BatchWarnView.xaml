<Window x:Class="STC.XBond.Plugin.View.BatchWarnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Common.View;assembly=STC.Common"
        x:Name="BatchWarnWindow"
             Title="{Binding Title}" Height="207" MaxHeight="600" Width="460" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
            SizeToContent="WidthAndHeight"    
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" BorderThickness="1" BorderBrush="#A0A0A0">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DefalutTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource ColorBrush.Gray13}">
        <Grid.RowDefinitions>
            <RowDefinition Height="23"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{Binding ShowTitleBG}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Title}" Width="48" Margin="10, 4, 0, 0" FontWeight="Bold"
                               Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource SmallContentFontSize}"/>
            <Button Width="16" Height="16" Grid.Column="2" Click="Button_Click" Style="{StaticResource ImageCloseButton}"/>
        </Grid>


       
        <Border VerticalAlignment="Stretch" Grid.Row="1" BorderThickness="1, 0, 1, 1" BorderBrush="{Binding ShowBdBG}" Background="{Binding ShowBG}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <ListBox Background="Transparent" ItemsSource="{Binding WarnList}" VirtualizingPanel.IsVirtualizing="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Template>
                        <ControlTemplate>
                            <ScrollViewer x:Name="ScrollViewer" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Grid.Row="0" BorderThickness="0" Background="{Binding ShowBG}">
                                <local:SendPriceRiskView/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" Margin="10 0 0 0">
                    <TextBlock Grid.Row="2" Text="请检查要素" Foreground="White" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Grid.Row="2" Height="40" HorizontalAlignment="Center">
                    <Button HorizontalAlignment="Center" Content="关闭" Click="Button_Click"
                            Height="24" Width="60" Foreground="#FFFFFF" Style="{StaticResource SmallCancelBtnStyle}"  Visibility="{Binding ButtonVisibility}"></Button>
                    <Button HorizontalAlignment="Center"  Content="全部关闭" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=BatchWarnWindow}"
                            Height="24" Width="60" Foreground="#FFFFFF" Style="{StaticResource SmallCancelBtnStyle}" Visibility="{Binding OkVisibility}"></Button>
                    <Button x:Name="btnOk" Visibility="{Binding OkVisibility}" HorizontalAlignment="Center" Margin="10 0 0 0" Content="全部确认，发出" Command="{Binding OkCommand}" 
                            Height="24" Width="100" Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}" CommandParameter="{Binding ElementName=BatchWarnWindow}" ></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
