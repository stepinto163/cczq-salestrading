<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View"
             xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component" 
             x:Class="STC.XBond.Plugin.View.MarketExecution"
             xmlns:vm ="clr-namespace:STC.XBond.Plugin.ViewModel"
             xmlns:utils="clr-namespace:STC.XBond.Plugin.Utils"
             xmlns:command ="clr-namespace:STC.XBond.Plugin.Command"
             mc:Ignorable="d"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             d:DesignHeight="300" d:DesignWidth="400" Initialized="MarketExecution_Initialized">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

           
            <!--买卖样式-->
            <Style x:Key="TempSizeStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="24"></Setter>
                <Setter Property="Width" Value="40"></Setter>
                <Setter Property="Padding" Value="0,4,0,0"></Setter>
                <Setter Property="TextAlignment" Value="Center"></Setter>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="X"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="Z"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Green}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="Y"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="1"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="3"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Green}" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Side}" Value="2"/>
                            <!--<Condition Binding="{Binding IsValid}" Value="Y"/>-->
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                    </MultiDataTrigger>

                    <DataTrigger Binding="{Binding IsValid}" Value="N">
                        <Setter Property="Foreground" Value="{DynamicResource Textblock.Foreground.HOLC.Gray}" />
                    </DataTrigger>
                </Style.Triggers>

            </Style>


            <Style x:Key="CheckBoxThemeColor" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}" 
                            CornerRadius="2">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_icon_favorite_normal.png"/>
                                    </Border.Background>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_icon_favorite_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_icon_favorite_seleted.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>

                                <Trigger Property="IsChecked" Value="false">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_icon_favorite_normal.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="Title_Part" Height="28" />
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="textBlock" Margin="10,0,0,0" VerticalAlignment="Center" Text="市场成交"
                   Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                   FontWeight="SemiBold"
                   FontSize="{DynamicResource NormalContentFontSize}" />

        <commComp:SearchTextBox x:Name="Search_TextBox" SearchText="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Margin="0,0,50,0" Width="120" Height="18"
                                 FocusBorderBrush="{DynamicResource TextBox.Focus.Border}" MouseOverBorderBrush="{DynamicResource TextBox.MouseOver.Border}"/>

        <Button x:Name="PopupBtn" Style="{DynamicResource PopupButton}" HorizontalAlignment="Right" Width="12" Height="12" Margin="0,0,20,0" Command="{x:Static utils:WindowKeyHelper.popupWindowCommand}" CommandParameter="{x:Static command:PopupTypeEnum.MarketExecution}"/>

        <DataGrid x:Name="marketExecutionNew" Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding FilteredMarketExecutions.View}" 
                 Style="{DynamicResource DefaultDataGrid}" RowHeight="32" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn MinWidth="40" Width="Auto">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="方向" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource DefaultDisableForground}" FontSize="12"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"  FontSize="12" Style="{DynamicResource TempSizeStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Width="32">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox Style="{DynamicResource CheckBoxThemeColor}" Margin="2, 0, 0, 0" Height="16" Width="16" Command="{Binding DataContext.StarFilterCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></CheckBox>
                            <!--<Button Style="{StaticResource StarButton}" Margin="2, 0, 0, 0" Height="16" Width="16" Command="{Binding DataContext.StarFilterCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"/>-->
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="/STC.XBond.Plugin;component/Images/stc_icon_favorite_seleted.png" Height="16" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowStar}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding SecurityID}" Header="代码" Width="Auto" MinWidth="85"/>

                <!--<DataGridTextColumn Binding="{Binding ExecutePricePercent_Display, Converter={StaticResource numConvertor}}" SortMemberPath="ExecutePricePercent" Header="成交价(%)" Width="Auto" MinWidth="80" CellStyle="{StaticResource ColumnColorStyle}"/>-->

                <DataGridTemplateColumn  Width="Auto" MinWidth="80" SortMemberPath="ExecutePricePercent">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="成交价" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource DefaultDisableForground}" FontSize="12"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="{Binding ExecutePricePercent_Display, Converter={StaticResource numConvertor}}" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left"  MinWidth="25" Width="Auto" FontSize="12" Style="{DynamicResource TempSizeStyle}" />
                                <Border x:Name="YuanQi" CornerRadius="2" Width="12" Height="14" Visibility="Collapsed" Background="{DynamicResource MainSplitterBackgroup.ColorBrush}" BorderThickness="0" Margin="2,0,0,0">
                                    <TextBlock Text="远" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FFFFFF" 
                                               ToolTip="{Binding SettlType_yuan, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_tooltip'}"/>
                                </Border>
                                <Border x:Name="T0" CornerRadius="2" Width="14" Height="14" Visibility="Collapsed" BorderThickness="0" Margin="2,0,0,0">
                                    <TextBlock Text="+0" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FFFFFF" Background="#6E2022"/>
                                </Border>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SettlType,Converter={StaticResource stringContainsConvertor}, ConverterParameter='1'}" Value="true">
                                    <Setter TargetName="T0" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SettlType_yuan, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter TargetName="YuanQi" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn  Width="Auto" MinWidth="25" SortMemberPath="LastQty">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="成交量" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource DefaultDisableForground}" FontSize="12"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="{Binding LastQty}" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="25" Width="Auto" FontSize="12" 
                                         />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="来源" Width="Auto" MinWidth="60"  CanUserSort="True" SortMemberPath="SourceTrader">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="SourceTraderBorder" Background="{Binding SourceTrader,Converter={StaticResource venuesColorConvertor}}"  CornerRadius="2" Height="16" Width="40" HorizontalAlignment="Left">
                                <TextBlock x:Name="SourceTraderText" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"  Text="{Binding SourceTrader,Converter={StaticResource EnumTypeConvertor},ConverterParameter=venuesxb}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Style="{DynamicResource  SourceTraderStyle}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Header="时间" Width="Auto" MinWidth="60"  CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="borderTime"  Width="Auto" MinWidth="60" HorizontalAlignment="Right">
                                <TextBlock x:Name="TimeText" Foreground="{DynamicResource DataGrid.SubTitle.Foreground}"  Text="{Binding Time, Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" ToolTip="{Binding Time}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- Binding="{Binding Path=CreateTime,StringFormat=‘yyyy年MM月dd日 HH:mm:ss‘}" -->
                <!--<DataGridTextColumn Binding="{Binding Time, Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}"  Header="时间"  Width="Auto" MinWidth="60" CanUserSort="True" SortMemberPath="Time" HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridTextRightStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource DataGrid.SubTitle.Foreground}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>-->
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
