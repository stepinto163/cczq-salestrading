<Window x:Class="STC.XBond.Plugin.View.PointPriceSettleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.View"
        mc:Ignorable="d"
        Title="点价" Height="330" Width="550" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" AllowsTransparency ="True"
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" BorderThickness="1" BorderBrush="#A0A0A0">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Button}" x:Key="XBondButton">
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray13}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue10}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"   
                            CornerRadius="2, 2, 0, 0"/>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                       Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Blue8}"/>
                                    <!--<Setter Property="BorderBrush" TargetName="background" Value="{DynamicResource {x:Static SystemColors.HighlightBrush}}"/>-->
                                </Trigger>
                                <!--<Trigger Property="IsMouseOver" Value="false">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Transparent}"/>
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Blue8}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="BorderThickness" TargetName="background" Value="0"/>
                                    <Setter Property="BorderBrush" TargetName="background" Value="{StaticResource ColorBrush.Gray13}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="listBoxItemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding SendPriceItem.DefaultItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="radBase" TargetType="RadioButton">
                <Setter Property="IsChecked" Value="{Binding Path=IsSelected,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="outElli" Width="16" Height="16" Grid.Column="0" Fill="{StaticResource ColorBrush.Gray15}"></Ellipse>
                                <Ellipse x:Name="middleElli" Width="10" Height="10" Grid.Column="0" Fill="{StaticResource ColorBrush.Gray13}"></Ellipse>
                                <Ellipse x:Name="innerElli" Width="8" Height="8" Grid.Column="0" Fill="{StaticResource ColorBrush.Gray13}"></Ellipse>

                                <TextBlock  Grid.Column="1" Text="{TemplateBinding Content}" Padding="2, 3, 0, 0"></TextBlock>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter TargetName="outElli" Property="Fill" Value="{StaticResource ColorBrush.Green}"/>
                                    <Setter TargetName="middleElli" Property="Fill" Value="{StaticResource ColorBrush.Gray13}"/>
                                    <Setter TargetName="innerElli" Property="Fill" Value="{StaticResource ColorBrush.Green}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="16"/>
                <!--<Setter Property="Width" Value="80"/>
                <Setter Property="Height" Value="24"/>-->
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <!--<Setter Property="IsEnabled" Value="{Binding SendPriceItem.DirectionItemEnable}"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">

                            <RadioButton Content="{TemplateBinding Content}" FontSize="{StaticResource BigContentFontSize}" Background="{StaticResource ColorBrush.Transparent}" 
                              Foreground="{StaticResource ColorBrush.While}" Margin="10, 5, 0, 0" Style="{StaticResource radBase}"></RadioButton>
                                
                                <!--<CheckBox VerticalAlignment="Center" Margin="0, 3, 0, 0" BorderThickness="2" 
                              BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"  Content="{TemplateBinding Content}"
                              FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" 
                              Foreground="{StaticResource ColorBrush.While}"></CheckBox>-->
                            
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="XBondButtong" TargetType="{x:Type Button}">
                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"  Background="{TemplateBinding Background}"    
                            CornerRadius="1">

                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                </Border>
            </ControlTemplate>


            <Style x:Key="BidRadioStyle" TargetType="RadioButton">
                <Setter Property="Margin" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">

                            <Border x:Name="_borderChecked" CornerRadius="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <Border.Background>
                                    <ImageBrush ImageSource="../Images/stc_button_nonfirm_disable.png"/>
                                </Border.Background>
                            </Border>
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="_borderChecked">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_button_nonfirm_normal.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" TargetName="_borderChecked">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_button_nonfirm_disable.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CheckBoxThemeColor" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="_borderOne" CornerRadius="5" Background="#3C3C3C" Width="12" Height="12" Margin="{TemplateBinding Margin}">
                                    <Border x:Name="_borderTwo" CornerRadius="4" Background="#3C3C3C" Width="8" Height="8" Margin="{TemplateBinding Margin}">
                                        <Border x:Name="_borderThree" CornerRadius="3" Background="#141414" Width="6" Height="6" Margin="{TemplateBinding Margin}">

                                        </Border>
                                    </Border>
                                </Border>
                                <ContentPresenter Grid.Column="1" x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" TargetName="_borderOne" Value="#E63034"/>
                                    <Setter Property="Background" TargetName="_borderTwo" Value="#141414"/>
                                    <Setter Property="Background" TargetName="_borderThree" Value="#E63034"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Background" TargetName="_borderOne" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="_borderTwo" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="_borderThree" Value="#141414"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
            
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>



    <Grid Background="{StaticResource ColorBrush.Gray13}">
        <Grid.RowDefinitions>
            <RowDefinition Height="33"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="45"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ColorBrush.Gray18}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="点价" Width="48" Margin="20, 8, 0, 0" FontWeight="Bold" 
                       Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource BigContentFontSize}"/>
            <Button Width="16" Height="16" Grid.Column="2" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
        </Grid>

        <Grid Grid.Row="1" Margin="10, 10, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="报价" Grid.Column="0" Width="40" Margin="30, 20, 0, 0" FontWeight="Bold" 
                       Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource BigContentFontSize}"/>

            <TextBlock Text="{Binding PointPriceInfo}" Grid.Column="1" Margin="10, 20, 0, 0" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource ColorBrush.Orange7}" FontSize="{StaticResource BigContentFontSize}" HorizontalAlignment="Left">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </Grid>

        <TextBlock Text="含有多个清算速度，请选择：" Grid.Row="2" Margin="45, 4, 0, 0" FontWeight="Bold" 
                       Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource BigContentFontSize}" HorizontalAlignment="Left"/>

        <ListBox x:Name="lbSettle" Grid.Row="3" Grid.Column="0" SelectionMode="Single" Margin="50, 10, 0, 0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="{Binding SpotSettleBoxVisibility}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" SelectedItem="SelectListBoxIndex"
                         Background="Transparent" MinWidth="130"
                         BorderThickness="0"
                         FontSize="12"          SelectedIndex="{Binding SelectListBoxIndex, Mode=TwoWay}"    
                         VerticalAlignment="Top" HorizontalAlignment="Left"
                         BorderBrush="Transparent" ItemsSource="{Binding SettleItems}" ItemContainerStyle="{StaticResource itemContainStyle}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!--<ListBox.ItemTemplate>
                <DataTemplate>
                    <ListBoxItem Width="60" Height="24"  FontSize="12"></ListBoxItem>
                </DataTemplate>
            </ListBox.ItemTemplate>-->
            <!--<ListBoxItem IsEnabled="False" Width="60" Height="24"  Content="T+0" Style="{StaticResource ListBoxItemStyle}"/>
            <ListBoxItem IsEnabled="False" Width="60" Height="24" Content="T+1" Style="{StaticResource ListBoxItemStyle}"/>
            <ListBoxItem IsEnabled="False" Width="60" Height="24" Content="远期" Style="{StaticResource ListBoxItemStyle}"/>-->
        </ListBox>

        <Border Grid.Row="4" BorderBrush="{StaticResource ColorBrush.Gray15}" BorderThickness="0, 2, 0, 0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>


                <Button Grid.Column="1" Content="取消" Visibility="Collapsed" Command="{Binding CancelCommand}" FontSize="12" Background="#3C3C3C" Foreground="#FFFFFF" 
                            Style="{StaticResource SmallCancelBtnStyle}" Width="60" Height="22" HorizontalAlignment="Left" Margin="10, 0, 0, 0"/>
                <Button Grid.Column="0" Grid.ColumnSpan="2" Content="确认" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding OkCommand}" FontSize="16"
                            Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}" Width="180" Height="40" HorizontalAlignment="Center"  Margin="0, 0, 10, 0"/>
            </Grid>
            
        </Border>
    </Grid>
</Window>
