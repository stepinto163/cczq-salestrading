                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedInactive.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedActive.Background}"/>
