<Window x:Class="STC.XBond.Plugin.View.Order.SendPointPriceViewLite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:FrameCustomUI="clr-namespace:STC.Frame.CustomUI;assembly=STC.Frame"
        mc:Ignorable="d"
        Title="提交意向" Height="304" Width="396" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" BorderThickness="0" Background="Transparent" ContentRendered="Window_ContentRendered" Initialized="Window_Initialized" KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated" Activated="Window_Activated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="ButtonSendPriceBrush" StartPoint="0.6,0" EndPoint="0.6,1">
                <GradientStop Color="#E63034" Offset="0"/>
                <GradientStop Color="#971F21" Offset="1"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="TextBlockForGround" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>

            <SolidColorBrush x:Key="SelectItemBorderBrush" Color="#FFF9C152"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectItemBackground" Color="#FF9300"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectItemForeground" Color="#000000"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBorder" Color="#136C5E"></SolidColorBrush>
            <SolidColorBrush x:Key="PriceDefaultComboBackground" Color="#193D37"></SolidColorBrush>


            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Background" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.MouseOver.Border" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Foreground" Color="#FFEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedInactive.Border" Color="#193D37"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Foreground" Color="#FEEBC8"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Background" Color="#136C5E"/>
            <SolidColorBrush x:Key="ListBoxItem.SelectedActive.Border" Color="#00D198"/>
            <SolidColorBrush x:Key="ListBoxItem.Normal.Border" Color="#193D37"/>

            <ControlTemplate x:Key="AmountTextBox" TargetType="{x:Type TextBox}">
                <Border x:Name="Border"
                        Background="#FF7D00"
                        BorderBrush="#FF9200"
                        CornerRadius="2"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      Grid.Column="0"
                                      BorderThickness="0"
                                      VerticalAlignment="Stretch"
                                      x:Name="PART_ContentHost" />
                        <TextBlock Margin="0, 0, 3, 0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                                Width="10"
                                Height="{TemplateBinding Height}"
                                Text="万"/>

                    </Grid>
                </Border>
            </ControlTemplate>

            <ControlTemplate x:Key="PriceTextBox"
                             TargetType="{x:Type TextBox}">
                <Border x:Name="Border"
                        Background="#FF7D00"
                        BorderBrush="#FF9200"
                        CornerRadius="2"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      Grid.Column="0"
                                      BorderThickness="0"
                                      VerticalAlignment="Stretch"
                                      x:Name="PART_ContentHost" />
                        <TextBlock Margin="0, 0, 3, 0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                                Width="10"
                                Height="{TemplateBinding Height}"
                                Text="%"/>

                    </Grid>
                </Border>
            </ControlTemplate>

            <Style TargetType="{x:Type Button}" x:Key="BidButton">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Orange5}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"   Background="{TemplateBinding Background}"   
                            CornerRadius="2, 2, 0, 0"/>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="background" Value="{StaticResource ColorBrush.Orange6}"/>
                                </Trigger>
                                <!--<Trigger Property="IsMouseOver" Value="false">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Transparent}"/>
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Orange6}"/>
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Orange6}"/>
                                </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="OfrButton">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Blue8}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"   Background="{TemplateBinding Background}"   
                            CornerRadius="2, 2, 0, 0"/>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                       Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="background" Value="{StaticResource ColorBrush.Blue9}"/>
                                </Trigger>
                                <!--<Trigger Property="IsMouseOver" Value="false">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Transparent}"/>
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Blue9}"/>
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Blue9}"/>
                                </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="XBondButton">
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray13}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue10}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"   
                            CornerRadius="2, 2, 0, 0"/>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                       Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Blue8}"/>
                                    <!--<Setter Property="BorderBrush" TargetName="background" Value="{DynamicResource {x:Static SystemColors.HighlightBrush}}"/>-->
                                </Trigger>
                                <!--<Trigger Property="IsMouseOver" Value="false">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Transparent}"/>
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Foreground" TargetName="background" Value="{StaticResource ColorBrush.Blue8}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="BorderThickness" TargetName="background" Value="0"/>
                                    <Setter Property="BorderBrush" TargetName="background" Value="{StaticResource ColorBrush.Gray13}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DropShadowEffect x:Key="BidEffect" Color="#FF7D00" ShadowDepth="3" Direction="90" BlurRadius="5" RenderingBias="Quality"/>
            <DropShadowEffect x:Key="OfrEffect" Color="#009AFF" ShadowDepth="3" Direction="90" BlurRadius="5" RenderingBias="Quality"/>

            <SolidColorBrush x:Key="MainFormBackground" Color="#0A0F0E"/>
            <SolidColorBrush x:Key="LostFocusBorderBrush" Color="#282828"/>
            <SolidColorBrush x:Key="GetFocusBorderBrush" Color="#8F9598"/>
            
            <LinearGradientBrush x:Key="BidLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#40FF7D00" Offset="0"/>
                <GradientStop Color="#00FF7D00" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="OfrLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#40009AFF" Offset="0"/>
                <GradientStop Color="#00009AFF" Offset="1"/>
            </LinearGradientBrush>
           
            <Style x:Key="listBoxItemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding SendPriceItem.DefaultItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding SendPriceItem.DirectionItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                <Setter Property="FontSize" Value="12"/>
                <!--<Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>-->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--渠道样式-->
            <Style x:Key="TempSourceTraderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Title.Foreground}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="24"></Setter>
                <Setter Property="Padding" Value="0,4,0,0"></Setter>
                <Setter Property="TextBlock.TextAlignment" Value="Center"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent" >
                                <Border.Background>
                                    <ImageBrush ImageSource="../Images/stc_button_dropdownarrow_normal.png"/>
                                </Border.Background>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>-->
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="Button" x:Key="DatePickBtnStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back"  BorderThickness="0" BorderBrush="Transparent" >
                                <Border.Background>
                                    <ImageBrush ImageSource="../Images/stc_button_dropdownarrow_normal.png"/>
                                </Border.Background>
                                <!--<TextBlock Text="∨" Foreground="#FFF1DA" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center"/>-->
                                <!--∧-->
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray14}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!--数量和增加减少-->
            <Style TargetType="{x:Type Button}" x:Key="AddAmountButtonStyle">
                <Setter Property="Background" Value="{StaticResource MainFormBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MainFormBackground}"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="2,2,0,0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="out_border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="out_border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="DecreaseAmountButtonStyle">
                <Setter Property="Background" Value="{StaticResource MainFormBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MainFormBackground}"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="0,0,2,2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="out_border" Value="{StaticResource TextBox.Disable.Background}"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="out_border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="SettleBoxButtonStyle">
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"   Background="{TemplateBinding Background}"   
                            CornerRadius="2">
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Gray14}">
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background" Value="{StaticResource ColorBrush.Gray14}">
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="Control.Background" TargetName="background" Value="{Binding SendPriceItem.BorderBH}">
                                    </Setter>
                                    <Setter Property="Foreground" Value="#000000">
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--报价或需求-->
            <Style x:Key="SendPriceButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
