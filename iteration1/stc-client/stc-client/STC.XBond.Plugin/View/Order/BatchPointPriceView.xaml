<Window x:Class="STC.XBond.Plugin.View.Order.BatchPointPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
         xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Order"
        xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component"
             mc:Ignorable="d"  Background="#0A0F0E"
             d:DesignHeight="470" d:DesignWidth="462" Height="470" Width="462"  WindowState="Normal"  WindowStartupLocation="CenterScreen" ResizeMode="NoResize" 
        AllowsTransparency ="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"
         WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="BidLinearGradientBrush" StartPoint="0.6,0" EndPoint="0.6,1">
                <GradientStop Color="#60FF7D00" Offset="0"/>
                <GradientStop Color="#00FF7D00" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="OfrLinearGradientBrush" StartPoint="0.6,0" EndPoint="0.6,1">
                <GradientStop Color="#60009AFF" Offset="0"/>
                <GradientStop Color="#00009AFF" Offset="1"/>
            </LinearGradientBrush>


            <Style x:Key="CustomePriceTextBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{StaticResource ColorBrush.Black-11}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSize-24}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.Roboto}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"></ColumnDefinition>
                                        <ColumnDefinition Width="24"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="24"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding BatchPointPriceDomain.Side}" VerticalAlignment="Bottom" FontFamily="{StaticResource IDCFontFamily.YaHei}" Margin="8, 0, 0, 8" 
                                               Foreground="{Binding BatchPointPriceDomain.SideBrush}" FontSize="{StaticResource FontSize-14}"></TextBlock>

                                    <Component:AlertSign Grid.Column="1" VerticalAlignment="Center" Width="24" Height="24" Visibility="{Binding BatchPointPriceDomain.WarnImageVisibility}" ToolTipText="{Binding BatchPointPriceDomain.WarnImageTooltip}"/>

                                    <ScrollViewer x:Name="PART_ContentHost" Foreground="{StaticResource ColorBrush.While}" Grid.Column="2" Focusable="false" HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" FontSize="{StaticResource FontSize-24}"/>
                                    <TextBlock Grid.Column="3" Text="%" Width="16" VerticalAlignment="Bottom" Margin="0, 0, 8, 8" Foreground="{StaticResource ColorBrush.PaleGrey}" FontSize="{StaticResource FontSize-12}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--<Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                    <Setter TargetName="border" Property="Background" Value="#515151"/>
                                </Trigger>-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding BatchPointPriceDomain.BoxBgBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BatchPointPriceDomain.BoxBorderBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding BatchPointPriceDomain.BoxBgBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BatchPointPriceDomain.BoxBorderBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="CustomeAmountTextBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{StaticResource ColorBrush.Black-11}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSize-24}"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamily.Roboto}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="32"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="0" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    <TextBlock Grid.Column="1" Text="KW" Width="24" VerticalAlignment="Bottom" Margin="0, 0, 8, 8" FontSize="{StaticResource FontSize-12}" Foreground="{StaticResource ColorBrush.PaleGrey}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                    <Setter TargetName="border" Property="Background" Value="#515151"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding BatchPointPriceDomain.BoxBgBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BatchPointPriceDomain.BoxBorderBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding BatchPointPriceDomain.BoxBgBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding BatchPointPriceDomain.BoxBorderBrush}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            
            
            <!--清算速度 +1 按钮 新弹出式 下拉按钮 -->
            <Style TargetType="ToggleButton" x:Key="SelfFilterComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="splitBorder" Height="24" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0" HorizontalAlignment="Center"  BorderThickness="0" BorderBrush="Transparent">
                                <!--TextBlock x:Name="arrow" Text="v" Foreground="#788187" Background="Transparent" Padding="6, 3, 0, 0" FontFamily="Calibri" FontSize="14"/-->
                                <Path  x:Name="arrow" Data="M 6,10 L 10,15 L 14,10" SnapsToDevicePixels="False"  Stroke="#788187" StrokeThickness="1"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="arrow" Property="Stroke" Value="#FFEBC8"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </Style>

            <!--清算速度 +1 按钮 新弹出式 Combox -->
            <Style TargetType="ComboBox" x:Key="SelfFilterComboxStyle">
                <Setter Property="Height" Value="24"></Setter>
                <Setter Property="Text" Value="默认"></Setter>
                <Setter Property="IsEditable" Value="False"></Setter>
                <Setter Property="IsReadOnly" Value="True"></Setter>
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="IsDropDownOpen" Value="False"></Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <!--ComBoxItem-->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinHeight" Value="24"></Setter>
                            <Setter Property="MinWidth" Value="56"></Setter>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="popBack" BorderBrush="#193D37" Background="#193D37" BorderThickness="0,0,0,1" CornerRadius="0">
                                            <Canvas>
                                                <ContentPresenter Canvas.Right="20" Canvas.Top="4"  ContentSource="{Binding Source}" ></ContentPresenter>
                                            </Canvas>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="popBack" Property="Background" Value="#136C5E"></Setter>
                                                <Setter TargetName="popBack" Property="BorderBrush" Value="#2CAB97"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Name="Back"  BorderBrush="#136C5E"  Background="{TemplateBinding Background}" BorderThickness="0,1,0,0" CornerRadius="2">
                                    <Border Name="InerBack"  BorderBrush="#193D37"  Background="Transparent" BorderThickness="0,0,0,1"  CornerRadius="2">
                                        <Canvas>
                                            <TextBox x:Name="bdTextBox"  Canvas.Right="18"   Canvas.Top="4"  BorderThickness="0"  Background="Transparent" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="12">
                                            </TextBox>
                                            <ToggleButton x:Name="tbArrow" Canvas.Right="1"  Canvas.Bottom="0"  Canvas.Top="0" Style="{StaticResource SelfFilterComboxStyleBtn}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"></ToggleButton>
                                        </Canvas>
                                    </Border>
                                </Border>
                                <Border>
                                    <TextBlock x:Name="bdTextBlock" MouseDown ="bdSetleBox_MouseDown"></TextBlock>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup" Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="0,2,0,2" BorderThickness="0,0,0,0" Background="#172422" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="{StaticResource TextBox.Static.Background}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsDropDownOpen" Value="False"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#2CAB97"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="2"></Setter>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="1"/>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#136C5E"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#136C5E"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#2CAB97"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="1"/>
                                        <Condition Property="IsDropDownOpen" Value="True"/>
                                        <Condition SourceName="Popup" Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#193D37"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="0"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="#193D37"></Setter>
                                    <Setter TargetName="Back" Property="Background" Value="#172422"></Setter>
                                    <Setter TargetName="InerBack" Property="BorderBrush" Value="#172422"></Setter>
                                    <Setter TargetName="InerBack" Property="CornerRadius" Value="0"></Setter>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="PriceComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="splitBorder" Height="24" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0" HorizontalAlignment="Center"  BorderThickness="0" BorderBrush="Transparent">
                                <!--TextBlock x:Name="arrow" Text="v" Foreground="#788187" Background="Transparent" Padding="6, 3, 0, 0" FontFamily="Calibri" FontSize="14"/-->
                                <Path  x:Name="arrow" Data="M 6,10 L 10,15 L 14,10" SnapsToDevicePixels="False"  Stroke="#788187" StrokeThickness="1"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="arrow" Property="Stroke" Value="#FFEBC8"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="IsSelected" Value="{Binding Checked}"/>
                <Setter Property="Visibility" Value="{Binding ItemVisibility}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.BlackishGreen}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="1"
                                    BorderThickness="0, 1, 0, 0" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Green3}"></Setter>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ColorBrush.Green-19}"></Setter>
                                </Trigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="false"></Condition>
                                        <Condition Property="IsEnabled" Value="true"></Condition>
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.BlackishGreen}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ColorBrush.Green3}"/>

                                </MultiTrigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>


    <Border BorderThickness="2" x:Name="Border_Left1" Grid.Row="0"  CornerRadius="4" BorderBrush="{Binding BatchPointPriceDomain.BorderBrush}"  >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="53"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"></ColumnDefinition>
                    <ColumnDefinition Width="35"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="19"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="7, 5, 0, 0" Height="24" Width="72" Text="批量提交意向" Foreground="#FFFFFF" FontSize="{StaticResource SmallContentFontSize}"/>
                <TextBlock Grid.Column="1" Margin="4, 5, 0, 0" Height="24" Text="{Binding BatchPointPriceDomain.Side}" Foreground="{Binding BatchPointPriceDomain.SideBrush}"
                           FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                           FontWeight="Black"  FontSize="14"></TextBlock>
                <TextBlock Grid.Column="2" Margin="4, 5, 0, 0" Text="{Binding BatchPointPriceDomain.SecurityId}" Foreground="#F9C152" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontWeight="SemiBold" FontSize="14"></TextBlock>
                <TextBlock Grid.Column="3" Margin="4, 5, 0, 0" Text="{Binding BatchPointPriceDomain.SymbolName}" Foreground="#F9C152" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontWeight="SemiBold" LineHeight="24" FontSize="14"></TextBlock>
                <Button  Grid.Column="5" Width="16" Height="16" Margin="0, 2, 3, 0" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
            </Grid>

            <Border Grid.Row="1" Background="{Binding BatchPointPriceDomain.BgBrush}">


                <Grid Grid.Row="1" Margin="10, 0, 10, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"></RowDefinition>
                        <RowDefinition Height="50"></RowDefinition>
                        <RowDefinition Height="32"></RowDefinition>
                        <RowDefinition Height="26"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"></ColumnDefinition>
                            <ColumnDefinition Width="Auto" MinWidth="50"></ColumnDefinition>
                            <ColumnDefinition Width="5"></ColumnDefinition>
                            <ColumnDefinition Width="Auto" MinWidth="50"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="55"></ColumnDefinition>
                            <ColumnDefinition Width="49"></ColumnDefinition>
                            <ColumnDefinition Width="49"></ColumnDefinition>
                            <ColumnDefinition Width="36"></ColumnDefinition>
                            <ColumnDefinition Width="61"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="市场最优:" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="{StaticResource ColorBrush.Gray-22}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding SendPriceItem.BestBid}" Foreground="{StaticResource ColorBrush.Orange7}" FontFamily="{StaticResource FontFamily.Roboto}"
                                   Margin="0, 2, 0, 0" FontSize="{StaticResource FontSize-14}" TextAlignment="Left" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="|" Foreground="{StaticResource ColorBrush.Gray-22}"  FontSize="12" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding SendPriceItem.BestOfr}" Foreground="{StaticResource ColorBrush.Blue10}" FontFamily="{StaticResource FontFamily.Roboto}"  
                                   Margin="0, 2, 0, 0"  FontSize="{StaticResource FontSize-14}" TextAlignment="Right" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <ListBox Grid.Column="5" Grid.ColumnSpan="4" SelectionMode="Single" Margin="0, 2, 0, 0" 
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     Height="22"
                                     Background="Transparent" MinWidth="175"
                                     BorderThickness="0"
                                     FontSize="12"  SelectedIndex="{Binding BatchPointPriceDomain.ListBoxSelectIndex, Mode=TwoWay}"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     BorderBrush="Transparent" SelectionChanged="ListBox_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Width="47" Height="20" Content="2" Style="{DynamicResource BtnAmountListBoxItemStyle}" FontStyle="Italic" FontWeight="Normal" Background="{StaticResource ColorBrush.Black-11}"/>
                            <ListBoxItem Width="47" Margin="2, 0, 0, 0"  Height="20" Content="3" Style="{DynamicResource BtnAmountListBoxItemStyle}" FontStyle="Italic" FontWeight="Normal" Background="{StaticResource ColorBrush.Black-11}"/>
                            <ListBoxItem Width="47" Margin="2, 0, 0, 0"  Height="20" Content="5" Style="{DynamicResource BtnAmountListBoxItemStyle}" FontStyle="Italic" FontWeight="Normal" Background="{StaticResource ColorBrush.Black-11}"/>
                            <ListBoxItem Width="34" Margin="2, 0, 0, 0"  Height="20" Content="ALL" Style="{DynamicResource BtnAmountListBoxItemStyle}" FontStyle="Italic" FontWeight="Normal" Background="{StaticResource ColorBrush.Black-11}"/>
                        </ListBox>

                        <TextBlock Grid.Column="9" Text="等待时长:" HorizontalAlignment="Right" Width="51" FontFamily="{StaticResource IDCFontFamily.YaHei}" VerticalAlignment="Center"  Foreground="{StaticResource ColorBrush.Gray-22}" FontSize="12" />

                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"></ColumnDefinition>
                            <ColumnDefinition Width="10"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding BatchPointPriceDomain.Price}" IsEnabled="{Binding BatchPointPriceDomain.PriceEnable}" Height="48"  Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource CustomePriceTextBox}" Padding="0, 5, 10, 0"
                             PreviewTextInput="TextBox_PreviewTextInput" input:InputMethod.IsInputMethodEnabled="False" ContextMenu="{x:Null}" HorizontalContentAlignment="Right"></TextBox>

                        <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2">

                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144"></ColumnDefinition>
                                <ColumnDefinition Width="36"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Left" x:Name="AmountTxt" Width="144" Height="48" input:InputMethod.IsInputMethodEnabled="False"
                                 PreviewTextInput="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown"  ContextMenu="{x:Null}"
                                 BorderBrush="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"  Text="{Binding BatchPointPriceDomain.Qty}" Padding="10,4,0,0"
                                 Tag="{Binding OfrOrBid, Mode=TwoWay}" Style="{StaticResource CustomeAmountTextBox}" FontWeight="DemiBold" FontSize="24" HorizontalContentAlignment="Center" TextChanged="AmountTxt_TextChanged"/>

                            <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="2, 0, 0, 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Button x:Name="btnAddAmout" Padding="0,0,0,0" Grid.Row="0" TabIndex="-1" Width="34" Height="23" Content="+" Command="{Binding AddAmountCommand}" Style="{StaticResource AddAmountButtonStyle}" FontSize="14"/>
                                <Button x:Name="btnReduceAmout" Padding="0,0,0,0"  Grid.Row="1" TabIndex="-1" Width="34" Height="23" Content="－" Command="{Binding DownAmountCommand}" Style="{StaticResource AddAmountButtonStyle}" FontSize="14" />
                            </Grid>

                            <Component:NumericUpDown x:Name="numUpDown" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"  NumericValue="{Binding BatchPointPriceDomain.IocOutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LockTimeOutCheck, Mode=TwoWay}"  PreviewKeyDown="TextBox_PreviewKeyDown"  ContextMenu="{x:Null}" 
                                                      TextContentAlignment="Center" DecimalLength="0" Width="56" Height="48" RangeValue="5"  MaxValue="300" MinValue="1"  ToolTip="输入范围:1-300秒" UpDownBackground="{DynamicResource GreenBlueWatermarkTextBox.Normal.Border}" UpDownBorderBrush="{DynamicResource GreenBlueWatermarkTextBox.Normal.Border}" UpMargin="0,1,1,0"  DownMargin="0,0,1,1"
                                                      Margin="10,0,0,0" ValueChanged="NumericUpDown_ValueChanged"></Component:NumericUpDown>

                        </Grid>


                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock Grid.Column="0" Text="清算速度:*Ctrl 可复选" Margin="0,0,0,0" HorizontalAlignment="Left" Width="51" VerticalAlignment="Center"  Foreground="{StaticResource ColorBrush.Gray14}" FontSize="12" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <WrapPanel Orientation="Horizontal">
                            <ComboBox x:Name="SettlTypeCombox"  Width="60"  Text="{Binding BatchPointPriceDomain.SettleTxt}"  Margin="0, 0, 2, 2"  Height="24" Padding="4, 3, 0, 0" 
                                Style="{DynamicResource SelfFilterComboxStyle}" SelectedIndex="{Binding BatchPointPriceDomain.SettleSelectIndex, Mode=TwoWay}" >
                                <ComboBoxItem Content="+1" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                                <ComboBoxItem Content="今+1" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                                <ComboBoxItem Content="明+0" FontFamily="MicroSoft YaHei" FontWeight="Bold"></ComboBoxItem>
                            </ComboBox>

                            <ListBox x:Name="LstSettleBox" ItemsSource="{Binding BatchPointPriceDomain.SettleSource}" ItemContainerStyle="{StaticResource itemContainStyle}"
                            FontSize="12"  SelectedIndex="{Binding SettleBoxIndex, Mode=TwoWay}" SelectionChanged="LstSettleBox_SelectionChanged">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="{x:Type ListBox}">
                                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                            <WrapPanel Orientation="Horizontal" IsItemsHost="True">
                                            </WrapPanel>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </WrapPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="47*"/>
                            <ColumnDefinition Width="391*"/>
                        </Grid.ColumnDefinitions>
                        <local:PriceTableView x:Name="priceTableView" Grid.ColumnSpan="2" Margin="0, 8, 0, 0"></local:PriceTableView>
                    </Grid>


                </Grid>

            </Border>

            <Border Grid.Row="2" BorderThickness="0, 1, 0, 0" BorderBrush="{StaticResource ColorBrush.Gray15}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="16"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="62"></ColumnDefinition>
                        <ColumnDefinition Width="110"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Margin="16, 0, 2, 0" Text="{Binding BatchPointPriceDomain.ClickQty}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource FontFamily.Roboto}" FontSize="{StaticResource FontSize-24}"
                               Foreground="{Binding BatchPointPriceDomain.SideBrush}"></TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding BatchPointPriceDomain.MatchTotalQty}" Margin="0, 0, 5, 0" FontFamily="{StaticResource FontFamily.Roboto}" FontSize="{StaticResource FontSize-18}" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                    <TextBlock Grid.Column="2" Text="kw" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{StaticResource FontSize-12}" FontFamily="{StaticResource FontFamily.Roboto}"
                               Foreground="{StaticResource ColorBrush.Gray14}"></TextBlock>

                    <Button Grid.Column="4"  Margin="0,0,2,0" Content="取消" Command="{Binding CloseCommand}" FontSize="12"
                        Style="{StaticResource CancelPriceButton}" Width="60" Height="24" HorizontalAlignment="Right"/>
                    <Button Grid.Column="5" Margin="2,0,0,0" Content="{Binding BatchPointPriceDomain.SendPriceTxt}"  Command="{Binding OkCommand}" FontSize="12" HorizontalAlignment="Left"
                        Style="{StaticResource SendPriceButton}" Width="100" Height="24" />

                </Grid>
            </Border>

        </Grid>
    </Border>

</Window>
