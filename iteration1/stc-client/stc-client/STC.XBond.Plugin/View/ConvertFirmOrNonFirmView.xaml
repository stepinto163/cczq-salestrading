<comp:WindowBase x:Class="STC.XBond.Plugin.View.ConvertFirmOrNonFirmView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.XBond.Plugin.View"
        xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="ConvertFirmOrNonFirmView" MinWidth="478" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        Closed="WindowBase_Closed" Closing="WindowBase_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="ImageCheckBoxStyle" TargetType="{x:Type CheckBox}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="bg" Background="{DynamicResource GreenBlueCheckBox.Static.Border}" Height="24" Width="24" CornerRadius="3"/>
                                <Border Grid.Column="0" x:Name="_borderChecked" CornerRadius="1" Height="24" Width="24">
                                    <Border.Background>
                                        <ImageBrush ImageSource="../Images/stc_button_nonfirm_normal.png"/>
                                    </Border.Background>
                                </Border>
                                
                                <ContentPresenter Grid.Column="1" x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter Property="Background" TargetName="bg" Value="{DynamicResource GreenBlueCheckBox.Static.Border}"/>
                                    <Setter Property="Background" TargetName="_borderChecked">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_button_nonfirm_normal.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="false">
                                    <Setter Property="Background" TargetName="bg" Value="Transparent"/>
                                    <Setter Property="Background" TargetName="_borderChecked">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_button_nonfirm_disable.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
        <!--提示信息-->
        <Border Height="30" BorderThickness="0,1,0,1" BorderBrush="#323232" >
            <TextBlock Text="{Binding SelectedCount, StringFormat={}请确认{0}笔批量报价信息}" VerticalAlignment="Center" Margin="10,0,10,0" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
        </Border>

        <!--转Nonfirm时显示-->
        <Border x:Name="ToNonfirm_Part" Grid.Row="1"  Height="30" BorderThickness="0,1,0,1" BorderBrush="#323232" >
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="30"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="firmFlagChk" Width="70" Height="24" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" Margin="10,0,0,0" Style="{DynamicResource ImageCheckBoxStyle}" TextBlock.TextAlignment="Left" IsEnabled="False" IsChecked="{Binding FirmChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                               Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></CheckBox>
                <Grid Grid.Column="1" Visibility="{Binding IsToFirm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>


                    <CheckBox IsChecked="{Binding IsCheckedFirmTimeLimit, Mode=TwoWay}" VerticalAlignment="Center" Margin="5, 3, 0, 0" Grid.Column="0" BorderThickness="2" BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="20"   FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource CommonCheckBoxStyle}" Background="{DynamicResource ColorBrush.Transparent}" Foreground="{DynamicResource ColorBrush.While}"></CheckBox>

                    <Border Grid.Column="1" Height="24" CornerRadius="1" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray19}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="22"></ColumnDefinition>
                                <ColumnDefinition Width="20"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{DynamicResource DefaultTextBoxStyle}" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput"
                                     IsEnabled="{Binding FirmGridEnable}" Text="{Binding NonfirmTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ColorBrush.Black9}"></TextBox>
                            <Button Width="20" IsEnabled="{Binding DownEnable}" Height="20" Margin="1, 1, 0, 1" Background="{DynamicResource ColorBrush.Gray15}" Foreground="{DynamicResource ColorBrush.While}" Content="-" Command="{Binding DownCommand}" Style="{DynamicResource AddButton}" Grid.Column="1"/>
                            <Button Width="20" IsEnabled="{Binding AddEnable}" Height="20" Margin="0, 1, 1, 1" Background="{DynamicResource ColorBrush.Gray15}" Foreground="{DynamicResource ColorBrush.While}" Content="+" Command="{Binding AddCommand}" Style="{DynamicResource AddButton}" Grid.Column="2"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="后转为nonfirm" Grid.Column="2" TextAlignment="Center" Padding="0, 9, 0, 0"  Foreground="{DynamicResource ColorBrush.Gray15}" FontSize="12"/>
                </Grid>
            </Grid>
        </Border>
        
        <!-- 设置部分-->
        <Grid Grid.Row="2" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!--利率债-->
            <Grid x:Name="Interest_Part" Visibility="{Binding IsShowInterestRateDebt}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" BorderThickness="0, 1, 0, 1" BorderBrush="{DynamicResource ColorBrush.Gray20}"></Border>
                <Border Grid.Column="0" Width="4" Margin="0,10,0,10" Background="{DynamicResource ColorBrush.Red7}" HorizontalAlignment="Right"></Border>
                <TextBlock Text="利率债" Width="20" Height="50" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                <!--<comp:ChannelCheckUI x:Name="InterestRateDebt" Grid.Column="2"/>-->
            </Grid>
           
            <!--信用债-->
            <Grid x:Name="Credit_Part" Grid.Row="1" Visibility="{Binding IsShowCreditDebt}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" BorderThickness="0, 1, 0, 1" BorderBrush="{DynamicResource ColorBrush.Gray20}"></Border>
                <TextBlock  Width="20" Height="50" Grid.Column="0" Text="信用债" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                <Border Grid.Column="0" Width="4" Margin="0,10,0,10" Background="{DynamicResource ColorBrush.Blue12}" HorizontalAlignment="Right"></Border>
                <!--<comp:ChannelCheckUI x:Name="CreditDebt" Grid.Column="2"/>-->
            </Grid>
           
        </Grid>

        <Border Height="45" Grid.Row="3" BorderThickness="0, 1, 0, 1" BorderBrush="{DynamicResource ColorBrush.Gray20}" Background="{DynamicResource ColorBrush.Gray13}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="120"></ColumnDefinition>
                    <ColumnDefinition Width="65"></ColumnDefinition>
                    <ColumnDefinition Width="125"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Foreground="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">已执行 <Run Foreground="#FFFFFF" Text="{Binding ExecutedCount}"/> 条</TextBlock>

                <TextBlock Grid.Column="1" Text="*请详细确认以上信息"  VerticalAlignment="Center" HorizontalAlignment="Left"  Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBlock>

                <Button Grid.Column="2" Content="取消" Command="{x:Static SystemCommands.CloseWindowCommand}" Width="60" Height="24" FontSize="12" Style="{DynamicResource SmallCancelBtnStyle}"/>
                <Button Grid.Column="3" Content="报价" IsEnabled="{Binding SendPriceEnable, Mode=TwoWay}" Command="{Binding OkCommand}" Width="100" Height="24" Margin="0, 0, 20, 0" FontSize="12" Style="{DynamicResource BlueGreenStyle}"/>
            </Grid>
        </Border>
    </Grid>
</comp:WindowBase>
