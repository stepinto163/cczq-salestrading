<UserControl x:Class="STC.XBond.Plugin.View.Component.ChannelCheckUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Component"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="135" d:DesignWidth="300" MinHeight="138" MinWidth="310">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CheckBoxThemeColor" TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="_borderOne" CornerRadius="5" Background="#3C3C3C" Width="12" Height="12" Margin="{TemplateBinding Margin}">
                                    <Border x:Name="_borderTwo" CornerRadius="4" Background="#3C3C3C" Width="8" Height="8" Margin="{TemplateBinding Margin}">
                                        <Border x:Name="_borderThree" CornerRadius="3" Background="#141414" Width="6" Height="6" Margin="{TemplateBinding Margin}">

                                        </Border>
                                    </Border>
                                </Border>
                                <ContentPresenter Grid.Column="1" x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" TargetName="_borderOne" Value="#136C5E"/>
                                    <Setter Property="Background" TargetName="_borderTwo" Value="#141414"/>
                                    <Setter Property="Background" TargetName="_borderThree" Value="#136C5E"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter Property="Background" TargetName="_borderOne" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="_borderTwo" Value="#3C3C3C"/>
                                    <Setter Property="Background" TargetName="_borderThree" Value="#141414"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="listBoxItemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="IsSelected" Value="{Binding Checked}"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding BgColor}"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                    <!--<Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>-->
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="IsSelected" Value="{Binding Checked}"/>
                <Setter Property="Visibility" Value="{Binding ItemVisibility}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding BgColor}"></Setter>
                                    <!--Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>-->
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border Grid.Row="3" BorderThickness="0, 1, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray20}" Background="{StaticResource ColorBrush.Gray13}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <!--<RowDefinition ></RowDefinition>
                    <RowDefinition Height="60"></RowDefinition>
                    <RowDefinition></RowDefinition>-->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition Width="60"></ColumnDefinition>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="撮合渠道：" Margin="10, 0, 0, 0"  VerticalAlignment="Center" HorizontalAlignment="Left"  Foreground="{StaticResource ColorBrush.While}" FontSize="12" />
                <CheckBox Visibility="{Binding CheckAllVisibility}" Style="{StaticResource CheckBoxThemeColor}" IsChecked="{Binding CheckAll, Mode=TwoWay}" Width="45" Grid.Column="1" Content="所有"   Foreground="{StaticResource ColorBrush.While}" FontSize="12"></CheckBox>

                <CheckBox Visibility="{Binding CheckInnerVisibility}" Style="{StaticResource CheckBoxThemeColor}" IsChecked="{Binding CheckInner, Mode=TwoWay}" Width="55" Grid.Column="2" Content="仅内部"   Foreground="{StaticResource ColorBrush.While}" FontSize="12"></CheckBox>

                <CheckBox Visibility="{Binding CheckXBondVisibility}" IsChecked="{Binding CheckXBond, Mode=TwoWay}" VerticalAlignment="Center" Margin="5, 3, 0, 0" Grid.Column="3" BorderThickness="2" 
                              BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"   Content="X-bond"
                              FontSize="{StaticResource SmallContentFontSize}" Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" 
                              Foreground="{StaticResource ColorBrush.While}"></CheckBox>

            </Grid>


            <Grid Grid.Row="1" Visibility="{Binding AllowanceChannelVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0" Text="余量发送渠道" Margin="10, 3, 0, 2" Height="15" HorizontalAlignment="Left" Grid.Column="0"  Foreground="{StaticResource ColorBrush.Gray14}" FontSize="10" />

                <Grid Grid.Row="1" Visibility="{Binding InnerDefaultVisibility}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="0"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="10, 0, 0, 0">
                        <CheckBox Style="{StaticResource CheckBoxThemeColor}" IsChecked="{Binding CheckNotOut, Mode=TwoWay}" Width="80"  Content="不发送外部"   
                          Foreground="{StaticResource ColorBrush.While}" FontSize="12" HorizontalAlignment="Left"></CheckBox>

                    </Border>


                    <Grid Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <CheckBox IsChecked="{Binding DefaultCheck, Mode=TwoWay}"  Grid.Row="0"  Width="50"
                              Grid.Column="0"   
                               Foreground="{StaticResource ColorBrush.While}" FontSize="12"
                              Style="{StaticResource CheckBoxThemeColor}" 
                               Content="默认" ></CheckBox>

                        <ListBox x:Name="lbFirstLevel" Grid.Row="0" Grid.Column="1" SelectionMode="Extended" Margin="0, 0, 0, 0" Grid.RowSpan="2" VerticalAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Height="55" 
                         Background="Transparent" 
                         BorderThickness="0" ItemsSource="{Binding DefaultFirstItems}"
                         FontSize="12" HorizontalAlignment="Left" SelectedItem=""
                         BorderBrush="Transparent" ItemContainerStyle="{StaticResource listBoxItemContainStyle}">

                            <!--<ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>-->
                            <!--<ListBoxItem Width="60" Height="24"  Content="X-bond" Style="{StaticResource ListBoxItemStyle}"/>-->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ListBoxItem Width="60" Height="24" FontSize="12" 
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{StaticResource ColorBrush.While}"></ListBoxItem>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <WrapPanel MaxWidth="180" Orientation="Horizontal" IsItemsHost="True"/>
                                </ControlTemplate>
                            </ListBox.Template>

                        </ListBox>

                        <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Width="1" Height="55" Stroke="{StaticResource ColorBrush.Gray15}" Margin="3, 0, 2, 3"/>

                        <ListBox x:Name="lbSecondLevel"  Grid.Column="3" SelectionMode="Extended" Margin="0, 0, 0, 0" Grid.RowSpan="2"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Height="55" 
                         Background="Transparent" ItemsSource="{Binding DefaultSecondItems}"
                         BorderThickness="0" 
                         FontSize="12"              
                         VerticalAlignment="Top" HorizontalAlignment="Left" 
                         BorderBrush="Transparent" ItemContainerStyle="{StaticResource listBoxItemContainStyle}">

                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ControlTemplate>
                            </ListBox.Template>

                            <!--<ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>-->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ListBoxItem Width="60" Height="24" FontSize="12" 
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{StaticResource ColorBrush.While}"></ListBoxItem>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" >
                            <TextBlock Text="以上随机" Width="48" VerticalAlignment="Center" Foreground="{StaticResource ColorBrush.Gray15}" FontSize="12"></TextBlock>
                            <TextBox Tag="4" IsEnabled="{Binding RandomEnable}" Text="{Binding RandomNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput"
                                 Width="40" Height="24" Margin="5, 0, 0, 0" Padding="0, 3, 0, 0" Template="{DynamicResource TextBoxControlTemplate1}"
                                 Foreground="{StaticResource ColorBrush.While}" Background="{StaticResource ColorBrush.Black8}">
                                <TextBox.Resources>
                                    <ControlTemplate x:Key="TextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                                        <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ColorBrush.Gray15}">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="false">
                                                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray15}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock Text="{Binding RandomTxt}" Margin="5, 0, 0, 0" Width="83" VerticalAlignment="Center"  Foreground="{StaticResource ColorBrush.Gray15}" FontSize="12"></TextBlock>
                        </StackPanel>
                    </Grid>

                </Grid>


                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"></ColumnDefinition>
                        <ColumnDefinition Width="29*"></ColumnDefinition>
                        <ColumnDefinition Width="107*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding DirectionCheck, Mode=TwoWay}"  Grid.Row="0"  Grid.Column="0"  Width="50"
                               Foreground="{StaticResource ColorBrush.While}" FontSize="12"
                              Style="{StaticResource CheckBoxThemeColor}" Command="{Binding AppointCommand}"
                             Content="指定"></CheckBox>

                    <ListBox x:Name="lbDirect"  Grid.Column="1" Grid.ColumnSpan="2" SelectionMode="Extended" ItemsSource="{Binding DirectionItems}" ItemContainerStyle="{StaticResource itemContainStyle}"
                             BorderBrush="Transparent" Background="Transparent" SelectionChanged="lbDirect_SelectionChanged">
                        <!--SelectedIndex="{Binding SendPriceItem.ChannelIndex}">-->

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ListBoxItem Width="60" Height="24"  FontSize="12"></ListBoxItem>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>

            </Grid>
        </Grid>

    </Border>

</UserControl>
