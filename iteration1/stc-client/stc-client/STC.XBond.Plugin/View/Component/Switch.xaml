<UserControl x:Class="STC.XBond.Plugin.View.Component.Switch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Component"
              mc:Ignorable="d" Height="10" Width="20" MinHeight="10" MaxHeight="20"
             d:DesignHeight="16" d:DesignWidth="32" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.XBond.Plugin;component/Resources/STC.SkinStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush  x:Key="Close.Background.ColorBrush">#3C3C3C</SolidColorBrush>
            <SolidColorBrush  x:Key="Open.Background.ColorBrush">#42B574</SolidColorBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VisualStateGroup">
                <VisualStateGroup.Transitions>
                    <VisualTransition From="VisualState" GeneratedDuration="0"/>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="VisualState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" Storyboard.TargetName="eClose">
                            <EasingDoubleKeyFrame KeyTime="0" Value="14"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="eClose">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0.4"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="checkBoxBorder" 
                                    SnapsToDevicePixels="True"                                     
                                    CornerRadius="5" 
                                    VerticalAlignment="Stretch"
                                    Background="{StaticResource Close.Background.ColorBrush}" 
                                    HorizontalAlignment="Stretch"                                     
                                    >

            <Grid x:Name="markGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="eClose"
                                            Width="8px"
                                            Height="8px"
                                            Stroke="#0F7272" 
                                            Margin="1,0,1,0"
                                            Fill="#FFFFFF"
                                            Grid.Column="0" 
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="eOpen"
                                            Visibility="Collapsed"
                                            Width="8px" 
                                            Height="8px"
                                            Stroke="#FFFFFF" 
                                            Fill="#FFFFFF"
                                            Margin="3,0,3,0"
                                            Grid.Column="2" 
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
