<UserControl x:Class="STC.XBond.Plugin.View.Setting.LikeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.XBond.Plugin.View.Setting"
             xmlns:Component="clr-namespace:STC.XBond.Plugin.View.Component"
             xmlns:comp ="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:fcon = "clr-namespace:STC.XBond.Plugin.Convertor"
             mc:Ignorable="d" 
             d:DesignHeight="710" d:DesignWidth="800" Margin="20, 10, 20, 0">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="TextBlockForeColor" Color="#FFFFFF"></SolidColorBrush>
            <SolidColorBrush x:Key="ButtonSelectedActiveBorderColorBrush" Color="#2CAB97"></SolidColorBrush>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextBox.Static.Background" Color="#172422"/>
            
            <LinearGradientBrush x:Key="OfrLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#48009AFF" Offset="0"/>
                <GradientStop Color="#00009AFF" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BidLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#66392512" Offset="0"/>
                <GradientStop Color="#00392512" Offset="0.65"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DrpLinearGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#50136C5E" Offset="0"/>
                <GradientStop Color="#00136C5E" Offset="1"/>
            </LinearGradientBrush>
            
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            
            <Style TargetType="{x:Type Button}" x:Key="ImageButtonStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/STC.XBond.Plugin;component/Images/stc_operation_history_dark_pressed.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/STC.XBond.Plugin;component/Images/stc_operation_history_dark_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/STC.XBond.Plugin;component/Images/stc_operation_history_dark_disabled.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="itemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="IsSelected" Value="{Binding Checked}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding BgColor}"></Setter>
                                    <!--Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>-->
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.Gray14}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CustomItemContainStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="60"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Content" Value="{Binding Name}"/>
                <Setter Property="IsSelected" Value="{Binding Checked}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsEnabled" Value="{Binding ItemEnable}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="#515151" Background="{TemplateBinding Background}"
                                    BorderThickness="1" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">

                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{Binding BgColor}"></Setter>
                                    <!--Value="{Binding SendPriceItem.BorderBH, Mode=TwoWay}"/>-->
                                </Trigger>

                                <Trigger Property="IsSelected" Value="false">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="border" Property="TextBlock.Foreground"  Value="{StaticResource ColorBrush.While}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style TargetType="{x:Type Button}" x:Key="MenuButtonStyle">
                <Setter Property="Background" Value="{StaticResource ColorBrush.Black8}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}">
                                </Border>
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                      Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Black8}">
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Foreground" Value="{StaticResource ColorBrush.Red7}"/>
                                    <Setter Property="Background" TargetName="background" Value="{StaticResource ColorBrush.Black8}">
                                    </Setter>
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Control.Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="../Images/stc_icon_login_setting.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SelfTabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="Background" Value="#141414"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="BorderBrush" Value="{StaticResource TabItem.Static.Border}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                                <Border x:Name="mainBorder" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="2" BorderThickness="0" Background="{TemplateBinding Background}">
                                    <Border x:Name="innerBorder" CornerRadius="4,4,0,0" BorderThickness="0" Background="#99392512" Opacity="0"/>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" ContentSource="Header" Focusable="False" HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="false"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="Top"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderThickness" TargetName="innerBorder" Value="0"/>
                                    <Setter Property="BorderThickness" TargetName="mainBorder" Value="0"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType={x:Type TabControl}}}" Value="Top"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Panel.ZIndex" Value="1"/>
                                    <Setter Property="Opacity" TargetName="innerBorder" Value="1"/>
                                    <Setter Property="BorderThickness" TargetName="innerBorder" Value="0"/>
                                    <Setter Property="BorderThickness" TargetName="mainBorder" Value="0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Image" x:Key="ImageStyle">
                <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BookType}" Value="R">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="P">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/group_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="A">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray20}">
        <Grid Grid.Column="1" Visibility="Visible" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="80"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>

                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="20"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock Text="报价要素" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Bottom" Foreground="{DynamicResource TextBlockDisableForeground}" FontSize="14" FontWeight="Bold"/>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="20"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Height="24">
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="缺省报量:" Margin="10, 0, 0, 0" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                        <Border Height="24" CornerRadius="1" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray20}" Margin="5, 0, 0, 0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <TextBox Tag="1" PreviewTextInput="TextBox_PreviewTextInput" Margin="2, 0, 2, 0" 
                                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                                     Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="70" Height="20" Text="{Binding DefaultAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" input:InputMethod.IsInputMethodEnabled="False"
                                             Style="{DynamicResource DefaultTextBoxStyle}" Background="{DynamicResource ColorBrush.Black7}" Padding="5, 2, 0, 0"
                                             Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBox>


                                <Button TabIndex="-1" Width="22" Height="10" Grid.Column="1" Grid.Row="0" Margin="0, 1, 0, 1" 
                                                    Background="{DynamicResource ColorBrush.Gray15}" Foreground="{DynamicResource ColorBrush.While}" Content="^" 
                                                    Padding="1, -2, 0, 0" Command="{Binding AddCommand}" Style="{DynamicResource AddButton}" FontSize="14px"/>
                                <Button TabIndex="-1" Width="22" Height="10" Grid.Column="1" Grid.Row="1" Margin="0, 1, 1, 1" 
                                                    Background="{DynamicResource ColorBrush.Gray15}" Foreground="{DynamicResource ColorBrush.While}" Content="v" 
                                                    Padding="2, -4, 0, 0"    Command="{Binding DownCommand}" Style="{DynamicResource AddButton}" FontSize="12px"/>

                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1" Margin="5, 0, 0, 0" Grid.Row="0" Text="万" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <CheckBox TabIndex="-1" IsChecked="{Binding SendPriceConsistencyCheck, Mode=TwoWay}" VerticalAlignment="Center" Margin="10, 3, 0, 0" Grid.Row="2" BorderThickness="2" 
                                          BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="14" HorizontalAlignment="Left" Content="与5秒内最新成交价不一致时提示"
                                          FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Background="{DynamicResource ColorBrush.Transparent}" 
                                          Foreground="{DynamicResource ColorBrush.Gray14}" FontWeight="Bold"></CheckBox>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Height="24">
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="类型:" Margin="10, 0, 0, 0" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                        
                        <ListBox x:Name="SettlTypeListBox2" Grid.Column="0" SelectionMode="Single"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                                 Height="24" 
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12" SelectedIndex="{Binding FirmSelectIndex, Mode=TwoWay}" 
                                 VerticalAlignment="Center" Margin="4,0,0,0"
                                 BorderBrush="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem x:Name="lbNoFirm" Width="24" Content="{DynamicResource ToFirm}" Style="{DynamicResource GreenBlueListBoxItemStyle}"/>
                            <ListBoxItem x:Name="lbFirm" Width="24" Content="{DynamicResource ToNonfirm}" Style="{DynamicResource GreenBlueListBoxItemStyle}"  IsSelected="True"/>
                        </ListBox>

                        <TextBlock Text="{Binding FirmTxt, Mode=TwoWay}" Width="45" Height="24" Margin="3,0,0,0" HorizontalAlignment="Left" Padding="0,6,0,0" Grid.Column="1" TextAlignment="Left"  Foreground="{DynamicResource TextBlockForeground}" FontSize="12"></TextBlock>
                    </StackPanel>

                </Grid>

                <!--废弃-->
                <Grid Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="89*"></ColumnDefinition>
                        <ColumnDefinition Width="215*"/>
                        <ColumnDefinition Width="304*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="10, 0, 0, 0" Visibility="Collapsed">
                        <TextBlock Text="报价设置:" VerticalAlignment="Center" Foreground="{DynamicResource TextBlockDisableForeground}" FontSize="12" FontWeight="Bold"/>
                        <CheckBox TabIndex="-1" IsChecked="{Binding NonFirmCheck, Mode=TwoWay}" VerticalAlignment="Center" Margin="5, 3, 0, 0" Grid.Column="3" BorderThickness="2" 
                                          BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="20"  
                                          FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource CommonCheckBoxStyle}" Background="{DynamicResource ColorBrush.Transparent}" 
                                          Foreground="{DynamicResource ColorBrush.While}"></CheckBox>

                        <TextBox Tag="3" Margin="5, 0, 5, 0" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="40" Height="20" IsEnabled="{Binding NonfirmTimeEnable}" 
                                                 PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                                 Text="{Binding NonfirmTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                 input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="2" BorderBrush="{DynamicResource ColorBrush.Gray15}"
                                             Style="{DynamicResource DefaultTextBoxStyle}" Background="{StaticResource ColorBrush.Black7}" Padding="5, 2, 0, 0"
                                             Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBox>

                        <TextBlock Grid.Column="1" Margin="5, 0, 0, 0" Grid.Row="0" Text="分后转为nonfirm" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.white}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!--撤单条件-->
                <Border Grid.Row="2" Grid.RowSpan="2" BorderThickness="0,0,0,0" BorderBrush="{DynamicResource ColorBrush.Gray20}">
                    <TabControl x:Name="SettlTypeListBox" Margin="0, 4, 0, 0" BorderThickness="0" Background="{DynamicResource BidLinearGradientBrush}">
                        <TabItem x:Name="lbCancel" Header="撤单条件" FontSize="12" Width="80" Style="{DynamicResource SelfTabItemStyle}">
                            <StackPanel Height="80" Background="Transparent">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4"></RowDefinition>
                                        <RowDefinition Height="18"></RowDefinition>
                                        <RowDefinition Height="32"></RowDefinition>
                                        <RowDefinition Height="24"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="有效时长:" Margin="10, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource TextBlockDisableForeground}"  FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal"  Grid.Column="0">
                                            <ComboBox x:Name="cbSettle2" Width="60"  Margin="12,0,0,0"  Height="24" Padding="0, 0, 0, 0" Style="{DynamicResource GreenBlueComboBoxStyle}" SelectedIndex="{Binding ValidSelectIndex,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="1">
                                                <ComboBoxItem Content="默认" Tag="1"></ComboBoxItem>
                                                <ComboBoxItem Content="时长" Tag="2"></ComboBoxItem>
                                                <ComboBoxItem Content="时点" Tag="3"></ComboBoxItem>
                                                <ComboBoxItem Content="无   " Tag="4"></ComboBoxItem>
                                            </ComboBox>
                                            <TextBlock Grid.Row="0" Margin="10, 0, 0, 0"  Height="16" HorizontalAlignment="Left" Grid.Column="0"  FontSize="12" FontWeight="Bold" Visibility="{Binding DefaultValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                                            <Run Text="每日" Foreground="{DynamicResource ColorBrush.Gray14}" />
                                                            <Run Text="6:00、12:00、16:30" Foreground="#F9C152"/>
                                                            <Run Text="自动撤回"  Foreground="{DynamicResource ColorBrush.Gray14}"/>
                                            </TextBlock>
                                            <!--时长-->
                                            <StackPanel Orientation="Horizontal" Height="24" Grid.Column="0"  Margin="6, 0, 0, 0"  Visibility="{Binding HourValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                                <comp:WatermarkTextBox WaterMark="" ContextMenu="{x:Null}" Tag="1" MaxLength="3" x:Name="ValidMinute" PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" Text="{Binding ValidMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputMethod.IsInputMethodEnabled="False" Width="28"  Height="24"  Padding="0, 0, 0, 0" Style="{DynamicResource GreenBlueWatermarkTextBox}">
                                                    <TextBox.ToolTip>
                                                        <ToolTip Content="输入范围:[0-500]分钟"></ToolTip>
                                                    </TextBox.ToolTip>
                                                </comp:WatermarkTextBox>
                                                <TextBlock Grid.Row="0" Text="分" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                                                <comp:WatermarkTextBox  WaterMark="" ContextMenu="{x:Null}"  Margin="6,0,0, 0" Tag="3"  MaxLength="2"  x:Name="ValidSecond"   PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24" Padding="0, 0, 0, 0"  Style="{DynamicResource GreenBlueWatermarkTextBox}">
                                                    <TextBox.ToolTip>
                                                        <ToolTip Content="输入范围:[0-60)"></ToolTip>
                                                    </TextBox.ToolTip>
                                                </comp:WatermarkTextBox>
                                                <TextBlock Grid.Row="0" Text="秒"  Height="16"  Margin="6, 0, 0, 0" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="后失效" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                            <!--时点-->
                                            <StackPanel Orientation="Horizontal" Height="24"  Grid.Column="0"  Margin="10, 0, 0, 0" Visibility="{Binding TimeValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                                                <comp:WatermarkTextBox  WaterMark="时" ContextMenu="{x:Null}" Tag="2" MaxLength="2" x:Name="ValidTimeHour"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False" Width="28" Height="24"  Padding="0, 0, 0, 0" Style="{DynamicResource GreenBlueWatermarkTextBox}">
                                                    <TextBox.ToolTip>
                                                        <ToolTip Content="输入范围:(0，24]"></ToolTip>
                                                    </TextBox.ToolTip>
                                                </comp:WatermarkTextBox>
                                                <TextBlock Grid.Row="0" Text=":"  Margin="6,0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
