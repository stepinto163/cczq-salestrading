                        <CheckBox  Grid.Column="0" IsChecked="{Binding DefaultCheckedBCO, Mode=TwoWay}" VerticalAlignment="Center"
                                  BorderThickness="2" BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="20"  Width="50"
                                  FontSize="{DynamicResource SmallContentFontSize}" 
                                  Style="{DynamicResource CheckBoxThemeColor}" Background="{DynamicResource ColorBrush.Transparent}" Foreground="{DynamicResource ColorBrush.While}" 
                                  Content="默认" ></CheckBox>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <ListBox x:Name="lbFirstLevelBCO"  SelectionMode="Extended" Margin="0, 0, 0, 0" 
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                             Height="26" ItemContainerStyle="{DynamicResource CustomItemContainStyle}"
                             Width="Auto" Background="{DynamicResource ColorBrush.Gray13}"
                             BorderThickness="0" ItemsSource="{Binding DefaultFirstItemDataBCO}"
                             FontSize="12"              
                             VerticalAlignment="Center" HorizontalAlignment="Left" SelectedItem=""
                             BorderBrush="Transparent" >

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <!--<ListBoxItem Width="60" Height="24"  Content="X-bond" Style="{StaticResource ListBoxItemStyle}"/>-->
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ListBoxItem Width="60" Height="24" FontSize="12" 
                                     Style="{DynamicResource CustomItemContainStyle}" Foreground="{DynamicResource ColorBrush.While}"></ListBoxItem>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                            <Rectangle Width="1" Height="30" Stroke="{StaticResource ColorBrush.Gray15}" Margin="3, 0, 2, 3"/>

                            <ListBox x:Name="lbSecondLevelBCO"  SelectionMode="Extended" Margin="0, 0, 0, 0" 
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                             Height="26" ItemContainerStyle="{DynamicResource CustomItemContainStyle}"
                             BorderThickness="0" ItemsSource="{Binding DefaultSecondItemDataBCO}"
                             FontSize="12"              Width="Auto" Background="{DynamicResource ColorBrush.Gray13}"
                             VerticalAlignment="Center" HorizontalAlignment="Left" SelectedItem=""
                             BorderBrush="Transparent" >

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <!--<ListBoxItem Width="60" Height="24"  Content="X-bond" Style="{StaticResource ListBoxItemStyle}"/>-->
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ListBoxItem Width="60" Height="24" FontSize="12" 
                                      Foreground="{DynamicResource ColorBrush.While}"></ListBoxItem>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>


                            <!--<StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left">-->
                            <TextBox x:Name="tbRandomNumBco" Tag="4" Text="{Binding RandomNumBCO, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                                     input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput"
                                     Width="50" Height="24" Margin="5, 0, 5, 0" Padding="0, 3, 0, 0" Template="{DynamicResource TextBoxControlTemplate1}"
                                     Foreground="{DynamicResource ColorBrush.While}" Background="{DynamicResource ColorBrush.Black8}" >
                                <TextBox.Resources>
                                    <ControlTemplate x:Key="TextBoxControlTemplate1" TargetType="{x:Type TextBox}">
                                        <Border x:Name="border" CornerRadius="1" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ColorBrush.Gray15}">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="false">
                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Gray15}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock Text="{Binding AllSecondChannelBCO}"  VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.While}"
                               FontSize="12" Margin="2, 0, 2, 0"></TextBlock>
                        </StackPanel>

                    </Grid>


                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" ></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <CheckBox  Grid.Row="3" Grid.Column="0" IsChecked="{Binding DirectionCheckedBCO, Mode=TwoWay}" 
                          VerticalAlignment="Center" BorderThickness="2" BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="20" Width="50"
                                  FontSize="{DynamicResource SmallContentFontSize}"
                                  Style="{DynamicResource CheckBoxThemeColor}" Background="{DynamicResource ColorBrush.Transparent}"
                                  Foreground="{DynamicResource ColorBrush.While}" Content="指定"></CheckBox>

                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <ListBox x:Name="lbBCODirection" SelectionMode="Extended" ItemsSource="{Binding DirectionItemDataBCO}"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden" Width="Auto" Background="{DynamicResource ColorBrush.Gray13}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" SelectionChanged="lbBCODirect_SelectionChanged"
                                  BorderBrush="Transparent" 
                         ItemContainerStyle="{DynamicResource itemContainStyle}"
                                 >

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ListBoxItem Width="60" Height="24"  FontSize="12" ></ListBoxItem>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>


                            <Button  Width="20"
                                        Height="20" Style="{StaticResource ImageButtonStyle}">
                                <Button.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/STC.XBond.Plugin;component/Images/stc_operation_history_dark_disabled.png"/>
                                </Button.Background>
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock Text="选择&lt;指定渠道&gt;，将在系统留痕，可能需要承担罚金"></TextBlock>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Grid>

                </Grid>

            </Grid>


            <Border Grid.Row="2" BorderBrush="{StaticResource ColorBrush.Gray20}" VerticalAlignment="Top" Height="70" BorderThickness="0, 1, 0, 1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="系统撤单设置" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Center" Grid.ColumnSpan="2" Foreground="{DynamicResource TextBlockDisableForeground}"  FontSize="14" FontWeight="Bold"/>


                    <TextBlock Margin="10, 0, 0, 0" Text="定时撤单:" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.Gray14}"  FontSize="12" FontWeight="Bold"></TextBlock>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
                        <CheckBox TabIndex="-1" IsChecked="{Binding CancelTimeEnable, Mode=TwoWay}" VerticalAlignment="Center" Margin="5, 3, 0, 0" Grid.Column="3" BorderThickness="2" 
                                          BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="14"  
                                          FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Background="{DynamicResource ColorBrush.Transparent}" 
                                          Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                        <TextBox Margin="5, 0, 5, 0" Width="40" Height="20" Tag="hour" IsEnabled="{Binding CancelTimeEnable}"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                                 Text="{Binding HourSetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                 input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="2" BorderBrush="{DynamicResource ColorBrush.Gray15}"
                                             Style="{DynamicResource DefaultTextBoxStyle}" Background="{DynamicResource ColorBrush.Black7}" Padding="5, 2, 0, 0"
                                             Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBox>
                        <TextBlock Text="时" VerticalAlignment="Center"   Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                        <TextBox Width="40" Height="20" Margin="5, 0, 5, 0" Tag="minute" IsEnabled="{Binding CancelTimeEnable}"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                                 Text="{Binding MinuteSetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                 input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="2" BorderBrush="{DynamicResource ColorBrush.Gray15}"
                                             Style="{DynamicResource DefaultTextBoxStyle}" Background="{DynamicResource ColorBrush.Black7}" Padding="5, 2, 0, 0"
                                             Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBox>
                        <TextBlock Text="分" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"></TextBlock>
                        <TextBox Width="40" Height="20" Margin="5, 0, 5, 0" Tag="second" IsEnabled="{Binding CancelTimeEnable}"
                                                 PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}"
                                                 Text="{Binding SecondSetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                 input:InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" BorderThickness="2" BorderBrush="{DynamicResource ColorBrush.Gray15}"
                                             Style="{DynamicResource DefaultTextBoxStyle}" Background="{DynamicResource ColorBrush.Black7}" Padding="5, 2, 0, 0"
                                             Foreground="{DynamicResource ColorBrush.While}" FontSize="12"></TextBox>
                        <TextBlock Text="秒" VerticalAlignment="Center"  Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"></TextBlock>

                    </StackPanel>

                    <TextBlock Grid.Column="2" Grid.Row="1" Text="注：勾选后,每日在该时间撤单" Foreground="{DynamicResource ColorBrush.Gray14}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,19,0"/>

                   
                </Grid>
            </Border>

            <Border Grid.Row="4" BorderBrush="{DynamicResource ColorBrush.Gray20}" VerticalAlignment="Top" Height="70" BorderThickness="0, 0, 0, 1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="订单匹配设置" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Center" Grid.ColumnSpan="2" Foreground="{StaticResource TextBlockDisableForeground}"  FontSize="14" FontWeight="Bold"/>
                    
                    <CheckBox TabIndex="-1" Grid.Row="1" Content="若订单匹配后发出点价，则更新原订单" IsChecked="{Binding PriceMatchCheck, Mode=TwoWay}" VerticalAlignment="Center" Margin="5, 3, 0, 0"  BorderThickness="2" 
                                          BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="14"  
                                          FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Background="{DynamicResource ColorBrush.Transparent}" 
                                           Foreground="{DynamicResource ColorBrush.Gray14}" FontWeight="Bold"></CheckBox>

                    <TextBlock Grid.Column="2" Grid.Row="1" Text="注：勾选后,订单匹配报价后弹框提示" Foreground="{DynamicResource ColorBrush.Gray14}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Margin="0,0,19,0"/>
                </Grid>
            </Border>

            <!--<Border Grid.Row="5" BorderBrush="{DynamicResource ColorBrush.Gray20}" VerticalAlignment="Top" Height="40" BorderThickness="0, 0, 0, 1" Visibility="{Binding AccountUserVisibility}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="投组账户" Foreground="{DynamicResource TextBlockDisableForeground}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <ComboBox x:Name="AccountUserCbc" ItemsSource="{Binding AccountUserSource}" Style="{DynamicResource GreenBlueComboBoxStyle}" 
                      SelectedItem="{Binding AccountUserItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      DropDownOpened="AccountUserCbc_DropDownOpened"
                      Width="160" Height="24" Margin="10,0,0,0" VerticalContentAlignment="Center"
                      DockPanel.Dock="Left" HorizontalAlignment="Left"
                  SourceUpdated="AccountUserCbc_SourceUpdated">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel></VirtualizingStackPanel>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" />
                                    <TextBlock x:Name="midTB" Text="-" />
                                    <TextBlock Text="{Binding AccountName}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Id, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                        <Setter TargetName="midTB" Property="Text" Value=""/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                   
                </StackPanel>
            </Border>-->

            <Border x:Name="DefaultGroup4Orders" Grid.Row="6" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}"  BorderBrush="{DynamicResource ColorBrush.Gray20}" VerticalAlignment="Top" Height="40" BorderThickness="0, 0, 0, 1">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="手工单默认组合" Foreground="{DynamicResource TextBlockDisableForeground}" VerticalAlignment="Center" Margin="10,0,0,0"/>

                    <comp:MultiTreeComboBox  Grid.Column="1" Width="160" Height="26"  Margin="10 0 0 0"  
                                        VerticalAlignment="Center" TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" Foreground="White"
                                        TreeItemsSource="{Binding MultiTreeComboxItemsSource}" IsEnableMultiSelect="False"  SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedTexts="{Binding SelectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <comp:MultiTreeComboBox.TreeItemItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                <StackPanel Orientation="Horizontal" Height="24">
                                    <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}" Visibility="{Binding IsLeaf, Converter={StaticResource visibilityConvertor}}"/>
                                    <Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>
                                    <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Checked}" Value="1">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </comp:MultiTreeComboBox.TreeItemItemTemplate>
                    </comp:MultiTreeComboBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="7" BorderBrush="{DynamicResource ColorBrush.Gray20}" VerticalAlignment="Top" Height="50" BorderThickness="0, 0, 0, 1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TradeBook页签标题设置" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Center" Grid.ColumnSpan="2" Foreground="{StaticResource TextBlockDisableForeground}"  FontSize="14" FontWeight="Bold"/>

                    <CheckBox TabIndex="-1" Grid.Row="1" Content="TradeBook页签标题展示债券简称" IsChecked="{Binding TradeBookHeaderCheck, Mode=TwoWay}" VerticalAlignment="Center" Margin="5, 3, 0, 0"  BorderThickness="2" 
                                          BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="14"  
                                          FontSize="{DynamicResource SmallContentFontSize}" Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Background="{DynamicResource ColorBrush.Transparent}" 
                                           Foreground="{DynamicResource ColorBrush.Gray14}" FontWeight="Bold"></CheckBox>

                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
