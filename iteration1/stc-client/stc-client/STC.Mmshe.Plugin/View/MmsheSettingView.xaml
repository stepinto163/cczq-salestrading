<UserControl x:Class="STC.Mmshe.Plugin.View.MmsheSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.Mmshe.Plugin.View" 
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded" Margin="20, 10, 20, 0">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>-->
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Image" x:Key="ImageStyle">
                <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BookType}" Value="R">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="P">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/group_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="A">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray20}">
        <Grid Grid.Column="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="260"></RowDefinition>
                <RowDefinition Height="2"></RowDefinition>
                <RowDefinition ></RowDefinition>
                <RowDefinition Height="2"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="120"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="做市义务提醒" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Bottom" Foreground="#788187" FontSize="14" FontWeight="Bold"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition  Width="35"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="09:25前未达标:" Grid.Column="0" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.White2}" 
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Right"/>
                    <CheckBox  Grid.Column="1"  TabIndex="-1" IsChecked="{Binding Tip1Enable, Mode=TwoWay}"
                               VerticalAlignment="Center" Margin="5, 3, 10, 0" BorderThickness="2"                                               
                               BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="16"                                                
                               FontSize="{DynamicResource SmallContentFontSize}" 
                               Style="{DynamicResource GreenBlueCheckedNormalCheckBox}"
                               Background="{DynamicResource ColorBrush.Transparent}"                                               
                               Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="提醒" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.Yellow}" FontSize="12" FontWeight="Bold"/>
                    
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="09:25-09:30未达标:" 
                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.White2}"
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Right"/>
                    <CheckBox Grid.Column="1" Grid.Row="1"  TabIndex="-1" IsChecked="{Binding Tip2Enable, Mode=TwoWay}"                               
                              VerticalAlignment="Center" Margin="5, 3, 10, 0" BorderThickness="2"                                                                           
                              BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="16"                                                                         
                              FontSize="{DynamicResource SmallContentFontSize}" 
                              Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                              Background="{DynamicResource ColorBrush.Transparent}"                                                                           
                              Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="高强提醒" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.Yellow}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Grid.Column="0" Grid.Row="2" Text="盘中断报监控:" 
                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.White2}"
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Right"/>
                    <CheckBox Grid.Column="1" Grid.Row="2"  TabIndex="-1" IsChecked="{Binding Tip3Enable, Mode=TwoWay}"                               
                              VerticalAlignment="Center" Margin="5, 3, 10, 0" BorderThickness="2"                                                                           
                              BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="16"                                                                         
                              FontSize="{DynamicResource SmallContentFontSize}" 
                              Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                              Background="{DynamicResource ColorBrush.Transparent}"                                                                           
                              Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="提醒" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.Yellow}" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <TextBlock Text="下单组合" Grid.Row="2" Margin="10, 0, 0, 0" VerticalAlignment="Bottom" Foreground="#788187" FontSize="14" FontWeight="Bold"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition  Width="150"/>
                        <ColumnDefinition  Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="默认下单组合:" Grid.Column="0" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.White2}" 
                               FontSize="12" Margin="0,0,0,0"
                               HorizontalAlignment="Right"/>

                    <!--<commComp:BookHierarchicalComboBox x:Name="bookHcbb" Grid.Column="1" Width="160" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" 
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Tag="BOOK" IsEditable="True" 
                                                       SelectedId="{Binding SelectedBookIdTexts, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                       SelectedTexts="{Binding SelectedBookNameTexts, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></commComp:BookHierarchicalComboBox>-->

                    <commComp:MultiTreeComboBox  Grid.Column="1" Grid.ColumnSpan="2" Width="160" Height="26"  Margin="10 0 0 0"  HorizontalAlignment="Left" 
                                                 VerticalAlignment="Center" TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" Foreground="White"
                                                 TreeItemsSource="{Binding MultiTreeComboxItemsSource}" IsEnableMultiSelect="False"  
                                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 SelectedTexts="{Binding SelectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <commComp:MultiTreeComboBox.TreeItemItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                <StackPanel Orientation="Horizontal" Height="24">
                                    <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}" Visibility="{Binding IsLeaf, Converter={StaticResource visibilityConvertor}}"/>
                                    <Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>
                                    <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Checked}" Value="1">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </commComp:MultiTreeComboBox.TreeItemItemTemplate>
                    </commComp:MultiTreeComboBox>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
