<bondComp:WindowBase x:Class="STC.Mmshe.Plugin.View.HomePage.AddGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bondComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Title="新增分组" Height="163" Width="500" ResizeMode="CanResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen">
    <bondComp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bondComp:WindowBase.Resources>
    <Grid FocusManager.FocusedElement="{Binding ElementName=groupname_txt}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="40,0,40,0" Grid.Row="0">
            <DockPanel VerticalAlignment="Bottom" Margin="0,0,0,0">
                <TextBlock Text="分组名称: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBox x:Name="groupname_txt"  Height="24" Width="160" Style="{StaticResource  STCDefaultBoxStyle}" TextChanged="groupname_txt_TextChanged" ContextMenu="{x:Null}"/>
            </DockPanel>
            <CheckBox x:Name="isGroupCk" VerticalAlignment="Center" Content="整组策略" Style="{StaticResource DefaultCheckBoxStyle}" Margin="10 0 0 0" Padding="4 0 0 0" Foreground="#A0A0A0" IsChecked="false"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="40,0,40,0" >
            <TextBlock x:Name="venue_tb" Text="交易场所: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ComboBox x:Name="comVenue" VerticalAlignment="Center" 
                      VerticalContentAlignment="Center"  HorizontalAlignment="Left" 
                      Width="120" Height="24"
                      SelectedValuePath="Key" DisplayMemberPath="Value" 
                      Style="{StaticResource NonEditableComboBoxStyle}" IsEnabled="True"
                      SelectionChanged="comVenue_SelectionChanged"/>
        </DockPanel>
        <TextBlock x:Name="error_tb" Grid.ColumnSpan="2" Grid.Row="2" Foreground="#E63034" VerticalAlignment="Top" HorizontalAlignment="Center"/>
        <Border Grid.ColumnSpan="2" Grid.Row="3" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK_Click" IsDefault="True">确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</bondComp:WindowBase>
