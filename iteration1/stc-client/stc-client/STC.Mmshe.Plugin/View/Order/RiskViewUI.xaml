<Window x:Class="STC.Mm.Plugin.View.Order.RiskViewUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
        mc:Ignorable="d"
        Title="风控提示" d:DesignHeight="281" d:DesignWidth="472" MinWidth="472" Height="281" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" SizeToContent="Width"
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" Loaded="window_Loaded" BorderThickness="0" BorderBrush="#136C5E" Background="Transparent" KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DefalutTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="WarnTextBlockStyle" TargetType="{x:Type Run}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="600"/>
            </Style>

            <Style x:Key="RedTextBlockStyle" TargetType="{x:Type Run}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Red7}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="600"/>
            </Style>
            
            <Style x:Key="GoldTextBlockStyle" TargetType="{x:Type Run}">
                <Setter Property="Foreground" Value="#F9C152"/>
                <Setter Property="FontSize" Value="12px"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="600"/>
            </Style>

            <Style x:Key="LightYellowTextBlockStyle" TargetType="{x:Type Run}">
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="FontSize" Value="12px"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="400"/>
            </Style>

            <!--警告标题新样式-->
            <ControlTemplate x:Key="AlterTextBox" TargetType="{x:Type TextBox}">
                <Border  CornerRadius="12" BorderBrush="#F9C152"  Background="#26F9C152" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,8" Padding="4,0,4,0"  MinHeight="24" MinWidth="16">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" FontSize="12px" BorderThickness="0" Width="Auto" FontFamily="Microsoft YaHei" Foreground="#F9C152" Background="Transparent"/>
                </Border>
            </ControlTemplate>
            <Style x:Key="AlterTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Foreground" Value="#F9C152"/>
                <Setter Property="FontSize" Value="12px"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="400"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Padding" Value="0,0,0,2"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- Cancel Button-->
            <Style x:Key="CancelPriceButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#3C3C3C"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderBrush" Value="#515151"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#515151"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#788187"/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="#3C3C3C"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#515151"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- SaveButton-->
            <Style x:Key="SendPriceButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid x:Name="Grid">
                                <Border x:Name="out_border" CornerRadius="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" Background="Transparent" SnapsToDevicePixels="true">
                                    <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                        <ContentPresenter x:Name="contentPresenter"  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </Border>
                                <Border x:Name="ShineBorder" CornerRadius="1" Opacity="0" Background="#59FFFFFF" BorderThickness="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#136C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#2CAB97 "/>
                                    <!--Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{DynamicResource SelectItemForeground}"/-->
                                    <!--Setter Property="Opacity" TargetName="ShineBorder" Value="0.5"/-->
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Opacity" TargetName="ShineBorder" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.3"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--ToolTip的样式-->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Padding" Value="4,2,4,2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="FontFamily" Value="ArialMT"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderBrush" Value="#308376"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border x:Name="Root" CornerRadius="1" BorderThickness="{TemplateBinding BorderThickness}" Background="#FFFFFFFF" BorderBrush="{TemplateBinding BorderBrush}">
                                <Border BorderBrush="#FFFFFFFF" BorderThickness="0" CornerRadius="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <Border.Resources>
                                        <Storyboard x:Key="Visible State"/>
                                        <Storyboard x:Key="Normal State"/>
                                    </Border.Resources>
                                    <ContentPresenter
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Cursor="{TemplateBinding Cursor}"
                              Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!--{Binding SuccessVisibility}-->
        <Border BorderThickness="1,1,1,1" BorderBrush="#0C4F44" CornerRadius="4" Background="{StaticResource ColorBrush.Gray18}" Visibility="{Binding SuccessVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="[报价成功]" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" Foreground="{StaticResource ColorBrush.Green15}" FontSize="12"></TextBlock>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="您的报价 " Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
                    <TextBlock Text=" 已报价成功 " Style="{StaticResource DefalutTextBlockStyle}"></TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!--{Binding FailVisibility}-->
        <Grid Background="Transparent" Visibility="{Binding FailVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border BorderThickness="1,1,1,0" Grid.Row="0"  CornerRadius="4,4,0,0" BorderBrush="#136C5E" Background="#0C4F44">
                <Grid  Background="#0C4F44" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Title}" Width="48" Margin="6, 0, 0, 0"  Foreground="#FFEBC8" FontSize="12" VerticalAlignment="Center"/>
                    <Button Width="16" Height="16" Grid.Column="2" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
                </Grid>
            </Border>
            
            <Border VerticalAlignment="Stretch" Grid.Row="1" BorderThickness="1, 0, 1, 1"  BorderBrush="#136C5E" CornerRadius="0,0,4,4" Background="#171F1F">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"></ColumnDefinition>
                        <ColumnDefinition Width="16"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <ed:RegularPolygon Fill="#FF9300" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" InnerRadius="1" PointCount="3" Stretch="Fill" Stroke="#FF9300" Height="22" Width="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Text="!" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"  VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#000000" FontWeight="ExtraBold" FontSize="11" Padding="0,4,0,0" ></TextBlock>
                    <StackPanel  Grid.Row="1" Grid.Column="2" Orientation ="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center"> 
                            <Run Text="{Binding YourPrice}" Style="{DynamicResource WarnTextBlockStyle}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Security}" x:Name="txt_Security" VerticalAlignment="Center" Foreground="#F9C152" FontFamily="Microsoft YaHei" FontSize="16"  FontWeight="Bold" ></TextBlock>
                        <TextBlock Text="{Binding BidOrOfr}"  x:Name="txt_BidOrOfr"  VerticalAlignment="Center" Foreground="{Binding BorderBH}"  FontWeight="Bold"  FontFamily="Microsoft YaHei" FontSize="16" Margin="8,0,0,0"></TextBlock>
                        <TextBlock Text="{Binding OrderInfo}"  x:Name="txt_PriceAndAmout" VerticalAlignment="Center" Foreground="#FFEBC8"  FontFamily="Microsoft YaHei" FontSize="16"  FontWeight="Light" Margin="8,0,0,0"></TextBlock>
                        <TextBlock VerticalAlignment="Center"> 
                            <Run Text="{Binding YourPriceTouch}" Style="{DynamicResource WarnTextBlockStyle}"/>
                            <Run Text="{Binding YourPriceTwo}" Style="{DynamicResource RedTextBlockStyle}"/>
                            <Run Text="{Binding YourPriceRiskWarn}" Style="{DynamicResource WarnTextBlockStyle}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Row="2"  Grid.Column="1" Grid.ColumnSpan="3"  BorderThickness="0,0,0,0" Background="#171F1F" BorderBrush="#0A0F0E">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" x:Name="spRiskLeft" Orientation ="Vertical" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <TextBox Text="数量超限" Template="{DynamicResource AlterTextBox}" Style="{StaticResource AlterTextBoxStyle}"></TextBox>
                                <TextBox Text="中债估值偏移" Template="{DynamicResource AlterTextBox}" Style="{StaticResource AlterTextBoxStyle}"></TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" x:Name="spRisk" Orientation ="Vertical" HorizontalAlignment="Left" Margin="0,16,8,0">
                                <TextBlock Height="24" Margin="0,0,0,8">
                                    <Run Text="数量超出单笔报量范围 " Style="{StaticResource LightYellowTextBlockStyle}"></Run>
                                    <Run Text="[1000,5000] " Style="{StaticResource GoldTextBlockStyle}"></Run>
                                    <Run Text="万" Style="{StaticResource LightYellowTextBlockStyle}"></Run>
                                </TextBlock>
                                <TextBlock  Height="24" Margin="0,0,0,8">
                                    <Run Text="价格与中债估值 " Style="{StaticResource LightYellowTextBlockStyle}"></Run>
                                    <Run Text="(3.52) " Style="{StaticResource GoldTextBlockStyle}"></Run>
                                    <Run Text="偏离 " Style="{StaticResource LightYellowTextBlockStyle}"></Run>
                                    <Run Text="7 bp, " Style="{StaticResource GoldTextBlockStyle}"></Run>
                                    <Run Text="超出设置值 " Style="{StaticResource LightYellowTextBlockStyle}"></Run>
                                    <Run Text="5 bp" Style="{StaticResource GoldTextBlockStyle}"></Run>
                                    <TextBlock.ToolTip>
                                        <TextBlock Text="Test" MaxWidth="500" TextWrapping="Wrap" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        
                    </Border>

                    <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#171F1F" Margin="2,0,2,2" BorderThickness="0,1,0,0" BorderBrush="#0A0F0E">
                        <Grid>
                            <Button HorizontalAlignment="Center" Margin="{Binding CancelBtnThickness}" Content="取消" Command="{Binding CloseCommand}" 
                            Height="24" Width="60" Style="{DynamicResource CancelPriceButton}"></Button>
                            <Button x:Name="btnOk" Visibility="{Binding OkVisibility}" HorizontalAlignment="Center" Margin="{Binding OkBtnThickness}" Content="{Binding OkContent}" Command="{Binding OkCommand}" 
                            Height="24" Width="100" Style="{DynamicResource SendPriceButton}"></Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>
       
    </Grid>
</Window>
