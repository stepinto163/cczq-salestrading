<bondComp:WindowBase x:Class="STC.Mmshe.Plugin.View.ChangeGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:bondComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" Height="150" Width="300" ResizeMode="NoResize" x:Name="ChangeGroupWin"
             d:DesignHeight="450" d:DesignWidth="800">



    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/MMThemes.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="组名: " Foreground="#FFFFFF" Margin="0 0 20 0"/>
            <ComboBox Name="groupCBC" Style="{StaticResource  NonEditableComboBoxStyle}" Width="120"  VirtualizingStackPanel.IsVirtualizing ="True"
                      ItemsSource="{Binding GroupList}" 
                      SelectedValue="{Binding SelectedGroup, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="item" Text="{Binding GroupName}"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="item" Property="Foreground" Value="Goldenrod"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!--确认取消按钮区域-->
        <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="#282828" BorderThickness="0 1 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource  CancelButtonStyle}" Width="60" Height="24" Content="取消" Foreground="#FFFFFF" Command="{Binding CancelBtnCommand}" CommandParameter="{Binding ElementName=ChangeGroupWin}"/>
                <Button Style="{StaticResource  ConfirmButtonStyle}" Width="100" Height="24" Content="确认" Foreground="#FFFFFF" Margin="10,0,0,0" Command ="{Binding ConfirmBtnCommand}" CommandParameter="{Binding ElementName=ChangeGroupWin}"/>
            </StackPanel>
        </Border>
    </Grid>
</bondComp:WindowBase>
