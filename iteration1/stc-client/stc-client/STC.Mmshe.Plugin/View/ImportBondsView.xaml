<comp:WindowBase x:Class="STC.Mmshe.Plugin.View.ImportBondsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Mmshe.Plugin.View"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" Height="328" Width="280" Closed="WindowBase_Closed"
             d:DesignHeight="450" d:DesignWidth="800" ContentRendered="WindowBase_ContentRendered">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/MMThemes.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mmshe.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="34"/>
            <RowDefinition/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        
        <!--第一层-->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="债券分组" Foreground="#A0A0A0" VerticalAlignment="Bottom" Margin="16 0 0 6"/>
            <ComboBox x:Name="UnifyGroupCb" ItemsSource="{Binding UnifyGroupDic}" SelectedItem="{Binding SelectedUnifyGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Style="{StaticResource NonEditableComboBoxStyle}" Margin="4 0 0 0" Width="160" Height="24" VerticalAlignment="Bottom" VerticalContentAlignment="Center"
                      IsEnabled="{Binding Path=IsEnabled, ElementName=btnOK}">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="importBtn" Width="24" Height="24" Margin="4 0 0 0" Style="{StaticResource ImportButton2}" VerticalAlignment="Bottom" Click="ImportBtn_Click">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource multiAndNormalConverter}">
                        <MultiBinding.Bindings>
                            <Binding Path="ImportEnabled"/>
                            <Binding Path="IsEnabled" ElementName="btnOK"/>
                            <Binding Path="IsChecked" ElementName="IsHomeCb" Converter="{StaticResource reversebooleanConvertor}"/>
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>

           
        </StackPanel>

        <!--第二层-->
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <CheckBox x:Name="IsHomeCb" Content="选择已有关注组" Foreground="#A0A0A0" VerticalAlignment="Bottom" Margin="16 0 0 6"  
                      Style="{StaticResource DefaultCheckBoxStyle}" Padding="4 0 0 0" 
                      IsChecked ="{Binding IsHomeChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Checked="IsHomeCb_Checked"
                      Unchecked="IsHomeCb_Unchecked"/>
            <ComboBox ItemsSource="{Binding HomeGroupDic}" SelectedItem="{Binding SelectedHomeGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Style="{StaticResource NonEditableComboBoxStyle}" Margin="4 0 0 0" Width="132" Height="24" VerticalAlignment="Bottom" VerticalContentAlignment="Center"
                      SelectionChanged="ComboBox_SelectionChanged">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- 第三步 -->
        <Border x:Name="step1" BorderBrush="#3B3C3E" Background="#0B0C0C" BorderThickness="1"  Margin="16 10 16 10" Visibility="Visible" Grid.Row="2">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="importTxt" BorderThickness="0" Background="#0B0C0C" Foreground="#FFFFFF"  AcceptsReturn="True" TextWrapping="Wrap"  Padding="10" Text="{Binding CodeText}"
                             IsReadOnly="{Binding IsChecked, ElementName=IsHomeCb}">
                        <!--<TextBox.ContextMenu>
                        <ContextMenu Name="cm" StaysOpen="true">
                            <MenuItem Header="导入CVS文件" Command="{Binding ImportCommand}"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>-->
                    </TextBox>
                </ScrollViewer>

                <TextBlock x:Name="HintTextBox" IsHitTestVisible="False" Text="贴上文本信息以识别债券数据" 
                       Foreground="{StaticResource TextBox.Static.Border}" Padding="10">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=importTxt}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 第四步 -->
        <Grid x:Name="step2" Visibility="Collapsed" Grid.Row="2">
            <TextBlock Margin="16,10,16,0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}识别: {0}/{1}">
                        <Binding Path="CheckedCount"></Binding>
                        <Binding Path="SumCount"></Binding>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <DataGrid x:Name="dg" Margin="16,40,16,10" ItemsSource="{Binding ImportDv}" Style="{StaticResource DefaultDataGrid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn MinWidth="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsCheck,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Checked="CheckBox_Click" Unchecked="CheckBox_Click" Style="{StaticResource DefaultCheckBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="代码" MinWidth="80" Binding="{Binding SecurityID}"/>
                    <DataGridTextColumn Header="简称" MinWidth="130" Binding="{Binding Symbol}"/>
                    <DataGridTextColumn Header="期限" MinWidth="100" Binding="{Binding RemainingDate}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 第三步 -->
        <Grid x:Name="step3" Visibility="Collapsed" Grid.Row="2">
            <TextBlock Margin="16,10,16,0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}识别: 成功导入{0}只债券，失败导入{1}只债券：">
                        <Binding Path="SuccessCount"></Binding>
                        <Binding Path="FailCount"></Binding>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <ScrollViewer Margin="16,40,16,10" Grid.Column="1" MinWidth="260" 
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="viewer">
                <TextBox x:Name="txtMessage" IsReadOnly="True"  TextWrapping="Wrap" BorderThickness="0" Background="#0B0C0C" Foreground="#FFFFFF" Text="{Binding ResultStr}" ></TextBox>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK_Click" Visibility="Visible">识别</Button>
                <Button x:Name="btnBack" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnBack_Click" Visibility="Collapsed">返回</Button>
                <Button x:Name="btnOK2" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK2_Click" Visibility="Collapsed" IsDefault="True" IsEnabled="{Binding HasItems, ElementName=dg}">确认导入</Button>
                <Button x:Name="btnOK3" Width="100" Height="24"  Margin="4,0,0,0"  Style="{StaticResource RedButtonStyle}"
                        Click="btnOK3_Click" Visibility="Collapsed" IsDefault="True" IsEnabled="{Binding BtnOK3Enabled}">确认</Button>
            </StackPanel>

        </Border>
    </Grid>
</comp:WindowBase>
