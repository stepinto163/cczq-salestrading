<Window x:Class="STC.MMshe.Plugin.View.MMLogsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.MMshe.Plugin.View"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d"
            Title="MMLogsWindow" d:DesignHeight="600" d:DesignWidth="400" 
            MinWidth="280"  MinHeight="400" Width="300" Height="500"
            AllowsTransparency ="True" IsHitTestVisible="True" WindowStartupLocation="CenterScreen" 
            WindowStyle="None"  WindowState="Normal" BorderThickness="1" BorderBrush="#A0A0A0"  Background="#0A0F0E"
            Closed="Window_Closed" KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/TabControlStyleDictionary.xaml"/>-->

            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="danger" Color="#FF333A"/>
            <SolidColorBrush x:Key="opportunity" Color="#F9C152"/>
            <SolidColorBrush x:Key="standard" Color="#00CDAD"/>
            <SolidColorBrush x:Key="failure" Color="#A0A0A0"/>

            <SolidColorBrush x:Key="white" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="green" Color="#00CDAD"/>
            <SolidColorBrush x:Key="gray" Color="#8F9598"/>
            <SolidColorBrush x:Key="orange" Color="#FF7D00"/>
            <SolidColorBrush x:Key="blue" Color="#009AFF"/>
            <SolidColorBrush x:Key="red" Color="red"/>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="1" BorderThickness="0" BorderBrush="#A0A0A0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="0" x:Name="TitleBar" Height="30" >
                <Grid>
                    <Border x:Name="bdSecurity"  BorderThickness="0">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="24"></ColumnDefinition>
                                <ColumnDefinition Width="24"></ColumnDefinition>
                                <ColumnDefinition Width="24"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" x:Name="TitleIcon" Stretch="Uniform" Height="16"/>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" >
                                <TextBlock x:Name="TextBlockLog" Text="日志" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-4,0,0,0"></TextBlock>
                                <TextBlock x:Name="TextBlockSecurity" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"></TextBlock>
                                <TextBlock x:Name="TextBlockStatus" Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"></TextBlock>
                            </StackPanel> 
                            
                            <!--<Button x:Name="btnMin" Style="{StaticResource MainPageImageMinButton}" Width="22" Height="14" Grid.Column="2" Click="btnMin_Click"></Button>
                            <Button x:Name="btnMax" Style="{StaticResource MainPageImageMaxButton}" Width="22" Height="14" Grid.Column="3" Click="btnMax_Click"></Button>-->
                            <Button x:Name="btnClose" Style="{StaticResource MainPageImageCloseButton}"  Width="22" Height="12"  Grid.Column="4" Click="btnClose_Click" IsCancel="True" ToolTip="关闭" />

                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <!--<Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" >
               
            </Frame>-->

            <RichTextBox x:Name="rtb" Grid.Row="1" Background="black" Padding="0 4 0 0" IsReadOnly="true"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <RichTextBox.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandBinding_CanExecute"/>
                    <CommandBinding Command="ApplicationCommands.Cut" CanExecute="CommandBinding_CanExecute"/>
                </RichTextBox.CommandBindings>
                <FlowDocument x:Name="fd" LineHeight="4">
                    
                </FlowDocument>
            </RichTextBox>
        </Grid>
    </Border>


    </Window>
