<UserControl x:Class="STC.Excel.Plugin.View.Setting.ExcelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Excel.Plugin.View.Setting"
             xmlns:cv ="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Margin="20, 10, 20, 0">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <cv:VisibilityConvertor x:Key="visibilityConvertor"/>
            <SolidColorBrush x:Key="TextBlockDisableForeground" Color="#788187"/>
            <!-- Install按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="InstallImageButton">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
                <Setter Property="Background" Value="{DynamicResource BlueGreenButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BlueGreenButton.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource BlueGreenButton.Static.Foreground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"  Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}" SnapsToDevicePixels="true">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Label Name="label" Grid.Column="0" Width="30" Height="30" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Label.Content>
                                                <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_setting_normal.png"/>
                                            </Label.Content>
                                        </Label>
                                        <TextBlock  Grid.Column="1" Text="{TemplateBinding Content}" TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"></TextBlock>
                                        <Ellipse x:Name="elli" Grid.Column="1"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="42 ,8, 0, 0" Visibility="{Binding IsUpgradeRedVisible, Converter={StaticResource visibilityConvertor}}" Width="5"  Height="5" Fill="#FF3C3C" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_setting_normal.png"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.MouseOver.Background}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_setting_normal.png"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.Pressed.Background}"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_setting_disabled.png"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.Disabled.Background}"/>
                                </Trigger>
                                
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- UnInstall按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="UnInstallImageButton">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
                <Setter Property="Background" Value="{DynamicResource BlueGreenButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BlueGreenButton.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource BlueGreenButton.Static.Foreground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding Background}" Background="{TemplateBinding Background}"      
                            CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Label Name="label" Grid.Column="0" Width="30" Height="30" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Label.Content>
                                                <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_delete_normal.png"/>
                                            </Label.Content>
                                        </Label>
                                        <TextBlock  Grid.Column="1" Text="{TemplateBinding Content}" TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"></TextBlock>                                    
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_delete_normal.png"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.MouseOver.Background}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_delete_pressed.png"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.Pressed.Background}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="label" Property="Content">
                                        <Setter.Value>
                                            <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_delete_normal.png"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.Disabled.Background}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- InfoButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="InfoButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="注：安装、升级或卸载前请关闭EXCEL">
                                        <Label.Content>
                                            <Image Source="/STC.Excel.Plugin;component/Images/icon_operation_history_dark_disabled.png"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- api文档Button样式-->
            <Style TargetType="{x:Type Button}" x:Key="ApiStcButton">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}"/>
                <Setter Property="Background" Value="{DynamicResource BlueGreenButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BlueGreenButton.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource BlueGreenButton.Static.Foreground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding Background}" Background="{TemplateBinding Background}"      
                            CornerRadius="4">
                                    <TextBlock  Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.MouseOver.Background}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.Pressed.Background}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="background" Property="Background" Value="{DynamicResource BlueGreenButton.Disabled.Background}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>


    <Border Grid.Row="1" BorderThickness="0" BorderBrush="{DynamicResource ColorBrush.Gray20}">
        <Grid Grid.Column="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="220"></RowDefinition>
                <RowDefinition Height="2"></RowDefinition>
                <RowDefinition ></RowDefinition>
                <RowDefinition Height="2"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"></RowDefinition>
                    <RowDefinition Height="112"></RowDefinition>
                    <RowDefinition Height="0"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition Height="60"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"></ColumnDefinition>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" >
                        <TextBlock Text="{Binding ExcelPlugInVersion,Mode=TwoWay}" Height="20" Margin="20, 0, 0, 0"  HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="{DynamicResource TextBlockDisableForeground }" FontSize="14" FontFamily="{DynamicResource FontFamily.Roboto}" />
                        <!--<TextBlock Text="可升级"  Margin="20, 0, 0, 0"  VerticalAlignment="Center"  Foreground="{StaticResource  RedButton.Static.Foreground}" Visibility="{Binding IsUpgradeRedVisible, Converter={StaticResource visibilityConvertor}}" FontSize="14" FontFamily="{StaticResource FontFamily.Roboto}" />-->
                        <Button Margin="10,-4,0,0" VerticalAlignment="Center" Style="{DynamicResource InfoButton}" Visibility="Visible" Height="24" />
                    </StackPanel>

                    <Button Grid.Column="0" Grid.Row="1" Margin="20,0,0,0" Content="{Binding ExcelPlugInButtonText,Mode=TwoWay}" FontFamily="{DynamicResource IDCFontFamily.YaHei}" FontSize="{DynamicResource FontSize-14}" Style="{DynamicResource InstallImageButton}" Command="{Binding InstallExcelPluginCommand}"
                            Height="40" Width="130" />
                    <Button Grid.Column="1" Grid.Row="1" Margin="0,0,0,0" Content="卸载" FontFamily="{DynamicResource IDCFontFamily.YaHei}" FontSize="{DynamicResource FontSize-14}" Style="{DynamicResource UnInstallImageButton}" Command="{Binding UnInstallExcelPluginCommand}"
                            Height="40" Width="130" IsEnabled="{Binding IsUninstallButtonEnable,Mode=TwoWay}" />
                    <Button x:Name="ApiStcButton" Grid.Column="2" Grid.Row="1" Margin="0,0,0,0" Content="Api文档" FontFamily="{DynamicResource IDCFontFamily.YaHei}" FontSize="{DynamicResource FontSize-14}" Style="{DynamicResource ApiStcButton}"
                            Height="40" Width="130" Click="ApiStcButton_Click" HorizontalAlignment="Left"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Visibility="Collapsed" BorderThickness="1" Height="1" BorderBrush="{DynamicResource ColorBrush.Gray20}" Margin="0, 0, 5, 0">
            </Border>
        </Grid>
    </Border>
</UserControl>
