<UserControl x:Class="STC.Execute.Plugin.View.Execute.ExecuteOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:command ="clr-namespace:STC.Execute.Plugin.Command"
             xmlns:utils="clr-namespace:STC.Execute.Plugin.Utils"
             xmlns:local="clr-namespace:STC.Execute.Plugin.View.Execute"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="286">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="TextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10, 0, 0, 0"/>
            </Style>

            <Style x:Key="DetailTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Yellow}"/>
                <Setter Property="FontSize" Value="{StaticResource NormalContentFontSize}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10, 0, 0, 0"/>
            </Style>

            <Style x:Key="TextBox2" TargetType="TextBox">
                <Setter Property="Background" Value="#0F0F0F" />
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Yellow}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="Margin" Value="10, 0, 0, 0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="Bd" SnapsToDevicePixels="true" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter Property="Background" TargetName="Bd" Value="#1E1E1E"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="#3C3C3C"/>
                                    <!--<Setter Property="Foreground" Value="#3C3C3C"/>-->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="false">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <TextBlock Text="{TemplateBinding Text}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <ContextMenu x:Key="CopyContextMenu" Style="{StaticResource DefaultContextMenu}">
                <MenuItem x:Name="copyRow" Header="复制" Style="{StaticResource DefaultMenuItem}" Click="copyRow_Click"/>
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="75"></ColumnDefinition>
                <ColumnDefinition Width="24"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="成交明细" Foreground="{StaticResource ColorBrush.While}" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10, 0, 0, 0"></TextBlock>
            <Button Name="btConfirm" Grid.Column="2" Grid.Row="0" IsEnabled="{Binding ConfirmEnable}" Width="56" Height="18" Content="确认" Style="{StaticResource RedButtonStyle}" HorizontalAlignment="Right" Margin="0, 0, 0, 0" 
                        Command="{Binding ConfirmCommand}" />
            <Button x:Name="btnFullScreen" Grid.Column="3" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PopupButton}" 
                    Command="{x:Static utils:CommonUtils.PopupWindowCommand}" CommandParameter="{x:Static command:PopupTypeEnum.ExecutionConfirm}"/>

        </Grid>
        <ScrollViewer Grid.Row="1" Style="{StaticResource DefaultScrollViewer}" HorizontalScrollBarVisibility="Disabled"  VerticalScrollBarVisibility="Auto">

            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="359"></RowDefinition>
                    <RowDefinition Height="599"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderThickness="0, 0, 0, 1" Background="{StaticResource ColorBrush.Gray13}" BorderBrush="{StaticResource ColorBrush.Gray18}">
                    <Grid Margin="0, 15, 0, 0">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="债券代码" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="债券简称" HorizontalAlignment="Left"></TextBlock>
                        <!--<Button Grid.Column="2" Grid.Row="0" IsEnabled="{Binding ConfirmEnable}" Width="64" Height="24" Content="确认" Style="{StaticResource RedButtonStyle}" HorizontalAlignment="Right" Margin="0, 0, 10, 0"/>-->
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding SecurityID}" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding Symbol}" HorizontalAlignment="Left"></TextBlock>


                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="方向" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="成交价(%)" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding AvgPx}" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding Side}" HorizontalAlignment="Left"></TextBlock>


                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="清算速度" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="成交量(万)" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding SettlType}" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left"></TextBlock>

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="净价(元)" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="全价(元)" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding CleanPrice}" ToolTip="仅供参考" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding DirtyPrice}" ToolTip="仅供参考" HorizontalAlignment="Left"></TextBlock>

                        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="对手方" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="对手方交易员" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding CounterPartyName}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding CounterPartySubName}" HorizontalAlignment="Left"></TextBlock>


                        <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="交易日" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="结算日" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding TradeDate}" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding SettlDate}" HorizontalAlignment="Left"></TextBlock>

                        <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="到期日" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="价格备注" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="13" Grid.Column="0" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding MaturityDate}" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="13" Grid.Column="1" Style="{StaticResource DetailTextBlockStyle}" Text="{Binding TransactionPriceType}" HorizontalAlignment="Left"></TextBlock>
                        
                        <TextBlock Grid.Row="14" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="经纪商备注" HorizontalAlignment="Left"></TextBlock>
                        <TextBox Name="txAllocText" Grid.Row="15" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3" BorderThickness="0" IsReadOnly="True" Style="{StaticResource TextBox2}" Text="{Binding AllocText}" TextWrapping = "Wrap"
                         MouseRightButtonUp="txAllocText_MouseRightButtonUp" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}">
                        </TextBox>


                    </Grid>
                </Border>


                <Border Grid.Row="1" BorderThickness="0, 0, 0, 1" Background="{StaticResource ColorBrush.Gray13}" BorderBrush="{StaticResource ColorBrush.Gray18}">

                    <Grid Margin="0, 10, 0, 0">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="90"></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"></ColumnDefinition>
                            <ColumnDefinition Width="96*"></ColumnDefinition>
                            <ColumnDefinition Width="95*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Grid.ColumnSpan="3">
                            <TextBlock Style="{StaticResource TextBlockStyle}" Text="我的备注" HorizontalAlignment="Left" Margin="0,0,5,0"></TextBlock>
                            <Button x:Name="editBtn" BorderThickness="0" Height="20" Width="20" 
                            VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource EditButton}" 
                            Visibility="{Binding EditBtnVisible ,Converter={StaticResource visibilityConvertor}}" 
                            Command="{Binding EditRemarkCommand}" IsEnabled="{Binding IsOwn}"></Button>
                            <Button x:Name="saveBtn" BorderThickness="0" Height="20" Width="20" 
                            VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource SaveButton}" 
                            Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}" 
                            Command="{Binding SaveRemarkCommand}" Margin="0,0,5,0"></Button>
                            <Button x:Name="cancelBtn" BorderThickness="0" Height="20" Width="20" 
                            VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CancelButton}" 
                            Visibility="{Binding SaveBtnVisible ,Converter={StaticResource visibilityConvertor}}" 
                            Command="{Binding CancelRemarkCommand}"></Button>
                            <TextBox x:Name="tBspare" Width="0"></TextBox>
                        </StackPanel>
                        <TextBox Name="txRemark" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                             Style="{StaticResource TextBoxStyle1}" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Visible"
                             Text="{Binding EditRemark, Mode=TwoWay}"    
                            IsReadOnly="{Binding EditBtnVisible, Mode=TwoWay}" IsEnabled="{Binding IsOwn}"
                    MouseDoubleClick="TextBox_MouseDoubleClick" KeyDown="TextBox_KeyDown"></TextBox>
                        <!--AcceptsReturn="True"-->

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="债券类型" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="市场" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding SecurityType}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding MarketIndicator,Converter={StaticResource EnumTypeConvertor},ConverterParameter='marketindicator'}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>


                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="到期收益率" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="行权收益率" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding AvgPx2}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding StipulationValue}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="清算方式" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="交易类型" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding DeliveryType,Converter={StaticResource EnumTypeConvertor},ConverterParameter='dliverytype'}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding TradeType}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>

                        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="报价方式" HorizontalAlignment="Left">
                        </TextBlock>
                        <!--<TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="要素发送至" HorizontalAlignment="Left"></TextBlock>-->
                        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding TrdType}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <!--<TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding IndividualAllocID}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>-->
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="方向说明" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource TextBlockStyle}" Text="{Binding TrdSubType,Converter={StaticResource EnumTypeConvertor},ConverterParameter='trdsubtype'}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <!--<TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="券面总额(万)" HorizontalAlignment="Left"></TextBlock>
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="交易金额(万)" HorizontalAlignment="Left"></TextBlock>
                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                    <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>-->
                        <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="票面总额(万)" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="返点(元)" HorizontalAlignment="Left"></TextBlock>
                        <!--<TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="结算金额(万)" HorizontalAlignment="Left"></TextBlock>-->
                        <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding PaymentAmount}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <!--<TextBlock Grid.Row="13" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>-->

                        <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="创建时间" HorizontalAlignment="Left"></TextBlock>

                        <TextBlock Grid.Row="13" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding CreateTime}" HorizontalAlignment="Left" Grid.ColumnSpan="2" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <TextBlock Grid.Row="14" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="修改时间" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="15" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding UpdateTime}" HorizontalAlignment="Left"
                           Grid.ColumnSpan="2" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                        <TextBlock Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource TextBlockStyle}" Text="外部成交单编号" HorizontalAlignment="Left"></TextBlock>
                        <TextBlock Grid.Row="17" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource TextBlockStyle}" Text="{Binding SecondaryTradeID}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>


                        <!--<TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="外部成交单编号" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="备注" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding SecondaryTradeID}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocText}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="报价方式" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="要素发送至" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding TrdType}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding AlloAccount}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="券面总额(万)" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="交易金额(元)" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>

                <TextBlock Grid.Row="8" Visibility="Collapsed" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="应计利息" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="8" Visibility="Collapsed" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="应计利息总额" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="9" Visibility="Collapsed" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                <TextBlock Grid.Row="9" Visibility="Collapsed" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>


                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="结算金额(元)" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding AllocQty}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                


                <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="创建日期" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="更新时间" HorizontalAlignment="Left"></TextBlock>
                <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource TextBlockStyle}" Text="{Binding TransactTime}" HorizontalAlignment="Left" Foreground="{StaticResource ColorBrush.While}"></TextBlock>
                <TextBlock Grid.Row="11" Grid.Column="1" Style="{StaticResource TextBlockStyle}" Text="{Binding UpdateTime}" HorizontalAlignment="Left"
                           Grid.ColumnSpan="2" Foreground="{StaticResource ColorBrush.While}"></TextBlock>-->


                    </Grid>

                </Border>

                <Grid Grid.Row="2" Background="{StaticResource ColorBrush.Gray13}">

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>
