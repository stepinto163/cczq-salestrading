<UserControl x:Class="STC.Execute.Plugin.View.Execute.ExecuteOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:command ="clr-namespace:STC.Execute.Plugin.Command"
             xmlns:Component="clr-namespace:STC.Execute.Plugin.View.Component" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore" 
             xmlns:utils="clr-namespace:STC.Execute.Plugin.Utils"
             xmlns:local="clr-namespace:STC.Execute.Plugin.View.Execute"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1420" Margin="2, 6, 2, 2">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ContextMenu x:Key="CopyContextMenu" Style="{StaticResource DefaultContextMenu}" ContextMenuOpening="UserControl_ContextMenuOpening">
                <MenuItem x:Name="copyRow" Header="复制" Style="{StaticResource DefaultMenuItem}" Click="copyRow_Click"/>
            </ContextMenu>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="TextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <VisualBrush x:Key="HintExchangeText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="24" Width="180" Background="{StaticResource SearchTextBox.Backgroud.ColorBrush}" FontSize="12" Foreground="{StaticResource TextBox.Static.Border}" Text="搜索代码、对手方"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#0B0C0C"/>
                <!--<Setter Property="BorderBrush" Value="#193D37"/>-->
                <!--<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>-->
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#3B3C3E"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                    <Setter TargetName="border" Property="Background" Value="#515151"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{StaticResource TextBox.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.MouseOver.Border}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#A0A0A0"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{StaticResource TextBox.Focus.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Focus.Border}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF"/>
                                </Trigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="false"/>
                                        <Condition Property="Text" Value=""/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource HintExchangeText}"/>
                                </MultiTrigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--绿色样式-->
            <Style x:Key="SplitButtonStyle" TargetType="{x:Type Button}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Background" Value="#136C5E"/>
                <!--<Setter Property="BorderBrush" Value="#00D198"/>-->
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderThickness" Value="0, 0, 0, 0"/>
                <!--<Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="80"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#146C5E"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#2CAB97"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#1C4B43"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Pressed.Border}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource RedButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource RedButton.Disabled.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource RedButton.Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



        </ResourceDictionary>
    </UserControl.Resources>



    <Grid Background="{StaticResource ColorBrush.Gray18}" x:Name="gridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="24"></RowDefinition>
            <RowDefinition Height="6*"></RowDefinition>
            <!--<RowDefinition Height="6"></RowDefinition>-->
            <RowDefinition Height="4*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="10"></ColumnDefinition>
            <ColumnDefinition Width="286"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"></ColumnDefinition>
                <ColumnDefinition Width="160"></ColumnDefinition>
                <ColumnDefinition Width="45"></ColumnDefinition>
                <ColumnDefinition Width="280" MinWidth="240"></ColumnDefinition>
                <ColumnDefinition Width="55"></ColumnDefinition>
                <ColumnDefinition Width="50*" MinWidth="160"></ColumnDefinition>
                <ColumnDefinition Width="50*"></ColumnDefinition>
                <ColumnDefinition Width="90"></ColumnDefinition>
                <ColumnDefinition Width="150"></ColumnDefinition>
                <ColumnDefinition Width="24"></ColumnDefinition>
                <ColumnDefinition Width="24"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="状态:" Style="{StaticResource TextBlockStyle}"></TextBlock>

            <local:ExecStatusFilter x:Name="statusFilter" Grid.Column="1" FilterDicChanged="ExecStatusFilter_FilterDicChanged"></local:ExecStatusFilter>

            <TextBlock Grid.Column="2" Text="渠道:" Style="{StaticResource TextBlockStyle}"></TextBlock>

            <local:BrokerFilter x:Name="brokerFilter" Grid.Column="3" FilterDicChanged="BrokerFilter_FilterDicChanged"></local:BrokerFilter>

            <TextBlock Grid.Column="4" Text="债券类型:" Style="{StaticResource TextBlockStyle}"></TextBlock>
            <local:SecurityTypeFilter x:Name="securityTypeFilters" Grid.Column="5" FilterDicChanged="securityTypeFilters_FilterDicChanged"></local:SecurityTypeFilter>

            <ComboBox x:Name="comboBox" Grid.Column="7" Width="90"  Height="18" SelectionChanged="ComboBox_SelectionChanged"
                          VerticalAlignment="Center" SelectedIndex="{Binding SelectedConditionIndex}"
                          Style="{StaticResource NonEditableComboBoxStyle}">
                <ComboBoxItem Content="债券代码" Tag="1"/>
                <ComboBoxItem Content="本方交易员" Tag="2"/>
                <ComboBoxItem Content="对手方" Tag="3"/>
            </ComboBox>

            <TextBox Padding="5, 0, 0, 0" Grid.Column="8" x:Name="btnSearch"
                         Style="{StaticResource SearchTextBoxStyle}" 
                         KeyDown="orderTextBox_KeyDown"
                         TextChanged="orderTextBox_TextChanged" VerticalAlignment="Center" Width="144" Height="18"
                         input:TextCompositionManager.PreviewTextInput="orderTextBox_PreviewTextInput"
                         input:TextCompositionManager.PreviewTextInputUpdate="orderTextBox_PreviewTextInputUpdate">
            </TextBox>

            <!--<Component:SearchTextBox x:Name="Search_TextBox" Grid.Column="6" HorizontalAlignment="Left" HintText="搜索代码、对手方"
                                 ValueChanged="Search_TextBox_ValueChanged"
                                 VerticalAlignment="Center" Width="144" Height="18" />-->

            <Button x:Name="btnExport" Grid.Column="9" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ExportButton}" Command="{Binding ExportCommand}"/>
            <!--<Button x:Name="btnFullScreen" Grid.Column="8" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PopupButton}" 
                    Command="{x:Static utils:CommonUtils.PopupWindowCommand}" CommandParameter="{x:Static command:PopupTypeEnum.VenuesExecution}"/>-->

        </Grid>

        <Component:CustomExecDataGrid Grid.Row="1" x:Name="Executions_dataGrid" Style="{StaticResource DefaultDataGrid}" ItemsSource="{Binding ExeOrderDV}" SelectionChanged="Executions_dataGrid_SelectionChanged"
                                      MouseRightButtonDown="Executions_dataGrid_MouseRightButtonDown">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="状态" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="tbTradeStat" Text="{Binding TradeStat, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='tradeStat'}" Foreground="{StaticResource ColorBrush.Yellow8}"/>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding TradeStat}" Value="1">
                                    <Setter TargetName="tbTradeStat" Property="Foreground" Value="{StaticResource ColorBrush.Green18}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="tbTradeStat" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="tbTradeStat" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="tbTradeStat" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="tbTradeStat" Value="Italic" />
                                </DataTrigger>
                            </DataTemplate.Triggers>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn MinWidth="80" Header="内码" Binding="{Binding Text}"></DataGridTextColumn>-->
                <DataGridTemplateColumn Header="内码" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="code" Text="{Binding Text}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="code" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="code" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="code" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="code" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="code" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Header="债券代码" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="15"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txSecurityID" Text="{Binding SecurityID}" Grid.Column="0"/>

                                <Border x:Name="background" Grid.Column="1" Height="12" Width="12" BorderThickness="0"  Visibility="Collapsed" ToolTip="{Binding ChangeMsg}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/STC.Execute.Plugin;component/Images/stc-status-yellow.png"/>
                                    </Border.Background>
                                </Border>

                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ChangeFlag}" Value="1">
                                    <Setter TargetName="background" Property="Visibility" Value="Visible"></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txSecurityID" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txSecurityID" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txSecurityID" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txSecurityID" Value="Italic" />
                                    </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="txSecurityID" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                            
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="债券简称" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txSymbol" Text="{Binding Symbol}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txSymbol" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txSymbol" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txSymbol" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txSymbol" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="txSymbol" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="债券类型" MinWidth="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="tbSecurityType" Text="{Binding SecurityType, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='securitytype'}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="tbSecurityType" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="tbSecurityType" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="tbSecurityType" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="tbSecurityType" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="tbSecurityType" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="方向" MinWidth="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="tbSide" Text="{Binding Side, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}" Foreground="{StaticResource ColorBrush.Orange}"/>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Side}" Value="2">
                                    <Setter TargetName="tbSide" Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="tbSide" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="tbSide" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="tbSide" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="tbSide" Value="Italic" />
                                </DataTrigger>
                            </DataTemplate.Triggers>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="成交价(%)" MinWidth="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txAvgPx" Text="{Binding AvgPx}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txAvgPx" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txAvgPx" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txAvgPx" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txAvgPx" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="txAvgPx" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="成交量(万)" MinWidth="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txAllocQty" Text="{Binding AllocQty}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txAllocQty" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txAllocQty" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txAllocQty" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txAllocQty" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="txAllocQty" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="交易日期" MinWidth="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txTradeDate" Text="{Binding TradeDate}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txTradeDate" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txTradeDate" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txTradeDate" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txTradeDate" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="txTradeDate" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn MinWidth="48" Header="清算速度" Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_execute'}"></DataGridTextColumn>-->
                <DataGridTemplateColumn Header="清算速度" MinWidth="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txSettlType" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_execute'}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txSettlType" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txSettlType" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txSettlType" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txSettlType" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="txSettlType" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!--<DataGridTextColumn MinWidth="32" Header="类型" Binding="{Binding TradeType, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='exeType'}"></DataGridTextColumn>-->
                <DataGridTemplateColumn Header="类型" MinWidth="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txTradeType" Text="{Binding TradeType, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='exeType'}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txTradeType" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txTradeType" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txTradeType" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txTradeType" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="txTradeType" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="本方交易员" MinWidth="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txPartySubName" Text="{Binding PartySubName}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txPartySubName" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txPartySubName" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txPartySubName" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txPartySubName" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
                                    <Setter Property="Foreground" TargetName="txPartySubName" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!--<DataGridTextColumn MinWidth="56" Header="对手方" Binding="{Binding CounterPartyName}"></DataGridTextColumn>-->
                <DataGridTemplateColumn Header="对手方" MinWidth="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txCounterPartyName" Text="{Binding CounterPartyName}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="txCounterPartyName" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="txCounterPartyName" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="txCounterPartyName" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="txCounterPartyName" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDelete}" Value="0">
