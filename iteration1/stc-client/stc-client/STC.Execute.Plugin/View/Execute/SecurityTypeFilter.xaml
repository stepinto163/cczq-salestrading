<UserControl x:Class="STC.Execute.Plugin.View.Execute.SecurityTypeFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Execute.Plugin.View.Execute"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="160">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.Execute.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="lbBroker" Background="Transparent" VerticalAlignment="Center" SelectionMode="Extended" SelectionChanged="LbBroker_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate>
                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ControlTemplate>
            </ListBox.Template>
            <ListBoxItem Content="全部" Width="40" Height="16" x:Name="All" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True" />
            <ListBoxItem Content="利率" Width="40" Height="16"  Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="信用" Width="40" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            <ListBoxItem Content="NCD" Width="40" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
        </ListBox>
    </Grid>
</UserControl>
