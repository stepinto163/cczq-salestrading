<local:WindowBase x:Class="STC.Frame.CustomUI.Component.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Title="CustomMessageBox" Width="380" SizeToContent="WidthAndHeight"
                  MaxboxEnable="False" MinboxEnable="False" ResizeMode="NoResize"
                  FocusManager.FocusedElement="{Binding ElementName=btnOK}"
                  Closing="WindowBase_Closing">
    <local:WindowBase.Resources>
        <ResourceDictionary>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
    </local:WindowBase.Resources>
    <local:WindowBase.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </local:WindowBase.InputBindings>
    <!--<Viewbox x:Name="RootViewbox" Stretch="None">-->
    <Grid x:Name="RootGrid" Background="{DynamicResource MainBackgroup.ColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MaxHeight="400"/>
                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ErroIcon" Width="16" Height="16" CornerRadius="8" Background="#E63034" Visibility="Collapsed">
                <TextBlock Text="×" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="InfoIcon" Width="16" Height="16" CornerRadius="8" Background="#00A84B" Visibility="Collapsed">
                <TextBlock Text="✔" Foreground="#FFFFFF"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="QuestionIcon" Width="16" Height="16" CornerRadius="8" Background="#E63034" Visibility="Collapsed">
                <TextBlock Text="!" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

        <ScrollViewer Margin="5,36,10,30" Grid.Column="1" MinWidth="260" 
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="viewer">
            <TextBlock x:Name="txtMessage"  Foreground="#FFFFFF" TextWrapping="Wrap" FontSize="{StaticResource NormalContentFontSize}"></TextBlock>
        </ScrollViewer>

        <Border Grid.ColumnSpan="2" Grid.Row="1" BorderBrush="#232323" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource CommonButtonStyle}" Background="#3C3C3C" Foreground="#FFFFFF" 
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Background="#136C5E" Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}"
                        Click="btnOK_Click" IsDefault="True">确定</Button>
                </StackPanel>

            </Border>
        </Grid>
    <!--</Viewbox>-->

</local:WindowBase>
