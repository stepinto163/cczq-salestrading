            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave">
                            <Border x:Name="Border"  Margin="0" Background="Transparent"  CornerRadius="2,2,2,2" BorderThickness="0" >

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition Width="13"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ContentSite" Text="{TemplateBinding Header}" Grid.Column="0" TextAlignment="Center" VerticalAlignment="Center"/>

                                    <Button x:Name="btnTabClose" Style="{StaticResource ImageCloseButton}" Width="10" Height="10" Grid.Column="1" Visibility="Hidden" Click="btn_Close_Click"/>

                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                --><!--<Setter TargetName="Border" Property="BorderThickness" Value="1"/>--><!--
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ColorBrush.Black8}"></Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ColorBrush.Red7}"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource ColorBrush.White2}"/>
                                <Setter TargetName="ContentSite" Property="TextBlock.FontFamily" Value="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                --><!--<Setter Property="Panel.ZIndex" Value="100"/>-->
                                <!--<Setter TargetName="Border" Property="TextBlock.Foreground" Value="#6E2022">--><!--
                                <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>








                    --><!--<ControlTemplate TargetType="TabItem">
                        --><!--<Border x:Name="Border"  Margin="0" Background="Transparent"  CornerRadius="2,2,2,2" BorderThickness="0" >--><!--
                            <Grid x:Name="templateRoot" SnapsToDevicePixels="true" MouseEnter="templateRoot_MouseEnter" MouseLeave="templateRoot_MouseLeave">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" BorderThickness="{TemplateBinding BorderThickness}" x:Name="mainBorder" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Margin="0">
                                    <Border Margin="0,0,0,0" x:Name="innerBorder" Background="Transparent" Visibility="Collapsed"/>
                                </Border>

                                <ContentPresenter  Grid.Column="0" x:Name="contentPresenter" Focusable="False" TextBlock.TextAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                    <ContentPresenter.Content>
                                        <local:EditableTabHeaderControl x:Name="ContentSite" Style="{StaticResource EditableTabHeaderControl}" 
                                                     Content="{Binding Header, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </ContentPresenter.Content>
                                </ContentPresenter>

                                <Button Grid.Column="1" Name="btn_Close" Width="10" Height="10" Visibility="Hidden" Style="{StaticResource ImageCloseButton}"  Click="btn_Close_Click"></Button>
                            </Grid>
                        --><!--</Border>--><!--

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Panel.ZIndex" Value="1"/>
