<UserControl x:Class="STC.Frame.CustomUI.MsgUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Frame.CustomUI"
             xmlns:CustomUI="clr-namespace:STC.Frame.CustomUI"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="358" Width="358" MouseLeftButtonDown="UserControl_MouseLeftButtonDown">

    <UserControl.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NoticeUrgebtButton" TargetType="Button">
                <Setter Property="Width" Value="65" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_urgebt_noraml.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_urgebt_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_urgebt_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoticeWarntButton" TargetType="Button">
                <Setter Property="Width" Value="65" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_warning_normal.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_warning_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_warning_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NoticeNormalButton" TargetType="Button">
                <Setter Property="Width" Value="65" />
                <Setter Property="Height" Value="65" />
                <Setter Property="Margin" Value="0, 0, 0, 3"/>
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.White2}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Ellipse Name="GelBackground">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_normal_normal.png"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <ContentPresenter Name="GelButtonContent" Margin="{TemplateBinding Margin}" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_normal_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Ellipse.Fill" TargetName="GelBackground">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="../Images/stc_iamge_noticewidget_normal_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Name="TabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Width" Value="100"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray18}"/>
                <!--<Setter Property="Foreground" Value="#FFEBC8"/>-->
                <Setter Property="Margin" Value="0, 0, 0, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <!--Width="120px" Height="30px"  Background="#21322F" Foreground="#FFEBC8"-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid>
                                <Border x:Name="Border"  Margin="0" Background="Transparent"  CornerRadius="2,2,2,2" BorderThickness="0" >
                                    <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Center" 
                                                  ContentSource="Header" 
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                   Margin="0,0,0,5"
                                                  
                                                  RecognizesAccessKey="True">
                                        <ContentPresenter.LayoutTransform>
                                            <RotateTransform Angle="0" />
                                        </ContentPresenter.LayoutTransform>
                                    </ContentPresenter>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <!--<Setter TargetName="Border" Property="BorderThickness" Value="1"/>-->
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource ColorBrush.Black8}"></Setter>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ColorBrush.Red7}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource ColorBrush.White2}"/>
                                    <Setter TargetName="ContentSite" Property="TextBlock.FontFamily" Value="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="False">
                                    <!--<Setter Property="Panel.ZIndex" Value="100"/>-->
                                    <!--<Setter TargetName="Border" Property="TextBlock.Foreground" Value="#6E2022">-->
                                    <Setter TargetName="ContentSite" Property="TextBlock.Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                                    <!--<Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FFA200" Offset="0"/>
                                                <GradientStop Color="#F76B1C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>-->
                                    <!--</Setter>-->
                                    <!--<Setter Property="Foreground" Value="#FFEBC8"/>-->
                                    <!--<Setter TargetName="Border" Property="BorderThickness" Value="0,0,0,2" />-->
                                </Trigger>
                                <!--<Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Background" Value="Silver"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="Black" />
                                    -->
                                <!--<Setter Property="Foreground" Value="#FFEBC8"/>-->
                                <!--
                                </Trigger>-->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Gray15}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0, 3, 0, 0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{TemplateBinding Background}"
                                    BorderThickness="1">

                                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Red7}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <!--<Setter Property="AutoGenerateColumns" Value="False"/>-->
                <!--<Setter Property="BorderThickness" Value="0"/>-->
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <!--<Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>-->
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" >
                            <Setter Property="BorderThickness" Value="0"/>
                            <!--<Setter Property="ToolTipService.ToolTip" Value="{Binding ToolText}"/>-->
                            <Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{Binding ShowBorderBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

           
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <Button x:Name="btnMsg" Style="{StaticResource NoticeNormalButton}" Click="btnMsg_Click"></Button>
        <Popup x:Name="popMsg" PlacementTarget="{Binding ElementName=btnMsg}" Visibility="Collapsed"
                   StaysOpen="False" Width="300" MaxHeight="500" MouseDown="popMsg_MouseDown" MouseLeave="popMsg_MouseLeave"
                   PopupAnimation="Slide" AllowsTransparency="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                <CustomUI:MsgFloatUI x:Name="firtMsg" Grid.Row="0" Visibility="Collapsed" Margin="0, 2, 0, 0" OnStoryboardComplete="OnStoryboardComplete"></CustomUI:MsgFloatUI>
