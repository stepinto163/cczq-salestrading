                <CustomUI:MsgFloatUI x:Name="threeMsg" Grid.Row="2" Visibility="Collapsed" Margin="0, 2, 0, 0" OnStoryboardComplete="OnStoryboardComplete"></CustomUI:MsgFloatUI>
            </Grid>
            
        </Popup>


