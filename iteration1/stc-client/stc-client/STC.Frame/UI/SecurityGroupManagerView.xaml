<UserControl x:Class="STC.Frame.UI.SecurityGroupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Frame.UI"
             xmlns:component="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:comp="clr-namespace:STC.Frame.CustomUI.Component"
             mc:Ignorable="d" >

    <!--Title="券组管理"  MinboxEnable="False" MaxboxEnable="False" 
             WindowStartupLocation="CenterScreen"
             Width="1000" Height="700" Closed="WindowBase_Closed"-->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="EditGroup_DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"></Setter>
                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="Height" Value="32"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource DefaultAlternatingRowBackground.ColorBrush}"/>
                    </Trigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Item.SelectedInactive.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedInactive.Border}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Item.SelectedInactive.Foreground}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Item.SelectedActive.Foreground}"/>
                    </MultiTrigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Item.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Item.MouseOver.Border}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--<component:WindowBase.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </component:WindowBase.InputBindings>-->
    <Grid Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0 20 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4">
                    <comp:SearchGroupTextBox Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="8 0 0 0" 
                                                  x:Name="Search_TextBox"
                                                  VerticalAlignment="Center" Width="104" Height="24"
                                                  SearchGroupText="{Binding SearchText,Mode=TwoWay}"/>
                    <Button x:Name="btnAdd" Grid.Column="1" Margin="4,0,4,0" HorizontalAlignment="Left"
                            Style="{DynamicResource  BlueGreenOrangeGraySlateButtonStyle}" 
                            Foreground="{DynamicResource DefaultGridForground}"
                            FontFamily="Microsoft YaHei"  FontSize="12" Padding="0,-1,0,0" Command="{Binding AddCommand}" 
                            Width="40" Height="24" Content="新增"></Button>
                    <Button x:Name="btnImport" Grid.Column="2" ToolTip="导入" Width="24" Height="24" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Style="{DynamicResource ImportButton2}" 
                            Command="{Binding ImportCommand}"/>
                    <Button x:Name="btnExport" Grid.Column="3" ToolTip="导出" Width="24" Height="24" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Style="{DynamicResource ExportButton2}" 
                            Command="{Binding ExportCommand}"/>

                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="4" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <RadioButton x:Name="ShowAll_ToggleButton" Content="SHOW ALL" Grid.Column="0" Width="80" Height="24" Margin="8 0 0 0"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          IsChecked="{Binding IsShowAll, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{DynamicResource ShowAllRadioButtonStyle}" />
                    
                    <ListBox x:Name="LstModules" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="4" Background="Transparent" VerticalAlignment="Center" SelectionMode="Single" 
                         SelectedIndex="{Binding TagSelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   Margin="0 4 0 0" Width="200">
                        <ListBox.Template>
                            <ControlTemplate>
                                <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBoxItem Content="ALL" Tag="0" Style="{DynamicResource FilterListBoxItemDodgerBlueAllStyle}" IsSelected="True" Width="40" HorizontalContentAlignment="Center" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,4" BorderThickness="0 1 0 0"/>
                        <ListBoxItem Content="主页" Tag="1" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="40" HorizontalContentAlignment="Center" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,4" BorderThickness="0 1 0 0"/>
                        <ListBoxItem Content="内部看板" Tag="2" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="64" HorizontalContentAlignment="Center" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal" Margin="4,0,0,4" BorderThickness="0 1 0 0"/>
                        <ListBoxItem Content="策略" Tag="3" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="40" HorizontalContentAlignment="Center" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,4" BorderThickness="0 1 0 0"/>
                        <ListBoxItem Content="双边做市" Tag="4" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="64" HorizontalContentAlignment="Center" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,4" BorderThickness="0 1 0 0"/>
                        <ListBoxItem Content="做市工作台" Tag="5" Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="76" HorizontalContentAlignment="Center" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal"  Margin="4,0,0,4" BorderThickness="0 1 0 0"/>
                    </ListBox>

                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="dynamicsGroupChk" Grid.Column="0" Content="动态组"
                                  IsChecked="{Binding DynamicsGroupChecked,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Width="Auto" 
                                  Padding="4 0 0 0" Margin="6 1 0 4" Foreground="#A0A0A0" VerticalAlignment="Top"></CheckBox>
                        <CheckBox x:Name="allInstGroupChk" Grid.Column="1" Content="全机构适用"
                                  IsChecked="{Binding AllInstGroupChecked,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                                  Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Width="Auto" 
                                  Padding="4 0 0 0" Margin="4 1 0 4" Foreground="#A0A0A0" VerticalAlignment="Top"></CheckBox>
                        <CheckBox x:Name="isMyself" Grid.Column="2" Content="我" Margin="4 1 0 4" VerticalAlignment="Top"
                                  Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Padding="4 0 0 0"
                                  Foreground="#A0A0A0"
                                  IsChecked="{Binding IsMyselfGroupChecked,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Row="1" BorderThickness="1,1,1,1" BorderBrush="#3C3C3C" Margin="8 8 8 8" CornerRadius="1,1,1,1">
                <DataGrid x:Name="GroupList" Style="{DynamicResource DefaultDataGrid}" 
                      HeadersVisibility="None" ItemsSource="{Binding GroupVS.View}" 
                      SelectionMode="Single" IsReadOnly="False" 
                      SelectedItem="{Binding SelectedGroupItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      SelectionChanged="GroupList_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="20">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="/STC.Common;component/Images/stc_icon_favorite_seleted.png" 
                                           Height="16" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                           Visibility="{Binding IsMyselfGroup,Converter={StaticResource visibilityConvertor}}"
                                           ToolTip="我的组" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*" Header="组名" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="{Binding groupname}" VerticalAlignment="Center">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="180" Header="标签" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Border x:Name="homeBorder" Background="#2D5D96"  
                                                    CornerRadius="2" Height="16" Width="30" HorizontalAlignment="Left" Margin="4 0 0 0" 
                                                    Visibility="{Binding IsHomeTag,Converter={StaticResource visibilityConvertor}}">
                                                <TextBlock x:Name="homeText" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"  
                                                           Text="主页" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="innerBorder" Background="#B03131"  
                                                    CornerRadius="2" Height="16" Width="30" HorizontalAlignment="Left" Margin="4 0 0 0" 
                                                    Visibility="{Binding IsINNERTag,Converter={StaticResource visibilityConvertor}}">
                                                <TextBlock x:Name="innerText" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"  
                                                           Text="内部" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="quantBorder" Background="#62358A"  
                                                    CornerRadius="2" Height="16" Width="30" HorizontalAlignment="Left" Margin="4 0 0 0" 
                                                    Visibility="{Binding IsQuantTag,Converter={StaticResource visibilityConvertor}}">
                                                <TextBlock x:Name="quantText" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"  
                                                           Text="策略" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="mmBorder" Background="#229B88"  
                                                    CornerRadius="2" Height="16" Width="30" HorizontalAlignment="Left" Margin="4 0 0 0" 
                                                    Visibility="{Binding IsMMTag,Converter={StaticResource visibilityConvertor}}">
                                                <TextBlock x:Name="mmText" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"  
                                                           Text="双边" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border x:Name="mmsheBorder" Background="#5F4E44"  
                                                    CornerRadius="2" Height="16" Width="30" HorizontalAlignment="Left" Margin="4 0 0 0" 
                                                    Visibility="{Binding IsMMSHETag,Converter={StaticResource visibilityConvertor}}">
                                                <TextBlock x:Name="mmsheText" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"  
                                                           Text="做市" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </Border>
        </Grid>
        <!--<GridSplitter x:Name="gridSplitter" MinWidth="7" Grid.Column="1"  Background="{DynamicResource MainBackgroup.ColorBrush}" Style="{DynamicResource VGridSplitterStyle2}"/>-->
        <Border x:Name="gridSplitter" MinWidth="7" Grid.Column="1"  Background="{DynamicResource MainBackgroup.ColorBrush}"/>
        <Border Grid.Column="1" BorderThickness="1,0,0,0" CornerRadius="0,0,0,0" BorderBrush="#3C3C3C" Background="{DynamicResource ColorBrush.Gray13}"/>

        <Grid Grid.Column="2" >
            <local:SecurityGroupDetailView x:Name="detailView"></local:SecurityGroupDetailView>
        </Grid>
    </Grid>
</UserControl>
