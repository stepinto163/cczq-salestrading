<Window x:Class="STC.Frame.UI.MessageBoxGUI4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:local="clr-namespace:STC.Frame.UI"
        x:Name="sysWarnGUI" mc:Ignorable="d"
        Title="SysWarnGUI" Height="130" Width="250"  Background="#0A0F0E" BorderThickness="1" BorderBrush="#193D37" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">

            <Setter Property="AllowDrop" Value="true"/>
            <Setter Property="Foreground" Value="{StaticResource ColorBrush.Yellow}"/>
            <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>

            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AllowDrop" Value="true"/>
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" CornerRadius="2" BorderThickness="1" BorderBrush="#186054" Background="{StaticResource ColorBrush.BlackishGreen2}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#172422"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground"  Value="#FFEBC8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#FF7D00"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground"  Value="#000"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="false">
                                <Setter Property="Foreground"  Value="Wheat"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                        <Condition Property="IsSelectionActive" Value="false"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel x:Name="dpMain" LastChildFill="True" >
        <Grid x:Name="gTitle" DockPanel.Dock="Top" Background="#193D37" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="tbTitle" x:FieldModifier="public" Text="提示" Margin="10,0,0,0" Grid.Column="0" VerticalAlignment="Center" Foreground="#F4E1C0"  FontSize="12px"></TextBlock>
            <Button  Grid.Column="2" Margin="0,0,10,0" Style="{DynamicResource ImageCloseButton}" Width="20" Height="20" Click="Button_Click" IsCancel="True"></Button>
        </Grid>
        <Grid x:Name="gDetail">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="20,0,0,5"  HorizontalAlignment="Left" x:Name="tbMsg"  x:FieldModifier="public" Text="请输入拷贝订单数量：" Width="auto"  VerticalAlignment="Center"  TextWrapping="Wrap" FontSize="12px" Foreground="#FFEBC8"/>
            <TextBox x:Name="tbCopyCount" Margin="150,0,0,5" Height="23" Width="25" HorizontalAlignment="Left" 
                     Text="1" input:InputMethod.IsInputMethodEnabled="False" PreviewKeyDown="tbCopyCount_PreviewKeyDown"
                     PreviewTextInput="tbCopyCount_PreviewTextInput" TextChanged="tbCopyCount_TextChanged"/>
            <Button  Grid.Row="1" Margin="40,0,0,5"  Height="20"  x:Name="btnClose" Content="取消" HorizontalAlignment="Left" Width="50"  Background="#136C5E" Foreground="#FFEBC8" Style="{StaticResource buttonCancelStyle}" Click="btnClose_Click" IsDefault="False"/>
            <Button  Grid.Row="1" Margin="150,0,0,5"  x:Name="btnConfirm" Content="确认"  HorizontalAlignment="Left" Width="50" Height="20"  Background="#136C5E" Foreground="#FFEBC8" Style="{StaticResource CommonButtonStyle}" Click="btnConfirm_Click" IsDefault="true"/>
        </Grid>

    </DockPanel>

</Window>
