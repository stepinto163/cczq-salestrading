<comp:WindowBase x:Class="STC.Frame.UI.AddGroupWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Frame.UI"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             Title="新增分组" Height="200" Width="400" ResizeMode="CanResize"
             MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen">
    <Grid FocusManager.FocusedElement="{Binding ElementName=groupname_txt}" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Bottom" Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55"></ColumnDefinition>
                <ColumnDefinition Width="200"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="分组名称: " Foreground="#D7D7D7" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBox x:Name="groupname_txt" Grid.Column="1"  Height="24" Style="{DynamicResource STCDefaultBoxStyle}"/>
            <CheckBox x:Name="careGroupChk" Grid.Column="2" Content="关注"
                      Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                      Height="14" Width="Auto" Padding="5 0 0 0" Margin="8 6 0 4" 
                      Foreground="#D7D7D7" VerticalAlignment="Top"
                      Checked="careGroupChk_Checked" Unchecked="careGroupChk_Unchecked"></CheckBox>
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="55,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="dynamicsGroupChk" Grid.Column="0" Content="动态组"
                      Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Height="14" Width="Auto" Padding="5 0 0 0" Margin="10 1 0 4" Foreground="#D7D7D7" VerticalAlignment="Top"></CheckBox>
            <CheckBox x:Name="allInstGroupChk" Grid.Column="1" Content="全机构适用"
                      Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Height="14" Width="Auto" Padding="5 0 0 0" Margin="4 1 0 4" Foreground="#D7D7D7" VerticalAlignment="Top"></CheckBox>

        </Grid>
        <Grid VerticalAlignment="Bottom" Margin="10,0,0,0" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Text="标签:" Foreground="#D7D7D7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <!--<TextBox x:Name="txRemark" Grid.Row="2" Grid.Column="1" Margin="2 0 0 0" HorizontalAlignment="Left"
                     Text="{Binding GroupItem.Inf2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Height="24" Width="200" Style="{DynamicResource STCDefaultBoxStyle}"/>-->
            <comp:TagComboBox x:Name="comTag" Grid.Row="2" Grid.Column="1" Margin="2 0 0 0" 
                              VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left"  
                              Height="24" Width="200" SelectedChanged="comTag_SelectedChanged"/>
        </Grid>
        
        <TextBlock x:Name="error_tb" Grid.Row="3" Foreground="#E63034" VerticalAlignment="Top"  Margin="65,8,0,0"/>
        
        <Border Grid.ColumnSpan="2" Grid.Row="4" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{DynamicResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnOK_Click" IsDefault="True">确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</comp:WindowBase>
