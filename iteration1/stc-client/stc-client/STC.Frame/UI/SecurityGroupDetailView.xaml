<UserControl x:Class="STC.Frame.UI.SecurityGroupDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Frame.UI"
             xmlns:commConv="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <commConv:DaysOffStrConverter x:Key="DaysOffCon"/>
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#A0A0A0"></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="32"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Text="组名称:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"/>
            <TextBox x:Name="txGroupName" Text="{Binding GroupItem.groupname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.ColumnSpan="2" Height="24" Width="308" 
                     Grid.Row="0" Grid.Column="1" Style="{DynamicResource STCDefaultBoxStyle}" Foreground="{DynamicResource DefaultGridForground}"
                     IsEnabled="{Binding IsEnable}"/>
            <CheckBox x:Name="careGroupChk" Grid.Column="3" Content="关注"
                          IsChecked="{Binding CareGroupChecked,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                          Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                          Width="Auto" Padding="4 0 0 0" Margin="8 6 0 4" 
                          Foreground="#D7D7D7" VerticalAlignment="Center"
                      Checked="careGroupChk_Checked" Unchecked="careGroupChk_Unchecked"
                      IsEnabled="{Binding IsEnable}"></CheckBox>
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="60,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="dynamicsGroupChk" Grid.Column="0" Content="动态组"
                          IsChecked="{Binding DynamicsGroupChecked,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                          Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                          Height="14" Width="Auto" Padding="4 0 0 0" Margin="8 1 0 4" 
                          Foreground="#D7D7D7" VerticalAlignment="Bottom"
                          IsEnabled="{Binding IsEnable}"></CheckBox>
                <CheckBox x:Name="allInstGroupChk" Grid.Column="1" Content="全机构适用"
                          IsChecked="{Binding AllInstGroupChecked,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                          Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                          Height="14" Width="Auto" Padding="4 0 0 0" Margin="4 1 0 4" 
                          Foreground="#D7D7D7" VerticalAlignment="Bottom"
                          IsEnabled="{Binding IsEnable}"></CheckBox>
            </Grid>
            <TextBlock Text="标签:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0"/>
            <comp:TagComboBox x:Name="comTag" Grid.Row="2" Grid.Column="1" Margin="6 0 0 0"  
                              VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left"  
                              Height="24" Width="308" SelectedChanged="comTag_SelectedChanged"
                              SelectedValues="{Binding SelectedValues,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsEnable}"/>
            <!--<TextBox x:Name="txRemark" Text="{Binding GroupItem.Inf2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.ColumnSpan="2" Height="24" Width="200" 
                     Grid.Row="2" Grid.Column="1" Style="{DynamicResource  DrpPriceAmountEditTextBox}"/>-->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3" Grid.ColumnSpan="4" Margin="0 0 10 0">
                <Button x:Name="btnDelete" Width="60" Height="24" Margin="4,0,4,0" Style="{DynamicResource GraySlateButtonStyle}"  BorderThickness="0,1,0,0"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding IsEnable}">删除</Button>
                <Button x:Name="btnUpdate" Width="100" Height="24" Style="{DynamicResource BlueGreenStyle}"  BorderThickness="0,1,0,0"
                        Command="{Binding UpdateCommand}"
                        IsEnabled="{Binding IsEnable}">修改</Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0,0,0,0" BorderBrush="#3C3C3C" Margin="0 4 0 0" Background="{DynamicResource ColorBrush.Gray13}"/>
        <StackPanel Orientation="Vertical"  Grid.Row="2">
            <StackPanel Orientation="Horizontal" Margin="0 10 0 4">
                <Button x:Name="btnRecognizeImport" ToolTip="批量导入" Width="24" Height="24" Margin="4,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Style="{DynamicResource ImportButton}" 
                        Command="{Binding RecognizeImportCommand}" IsEnabled="{Binding IsEnable}"/>
                <!--<CheckBox x:Name="IsHomeCb" Content="选择已有关注组" VerticalAlignment="Bottom" Margin="0 0 0 4"  
                      Style="{StaticResource GreenBlueCheckedNormalCheckBox}" Padding="4 1 0 0" Height="16"
                      IsChecked ="{Binding IsHomeChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Checked="IsHomeCb_Checked" Foreground="#D7D7D7"
                      Unchecked="IsHomeCb_Unchecked"/>
                <ComboBox ItemsSource="{Binding HomeGroupDic}" SelectedItem="{Binding SelectedHomeGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Style="{StaticResource NonEditableComboBoxStyle}" Margin="4 0 0 0" Width="132" Height="24" VerticalAlignment="Bottom" VerticalContentAlignment="Center"
                      SelectionChanged="ComboBox_SelectionChanged">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="btnImport" ToolTip="导入" Width="24" Height="24" Margin="4,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Style="{DynamicResource ImportButton2}" 
                        Command="{Binding ImportCommand}"/>-->
            </StackPanel>
            
        </StackPanel>
        <Border Grid.Row="3" BorderThickness="1,1,1,1" BorderBrush="#3C3C3C" Margin="8 8 8 8" CornerRadius="1,1,1,1">
            <DataGrid x:Name="GroupView" BorderThickness="1"
                  SelectedItem="{Binding SelectedBondItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding BondView}"
                  Style="{DynamicResource DefaultDataGrid}" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="48" MinWidth="40">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Button x:Name="btnAddBond" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Content="➕" Width="24" Height="24" 
                                        Style="{DynamicResource AddButtonStyle}" Margin="4 0 0 0"
                                        Command="{Binding DataContext.AddBondCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"                                       
                                        Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}"
                                        IsEnabled="{Binding DataContext.IsEnable, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                        ToolTip="添加"></Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center">
                                    <Button x:Name="delBondBtn" Content="一" Foreground="#A0A0A0" Width="24" Margin="0, 0, 6, 0" Height="24" ToolTip="删除" HorizontalAlignment="Center" Style="{DynamicResource GreenDeleteButtonStyle}" 
                                        Command="{Binding DataContext.DelBondCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                        Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}"
                                        IsEnabled="{Binding DataContext.IsEnable, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                            Click="delBondBtn_Click"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="*" Header="债券简称" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBlock Text="{Binding Symbol}" VerticalAlignment="Center">
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="100"  Width="*" Header="债券代码" CanUserSort="False" SortMemberPath="Value" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label Content="{Binding Securityid}" Foreground="#FFFFFF">
                                    <Label.ToolTip>
                                        <ToolTip  >
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </Label.ToolTip>
                                </Label>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="剩余期限" Width="Auto" MinWidth="105" SortMemberPath="RemainingTime">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                                <Setter Property="Padding" Value="9,0,5,0"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="remainingTimetb" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding RemainingTime}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Text}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RemainingTime}" Value="已到期">
                                        <Setter TargetName="remainingTimetb" Property="Foreground" Value="#B03131"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
