<comp:WindowBase x:Class="STC.Frame.UI.AddBondWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Frame.UI"
        xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Title="新增债券" Height="163" Width="320" ResizeMode="NoResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen"
                     FocusManager.FocusedElement="{Binding ElementName=bond_txt}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <DockPanel VerticalAlignment="Bottom" Margin="40,0,40,0">
            <TextBlock x:Name="bond_tb" Text="债券代码: " Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <comp:SearchTextBox x:Name="bond_txt" Height="24" AfterSearch="bond_txt_AfterSearch" ValueChanged="bond_txt_ValueChanged" IsMagnifierMode="False"
                                FocusBorderBrush="{DynamicResource TextBox.Focus.Border}" MouseOverBorderBrush="{DynamicResource TextBox.MouseOver.Border}"/>
        </DockPanel>
        <DockPanel x:Name="MaturityPanel" Grid.ColumnSpan="2" Grid.Row="1" Margin="40,0,40,0" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="该券已过期" Foreground="#E63034" DockPanel.Dock="Left"/>
            <TextBlock x:Name="symbolTb" Foreground="#FFFFFF" DockPanel.Dock="Right"/>
            <TextBlock/>
        </DockPanel>
       

        <Border Grid.ColumnSpan="2" Grid.Row="2" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{DynamicResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnOK_Click" IsEnabled="False">确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</comp:WindowBase>
