                        <Border x:Name="serverBorder" MinHeight="41" Grid.Row="4" Grid.Column="1">
                            <ComboBox x:Name="comboBoxServer" FontSize="14px" Padding="10, 0, 0, 0" Height="32" Foreground="#FFEBC8"   Background="#20FFEBC8" Style="{StaticResource  TransparentNonEditableComboBoxStyle }"
                                      VerticalContentAlignment="Center" VerticalAlignment="Top">
                                <!--<ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="item" Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>-->
                            </ComboBox>
                        </Border>

                        <Grid  Grid.Row="5" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="tbVlidCode" Visibility="Hidden" Grid.Column="0"  FontSize="14px"  Height="32" VerticalContentAlignment="Center" VerticalAlignment="Top" Style="{StaticResource SelfDefaultTextBoxStyle}"></TextBox>
                            <Image x:Name="IMVlidCode" Source="{Binding ImageSource}" Height="32" Grid.Column="2" Stretch="Fill" VerticalAlignment="Top"  />
                        </Grid>

                        <CheckBox x:Name="cbRemember" Grid.Row="7" Grid.Column="1" IsChecked="False" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" FontFamily="{DynamicResource DefaultFont}" FontSize="{DynamicResource NormalContentFontSize}" Style="{DynamicResource DefaultCheckBoxStyle}" Background="Transparent" BorderBrush="{DynamicResource SlateGrayButton.MouseOver.Border}" BorderThickness="2" Foreground="#FFEBC8" Content=" 记住密码" ></CheckBox>
                        <CheckBox x:Name="cbAutoLogin" Grid.Row="7" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right" Height="24" FontFamily="{DynamicResource DefaultFont}" FontSize="{DynamicResource NormalContentFontSize}" Style="{DynamicResource DefaultCheckBoxStyle}" Background="Transparent" BorderBrush="{DynamicResource BlueGreenButton.Static.Background}" Foreground="#FFEBC8" Content="自动登录" ></CheckBox>


                        <Button x:Name="btnLogin" Grid.Row="6"  Width="240" Height="34" Grid.Column="1" VerticalAlignment="Top" FontFamily="{DynamicResource IDCFontFamily.Regular}" FontSize="{DynamicResource NormalContentFontSize}" Style="{DynamicResource BlueGreenStyle}" Foreground="#FFEBC8" Content="登录" BorderThickness="0" IsDefault="True" Click="btnLogin_Click">
                        </Button>
                        <!--<Image x:Name="IMVlidCode" Source="{Binding ImageSource}" Stretch="Fill" Grid.Row="2" Grid.RowSpan="2" Grid.Column="2" Margin="10, 0, 10, 0"/>
                        <TextBox x:Name="tbVlidCode" Grid.Row="4" Grid.Column="2" Background="#20FFEBC8" Visibility="Hidden"  FontSize="14px" Margin="10, 2, 10, 0" Height="32" VerticalContentAlignment="Center" VerticalAlignment="Top" Style="{StaticResource SelfDefaultTextBoxStyle}"></TextBox>-->


                        <TextBlock x:Name="tbLoginPercent" Grid.Row="9" HorizontalAlignment="Right" Margin="0, 0, 10, 0" Foreground="Wheat" Grid.Column="2" Text=""/>

                        <ProgressBar x:Name="pbLoginProcess" Grid.Row="9" Grid.Column="0" BorderThickness="0" Height="6" Margin="0, 0, 7, 0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Value="50" Background="Transparent" Foreground="{DynamicResource BlueGreenButton.Static.Background}">
                        </ProgressBar>
                        <TextBlock x:Name="tbTips" Grid.Row="8" Grid.Column="1" Text="" Foreground="#FF3737" Style="{DynamicResource TBFont}" Visibility="Collapsed"  TextWrapping="Wrap" HorizontalAlignment="Center" ></TextBlock>

                        <Grid Grid.Row="8" Grid.Column="1" Margin="0, 12, 0, 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="53*"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="120"></ColumnDefinition>
                                <ColumnDefinition Width="52*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="1" Width="15" Height="15" Margin="8, 2, 4, 0" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                                <TextBlock.Background>
                                    <ImageBrush ImageSource="../Images/stc_icon_login_phone.png">
                                    </ImageBrush>
                                </TextBlock.Background>
                            </TextBlock>
                            <TextBlock x:Name="tbPhone" Grid.Row="0" Grid.Column="2"  TextAlignment="Center" Foreground="#FFEBC8" FontSize="12" Text="400-119-9898" Margin="0,12,0,5" Style="{DynamicResource TBFont}"></TextBlock>

                            <TextBlock x:Name="tbLable" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Foreground="#FFEBC8" TextAlignment="Left" FontSize="10" Text="© Powered by Sumscope" Margin="5,5,0,0" Style="{DynamicResource TBFont}"></TextBlock>

                        </Grid>



                    </Grid>

                </Border>

            </Grid>

            <fUI:LoadingMask x:Name="loadMask" Visibility="Collapsed" Grid.RowSpan="1" Grid.Row="0"></fUI:LoadingMask>
        </Grid>
    </Border>
</Window>
