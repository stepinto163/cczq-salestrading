<Window x:Class="STC.Frame.UI.LoginGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Frame.UI"
        xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
        mc:Ignorable="d"
AllowsTransparency="True" Background="Transparent" OpacityMask="White"
        x:Name="loginWindow" Title="登录" Height="400" Width="800" BorderThickness="0" Opacity="1"
         xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BDB.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TBFont" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"/>
                <Setter Property="FontSize" Value="{DynamicResource BigContentFontSize}"></Setter>
                <Setter Property="Foreground" Value="Wheat"></Setter>
            </Style>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back" Background="{DynamicResource ColorBrush.Green}" Width="30" BorderThickness="0" BorderBrush="Transparent" >
                                <TextBlock Padding="10, 5, 0, 0" Text="∨" FontSize="16" Foreground="#FFF1DA" />
                                <!--∧-->
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource ColorBrush.Green}"></Setter>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource ColorBrush.Green8}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransparentComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Focusable" Value="false"/>
                <Setter Property="ClickMode" Value="Press"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="templateRoot" SnapsToDevicePixels="true" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                <Border x:Name="splitBorder" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="{TemplateBinding Padding}" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
                                    <Path x:Name="arrow"  Stroke="#788187" StrokeThickness="1" Fill="#788187" Data="M 6,10 L 10,15 L 14,10"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--鼠标移过-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Stroke" TargetName="arrow" Value="{DynamicResource TabItem.Selected.Foreground}"/>
                                    <Setter Property="Fill" TargetName="arrow" Value="{DynamicResource TabItem.Selected.Foreground}"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource TabItem.Selected.Foreground}"/>

                                </MultiDataTrigger>
                                <!--鼠标按下-->
                                <Trigger Property="IsEnabled" Value="true">
                                    <Setter Property="Stroke" TargetName="arrow" Value="#788187"/>
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="true"/>
                                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource TabItem.Selected.Foreground}"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransparentComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="MinHeight" Value="20"></Setter>
                <Setter Property="MinWidth" Value="60"></Setter>
                <Setter Property="Foreground" Value="#FFEBC8"></Setter>
                <Setter Property="FontSize" Value="12"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border Name="Back" Background="Transparent" BorderThickness="0" CornerRadius="0" BorderBrush="{DynamicResource TabItem.Selected.Foreground}" Height="28" Padding="10, 0, 0, 0">
                                <ContentPresenter ContentSource="{Binding Source}" TextBlock.TextAlignment="Center" TextBlock.Foreground="#FFEBC8" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GreenBlueComboBoxItem.MouseOver.Background}"></Setter>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource TabItem.Selected.Border}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="TransparentComboBoxTemplate" TargetType="{x:Type ComboBox}">
                <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition MinWidth="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" Placement="Bottom">
                        <Themes:SystemDropShadowChrome x:Name="shadow" Color="Transparent" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                            <Border x:Name="dropDownBorder" BorderThickness="1 0 1 1" CornerRadius="0 0 2 2" Background="{DynamicResource GreenBlueComboBoxItem.Normal.Background}"  BorderBrush="{DynamicResource TextBox.Static.Border}">
                                <ScrollViewer x:Name="DropDownScrollViewer">
                                    <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                        <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                            <Rectangle x:Name="opaqueRect" Fill="{Binding Background, ElementName=dropDownBorder}" Height="{Binding ActualHeight, ElementName=dropDownBorder}" Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                        </Canvas>
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Themes:SystemDropShadowChrome>
                    </Popup>
                    <ToggleButton x:Name="toggleButton" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.ColumnSpan="2" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource TransparentComboBoxToggleButton}" Padding="0 2 10 0"/>
                    <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasDropShadow" SourceName="PART_Popup" Value="true">
                        <Setter Property="Margin" TargetName="shadow" Value="0,0,5,5"/>
                        <Setter Property="Color" TargetName="shadow" Value="#71000000"/>
                    </Trigger>
                    <Trigger Property="HasItems" Value="false">
                        <Setter Property="Height" TargetName="dropDownBorder" Value="95"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsGrouping" Value="true"/>
                            <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                    </MultiTrigger>
                    <Trigger Property="ScrollViewer.CanContentScroll" SourceName="DropDownScrollViewer" Value="false">
                        <Setter Property="Canvas.Top" TargetName="opaqueRect" Value="{Binding VerticalOffset, ElementName=DropDownScrollViewer}"/>
                        <Setter Property="Canvas.Left" TargetName="opaqueRect" Value="{Binding HorizontalOffset, ElementName=DropDownScrollViewer}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsDropDownOpen" Value="True"/>
                            <Condition SourceName="PART_Popup" Property="IsMouseOver" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="toggleButton" Property="BorderBrush" Value="{DynamicResource TabItem.Selected.Foreground}"></Setter>
                        <Setter TargetName="toggleButton" Property="BorderThickness" Value="1"></Setter>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsDropDownOpen" Value="True"/>
                            <Condition SourceName="PART_Popup" Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="toggleButton" Property="BorderBrush" Value="{DynamicResource TabItem.Selected.Foreground}"></Setter>
                        <Setter TargetName="toggleButton" Property="BorderThickness" Value="1"></Setter>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            
            <!--Combox-->
            <Style x:Key="TransparentNonEditableComboBoxStyle" TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="#400B0C0C"/>
                <Setter Property="BorderBrush" Value="#400B0C0C"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Padding" Value="6,0,5,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template" Value="{StaticResource TransparentComboBoxTemplate}"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource TransparentComboBoxItemStyle}"/>
            </Style>

            <Style x:Key="SelfDefaultTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#400B0C0C"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                    <Setter TargetName="border" Property="Background" Value="#515151"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#300F0F0F"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TabItem.Selected.Foreground}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#A0A0A0"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#300F0F0F"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TabItem.Selected.Foreground}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                
            </Style>

            <!-- 默认密码文本框 -->
            <Style x:Key="SelfPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
                <Setter Property="PasswordChar" Value="●"/>
                <Setter Property="Background" Value="{DynamicResource PasswordBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type PasswordBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource PasswordBox.Focus.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBox.MouseOver.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TabItem.Selected.Foreground}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource PasswordBox.Focus.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TabItem.Selected.Foreground}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="CaretBrush" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>

    </Window.Resources>
    <Border CornerRadius="10,10,10,10" x:Name="FullBorder">
        <Border.Background>
            <ImageBrush ImageSource="{Binding BackImage}">

            </ImageBrush>
        </Border.Background>
        <Grid Background="Transparent">

            <Grid x:Name="loginGrid">

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="1" Grid.Column="0" Visibility="Collapsed" x:Name="logoBorder" Width="173" Height="133" Margin="0, 0, 0, 40">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding BackImage}">

                        </ImageBrush>
                    </Border.Background>
                </Border>

                <!--<Button x:Name="btnLoginTest" Grid.Row="0" Margin="8, 2, 0, 0" Height="24" Width="100" Grid.Column="0" HorizontalAlignment="Left"
                            FontFamily="{StaticResource IDCFontFamily.Regular}" FontSize="10" Background="{StaticResource ColorBrush.Gray15}" Panel.ZIndex="1"
                            Style="{StaticResource ConfirmButtonStyle}" Foreground="#FFEBC8" Content="登陆测试环境 >" BorderThickness="0" Click="BtnLoginTest_Click">
                </Button>-->

                <Button x:Name="btnTestEnvironment" Grid.Row="0" Margin="8, 2, 0, 0" Height="24" Width="100" Grid.Column="0" HorizontalAlignment="Left" Panel.ZIndex="1"
                            FontFamily="{DynamicResource IDCFontFamily.Regular}" FontSize="{DynamicResource NormalContentFontSize}"
                            Style="{DynamicResource BlueGreenStyle}" Foreground="#FFEBC8" Content="测试环境" BorderThickness="0">
                </Button>


                <Grid Grid.Row="0" Grid.Column="1" Panel.ZIndex="1" Margin="0, 2, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="27"></ColumnDefinition>
                        <ColumnDefinition Width="27"></ColumnDefinition>
                        <ColumnDefinition Width="27"></ColumnDefinition>
                        <ColumnDefinition Width="10"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnPrdEnvironment" Grid.Row="0" Margin="8, 0, 0, 0" Height="24" Width="100" Grid.Column="0" HorizontalAlignment="Left"
                            FontFamily="{DynamicResource IDCFontFamily.Regular}" FontSize="{DynamicResource NormalContentFontSize}"
                            Style="{DynamicResource ConfirmButtonStyle}"  Background="{DynamicResource BlueGreenButton.Static.Background}" Foreground="#FFEBC8" Content="生产环境" BorderThickness="0">
                    </Button>


                    <!--<Button x:Name="btnLoginPrd" Grid.Row="0" Margin="8, 0, 0, 0" Height="24" Width="100" Grid.Column="0" HorizontalAlignment="Left"
                            FontFamily="{StaticResource IDCFontFamily.Regular}" FontSize="10" Background="{StaticResource ColorBrush.Gray15}"
                            Style="{StaticResource ConfirmButtonStyle}" Foreground="#FFEBC8" Content="登陆生产环境 >" BorderThickness="0" Click="BtnLoginPrd_Click">
                    </Button>-->


                    <Button x:Name="btnSetting" Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" Style="{DynamicResource MainPageSettingButton}" Width="20" Height="20" Click="btnSetting_Click"></Button>

                    <Button x:Name="btnMin" Grid.Row="1" Grid.Column="2" Margin="0,0,0,0" Style="{DynamicResource MainImageMinButton}"  Background="Transparent" Width="20" Height="20" Click="btnMin_Click"></Button>

                    <Button x:Name="btnClose" Grid.Row="1" Grid.Column="3" Margin="0,0,0,0" Style="{DynamicResource MainImageCloseButton}" Background="Transparent" Width="20" Height="20" Click="Button_Click"></Button>

                </Grid>


                <Border x:Name="loginBorder" CornerRadius="0, 10, 10, 0" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="#540C0F0E">

                    <!--<Border.Background>
                        <ImageBrush ImageSource="../Images/stc_image_login_redbg.png">

                        </ImageBrush>
                    </Border.Background>-->

                    <Grid x:Name="loGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"></RowDefinition>
                            <RowDefinition Height="112"></RowDefinition>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition Height="41"></RowDefinition>
                            <RowDefinition Height="0"></RowDefinition>
                            <RowDefinition Height="40"></RowDefinition>
                            <RowDefinition Height="24"></RowDefinition>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="13"></RowDefinition>
                        </Grid.RowDefinitions>

                        <!--<Grid Grid.Row="0" Grid.ColumnSpan="3" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="27"></ColumnDefinition>
                                <ColumnDefinition Width="27"></ColumnDefinition>
                                <ColumnDefinition Width="27"></ColumnDefinition>
                                <ColumnDefinition Width="10"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnSetting" Grid.Row="1" Visibility="Collapsed" Grid.Column="1" Margin="0,0,0,0" Style="{StaticResource ImageSettingButton}" Width="20" Height="20" Click="Button_Click"></Button>

                            <Button x:Name="btnMin" Grid.Row="1" Grid.Column="2" Margin="0,0,0,0" Style="{StaticResource ImageMinButton}" Width="20" Height="20" Click="btnMin_Click"></Button>

                            <Button x:Name="btnClose" Grid.Row="1" Grid.Column="3" Margin="0,0,0,0" Style="{StaticResource ImageCloseButton}" Width="20" Height="20" Click="Button_Click"></Button>

                        </Grid>-->

                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" Width="{Binding Width}" Height="54" x:Name="LoginLogo" Margin="{Binding Margin}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding LogoImage}" Stretch="{Binding Stretch}" Opacity="{Binding Opacity}" AlignmentY="Bottom">

                                    </ImageBrush>
                                </Border.Background>
                            </Border>

                            <TextBlock x:Name="tbVersion" Grid.Row="1" Text="V1.0.0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0, 0, 0, 20" Foreground="#FFEBC8" Style="{StaticResource TBFont}"></TextBlock>

                        </Grid>

                        <!-- 用户图标 -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" x:Name="UserStackPanel">
                            <TextBox x:Name="tbUsername" FontSize="14px" Padding="26, 0, 0, 0" Width="240" Height="32" VerticalContentAlignment="Center" VerticalAlignment="Top" Foreground="#FFEBC8" Background="#20FFEBC8" Style="{StaticResource  SelfDefaultTextBoxStyle}"></TextBox>
                            <Path Margin="8 -32 0 0" Width="16" Height="16" Fill="#FFEBC8" HorizontalAlignment="Left" VerticalAlignment="Center" UseLayoutRounding="True" 
                                  Data="M11.7,5.4C11.7,3.5,10.1,2,8,2C5.9,2,4.3,3.5,4.3,5.4c0,1.3,0.9,2.5,2.1,3C3.9,9,2,11.1,2,13.6
		                    C2,13.8,2.2,14,2.5,14s0.7-0.2,0.7-0.5c0-2.5,2.1-4.3,4.8-4.3s4.8,1.8,4.8,4.3c0,0.2,0.4,0.5,0.7,0.5c0.3,0,0.5-0.2,0.5-0.5
		                    c0-2.5-1.9-4.5-4.4-5.2C10.9,7.8,11.7,6.7,11.7,5.4z M8,3.3c1.3,0,2.4,1,2.4,2.2c0,1.2-1.1,2.2-2.4,2.2c-1.3,0-2.4-1-2.4-2.2
		                    C5.6,4.3,6.7,3.3,8,3.3z"/>
                        </StackPanel>

                        
                        <!-- 密码图标 -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" x:Name="PassStackPanel">
                            <PasswordBox x:Name="pbPwd" FontSize="16px" Padding="26, 0, 0, 0" Height="32" VerticalAlignment="Top" Foreground="#FFEBC8" Background="#20FFEBC8" Style="{StaticResource SelfPasswordBoxStyle}"></PasswordBox>
                            <Path  Margin="8 -32 0 0" Width="16" Height="16" Fill="#FFEBC8" HorizontalAlignment="Left" VerticalAlignment="Center" UseLayoutRounding="True" 
