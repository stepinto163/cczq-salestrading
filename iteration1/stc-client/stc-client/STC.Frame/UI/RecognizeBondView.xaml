<comp:WindowBase x:Class="STC.Frame.UI.RecognizeBondView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:local="clr-namespace:STC.Frame.UI"
             xmlns:comCon ="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             ResizeMode="CanResize"
             Title="批量导入" d:DesignWidth="1000"
             Height="700" Width="880"  Closed="WindowBase_Closed">
    <comp:WindowBase.Resources>
        <ResourceDictionary>
            <comCon:BooleanConvertor x:Key="booleanConvertor"/>
            <comCon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <comCon:DaysOffStrConverter x:Key="DaysOffCon"/>
            <comCon:NumberConvertor x:Key="numConvertor"/>
            <comCon:SubStringConverter x:Key="subStringConverter"/>
            <comCon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <comCon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="SideTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SelfVGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{DynamicResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Rectangle Width="1" Height="12" Stroke="#515151" Margin="0,0,2,0"/>
                                    <Rectangle Width="1" Height="12" Stroke="#515151" Margin="-2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 居中 -->
            <Style x:Key="SelfDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="SelfDataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Right"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="SelfDataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
                <Grid Height="25">
                    <Border Grid.Column="1" Background="#FFEBC8" Opacity="0"   Cursor="Hand"/>
                    <Path x:Name="Arrow" Grid.Column="1"  Margin="0,0,0,0"  Data="M 0 0  6 6 12 0 Z"  VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="None" Fill="#A0A0A0" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="true">
                        <Setter TargetName="Arrow" Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform   CenterX="6" CenterY="3" Angle="180"></RotateTransform>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Arrow" Property="Margin" Value="0 -5 0 2"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <Style TargetType="{x:Type ComboBox}" x:Key="DTitileComboxStyle">
                <Setter Property="BorderBrush" Value="#3C3C3C"></Setter>
                <Setter Property="Background" Value="#0F0F0F"></Setter>
                <Setter Property="Foreground" Value="#D7D7D7"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="25"/>
                                </Grid.ColumnDefinitions>
                                <Border  Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="1"/>
                                <ContentPresenter HorizontalAlignment="Left" Margin="3,3,0,3"  x:Name="ContentSite"  VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/>

                                <!--ToggleButton 已数据绑定到 ComboBox 本身以切换 IsDropDownOpen-->
                                <ToggleButton Grid.Column="1"  Grid.ColumnSpan="1"  Template="{StaticResource ComboBoxToggleButton}" x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                                <!--必须将 TextBox 命名为 PART_EditableTextBox，否则 ComboBox 将无法识别它-->
                                <TextBox   Visibility="Hidden" BorderThickness="0"   Margin="2 0 0 0" x:Name="PART_EditableTextBox"  VerticalAlignment="Center" Focusable="True" Background="#0F0F0F" IsReadOnly="{TemplateBinding IsReadOnly}"/>

                                <!--Popup 可显示 ComboBox 中的项列表。IsOpen 已数据绑定到通过 ComboBoxToggleButton 来切换的 IsDropDownOpen-->
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Margin="0,4,0,0" Placement="Bottom" x:Name="Popup"  Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" BorderThickness="1,0,1,1" BorderBrush="{TemplateBinding BorderBrush}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{TemplateBinding Background}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFEBC8" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#0F0F0F"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="true">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="MinHeight" Value="20"></Setter>
                            <Setter Property="Foreground" Value="#D7D7D7"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontFamily" Value="MicrosoftYaHeiSemibold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Back" CornerRadius="1" Background="#0F0F0F" >
                                            <ContentPresenter ContentSource="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="#3C3C3C"></Setter>
                                                <!--<Setter TargetName="Back" Property="BorderThickness" Value="1,0,1,1"></Setter>-->
                                                <Setter TargetName="Back" Property="BorderBrush" Value="#3C3C3C"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </comp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="8" x:Name="LeftRow"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TabControl x:Name="recogTypeTC" Grid.RowSpan="3"  Style="{DynamicResource TabControlStyle1}" 
                    Padding="0" BorderThickness="0" AllowDrop="True" 
                    DragDrop.DragEnter="TabControl_DragEnter" 
                    DragDrop.Drop="TabControl_Drop" 
                    PreviewKeyDown="img_PreviewKeyDown"
                    Margin="8 2 4 0">
            <TabItem x:Name="textTI" Header="原文识别" Width="138" Style="{DynamicResource TabItemStyle_Button}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderThickness="1,1,1,1" BorderBrush="#3C3C3C" CornerRadius="1,1,1,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <comp:WatermarkTextBox x:Name="contentTxt"  WaterMark="请粘贴报价信息&#x000A;如 200210.IB &#x000A;(支持粘贴多条信息)" VerticalContentAlignment="Top"
                             BorderThickness="0" Background="{DynamicResource MainBackgroup.ColorBrush}"
                             AcceptsReturn="True" TextWrapping="Wrap"></comp:WatermarkTextBox>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="btnClear" Grid.Row="1" Width="60" Height="24" Style="{DynamicResource GraySlateButtonStyle}"
                            Click="btnClear_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0"
                            HorizontalAlignment="Left">清空</Button>
                    <Button x:Name="btnRecognize" Grid.Row="1" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnRecognize_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0"
                            HorizontalAlignment="Right">去识别</Button>

                </Grid>
            </TabItem>

            <TabItem Header="筛选" Style="{DynamicResource TabItemStyle_Button}" Width="150" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <comp:DescriptionCtrl x:Name="desCtrl_Best" Margin="0 0 0 0" ItemsSource="{Binding DesSource}" HorizontalAlignment="Left"/>

                    <ScrollViewer x:Name="sv" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="filterGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>


                            <!--<TextBlock Text="产品:" Grid.Row="1" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="product" Grid.Row="1" Grid.Column="2" TagKey="PRODUCT" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="债券:" Grid.Row="2" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="securityType" Grid.Row="2" Grid.Column="2" TagKey="SecurityType" TagsListChanged="TagsListChanged"/>

                            <comp:FilterOptions x:Name="bondSubType" Grid.Row="3" Grid.Column="2" TagKey="BOND_SUB_TYPE" TagsListChanged="TagsListChanged"/>

                            <comp:FilterOptions x:Name="finBondType" Grid.Row="4" Grid.Column="2" TagKey="FIN_BOND_TYPE" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="地方债:" Grid.Row="5" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="localGovBondType" Grid.Row="5" Grid.Column="2" TagKey="LOCAL_GOV_BOND_TYPE" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="清算速度:" Grid.Row="6" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="settltype" Grid.Row="6" Grid.Column="2" Tag="SETTL_TYPE" Width="100" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" DefaultText="不限" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="期限:" Grid.Row="7" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="term" Grid.Row="7" Grid.Column="2" TagKey="TERM" TagsListChanged="TagsListChanged"/>
                            <comp:CustomTermControl x:Name="TermCtrl" Grid.Row="8" Grid.Column="2" Width="160" Height="24" HorizontalAlignment="Left" Margin="42 0 0 0" OKAction="TermCtrl_OKAction"/>

                            <TextBlock Text="永续债:" Grid.Row="9" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="perpetualType" Grid.Row="9" Grid.Column="2" Tag="PERPETUAL_TYPE" Width="100" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" DefaultText="不限" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="发行人:" Grid.Row="10" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiAutoCompleteComboBox x:Name="issuer" Grid.Row="10" Grid.Column="2" Width="120" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Watermark="" Tag="ISSUER" FilterDicChanged="MultiAutoCbb_FilterDicChanged" HasRecognizeBtn="True">
                            </comp:MultiAutoCompleteComboBox>

                            <TextBlock Text="担保人:" Grid.Row="11" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiAutoCompleteComboBox x:Name="guarantor" Grid.Row="11" Grid.Column="2" Width="120" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Watermark="" Tag="GUARANTOR" FilterDicChanged="MultiAutoCbb_FilterDicChanged" HasRecognizeBtn="True">
                            </comp:MultiAutoCompleteComboBox>

                            <TextBlock Text="企业:" Grid.Row="12" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="enterpriseType" Grid.Row="12" Grid.Column="2" TagKey="ENTERPRISE_TYPE" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="城投:" Grid.Row="13" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="ifMunicipal" Grid.Row="13" Grid.Column="2" TagKey="IF_MUNICIPAL" TagsListChanged="TagsListChanged"/>
                            <comp:FilterOptions x:Name="ifPlatform" Grid.Row="14" Grid.Column="2" TagKey="IF_PLATFORM" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="平台债:" Grid.Row="15" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="adminLevel" Grid.Row="15" Grid.Column="2" TagKey="ADMIN_LEVEL" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="主体:" Grid.Row="16" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="rankingType" Grid.Row="16" Grid.Column="2" TagKey="RANKING_TYPE" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="债项:" Grid.Row="17" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="ratingCurrent" Grid.Row="17" Grid.Column="2" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" DefaultText="不限" Tag="RATING_CURRENT" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="中债隐含:" Grid.Row="18" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="CDC_IMPLITED_RATING" Grid.Row="18" Grid.Column="2" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" DefaultText="不限" Tag="CDC_IMPLITED_RATING" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="中证隐含:" Grid.Row="19" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="CSI_IMPLIED_RATING" Grid.Row="19" Grid.Column="2" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" DefaultText="不限" Tag="CSI_IMPLIED_RATING" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="中债资信:" Grid.Row="20" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="ISSUER_RATING_CURRENT_CBR" Grid.Row="20" Grid.Column="2" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" DefaultText="不限" Tag="ISSUER_RATING_CURRENT_CBR" FilterDicChanged="Cbb_FilterDicChanged"/>

                            <TextBlock Text="NCD:" Grid.Row="21" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="NCD_TYPE" Grid.Row="21" Grid.Column="2" Width="100" Height="22" Background="Black" HorizontalAlignment="Left" VerticalAlignment="Center" DefaultText="不限" Tag="NCD_TYPE" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="发行:" Grid.Row="22" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="issue_type" Grid.Row="22" Grid.Column="2" TagKey="ISSUE_TYPE" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="利率方式:" Grid.Row="23" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="cal_inter_type" Grid.Row="23" Grid.Column="2" Width="140" Height="22" Background="Black" HorizontalAlignment="Left" VerticalAlignment="Center"  DefaultText="不限" Tag="CAL_INTER_TYPE" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="含权:" Grid.Row="24" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="CUM_TYPE" Grid.Row="24" Grid.Column="2" TagKey="CUM_TYPE" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="行业:" Grid.Row="25" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:HierarchicalComboBox x:Name="industry_type"  Grid.Row="25" Grid.Column="2"  Width="160" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" DefaultText="不限" Tag="INDUSTRY_TYPE" FilterDicChanged="HierarchicalComboBox_FilterDicChanged" IsEditable="True"/>

                            <TextBlock Text="地区:" Grid.Row="26" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="REGION_TYPE" Grid.Row="26" Grid.Column="2" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"  DefaultText="不限" Tag="REGION_TYPE" FilterDicChanged="Cbb_FilterDicChanged" IsEditable="True">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="年份:" Grid.Row="27" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="ISSUE_YEAR" Grid.Row="27" Grid.Column="2" Width="100" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"  DefaultText="不限" Tag="ISSUE_YEAR" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>

                            <TextBlock Text="特殊:" Grid.Row="28" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:FilterOptions x:Name="LISTED_MARKET" Grid.Row="28" Grid.Column="2" TagKey="LISTED_MARKET" TagsListChanged="TagsListChanged"/>

                            <TextBlock Text="假日:" Grid.Row="29" Foreground="#D7D7D7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0 4 0 0"/>
                            <comp:MultiSelectComboBox x:Name="HOLIDAY_TYPE" Grid.Row="29" Grid.Column="2"  Width="100" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"  Background="{DynamicResource MainBackgroup.ColorBrush}" DefaultText="不限" Tag="HOLIDAY_TYPE" FilterDicChanged="Cbb_FilterDicChanged">
                            </comp:MultiSelectComboBox>-->
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </TabItem>

        </TabControl>
        <Border x:Name="step1" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#3B3C3E" BorderThickness="0 1 0 0" />

        <!--分割-->
        <!--<GridSplitter x:Name="gridSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SelfVGridSplitterStyle2}" DragCompleted="gridSplitter_DragCompleted"/>-->
        <StackPanel Orientation="Horizontal" Margin="0 2 0 2" Grid.Row="0" Grid.Column="2">
            <CheckBox x:Name="IsHomeCb" Content="从已有组导入" VerticalAlignment="Bottom" Margin="4 0 0 4"  
                      Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" Padding="4 1 0 0" Height="16"
                      IsChecked ="{Binding IsHomeChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Checked="IsHomeCb_Checked" Foreground="#D7D7D7"
                      Unchecked="IsHomeCb_Unchecked"/>
            <ComboBox ItemsSource="{Binding HomeGroupDic}" 
                      SelectedItem="{Binding SelectedHomeGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Style="{DynamicResource NonEditableComboBoxStyle}" Margin="4 0 0 0" Width="160" Height="24" VerticalAlignment="Bottom" VerticalContentAlignment="Center"
                      SelectionChanged="ComboBox_SelectionChanged">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding groupname}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="btnImport" ToolTip="导入" Width="24" Height="24" Margin="4,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Style="{DynamicResource ImportButton2}" 
                        Command="{Binding ImportCommand}"/>
        </StackPanel>
        <Border BorderThickness="1,1,1,0" BorderBrush="#3C3C3C" CornerRadius="1,1,1,1" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="278*"/>
                    <ColumnDefinition Width="409*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid Grid.ColumnSpan="2">
                    <TextBlock Text="结果" FontWeight="Bold" Foreground="#D7D7D7" Margin="10 0 0 0" VerticalAlignment="Center"/>

                    <Button x:Name="btnTop10"  Grid.Row="1" Grid.ColumnSpan="3" Width="60" Height="24" Style="{DynamicResource BlueGreenStyle}"
                            HorizontalAlignment="Right" Margin="0 0 76 0" Command="{Binding Top10Command}">选择前10</Button>
                    <Button x:Name="btnTop50"  Grid.Row="1" Grid.ColumnSpan="3" Width="60" Height="24" Style="{DynamicResource BlueGreenStyle}"
                            HorizontalAlignment="Right" Margin="0 0 10 0" Command="{Binding Top50Command}">选择前50</Button>
                </Grid>
                <DataGrid x:Name="dg" Grid.Row="1" Margin="0 0 4 0"
                          ItemsSource="{Binding ViewSource.View}"
                          SelectedItem="{Binding SelectedItem_Recognize,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          Style="{DynamicResource DefaultDataGrid}" SelectionMode="Single" IsReadOnly="False" Grid.ColumnSpan="2"
                          LoadingRow="DataGrid_LoadingRow"
                          UnloadingRow="DataGrid_UnloadingRow">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="checkedColumn" MinWidth="40" Width="40" MaxWidth="40" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="CheckBox_All"
                                                    IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Style="{DynamicResource DefaultCheckBoxStyle}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{DynamicResource DefaultCheckBoxStyle}"></CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="序号" Width="Auto" MinWidth="40" MaxWidth="80" IsReadOnly="True"  HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="No_TB" Text="{Binding No}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="#8F9598" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="债券代码" MinWidth="80" Width="100" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="SecurityIDTB" Text="{Binding SecurityId}" Foreground="#F9C152"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecurityId}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="债券简称" MinWidth="80" Width="100" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Symbol" Text="{Binding Symbol}"  Foreground="#F9C152" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Symbol}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="剩余期限" Width="Auto" MinWidth="105" SortMemberPath="TimeToMaturity_Convert">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="14"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding TimeToMaturity}" FontWeight="SemiBold">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Text}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <Border x:Name="DayOff_Tag" BorderBrush="#C29B4E" BorderThickness="1" CornerRadius="2" Background="#C29B4E" Margin="2 0 0 0" >
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="休" Background="Black" Foreground="#C29B4E" FontSize="10" FontWeight="Bold" Padding="1"/>
                                                    <TextBlock Text="{Binding TimeToMaturityToWorkDay, Converter={StaticResource DaysOffCon}}" Grid.Column="1" Foreground="Black" FontSize="10" FontWeight="Bold" Padding="1"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TimeToMaturityToWorkDay, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                            <Setter TargetName="DayOff_Tag" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="昨日成交(笔)" Width="auto" MinWidth="80" SortMemberPath="OrderCount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OrderCount}"  FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="中债估值" Width="auto" MinWidth="80" SortMemberPath="CCDCValuation">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CCDCValuation,Converter={StaticResource numConvertor}}"  FontWeight="SemiBold"/>
                                        <!--<Image x:Name="DataInfo" Source="/STC.Common;component/Images/icon 更多信息.png" Margin="10 0 0 0" Width="12" Height="12" Visibility="Collapsed" ToolTip="{Binding CCDCValuation_Date}"/>-->
                                    </StackPanel>
                                    <!--<DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowLastWorkDay}" Value="!">
                                    <Setter Property="Visibility" TargetName="DataInfo" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>-->
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--<DataGridTemplateColumn Header="估值偏离" Width="auto" MinWidth="80" SortMemberPath="OrderCount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OrderCount}"  FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Foreground="#D7D7D7" FontWeight="Bold" VerticalAlignment="Center" Margin="10,12,0,12" Grid.ColumnSpan="2">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="共计有效结果: {0}条">
                            <Binding Path="DataCount"></Binding>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Grid.Column="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                <TextBlock Grid.Row="1" Text="添加至：" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 0 0"/>
                <ComboBox x:Name="addHomeGroup" ItemsSource="{Binding AddHomeGroupDic}" 
                          SelectedItem="{Binding SelectedAddHomeGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          Style="{DynamicResource NonEditableComboBoxStyle}" Margin="4 0 4 0" Width="96" Height="24" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          SelectionChanged="addHomeGroup_SelectionChanged">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding groupname}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="btnCancel" Grid.Row="1" Grid.ColumnSpan="3" Width="100" Height="24" Style="{DynamicResource GrayButtonStyle}"
                        HorizontalAlignment="Right" Margin="0 0 4 0" Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK"  Grid.Row="1" Grid.ColumnSpan="3" Width="120" Height="24" Style="{DynamicResource BlueGreenStyle}"
                        HorizontalAlignment="Right" Margin="0 0 10 0" 
                        IsDefault="True" Click="btnOK_Click">确定</Button>
            </StackPanel>
        </Grid>
    </Grid>
</comp:WindowBase>
