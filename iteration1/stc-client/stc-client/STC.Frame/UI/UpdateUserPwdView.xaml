<Window x:Class="STC.Frame.UI.UpdateUserPwdView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Frame.UI"
        Title="修改密码" Height="281" Width="344"  WindowStartupLocation="CenterScreen" ResizeMode="NoResize" BorderThickness="1" BorderBrush="#A0A0A0"
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" Background="#141414" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#282828" BorderThickness="1">
        <Grid Background="{StaticResource ColorBrush.Gray13}">
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource ColorBrush.Gray18}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="修改密码" Width="48" Margin="10, 5, 0, 0" FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Bold}" 
                           Foreground="{StaticResource ColorBrush.While}" FontSize="{StaticResource SmallContentFontSize}"/>
                <Button Click="btCancel_Click"   Width="16" Height="16" Grid.Column="2" IsCancel="True" Style="{StaticResource ImageCloseButton}" />
            </Grid>


            <Border Grid.Row="1" BorderThickness="0, 0, 0, 1" BorderBrush="{StaticResource ColorBrush.Gray19}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"></RowDefinition>
                        <RowDefinition Height="40"></RowDefinition>
                        <RowDefinition Height="20"></RowDefinition>
                        <RowDefinition Height="34"></RowDefinition>
                        <RowDefinition Height="20"></RowDefinition>
                        <RowDefinition Height="34"></RowDefinition>
                        <RowDefinition Height="16"></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                               FontSize="{StaticResource FontSize-12}" Foreground="{StaticResource ColorBrush.While}" Margin="20, 10, 0, 0">
                        <Run Text="每"></Run>
                        <Run Text="{Binding UpdatePwdDay}"></Run>
                        <Run Text="天需更改一次密码"></Run>
                    </TextBlock>

                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Text="原密码:" FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                               FontSize="{StaticResource FontSize-12}" Foreground="{StaticResource ColorBrush.While}" Margin="20, 0, 0, 0"></TextBlock>

                        <PasswordBox x:Name="pbOld" Grid.Column="1" Width="216" Height="24" Margin="4,0,0,2"
                                     Background="{StaticResource ColorBrush.Gray13}"                                        
                                         FontSize="14px" BorderBrush="{Binding OldPwdBorderBrush}"                                     
                                         VerticalAlignment="Bottom" VerticalContentAlignment="Center" Foreground="#FFFFFF " 
                                         KeyDown="tbWeight_KeyDown"                                     
                                         Style="{StaticResource DefaultPasswordBoxStyle}" BorderThickness="1"
                                         HorizontalAlignment="Left"></PasswordBox>

                    </Grid>

                    <TextBlock Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="密码不正确" FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                               FontSize="{StaticResource FontSize-10}" Foreground="{StaticResource ColorBrush.Red7}" Margin="88, 0, 0, 0" Visibility="{Binding OldPwdTxtVisibillity}"></TextBlock>

                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Text="新密码:" FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                               FontSize="{StaticResource FontSize-12}" Foreground="{StaticResource ColorBrush.While}" Margin="20, 0, 0, 0"></TextBlock>

                        <PasswordBox x:Name="pbNew" Grid.Column="1" Width="216" Height="24" Margin="4,0,0,2"
                                     Background="{StaticResource ColorBrush.Gray13}"                                        
                                         FontSize="14px" BorderBrush="{Binding NewPwdBorderBrush}"                                     
                                         VerticalAlignment="Bottom" VerticalContentAlignment="Center" Foreground="#FFFFFF " 
                                         KeyDown="tbWeight_KeyDown"                                     
                                         Style="{StaticResource DefaultPasswordBoxStyle}" BorderThickness="1"
                                         HorizontalAlignment="Left"></PasswordBox>

                    </Grid>

                    <TextBlock Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="{Binding PassErrorText}" FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                               FontSize="{StaticResource FontSize-10}" Foreground="{StaticResource ColorBrush.Gray14}" Margin="88, 0, 0, 0" Visibility="{Binding NewPwdTxtVisibillity}"></TextBlock>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Text="重复新密码:" FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                               FontSize="{StaticResource FontSize-12}" Foreground="{StaticResource ColorBrush.While}" Margin="20, 0, 0, 0"></TextBlock>

                        <PasswordBox x:Name="pbNewCopy" Grid.Column="1" Width="216" Height="24" Margin="4,0,0,2"
                                     Background="{StaticResource ColorBrush.Gray13}"                                        
                                         FontSize="14px" BorderBrush="{Binding NewCopyPwdBorderBrush}"                                     
                                         VerticalAlignment="Bottom" VerticalContentAlignment="Center" Foreground="#FFFFFF " 
                                         KeyDown="tbWeight_KeyDown"                                     
                                         Style="{StaticResource DefaultPasswordBoxStyle}" BorderThickness="1"
                                         HorizontalAlignment="Left"></PasswordBox>

                    </Grid>

                    <TextBlock Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Left" Text="二次输入不一致" FontFamily="{StaticResource IDCFontFamily.YaHei}" Visibility="{Binding NewCopyPwdTxtVisibillity}"
                               FontSize="{StaticResource FontSize-10}" Foreground="{StaticResource ColorBrush.Red7}" Margin="88, 0, 0, 0"></TextBlock>

                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>


                <Button Name="btCancel"                            
                            HorizontalAlignment="Right"
                            Grid.Column="0" Content="取消" IsCancel="True" 
                            IsDefault="True" 
                            Click="btCancel_Click"  
                            Width="100" Height="24"
                            FontSize="12"
                            Style="{StaticResource SmallCancelBtnStyle}"/>

                <Button Name="btOK" Grid.Column="1" Content="确认" IsEnabled="{Binding ConfirmEnable}"
                            HorizontalAlignment="Left"
                            IsDefault="True"  
                            Click="btOK_Click" 
                            Width="100" Height="24" 
                            Margin="10, 0, 0, 0" FontSize="12"
                            Foreground="#FFFFFF" Style="{StaticResource SmallConfirmBtnStyle}"/>

            </Grid>

        </Grid>
    </Border>
</Window>
