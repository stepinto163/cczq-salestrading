<comp:WindowBase x:Class="STC.Frame.UI.NetworkSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Frame.UI"
        xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        xmlns:val="clr-namespace:STC.Frame.Validation"
        xmlns:com="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
        mc:Ignorable="d"
        Title="网络设置" Height="258" Width="396" Background="Black">
    <comp:WindowBase.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->

            <com:RadioButtonConverter x:Key="radioBtnConverter"/>
        </ResourceDictionary>
    </comp:WindowBase.Resources>
    <Grid Margin="16 4 16 4">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <RadioButton Grid.Row="0" Grid.ColumnSpan="4" Content="不使用代理服务器" VerticalAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource DefaultRadioButtonStyle}" Foreground="#FFFFFF" IsChecked="{Binding AccessType, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
        <RadioButton Grid.Row="1" Grid.ColumnSpan="4" Content="使用与 Internet Explorer相同的代理设置" VerticalAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource DefaultRadioButtonStyle}" Foreground="#FFFFFF" IsChecked="{Binding AccessType, Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}"/>
        <RadioButton x:Name="proxyRd" Grid.Row="2" Grid.ColumnSpan="4" Content="使用如下代理服务器" VerticalAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource DefaultRadioButtonStyle}" Foreground="#FFFFFF" IsChecked="{Binding AccessType, Converter={StaticResource radioBtnConverter}, ConverterParameter='3'}"/>

        <RadioButton Grid.Row="3" GroupName="ProxyType" Grid.ColumnSpan="4" Margin="12 0 0 0" Content="HTTPS" VerticalAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource DefaultRadioButtonStyle}" Foreground="#FFFFFF" IsChecked="true" IsEnabled="{Binding IsChecked, ElementName=proxyRd}"/>
        
        <TextBlock Text="地址" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0" Foreground="#A0A0A0"></TextBlock>
        <TextBox x:Name="address_TB" Grid.Row="4" Grid.Column="1" Height="24" Style="{DynamicResource STCDefaultBoxStyle}" IsEnabled="{Binding AccessType, Converter={StaticResource radioBtnConverter}, ConverterParameter='3'}">
            <TextBox.Text>
                <Binding Path="ProxyHost" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                    <Binding.ValidationRules>
                        <val:ProxyValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <TextBlock Text="端口" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0" Foreground="#A0A0A0"></TextBlock>
        <TextBox x:Name="port_TB" Grid.Row="4" Grid.Column="3" Height="24" Style="{DynamicResource STCDefaultBoxStyle}" IsEnabled="{Binding AccessType, Converter={StaticResource radioBtnConverter}, ConverterParameter='3'}">
            <TextBox.Text>
                <Binding Path="ProxyPort" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                    <Binding.ValidationRules>
                        <val:ProxyValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <TextBlock Text="用户名" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0" Foreground="#A0A0A0"></TextBlock>
        <TextBox x:Name="user_TB" Grid.Row="5" Grid.Column="1" Height="24" Style="{DynamicResource STCDefaultBoxStyle}" IsEnabled="{Binding AccessType, Converter={StaticResource radioBtnConverter}, ConverterParameter='3'}">
            <TextBox.Text>
                <Binding Path="ProxyUser" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                    <Binding.ValidationRules>
                        <val:ProxyValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <TextBlock Text="密码" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 4 0" Foreground="#A0A0A0"></TextBlock>
        <TextBox x:Name="pwd_TB" Grid.Row="5" Grid.Column="3" Height="24"  Style="{DynamicResource STCDefaultBoxStyle}" IsEnabled="{Binding AccessType, Converter={StaticResource radioBtnConverter}, ConverterParameter='3'}">
            <TextBox.Text>
                <Binding Path="ProxyPassword" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                    <Binding.ValidationRules>
                        <val:ProxyValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="4"  Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Width="60" Height="24"
                            Click="btnCancel_Click" Style="{DynamicResource GrayButtonStyle}">取消</Button>
            <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" 
                        Click="btnOK_Click" Style="{DynamicResource BlueGreenStyle}">确定
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource multiAndConverter}">
                        <MultiBinding.Bindings>
                            <Binding ElementName="address_TB" Path="(Validation.HasError)"/>
                            <Binding ElementName="port_TB" Path="(Validation.HasError)"/>

                            <Binding ElementName="user_TB" Path="(Validation.HasError)"/>
                            <Binding ElementName="pwd_TB" Path="(Validation.HasError)"/>
                            
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
        </StackPanel>

    </Grid>
</comp:WindowBase>
