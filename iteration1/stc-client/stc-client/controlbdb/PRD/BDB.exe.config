<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="ServerGroupCfg" type="BDB.Common.Utils.Cfg.ServerCfgSection, BDB.Common" />
		<section name="ServerStatusGroupCfg" type="BDB.Common.Utils.Cfg.ServerStatusCfgSection, BDB.Common" />
		<section name="IsDcsBrokerGroupCfg" type="BDB.Common.Utils.Cfg.IsDcsBrokerCfgSection, BDB.Common" />
		<section name="RemoteServerGroupCfg" type="BDB.Common.Utils.Cfg.RemoteServerSection, BDB.Common" />
	</configSections>
	<RemoteServerGroupCfg>
		<RemoteServerGroup>
			<RemoteServer Id="1" Name="BDB" Host="qb3.idbhost.com" Port="28885" Protocol="TCPS" />
			<RemoteServer Id="3" Name="BDB" Host="121.36.130.55" Port="28885" Protocol="TCPS" />
		</RemoteServerGroup>
	</RemoteServerGroupCfg>
	<ServerGroupCfg>
		<ServerGroup>
			<Server Id="1" Name="StcLite" Host="127.0.0.1" Port="3000" Protocol="TCP" />
		</ServerGroup>
	</ServerGroupCfg>
	<ServerStatusGroupCfg>
		<ServerStatusGroup>
			<ServerStatus Id="6" VenueTypeGW="CDH" Name="经纪商" TargetSessionId="PRICE" />
			<ServerStatus Id="7" VenueTypeGW="SDN" Name="国债期货" TargetSessionId="PRICE" />
		</ServerStatusGroup>
	</ServerStatusGroupCfg>
	<IsDcsBrokerGroupCfg>
		<IsDcsBrokerGroup>
			<IsDcsBroker Id="1" Broker="TPSC" Name="国利" Status="1" />
			<IsDcsBroker Id="2" Broker="CNEX" Name="国际" Status="0" />
			<IsDcsBroker Id="3" Broker="CCTB" Name="中诚" Status="0" />
			<IsDcsBroker Id="4" Broker="PTCN" Name="平安" Status="1" />
			<IsDcsBroker Id="5" Broker="CTTJ" Name="信唐" Status="0" />
		</IsDcsBrokerGroup>
	</IsDcsBrokerGroupCfg>
	<appSettings>
		<add key="AppExe" value="BDB" />
		<add key="AppName" value="BDB" />
		<add key="Version" value="2.14.0" />
		<add key="LoginEnv" value="PRD" />
		<add key="LogPath" value="./logs/BDB_" />
		<add key="LogLevel" value="info" />
		<add key="ClientSettingsProvider.ServiceUri" value="" />
		<add key="CanGoodsQuickSearch" value="true" />
		<add key="MaxWarningCount" value="5" />
		<add key="LoginTitle" value="登录-PRD" />
		<!--计算器调用方式,1:bond,2:cfets-->
		<add key="CalType" value="1" />
		<!--是否单机-->
		<add key="IsSingle" value="false" />
		<!--是否启用拖拽窗口-->
		<add key="UserDrag" value="false" />
		<!--1：test, 2:prd-->
		<add key="EnvironmentFlag" value="2" />
		<add key="ApiKey" value="1" />
		<add key="StartDps" value="0" />
		<!--过滤指定topic前缀的日志打印-->
		<add key="FilterLog" value="stc.md,stc.ems.c.cdh,stc.ems.e.sdn,stc.base.search,stc.ohlc" />
		<!--是否显示最优来源-->
		<add key="ShowBestSource" value="2" />
		<!--债券K线入口是否启用-->
		<add key="IsKLine" value="0" />
		<!--国债期货K线入口是否启用-->
		<add key="IsKLine_F" value="1" />
		<!--没有首页权限时，默认打开页面 格式:{PluginKey}-{Description}-->
		<add key="DefaultPlugin" value="10-行情看板,89-内部看板,112-需求工作台"/>
		<!--没有首页权限时，默认选择页面 格式:{Description}-->
		<add key="DefaultFocusPlugin" value="行情看板"/>
		<add key="EnableIOC" value ="false"/>
		<!--开启DPI感知功能-->
		<add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
		<!--BDB是否分屏 0：无分屏功能 1：有分屏功能-->
		<add key="IsBDBSplit" value="1"/>
		<!--是否支持FQ-->
		<add key="IsFQ" value="0"/>
		<!--是否本地加载Crm交易员-->
		<add key="IsLocalCacheCrm" value="1"/>
		<add key="IsParserImage" value="1"/>
		<!--是否群聊全部不进 -->
		<add key="IsGroupFQNotEnter" value="false" />
		<!--是否支持QQ-->
		<add key="IsQQ" value="1"/>
                           <!--客户端自动退出时间-->
		<add key="ClientAutoExitTime" value="03:00:00"/>
		<!--是否写log -->
		<add key="IsWriteDBLog" value="true"/>
		<!--是否开启询价-->
		<add key="IsInquiry" value="false"/>
		<!--是否使用WebFinQ-->
		<add key="IsUseWebFinQ" value="0"/>
	</appSettings>
	<runtime>
		<gcConcurrent enabled="true" />
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<publisherPolicy apply="yes" />
			<probing privatePath="bin;plugin" />
		</assemblyBinding>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="log4net" culture="neutral" publicKeyToken="669e0ddf0bb1aa2a" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.12.0" newVersion="2.0.12.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
	</startup>
	<system.web>
		<membership defaultProvider="ClientAuthenticationMembershipProvider">
			<providers>
				<add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
			</providers>
		</membership>
		<roleManager defaultProvider="ClientRoleProvider" enabled="true">
			<providers>
				<add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
			</providers>
		</roleManager>
	</system.web>
</configuration>