<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<configSections>
		<section name="ServerGroupCfg" type="STC.Common.Model.Cfg.ServerCfgSection, STC.Common"/>
		<section name="ServerStatusGroupCfg" type="STC.Common.Model.Cfg.ServerStatusCfgSection, STC.Common"/>
		<section name="IsDcsBrokerGroupCfg" type="STC.Common.Model.Cfg.IsDcsBrokerCfgSection, STC.Common"/>
		<section name="RemoteServerGroupCfg" type="BDB.Common.Utils.Cfg.RemoteServerSection, BDB.Common"/>
	</configSections>
	<ServerGroupCfg>
		<ServerGroup>
			<Server Id="1" Name="DEV" Host="127.0.0.1" Port="2004" Protocol="TCP" DpsHost="172.16.129.107" DpsPort="2000" DpsProtocol="TCP" UpdateHost="172.16.129.107" UpdatePort="80" UpdateProtocol="http" />
		</ServerGroup>
	</ServerGroupCfg>
	<ServerStatusGroupCfg>
		<ServerStatusGroup>
			<ServerStatus Id="6" VenueTypeGW="CDH" Name="经纪商" TargetSessionId="PRICE"/>
			<ServerStatus Id="7" VenueTypeGW="SDN" Name="国债期货" TargetSessionId="PRICE"/>
		</ServerStatusGroup>
	</ServerStatusGroupCfg>

	<IsDcsBrokerGroupCfg>
		<IsDcsBrokerGroup>
			<IsDcsBroker Id="1" Broker="TPSC" Name="国利" Status="1"/>
			<IsDcsBroker Id="2" Broker="CNEX" Name="国际" Status="0"/>
			<IsDcsBroker Id="3" Broker="CCTB" Name="中诚" Status="0"/>
			<IsDcsBroker Id="4" Broker="PTCN" Name="平安" Status="1"/>
			<IsDcsBroker Id="5" Broker="CTTJ" Name="信唐" Status="0"/>
		</IsDcsBrokerGroup>
	</IsDcsBrokerGroupCfg>

	<appSettings>
		<add key="AppExe" value="BDB"/>
		<add key="AppName" value="BDB"/>
		<add key="Version" value="2.14.0"/>
		<add key="LoginEnv" value="QA"/>
		<add key="LogPath" value="./logs/BDB_" />
		<add key="LogLevel" value="info" />
		<add key="ClientSettingsProvider.ServiceUri" value="" />
		<add key="CanGoodsQuickSearch" value="true" />
		<add key="MaxWarningCount" value="5"/>
		<add key="LoginTitle" value="登录-QA"/>
		<!--计算器调用方式,1:bond,2:cfets-->
		<add key="CalType" value="1"/>
		<!--是否单机-->
		<add key="IsSingle" value="false"/>
		<!--是否启用拖拽窗口-->
		<add key="UserDrag" value="false"/>
		<!--是否显示最优来源-->
		<add key="ShowBestSource" value="2" />
		<!--1：test, 2:prd-->
		<add key="EnvironmentFlag" value="2" />
		<!--弹窗展示位置，0：按定位的x,y坐标，1：直接居中弹-->
		<add key="ShowPosition" value="0"/>
		<add key="QuoteBtnVisual" value="false"/>
		<!--记忆明细显示位置-->
		<add key="DetailPosition" value="true"/>
		<!--记忆线下录入显示位置-->
		<add key="ExecPosition" value="true"/>
		<!--重置缓存数据时间(格式:HH:mm:ss),默认为空-->
		<add key="ResetDataTime" value=""/>
		<add key="BridgeVisible" value="true"/>
		<add key="ApiKey" value="1" />
		<add key="StartDps" value="0" />
		<add key ="UseVenueSort" value ="0"/>
		<!--锁屏类型 0 不锁屏 -1 直接退出系统 1 锁屏 （锁屏启动条件  LockScreen<>0 && LockScreenMinute>0） -->
		<add key ="LockScreen" value ="1"/>
		<!--锁屏系统空闲时间 单位是分钟-->
		<add key ="LockScreenMinute" value ="15"/>
		<!--是否可修改密码 0：不可；默认或1：可以； -->
		<add key ="ChangePassMode" value="0"/>
		<add key ="LockScreenMinute" value ="0"/>
		<!--是否在个人设置鼠标右键显示演示程序菜单入口-->
		<add key="IsShowPlotDemoMenu" value="0" />
		<!--Chrome框架是否显示工具栏状态栏和右键菜单 1显示 0隐藏，没有该key则隐藏-->
		<add key="ChromeShowToolBar" value="0" />
		<!--是否在设置中显示特殊审批黑名单 1显示 0隐藏，没有该key则隐藏-->
		<add key="ShowBlackListSetting" value="1" />
		<!--隐藏【拉宽所有报价】按键;策略类型下拉选项去掉【接口】;算法报价中参考中间价下拉选项仅保留【中债估值】; 接口报价、成交报价设置隐藏; 0-不显示 1-显示  默认显示-->
		<add key="openMMDHideSet" value="0" />
		<!--是否在消息提醒中显示报价识别 1显示 0不显示-->
		<add key="IsShowCopyQuoteAlert" value="0" />
		<!--多个策略批量开启的时候，最小时间间隔(毫秒)-->
		<add key="BatchOpenIntervalTime" value="500" />
		<!--是否本地加载Crm交易员-->
		<add key="IsLocalCacheCrm" value="1"/>
		<!--过滤指定topic前缀的日志打印-->
		<add key="FilterLog" value="stc.md,stc.ems.c.cdh,stc.ems.e.sdn,stc.ohlc.ems.e,stc.base.search" />
		<!--是否本地加载Crm交易员-->
		<add key="IsLocalCacheCrm" value="1" />
		<!--是否显示条件撤销,1:显示-->
		<add key="IsShowPriceCondition" value="1" />
		<!--是否显示定向询价,1:显示-->
		<add key="IsShowDRP" value="1" />
		<!--定向报价不可撤销时间-->
		<add key="PendingCancelTime" value="15" />
		<!--是否显示内部看板报废区,1:显示-->
		<add key="IsShowInnerHistoryRequire" value="1" />
		<!--是否显示内部看板 模糊需求,1:显示-->
		<add key="IsShowInnerFuzzyRequire" value="0" />
		<!--皮肤 DefaultSkin，BlueSkin，BDB -->
		<add key="DefaultSkinStyle" value="DefaultSkin"/>
		<!--债券K线入口是否启用-->
		<add key="IsKLine" value="0"/>
		<!--国债期货K线入口是否启用-->
		<add key="IsKLine_F" value="1"/>
		<!--没有首页权限时，默认打开页面 格式:{PluginKey}-{Description}-->
		<add key="DefaultPlugin" value="10-行情看板,89-内部看板,112-需求工作台"/>
		<!--没有首页权限时，默认选择页面 格式:{Description}-->
		<add key="DefaultFocusPlugin" value="行情看板"/>
		<add key="EnableIOC" value ="false"/>
		<!--开启DPI感知功能-->
		<add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
		<!--是否支持内部看板最优显示样式-->
		<add key="IsInnerQtyDetail" value="1"/>
		<!--内部看板下单界面报量支持散量配置 只支持1-4位小数-->
		<add key="QtyDecimalDigit" value="3"/>
		<!--BDB是否分屏 0：无分屏功能 1：有分屏功能-->
		<add key="IsBDBSplit" value="1"/>
		<!--是否支持FQ-->
		<add key="IsFQ" value="0"/>
		<add key="IsParserImage" value="1"/>
		<!--是否群聊全部不进 -->
		<add key="IsGroupFQNotEnter" value="false" />
		<!--是否支持QQ-->
		<add key="IsQQ" value="1"/>
                           <!--客户端自动退出时间-->
		<add key="ClientAutoExitTime" value="03:00:00"/>
		<!--是否写log -->
		<add key="IsWriteDBLog" value="true"/>
		<!--是否开启询价-->
		<add key="IsInquiry" value="false"/>
		<!--是否使用WebFinQ-->
		<add key="IsUseWebFinQ" value="0"/>
	</appSettings>
	<runtime>
		<gcConcurrent enabled="true" />
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<publisherPolicy apply="yes" />
			<probing privatePath="bin;plugin" />
		</assemblyBinding>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="log4net" culture="neutral" publicKeyToken="669e0ddf0bb1aa2a" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.12.0" newVersion="2.0.12.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>

	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
	</startup>
	<system.web>
		<membership defaultProvider="ClientAuthenticationMembershipProvider">
			<providers>
				<add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
			</providers>
		</membership>
		<roleManager defaultProvider="ClientRoleProvider" enabled="true">
			<providers>
				<add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
			</providers>
		</roleManager>
	</system.web>
</configuration>
