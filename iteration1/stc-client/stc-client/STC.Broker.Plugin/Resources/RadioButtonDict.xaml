<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">




    <ControlTemplate x:Key="RadioButtonTemplate" 
                     TargetType="RadioButton">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Padding="0"
                   Visibility="Visible"
                   Name="label1"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Label.Content>
                    <Image Source="../Images/radio_button_normal.png"
                           Width="12"
                           Height="12" />
                </Label.Content>
            </Label>
            <Label Padding="0"
                   Visibility="Collapsed"
                   Name="label2"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Label.Content>
                    <Image Source="../Images/radio_button_selected.png"
                           Width="12"
                           Height="12" />
                </Label.Content>
            </Label>

            <ContentPresenter Name="content"
                              Grid.Column="1"
                              ContentSource="Content"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="2,0,0,0"
                              TextElement.FontSize="12"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked"
                     Value="True">
                <Setter TargetName="label2"
                        Property="Visibility"
                        Value="Collapsed" />
                <Setter TargetName="label1"
                        Property="Visibility"
                        Value="Visible" />
                <Setter TargetName="label1"
                        Property="Content">
                    <Setter.Value>
                        <Image Source="../Images/radio_button_selected.png"
                               Width="12"
                               Height="12" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="content"
                        Property="TextElement.Foreground"
                        Value="#F9C152" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="DefaultRadioButton" TargetType="{x:Type RadioButton }">
        <Setter Property="Foreground" Value="#FFEBC8"></Setter>
        <Setter Property="FontFamily" Value="Microsoft YaHei"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Template" Value="{StaticResource CheckBoxTemplate }">
        </Setter>
    </Style>
</ResourceDictionary>