<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:STC.Broker.Plugin">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/STC.Broker.Plugin;component/Resources/StyleDict.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <Style x:Key="ConfirmButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="MicrosoftYaHei"></Setter>
        <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"></Setter>
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                                    CornerRadius="2" Background="#136C5E" >
                        <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#178674"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#178674"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#115B4F"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#115B4F"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" TargetName="border" Value="#464646"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#464646"/>
                            <Setter Property="Foreground"  Value="#8F9598"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonStyle2" TargetType="Button" BasedOn="{StaticResource ConfirmButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.Medium}"></Setter>
        <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"></Setter>
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                                    CornerRadius="2" Background="{TemplateBinding Background}" >
                        <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#178674"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#178674"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#115B4F"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#115B4F"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="UserControlBorderStyle" TargetType="Border">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#0f7767"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="False">
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--birgde datagrid style-->
    <Style x:Key="BrigdeDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="None"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="FontSize" Value="{StaticResource NormalContentFontSize}"/>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Margin" Value="0,0,0,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="Background" Value="{StaticResource ColorBrush.BlackishGreen}"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex"  Value="1">
                            <Setter Property="Background" Value="#152421"  />
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex"  Value="0">
                            <Setter Property="Background" Value="#111917"  />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell" >
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers >
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#193D37"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--brigde row ordertext style-->
    <Style x:Key="RowBrigdeOrderText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei.SemiSold}" ></Setter>
        <Setter Property="Foreground" Value="{StaticResource DefaultForeground}" ></Setter>
    </Style>
    
    <!--brigde row button style-->
    <Style x:Key="RowButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                                    CornerRadius="2" Background="#193D37" >
                        <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#178674"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#178674"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#115B4F"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#115B4F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaselineButton" TargetType="{x:Type Button}">
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="#FFEBC8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <TextBlock x:Name="TB_Text" TextDecorations="Baseline" Style="{StaticResource RowBrigdeOrderText}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </TextBlock>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="TB_Text" Value="#178674"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="TB_Text" Value="#115B4F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--可拖动listbox item-->
    <Style TargetType="{x:Type ListBoxItem}" x:Key="DragListBoxItemStyle">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="#FFEBC8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ToolTip" Value="{Binding UsedLimitedShow}"/>
        <Setter Property="AllowDrop" Value="True"></Setter>
        <!--设置模板-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem" >
                    <Grid   Background="{TemplateBinding Background}" >
                        <TextBlock Text="{Binding Item1}" x:Name="tbItem1"
                                           Margin="5,0,35,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                           TextBlock.FontSize="{TemplateBinding FontSize}" 
                                           Foreground="{TemplateBinding Foreground}">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock Text="{Binding Item2}"  Background="{StaticResource ColorBrush.Green}"
                                           Padding="4,0,4,0"
                                           Margin="20,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                           TextBlock.FontSize="{TemplateBinding FontSize}" 
                                           Foreground="{TemplateBinding Foreground}">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!--<EventSetter Event="PreviewMouseMove" Handler="lsBridge_PreviewMouseMove"></EventSetter>
        <EventSetter Event="QueryContinueDrag" Handler="ListBoxItem_QueryContinueDrag"></EventSetter>-->
        <Style.Triggers>
            <!--触发器，通过设置 AlternationCount="2"ItemsControl.AlternationIndex 实现颜色交替显示 -->
            <Trigger Property="ItemsControl.AlternationIndex"  Value="1">
                <Setter Property="Background" Value="#152421"  />
            </Trigger>
            <Trigger Property="ItemsControl.AlternationIndex"  Value="0">
                <Setter Property="Background" Value="#111917"  />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected"  Value="True">
                <Setter Property="Background" Value="#173D37"  />
                <Setter Property="Foreground" Value="Yellow" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#173D37"  />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--listbox-->
    <Style TargetType="ListBox" x:Key="DragListBoxStyle">
        <Setter Property="Background" Value="#162220"/>
        <Setter Property="Foreground" Value="#D4C6A7"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DragListBoxItemStyle}"/>
       
        <!--设置模板-->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel  Orientation="Vertical" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="CommonButtonStyle" TargetType="{x:Type Button}">
        <!--<Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.Medium}"></Setter>-->
        <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"></Setter>
        <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                                    CornerRadius="2" Background="#136C5E" >
                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#178674"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#178674"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="#115B4F"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#115B4F"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" TargetName="border" Value="#464646"/>
                            <Setter Property="BorderBrush" TargetName="border" Value="#464646"/>
                        </Trigger>


                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BrokerNormalFont" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"/>
        <Setter Property="FontSize" Value="12px"/>
    </Style>

    <!-- 现金流按钮样式-->
    <Style TargetType="{x:Type Button}" x:Key="ImageCashButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                            <Border.Background>
                                <ImageBrush ImageSource="./Images/icon_operation_history_normal.png"/>
                            </Border.Background>
                        </Border>
                        <Grid>
                            <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="./Images/icon_operation_history_hover.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Control.Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="./Images/icon_operation_history_pressed.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Control.Background" TargetName="background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="./Images/icon_operation_history_disabled.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


