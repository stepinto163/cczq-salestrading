        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked"
                     Value="True">
                <Setter TargetName="label2"
                        Property="Visibility"
                        Value="Collapsed" />
                <Setter TargetName="label1"
                        Property="Visibility"
                        Value="Visible" />
                <Setter TargetName="label1"
                        Property="Content">
                    <Setter.Value>
                        <Image Source="../Images/radio_button_selected.png"
                               Width="12"
                               Height="12" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="content"
                        Property="TextElement.Foreground"
                        Value="#F9C152" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
