    <ControlTemplate x:Key="ShowStarCheckBoxTemplate" 
                     TargetType="CheckBox">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Padding="0"
                   Visibility="Visible"
                   Name="label1"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Label.Content>
                    <Image Source="../Images/Rectangle.png"
                           Width="12"
                           Height="12" />
                </Label.Content>
            </Label>
            <Label Padding="0"
                   Visibility="Collapsed"
                   Name="label2"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
                <Label.Content>
                    <Image Source="../Images/Check-Rectangle.png"
                           Width="12"
                           Height="12" />
                </Label.Content>
            </Label>

            <ContentPresenter Name="content"
                              Grid.Column="1"
                              ContentSource="Content"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="4,0,0,0"
                              TextElement.FontSize="12"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked"
                     Value="True">
                <Setter TargetName="label2"
                        Property="Visibility"
                        Value="Collapsed" />
                <Setter TargetName="label1"
                        Property="Visibility"
                        Value="Visible" />
                <Setter TargetName="label1"
                        Property="Content">
                    <Setter.Value>
                        <Image Source="../Images/Check-Rectangle.png"
                               Width="12"
                               Height="12" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="TitleTBFont" TargetType="{x:Type TextBlock}">
