<UserControl x:Class="STC.Broker.Plugin.View.Transaction.BridgeDesign.BridgeInfoUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction.BridgeDesign"
             mc:Ignorable="d" FontSize="14"
             d:DesignHeight="50" d:DesignWidth="800" Height="55">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/IDC.Broker.Plugin;component/BrokerDict.xaml"></ResourceDictionary>-->
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="textBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="textBlockStyle2" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Yellow}"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei.Bold}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="CommonLabelStyle" TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Green7}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="5,1,5,1"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Label}">
                            <Border x:Name="border" CornerRadius="10"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="buttonStyle" TargetType="{x:Type Button}">
                <!--<Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.Medium}"></Setter>-->
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"></Setter>
                <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                                    CornerRadius="2" Background="#136C5E" >
                                <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#178674"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#178674"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#115B4F"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#115B4F"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </Style>

            <!--<Style x:Key="customeMenuItemStyle" TargetType="{x:Type MenuItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border Margin="10, 10, 0, 0" x:Name="border" Background="{StaticResource ColorBrush.Green3}">
                                --><!--<StackPanel Orientation="Horizontal">--><!--
                                <ContentPresenter ContentSource="Header"/>
                                --><!--</StackPanel>--><!--


                                <Border.Effect>
                                    <DropShadowEffect x:Name="OG" BlurRadius="10" Color="#000000" Direction="50" Opacity="0.5" RenderingBias="Performance" ShadowDepth="1">
                                        <Storyboard.TargetProperty>BlurRadius</Storyboard.TargetProperty>
                                    </DropShadowEffect>
                                </Border.Effect>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderThickness" TargetName="border" Value="1"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource ColorBrush.Green8}"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource ColorBrush.Green}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>


                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>-->

            <Style x:Key="textBoxBridge" TargetType="{x:Type TextBox}">
                <Style.Resources>
                    <VisualBrush x:Key="HintText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left" >
                        <VisualBrush.Visual>
                            <TextBlock x:Name="tbVisual" Width="140" HorizontalAlignment="Left" Height="22" FontSize="14" Padding="5, 3, 0, 0" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"  Background="#0E1A18" Foreground="#8F9598" />
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Style.Resources>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.While}"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>

                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="CaretBrush" Value="#FFFFFF"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray15}" Background="#0F0F0F">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#0F0F0F"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00CDAD"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#0F0F0F"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00CDAD"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF"/>
                                </Trigger>
                               
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#0F0F0F" x:Name="xt_gd">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="35"></ColumnDefinition>
            <ColumnDefinition Width="150"></ColumnDefinition>
            <ColumnDefinition Width="47"></ColumnDefinition>
            <ColumnDefinition Width="120"></ColumnDefinition>
            <ColumnDefinition Width="61"></ColumnDefinition>
            <ColumnDefinition Width="120"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <!--<ColumnDefinition Width="50"></ColumnDefinition>-->
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Width="30" Text="机构:"  Style="{StaticResource textBlockStyle}"></TextBlock>
        <TextBlock Grid.Column="1" x:Name="tbInst" Width="auto" HorizontalAlignment="Left" Margin="5,0,0,0" Text="兴业证券"  Style="{StaticResource textBlockStyle2}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>

        <TextBlock Grid.Column="2" Width="auto" Text="联系人:" Style="{StaticResource textBlockStyle}"></TextBlock>
        <TextBlock Grid.Column="3" Width="auto" x:Name="tbContact" HorizontalAlignment="Left" Margin="5,0,0,0" Text="赵晓军" Style="{StaticResource textBlockStyle2}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>

        <TextBlock Grid.Column="4" Width="auto" Text="联系方式:" Style="{StaticResource textBlockStyle}"></TextBlock>
        <TextBlock Grid.Column="5" Width="auto" x:Name="tbContactType" HorizontalAlignment="Left" Margin="5,0,0,0" Text="1234567890" Style="{StaticResource textBlockStyle2}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>


        <TextBlock Grid.Row="1" Grid.Column="0" Width="30" Text="计费:" Style="{StaticResource textBlockStyle}"></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbCost"  Width="auto" HorizontalAlignment="Left" Margin="5,0,0,0" Text="机构(赵晓军)"  Style="{StaticResource textBlockStyle2}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>

        <TextBlock Grid.Row="1" Grid.Column="2" Width="30" Text="发给:" Style="{StaticResource textBlockStyle}"></TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="tbSendTo"  Width="auto" HorizontalAlignment="Left" Margin="5,0,0,0" Text="赵晓军" Style="{StaticResource textBlockStyle2}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>


        <Label Grid.Column="4" Grid.Row="1" Grid.ColumnSpan="2" Width="44" Height="20" Style="{StaticResource CommonLabelStyle}" HorizontalAlignment="Left">
            <TextBlock x:Name="tbWay" Text="对话" TextTrimming="CharacterEllipsis" Width="30" Height="20">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </Label>

        <TextBlock Grid.Column="5" Grid.Row="1"  Grid.ColumnSpan="2" x:Name="tbRemarks" MaxWidth="260" Height="20" Text="每日上限2E，后台较慢" 
                   HorizontalAlignment="Left" Margin="0, 0, 0, 0"
                   FontFamily="{StaticResource IDCFontFamily.YaHei}" Foreground="{StaticResource ColorBrush.PaleGrey}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>


        <TextBox x:Name="tbOrderId" Grid.Column="7" Grid.RowSpan="2" Width="98" Height="22" Style="{StaticResource textBoxBridge}" 
                         KeyDown="tbOrderId_KeyDown" PreviewKeyDown="tbOrderId_PreviewKeyDown" PreviewTextInput="tbOrderId_PreviewTextInput"
                     input:InputMethod.IsInputMethodEnabled="False">
            <TextBox.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBox.ToolTip>
        </TextBox>

        <StackPanel Orientation="Horizontal" Grid.Column="8" Grid.RowSpan="2" HorizontalAlignment="Right">
        <Button x:Name="btnAddBridge" Grid.Column="8" Grid.RowSpan="2"  Style="{StaticResource buttonStyle}" Content="添加" 
                        Width="45" Height="22" Click="btnAddBridge_Click" ></Button>

        <Button Margin="4,0,3,0" x:Name="btnDrawUp" Grid.Column="9" Grid.RowSpan="2"  Style="{StaticResource buttonStyle}" Content="预订" Visibility="Collapsed"
                        Width="45" Height="22" Click="btnDrawUp_Click"  ></Button>
        </StackPanel>
    </Grid>

   
</UserControl>
