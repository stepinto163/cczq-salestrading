                        </TextBox.ToolTip>
                    </TextBox>

                    <TextBox x:Name="tbOrderId"  Width="60" Height="22" Margin="10, 0, 0, 0" Style="{StaticResource textBoxOrderId}"
                         TextChanged="tbOrderId_TextChanged"  GotFocus="tbOrderId_GotFocus"
                         KeyDown="tbOrderId_KeyDown" PreviewKeyDown="tbOrderId_PreviewKeyDown" PreviewTextInput="tbOrderId_PreviewTextInput"
                     input:InputMethod.IsInputMethodEnabled="False">
                        <TextBox.ToolTip>
                            <ToolTip Content="{Binding Path=Text}"></ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <TextBox x:Name="tbGoodCode" Width="101" Height="22" Margin="10, 0, 0, 0" 
                         FontFamily="{StaticResource DefaultFont}" Style="{StaticResource textBoxBondCode}"
                         TextChanged="tbGoodCode_TextChanged" GotFocus="tbGoodCode_GotFocus"
                         PreviewKeyDown="tbGoodCode_PreviewKeyDown"
                         input:InputMethod.IsInputMethodEnabled="True" 
                         KeyDown="tbGoodCode_KeyDown">
                        <TextBox.ToolTip>
                            <ToolTip Content="{Binding Path=Text}"></ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <TextBox x:Name="tb_price" Width="80" Height="22" Margin="10, 0, 0, 0" 
                         FontFamily="{StaticResource DefaultFont}" Style="{StaticResource PriceTextBoxStyle}"
                         TextChanged="tb_price_TextChanged"
                         PreviewKeyDown="tb_price_PreviewKeyDown"
                         GotFocus="tb_price_GotFocus"
                         input:InputMethod.IsInputMethodEnabled="False" 
                         input:TextCompositionManager.PreviewTextInput="tb_price_PreviewTextInput"
                         KeyDown="tb_price_KeyDown">
                        <TextBox.ToolTip>
                            <ToolTip Content="{Binding Path=Text}"></ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" Grid.Column="3" Margin="10, 0, 0, 0">
                        <UserControls:MultipleCheckbox x:Name="ucTimeFilter" Height="22" Width="110" Margin="0,0,10,0"/>
                        <DatePicker x:Name="dpMaturityDate"  Background="Transparent"  Focusable="True"  Style="{StaticResource DefaultDatePickerStyle}"  Margin="0,0,5,0" Width="110" Height="22" SelectedDateChanged="dpMaturityDate_SelectedDateChanged"/>
                    </StackPanel>
                    <CheckBox x:Name="cbSort" Margin="10, 0, 0, 0" Height="15" Width="auto" Content="智能排序" 
                          FontFamily="{StaticResource DefaultFont}" 
                          Style="{StaticResource OrangeCheckedNormalCheckBox}" BorderBrush="#515151"  Background="Transparent" Foreground="#FFFFFF"
                          HorizontalAlignment="Center" Click="cbSort_Click"></CheckBox>
                    <Button x:Name="btnEditImage" Width="20"  HorizontalAlignment="Left"  
                                        Height="20" Style="{StaticResource ImageButtonStyle}">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_dark_disabled.png"/>
                        </Button.Background>
                        <Button.ToolTip>
                            <ToolTip>
                                <TextBlock Text="按券码、价格、Ofr方机构、Bid方机构、ofr交易日依次排序"></TextBlock>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <CheckBox x:Name="cb_Term" Margin="10, 0, 0, 0" Height="15" Width="auto" Content="期限排序" 
                          FontFamily="{StaticResource DefaultFont}" 
                          Style="{StaticResource OrangeCheckedNormalCheckBox}" BorderBrush="#515151"  Background="Transparent" Foreground="#FFFFFF"
                          HorizontalAlignment="Center" Click="cb_Term_Click">
                    </CheckBox>

                    <CheckBox x:Name="cbself" Margin="10, 0, 0, 0" Height="15" Width="auto" Content="我的桥" 
                          FontFamily="{StaticResource DefaultFont}" 
                          Style="{StaticResource OrangeCheckedNormalCheckBox}" BorderBrush="#515151" Background="Transparent" Foreground="#FFFFFF"
                          HorizontalAlignment="Center" Click="cbself_Click"></CheckBox>
                    <UserControls:MultipleCheckbox x:Name="mu_BridgeSelect" IsSingle="True" Height="22" Width="110" Margin="10,0,1,0"/>
                </StackPanel>


                <Grid Grid.Column="2" HorizontalAlignment="Right" Margin="0, 0, 10, 0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6*"/>
                        <RowDefinition Height="4*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.RowSpan="2" Orientation="Horizontal"  >
                        <Button  x:Name="btnRead"  Style="{StaticResource buttonStyle}" Content="查看" 
                        Width="60" Height="25" Click="btnRead_Click"  Margin="5, 0, 5, 0"></Button>
                        <Button  x:Name="btnAddBridge"  Style="{StaticResource buttonStyle}" Content="添加桥" 
                        Width="75" Height="25" Click="btnAddBridge_Click"  Margin="5, 0, 5, 0"></Button>
                        <Button  x:Name="btn_AddBridge" Style="{StaticResource AddBridgeButtonStyle}"  Visibility="Collapsed" 
                         Click="Btn_BatchCrossBridge_Click" Height="27"  Margin="5, 0, 5, 0">
                            <Button.ToolTip>
                                <ToolTip Content="一键加桥"></ToolTip>
                            </Button.ToolTip>
                        </Button>
                        <Button  x:Name="btnExport" Height="27" Style="{StaticResource ExportButtonStyle}" 
                         Click="btnExport_Click"  Margin="5, 0, 5, 0">
                            <Button.ToolTip>
                                <ToolTip Content="导出"></ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                    <!-- 桥状态更新计数标识 wxp 20200624 -->
                    <Label x:Name="lbBridgeUpdateCount"  
                           Content="{Binding BridgeUpdateCount, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BridgeWinNew}}}"  
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,3,0,0"  >
                        <Label.Style>
                            <Style TargetType="Label">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Label" >
                                            <Border CornerRadius="8" BorderThickness="0" Background="#E21D19" Width="20" Height="16">
                                                <ContentPresenter  HorizontalAlignment="Center" VerticalAlignment="Center"  TextBlock.Foreground="White" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="Content" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                </Grid>
            </Grid>
                
            <Grid x:Name="spBridge" Grid.Row="1" Margin="10, 0, 0, 10" ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="50" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--左区域-->
                <Grid >
                    <ListBox x:Name="lsBridge" Width="Auto" MinWidth="50" Drop="lsBridge_Drop" 
                             FontSize="14" 
                             ItemsSource="{Binding}"  Style="{StaticResource ListBoxStyle}"
                             SelectionChanged="lsBridge_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
                <!--分界线-->
                <GridSplitter Grid.Column="1"  Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Background="Black" />
                <!--右区域-->
                <Grid Grid.Column=" 2">
                    <local:BridgeUI x:Name="BridgeUI" Margin="0,0,0.4,0.4"  ></local:BridgeUI>
                </Grid>
            </Grid>
        </Grid>
    <!--</Border>-->
</UserControl>
