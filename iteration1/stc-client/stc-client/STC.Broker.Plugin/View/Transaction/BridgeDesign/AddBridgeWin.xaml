<Window x:Class="STC.Broker.Plugin.View.Transaction.BridgeDesign.AddBridgeWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction.BridgeDesign"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="加桥" Height="300" Width="300" WindowStyle="None" ResizeMode="NoResize" Closed="Window_Closed" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/IDC.Broker.Plugin;component/BrokerDict.xaml"></ResourceDictionary>-->
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="textBoxSearchStyle" TargetType="{x:Type TextBox}">
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>

                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray15}" Background="#0F0F0F">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#172422"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00CDAD"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#FF7D00"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#000"/>
                                </Trigger>
                                
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RichTextBoxStyle" TargetType="{x:Type RichTextBox}">
                <Setter Property="Background" Value="#0E1A18"/>
                <Setter Property="BorderBrush" Value="#193D37"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RichTextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#172422"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00CDAD"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#FF7D00"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="textBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontFamily" Value="PingFangSC-Semibold"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="Background" Value="#3C3C3C"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="1, 0, 1, 0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" Background="#3C3C3C"
                                    BorderThickness="0" CornerRadius="2">

                                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#238F7E"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="True"/>
            </Style>
            
        </ResourceDictionary>
    </Window.Resources>



    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="5"
                       GlassFrameThickness="0">
        </WindowChrome>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="2" BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray18}" Background="{StaticResource ColorBrush.Black7}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource LightGrayButton.Pressed.Border}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="35"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="加桥" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                           FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" Foreground="#FFFFFF"></TextBlock>

                <Button Grid.Column="2" x:Name="btnClose" Style="{StaticResource ImageCloseButton}" Width="20" Height="16" IsCancel="True" Click="btnClose_Click"></Button>
            </Grid>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="10"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="33"></RowDefinition>
                    <RowDefinition Height="33"></RowDefinition>
                    <RowDefinition Height="33"></RowDefinition>
                    <RowDefinition Height="33"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>


                <TextBlock Grid.Column="0" Grid.Row="0" Height="20" Text="机构(联系人)：" HorizontalAlignment="Right" 
                           VerticalAlignment="Bottom" Style="{StaticResource textBlockStyle}"></TextBlock>
                <TextBox x:Name="tbInst" Grid.Row="0" Grid.Column="1"
                     FontFamily="{StaticResource DefaultFont}"
                     Height="24" Width="174"  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Style="{StaticResource textBoxSearchStyle}"
                     KeyDown="tbInst_KeyDown"
                     PreviewKeyDown="tbInst_PreviewKeyDown"
                     TextChanged="tbInst_TextChanged"
                     ContextMenu="{x:Null}"
                     input:TextCompositionManager.PreviewTextInput="tbInst_PreviewTextInput"
                     input:TextCompositionManager.PreviewTextInputUpdate="tbInst_PreviewTextInputUpdate">
                    <TextBox.ToolTip>
                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                    </TextBox.ToolTip>
                    <TextBox.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandCanExecute"/>
                    </TextBox.CommandBindings>
                </TextBox>
                <TextBlock x:Name="tbWarn" Grid.Column="2" Grid.Row="0" Text="*" Foreground="Red"  FontSize="20" Height="20" Margin="12,12,0,0"
                           TextAlignment="Left" VerticalAlignment="Bottom" HorizontalAlignment="Left"  Visibility="Collapsed"></TextBlock>
              
                <TextBlock Grid.Column="0" Grid.Row="1"  Height="20" Text="机构(计费)：" HorizontalAlignment="Right" 
                           VerticalAlignment="Bottom" Style="{StaticResource textBlockStyle}"></TextBlock>
                <TextBox x:Name="tbInstFee" Grid.Row="1" Grid.Column="1"
                     FontFamily="{StaticResource DefaultFont}"
                     Height="24" Width="174"  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Style="{StaticResource textBoxSearchStyle}"
                     KeyDown="tbInstFee_KeyDown"
                     PreviewKeyDown="tbInstFee_PreviewKeyDown"
                     TextChanged="tbInstFee_TextChanged"
                     ContextMenu="{x:Null}"
                     input:TextCompositionManager.PreviewTextInput="tbInstFee_PreviewTextInput"
                     input:TextCompositionManager.PreviewTextInputUpdate="tbInstFee_PreviewTextInputUpdate">
                    <TextBox.ToolTip>
                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                    </TextBox.ToolTip>
                    <TextBox.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Paste" CanExecute="CommandCanExecute"/>
                    </TextBox.CommandBindings>
                </TextBox>
                <TextBlock x:Name="tbWarnFee" Grid.Column="2" Grid.Row="1" Text="*" Foreground="Red"  FontSize="20" Height="20" Margin="12,12,0,0"
                           TextAlignment="Left" VerticalAlignment="Bottom" HorizontalAlignment="Left"  Visibility="Collapsed"></TextBlock>
                <Popup x:Name="popInst" PlacementTarget="{Binding ElementName=tbInst}" StaysOpen="False" MaxHeight="300" Width="210" 
                   PopupAnimation="Slide" AllowsTransparency="False">
                    <DataGrid x:Name="dgTraderA" 
                                  Background="#193D37"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  MouseUp="dgTraderA_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True" 
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              Style="{StaticResource DataGridDefaultStyle}"
                          >
                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding InstTraderName}" Width="1*" >
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IdbKey}" Width="1*" Visibility="Collapsed">
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding InstIdbKey}" Width="1*" Visibility="Collapsed">
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Popup>
                <Popup x:Name="popInstFee" PlacementTarget="{Binding ElementName=tbInstFee}" StaysOpen="False" MaxHeight="300" Width="210" 
                   PopupAnimation="Slide" AllowsTransparency="False">
                    <DataGrid x:Name="dgInstFee" 
                                  Background="#193D37"
                                  ItemsSource="{Binding}" 
                                 HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  MouseUp="dgInstFee_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              Style="{StaticResource DataGridDefaultStyle}"
                          >
                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding InstTraderName}" Width="1*" >
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IdbKey}" Width="1*" Visibility="Collapsed">
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding InstIdbKey}" Width="1*" Visibility="Collapsed">
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Popup>


                <TextBlock Grid.Column="0" Grid.Row="2"  Height="20" Text="发给：" HorizontalAlignment="Right" 
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>
                <TextBox x:Name="tbSendTo" Grid.Row="2" Grid.Column="1" Background="#0C1917" BorderBrush="#186054" FontSize="14"
                         MaxLength="30"
                         VerticalAlignment="Bottom"  Width="174" Height="24" HorizontalAlignment="Left" VerticalContentAlignment="Center" Style="{StaticResource textBoxSearchStyle}">
                    <TextBox.ToolTip>
                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <TextBlock Grid.Column="0" Grid.Row="3"  Height="20" Text="渠道：" HorizontalAlignment="Right" 
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>

                <ListBox x:Name="lbChannel"
                         Grid.Column="1" Grid.Row="3"           
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Height="26"
                         Background="Transparent" 
                         BorderThickness="0" 
                         FontSize="14"              
                         SelectionMode="Extended"
                         VerticalAlignment="Bottom" 
                         BorderBrush="Transparent"   
                         SelectionChanged="lbChannel_SelectionChanged" Grid.ColumnSpan="2" Margin="0,0,48,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem x:Name="lbTalk" Width="51" Height="24" Style="{StaticResource ListBoxItemStyle}" Content="对话"/>
                    <ListBoxItem x:Name="lbRequest" Width="51" IsSelected="True" Height="24"  Style="{StaticResource ListBoxItemStyle}" Content="请求" />

                </ListBox>

                <TextBlock Grid.Column="0" Grid.Row="4"  Height="20" Text="备注：" HorizontalAlignment="Right" 
                           VerticalAlignment="Bottom" Style="{StaticResource textBlockStyle}"></TextBlock>

                <RichTextBox x:Name="tbRemarks" Grid.Row="4" Grid.Column="1"  Background="#0F0F0F "  BorderBrush="{StaticResource ColorBrush.Gray15}" FontSize="14" Padding="0, 2, 0, 0" Style="{StaticResource RichTextBoxStyle}"
                         VerticalAlignment="Bottom" Width="174" Height="24" HorizontalAlignment="Left" VerticalContentAlignment="Center">
                    
                </RichTextBox>

                <TextBlock Grid.Column="0" Grid.Row="5" Width="auto" Height="20" Text="联系方式：" HorizontalAlignment="Right" 
                           VerticalAlignment="Bottom" Style="{StaticResource textBlockStyle}"></TextBlock>
                <RichTextBox x:Name="tbContactType" Grid.Row="5" Grid.Column="1" Background="#0F0F0F " BorderBrush="{StaticResource ColorBrush.Gray15}" FontSize="12" Padding="0, 2, 0, 0" Style="{StaticResource RichTextBoxStyle}"
                         VerticalAlignment="Bottom" Width="174" Height="24" HorizontalAlignment="Left" VerticalContentAlignment="Center">

                </RichTextBox>
                <!--<TextBox x:Name="tbRemarks" Grid.Row="3" Grid.Column="1" Background="#0C1917" BorderBrush="#186054" FontSize="12"
                         VerticalAlignment="Bottom" Width="150" Height="22" HorizontalAlignment="Left" VerticalContentAlignment="Center" Style="{StaticResource DefaultTextBoxStyle}">
                    <TextBox.ToolTip>
                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                    </TextBox.ToolTip>
                </TextBox>-->

                <StackPanel x:Name="spButtons" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnCancel" Focusable="False" Content="取消" Background="#464646" Margin="0, 0, 4, 0"
                            FontFamily="{StaticResource DefaultFont}"  FontSize="12px" Foreground="#FFEBC8" 
                            Width="90" Height="24" Style="{StaticResource CancelButtonStyle}" BorderThickness="0" Click="btnCancel_Click" />
                    <Button x:Name="btnConfirm" Content="确定" IsEnabled="True" Background="#238F7E" 
                            FontFamily="{StaticResource DefaultFont}"  FontSize="{StaticResource NormalContentFontSize}" 
                            Foreground="#FFEBC8" Width="90" Height="24" Style="{StaticResource ConfirmButtonStyle}" 
                            BorderThickness="0"  Click="btnConfirm_Click"/>
                </StackPanel>

            </Grid>
            
        </Grid>
    </Border>
</Window>
