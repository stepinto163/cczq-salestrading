                                <TextBlock x:Name="tbBridgeStatus" Height="22" Text="{Binding BridgeStateShow}" 
                                           FontFamily="{StaticResource IDCFontFamily.YaHei.SemiSold}"
                                           Foreground="{Binding Path= Text,RelativeSource={RelativeSource self}, Converter={StaticResource BridgeStatusColorConverter }}"
                                           TextTrimming="CharacterEllipsis" >
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <!--编辑-->
                <DataGridTemplateColumn Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent"  x:Name="bdEditImage" Loaded="bdEditImage_Loaded">
                                <Button x:Name="btnEditImage" Width="20" HorizontalAlignment="Left" IsEnabled="{Binding EditIsEnable}"
                                        Height="16" Style="{StaticResource EditImageButtonStyle}" Click="btnEditImage_Click">
                                    <Button.Background>
                                        <ImageBrush ImageSource="{Binding Path=EditImageSource}"></ImageBrush>
                                    </Button.Background>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--添加O桥-->
                <DataGridTemplateColumn Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" x:Name="bdOfrImage" Loaded="bdOfrImage_Loaded">
                                <Button x:Name="btnOfrImage" Width="20" HorizontalAlignment="Left" IsEnabled="{Binding OfrIsEnable}"
                                        Height="16" Style="{StaticResource OfrImageButtonStyle}" Click="btnOfrImage_Click">
                                    <Button.Background>
                                        <ImageBrush ImageSource="{Binding Path=OfrImageSource}"></ImageBrush>
                                    </Button.Background>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--添加B桥-->
                <DataGridTemplateColumn Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" x:Name="bdBidImage" Loaded="bdBidImage_Loaded">
                                <Button x:Name="btnBidImage" Width="20" HorizontalAlignment="Left" IsEnabled="{Binding BidIsEnable}"
                                        Height="16" Style="{StaticResource BidImageButtonStyle}" Click="btnBidImage_Click">
                                    <Button.Background>
                                        <ImageBrush ImageSource="{Binding Path=BidImageSource}"></ImageBrush>
                                    </Button.Background>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--历史-->
                <DataGridTemplateColumn Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" x:Name="bdHisrtoy" >
                                <Button x:Name="btnHiistory"  Width="20" HorizontalAlignment="Left"  Content="{Binding BridgeisCheckedShow}"
                                        Height="20"  Click="btnHiistory_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Grid>
                                                            <Border x:Name="border" Height="{TemplateBinding Height}" 
                                                                    Width="{TemplateBinding Width}" 
                                                                    Opacity="{TemplateBinding Opacity}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"      
                                                                    CornerRadius="2">
                                                                <Border.Background><!--Value="pack://application:,,,/STC.Frame;component/Images/icon_operation_delete_normal.png"-->
                                                                    <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_normal.png"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter Property="Background" TargetName="border">
                                                                    <Setter.Value>
                                                                        <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_hover.png"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="true">
                                                                <Setter Property="Control.Background" TargetName="border">
                                                                    <Setter.Value>
                                                                        <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_pressed.png"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="false">
                                                                <Setter Property="Control.Background" TargetName="border">
                                                                    <Setter.Value>
                                                                        <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_normal.png"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="Content" Value="未查看">
                                                                <Setter Property="Control.Background" TargetName="border">
                                                                    <Setter.Value>
                                                                        <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_selected.png"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </local:BridgeDataGridEx.Columns>
        </local:BridgeDataGridEx>
        <!--ofr桥机构列表弹出框-->
        <utils:TextBoxPopup x:Name="popOfr" StaysOpen="False" MaxHeight="300" Width="220" Grid.ColumnSpan="2" Margin="0,0,67,0"
                   PopupAnimation="Slide" AllowsTransparency="False">
            <Border BorderBrush="#3C3C3C" BorderThickness="1" Background="#1E1E1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                    <DockPanel Width="370" Background="#1E1E1E" Grid.Row="0">
                    <!--搜索框-->
                    <TextBox x:Name="tbOfrBridgeKey" Margin="4,2,4,0" Width="210"  Height="24" KeyDown="tbOfrBridgeKey_KeyDown" HorizontalAlignment="Left"
                        TextChanged="tbBridgeKey_TextChanged"  Style="{StaticResource DefaultTextBoxStyle}"
                        input:InputMethod.IsInputMethodEnabled="True"  Background="#0F0F0F"
                        PreviewKeyDown="tbOfrBridgeKey_PreviewKeyDown">>
                    </TextBox>
                </DockPanel>
                <DataGrid x:Name="dgOfr"  Grid.Row="1"
                                  Background="#1E1E1E"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  MouseUp="dgOfr_MouseClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  Style="{StaticResource DataGridDefaultStyle}"
                          >
                    <DataGrid.Resources>
                        <Style x:Key="tbStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding InstTraderName}" Width="1*" >
                            <DataGridTextColumn.ElementStyle >
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                    <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding IdbKey}" Width="1*" Visibility="Collapsed">
                            <DataGridTextColumn.ElementStyle >
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                    <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding InstIdbKey}" Width="1*" Visibility="Collapsed">
                            <DataGridTextColumn.ElementStyle >
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                    <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            </Border>
        </utils:TextBoxPopup>
    </Grid>
    <!--</Border>-->
    <UserControl.ContextMenu >
        <ContextMenu Name="uiContextMenu" Width="170" Height="auto" FontSize="14"  Foreground="#FFFFFF" Style="{StaticResource contextMenuStyle}" >
            <!--批量修改桥要素按钮-->
            <MenuItem Name="btnEdit" Header="编辑" Padding="5, 5, 0, 0" Margin="0" Height="24"  Click ="BtnEdit_Click"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{StaticResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btnUpdate" Header="编辑桥" Padding="5, 5, 0, 0" Margin="0" Height="24"  Click="btnUpdate_Click"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{StaticResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btnDelete" Header="删除桥" Padding="5, 5, 0, 0" Margin="0" Height="24"  Click="btnDelete_Click"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{StaticResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btnChange" Header="换桥" Padding="5, 5, 0, 0" Margin="0" Height="24"  Click="btnChange_Click"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{StaticResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btnCopy" Header="不带单号复制" Padding="5, 5, 0, 0"  Height="24"  Click="btnCopy_Click"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{StaticResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btn_NoBroker" Header="不带broker复制" Padding="5, 5, 0, 0"  Height="24"  Click="btn_NoBroker_Click"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{StaticResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btn_SpecialSeqCopy" Header="特殊内码复制" Padding="5, 5, 0, 0"  Height="24"  Click="btn_SpecialSeqCopy_Click"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{StaticResource IDCFontFamily.Regular}"/>
        </ContextMenu>
    </UserControl.ContextMenu>


</UserControl>
