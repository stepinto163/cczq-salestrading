<UserControl x:Class="STC.Broker.Plugin.View.Transaction.BridgeDesign.BridgeUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction.BridgeDesign"
             xmlns:convertor="clr-namespace:STC.Broker.Plugin.Convertor"
             xmlns:reserve="clr-namespace:STC.Broker.Plugin.View.Transaction.BridgeDesign.Reserve"
             xmlns:utils="clr-namespace:STC.Broker.Plugin.Utils"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             FontSize="14"
             d:DesignWidth="800" d:DesignHeight="200" ContextMenuOpening="uiContextMenu_ContextMenuOpening" Background="#172422" AllowDrop="True">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/IDC.Broker.Plugin;component/BrokerDict.xaml"></ResourceDictionary>-->
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <!--<Image x:Key="EditImageWhite" Source="/icon_operation_tag_normal.png"/>
            <Image x:Key="EditImageOrange" Source="/icon_operation_tag_selected.png"/>

            <Image x:Key="OfrImageWhite" Source="/icon_operation_ofr_normal.png"/>
            <Image x:Key="OfrImageOrange" Source="/icon_operation_ofr_selected.png"/>
            <Image x:Key="OfrImageRed" Source="/icon_operation_ofr_standby.png"/>

            <Image x:Key="BidImageWhite" Source="/icon_operation_bid_normal.png"/>
            <Image x:Key="BidImageOrange" Source="/icon_operation_bid_selected.png"/>
            <Image x:Key="BidImageRed" Source="/icon_operation_bid_standby.png"/>-->

            <SolidColorBrush x:Key="DefaultForeground" Color="#FFFFFF"></SolidColorBrush>

            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
            <Style x:Key="DataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Background" Value="#0F0F0F"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="#0F0F0F"/>
                                </Trigger>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#181818"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" Value="#0A2420"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#0A2420"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#193D37"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" >
                            <Setter Property="BorderThickness" Value="0"/>
                            <!--<Setter Property="ToolTipService.ToolTip" Value="{Binding ToolText}"/>-->
                            <Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#193D37"/>
                                    <!--<Setter Property="Foreground" Value="#000000"/>-->
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="buttonStyle" TargetType="{x:Type Button}">
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                                    CornerRadius="2" Background="#193D37" >
                                <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#178674"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#178674"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#115B4F"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#115B4F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="customeMenuItemStyle" TargetType="{x:Type MenuItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="border" Margin="{TemplateBinding Margin}" Padding="{TemplateBinding Padding}"
                                    Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="#0F0F0F">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderThickness" TargetName="border" Value="1"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#323232"/>
                                    <Setter Property="Background" TargetName="border" Value="#282828"/>
                                </Trigger>
                            </ControlTemplate.Triggers>


                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DeleteImageStyle" TargetType="Image">
                <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/icon_operation_delete_normal.png"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="true">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/icon_operation_delete_hover.png"/>
                    </Trigger>

