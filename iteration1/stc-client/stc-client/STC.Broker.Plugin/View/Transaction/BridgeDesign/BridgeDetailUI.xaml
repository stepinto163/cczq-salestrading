<UserControl x:Class="STC.Broker.Plugin.View.Transaction.BridgeDesign.BridgeDetailUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction.BridgeDesign"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="478" d:DesignWidth="290" Background="#193D37">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/IDC.Broker.Plugin;component/BrokerDict.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml" />-->
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="True"/>
            </Style>

            <Style x:Key="textBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="textBlockStyle2" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Yellow}"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei.Bold}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="10, 0, 0, 0"/>
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="FontFamily" Value="PingFangSC-Semibold"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Green9}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="1, 2, 1, 0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="border" BorderBrush="{TemplateBinding Control.BorderBrush}" Background="{StaticResource ColorBrush.Green9}"
                                    BorderThickness="0" CornerRadius="2">

                                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource ColorBrush.Yellow3}"/>
                                    <Setter Property="Foreground" Value="{StaticResource ColorBrush.Black3}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type Button}" x:Key="ImageButtonStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_dark_pressed.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_dark_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_dark_disabled.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Image x:Key="DownImage" Name="DownImage" Width="8" Height="14" >
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V10 H7 V0 H0 Z">
                                <DrawingGroup Opacity="1">
                                    <DrawingGroup Opacity="1" Transform="1,0,0,1,-511,-403">
                                        <DrawingGroup Transform="1,2.44921270764475E-16,-2.44921270764475E-16,1,1.13686837721616E-13,-1.13686837721616E-13">
                                            <GeometryDrawing Brush="#FFFFEBC8" Geometry="F1 M7,10z M0,0z M514.5,413L514.5,413 518,407.7745 515.6667,407.7745 515.6667,403 513.3333,403 513.3333,407.7745 511,407.7745z" />
                                        </DrawingGroup>
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingImage.Drawing>
                    </DrawingImage>
                </Image.Source>
            </Image>
            <Image x:Key="UpImage" Name="UpImage" Width="8" Height="14" >
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V10 H7 V0 H0 Z">
                                <DrawingGroup Opacity="1">
                                    <DrawingGroup Opacity="1" Transform="1,0,0,1,-492,-403">
                                        <DrawingGroup Transform="-1,-2.44921270764475E-16,2.44921270764475E-16,-1,991,816">
                                            <GeometryDrawing Brush="#FFFFEBC8" Geometry="F1 M7,10z M0,0z M495.5,413L495.5,413 499,407.7745 496.6667,407.7745 496.6667,403 494.3333,403 494.3333,407.7745 492,407.7745z" />
                                        </DrawingGroup>
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingImage.Drawing>
                    </DrawingImage>
                </Image.Source>
            </Image>
            <Image x:Key="LeftImage" Width="8" Height="14" >
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V8 H10 V0 H0 Z">
                                <DrawingGroup Opacity="1">
                                    <DrawingGroup Opacity="1" Transform="1,0,0,1,-491,-389">
                                        <DrawingGroup Transform="-6.12303176911189E-17,1,-1,-6.12303176911189E-17,888.977272,-103.022728">
                                            <GeometryDrawing Brush="#FFFFEBC8" Geometry="F1 M10,8z M0,0z M496,397.9773L496,397.9773 499.5,392.7517 497.1667,392.7517 497.1667,387.9773 494.8333,387.9773 494.8333,392.7518 492.5,392.7518z" />
                                        </DrawingGroup>
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingImage.Drawing>
                    </DrawingImage>
                </Image.Source>
            </Image>
            <Image x:Key="RightImage" Width="8" Height="14" >
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V8 H10 V0 H0 Z">
                                <DrawingGroup Opacity="1">
                                    <DrawingGroup Opacity="1" Transform="1,0,0,1,-510,-389">
                                        <DrawingGroup Transform="6.12303176911189E-17,-1,1,6.12303176911189E-17,122.022728,907.977272">
                                            <GeometryDrawing Brush="#FFFFEBC8" Geometry="F1 M10,8z M0,0z M515,397.9773L515,397.9773 518.5,392.7517 516.1667,392.7517 516.1667,387.9773 513.8333,387.9773 513.8333,392.7518 511.5,392.7518z" />
                                        </DrawingGroup>
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingImage.Drawing>
                    </DrawingImage>
                </Image.Source>
            </Image>


            <Style x:Key="QtyTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#0E1A18"/>
                <Setter Property="BorderBrush" Value="{Binding TbBordBrush}"/>
                <!--<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>-->
                <Setter Property="Foreground" Value="#F9C152"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="ToolTip">
                    <Setter.Value>
                        <TextBlock Text="{Binding Path=Text}"></TextBlock>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#172422"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#FF7D00"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                    <Trigger Property="Text" Value="">
                        <Setter  Property="ToolTip" Value="{x:Null}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="textBoxSearchStyle" TargetType="{x:Type TextBox}">
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Yellow}"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>

                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray15}" Background="#0E1A18">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#172422"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#FF7D00"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#000"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>


            <Style TargetType="{x:Type ListBoxItem}" x:Key="InstListBoxItemStyle">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Foreground" Value="#F9C152"/>
                <Setter Property="Background" Value="#040B0B"/>
                <Setter Property="Focusable" Value="False"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem" >
                            <Border Background="{TemplateBinding Background}">
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"></ColumnDefinition>
                                        <ColumnDefinition Width="24"></ColumnDefinition>
                                        <ColumnDefinition Width="52"></ColumnDefinition>
                                        <ColumnDefinition Width="5"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="tb_Organization" Grid.Column="0"  MaxLength="50"  Width="88" Height="22" Text="{Binding Shortnamecn}" Style="{StaticResource textBoxSearchStyle}"
                                     PreviewKeyDown="tb_Organization_PreviewKeyDown"
                                     KeyDown="tb_Organization_KeyDown" 
                                     TextChanged="tb_Organization_TextChanged"      
                                     HorizontalAlignment="Left" Margin="0" 
                                     input:TextCompositionManager.PreviewTextInput="tb_Organization_PreviewTextInput"
                                     input:TextCompositionManager.PreviewTextInputUpdate="tb_Organization_PreviewTextInputUpdate"
                                             />
                                    <TextBlock Grid.Column="1" FontSize="12" Grid.Row="0" VerticalAlignment="Center" Background="Transparent" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                                    Foreground="{StaticResource DefaultForeground}"  Text="Vol"/>
                                    <TextBox x:Name="tb_Quantity" Grid.Column="2"  Width="50"  Height="22"    Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource QtyTextBoxStyle}"
                                    HorizontalAlignment="Left" Margin="0"   PreviewMouseDown="tb_Quantity_PreviewMouseDown" KeyDown="tb_Quantity_KeyDown"
                                             GotFocus="tb_Quantity_GotFocus"  LostFocus="tb_Quantity_LostFocus"
                                      input:InputMethod.IsInputMethodEnabled="False"
                                    input:TextCompositionManager.PreviewTextInput="tb_Quantity_PreviewTextInput" />
                                    <StackPanel Orientation="Horizontal"  Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Image x:Name="minusSign"  Width="10" Visibility="{Binding  MinusVisibility}" Height="10"  MouseLeftButtonDown="minusSign_MouseLeftButtonDown">
                                            <Image.Source>
                                                <DrawingImage>
                                                    <DrawingImage.Drawing>
                                                        <DrawingGroup ClipGeometry="M0,0 V1024 H1024 V0 H0 Z">
                                                            <GeometryDrawing Brush="#FFEBC8"
                                                 Geometry="F1 M1024,1024z M0,0z M64.2,448.2L959.3,448.2 959.3,576 64.2,576z" />
                                                        </DrawingGroup>
                                                    </DrawingImage.Drawing>
                                                </DrawingImage>
                                            </Image.Source>
                                        </Image>
                                        <Image x:Name="imTips" Margin="5,0,0,0" Width="10" Visibility="{Binding  AddVisibility}" Height="10" MouseLeftButtonDown="imTips_MouseLeftButtonDown">
                                            <Image.Source>
                                                <DrawingImage>
                                                    <DrawingImage.Drawing>
                                                        <DrawingGroup ClipGeometry="M0,0 V1024 H1024 V0 H0 Z">
                                                            <DrawingGroup Opacity="1">
                                                                <DrawingGroup Opacity="1"
                                                  Transform="1,0,0,1,-119,-149">
                                                                    <GeometryDrawing Brush="#FFEBC8"
                                                         Geometry="F1 M1024,1024z M0,0z M448,576L128,576 128,448 448,448 448,128 576,128 576,448 896,448 896,576 576,576 576,896 448,896 448,576z" />
                                                                </DrawingGroup>
                                                            </DrawingGroup>
                                                        </DrawingGroup>
                                                    </DrawingImage.Drawing>
                                                </DrawingImage>
                                            </Image.Source>
                                        </Image>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ListBoxItem.IsSelected"  Value="True">
                                    <Setter Property="Background" Value="#040B0B"  />
                                    <Setter Property="Foreground" Value="#FFEBC8" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#040B0B"   />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--<EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"></EventSetter>-->
            </Style>

            <Style TargetType="ListBox" x:Key="ListBoxStyle">
                <Setter Property="Background" Value="#040B0B"/>
                <Setter Property="Foreground" Value="#D4C6A7"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource InstListBoxItemStyle}"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Style="{StaticResource DefaultScrollViewer}">
                                <StackPanel  Orientation="Vertical" IsItemsHost="True" ScrollViewer.CanContentScroll="True" Focusable="True"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="DataGrid">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="Background" Value="#040B0B"/>
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="AlternatingRowBackground" Value="#121716"/>
                <Setter Property="ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Margin" Value="10,0,0,0"/>
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Background" Value="#040B0B"/>
                            <Setter Property="Height" Value="30"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#FFEBC8"></Setter>
                            <Setter Property="Background" Value="#193D37"/>
                            <Setter Property="Margin" Value="0,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Height" Value="30"/>
                            <Style.Triggers>
                                <!--<Trigger Property="AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="#121716"/>
                                </Trigger>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#0E0F0E"/>
                                </Trigger>-->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" Value="#172422"/>
                                    <Setter Property="Foreground" Value="Yellow"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#172422"/>
                                    <Setter Property="Foreground" Value="#FFEBC8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ImageDirButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="Background" Value="#193D37"/>
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" BorderThickness="1" BorderBrush="#136C5E " CornerRadius="2" Background="{TemplateBinding Background}">
                                <ContentPresenter Name="content"
                              ContentSource="Content"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              TextElement.FontSize="12"
                              TextElement.Foreground="#FFEBC8" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#115B4F" TargetName="border"  />
                                    <Setter Property="Cursor" Value="Hand"></Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" Value="#115B4F"  TargetName="border" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#4A4D4C"  TargetName="border" />
                                    <Setter Property="BorderThickness" Value="0"></Setter>
                                    <Setter Property="Cursor" Value="Hand"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
           

            <SolidColorBrush x:Key="ColorBrush.Orange11" Color="#463622"></SolidColorBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#040B0B" x:Name="gd_main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="8"></RowDefinition>
            <RowDefinition Height="58"></RowDefinition>
            <!--<RowDefinition Height="30"></RowDefinition>-->
            <RowDefinition Height="0"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="1" x:Name="bod_Tile" HorizontalAlignment="Left" Margin="10,0,0,0" CornerRadius="2" Grid.ColumnSpan="2" Background="#153752" Height="58" Width="255">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"></ColumnDefinition>
                    <ColumnDefinition Width="15"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="7"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="7"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbSide" Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Width="35" Height="25" Text="Ofr方" HorizontalAlignment="Right"   Padding="0, 5, 0, 0"
                           VerticalAlignment="Center" FontFamily="{StaticResource IDCFontFamily.Arial.BoldMT}" FontSize="14" Foreground="{StaticResource ColorBrush.Yellow3}"></TextBlock>
                <!--机构名称-桥-->
                <TextBlock x:Name="tbBnakName" Grid.Column="2" Grid.Row="1" Height="25" Text="兴业银行" HorizontalAlignment="Left"   Padding="0, 5, 0, 0" Margin="10, 0, 0, 0"
                           VerticalAlignment="Top" FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}" FontSize="18" Foreground="{StaticResource ColorBrush.Yellow3}"></TextBlock>

                <!--订单对应方向的机构交易员-->
                <TextBlock x:Name="tbInstTrader" Grid.Column="2" Grid.Row="2" Height="15" Text="机构（交易员）" HorizontalAlignment="Left"  Margin="10, 2, 0, 0"
                           VerticalAlignment="Bottom"   Style="{StaticResource textBlockStyle}"></TextBlock>
                <Button  x:Name="btn_OfrFlag" Style="{StaticResource ImageDirButtonStyle}" Content="{StaticResource DownImage}" Grid.Column="1" Grid.RowSpan="4"  Height="20" Click="btn_OfrFlag_Click">
                </Button>
            </Grid>
        </Border>
        <!--<TextBlock x:Name="tbSide" Grid.Column="0" Grid.Row="0" Width="35" Height="25" Text="Ofr方" HorizontalAlignment="Right"   Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom" FontFamily="{StaticResource IDCFontFamily.Arial.BoldMT}" FontSize="14" Foreground="{StaticResource ColorBrush.Yellow3}"></TextBlock>
        -->
        <!--机构名称-桥-->
        <!--
        <TextBlock x:Name="tbBnakName" Grid.Column="1" Grid.Row="0" Height="25" Text="兴业银行" HorizontalAlignment="Left"   Padding="0, 5, 0, 0" Margin="10, 0, 0, 0"
                           VerticalAlignment="Bottom" FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}" FontSize="18" Foreground="{StaticResource ColorBrush.Yellow3}"></TextBlock>-->

        <TextBlock x:Name="tbWarn" Grid.Column="2" Grid.Row="0" Text="*" Foreground="Red" HorizontalAlignment="Center" FontSize="20"  Padding="0, 5, 0, 0"
                           TextAlignment="Left" VerticalAlignment="Bottom" Width="30" Height="22" Visibility="Collapsed"></TextBlock>
        <!--订单对应方向的机构交易员-->
        <!--
        <TextBlock x:Name="tbInstTrader" Grid.Column="1" Grid.Row="1" Height="15" Text="机构（交易员）" HorizontalAlignment="Left"  Margin="10, 2, 0, 0"
                           VerticalAlignment="Top"   Style="{StaticResource textBlockStyle}"></TextBlock>-->
        <!--<Separator Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="10, 12, 10, 0" Background="{StaticResource ColorBrush.Green9}"></Separator>-->
        <!--交易员名称-桥-->
        <TextBlock Grid.Column="0" Grid.Row="3" Width="auto" Height="26"  Text="联系人:" HorizontalAlignment="Right"  Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>

        <TextBlock Grid.Column="1" Grid.Row="3" x:Name="tbBankAgentName" Width="auto"  Text="123"  Margin="15, 0, 0, 0"
                   Style="{StaticResource textBlockStyle2}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>
        <!--联系方式-->
        <TextBlock Grid.Column="0" Grid.Row="4" Width="auto" Height="26"  Text="联系方式:" HorizontalAlignment="Right" Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>
        <TextBlock x:Name="tbContactType" Grid.Column="1" Grid.Row="4"  Width="auto"  Text="123"  Margin="15, 0, 0, 0" Style="{StaticResource textBlockStyle}">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>

        <!---计费-->
        <TextBlock Grid.Column="0" Grid.Row="5" Width="auto" Height="26"  Text="计费:" HorizontalAlignment="Right"  Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>

        <TextBlock Grid.Column="1" Grid.Row="5" x:Name="tbFeeBankAgentName" Width="auto"  Text="123"  Margin="15, 0, 0, 0"
                   Style="{StaticResource textBlockStyle2}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>

        <!--发给-->
        <TextBlock Grid.Column="0" Grid.Row="6" Width="auto" Height="26"  Text="发给:" HorizontalAlignment="Right" Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>
        <TextBox x:Name="tbSendto" Grid.Column="1" Grid.Row="6" Width="188" Height="22" Style="{StaticResource textBoxSearchStyle}" 
                  HorizontalAlignment="Left"  Margin="16,0,0,0" TextChanged="tbSendto_TextChanged">
        </TextBox>



        <!--渠道-->
        <TextBlock Grid.Column="0" Grid.Row="7" Width="auto" Height="26" Text="渠道:" HorizontalAlignment="Right" Padding="0, 5, 0, 0" 
                           VerticalAlignment="Top"  Style="{StaticResource textBlockStyle}"></TextBlock>

        <ListBox x:Name="lbChannel" HorizontalAlignment="Left"  Margin="16,0,0,0"
                         Grid.Column="1" Grid.Row="7"           
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Width="188"
                         Background="Transparent" 
                         BorderThickness="0" 
                         FontSize="12"              
                         SelectionMode="Single"
                         VerticalAlignment="Top" 
                         BorderBrush="Transparent"  
                         SelectionChanged="lbChannel_SelectionChanged">

            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <WrapPanel Width="188" Orientation="Horizontal" IsItemsHost="True"/>
                </ControlTemplate>
            </ListBox.Template>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem x:Name="lbTalk" Width="35" Height="22" Style="{StaticResource ListBoxItemStyle}" Content="对话"/>
            <ListBoxItem x:Name="lbRequest" Width="35" Height="22"  Style="{StaticResource ListBoxItemStyle}" Content="请求" />
            <ListBoxItem x:Name="lbDouble" Width="35" Height="22" Style="{StaticResource ListBoxItemStyle}" Content="双边"/>
            <ListBoxItem x:Name="lbXBond" Width="35" Height="22"  Style="{StaticResource ListBoxItemStyle}" Content="xbond" />
            <ListBoxItem x:Name="lbIDeal" Width="35" Height="22"  Style="{StaticResource ListBoxItemStyle}" Content="ideal" />

            <ListBoxItem x:Name="lbFixed" Width="35" Height="22" Style="{StaticResource ListBoxItemStyle}" Content="固收"/>
            <ListBoxItem x:Name="lbBidding" Width="35" Height="22"  Style="{StaticResource ListBoxItemStyle}" Content="竞价" />
            <ListBoxItem x:Name="lbBulk" Width="35" Height="22"  Style="{StaticResource ListBoxItemStyle}" Content="大宗" />
            <ListBoxItem x:Name="lbIntention" Width="35" Height="22"  Style="{StaticResource ListBoxItemStyle}" Content="意向" />
            <ListBoxItem x:Name="lbAnonymity" Width="35" Height="22"  Style="{StaticResource ListBoxItemStyle}" Content="匿名" />
            <ListBoxItem x:Name="lbXbargain" Width="35" Height="22"  Style="{StaticResource ListBoxItemStyle}" Content="xbargain" ToolTip="xbargain" />
        </ListBox>

        <!--费用-->
        <TextBlock Grid.Column="0" Grid.Row="8" Width="auto" Height="26"  Text="费用:" HorizontalAlignment="Right"  Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>

        <StackPanel Orientation="Horizontal"  Grid.Column="1" Grid.Row="8"  HorizontalAlignment="Left"  Margin="16,0,0,0" >
            <TextBox x:Name="tbCost"  Width="158" Height="22" MaxLength="20" Style="{StaticResource textBoxSearchStyle}"
                       PreviewTextInput="tbCost_PreviewTextInput" TextChanged="tbCost_TextChanged">
            </TextBox>
            <TextBlock Grid.Column="1" Grid.Row="8" Width="20" Text="厘" HorizontalAlignment="Left" Margin="13, 0, 0, 0" VerticalAlignment="Center" Style="{StaticResource textBlockStyle2}"></TextBlock>
        </StackPanel>
        <!--特殊佣金-->
        <TextBlock Grid.Column="0" Grid.Row="9" Width="auto" Height="26"  Text="特殊佣金:" HorizontalAlignment="Right"  Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>

        <StackPanel Orientation="Horizontal"  Grid.Column="1" Grid.Row="9"  HorizontalAlignment="Left"  Margin="16,0,0,0" >
            <TextBox x:Name="tb_SpecialFee"  Width="158" Height="22" MaxLength="20" Style="{StaticResource textBoxSearchStyle}"
                       PreviewTextInput="tb_SpecialFee_PreviewTextInput" TextChanged="tb_SpecialFee_TextChanged">
            </TextBox>
            <TextBlock Grid.Column="1"  Width="20" Text="厘" HorizontalAlignment="Left" Margin="13, 0, 0, 0" VerticalAlignment="Center" Style="{StaticResource textBlockStyle2}"></TextBlock>
        </StackPanel>

        <!--结算-->
        <TextBlock Grid.Column="0" Grid.Row="10" Width="auto" Height="26"  Text="结算:" HorizontalAlignment="Right"  Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>
        <TextBlock Grid.Column="1" Grid.Row="10" x:Name="tbSettle" Width="auto"   Margin="15, 0, 0, 0"
                   Style="{StaticResource textBlockStyle2}" TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>
        <!--第11行 -->
        <TextBlock  x:Name="tbRemarksName" Grid.Column="0" Grid.Row="11" Width="auto" Height="26"  Text="备注:" HorizontalAlignment="Right"  Padding="0, 5, 0, 0"
                           VerticalAlignment="Bottom"  Style="{StaticResource textBlockStyle}"></TextBlock>
        <!--第13行 -->
        <TextBlock  x:Name="tb_BillingInst" Grid.Column="0" Grid.Row="13" Width="auto" Height="26"  Text="发单机构:" HorizontalAlignment="Right" VerticalAlignment="Top"  Padding="0, 5, 0, 0"
                             Style="{StaticResource textBlockStyle}"></TextBlock>
        <!--第10行 -->
        <TextBox x:Name="tbRemark" Grid.Column="1" Grid.Row="11" Width="188" Height="22" MaxLength="30" Style="{StaticResource textBoxSearchStyle}"  
                       HorizontalAlignment="Left"  Margin="16,0,0,0" TextChanged="tbRemark_TextChanged" >
        </TextBox>
        <!--第12行 -->
        <TextBlock Grid.Column="1" Grid.Row="12"  HorizontalAlignment="Left"  Margin="13,0,0,0" Height="20" x:Name="tbShowRemark">
            <CheckBox x:Name="cbShowRemark"  Width="80" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Content="隐藏备注"  Margin="5 0 0 0" FontFamily="{StaticResource DefaultFont}" FontSize="{StaticResource NormalContentFontSize}" 
                          Style="{StaticResource CommonCheckBoxStyle}" BorderBrush="#136C5E"  Background="Transparent" Foreground="{StaticResource DefaultForeground}"   />
            <Button x:Name="btnEditImage" Width="20" HorizontalAlignment="Left"  Margin="-5 -25 0 0"
                                        Height="20" Style="{StaticResource ImageButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/icon_operation_history_dark_disabled.png"/>
                    </Button.Background>
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock Text="备注信息在明细中隐藏"></TextBlock>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
        </TextBlock>

        <ListBox Grid.Column="1" Grid.Row="13" Focusable="True" KeyboardNavigation.TabNavigation="Continue"
                 SelectionMode="Multiple" Margin="16,0,0,0"  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"  ItemsSource="{Binding}" DisplayMemberPath="Shortnamecn"  x:Name="boxGroupList" Style="{StaticResource ListBoxStyle}"
                 >
        </ListBox>

        <Popup x:Name="pop_Organization" PlacementTarget="{Binding ElementName=boxGroupList}" LostFocus="popReciveName_LostFocus" StaysOpen="False">
            <DataGrid x:Name="dgRecive" Grid.Row="1" Background="#193D37" ItemsSource="{Binding}" HeadersVisibility="None" BorderThickness="0" Width="200" MaxHeight="300" Height="auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  DataGridRow.MouseUp="dgRecive_MouseUp"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 Style="{StaticResource DataGridDefaultStyle}" >
                <DataGrid.Resources>
                    <Style x:Key="tbStyle" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding shortnamecn}" Width="1*" >
                        <DataGridTextColumn.ElementStyle >
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                <Setter Property="Padding" Value="10,0,0,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Popup>
        <TextBox Grid.Row="0" x:Name="visTextTextBox" Width="0" Height="0"></TextBox>
    </Grid>
</UserControl>
