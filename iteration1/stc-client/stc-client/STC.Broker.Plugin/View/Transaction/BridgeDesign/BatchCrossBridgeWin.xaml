<Window x:Class="STC.Broker.Plugin.View.Transaction.BridgeDesign.BatchCrossBridgeWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction.BridgeDesign"
        xmlns:uload="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
        mc:Ignorable="d"
        d:DesignHeight="500" WindowStyle="None" MinHeight="300" Height="500" Width="1000" BorderThickness="0" WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="一键过桥" >
   <!--xmlns:uload="clr-namespace:IDC.Broker.Plugin.LoadingPan"-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/IDC.Broker.Plugin;component/BrokerDict.xaml"></ResourceDictionary>-->
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <!--listbox-->
            
            <!--可拖动listbox item-->
            <Style TargetType="{x:Type ListBoxItem}" x:Key="DragListBoxItemStyle">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ToolTip" Value="{Binding UsedLimitedShow}"/>
                <Setter Property="AllowDrop" Value="True"></Setter>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem" >
                            <Grid   Background="{TemplateBinding Background}" >
                                <TextBlock Text="{Binding Item1}" x:Name="tbItem1"
                                           Margin="5,0,35,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                           TextBlock.FontSize="{TemplateBinding FontSize}" 
                                           Foreground="{TemplateBinding Foreground}">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Path=Text}"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                                <TextBlock Text="{Binding Item2}"  Background="{StaticResource ColorBrush.Green}"
                                           Padding="4,0,4,0"
                                           Margin="20,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                           TextBlock.FontSize="{TemplateBinding FontSize}" 
                                           Foreground="{TemplateBinding Foreground}">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Path=Text}"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--<EventSetter Event="PreviewMouseMove" Handler="lsBridge_PreviewMouseMove"></EventSetter>
        <EventSetter Event="QueryContinueDrag" Handler="ListBoxItem_QueryContinueDrag"></EventSetter>-->
                <Style.Triggers>
                    <!--触发器，通过设置 AlternationCount="2"ItemsControl.AlternationIndex 实现颜色交替显示 -->
                    <Trigger Property="ItemsControl.AlternationIndex"  Value="1">
                        <Setter Property="Background" Value="#152421"  />
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex"  Value="0">
                        <Setter Property="Background" Value="#111917"  />
                    </Trigger>
                    <Trigger Property="ListBoxItem.IsSelected"  Value="True">
                        <Setter Property="Background" Value="#173D37"  />
                        <Setter Property="Foreground" Value="Yellow" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#173D37"  />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ListBox" x:Key="DragListBoxStyle">
                <Setter Property="Background" Value="#162220"/>
                <Setter Property="Foreground" Value="#D4C6A7"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource DragListBoxItemStyle}"/>

                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel  Orientation="Vertical" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--birgde datagrid style-->
            <Style x:Key="BrigdeDataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="FontSize" Value="{StaticResource NormalContentFontSize}"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="Background" Value="{StaticResource ColorBrush.BlackishGreen}"/>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex"  Value="1">
                                    <Setter Property="Background" Value="#152421"  />
                                </Trigger>
                                <Trigger Property="ItemsControl.AlternationIndex"  Value="0">
                                    <Setter Property="Background" Value="#111917"  />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" >
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#193D37"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>


        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="5"
                       GlassFrameThickness="0">
        </WindowChrome>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="2" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Green4}" Background="{StaticResource ColorBrush.Black2}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="44"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource ColorBrush.Green}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="35"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="一键过桥" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" Foreground="{StaticResource ColorBrush.PaleGold}"></TextBlock>

                <Button Grid.Column="2" x:Name="btnClose" Style="{StaticResource ImageCloseButton}" Margin="0, 0, 10, 0" Width="20" Height="16" IsCancel="True" Click="btnClose_Click"></Button>
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource ColorBrush.Blue7}" Margin="5,5,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <StackPanel x:Name="TotalShow" Orientation="Horizontal" Grid.Column="0"  >
                            <TextBlock  FontFamily="{StaticResource DefaultFont}" FontSize="{StaticResource BigContentFontSize}" Foreground="{StaticResource DefaultForeground}" >共计</TextBlock>
                            <TextBlock x:Name="BatchCount" Text="{Binding BatchCount}" FontFamily="{StaticResource DefaultFont}" FontSize="{StaticResource BigContentFontSize}" Foreground="{StaticResource ColorBrush.Orange}" Margin="10,0,10,0"></TextBlock>
                            <TextBlock FontFamily="{StaticResource DefaultFont}" FontSize="{StaticResource BigContentFontSize}" Foreground="{StaticResource DefaultForeground}">过桥等待确认</TextBlock>
                        </StackPanel>
                    </Grid>
                    
                    <Grid  Grid.Column="1" HorizontalAlignment="Right" Margin="0, 0, 10, 0" >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button  x:Name="BtnRun" Style="{StaticResource CommonButtonStyle}" Content="运行" Width="60" Height="20" Click="BtnRun_Click"  Margin="5, 0, 5, 0"></Button>
                            <Button Style="{StaticResource ImageSettingButton}" Width="20" Height="20" Click="Btn_Config_Click"></Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" MinWidth="200"></ColumnDefinition>
                    <ColumnDefinition Width="5"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition ></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border VerticalAlignment="Center" Grid.Row="0"  >
                        <TextBlock Text="机构(联系人)" Foreground="{StaticResource ColorBrush.Gray3}"/>
                    </Border>
                    <ListBox x:Name="lsBridge" 
                             Grid.Row="1"
                             Width="Auto" 
                             MinWidth="50"
                             FontSize="14"
                             ItemsSource="{Binding BridgeInfos }"  Style="{StaticResource DragListBoxStyle}"
                             SelectionChanged="lsBridge_SelectionChanged">
                    </ListBox>
                </Grid>

                <!--分界线-->
                <GridSplitter  Grid.Column="1"  Width="5"   
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Background="Black" />

                <Grid  Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"></RowDefinition>
                        <RowDefinition ></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="CheckAll" Margin="-6, 0, 0, 0" Height="15" Width="auto" Content="全选" FontFamily="{StaticResource DefaultFont}" 
                              Style="{StaticResource CommonCheckBoxStyle}" BorderBrush="#136C5E"  Background="Transparent" Foreground="{StaticResource DefaultForeground}" 
                              HorizontalAlignment="Center"  Click="CheckAll_Click"></CheckBox>

                        <Button Grid.Column="1"  HorizontalAlignment="Right"  x:Name="s" Style="{StaticResource CommonButtonStyle}" Content="确定" Width="105" Height="25" Click="BtnConfirm_Click" ></Button>
                </Grid>

                    <Grid Grid.Row="1" >
                        <DataGrid x:Name="BridgeOrderData" ItemsSource="{Binding BridgeOrderInfos}" Background="{StaticResource ColorBrush.BlackishGreen}" BorderThickness="0" HeadersVisibility="None" Margin="5,4.8,0,10"   RowHeight="24"
                              ScrollViewer.CanContentScroll="True" AllowDrop="True" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                              ScrollViewer.IsDeferredScrollingEnabled="True" 
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True" 
                              VirtualizingPanel.ScrollUnit="Pixel"
                              GridLinesVisibility ="None"
                              AutoGenerateColumns="False" IsReadOnly="True"  
                              SelectionMode="Extended" SelectionUnit="FullRow"  CanUserSortColumns="True" 
                              MouseLeftButtonUp ="BridgeOrderData_Selected"
                              PreviewMouseLeftButtonDown="BridgeOrderData_PreviewMouseLeftButtonDown"
                              Style="{StaticResource BrigdeDataGridStyle}" 
                                  >

                            <DataGrid.Columns>
                                <!--checkbox-->
                                <DataGridTemplateColumn Width="auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Grid.Column="0" x:Name="cbSort" Margin="10, 0, 0, 0" Height="15" Width="auto"  FontFamily="{StaticResource DefaultFont}" 
                                                  Style="{StaticResource CommonCheckBoxStyle}" BorderBrush="#136C5E"  Background="Transparent" Foreground="{StaticResource DefaultForeground}" 
                                                  HorizontalAlignment="Center" IsChecked="{Binding IsSelectedFlag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Unchecked="cbSort_Unchecked" Checked="cbSort_Checked" Click="cbSort_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--单号-->
                                <DataGridTemplateColumn Width="auto" MinWidth="25">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" x:Name="bdSeq" >
                                                <Button x:Name="btnSeq" Height="18" FontFamily="{StaticResource IDCFontFamily.Arial.BoldMT}"
                                        Background="{StaticResource ColorBrush.Green3}" Style="{StaticResource RowButtonStyle}"
                                    Foreground="{StaticResource DefaultForeground}" Width="auto"  Content="{Binding OrderSeq}"></Button>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--brokerA-->
                                <DataGridTemplateColumn Width="35" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" x:Name="bdBrokerA" >
                                                <TextBlock  FontFamily="{StaticResource IDCFontFamily.Regular}" Background="{StaticResource ColorBrush.Blue6}"
                                       Padding="3, 3, 0, 0" Width="auto" Height="18" Foreground="{StaticResource ColorBrush.Black2}" Text="{Binding BrokerAName}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--brokerB-->
                                <DataGridTemplateColumn Width="35" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent"  x:Name="bdBrokerB" >
                                                <TextBlock  FontFamily="{StaticResource IDCFontFamily.Regular}" Background="{StaticResource ColorBrush.Yellow7}"
                                       Padding="3, 3, 0, 0" Width="auto" Height="18" Foreground="{StaticResource ColorBrush.Black2}" Text="{Binding BrokerBName}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--显示文本-->
                                <DataGridTemplateColumn x:Name="dgTxt" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent">
                                                <TextBlock Name="bridgeTxt" Grid.Column="0"  VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding OrderText}"  Margin="5, 0, 0, 0" Foreground="{StaticResource DefaultForeground}"
                                                       TextTrimming="CharacterEllipsis" Style="{StaticResource RowBrigdeOrderText}">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

               
                
            </Grid>

            <uload:LoadingWaiting x:Name="LoadingUI"  Grid.Row="1" Grid.RowSpan="2" CanvasSize="130" EllipseCount="10" EllipseSize="20" StepAngle="36" TimeSpan="50"  Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
