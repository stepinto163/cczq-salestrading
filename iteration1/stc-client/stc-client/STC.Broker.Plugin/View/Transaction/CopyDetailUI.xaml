            <Style x:Key="txseq" TargetType="TextBlock">
                <Setter Property="TextAlignment"  Value="Center"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei.SemiSold}" ></Setter>
                <Setter Property="FontSize" Value="14" ></Setter>
                <Setter Property="FontWeight" Value="Bold" ></Setter>
                <Setter Property="Foreground" Value="#FFEBC8" ></Setter>
                <!--<Setter Property="Background" Value="#193D37"></Setter>-->
                <Setter Property="Height" Value="15"></Setter>
                <Setter Property="Width" Value="{Binding Path=IsWidth,Converter={StaticResource CopyColorConverter}}"></Setter>
                <Setter Property="Visibility" Value="{Binding Path=IsHeader,Converter={StaticResource CopyColorConverter}}"></Setter>
                <Setter Property="Margin" Value="{Binding Path=IsMargin,Converter={StaticResource CopyColorConverter}}"></Setter>
            </Style>
            <!--ofr-->
            <Style x:Key="txofr" TargetType="TextBlock">
                <Setter Property="TextAlignment"  Value="Center"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="FontFamily" Value="MicrosoftYaHei"></Setter>
                <!--<Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.Regular}"></Setter>-->
                <Setter Property="FontSize" Value="14" ></Setter>
                <Setter Property="Foreground" Value="#0082D8"></Setter>
                <!--<Setter Property="Background" Value="#97CEF2"></Setter>-->
                <Setter Property="Height" Value="15"></Setter>
                <Setter Property="Width" Value="{Binding Path=IsWidth,Converter={StaticResource CopyColorConverter}}"></Setter>
                <Setter Property="Visibility" Value="{Binding Path=IsHeader,Converter={StaticResource CopyColorConverter}}"></Setter>
                <!--<Setter Property="Margin" Value="0,0,5,0"></Setter>-->
                <Setter Property="Margin" Value="{Binding Path=IsMargin,Converter={StaticResource CopyColorConverter}}"></Setter>
