            <Style x:Key="OrangeCheckedNormalCheckBox" TargetType="CheckBox">
                <Setter Property="Visibility" Value="{Binding Path=SumIsVisible}"></Setter>
                <!--<Setter Property="Width" Value="{Binding Path=SumIsVisible,Converter={StaticResource CopyColorConverter} }"></Setter>-->
                <Setter Property="Background" Value="{DynamicResource GreenBlueCheckBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="#515151"/>
                <Setter Property="Foreground" Value="{DynamicResource GreenBlueCheckBox.Normal.Foreground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,0,0,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="checkBoxBorder" CornerRadius="1" Height="14" MaxHeight="14" MinHeight="14" Width="14" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid x:Name="markGrid">
                                        <Path x:Name="optionMark"  Data="M0.1,6 3.2,7.5 7.5,2 7.0,0.2 3.2,5.2 1,4 0.2,4 z" Fill="Transparent" Margin="1,0,0,0" Opacity="0" Stretch="None"/>
                                        <Rectangle x:Name="indeterminateMark" Fill="{DynamicResource GreenBlueCheckBox.Static.Background}" Opacity="0"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" TextBlock.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Height" Value="16"/>
                                        <Condition Property="BorderThickness" Value="1"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Data" TargetName="optionMark" Value="F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z"/>
                                    <Setter Property="Margin" TargetName="optionMark" Value="1,1,0,0"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Height" Value="18"/>
                                        <Condition Property="BorderThickness" Value="1"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Data" TargetName="optionMark" Value="F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z"/>
                                    <Setter Property="Margin" TargetName="optionMark" Value="1,1,0,0"/>
                                </MultiTrigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Height" Value="16"/>
                                        <Condition Property="BorderThickness" Value="2"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Data" TargetName="optionMark" Value="F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z"/>
                                    <Setter Property="Margin" TargetName="optionMark" Value="0,0,0,0"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Height" Value="18"/>
                                        <Condition Property="BorderThickness" Value="2"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Data" TargetName="optionMark" Value="F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z"/>
                                    <Setter Property="Margin" TargetName="optionMark" Value="1,0.5,0,0"/>
                                </MultiTrigger>

                                <Trigger Property="Height" Value="14">
                                    <Setter Property="Margin" TargetName="optionMark" Value="1,1,0,0"/>
                                    <Setter Property="BorderThickness" TargetName="checkBoxBorder" Value="1"/>
                                </Trigger>
                                <Trigger Property="Height" Value="12">
                                    <Setter Property="Margin" TargetName="optionMark" Value="0,0,0,0"/>
                                    <Setter Property="BorderThickness"  TargetName="checkBoxBorder" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.YellowChecked.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.Static.Background}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource GreenBlueCheckBox.Static.Background}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource GreenBlueCheckBox.Static.Background}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="true"/>
                                        <Condition Property="IsChecked" Value="true"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.Static.Background}"></Setter>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.YellowChecked.Border}"></Setter>
                                    <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource GreenBlueCheckBox.YellowChecked.Border}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource GreenBlueCheckBox.Static.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="false"/>
                                        <Condition Property="IsChecked" Value="true"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.Disabled.Background}"></Setter>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.Disabled.Border}"></Setter>
                                    <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource GreenBlueCheckBox.Disabled.Border}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource GreenBlueCheckBox.Disabled.Border}"/>
                                    <Setter Property="TextBlock.Foreground"  TargetName="contentPresenter"  Value="{DynamicResource GreenBlueCheckBox.Disabled.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="false"/>
                                        <Condition Property="IsChecked" Value="true"/>
                                        <Condition Property="Tag" Value="Set"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="Transparent"/>
                                    <Setter Property="BorderThickness" TargetName="checkBoxBorder" Value="0"/>
                                    <Setter Property="Opacity" TargetName="checkBoxBorder" Value="1"/>
                                    <Setter Property="Opacity" TargetName="optionMark" Value="1"/>
                                    <Setter Property="Margin" TargetName="optionMark" Value="2,2,0,0"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource GreenBlueCheckBox.Normal.Foreground}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource GreenBlueCheckBox.YellowChecked.Border}"/>
                                    <Setter Property="TextBlock.Foreground"  TargetName="contentPresenter" Value="{DynamicResource GreenBlueCheckBox.Normal.Foreground}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="false"/>
                                        <Condition Property="IsChecked" Value="false"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.Disabled.Border}"/>
                                    <Setter Property="Opacity" TargetName="optionMark" Value="0"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource GreenBlueCheckBox.Disabled.Border}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource GreenBlueCheckBox.Disabled.Border}"/>
                                    <Setter Property="TextBlock.Foreground"  TargetName="contentPresenter" Value="{DynamicResource GreenBlueCheckBox.Disabled.Border}"/>
                                </MultiTrigger>

                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.YellowChecked.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource GreenBlueCheckBox.YellowChecked.Border}"/>
                                    <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource GreenBlueCheckBox.Pressed.Glyph}"/>
                                    <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource GreenBlueCheckBox.Pressed.Glyph}"/>
                                </Trigger>

                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter Property="Opacity" TargetName="optionMark" Value="0"/>
                                    <Setter Property="Opacity" TargetName="indeterminateMark" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="SendButton" TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.Medium}"></Setter>
                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
