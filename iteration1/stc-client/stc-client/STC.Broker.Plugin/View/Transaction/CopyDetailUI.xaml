                        <Popup x:Name="tbBCodePop" PlacementTarget="{Binding ElementName=tbCode}" LostFocus="tbBCodePop_LostFocus"  StaysOpen="False" MaxHeight="310">
                            <DataGrid x:Name="dgCodeResult"
                                  Grid.Row="1"
                                  Background="#193D37"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  Width="288"
                                  MouseDoubleClick="dgCodeResult_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden" Style="{StaticResource DefaultDataGridNoHeadSpaceStyle}">
