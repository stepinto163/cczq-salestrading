<UserControl x:Class="STC.Broker.Plugin.View.Transaction.UnderLineExec.UnderLineExecWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction.UnderLineExec"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:uload="clr-namespace:STC.Common.View.UI"
        mc:Ignorable="d"  d:DesignHeight="390" d:DesignWidth="490">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/IDC.Broker.Plugin;component/BrokerDict.xaml"></ResourceDictionary>-->
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="buttonStyle" TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.Regular}"></Setter>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Foreground" Value="{StaticResource DefaultForeground}"></Setter>
                <Setter Property="Background" Value="{StaticResource ColorBrush.Green}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="0" CornerRadius="2" Name="PART_Background"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" Value="#178674"/>
                                    <Setter Property="BorderBrush"  Value="#178674"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background"  Value="#115B4F"/>
                                    <Setter Property="BorderBrush"  Value="#115B4F"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <!--下拉按钮-->
            <Style TargetType="ToggleButton" x:Key="ComboxStyleBtn">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border x:Name="Back" Background="{StaticResource ColorBrush.Green}" Width="30" BorderThickness="0" BorderBrush="Transparent" >
                                <TextBlock Padding="10, 0, 0, 0" Text="∨" FontSize="15" Foreground="#FFF1DA" />
                                <!--∧-->
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource ColorBrush.Green}"></Setter>
                                    <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource ColorBrush.Green8}"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--意向单选项-->
            <!--<ControlTemplate x:Key="ShowStarCheckBoxTemplate3"  TargetType="CheckBox">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
