                            <Setter.Value>
                                <Image Source="/IDC.Frame;component/Images/Check-Rectangle.png" Width="12" Height="12" />
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>-->

        </ResourceDictionary>
    </UserControl.Resources>

    <!--<WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="5"
                       GlassFrameThickness="0">
        </WindowChrome>
    </WindowChrome.WindowChrome>-->

    <Border CornerRadius="2" BorderBrush="{StaticResource ColorBrush.Gray15}" BorderThickness="0">
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <!--<RowDefinition Height="30"></RowDefinition>-->
                    <RowDefinition Height="8"></RowDefinition>
                    <RowDefinition Height="40*"></RowDefinition>
                    <RowDefinition Height="28"></RowDefinition>
                    <RowDefinition Height="60*"></RowDefinition>
                    <RowDefinition Height="56"></RowDefinition>
                </Grid.RowDefinitions>

                <!--<Grid Grid.Row="0" Background="{StaticResource ColorBrush.Gray18}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="20"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="线下成交单" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5, 0, 0, 0"
                           FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="12" Foreground="{StaticResource ColorBrush.PaleGold}"></TextBlock>
                    <Button Grid.Column="2" x:Name="btnClose" Style="{StaticResource ImageCloseButton}" Width="20" Height="16" IsCancel="True" Click="btnClose_Click"></Button>

                </Grid>-->

                <Border Grid.Row="1" CornerRadius="2" Background="{StaticResource ColorBrush.Black7}" Margin="8, 0, 8, 0">
                    <TextBox x:Name="tbOrder" Background="{StaticResource ColorBrush.Black7}" Padding="3,3,3,3" BorderThickness="1"
                         FontFamily="{StaticResource IDCFontFamily.YaHei.Bold}" FontSize="14" Foreground="{StaticResource ColorBrush.PaleGold}" BorderBrush="#3C3C3C"
                         TextWrapping="NoWrap" AcceptsReturn="True"  PreviewKeyDown="tbOrder_PreviewKeyDown"
                         input:TextCompositionManager.PreviewTextInput="tbOrder_PreviewTextInput"
                         input:TextCompositionManager.PreviewTextInputUpdate="tbOrder_PreviewTextInputUpdate"
                         >

                    </TextBox>
                </Border>


                <TextBlock Grid.Row="2" Text="格式: 200205 2.85 2000 +1 ofr交易员 bidbroker"
                       FontFamily="{StaticResource IDCFontFamily.YaHei}" Foreground="#A0A0A0 " FontSize="14" Margin="8, 5, 20, 0" ></TextBlock>

                <Border Grid.Row="3" CornerRadius="2" Background="{StaticResource ColorBrush.Black7}" Margin="8, 0, 8, 0"  BorderThickness="1" BorderBrush="#3C3C3C">
                    <ScrollViewer x:Name="scrList" CanContentScroll="False" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0" Padding="0"  Style="{StaticResource DefaultScrollViewer}">
                        <StackPanel x:Name="spExec" >

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!--<StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"  >-->
                <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"></ColumnDefinition>
                            <ColumnDefinition Width="10*"></ColumnDefinition>
                            <ColumnDefinition Width="87*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <!--意向框-->
                        <CheckBox x:Name="intentionCheckBox"  Grid.Column="1" Content="意向" Foreground="{StaticResource TextBox.Focus.Foreground}"  IsChecked="False"  
                              HorizontalAlignment="Left" Width="45" 
                              Style="{DynamicResource OrangeCheckedNormalCheckBox}"  />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Grid.Column="2">

                        <Button x:Name="btnInput" Grid.Column="1" Content="确定" Width="100" Height="29"  FontFamily="Microsoft YaHei" Foreground="#D7D7D7" FontWeight="SemiBold" FontSize="14px" 
                            Margin="0,0,100,0" Background="#136C5E" Click="btnInput_Click" BorderThickness="0 1 0 0" Style="{StaticResource ConfirmButtonStyle}"></Button>
                    </StackPanel>
                    </Grid>
 
                <!--</StackPanel>-->
            </Grid>
            <!--<uload:LoadingWaiting x:Name="_loading"  CanvasSize="130" EllipseCount="10" EllipseSize="20" StepAngle="36" TimeSpan="50"  Visibility="Collapsed"/>-->
        </Grid>
    </Border>
</UserControl>
