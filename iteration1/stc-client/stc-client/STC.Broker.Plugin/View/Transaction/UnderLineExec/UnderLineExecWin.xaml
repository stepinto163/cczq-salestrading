                        <Label.Content>
                            <Image Source="/IDC.Frame;component/Images/Check-Rectangle.png" Width="12" Height="12" />
                        </Label.Content>
                    </Label>
                    <ContentPresenter Name="content" Grid.Column="1" ContentSource="Content" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0,0,0" 
                                      TextElement.FontSize="12"  TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
