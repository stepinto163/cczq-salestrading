        <!--弹出框搜索内码框-->
        <Popup x:Name="tbpop_Seq" StaysOpen="False" MaxHeight="300" Width="230" 
                   PopupAnimation="Slide" AllowsTransparency="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Width="370" Background="#0F0F0F " Grid.Row="0">
                    <!--搜索框-->
                    <TextBox x:Name="tb_seqTxt" Width="230"  Height="22" KeyDown="tb_seqTxt_KeyDown"  HorizontalAlignment="Left"
                        TextChanged="tb_seqTxt_TextChanged"  Style="{DynamicResource DefaultTextBoxStyle}"
                        input:InputMethod.IsInputMethodEnabled="True"  Background="#193D37"
                        PreviewKeyDown="tb_seqTxt_PreviewKeyDown">>
                    </TextBox>
                </DockPanel>
                <DataGrid x:Name="dg_orderList"  Grid.Row="1"
                                  Background="#282828"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  MouseUp="dg_orderList_MouseUp"
                                   
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  Style="{DynamicResource DataGridDefaultStyle}"
                          >
                    <DataGrid.Resources>
                        <Style x:Key="tbStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Seq}" Width="40" >
                            <DataGridTextColumn.ElementStyle >
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                    <Setter Property="Padding" Value="4,0,0,0"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TraderExchangeShow}" Width="*" >
                            <DataGridTextColumn.ElementStyle >
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
                                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                    <Setter Property="Padding" Value="4,0,0,0"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding DateExchangeShow}" Width="75" >
                            <DataGridTextColumn.ElementStyle >
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                    <Setter Property="Padding" Value="4,0,0,0"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Popup>
        <!--推送订单到IDB-->
        <Popup x:Name="tbpop_OrderSide" StaysOpen="False" Height="75" Width="50" 
                   PopupAnimation="Slide" AllowsTransparency="False">
            <Border BorderThickness="1" BorderBrush="#1C443B">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button  Content="TKN" Tag="1" Foreground="#1AA1FF" Style="{StaticResource buttonSideStyle}"
                             Command="{Binding DataContext.PushMarketOrderCommand,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TransactionPanel}}}"
                             CommandParameter="{Binding RelativeSource={RelativeSource self}}" ></Button>
                    <Button Content="GVN" Tag="2" Foreground="#F0892A" Grid.Row="1" Style="{StaticResource buttonSideStyle}" 
                            Command="{Binding DataContext.PushMarketOrderCommand,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TransactionPanel}}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource self}}"></Button>
                    <Button Content="TRD" Tag="3" Foreground="#67C139" Grid.Row="2" Style="{StaticResource buttonSideStyle}" 
                            Command="{Binding DataContext.PushMarketOrderCommand,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TransactionPanel}}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource self}}"></Button>
                </Grid>
            </Border>
        </Popup>
        <!--等待-->
        <fUI:LoadingMask x:Name="positionloadMask" Visibility="{Binding LoadMaskVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.ColumnSpan="2"></fUI:LoadingMask>
    </Grid>

    <UserControl.ContextMenu>
        <ContextMenu  Name="uiContextMenu" Width="113" Height="auto"  Foreground="#D7D7D7" FontSize="16px" Style="{StaticResource contextMenuStyle}">
            <!--<MenuItem Name="btnRightReject" Header="拒绝" Padding="5, 4, 0, 0" Margin="1" Click="RejectItem_Click" Style="{StaticResource customeMenuItemStyle}" FontFamily="{StaticResource IDCFontFamily.Regular}">
            </MenuItem>-->

            <MenuItem Name="btnSend" Header="发送" Command="{Binding SendQQmsgCommand}"  Padding="5, 4, 0, 0" Margin="1"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{DynamicResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btnCopy" Header="复制" Command="{Binding CopyOrderTxtCommand}" Padding="5, 4, 0, 0" Margin="1"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{DynamicResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btnClone" Header="克隆"   Command="{Binding CloneOrderCommand}" Padding="5, 4, 0, 0" Margin="1"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{DynamicResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btn_Reminder" Header="催单" Command="{Binding ReminderCommand}" Padding="5, 4, 0, 0" Margin="1"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{DynamicResource IDCFontFamily.Regular}">
            </MenuItem>
            <MenuItem Name="btnDelete" Header="删除"  Command="{Binding DeleteOrderCommand}"
                               Padding="5, 4, 0, 0" Margin="1"  Style="{StaticResource customeMenuItemStyle}" FontFamily="{DynamicResource IDCFontFamily.Regular}">
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
</UserControl>
