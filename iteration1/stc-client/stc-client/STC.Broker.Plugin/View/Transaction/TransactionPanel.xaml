    </UserControl.Resources>

    <Grid Background="{DynamicResource  MainBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!--左标题区-->

        <!--日期过滤部分过滤部分-->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" MaxHeight="30" Background="{DynamicResource MainListTitleBackgroup}">
            <commComp:WatermarkTextBox x:Name="wt_seq" Margin="4 0 0 0" WaterMark="序列号" Width="60" Height="24" KeyDown="WatermarkTextBox_KeyDown" PreviewKeyDown="WatermarkTextBox_PreviewKeyDown"/>
            <RadioButton Style="{DynamicResource SelfDefaultRadioButtonStyle}" Margin="4 0 0 0" IsChecked="{Binding IsAllChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="全部" Padding="0 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center"  Foreground="{DynamicResource TextBlockDefaultForground}"/>

            <RadioButton Style="{DynamicResource SelfDefaultRadioButtonStyle}" Margin="4 0 0 0" IsChecked="{Binding DealTimeChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Content="" Padding="0 0 0 0" VerticalAlignment="Center"  Foreground="{DynamicResource TextBlockDefaultForground}"/>

            <DatePicker Width="90" Height="24" Margin="2, 0, 0, 0" SelectedDate="{Binding DealTimeEnd,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBlueDatePickerStyle}" Foreground="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Foreground}"
                                            BorderThickness="1" Background="Transparent" BorderBrush="#3C3C3C">
                <DatePicker.Resources>
                    <Style TargetType="DatePickerTextBox">
                        <Setter Property="IsReadOnly" Value="True"/>
                    </Style>
                </DatePicker.Resources>
            </DatePicker>
            <Button   x:Name="btn_Confirmed" Margin="6,0,0,0"
                              IsEnabled="True"
                              Width="70"
                              Height="24"
                              Content="待确认"
                              Foreground="#FF9D61 "
                              Command="{Binding GotoCommand}"
                              CommandParameter="0,1,2,E,I"
                              Style="{DynamicResource btnConfirmed}"></Button>
            <Button   x:Name="btn_Refuse" Margin="6,0,0,0"
                              IsEnabled="True"
                              Width="70"
                              Height="24"
                              Content="已拒绝"
                              Foreground="#C5585A"
                              Command="{Binding GotoCommand}"
                              CommandParameter="F,H"
                              Style="{DynamicResource btnConfirmed}"></Button>
            <!--<commComp:SearchTextBox Width="184" ToolTip="可模糊查询债券代码" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Center" Height="24"/>-->
        </StackPanel>

        <!--功能区-->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" MaxHeight="30"  Background="{DynamicResource MainListTitleBackgroup}">
            <Button x:Name="btn_unread" Content="{Binding UnreadTxt}" Width="90" Height="24" Margin="4 0 0 0"  Command="{Binding LookBatchCommand}"  CommandParameter="" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0 1 0 0" Style="{DynamicResource btnUnread}"/>
            <Button x:Name="btn" Content="线下成交" Width="64" Height="24" Margin="4 0 0 0" Command="{Binding DealCommand}"  CommandParameter="" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0 1 0 0" Style="{DynamicResource BlueGreenStyle}"/>

            <TextBlock Margin="10,0,0,0" Foreground="#8F9598" FontFamily="PingFangSC-Regular" HorizontalAlignment="Right" FontSize="14" VerticalAlignment="Center">
                     <Run Text="共"></Run>
                    <Run Text="{Binding RowCount}" Foreground="#FFD277"></Run>
                    <Run Text="笔"></Run>
            </TextBlock>

            <Button x:Name ="popupBtn" MinWidth="14" MinHeight="14"  Margin="4 0 4 0" Style="{DynamicResource PopupButton}" 
                    Command="{ Binding PopupWindowCommand}"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!--恢复报价数据显示区-->
        <TabControl x:Name="tbc_Data" Grid.Row="1" Grid.ColumnSpan="2" Background="#0F0F0F" BorderThickness="0">
            <TabItem  Visibility="Collapsed">
