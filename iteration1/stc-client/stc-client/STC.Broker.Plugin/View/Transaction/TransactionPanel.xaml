<UserControl x:Class="STC.Broker.Plugin.View.Transaction.TransactionPanel"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:localcomp ="clr-namespace:STC.Broker.Plugin.View.Component"
             mc:Ignorable="d"
             xmlns:localconvert ="clr-namespace:STC.Broker.Plugin.Convertor"
             xmlns:command="clr-namespace:STC.Broker.Plugin.Command"
             xmlns:ComCon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:SelectorTemplate="clr-namespace:STC.Broker.Plugin.View.Transaction"
             d:DesignHeight="450" d:DesignWidth="1120" ContextMenuOpening="UserControl_ContextMenuOpening"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <command:PopupWindowCommand x:Key="PopupWindowCommand"/>
            <localconvert:ColorConvertor x:Key="colorCon"/>
            <localconvert:RemainingTimeAndDaysOffStrConvetor x:Key="remainingTimeAndDaysOffStrConvetor"/>
            <localconvert:DaysOffStrConverter x:Key="daysOffStrConverter"/>
            <localconvert:TransOrderColorConvertor x:Key="transOrderColorConvertor"/>
            <localconvert:TransBorderStyleConvert x:Key="transBorderStyleConvert"/>

            <FontFamily x:Key="DefaultFont">Arial,Microsoft YaHei</FontFamily>
            <FontFamily x:Key="IDCFontFamily.YaHei">MicrosoftYaHei</FontFamily>
            <SolidColorBrush x:Key="ColorBrush.Black7" Color="#0F0F0F"></SolidColorBrush>
            <!--<Style BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="True"/>
            </Style>-->

            <!-- 居中 -->
            <Style x:Key="DataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="DataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Right"/>
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="DataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Left"/>
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>




            <Style TargetType="{x:Type DataGrid}" x:Key="SDataGrid">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="AllowDrop" Value="True"/>
                <Setter Property="Foreground" Value=" #D4C6A7"/>
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="AlternatingRowBackground" Value="#121716"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="#FFEBC8"></Setter>
                            <Setter Property="Background" Value="#0E0F0E"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="#0F0F0F"/>
                                </Trigger>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#181818"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" Value="#0A2420"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#238F7E"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#193D37"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelect}" Value="True">
                                    <Setter Property="Background" Value="#193D37"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#173D37"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--<Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="CustomDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>-->

            <Style TargetType="TextBlock" x:Key="gridBondTextBlock"  BasedOn="{StaticResource CommonSideTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="FontFamily" Value="MicrosoftYaHei"></Setter>
                <Setter Property="Foreground" Value="#FFD277"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
                <Setter Property="ToolTip" >
                    <Setter.Value>
                        <TextBlock Text="{Binding Path=Text}"></TextBlock>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SendButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#136C5E"/>
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" BorderThickness="0"  CornerRadius="2" Background="{TemplateBinding Background}">
                                <ContentPresenter Name="content" Margin="0,-2,0,0" TextBlock.FontSize="{TemplateBinding FontSize}"
                              ContentSource="Content"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"     
                              />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#178674" TargetName="border"  />
                                    <Setter Property="Cursor" Value="Hand"></Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" Value="#115B4F"  TargetName="border" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#4A4D4C"  TargetName="border" />
                                    <Setter Property="BorderThickness" Value="0"></Setter>
                                    <Setter Property="Cursor" Value="Hand"></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TBBigStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"></Setter>
                <Setter Property="FontSize" Value="16px"></Setter>
                <Setter Property="Foreground" Value="#FFD277"></Setter>
                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>


