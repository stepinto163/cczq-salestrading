                                            <Setter  TargetName="im_brokerB_Refuse" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_ROK" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="tbBrokerBName" Property="Foreground" Value="#FF9D61"/>

                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BrokerBStatus}" Value="1">
                                            <Setter  TargetName="im_brokerB_OK" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_TBC" Property="Visibility" Value="Visible"/>
                                            <Setter  TargetName="im_brokerB_PartOk" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_Refuse" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_ROK" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="tbBrokerBName" Property="Foreground" Value="#FF9D61"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BrokerBStatus}" Value="2">
                                            <Setter  TargetName="im_brokerB_OK" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_TBC" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_PartOk" Property="Visibility" Value="Visible"/>
                                            <Setter  TargetName="im_brokerB_Refuse" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_ROK" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="tbBrokerBName" Property="Foreground" Value="#D7D7D7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BrokerBStatus}" Value="3">
                                            <Setter  TargetName="im_brokerB_OK" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_TBC" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_PartOk" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_Refuse" Property="Visibility" Value="Visible"/>
                                            <Setter  TargetName="im_brokerB_ROK" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BrokerBStatus}" Value="4">
                                            <Setter  TargetName="im_brokerB_OK" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_TBC" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_PartOk" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_Refuse" Property="Visibility" Value="Collapsed"/>
                                            <Setter  TargetName="im_brokerB_ROK" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LookButtonStatus}" Value="1">
                                            <Setter  TargetName="bt_Status" Property="Foreground" Value="#FF4333"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LookButtonStatus}" Value="2">
                                            <Setter  TargetName="bt_Status" Property="Foreground" Value="#136C5E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BrokerAFree}" Value="1">
                                            <Setter Property="Background" TargetName="btn_brokerAFee" Value="#136C5E"/>
                                            <Setter Property="BorderBrush" TargetName="btn_brokerAFee" Value="#238F7E"/>
                                            <Setter Property="BorderThickness" TargetName="btn_brokerAFee" Value="0,1,0,0"/>
                                            <Setter Property="Foreground" TargetName="btn_brokerAFee" Value="#D7D7D7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BrokerBFree}" Value="1">
                                            <Setter Property="Background" TargetName="btn_brokerBFee" Value="#136C5E"/>
                                            <Setter Property="BorderBrush" TargetName="btn_brokerBFee" Value="#238F7E"/>
                                            <Setter Property="BorderThickness" TargetName="btn_brokerBFee" Value="0,1,0,0"/>
                                            <Setter Property="Foreground" TargetName="btn_brokerBFee" Value="#D7D7D7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FandianFlag}" Value="1">
                                            <Setter  TargetName="tb_Fandian1" Property="Foreground" Value="#FFD277"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FandianFlag}" Value="2">
                                            <Setter  TargetName="tb_Fandian1" Property="Foreground" Value="#A0A0A0"/>
                                            <Setter  TargetName="tb_Fandian1" Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDealHistDay}" Value="true">
                                            <Setter  TargetName="tb_createTime" Property="Foreground" Value="#8F9598"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

