                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" Value="#115B4F"  TargetName="border" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="BorderBrush" TargetName="border" Value="#4A4D4C">
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HistoryFalshDefaultButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="2,2,2,2" BorderThickness="0" Background="{TemplateBinding Background}" BorderBrush="#FFFFEBC8">
                                <Image  Grid.Column="1" Width="24" Height="24"  >
                                    <Image.Source>
                                        <DrawingImage >
                                            <DrawingImage.Drawing>
                                                <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                                                    <DrawingGroup Opacity="1">
                                                        <DrawingGroup Opacity="1" Transform="1,0,0,1,-1410,-120">
                                                            <DrawingGroup Opacity="1" Transform="1,0,0,1,1353,120">
                                                                <DrawingGroup Opacity="1" Transform="1,0,0,1,57,0">
                                                                    <GeometryDrawing Brush="#FFA0A0A0" Geometry="F0 M24,24z M0,0z M11.75,5C15.4779221,5 18.5,8.02207794 18.5,11.75 18.5,15.4779221 15.4779221,18.5 11.75,18.5 8.02207794,18.5 5,15.4779221 5,11.75 5,8.02207794 8.02207794,5 11.75,5z M11.75,6.23958111C8.68385567,6.23958111 6.19825458,8.7251822 6.19825458,11.7913265 6.19825458,14.8574709 8.68385567,17.3430719 11.75,17.3430719 14.8161443,17.3430719 17.3017454,14.8574709 17.3017454,11.7913265 17.3017454,8.7251822 14.8161443,6.23958111 11.75,6.23958111z M12.0031261,9.00602674L12.003,12.005 15.0111809,12.0051866 15.0111809,13.0055351 11.0027776,13.0055351 11.0027776,9.00602674 12.0031261,9.00602674z" />
                                                                </DrawingGroup>
                                                            </DrawingGroup>
                                                        </DrawingGroup>
                                                    </DrawingGroup>
                                                </DrawingGroup>
                                            </DrawingImage.Drawing>
                                        </DrawingImage>
                                    </Image.Source>
                                </Image>
                            </Border>

                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRefreshOrderEnable}" Value="false">
                                    <Setter Property="BorderBrush" TargetName="border" Value="#8F9598">
                                    </Setter>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#178674" TargetName="border"  />
                                    <Setter Property="Cursor" Value="Hand"></Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" Value="#115B4F"  TargetName="border" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="buttonTraderStyle" TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"></Setter>
                <Setter Property="Foreground" Value="#D7D7D7"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Left"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" 
                                    CornerRadius="2" Background="Transparent" >
                                <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>

                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="btnConfirmed" TargetType="{x:Type Button}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="0" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Padding" Value="5,1,5,1"/>
                <Setter Property="Foreground" Value="#FFEBC8"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border CornerRadius="1" BorderThickness="0,1,0,0" x:Name="border" Background="{TemplateBinding Background}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image   Margin="0" Width="24"  Height="24" >
                                        <Image.Source>
                                            <DrawingImage>
                                                <DrawingImage.Drawing>
                                                    <DrawingGroup ClipGeometry="M0,0 V24 H24 V0 H0 Z">
                                                        <DrawingGroup Opacity="1">
                                                            <DrawingGroup Opacity="1">
                                                                <DrawingGroup Opacity="1">
                                                                    <GeometryDrawing>
                                                                        <GeometryDrawing.Pen>
                                                                            <Pen Brush="#979797" Thickness="1" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" />
                                                                        </GeometryDrawing.Pen>
                                                                        <GeometryDrawing.Geometry>
                                                                            <EllipseGeometry RadiusX="4.63" RadiusY="4.63" Center="12,12" />
                                                                        </GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                    <GeometryDrawing Brush="#979797" Geometry="F1 M24,24z M0,0z M12,5C12.28,5,12.5,5.16,12.5,5.36L12.5,9.3C12.5,9.5 12.28,9.67 12,9.67 11.72,9.67 11.5,9.5 11.5,9.3L11.5,5.36C11.53,5.16,11.76,5,12,5z" />
                                                                    <GeometryDrawing Brush="#979797" Geometry="F1 M24,24z M0,0z M12,14.33C12.28,14.33,12.5,14.5,12.5,14.7L12.5,18.64C12.5,18.84 12.28,19 12,19 11.72,19 11.5,18.84 11.5,18.64L11.5,14.7C11.53,14.5,11.76,14.33,12,14.33z" />
                                                                    <GeometryDrawing Brush="#979797" Geometry="F1 M24,24z M0,0z M18.64,11.53C18.84,11.53 19,11.76 19,12.03 19,12.3 18.84,12.53 18.64,12.53L14.7,12.53C14.5,12.53 14.33,12.31 14.33,12.03 14.33,11.75 14.5,11.53 14.7,11.53z" />
                                                                    <GeometryDrawing Brush="#979797" Geometry="F1 M24,24z M0,0z M9.3,11.53C9.5,11.53 9.67,11.76 9.67,12.03 9.67,12.3 9.5,12.53 9.3,12.53L5.36,12.53C5.16,12.53 5,12.31 5,12.03 5,11.75 5.16,11.53 5.36,11.53z" />
                                                                </DrawingGroup>
                                                            </DrawingGroup>
                                                        </DrawingGroup>
                                                    </DrawingGroup>
                                                </DrawingImage.Drawing>
                                            </DrawingImage>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock x:Name="Txt" Margin="1,0,10,0" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{ DynamicResource BlueGreenButton.MouseOver.Background}"/>
                                    <Setter Property="Cursor" Value="Hand"></Setter>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource BlueGreenButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource BlueGreenButton.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource BlueGreenButton.Pressed.Border}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="Transparent"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="btnUnread" TargetType="{x:Type Button}">
                <Style.Resources>
                    <Style x:Key="FocusVisual">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="0" SnapsToDevicePixels="true" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Padding" Value="5,1,5,1"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
