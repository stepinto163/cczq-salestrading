<UserControl x:Class="STC.Broker.Plugin.View.Transaction.Design.UserCheckUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction.Design"
             mc:Ignorable="d" x:Name="userCheckUI"
             d:DesignHeight="450" d:DesignWidth="800" Width="144" Height="22">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition Width="20"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="tbName" Text="idb_broker06" Grid.Column="0" Margin="7, 4, 0, 0" HorizontalAlignment="Left" Foreground="#FFFFFF"
                   TextTrimming="CharacterEllipsis" FontSize="12" FontFamily="{DynamicResource DefaultFont}">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Path=Text}"></ToolTip>
            </TextBlock.ToolTip>
        </TextBlock>
        <Button x:Name="Close" Width="16" Height="16" BorderThickness="0"
                HorizontalAlignment="Right" Grid.Column="2" Click="Button_Click">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="CloseB" Background="#282828" Width="16" Height="16" BorderThickness="0">
                                    <TextBlock x:Name="closeTB" Text="×" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter Property="Background" TargetName="CloseB" Value="{DynamicResource ListBoxItemSettle.SelectedActive.Background}"/>
                                        <Setter Property="Foreground" TargetName="closeTB" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="true">
                                        <Setter Property="Background" TargetName="CloseB" Value="{DynamicResource ListBoxItemSettle.SelectedActive.Background}"/>
                                        <Setter Property="Foreground" TargetName="closeTB" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="false">
                                        <Setter Property="Background" TargetName="CloseB" Value="{DynamicResource SvgButton.Disabled.Background}"/>
                                        <Setter Property="Foreground" TargetName="closeTB" Value="{DynamicResource TextBox.Disable.Foreground}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                           
                        </Setter.Value>
                    </Setter>
                </Style>
               
            </Button.Style>
            
        </Button>
    </Grid>
</UserControl>
