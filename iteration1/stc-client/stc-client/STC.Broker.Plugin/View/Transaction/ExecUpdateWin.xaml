<Window x:Class="STC.Broker.Plugin.View.Transaction.ExecUpdateWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction"
        mc:Ignorable="d"
        Title="成交单发生修改" Height="355" Width="450"
        ResizeMode="NoResize" WindowStyle="None" Background="#282828" WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="textBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.YaHei.Semibold}"/>
                <!--<Setter Property="HorizontalAlignment" Value="Center"/>-->
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="14"/>
                <!--<Setter Property="Margin" Value="0, 10, 0, 0"/>-->
                <!--<Setter Property="Height" Value="18"/>-->
                <!--
                -->
            </Style>

            <Style x:Key="buttonStyle" TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="{StaticResource IDCFontFamily.Regular}"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                <Setter Property="Background" Value="#136C5E"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="0" CornerRadius="2" Name="PART_Background"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" Value="#178674"/>
                                    <Setter Property="BorderBrush"  Value="#178674"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background"  Value="#115B4F"/>
                                    <Setter Property="BorderBrush"  Value="#115B4F"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

            <SolidColorBrush x:Key="DefaultForeground" Color="#FFFFFF"></SolidColorBrush>

        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="5"
                       GlassFrameThickness="0">
        </WindowChrome>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="2" BorderThickness="1"  BorderBrush="#282828" Background="#0F0F0F">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="23.73"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="5"></RowDefinition>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition Height="100"></RowDefinition>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition Height="100"></RowDefinition>
                <RowDefinition Height="5"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource LightGrayButton.Pressed.Border}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="25"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="8,0,0,0" Text="成交单发生修改"  VerticalAlignment="Center" FontSize="14"
                           FontFamily="{StaticResource IDCFontFamily.YaHei}" HorizontalAlignment="Left" Foreground="{StaticResource DefaultForeground}"></TextBlock>

                <Button Grid.Column="2" x:Name="btnClose" Style="{StaticResource ImageCloseButton}" Width="20" Height="16" IsCancel="True" Click="btnClose_Click"></Button>
            </Grid>

            <TextBlock x:Name="tbOrderId"  Margin="16, 0, 0, 0" Height="14" HorizontalAlignment="Left"
                   Style="{StaticResource textBlockStyle}" Grid.Row="1" Text="单号{0}成交信息发生以下修改:"></TextBlock>

            <Border Background="#323232" Height="1" Grid.Row="2" Width="418"></Border>
            <TextBlock VerticalAlignment="Bottom" Margin="20, 0,20, 5" Height="16" FontSize="12" Foreground="{StaticResource ColorBrush.PaleGrey}" FontFamily="{StaticResource IDCFontFamily.YaHei}" Grid.Row="3" Text="原始内容:"></TextBlock>

            <Border CornerRadius="2" Grid.Row="4" Margin="20, 0, 20, 0" BorderThickness="0">
                <Grid  Background="{StaticResource TextBox.Static.Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"></RowDefinition>
                        <RowDefinition Height="25"></RowDefinition>
                        <RowDefinition Height="25"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid x:Name="gOld" Grid.Row="0" Margin="20, 8, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="46"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="sp_sendOld" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="txt_Dir" Grid.Column="0" Text="bid发ofr" Width="50" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" >
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_Chnenl" Margin="5,0,0,0" Grid.Column="0" Width="30" Text="对话" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_SendInst" Margin="5,0,0,0" Grid.Column="0" Width="90" Text="发中国工商银行上海" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left"  TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_Reamks" Margin="5,0,0,0" Grid.Column="0" MaxWidth="90" Text="bid发ofr2212222" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" >
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_payFee" Margin="5,0,0,0" Grid.Column="0" MaxWidth="90" Text="帮工商银行代付" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" >
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_Fee" Margin="5,0,0,0" Grid.Column="0" MaxWidth="30" Text="5厘" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" >
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="tbSend" Grid.Column="0" Text="发给" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" ></TextBlock>
                        <TextBlock x:Name="tbSendTo" Grid.Column="1" Width="100" Text="" Style="{StaticResource textBlockStyle}"
                                HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbSendOfr" Grid.Column="2" Text="Ofr发给" Style="{StaticResource textBlockStyle}"  Visibility="Collapsed"
                            HorizontalAlignment="Left" ></TextBlock>
                        <TextBlock x:Name="tbSendToOfr" Grid.Column="3" Width="100" Text="" Style="{StaticResource textBlockStyle}"  Visibility="Collapsed"
                                HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20, 0, 20, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62"></ColumnDefinition>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="65"></ColumnDefinition>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="tbCode" Grid.Column="0" Text="" TextTrimming="CharacterEllipsis" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" Margin="0,6,0,5" >
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="tbPrice" Grid.Column="2" Text="" Width="65" TextTrimming="CharacterEllipsis" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" Margin="0,6,0,5">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbQty" Grid.Column="3" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Width="65" TextTrimming="CharacterEllipsis"  Height="18" Padding="0, 1, 0, 0" TextAlignment="Center" Margin="5,4,4,4">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="tbSettle" Grid.Column="4" Text="" TextTrimming="CharacterEllipsis" FontSize="12" HorizontalAlignment="Left" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Width="86" Height="18" Padding="0, 1, 0, 0" TextAlignment="Center" Grid.ColumnSpan="2" Margin="0,4">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2" Margin="20,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="45"></ColumnDefinition>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="49"></ColumnDefinition>
                            <ColumnDefinition Width="0*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="tbTraderA" Grid.Column="0" Text="" Width="120" TextTrimming="CharacterEllipsis" Style="{StaticResource textBlockStyle}" TextAlignment="Left" 
                            HorizontalAlignment="Left" Height="14" >
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="tbBrokerA" Grid.Column="1" Width="45" TextTrimming="CharacterEllipsis" Text="" Style="{StaticResource textBlockStyle}" Height="14" />
                        <TextBlock x:Name="tbSize" Grid.Column="2" Text="" Style="{StaticResource textBlockStyle}" HorizontalAlignment="Left" Height="14"  Width="30" ></TextBlock>
                        <TextBlock x:Name="tbTraderB" Grid.Column="3" TextTrimming="CharacterEllipsis" Text="" Style="{StaticResource textBlockStyle}" HorizontalAlignment="Left" Height="14"  Width="120" >
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock x:Name="tbBrokerB" Grid.Column="4" TextTrimming="CharacterEllipsis" Text="" Style="{StaticResource textBlockStyle}"
                     Height="14"  Width="40" >
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock  Margin="20, 0, 20, 0" Foreground="{StaticResource ColorBrush.PaleGrey}" 
                       FontFamily="MicrosoftYaHei" Grid.Row="5" Text="新内容:"></TextBlock>

            <Border CornerRadius="2" Grid.Row="6" Margin="20, 0, 20, 0" BorderThickness="0">
                <Grid  Background="{StaticResource TextBox.Static.Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"></RowDefinition>
                        <RowDefinition Height="25"></RowDefinition>
                        <RowDefinition Height="25"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid x:Name="gNew" Grid.Row="0" Margin="20, 8, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="46"></ColumnDefinition>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="sp_sendNew" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="txt_DirN" Grid.Column="0" Text="bid发ofr" Width="50" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_ChnenlN" Margin="5,0,0,0" Grid.Column="0" Width="30" Text="对话" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left"  TextAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_SendInstN" Margin="5,0,0,0" Grid.Column="0" Width="90" Text="发中国工商银行上海" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextAlignment="Center" TextTrimming="CharacterEllipsis" >
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_ReamksN" Margin="5,0,0,0" Grid.Column="0" MaxWidth="90" Text="bid发ofr1232311" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left"  TextAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_payFeeN" Margin="5,0,0,0" Grid.Column="0" MaxWidth="90" Text="帮工商银行代付" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextAlignment="Center" TextTrimming="CharacterEllipsis" >
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock x:Name="txt_FeeN" Margin="5,0,0,0" Grid.Column="0" MaxWidth="30" Text="5厘" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" >
                                <TextBlock.ToolTip>
                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>


                        <TextBlock Grid.Column="0" x:Name="tbSend2" Text="发给" Style="{StaticResource textBlockStyle}"
                            HorizontalAlignment="Left" ></TextBlock>
                        <TextBlock x:Name="tbSendTo2" Grid.Column="1" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource DefaultForeground}" Width="100" Height="18" Padding="0, 1, 0, 0" TextAlignment="Center">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock Grid.Column="2" x:Name="tbSend2Ofr" Text="Ofr发给" Style="{StaticResource textBlockStyle}" Visibility="Collapsed"
                            HorizontalAlignment="Left" ></TextBlock>
                        <TextBlock x:Name="tbSendTo2Ofr" Grid.Column="3" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource DefaultForeground}" Width="100" Height="18" Padding="0, 1, 0, 0" TextAlignment="Center"  Visibility="Collapsed">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20, 0, 20, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="65"></ColumnDefinition>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="tbCodeNew" Grid.Column="0" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Padding="0, 1, 0, 0" TextAlignment="Center" 
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Margin="0,4" Width="60">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbPriceNew" Grid.Column="2" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Width="65" TextTrimming="CharacterEllipsis" Padding="0, 1, 0, 0" TextAlignment="Center" HorizontalAlignment="Left" Margin="0,4">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbQtyNew" Grid.Column="3" Text="" Width="65" TextTrimming="CharacterEllipsis" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Padding="0, 1, 0, 0" TextAlignment="Center" Margin="5,4,4,4" >
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbSettleNew" Grid.Column="4" Text="" Width="86" TextTrimming="CharacterEllipsis" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Padding="0, 1, 0, 0" TextAlignment="Center" Margin="0,4">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2" Margin="20,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="45"></ColumnDefinition>
                            <ColumnDefinition Width="30"></ColumnDefinition>
                            <ColumnDefinition Width="120"></ColumnDefinition>
                            <ColumnDefinition Width="49"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="tbTraderANew" Grid.Column="0" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Width="120" TextTrimming="CharacterEllipsis"  Height="18" Padding="0, 1, 0, 0" TextAlignment="Left" 
                                   HorizontalAlignment="Left">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbBrokerANew" Grid.Column="1" Width="45" TextTrimming="CharacterEllipsis" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Height="18" Padding="0, 1, 0, 0" TextAlignment="Center"></TextBlock>

                        <TextBlock x:Name="tbSizeNew" Grid.Column="2" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Width="30" Height="18" Padding="0, 1, 0, 0" TextAlignment="Center"></TextBlock>

                        <TextBlock x:Name="tbTraderBNew" Grid.Column="3" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Width="120" TextTrimming="CharacterEllipsis" Height="18" Padding="0, 1, 0, 0" TextAlignment="Center">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>

                        <TextBlock x:Name="tbBrokerBNew" Grid.Column="4" TextTrimming="CharacterEllipsis" Text="" FontSize="12" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" 
                                   Foreground="{StaticResource DefaultForeground}" Width="40" Height="18" Padding="0, 1, 0, 0" TextAlignment="Center">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Path=Text}"></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
            <Border Background="#323232" Height="1" Grid.Row="7" Width="418"></Border>
            <Button Grid.Row="8" x:Name="btnKnow" Margin="0,-6,0,0" Content="我知道了" HorizontalAlignment="Center" VerticalAlignment="Center" Width="124"  Height="24" Click="btnKnow_Click"
                Style="{StaticResource buttonStyle}"></Button>
        </Grid>
    </Border>
</Window>
