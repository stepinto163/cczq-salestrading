<UserControl x:Class="STC.Broker.Plugin.View.Transaction.Settle.SettleUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction.Settle"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="302" Height="182" Width="286" Background="#193D37">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/IDC.Broker.Plugin;component/BrokerDict.xaml"></ResourceDictionary>-->
            </ResourceDictionary.MergedDictionaries>


            <Style x:Name="ListBoxItemStyle2" TargetType="{x:Type ListBoxItem}">
                <Style.Resources>
                    <SolidColorBrush x:Key="Item.MouseOver.Background" Color="#1F26A0DA"/>
                    <SolidColorBrush x:Key="Item.MouseOver.Border" Color="#a826A0Da"/>
                    <SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="#696969"/>
                    <SolidColorBrush x:Key="Item.SelectedInactive.Border" Color="#696969"/>
                    <SolidColorBrush x:Key="Item.SelectedActive.Background" Color="#136C5E"/>
                    <SolidColorBrush x:Key="Item.SelectedActive.Border" Color="#136C5E"/>
                    <SolidColorBrush x:Key="Item.MouseOver.Foreground" Color="#FF26A0DA"/>
                    <SolidColorBrush x:Key="Item.SelectedInactive.Foreground" Color="#1F1F1F"/>
                    <SolidColorBrush x:Key="Item.SelectedActive.Foreground" Color="#190E00"/>
                </Style.Resources>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                <!--<Setter Property="Background" Value="Transparent"/>-->
                <Setter Property="Foreground" Value="#D7D7D7"/>
                <Setter Property="Background" Value="#282828"/>
                <Setter Property="FontFamily" Value="MicrosoftYaHei"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <!--<Setter Property="Height" Value="22"></Setter>-->
                <!--<Setter Property="Padding" Value="2,2,0,2"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource Item.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Item.MouseOver.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource Item.SelectedInactive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Item.SelectedInactive.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--<Condition Property="Selector.IsSelectionActive" Value="True"/>-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource Item.SelectedActive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Item.SelectedActive.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#D7D7D7"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                                <MultiTrigger >
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="False"/>
                                        <Condition Property="IsSelected" Value="false"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="#4A4D4C"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="#4A4D4C"/>
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="#888C8A"/>
                                </MultiTrigger>
                                <MultiTrigger >
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource Item.SelectedInactive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource Item.SelectedInactive.Border}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="#1F1F1F"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxStyle1" TargetType="{x:Type ListBox}">
                <Style.Resources>
                    <SolidColorBrush x:Key="ListBox.Static.Background" Color="#172422"/>
                    <SolidColorBrush x:Key="ListBox.Static.Border" Color="#FFABADB3"/>
                    <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#4A4D4C"/>
                    <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#4A4D4C"/>
                    <SolidColorBrush x:Key="ListBox.Disabled.Foreground" Color="#888C8A"/>
                </Style.Resources>
                <Setter Property="Background" Value="{StaticResource ListBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ListBox.Static.Border}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <Border x:Name="Bd" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="1" SnapsToDevicePixels="true">
                                <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter x:Name="itemsPresenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Border}"/>
                                    <!--<Setter Property="TextElement.Foreground" TargetName="itemsPresenter" Value="ListBox.Disabled.Foreground"/>-->
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsGrouping" Value="true"/>
                                        <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="DatePickerTextBox">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <TextBox Text="{Binding Path=SelectedDate, StringFormat='yyy-MM-dd dddd', RelativeSource={RelativeSource AncestorType=DatePicker}}"
                                     BorderThickness="0" Height="24" Background="#0F0F0F" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" FontSize="14" 
                                     Foreground="#FFFFFF" Style="{DynamicResource }">

                            </TextBox>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TextBoxStyle" BasedOn="{x:Null}" TargetType="{x:Type TextBox}">
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="Bd" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                >
                                <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"></ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid Background="#0A0F0E" >
        <Grid.RowDefinitions>
            <RowDefinition Height="38"></RowDefinition>
            <RowDefinition Height="150"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Border x:Name="bd_side" CornerRadius="2" Background="#102A3B" Height="30" Margin="8,8,8,0">
            <TextBlock x:Name="tbSide"  Text="Ofr" Width="36"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0082D8" FontSize="14" FontFamily="MicrosoftYaHei" FontWeight="Bold" ></TextBlock>
        </Border>
      


        <Border CornerRadius="2" Background="{StaticResource RadioOrangeButton.Pressed.Background}" Grid.Row="1"  >
            <StackPanel  Orientation="Vertical" HorizontalAlignment="Left">

                <ListBox x:Name="lbSettle"
                         Margin="8,8,0,0"  
                         HorizontalAlignment="Left"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         HorizontalContentAlignment="Center"
                         Background="Transparent" 
                         BorderThickness="1" 
                         Style="{StaticResource ListBoxStyle1}" 
                         FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                         Foreground="#D7D7D7"
                         FontSize="14"         
                         SelectionMode="Single"
                         BorderBrush="Transparent"   
                         SelectionChanged="lbSettle_SelectionChanged"
                         >
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <!--<ListBoxItem x:Name="lbtAll" Width="36" Height="22"  Background="#22544C"  Content="不限"/>-->
                    <ListBoxItem x:Name="lbt0" Width="63"  Height="24"  Content="+0"/>
                    <ListBoxItem x:Name="lbt1" Width="73"   Content="+1"/>
                    <ListBoxItem x:Name="lbtTomorrow0" Width="63"   Content="明天+0"/>
                    <ListBoxItem x:Name="lbtTomorrow1" Width="63"  Content="明天+1" />
                </ListBox>

                <Border BorderThickness="1" Margin="8, 8, 10, 0" HorizontalAlignment="Left" Height="1" Width="325"  BorderBrush="#323232"></Border>
                <ListBox x:Name="lbWeek"
                         Margin="10,8,10,0"                        
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Style="{DynamicResource ListBoxStyle1}" 
                         FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                         Foreground="{StaticResource ColorBrush.While3}"
                         FontSize="14"         
                         SelectionMode="Extended"
                         BorderBrush="Transparent"   
                         HorizontalAlignment="Left"
                         SelectionChanged="lbWeek_SelectionChanged"
                             >
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem x:Name="lbtOne" Width="35"  Height="24"   Content="周一"/>
                    <ListBoxItem x:Name="lbtTow" Width="36"   Content="周二" />
                    <ListBoxItem x:Name="lbtThree" Width="36"   Content="周三" />
                    <ListBoxItem x:Name="lbtFour" Width="36"   Content="周四" />
                    <ListBoxItem x:Name="lbtFive" Width="36"  Content="周五" />
                    <ListBoxItem x:Name="lbtSix" Width="36"   Content="周六" />
                    <ListBoxItem x:Name="lbtSeven" Width="35" Height="24"  Content="周日" />
                </ListBox>

                <Grid Margin="8,8,0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" ></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="dpDate" Grid.Column="0" Height="24"  Width="132" Style="{DynamicResource GreenBlueDatePickerStyle}" HorizontalAlignment="Left"  SelectedDateChanged="dpDate_SelectedDateChanged"
                                 BorderThickness="1" Background="Transparent" BorderBrush="#3C3C3C">
                    </DatePicker>

                    <ListBox x:Name="lbAdd"
                                 Grid.Column="1"    
                             Margin="5,0,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                         Background="Transparent" 
                         BorderThickness="1" 
                         Style="{DynamicResource ListBoxStyle1}" 
                         FontFamily="{StaticResource IDCFontFamily.YaHei}" 
                         Foreground="{StaticResource ColorBrush.While3}"
                         FontSize="14"         
                         Width="218"
                         SelectionMode="Extended"
                         BorderBrush="Transparent" 
                         HorizontalAlignment="Center"
                         SelectionChanged="lbAdd_SelectionChanged"
                         >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem x:Name="lbtAdd0" Width="35" Height="24"   Content="+0" />
                        <ListBoxItem x:Name="lbtAdd1" Width="35"  Height="24"  Content="+1" />

                    </ListBox>


                </Grid>

                <Grid Grid.Row="3" Margin="8, 8, 0, 9"  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="交易日:" HorizontalAlignment="Left"  FontFamily="{StaticResource IDCFontFamily.YaHei}" Foreground="#A0A0A0 "
                           FontSize="14"></TextBlock>

                    <TextBlock Grid.Column="1" x:Name="tbTradeDate" Margin="4, 0, 0, 0" HorizontalAlignment="Left" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" Foreground="#FFFFFF"
                           FontSize="14" Text=""></TextBlock>

                    <TextBlock Grid.Column="2" Text="交割日:" HorizontalAlignment="Left" FontFamily="{StaticResource IDCFontFamily.YaHei}" Foreground="#A0A0A0"
                           FontSize="14"></TextBlock>

                    <TextBlock Grid.Column="3" x:Name="tbDeliveryDate" Margin="4, 0, 0, 0" HorizontalAlignment="Left" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" Foreground="#FFFFFF"
                           FontSize="14" Text=""></TextBlock>
                </Grid>

            </StackPanel>
        </Border>

      
    </Grid>
</UserControl>
