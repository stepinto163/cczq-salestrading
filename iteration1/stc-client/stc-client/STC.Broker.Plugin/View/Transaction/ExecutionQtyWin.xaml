<Window x:Class="STC.Broker.Plugin.View.Transaction.ExecutionQtyWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.Broker.Plugin.View.Transaction"
        mc:Ignorable="d"
        Title="成交量统计" Height="250" Width="382"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#000000"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0" 
                      CornerRadius="0">
        </WindowChrome>
    </WindowChrome.WindowChrome>
    <Border BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray18}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource LightGrayButton.Pressed.Border}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="35"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="成交量统计" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"
                           FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}" Foreground="#FFFFFF"
                       Margin="10,0,0,0"/>
                <Button Grid.Column="2" x:Name="btnClose" Style="{StaticResource ImageCloseButton}" Width="22" Height="22" IsCancel="True" Click="btnClose_Click"></Button>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Grid Height="155" Width="145" Background="{StaticResource ColorBrush.BlackishGreen}" Margin="15" 
                  Visibility="{Binding VisibilityBuy}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="40"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="买入量" Foreground="{StaticResource ColorBrush.Orange1}" FontSize="18" Width="auto" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock Grid.Row="1" Text="{Binding BuyQty}" Foreground="{StaticResource ColorBrush.Yellow}" FontSize="36" Width="auto" 
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5" 
                           ToolTip="{Binding BuyQty}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="E" Foreground="{StaticResource ColorBrush.Gray10}" FontSize="18" 
                           VerticalAlignment="Center" Margin="0,15,0,0" FontWeight="SemiBold" FontFamily="{StaticResource IDCFontFamily.Arial.BoldMT}"/>
                </Grid>
                <Grid Height="155" Width="145" Background="{StaticResource ColorBrush.BlackishGreen}" Margin="15"
                  Visibility="{Binding VisibilitySell}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="40"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="卖出量" Foreground="{StaticResource ColorBrush.Blue1}" FontSize="18" Width="auto" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock Grid.Row="1" Text="{Binding SellQty}" Foreground="{StaticResource ColorBrush.Yellow}" FontSize="36" Width="auto" 
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5" 
                           ToolTip="{Binding SellQty}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="E" Foreground="{StaticResource ColorBrush.Gray10}" FontSize="18" 
                           VerticalAlignment="Center" Margin="0,15,0,0" FontWeight="SemiBold" FontFamily="{StaticResource IDCFontFamily.Arial.BoldMT}"/>

                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
