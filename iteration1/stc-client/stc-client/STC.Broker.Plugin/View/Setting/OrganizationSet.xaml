<commonComp:WindowBase x:Class="STC.Broker.Plugin.View.Setting.OrganizationSet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Setting"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        d:DesignWidth="600" d:DesignHeight="500"
        Title="机构设置" Height="462" Width="420"
         Background="#0A0F0E" BorderThickness="2" 
        BorderBrush="#282828" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        WindowState="Normal">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="MyScrollViewer" BasedOn="{StaticResource DefaultScrollViewer}" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="False"/>
            </Style>

            <Style TargetType="{x:Type ListBoxItem}" x:Key="ListBoxItemStyle">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem" >
                            <Border Background="{TemplateBinding Background}" >
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding shortnamecn }" Margin="5,0,8,0"  TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <!--<ContentPresenter  Margin="5,0,5,0"  HorizontalAlignment="Left" VerticalAlignment="Center">
                                        -->
                                    <!--<ContentPresenter.ToolTip>
                                            <ToolTip  Content="{Binding Path=}"></ToolTip>
                                        </ContentPresenter.ToolTip>-->
                                    <!--
                                    </ContentPresenter>-->
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ListBoxItem.IsSelected"  Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"  />
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"   />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--<EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"></EventSetter>-->
            </Style>

            <Style TargetType="{x:Type ListBoxItem}" x:Key="organListBoxItemStyle">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem" >
                            <Border Background="{TemplateBinding Background}" >
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="40" x:Name="colum1"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <!--<ContentPresenter Margin="5,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center" ></ContentPresenter>-->
                                    <TextBlock Text="{Binding instName}" TextTrimming="CharacterEllipsis"  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,5,0" Foreground="{TemplateBinding Foreground}"  FontSize="12">
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <!--<Button x:Name="btnDelOrgan" Grid.Column="2"  Style="{StaticResource DelButtonStyle}" Background="Transparent"  BorderBrush="{ TemplateBinding Background}" Click="btnDelOrgan_Click">
                                        <Button.ToolTip>
                                            <ToolTip Content="删除机构"></ToolTip>
                                        </Button.ToolTip>
                                    </Button>-->

                                    <Button x:Name="btn_CostSetting" Grid.Column="2"  Width="36" Height="22" 
                                            Style="{DynamicResource GraySlateButtonStyle}" Foreground="#D7D7D7" BorderThickness="0 1 0 0"
                                            FontSize="12" Click="btn_CostSetting_Click">费用</Button>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ListBoxItem.IsSelected"  Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"  />
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"  />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="ListBox" x:Key="ListBoxStyle">
                <Setter Property="Background" Value="#0F0F0F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemStyle}"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Style="{StaticResource MyScrollViewer}">
                                <VirtualizingStackPanel  Orientation="Vertical" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="organListBox" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="#0F0F0F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource organListBoxItemStyle}"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Style="{StaticResource MyScrollViewer}">
                                <VirtualizingStackPanel  Orientation="Vertical" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="gMain" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="8"></RowDefinition>
            <!--<RowDefinition Height="42"></RowDefinition>-->
            <!--<RowDefinition Height="Auto"></RowDefinition>-->
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" x:Name="visTextTextBox" Width="0" Height="0"></TextBox>


        <commonComp:WatermarkTextBox x:Name="tb_Organization" Margin="10, 10, 10, 0" Grid.Row="1" Width="395" Height="22" WaterMark="搜索机构"
                                 PreviewKeyDown="tb_Organization_PreviewKeyDown"
                                 KeyDown="tb_Organization_KeyDown" 
                                 TextChanged="tb_Organization_TextChanged"
                                 HorizontalAlignment="Left"
                                 input:TextCompositionManager.PreviewTextInput="tbTraderAInfoChange_PreviewTextInput"
                                 input:TextCompositionManager.PreviewTextInputUpdate="tbTraderAInfoChange_PreviewTextInputUpdate">
        </commonComp:WatermarkTextBox>

        <Popup x:Name="pop_Organization" PlacementTarget="{Binding ElementName=tb_Organization}" LostFocus="popReciveName_LostFocus" StaysOpen="False">
            <DataGrid x:Name="dgRecive"
                                  Grid.Row="1"
                                  Style="{DynamicResource DefaultDataGridNoSpaceStyle}"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  Width="200" 
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                   DataGridRow.MouseUp="dgRecive_MouseUp"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style x:Key="tbStyle" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding shortnamecn}" Width="1*" >
                        <DataGridTextColumn.ElementStyle >
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                <Setter Property="Padding" Value="10,0,0,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Popup>

        <Border CornerRadius="2" BorderThickness="1"   Grid.Row="2" Margin="10,0,0,0" Background="#0A0F0E">
            <Grid  Margin="2" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185*"></ColumnDefinition>
                    <ColumnDefinition Width="22"></ColumnDefinition>
                    <ColumnDefinition Width="210*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center" Background="Transparent" FontFamily="{DynamicResource DefaultFont}"
                                    Foreground="#A0A0A0" Margin="0,4,0,3" Text="不代付机构"/>
                <TextBlock  FontSize="12" VerticalAlignment="Center" Grid.Column="2"  Background="Transparent" FontFamily="{DynamicResource DefaultFont}"
                                    Foreground="#A0A0A0" Margin="10,4,0,3" Text="代付机构" Grid.ColumnSpan="2"/>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Background="#0F0F0F" BorderBrush="#323232" BorderThickness="1" CornerRadius="2">
                    <ListBox Grid.Row="1" SelectionMode="Multiple"  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"  ItemsSource="{Binding}" DisplayMemberPath="shortnamecn"  x:Name="boxGroupList" Style="{StaticResource ListBoxStyle}" >
                    </ListBox>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Margin="10,0,10,0" Background="#0F0F0F" BorderBrush="#323232" BorderThickness="1" CornerRadius="2" Grid.ColumnSpan="2">
                    <ListBox  x:Name="lborganList" SelectionMode="Multiple" ItemsSource="{Binding}" 
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  DisplayMemberPath="OrganizationName" Style="{StaticResource organListBox}" >
                    </ListBox>
                </Border>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,142">
                    <Button x:Name="btnAdd"  Margin="0" Width="22" Height="22" FontWeight="SemiBold" Style="{DynamicResource GraySlateButtonStyle}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" FontSize="12" Click="btnAdd_Click" Content=">"></Button>
                    <Button x:Name="btnDel"  Margin="0,4,0,0"  Width="22" Height="22" FontWeight="SemiBold" Style="{DynamicResource GraySlateButtonStyle}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" FontSize="12" Click="btnDel_Click" Content="&lt;" ></Button>
                </StackPanel>

            </Grid>
        </Border>

        <!--<StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center"  VerticalAlignment="Center">
                <Button x:Name="btnCancel" Grid.Column="3" Margin="0,0,4,0" Width="70" Height="22"  Style="{StaticResource buttonStyle}" FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="12" Foreground="{StaticResource ColorBrush.PaleGold}" Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOk" Grid.Column="5"  Width="70" Height="22"  Style="{StaticResource buttonStyle}" FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="12" Foreground="{StaticResource ColorBrush.PaleGold}" Click="btnOkClose_Click">确认</Button>
            </StackPanel>-->
    </Grid>
</commonComp:WindowBase>

