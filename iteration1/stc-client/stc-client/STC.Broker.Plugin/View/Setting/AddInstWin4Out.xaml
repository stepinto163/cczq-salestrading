<commonComp:WindowBase x:Class="STC.Broker.Plugin.View.Setting.AddInstWin4Out"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Setting"
             xmlns:tcontrol="clr-namespace:STC.Broker.Plugin.View.Component"
            xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Background="#0A0F0E" BorderThickness="2" 
        BorderBrush="#282828" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" 
        WindowState="Normal"
        Title="添加控制机构" Height="120" Width="284">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="16"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" x:Name="visTextTextBox" Width="0" Height="0"></TextBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
            <TextBlock Text="机构简称：" Width="60" Margin="15,0,0,0" Foreground="#A0A0A0" VerticalAlignment="Center"></TextBlock>
            <commonComp:WatermarkTextBox x:Name="tb_Organization" Margin="5,0,10, 0" Grid.Row="1" Width="195" Height="22" WaterMark="搜索机构"
                                 PreviewKeyDown="tb_Organization_PreviewKeyDown"
                                 KeyDown="tb_Organization_KeyDown" 
                                 TextChanged="tb_Organization_TextChanged"
                                 HorizontalAlignment="Left">
            </commonComp:WatermarkTextBox>
            <Popup x:Name="pop_Organization" PlacementTarget="{Binding ElementName=tb_Organization}" LostFocus="popReciveName_LostFocus" StaysOpen="False">
                <DataGrid x:Name="dgRecive"
                                  Grid.Row="1"
                                  Style="{DynamicResource DefaultDataGridNoSpaceStyle}"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  Width="200" 
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                   DataGridRow.MouseUp="dgRecive_MouseUp"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style x:Key="tbStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding shortnamecn}" Width="1*" >
                            <DataGridTextColumn.ElementStyle >
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                    <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </Popup>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="btnCancel" Grid.Column="3" Margin="0,0,8,0" Width="70" Height="22" Style="{DynamicResource GrayButtonStyle}" FontFamily="{DynamicResource DefaultFont}" Click="btnCloseWin_Click">取消</Button>
            <Button x:Name="btnOk" Grid.Column="4"  Margin="0,0,10,0" Width="70" Height="22" Style="{DynamicResource BlueGreenStyle}" FontFamily="{DynamicResource DefaultFont}" FontSize="12" Click="btnOk_Click">确认</Button>
        </StackPanel>
    </Grid>

</commonComp:WindowBase>
