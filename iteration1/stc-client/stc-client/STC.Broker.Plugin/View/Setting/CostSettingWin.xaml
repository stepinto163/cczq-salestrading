<commonComp:WindowBase x:Class="STC.Broker.Plugin.View.Setting.CostSettingWin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2006" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Setting"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        Title="机构设置" Height="475" Width="365"
        Background="#0A0F0E" BorderThickness="2" 
        BorderBrush="#282828" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        WindowState="Normal">
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="buttonStyle1" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                <Setter Property="Background" Value="Transparent"></Setter>
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" Width="{TemplateBinding Width}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Height="{TemplateBinding Height}" 
                                    CornerRadius="2"  >
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Border BorderThickness="1" x:Name="_dabt" BorderBrush="#FFFFFF" Height="1" Grid.Row="1" Width="24" Margin="0,-3,0,0"></Border>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"></ContentPresenter>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#040B0B"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#040B0B"/>
                                    <Setter Property="Foreground"  Value="{DynamicResource UnderlineButton.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="_dabt"  Value="{DynamicResource UnderlineButton.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="#040B0B"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="#040B0B"/>
                                    <Setter Property="Foreground"  Value="{DynamicResource UnderlineButton.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="_dabt"  Value="{DynamicResource UnderlineButton.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="BorderBrush" TargetName="_dabt" Value="{DynamicResource ColorBrush.Gray2}"/>
                                    <Setter Property="Foreground"  Value="{DynamicResource ColorBrush.Gray2}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ListBoxItem}" x:Key="ListBoxItemStyle">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="#040B0B"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem" >
                            <Border Background="{TemplateBinding Background}" >
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="81"></ColumnDefinition>
                                        <ColumnDefinition Width="22"></ColumnDefinition>
                                        <ColumnDefinition Width="81"></ColumnDefinition>
                                        <ColumnDefinition Width="12"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="tb_term11" Grid.Column="0"  Width="80"
                                          Grid.Row="0" 
                                          Height="22" 
                                           Text="{Binding termStart}"
                                          Style="{DynamicResource STCDefaultBoxStyle}"
                                          HorizontalAlignment="Left" Margin="0"/>
                                    <TextBlock Grid.Column="1" FontSize="12" Grid.Row="0" VerticalAlignment="Center" Background="Transparent" Text="Y/D"/>
                                    <TextBox x:Name="tb_term102" Grid.Column="2"  Width="80"
                                    Grid.Row="9" 
                                    Height="22"  
                                    Text="{Binding termEnd}"
                                    Style="{DynamicResource STCDefaultBoxStyle}"
                                    HorizontalAlignment="Left" Margin="0"/>

                                    <StackPanel Orientation="Horizontal"  Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBox x:Name="tb_cost1"  Text="{Binding fee}"  Width="80" Grid.Row="0" Height="22"  Style="{DynamicResource STCDefaultBoxStyle}" HorizontalAlignment="Left" Margin="0"/>
                                        <TextBlock  Foreground="{DynamicResource ColorBrush.PaleGrey}"
                                         FontSize="13" Text="厘" Margin="4,0,0,0"  VerticalAlignment="Center" Grid.Row="2" />
                                        <Button x:Name="btn_delete1" Margin="4,0,0,0"  IsEnabled="{ Binding IsDel}"  Content="删除"  Style="{StaticResource buttonStyle1}"  Click="btn_delete1_Click" ></Button>
                                    </StackPanel>

                                    <ContentPresenter  Margin="5,0,8,0"  HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ContentPresenter.ToolTip>
                                            <ToolTip  Content="{Binding Path=Content}"></ToolTip>
                                        </ContentPresenter.ToolTip>
                                    </ContentPresenter>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ListBoxItem.IsSelected"  Value="True">
                                    <Setter Property="Background" Value="#040B0B"  />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#040B0B"   />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--<EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"></EventSetter>-->
            </Style>

            <Style TargetType="ListBox" x:Key="ListBoxStyle">
                <Setter Property="Background" Value="#040B0B"/>
                <Setter Property="Foreground" Value="#D4C6A7"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemStyle}"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel  Orientation="Vertical" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="gMain" >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="42"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="202"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" FontSize="12" Grid.Row="1" VerticalAlignment="Center" Background="Transparent"
                                    Foreground="#A0A0A0" Margin="12,0, 0, 0" Text="期限"/>
        <TextBlock  FontSize="12" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"  Background="Transparent"
                                    Foreground="#A0A0A0" Margin="12,0, 0, 0" Text="费用"/>

        <Border CornerRadius="2" BorderThickness="1"  Grid.ColumnSpan="2"  Grid.Row="2" Margin="12,0,0,0" Background="#0F0F0F">
            <ListBox Grid.Row="1" SelectionMode="Multiple"  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"  ItemsSource="{Binding}" DisplayMemberPath="Shortnamecn"  x:Name="boxGroupList" Style="{StaticResource ListBoxStyle}" >
            </ListBox>
        </Border>

        <StackPanel Margin="13,0,0,0" Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="btn_Add"  Content="添加"  Style="{StaticResource buttonStyle1}"  Click="btn_Add_Click" >
                <Button.ToolTip>
                    <ToolTip Content="最多可以设置组代付费用"></ToolTip>
                </Button.ToolTip>
            </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Center"  VerticalAlignment="Center">
            <Button x:Name="btnCancel" Grid.Column="3" Margin="0,0,4,0" Width="70" Height="22" Style="{DynamicResource GrayButtonStyle}" FontFamily="{DynamicResource DefaultFont}" Click="btnCancel_Click">取消</Button>
            <Button x:Name="btnOk" Grid.Column="5"  Width="70" Height="22" Style="{DynamicResource BlueGreenStyle}" FontFamily="{DynamicResource DefaultFont}" FontSize="12" Click="btnOkClose_Click">确认</Button>
        </StackPanel>
    </Grid>
</commonComp:WindowBase>

