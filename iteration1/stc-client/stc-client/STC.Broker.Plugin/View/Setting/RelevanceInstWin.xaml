<commonComp:WindowBase x:Class="STC.Broker.Plugin.View.Setting.RelevanceInstWin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Setting"
             xmlns:comp="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" Background="#0A0F0E" BorderThickness="2" 
             BorderBrush="#282828" Title="关联方设置" WindowStartupLocation="CenterOwner"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*" ></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,4,3,8" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <commonComp:WatermarkTextBox x:Name="tb_Inst" Width="200" Height="25" KeyDown="tb_Inst_KeyDown" WaterMark="筛选机构"></commonComp:WatermarkTextBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Grid.Column="0"  x:Name="add"    Width="93" Height="22" 
                            Style="{DynamicResource GraySlateButtonStyle}" Foreground="#D7D7D7" BorderThickness="0 1 0 0"
                            Click="Add_Click">添加</Button>
                    <Button Grid.Column="1"  x:Name="delete"  Width="93" Height="22" Margin="10,0,0,0"
                             Style="{DynamicResource GraySlateButtonStyle}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsEnabled="False"
                            Click="Delete_Inst">删除</Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <DataGrid x:Name="InstDataGrid"  HorizontalAlignment="Left" ItemsSource="{Binding}" FontSize="12" Opacity="1" BorderThickness="1"  BorderBrush="#323232" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Grid.ColumnSpan="4"
                          Style="{DynamicResource DefaultDataGridNoSpaceStyle}"
                                  >
                    <DataGrid.Resources>
                        <Style x:Key="tbStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="5,0,5,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <ToolTip Content="{Binding Path=Text}"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn   Width="40"  >
                            <DataGridTemplateColumn.HeaderTemplate >
                                <DataTemplate >
                                    <CheckBox  x:Name="cb_all" Style="{DynamicResource DefaultCheckBoxStyle}" Background="Transparent" Margin="6,0,0,0" IsChecked="{Binding IsAllSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:RelevanceInstWin}}}" Click="cb_all_Click"></CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{DynamicResource DefaultCheckBoxStyle}" Background="Transparent" Margin="5,0,0,0" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Height="12" IsChecked="{Binding IsSelect,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="CheckBox_Click"></CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="dgtcSeq" Header="机构" Width="120*" ElementStyle="{StaticResource tbStyle}" CanUserSort="False" SortMemberPath="goodsCode" FontWeight="Bold" Binding="{Binding InstName}"></DataGridTextColumn>
                        <DataGridTextColumn x:Name="dgtcGoodsCode" Header="关联机构" Width="120*" ElementStyle="{StaticResource tbStyle}" CanUserSort="False" SortMemberPath="goodsCode" FontWeight="Bold" Binding="{Binding RelevanceInstName}"></DataGridTextColumn>
                        <DataGridTextColumn x:Name="dgtc_action" Header="操作人" Width="60*" ElementStyle="{StaticResource tbStyle}" CanUserSort="False" SortMemberPath="goodsCode" FontWeight="Bold" Binding="{Binding Operator}"></DataGridTextColumn>
                        <DataGridTextColumn x:Name="dgtc_time" Header="操作时间" Width="120*" ElementStyle="{StaticResource tbStyle}" CanUserSort="False" SortMemberPath="goodsCode" FontWeight="Bold" Binding="{Binding OperationTime}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <comp:LoadingWaiting x:Name="LoadingUI" Grid.Row="1"  Grid.RowSpan="3" CanvasSize="130" EllipseCount="10" EllipseSize="20" StepAngle="36" TimeSpan="50"  Visibility="Collapsed"/>
    </Grid>
</commonComp:WindowBase>
