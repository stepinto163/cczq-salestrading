<UserControl x:Class="STC.Broker.Plugin.View.Setting.ManageSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Setting"
              xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <!--<UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>-->
    <Border BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray20}">
        <StackPanel Grid.Row="1" x:Name="gd_Setting" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}" Margin="18 0 18 0">
            <TextBox x:Name="txtVis" Width="0" Grid.Row="0" />

            <StackPanel x:Name="spSendSetting" Height="68">
                <TextBlock  x:Name="tb_SendSetting" FontWeight="Bold" Foreground="{DynamicResource ColorBrush.While}"
                            Text="发单管理"  Margin="10,10,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Grid Height="40" >
                    <Button x:Name="btn_SendSetting" Content="机构发单设置" IsEnabled="True" HorizontalAlignment="Left"
                         Margin="20,0,0,0"  Foreground="{DynamicResource ColorBrush.While}"
                         Width="90"  VerticalAlignment="Center" Height="24" Style="{DynamicResource GraySlateButtonStyle}"
                         BorderThickness="0,1,0,0"  Click="btn_SendSetting_Click"/>
                </Grid>

                <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource ColorBrush.Gray20}"/>
            </StackPanel>

            <StackPanel x:Name="sp_PaymentSetup" Height="68">
                <TextBlock x:Name="tb_PaymentSetup" FontWeight="Bold" Foreground="{DynamicResource ColorBrush.While}"
                            Text="代付设置" Margin="10,10,0,0" VerticalAlignment="Center"  TextWrapping="Wrap"/>

                <Grid Height="40" >
                    <Button x:Name="btn_PaymentSetup" Content="机构代付设置"   IsEnabled="True" HorizontalAlignment="Left"
                            Margin="20,0,0,0"  Foreground="{DynamicResource ColorBrush.While}"
                            Width="90"  VerticalAlignment="Center" Height="24" Style="{DynamicResource GraySlateButtonStyle}"
                            BorderThickness="0,1,0,0" Click="btn_PaymentSetup_Click"/>
                </Grid>
                <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource ColorBrush.Gray20}"/>
            </StackPanel>

            <StackPanel x:Name="spOutSendSetup" Height="68">
                <TextBlock  x:Name="tb_OutgoingSetup"  FontWeight="Bold" Foreground="{DynamicResource ColorBrush.While}"
                            Text="外发管理"  Margin="10,10,0,0" VerticalAlignment="Center"  TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" >
                    <Button  x:Name="btn_OutgoingSetup" Content="外发机构设置" IsEnabled="True" HorizontalAlignment="Left"
                            Margin="20,0,0,0"  Foreground="{DynamicResource ColorBrush.While}"
                            Width="90"  VerticalAlignment="Center" Height="24" Style="{DynamicResource GraySlateButtonStyle}"
                            BorderThickness="0,1,0,0"  Click="btn_OutgoingSetup_Click"/>

                    <Button  x:Name="btn_RelevanceSetup" Content="关联方设置" IsEnabled="True" HorizontalAlignment="Left"
                            Margin="15,0,0,0" Foreground="{DynamicResource ColorBrush.While}"
                            Width="90"  VerticalAlignment="Center" Height="24" Style="{DynamicResource GraySlateButtonStyle}"
                            BorderThickness="0,1,0,0"  Click="btn_RelevanceSetup_Click"/>
                </StackPanel>

                <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource ColorBrush.Gray20}"/>
            </StackPanel>

            <StackPanel x:Name="spMarketSetup" Height="88">
                <TextBlock x:Name="tb_MarketSetup"  FontWeight="Bold" Foreground="{DynamicResource ColorBrush.While}"
                            Text="自动开闭市设置"  Margin="10,10,0,0" VerticalAlignment="Center"  TextWrapping="Wrap"/>

                <StackPanel Height="30" x:Name="spOpenTime" Orientation="Horizontal"  HorizontalAlignment="Left"  VerticalAlignment="Center" Margin="10,0,0,0">
                    <CheckBox x:Name="cbAutoOpen"  HorizontalAlignment="Left"
                              Content="自动开市" Foreground="{DynamicResource ColorBrush.While}"
                              Margin="20,0,0,0" Grid.Column="0" Height="25" Padding="4 0 0 0" VerticalContentAlignment="Center"
                              Style="{DynamicResource DefaultCheckBoxStyle}" Width="80"
                              Checked="cbAutoOpen_Checked" Unchecked="cbAutoOpen_Unchecked"/>
                    <TextBox Width="36" x:Name="tb_startHours_Open"  Style="{DynamicResource  STCDefaultBoxStyle}" Margin="0,0,0,0"  Height="22"  PreviewKeyDown="tb_startHours_Open_PreviewKeyDown" IsEnabled="{Binding IsChecked, ElementName=cbAutoOpen}"></TextBox>
                    <TextBlock  Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="时"  Margin="2,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>
                    <TextBox Width="36" x:Name="tb_startMinute_Open" Style="{DynamicResource  STCDefaultBoxStyle}" Margin="4,0,0,0" Height="22"  PreviewKeyDown="tb_startHours_Open_PreviewKeyDown" IsEnabled="{Binding IsChecked, ElementName=cbAutoOpen}"></TextBox>
                    <TextBlock  Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="分"  Margin="2,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="至"  Margin="10,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>
                    <TextBox Width="36" x:Name="tb_endHours_Open" Style="{DynamicResource  STCDefaultBoxStyle}" Margin="6,0,0,0"  Height="22"  PreviewKeyDown="tb_startHours_Open_PreviewKeyDown" IsEnabled="{Binding IsChecked, ElementName=cbAutoOpen}"></TextBox>
                    <TextBlock Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="时"  Margin="6,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>
                    <TextBox Width="36"  x:Name="tb_endMinute_Open" Style="{DynamicResource  STCDefaultBoxStyle}" Margin="4,0,0,0"  Height="22" PreviewKeyDown="tb_startHours_Open_PreviewKeyDown" IsEnabled="{Binding IsChecked, ElementName=cbAutoOpen}"></TextBox>
                    <TextBlock Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="分"  Margin="6,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>

                </StackPanel>

                <StackPanel Height="30" x:Name="spCloseTime" Orientation="Horizontal"  HorizontalAlignment="Left"  VerticalAlignment="Center" Margin="10,0,0,0">
                    <CheckBox x:Name="cbAutoClose"  HorizontalAlignment="Left"
                              Content="自动闭市" Foreground="{DynamicResource ColorBrush.While}"
                              Margin="20,0,0,0" Grid.Column="0" Height="25" Padding="4 0 0 0" VerticalContentAlignment="Center"
                              Style="{DynamicResource DefaultCheckBoxStyle}" Width="80"
                              Checked="cbAutoClose_Checked" Unchecked="cbAutoClose_Unchecked"/>
                    <TextBox Width="36" x:Name="tb_startHours"  Style="{DynamicResource  STCDefaultBoxStyle}" Margin="0,0,0,0"  Height="22"  PreviewKeyDown="tb_startHours_PreviewKeyDown" IsEnabled="{Binding IsChecked, ElementName=cbAutoClose}"></TextBox>
                    <TextBlock  Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="时"  Margin="2,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>
                    <TextBox Width="36" x:Name="tb_startMinute" Style="{DynamicResource  STCDefaultBoxStyle}" Margin="4,0,0,0" Height="22"  PreviewKeyDown="tb_startHours_PreviewKeyDown" IsEnabled="{Binding IsChecked, ElementName=cbAutoClose}"></TextBox>
                    <TextBlock  Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="分"  Margin="2,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="至"  Margin="10,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>
                    <TextBox Width="36" x:Name="tb_endHours" Style="{DynamicResource  STCDefaultBoxStyle}" Margin="6,0,0,0"  Height="22"  PreviewKeyDown="tb_startHours_PreviewKeyDown" IsEnabled="{Binding IsChecked, ElementName=cbAutoClose}"></TextBox>
                    <TextBlock Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="时"  Margin="6,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>
                    <TextBox Width="36"  x:Name="tb_endMinute" Style="{DynamicResource  STCDefaultBoxStyle}" Margin="4,0,0,0"  Height="22" PreviewKeyDown="tb_startHours_PreviewKeyDown"  IsEnabled="{Binding IsChecked, ElementName=cbAutoClose}"></TextBox>
                    <TextBlock Foreground="{DynamicResource ColorBrush.Gray14}"
                            Text="分"  Margin="6,0,0,0" VerticalAlignment="Center" Grid.Row="11" TextWrapping="Wrap"/>

                </StackPanel>

                <Border BorderThickness="0 1 0 0" BorderBrush="{DynamicResource ColorBrush.Gray20}"/>
            </StackPanel>




        </StackPanel>


        

    </Border>
</UserControl>
