3 187.857,159.3295 188.008,159.3295 188.159,159.3295 188.289167,159.274833 188.3985,159.1655 188.507833,159.056167 188.5625,158.923333 188.5625,158.767L188.5625,153.548C188.5625,153.391667 188.507833,153.258833 188.3985,153.1495 188.289167,153.040167 188.159,152.9855 188.008,152.9855z M184.969,152.9855C184.812667,152.9855 184.679833,153.040167 184.5705,153.1495 184.461167,153.258833 184.4065,153.391667 184.4065,153.548L184.4065,158.767C184.4065,158.923333 184.461167,159.056167 184.5705,159.1655 184.679833,159.274833 184.812667,159.3295 184.969,159.3295 185.125333,159.3295 185.258167,159.274833 185.3675,159.1655 185.476833,159.056167 185.5315,158.923333 185.5315,158.767L185.5315,153.548C185.5315,153.391667 185.476833,153.258833 185.3675,153.1495 185.258167,153.040167 185.125333,152.9855 184.969,152.9855L184.969,152.9855z M191.016,152.9855C190.859667,152.9855 190.726833,153.040167 190.6175,153.1495 190.508167,153.258833 190.4535,153.391667 190.4535,153.548L190.4535,158.767C190.4535,158.923333 190.508167,159.056167 190.6175,159.1655 190.726833,159.274833 190.859667,159.3295 191.016,159.3295 191.172333,159.3295 191.305167,159.274833 191.4145,159.1655 191.523833,159.056167 191.5785,158.923333 191.5785,158.767L191.5785,153.548C191.5785,153.391667 191.523833,153.258833 191.4145,153.1495 191.305167,153.040167 191.172333,152.9855 191.016,152.9855z" />
                                                        </DrawingGroup>
                                                    </DrawingGroup>
                                                </DrawingGroup>
                                            </DrawingImage.Drawing>
                                        </DrawingImage>
                                    </Image.Source>
                                </Image>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#FFFFFF" TargetName="border"  />
                                    <Setter Property="Cursor" Value="Hand"></Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="BorderBrush" Value="#FFFFFF"  TargetName="border" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="AllowDrop" Value="True"></Setter>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem" >
                            <Grid   Background="{TemplateBinding Background}" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="20"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Image Width="10" Height="10" Grid.Column="0"  >
                                    <Image.Source>
                                        <DrawingImage >
                                            <DrawingImage.Drawing>
                                                <DrawingGroup ClipGeometry="M0,0 V7 H10 V0 H0 Z">
                                                    <DrawingGroup Opacity="1">
                                                        <DrawingGroup Opacity="1" Transform="1,0,0,1,-694,-323">
                                                            <GeometryDrawing Brush="#A0A0A0" Geometry="F1 M10,7z M0,0z M704,329C703.81006,329,703.974675,329.195005,703.997467,329.852038L704,329.996 703.996376,329.941492C703.975718,329.797326,703.876776,329.922944,703.963758,329.982905L704,330 694.909091,330C694.253906,330,694.031634,329.80698,694.003224,329.958639L694,329.996 694.002285,329.848403C694.02133,329.226161,694.14931,329.046792,694,329L704,329z M704,326C703.81006,326,703.974675,326.195005,703.997467,326.852038L704,326.996 703.996376,326.941492C703.975718,326.797326,703.876776,326.922944,703.963758,326.982905L704,327 694.909091,327C694.253906,327,694.031634,326.80698,694.003224,326.958639L694,326.996 694.002285,326.848403C694.02133,326.226161,694.14931,326.046792,694,326L704,326z M704,323C703.81006,323,703.974675,323.195005,703.997467,323.852038L704,323.996 703.996376,323.941492C703.975718,323.797326,703.876776,323.922944,703.963758,323.982905L704,324 694.909091,324C694.253906,324,694.031634,323.80698,694.003224,323.958639L694,323.996 694.002285,323.848403C694.02133,323.226161,694.14931,323.046792,694,323L704,323z" />
                                                        </DrawingGroup>
                                                    </DrawingGroup>
                                                </DrawingGroup>
                                            </DrawingImage.Drawing>
                                        </DrawingImage>
                                    </Image.Source>
                                </Image>
                                <usercontrols:TextBoxBlockNoLimite Text="{Binding GroupName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Column="1"
                                           Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                           TextBlock.FontSize="{TemplateBinding FontSize}" 
                                           Width="90"
                                           Foreground="#A0A0A0" TextChanged="TextBoxBlockNoLimite_TextChanged"/>
                                <Border Background="Transparent" x:Name="bdDeleteImage" Grid.Column="2" Visibility="{Binding ShowInstDeleteBtnVisibility}">
                                    <Button x:Name="btnDeleteImage" Width="20" HorizontalAlignment="Center"
                                        Height="16" Style="{StaticResource DelButtonStyle}" Click="btnDeleteImage_Click" Tag="{Binding GroupId}"></Button>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--<EventSetter Event="PreviewMouseMove" Handler="lsBridge_PreviewMouseMove"></EventSetter>
                <EventSetter Event="QueryContinueDrag" Handler="ListBoxItem_QueryContinueDrag"></EventSetter>-->
                <Style.Triggers>
                    <!--触发器，通过设置 AlternationCount="2"ItemsControl.AlternationIndex 实现颜色交替显示 -->
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource DefaultAlternatingRowBackground.ColorBrush}"  />
                    </Trigger>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="ListBoxItem.IsSelected"  Value="True">
                        <Setter Property="Background" Value="#173D37"  />
                        <Setter Property="Foreground" Value="#00CDAD" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#173D37"  />
                    </Trigger>
                </Style.Triggers>
            </Style>


            <Style TargetType="ListBox" x:Key="ListBoxStyle">
                <Setter Property="Background" Value="#0F0F0F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemStyle}"/>
                <!--设置模板-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter ScrollViewer.CanContentScroll="True"/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="3.5*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Transparent" CornerRadius="2" BorderThickness="0 0 1 0" BorderBrush="#323232">
                <StackPanel >
                    <commonComp:WatermarkTextBox x:Name="tbInst" WaterMark="搜索机构"
                             input:InputMethod.IsInputMethodEnabled="True"
                             input:TextCompositionManager.PreviewTextInput="tbInstPInput"
                             input:TextCompositionManager.PreviewTextInputUpdate="tbInstPInputUpdate"
                             KeyDown="tbInst_KeyDown" 
                             PreviewKeyDown="tbInst_PreviewKeyDown" 
                             TextChanged="tbInst_TextChanged" 
                             Height="22"
                             Margin="8,8,8,0"
                             LostKeyboardFocus="tbInst_LostKeyboardFocus"/>

                    <Popup x:Name="tbInstPop" PlacementTarget="{Binding ElementName=tbInst}" LostFocus="tbInstPop_LostFocus"  StaysOpen="False">
                        <DataGrid x:Name="dgInstResult"
                                  Grid.Row="1"
                                  Background="#193D37"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  Width="124"
                                  MaxHeight="200"
                                  MouseLeftButtonUp="dgInstResult_MouseLeftButtonUp"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                                  Style="{DynamicResource DefaultDataGrid}">
                            <DataGrid.Resources>
                                <Style x:Key="tbStyle" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding shortnamecn}" Width="1*" >
                                    <DataGridTextColumn.ElementStyle >
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                            <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Popup>

                    <Border Margin="8" BorderThickness="1" Height="1" BorderBrush="#323232"/>
                    <TextBlock Text="机构分组" Margin="8,0,0,0" Foreground="#A0A0A0" FontWeight="Black"/>
                    <Grid MinHeight="290" Margin="8 0 8 8">
                        <ListBox x:Name="GroupList" ItemsSource="{Binding IssueGroupViewModels, Mode=TwoWay}" 
                                 Style="{StaticResource ListBoxStyle}" 
                                 Height="278"
                                 dd:DragDrop.IsDragSource="True"
                                 dd:DragDrop.IsDropTarget="True"
                                 SelectionChanged="GroupList_SelectionChanged"
                                 PreviewMouseDown="GroupList_PreviewMouseDown"
                                 >
 
                        </ListBox>
                    </Grid>
                    <Button x:Name="btnUpdate" Height="24" Width="128" FontWeight="SemiBold"
                            Style="{DynamicResource GraySlateButtonStyle}" Foreground="#D7D7D7" BorderThickness="0 1 0 0"
                            Click="btnOk_Click">添加分组</Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1"  Grid.Row="0" Margin="5,8,8,8" Height="378"  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*" ></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Grid.Column="0" x:Name="add" Width="64" Height="24"
                            Style="{DynamicResource GraySlateButtonStyle}" Foreground="#D7D7D7" BorderThickness="0 1 0 0"
                            Click="Add_Click">添加</Button>
                        <Button Grid.Column="1"  x:Name="delete" Width="64" Height="24" Margin="10,0,0,0"
                            Style="{DynamicResource GraySlateButtonStyle}" Foreground="#D7D7D7" BorderThickness="0 1 0 0"
                            IsEnabled="False"
                            Click="DeleteInst">删除</Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!--<CheckBox Grid.Column="0" Content="默认请求" Width="80" 
                                      FontFamily="{StaticResource DefaultFont}" 
                                      FontSize="{StaticResource SmallContentFontSize}"
                                      Style="{StaticResource CommonCheckBoxStyle}" 
                                      BorderBrush="#136C5E"  
                                      Background="Transparent"
                                      Foreground="#8F9598" 
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding DefualtRequest, Mode=TwoWay}"
                                      Click="UpdateGroupDefaultRequst"
                                      />-->

                        <TextBlock Grid.Column="1" Text="共计" VerticalAlignment="Center"  Foreground="#A0A0A0"/>
                        <TextBlock Grid.Column="2" Text="--家" x:Name="tb_InstCount" VerticalAlignment="Center"  Foreground="#F9C152"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136*"/>
                        <ColumnDefinition Width="264*"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="71*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="InstDataGrid" HorizontalAlignment="Left" ItemsSource="{Binding IssueInstViewModels}" FontSize="12" Opacity="1"
                              Style="{DynamicResource DefaultDataGridNoSpaceStyle}" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0 4 0 0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True" ColumnHeaderHeight="24" RowHeight="24"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Grid.ColumnSpan="4">
                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Content="{Binding Path=Text}"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn  Width="40"  >
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate >
                                        <CheckBox  x:Name="cb_all" Style="{DynamicResource DefaultCheckBoxStyle}"  Background="Transparent" BorderBrush="#515151"  Margin="6,0,0,0"  VerticalContentAlignment="Center" IsChecked="{Binding DataContext.IsAllSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InstSettingWin}}}" Click="cb_all_Click"></CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{DynamicResource DefaultCheckBoxStyle}"  BorderBrush="#515151"  Background="Transparent" Margin="5,0,0,0" HorizontalAlignment="Left" HorizontalContentAlignment="Left"  VerticalContentAlignment="Center" IsChecked="{Binding IsSelect,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="CheckBox_Click"></CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="dgtcSeq" Header="机构简称" Width="60*" ElementStyle="{StaticResource tbStyle}" CanUserSort="False" SortMemberPath="goodsCode" Foreground="#FFFFFF"  FontWeight="Bold" Binding="{Binding InstShortName}"></DataGridTextColumn>
                            <DataGridTextColumn x:Name="dgtcGoodsCode" Header="机构全称" Width="120*" ElementStyle="{StaticResource tbStyle}" CanUserSort="False" SortMemberPath="goodsCode" Foreground="#FFFFFF"  FontWeight="Bold" Binding="{Binding InstFullName}"></DataGridTextColumn>
                            <DataGridTemplateColumn   Width="80"   >
                                <DataGridTemplateColumn.HeaderTemplate >
                                    <DataTemplate >
                                        <CheckBox  x:Name="cb_allRes" Content="默认请求" Style="{DynamicResource DefaultCheckBoxStyle}" VerticalContentAlignment="Center" Padding="4 0 0 0" Margin="6 0 0 0" Foreground="#A0A0A0" 
                                                   IsChecked="{Binding DataContext.IsAllRequestSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:InstSettingWin}}}" 
                                                   Click="cb_allRes_Click"></CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox  x:Name="cb_dres" Style="{DynamicResource DefaultCheckBoxStyle}" Background="Transparent" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Margin="5 0 0 0"  IsChecked="{Binding IsDefualtRequestSelect,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Click="cb_dres_Click"></CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn   Width="45" CanUserSort="False" SortMemberPath="PriceFormat" Header="交易员">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonUp="ManagerInstTrader">
                                            <TextBlock.TextDecorations>
                                                <TextDecoration PenOffset="0" PenOffsetUnit="Pixel" PenThicknessUnit="Pixel">
                                                    <TextDecoration.Pen>
                                                        <Pen Thickness="1" Brush="White" />
                                                    </TextDecoration.Pen>
                                                </TextDecoration>

                                            </TextBlock.TextDecorations>
                                                <Image Source="{StaticResource traderPen}"></Image>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

        </Grid>

        <commonUI:LoadingWaiting x:Name="LoadingUI" Grid.Row="1"  Grid.RowSpan="3" CanvasSize="130" EllipseCount="10" EllipseSize="20" StepAngle="36" TimeSpan="50"  Visibility="Collapsed" />
    </Grid>
</commonComp:WindowBase>

