<commonComp:WindowBase x:Class="STC.Broker.Plugin.View.Setting.InstSettingWin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:STC.Broker.Plugin.View.Setting"
        xmlns:commonUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:usercontrols="clr-namespace:STC.Broker.Plugin.View.Component"
        xmlns:dd="clr-namespace:STC.Broker.Plugin.Utils.wpf"
        xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
        Title="发单管理"
        Background="#0A0F0E" BorderThickness="2" 
        BorderBrush="#282828" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        WindowState="Normal"
        Height="420" Width="700">
    <Window.Resources>
        <ResourceDictionary>
            <DrawingImage x:Key="traderPen">
                <DrawingImage.Drawing>
                    <DrawingGroup ClipGeometry="M0,0 V1024 H1024 V0 H0 Z">
                        <GeometryDrawing Brush="White" Geometry="F1 M1024,1024z M0,0z M173.013333,882.56L245.12,678.826667 741.546667,132.266667 789.333333,129.92 865.706667,199.253333 868.053333,247.04 371.413333,793.813333z M282.453333,701.226667L246.613333,802.986667 345.813333,758.4 824.533333,231.466667 824.533333,218.88 773.76,173.44 761.386667,173.44z" />
                        <GeometryDrawing Brush="White" Geometry="F1 M1024,1024z M0,0z M678.229333,202.026667L804.565333,316.778667 775.872,348.352 649.536,233.621333z" />
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <Style x:Key="DelButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="#A0A0A0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#A0A0A0"/>
                <Setter Property="Template" >
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                <Image  Grid.Column="1" Width="14" Height="14" >
                                    <Image.Source>
                                        <DrawingImage >
                                            <DrawingImage.Drawing>
                                                <DrawingGroup ClipGeometry="M0,0 V14 H14 V0 H0 Z">
                                                    <DrawingGroup Opacity="1">
                                                        <DrawingGroup Opacity="1" Transform="1,0,0,1,-181,-148">
