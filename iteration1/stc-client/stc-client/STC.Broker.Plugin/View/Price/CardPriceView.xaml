            <!--Bid 完整模式-->
            <DataTemplate x:Key="FullBidQuotesModel">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding id}" ToolTipService.IsEnabled="False" Margin="-6 0 0 4">
                            <Grid Background="{StaticResource BidBlockGradientBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" ></RowDefinition>
                                    <RowDefinition Height="28"></RowDefinition>
                                    <RowDefinition Height="28"></RowDefinition>
                                    <RowDefinition Height="36"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"></ColumnDefinition>
                                    <ColumnDefinition Width="66"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <!--第一行-->
                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="4 4 0 0" >
                                    <TextBlock x:Name="txtqty" Margin="0,0,0,0" Text="{Binding qty}" MinWidth="48" HorizontalAlignment="Left"  TextTrimming="CharacterEllipsis" Foreground="#EAB854" FontSize="16" FontFamily="Microsoft YaHei" ></TextBlock>
                                    <Button x:Name="firmbtn"  BorderThickness="0" Height="18" Width="18" Margin="2 -2 4 0"  VerticalAlignment="Center" HorizontalAlignment="Left" Style="{DynamicResource SelfFirmButton}" Visibility="Collapsed">
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"  Margin="0 4 4 0">

                                    <Button x:Name="ocoflagshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource ocoButton}" Visibility="Collapsed" ToolTip="oco">
                                    </Button>

                                    <Button x:Name="packageflagshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource packageButton}" Visibility="Collapsed" ToolTip="打包">
                                    </Button>

                                    <Button x:Name="onestarButtonshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource onestarButton}" Visibility="Collapsed" ToolTip="需请示">
                                    </Button>

                                    <Button x:Name="twostarButtonshowbtn" BorderThickness="0" Margin="2 -2 0 0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource twostarButton}" Visibility="Collapsed" ToolTip="必须请示">
                                    </Button>

                                    <Button x:Name="switchbtn" BorderThickness="0" VerticalAlignment="Center" Margin="2 -2 0 0" HorizontalAlignment="Left" Style="{StaticResource exchangeButton}" Visibility="Collapsed" ToolTip="换券">
                                    </Button>
                                </StackPanel>
                                <!--第二行-->
                                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0"  Margin="4 4 0 0">
                                <TextBlock Margin="0,0,0,0" Text="{Binding institutionName}"  Width="64" HorizontalAlignment="Left" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" TextTrimming="CharacterEllipsis" Foreground="#A0A0A0" FontSize="12" FontFamily="Microsoft YaHei" ></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1"  Margin="0 4 4 0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="txtsettltype" Margin="0,0,0,0"  Width="65" Text="{Binding settlType, Converter={StaticResource BrokerSettleTypeConverter}}" ToolTip="{Binding settlType, Converter={StaticResource BrokerSettleTypeConverter}}"  TextTrimming="CharacterEllipsis"  Foreground="#D7D7D7" FontSize="12" FontFamily="Microsoft YaHei" Visibility="{Binding IsInfo9Visible,Converter={StaticResource visibilityConvertor}}" >
                                    </TextBlock>
                                    <TextBlock x:Name="txtsettltypeinfo9" Margin="0,0,0,0" Width="65" Text="{Binding Info9, Converter={StaticResource BrokerSettleTypeConverter}}" ToolTip="{Binding settlType, Converter={StaticResource BrokerSettleTypeConverter}}"  TextTrimming="CharacterEllipsis"  Foreground="#D7D7D7" FontSize="12" FontFamily="Microsoft YaHei" Visibility="{Binding IsInfo9Visible,Converter={StaticResource visibleConverter}}">
                                    </TextBlock>
                                 </StackPanel>

                                <!--第三行-->
                                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0"  Margin="4 4 0 0">
                                    <TextBlock Margin="0,0,0,0" Text="{Binding traderName}" Width="66" HorizontalAlignment="Left" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" TextTrimming="CharacterEllipsis" Foreground="#A0A0A0" FontSize="12" FontFamily="Microsoft YaHei" ></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="0 4 0 0">
                                    <TextBlock x:Name="txtwholeflag" Margin="0,0,0,0" Text="" HorizontalAlignment="Left"  TextTrimming="CharacterEllipsis"  Foreground="#D7D7D7" FontSize="12" FontFamily="Microsoft YaHei" ></TextBlock>
                                </StackPanel>

                                <!--第四行-->
                                <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0"  VerticalAlignment="Center" Margin="4 4 0 0">
                                <TextBlock x:Name="brokerName" Text="{Binding ShowBrokerName}" Height="22" Width="66" HorizontalAlignment="Left"  TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}" Foreground="#A0A0A0" FontSize="12" FontFamily="Microsoft YaHei" ></TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0 0 2 0">
                                    <TextBlock Text="{Binding description}" HorizontalAlignment="Left"  TextTrimming="CharacterEllipsis" Width="64"  ToolTip="{Binding description}" Foreground="#A0A0A0" FontSize="12" FontFamily="Microsoft YaHei" ></TextBlock>
                                </StackPanel>
                                <!--<Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Background="#181818"/>-->
                            </Grid>

                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <EventSetter Event="MouseLeftButtonDown" Handler="bdBid_MouseLeftButtonDown" />
                                </Style>
                            </StackPanel.Style>

                        </StackPanel>
                    </WrapPanel>
                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding FirmFlag}" Value="0"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="firmbtn" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding FirmFlag}" Value="1"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="firmbtn" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ocoFlag}" Value="1"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ocoflagshowbtn" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ocoFlag}" Value="2"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="packageflagshowbtn" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ExchangeSignFlag}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="switchbtn" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ExchangeSignFlag}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="switchbtn" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>

                        <DataTrigger Binding="{Binding bargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                            <Setter TargetName="onestarButtonshowbtn" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding bargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                            <Setter TargetName="twostarButtonshowbtn" Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding wholeFlag}" Value="1">
                            <Setter TargetName="txtwholeflag" Property="TextBlock.Text" Value="整量"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding qty}" Value="0">
                            <Setter TargetName="txtqty" Property="TextBlock.Text" Value=""/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HandlInst}" Value="1">
                            <Setter TargetName="txtqty" Property="TextBlock.Foreground" Value="#00FFB4"/>
                            <Setter TargetName="txtqty" Property="TextBlock.ToolTip" Value="暗盘"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMe}" Value="True">
                            <Setter TargetName="brokerName" Property="Foreground" Value="#00CDAD"/>
                        </DataTrigger>
                        
                        <DataTrigger Binding="{Binding settlType}" Value="2,3">
                            <Setter TargetName="txtsettltype" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="txtsettltypeinfo9" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </DataTemplate.Triggers>

            </DataTemplate>
            
