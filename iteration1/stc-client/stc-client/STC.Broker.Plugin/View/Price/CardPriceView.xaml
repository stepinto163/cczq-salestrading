                                                                            <TextBlock x:Name="txtQtyTxt" Text="{Binding DataContext.QtyTxt, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:CardPriceView}}}"  Margin="2 2 4 0" Foreground="#A0A0A0"  FontFamily="Roboto" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" FontWeight="Medium"/>
