<UserControl x:Class="STC.Broker.Plugin.View.Price.CardPriceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Price"
             xmlns:localcomp="clr-namespace:STC.Broker.Plugin.View.Component"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:SelectorT="clr-namespace:STC.Broker.Plugin.View.Price"
             mc:Ignorable="d" 
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:localconv ="clr-namespace:STC.Broker.Plugin.Convertor" UseLayoutRounding="True"
             d:DesignHeight="390" d:DesignWidth="284" MinWidth="284" MinHeight="390">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <fcon:MultiBindingConverter x:Key="MultiBindingConverter"/>
            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <fcon:VenuesColorConvertor x:Key="venuesColorConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <localconv:BrokerSettleTypeConverter x:Key="BrokerSettleTypeConverter"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <fcon:VisibleConverter x:Key="visibleConverter"/>

            <Style x:Key="CardPriceGridCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CardPriceGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="#0F0F0F"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#181818"/>
                    </Trigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </MultiTrigger>
                    <!--<MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </MultiTrigger>-->
                </Style.Triggers>
            </Style>


            <!-- FrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Viewbox Height="13">
                                        <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Label.Content>
                                                <Polygon Fill="#FFB60E" Points="6 -5.31777997e-15 0 7.42857143 4 7.42857143 2 13 8 5.57142857 3.99658203 5.57142857"/>
                                            </Label.Content>
                                        </Label>
                                    </Viewbox>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Bid 样式-->
            <LinearGradientBrush x:Key="BidBlockGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#402B16" Offset="0"/>
                <GradientStop Color="#272523" Offset="1"/>
            </LinearGradientBrush>

            <!-- Ofr 样式-->
            <LinearGradientBrush x:Key="OfrBlockGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#162630" Offset="0"/>
                <GradientStop Color="#232627" Offset="1"/>
            </LinearGradientBrush>

