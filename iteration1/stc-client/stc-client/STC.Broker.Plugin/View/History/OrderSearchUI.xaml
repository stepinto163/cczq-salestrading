    <Grid x:Name="gMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel x:Name="spConditions" Orientation="Horizontal" Margin="5,5,5,5" Grid.Row="0" Grid.Column="0">

                <TextBox x:Name="txtb" Width="0"></TextBox>
                <DatePicker x:Name="dpFrom" Height="25" Width="100" Margin="10,0,3,0" FontFamily="{StaticResource DefaultFont}" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" SelectedDateChanged="dpFrom_SelectedDateChanged"></DatePicker>
                <Line X1 ="5" Y1="12"  X2="15"  Y2="12" Stroke="Wheat" />
                <DatePicker x:Name="dpTo" Height="25" Width="100" Margin="10,0,0,0" FontFamily="{StaticResource DefaultFont}" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" SelectedDateChanged="dpTo_SelectedDateChanged"></DatePicker>
                <TextBlock x:Name="tbOrderStatus" VerticalAlignment="Center" Visibility="Collapsed">订单状态：</TextBlock>
                <ComboBox x:Name="cbOrderStatus" Width="60" Visibility="Collapsed"></ComboBox>
                <!--<CheckBox x:Name="cbMyDeals"  Content="我的交易" Foreground="#A0A0A0" Width="70"  Margin="10,0,0,0"
                              Style="{StaticResource ShowStarCheckBoxStyle}"  Click="cbMyDeals_Click" />-->
                <CheckBox x:Name="cbMyDeals" Margin="16,0,0,0" Content="我的交易" Style="{DynamicResource CheckBoxStyle_2}"
                              IsChecked="{Binding Path=IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{DynamicResource TextBox.Static.Border}"
                              Background="#0F0F0F" Foreground="#A0A0A0" HorizontalAlignment="Center"  VerticalAlignment="Center" 
                              Click="cbMyDeals_Click" />
                <TextBlock x:Name="tb_bond" Margin="16,0,0,0" Foreground="#A0A0A0" VerticalAlignment="Center">债券</TextBlock>
                <localcomp:ClearTextBox x:Name="ctbBond" BackGroundText="" Width="100" Height="24" Margin="8,0,0,0" 
                                           Foreground="#A0A0A0" Background="#0F0F0F"
                                           BorderBrush="#3C3C3C"
                                           KeyDown="ctbBond_KeyDown" PreviewKeyDown="ctbBond_PreviewKeyDown"
                                           TextChanged="ctbBond_TextChanged" LostKeyboardFocus="ctbBond_LostKeyboardFocus"/>
                <Popup x:Name="tbBCodePop" PlacementTarget="{Binding ElementName=ctbBond}" LostFocus="tbBCodePop_LostFocus"  StaysOpen="False" MaxHeight="300">
                    <DataGrid x:Name="dgCodeResult"
                                  Grid.Row="1"
                                  Background="#0F0F0F"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  Width="288"
                                  MouseDoubleClick="dgCodeResult_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden" Style="{StaticResource SelectData}">
                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Bond_ID}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForeground}"
                                                TextTrimming="CharacterEllipsis" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Short_Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForeground}"
                                                TextTrimming="CharacterEllipsis" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding RemaingingTime}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForeground}"
                                                TextTrimming="CharacterEllipsis" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Popup>
                <TextBlock x:Name="tb_inst" Margin="16,0,0,0" Foreground="#A0A0A0" VerticalAlignment="Center">机构</TextBlock>
                <localcomp:ClearTextBox x:Name="ctbBank" BackGroundText="" Width="110" Height="22" Margin="8,0,0,0" 
                                           Foreground="#A0A0A0" Background="#0F0F0F"
                                           KeyDown="ctbBank_KeyDown" PreviewKeyDown="ctbBank_PreviewKeyDown"
                                           TextChanged="ctbBank_TextChanged" LostKeyboardFocus="ctbBank_LostKeyboardFocus"/>
                <Popup x:Name="tbInstPop" PlacementTarget="{Binding ElementName=ctbBank}" MaxHeight="300" LostFocus="tbInstPop_LostFocus"  StaysOpen="False">
                    <DataGrid x:Name="dgInstResult"
                                  Grid.Row="1"
                                  Background="#0F0F0F"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  Width="206"
                                  MouseDoubleClick="dgInstResult_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Style="{StaticResource SelectData}">
                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding TipsShortnamelist}" Width="1*" >
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding instcode}" Width="1*" Visibility="Collapsed">
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Popup>
                <TextBlock x:Name="tb_trader" Margin="16,0,0,0" Foreground="#A0A0A0" VerticalAlignment="Center">机构(交易员)</TextBlock>
                <localcomp:ClearTextBox x:Name="ctbBankAgent" BackGroundText="" Width="130" Height="22" Margin="8,0,0,0" 
                                           Foreground="Red" Background="#0F0F0F"
                                           KeyDown="ctbBankAgent_KeyDown" PreviewKeyDown="ctbBankAgent_PreviewKeyDown"
                                           TextChanged="ctbBankAgent_TextChanged" LostKeyboardFocus="ctbBankAgent_LostKeyboardFocus"/>
                <Popup x:Name="tbTraderPop" PlacementTarget="{Binding ElementName=ctbBankAgent}" MaxHeight="300" LostFocus="tbTraderPop_LostFocus"  StaysOpen="False">
                    <DataGrid x:Name="dgTraderResult"
                                  Grid.Row="1"
                                  Background="#0F0F0F"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                                  Margin="0" 
                                  Width="206"
                                  MouseDoubleClick="dgTraderResult_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Style="{StaticResource SelectData}">
                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding InstTraderName}" Width="1*" >
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding instcode}" Width="1*" Visibility="Collapsed">
                                <DataGridTextColumn.ElementStyle >
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                                        <Setter Property="Padding" Value="10,0,0,0"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
