            </Image>

            <Image  x:Key="price_xx_Image"  x:Shared="False"   Margin="2,0,0,0" Width="16"  Height="16"  >
                <Image.Source>
                    <DrawingImage>
                        <DrawingImage.Drawing>
                            <DrawingGroup ClipGeometry="M0,0 V16 H16 V0 H0 Z">
