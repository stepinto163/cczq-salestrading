<UserControl x:Class="STC.Broker.Plugin.View.Component.TextBoxBlockNoLimite"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Component"
             mc:Ignorable="d" 
             d:DesignHeight="35" d:DesignWidth="120" Width="90" x:Name="winName">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Broker.Plugin;component/Resources/BrokerDict.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>-->

            <Style x:Key="TBBigStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"></Setter>
                <Setter Property="FontSize" Value="12px"></Setter>
                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
           
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Style="{DynamicResource UserControlBorderStyle}" x:Name="bd_bor"  Width="{Binding ElementName=winName,Path=Width}" CornerRadius="2" Grid.Row="0" Height="22" Grid.Column="0" Mouse.MouseDown="Border_MouseDown"  >
            <TextBlock x:Name="TB_Name"  Style="{StaticResource TBBigStyle}"  MinWidth="20" TextTrimming="CharacterEllipsis">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </Border>
        <TextBox x:Name="TBox_Name" Grid.Row="0" Grid.Column="0" Height="22" Width="{Binding ElementName=winName,Path=Width}"
                 FontFamily="{DynamicResource DefaultFont}"
                 Visibility="Collapsed"  
                 HorizontalAlignment="Left" 
                 Style="{DynamicResource STCDefaultBoxStyle}"
                 KeyDown="TBoxName_KeyDown" 
                 PreviewKeyDown="TBoxName_PreviewKeyDown"
                 LostKeyboardFocus="TBoxName_LostKeyboardFocus"
                 InputMethod.IsInputMethodEnabled="True"
                 ContextMenu="{x:Null}" Grid.RowSpan="2"/>
    </Grid>
</UserControl>
