<UserControl x:Class="STC.Broker.Plugin.View.Component.WaterMarkControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Component"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Control.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="5,15,5,15"/>
            <Setter Property="Foreground" Value="#57A195"/>
            <Setter Property="FontFamily" Value="MicrosoftYaHei"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.2"/>
            <Setter Property="TextBlock.RenderTransform">
                <Setter.Value>
                    <RotateTransform x:Name="rotateTransform" Angle="-35" />
                </Setter.Value>
            </Setter>
        </Style>
    </Control.Resources>
    <WrapPanel x:Name="MainPanel"  Opacity="1" Background="#01FFFFFF"  >
    </WrapPanel>
</UserControl>
