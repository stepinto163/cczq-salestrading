<Window x:Class="STC.Broker.Plugin.View.Component.BrokerMessageBoxGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:CommComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        x:Name="系统提示" mc:Ignorable="d" Loaded="sysWarnGUI_Loaded" Window.SizeToContent="Height" MinHeight="150"
        Title="系统提示" Height="150" Width="300"  Background="#141414"  ResizeMode="CanResize" WindowStartupLocation="CenterScreen" 
        WindowState="Normal" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" BorderBrush="#282828">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="AlertTemplate" TargetType="Button">
                <Border x:Name="AlertSign" Grid.Column="0" Grid.Row="1" Visibility="Visible" SnapsToDevicePixels="true" HorizontalAlignment="Left"  BorderThickness="0" Width="24" Height="21">
                    <Canvas>
                        <Path  x:Name="patharrow"  Data="M 12,2 L 2,21 L 22,21 L 12,2 Z" SnapsToDevicePixels="False"  Stroke="#DE8E0B" Fill="#DE8E0B" StrokeThickness="2"/>
                        <TextBlock Text="!" x:Name="arrow" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FFFFFF"  FontSize="16" Padding="9,3,0,0" FontWeight="Bold">
                        </TextBlock>
                    </Canvas>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="false">
                        <Setter Property="Foreground" Value="#3C3C3C"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <DockPanel x:Name="dpMain" LastChildFill="True" >
        <Grid x:Name="gTitle" DockPanel.Dock="Top"  Height="30"  Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="tbTitle" x:FieldModifier="public" Text="系统提示" Margin="10,0,0,0" Grid.Column="0" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="12px"></TextBlock>
            <Button x:Name="btnClose" Grid.Column="2"  Margin="0,0,0,0" Style="{DynamicResource DrpImageCloseButton}" Width="24" Height="24" Click="Button_Click" IsCancel="True"></Button>
        </Grid>
        <Grid x:Name="gDetail" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <!--ed:RegularPolygon Fill="#DE8E0B" Grid.Row="0" Grid.Column="1" InnerRadius="1" PointCount="3" Stretch="Fill" Stroke="#DE8E0B" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Center"/-->
            <!--TextBlock Text="!" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="16" Margin="0" Padding="0"></TextBlock-->
            <Button Template="{StaticResource AlertTemplate}" Grid.Row="0" Grid.Column="1"/>
            <StackPanel Margin="0 14 0 10" Width="220" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="tbMsg" x:FieldModifier="public" Padding="20, 0, 0, 0" Margin="0 0 4 0" Text="请确认价格"  TextWrapping="Wrap" FontSize="12px" Foreground="#FFFFFF"/>
                <TextBlock x:Name="tbPrice" Text="" Foreground="#FFFFFF"/>
                <TextBlock x:Name="tbSide" Text="" Foreground="#FFFFFF" Margin="4 0 0 0"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="2" Margin="0, 0, 0, 10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCloseB" Content="取消" Grid.Column="0" HorizontalAlignment="Center" Width="60" Height="22" Margin="0 0 5 0" BorderThickness="0 1 0 0"
                        Style="{DynamicResource GraySlateButtonStyle}" Click="Button_Click" IsDefault="False"/>
                <Button x:Name="btnOK" Content="确认" Grid.Column="1" HorizontalAlignment="Left" Width="100" Height="22"  BorderThickness="0 1 0 0"
                        Style="{DynamicResource BlueGreenOrangeGraySlateButtonStyle}" Click="btnOK_Click" IsDefault="true"/>

            </Grid>

        </Grid>

    </DockPanel>
</Window>
