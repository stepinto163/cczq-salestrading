<UserControl x:Class="STC.Broker.Plugin.View.Component.SettleFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Component"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="110">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin/STC.SkinStyle.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin/ListBoxStyleDictinary.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin/STC.SkinStyle.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin/ListBoxStyleDictinary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <ListBox x:Name="lbSettle" Margin="2, 0, 0, 0"  Background="Transparent" VerticalAlignment="Center" SelectionMode="Single" SelectionChanged="LbSettle_SelectionChanged">
            <ListBox.Template>
                <ControlTemplate>
                    <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                </ControlTemplate>
            </ListBox.Template>

            <ListBoxItem Content="多" Style="{DynamicResource SelfFilterListBoxItemStyle}"/>
            <ListBoxItem Content="+1" Style="{DynamicResource SelfFilterListBoxItemStyle}" Margin="3,0,0,0" IsSelected="True"/>
            <ListBoxItem Content="+0" Style="{DynamicResource SelfFilterListBoxItemStyle}" Margin="3,0,0,0"/>
            <ListBoxItem Content="远" x:Name="lbtFwd" Style="{DynamicResource FwdListBoxItemStyle}" Margin="3,0,0,0"/>
        </ListBox>
    </Grid>
</UserControl>
