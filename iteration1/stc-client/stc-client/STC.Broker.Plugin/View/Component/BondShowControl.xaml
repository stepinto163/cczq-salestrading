<UserControl x:Class="STC.Broker.Plugin.View.Component.BondShowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Component"
              xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>-->

                <!--提交前需要注释掉，修改时可打开-->
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TBBigStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"></Setter>
                <Setter Property="FontSize" Value="16px"></Setter>
                <Setter Property="Foreground" Value="#F9C152"></Setter>
                <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.Column="0" BorderThickness="1" BorderBrush="#3C3C3C" Height="24" Margin="10,0,0,0" MouseEnter="tbOrderId_MouseEnter" MouseLeave="tbOrderId_MouseLeave">
            <TextBlock x:Name="tbOrderId" Text="{Binding DataContext.BondCodeShow, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BondShowControl}}}" Visibility="{Binding  DataContext.BondShowVisible, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BondShowControl}}}"  MaxWidth="360" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" Margin="10,0,0,0" HorizontalAlignment="Stretch" MouseDown="tbOrderId_MouseDown" Style="{StaticResource TBBigStyle}">
                <TextBlock.ToolTip>
                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </Border>
        <commComp:SearchTextBox x:Name="st_bondEdit" Visibility="{Binding DataContext.BondEditVisible, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BondShowControl}}}" SearchText="{Binding DataContext.SecurityID, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:BondShowControl}}}"  MinWidth="88" Height="24" Background="Transparent" Foreground="#EAB854" FontSize="14" ></commComp:SearchTextBox>
    </Grid>
</UserControl>
