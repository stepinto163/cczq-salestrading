<UserControl x:Class="STC.Broker.Plugin.View.Component.CustomBrokerSearchTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Component"
             mc:Ignorable="d" 
             d:DesignHeight="18" d:DesignWidth="120" x:Name="CommonSearchTextBox"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <!-- 搜索文本框 -->
            <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#181818"/>
                <Setter Property="BorderBrush" Value="#3C3C3C"/>
                <Setter Property="Width" Value="236"/>
                <Setter Property="FontFamily" Value="MicroSoft YaHei"/>
                <Setter Property="Foreground" Value="{DynamicResource LogDefaultFontBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="0 0 0 0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" TargetName="border" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFEBC8"/>
                                    <Setter TargetName="border" Property="Background" Value="#300F0F0F"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#300F0F0F"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9B00"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="false"/>
                                        <Condition Property="Text" Value=""/>
                                    </MultiTrigger.Conditions>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{StaticResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <Grid x:Name="SearchGrid" Visibility="Visible">
            <TextBox x:Name="SearchTermTextBox" Style="{StaticResource SearchTextBoxStyle}"
                 VerticalContentAlignment="Center" 
                 MaxLength="20" MinWidth="120"
                 TextChanged="SearchTermTextBox_TextChanged"
                 PreviewKeyDown="tbSearch_PreviewKeyDown"
                 KeyDown="tbSearch_KeyDown"
                 GotFocus="tbSearch_GotFocus"
                 LostFocus="tbSearch_LostFocus" 
                 PreviewMouseLeftButtonDown="SearchTermTextBox_PreviewMouseLeftButtonDown"
                 input:TextCompositionManager.PreviewTextInput="tbTraderAInfoChange_PreviewTextInput"
                 input:TextCompositionManager.PreviewTextInputUpdate="tbTraderAInfoChange_PreviewTextInputUpdate"/>
            
            <Popup x:Name="popBondCode" PlacementTarget="{Binding ElementName=SearchTermTextBox}" StaysOpen="False" MaxHeight="300"
                   PopupAnimation="Slide" AllowsTransparency="False">
                <Border BorderBrush="#282828" BorderThickness="1" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="搜索债券" FontSize="12" Background="{DynamicResource DefaultBackgroup.ColorBrush}" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"/>
                        <!--{DynamicResource DefaultBackgroup.ColorBrush}-->
                        <DataGrid x:Name="dgBondCode" Grid.Row="1"
                        ItemsSource="{Binding}" 
                        HeadersVisibility="None"
                        BorderThickness="0"       
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.CanContentScroll="True"
                        Margin="0" 
                        Width="360"
                        MouseUp="dgBondCode_MouseUp"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  >

                            <DataGrid.Resources>
                                <Style x:Key="tbStyle" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Style>
                                <DynamicResource ResourceKey="DefaultDataGrid"/>
                            </DataGrid.Style>
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent">
                                                <TextBlock Grid.Column="0" Height="22" Text="{Binding Bond_ID}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="#FFFFFF"
                                                TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent">
                                                <TextBlock Grid.Column="0" Height="22" Text="{Binding Short_Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent">
                                                <TextBlock Grid.Column="0" Height="22" Text="{Binding RemaingingTime}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" 
                                                Foreground="{DynamicResource DefaultForegroup.ColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>

                </Border>

            </Popup>

        </Grid>
       
    </Grid>
</UserControl>
