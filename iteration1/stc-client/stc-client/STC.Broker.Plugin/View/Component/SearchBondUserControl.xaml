<UserControl x:Class="STC.Broker.Plugin.View.Component.SearchBondUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.Broker.Plugin.View.Component"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <ControlTemplate x:Key="CloseButtonTemplate"
                             TargetType="Button">
                <Border CornerRadius="2">

                    <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                      Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/STC.Frame;component/Images/005.png"></ImageBrush>
                    </Border.Background>
                </Border>
            </ControlTemplate>

            <ControlTemplate x:Key="navSearchTextBox"
                             TargetType="TextBox">
                <Border Name="Border"
                        Background="#FF7D00"
                        BorderBrush="#FF9200"
                        CornerRadius="2"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      Grid.Column="0"
                                      BorderThickness="0"
                                      VerticalAlignment="Stretch"
                                      x:Name="PART_ContentHost" />
                        <Button Name="btnDelete"
                                Grid.Column="1"
                                Margin="5,0"
                                Width="10"
                                Height="10"
                                Template="{StaticResource CloseButtonTemplate}"
                                Click="Button_Click">
                        </Button>

                    </Grid>
                </Border>
            </ControlTemplate>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <TextBox x:Name="tbSearch"
                 TextChanged="tbSearch_TextChanged"
                 Template="{StaticResource navSearchTextBox}"
                 FontFamily="{StaticResource DefaultFont}" 
                 Height="25"
                 Text=""
            ScrollViewer.PanningMode="VerticalFirst"
            Stylus.IsFlicksEnabled="False"
            Padding="5, 5, 0, 0"
                 VerticalAlignment="Center"
                 PreviewKeyDown="tbSearch_PreviewKeyDown"
                 KeyDown="tbSearch_KeyDown"
                 GotFocus="tbSearch_GotFocus"
                 LostFocus="tbSearch_LostFocus"
                 input:TextCompositionManager.PreviewTextInput="tbTraderAInfoChange_PreviewTextInput"
                 input:TextCompositionManager.PreviewTextInputUpdate="tbTraderAInfoChange_PreviewTextInputUpdate"/>

        <Popup x:Name="popBondCode" PlacementTarget="{Binding ElementName=tbSearch}" StaysOpen="False" MaxHeight="300"
                   PopupAnimation="Slide" AllowsTransparency="False">
            <Border BorderBrush="#282828" BorderThickness="1" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>


                    <TextBlock Text="搜索债券" FontFamily="{StaticResource IDCFontFamily.YaHei}" FontSize="12" Foreground="{StaticResource ColorBrush.Yellow}"></TextBlock>
                    <DataGrid x:Name="dgBondCode" Grid.Row="1"
                                  Background="#0F0F0F"
                                  ItemsSource="{Binding}" 
                                  HeadersVisibility="None"
                                  BorderThickness="0"       
                          VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                                  Margin="0" 
                                  Width="360"
                                  MouseUp="dgBondCode_MouseDoubleClick"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  Style="{StaticResource DataGridDefaultStyle}"
                          >
                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Bond_ID}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForeground}"
                                                TextTrimming="CharacterEllipsis" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Short_Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForeground}"
                                                TextTrimming="CharacterEllipsis" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding RemaingingTime}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" 
                                                   Foreground="{StaticResource DefaultForeground}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
