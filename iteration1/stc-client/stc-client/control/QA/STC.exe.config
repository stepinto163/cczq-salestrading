<?xml version="1.0" encoding="utf-8"?>
<configuration>

 <configSections>
    <section name="ServerGroupCfg" type="STC.Common.Model.Cfg.ServerCfgSection, STC.Common" />
    <section name="ServerStatusGroupCfg" type="STC.Common.Model.Cfg.ServerStatusCfgSection, STC.Common" />
    <section name="IsDcsBrokerGroupCfg" type="STC.Common.Model.Cfg.IsDcsBrokerCfgSection, STC.Common" />
    </configSections>

    <ServerGroupCfg>
      <ServerGroup>
        <Server Id="1" Name="测试环境" Host="127.0.0.1" Port="2004" Protocol="TCP" DpsHost="10.100.5.39" DpsPort="2000" DpsProtocol="TCP" UpdateHost="10.100.5.39" UpdatePort="80" UpdateProtocol="http"/>
       </ServerGroup>
    </ServerGroupCfg>
	
	<ServerStatusGroupCfg>
    <ServerStatusGroup>
      <ServerStatus Id="1" VenueTypeGW="ODM" Name="X-Bond交易" TargetSessionId="TRADE"/>
	  <ServerStatus Id="3" VenueTypeGW="QDMESP" Name="双边交易" TargetSessionId="TRADE"/>
	  <!--
      <ServerStatus Id="2" VenueTypeGW="SOR" Name="经纪商交易(直连)" TargetSessionId="TRADE"/>
      -->
      <ServerStatus Id="4" VenueTypeGW="ODM" Name="X-Bond行情" TargetSessionId="PRICE"/>
      <ServerStatus Id="7" VenueTypeGW="QDMESP" Name="双边行情" TargetSessionId="PRICE"/>
      <ServerStatus Id="5" VenueTypeGW="CDH" Name="经纪商行情" TargetSessionId="PRICE"/>
      <!--
      <ServerStatus Id="6" VenueTypeGW="SOR" Name="经纪商行情(直连)" TargetSessionId="PRICE"/>
      -->
    </ServerStatusGroup>
  </ServerStatusGroupCfg>

  <IsDcsBrokerGroupCfg>
    <IsDcsBrokerGroup>
      <IsDcsBroker Id="1" Broker="TPSC" Name="国利" Status="1"/>
      <IsDcsBroker Id="2" Broker="CNEX" Name="国际" Status="0"/>
      <IsDcsBroker Id="3" Broker="CCTB" Name="中诚" Status="0"/>
      <IsDcsBroker Id="4" Broker="PTCN" Name="平安" Status="1"/>
      <IsDcsBroker Id="5" Broker="CTTJ" Name="信唐" Status="0"/>
    </IsDcsBrokerGroup>
  </IsDcsBrokerGroupCfg>
  
  <appSettings>
    <add key="AppExe" value="STC-QA"/>
    <add key="AppName" value="STC"/>
	<add key="Version" value="2.14.0" />
	<add key="LoginEnv" value="QA"/>
    <add key="LogPath" value="./logs/STC_" />
    <add key="LogLevel" value="info" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="CanGoodsQuickSearch" value="true" />
	<add key="MaxWarningCount" value="5"/>
	<add key="LoginTitle" value="登录-DEV"/>
	<!--计算器调用方式,1:bond,2:cfets-->
    <add key="CalType" value="1"/>
	<!--是否单机-->
    <add key="IsSingle" value="true"/>
	<!--是否启用拖拽窗口-->
    <add key="UserDrag" value="false"/>
	<!--1：test, 2:prd-->
    <add key="EnvironmentFlag" value="1" />
	
	<add key="ApiKey" value="1" />
    <add key="StartDps" value="1" />
    <add key="IsGzip" value="0" />
	<!--1:cross, 2:stp-->
    <add key="TradeType" value="2" />
	<!--是否在设置中显示特殊审批黑名单 1显示 0隐藏，没有该key则隐藏-->
    <add key="ShowBlackListSetting" value="0" />
	<!--双边做市定时EXCEL导出(格式:HH:mm,以英文逗号分割)-->
    <add key="MMExcelExportDataTime" value="16:58,20:31,08:29"/>
    <!--双边做市定时EXCEL导出(点差单位bp)-->
    <add key="MMExcelSpread" value="10"/>
	<!--过滤指定topic前缀的日志打印-->
    <add key="FilterLog" value="stc.ems.c,stc.table,stc.mm.mm,stc.md,stc.ems.c.cdh,stc.ems.e.sdn,stc.base.search,stc.sc.sysMessage" />
    <!--多个策略批量开启的时候，最小时间间隔(毫秒)-->
    <add key="BatchOpenIntervalTime" value="500" />	
	<!--隐藏【拉宽所有报价】按键;策略类型下拉选项去掉【接口】;算法报价中参考中间价下拉选项仅保留【中债估值】; 接口报价、成交报价设置隐藏; 0-不显示 1-显示  默认显示-->
    <add key="openMMDHideSet" value="0" />
    <!--是否本地加载Crm交易员-->
    <add key="IsLocalCacheCrm" value="1"/>
	<!--是否显示条件撤销,1:显示-->
	<add key="IsShowPriceCondition" value="1"/>
    <!--是否显示录入行情按钮 1显示 0不显示-->
    <add key="IsShowEnterMarket" value="0" />
    <!--是否显示定向询价,1:显示-->
    <add key="IsShowDRP" value="1" />
    <!--是否显示内部看板报废区,1:显示-->
    <add key="IsShowInnerHistoryRequire" value="1" />
    <!--是否支持图像识别-->
    <add key="IsParserImage" value="0"/>
	<!--没有首页权限时，默认打开页面 格式:{PluginKey}-{Description}-->
    <add key="DefaultPlugin" value="10-行情看板,11-成交处理,12-历史记录,112-需求工作台"/>
    <!--没有首页权限时，默认选择页面 格式:{Description}-->
    <add key="DefaultFocusPlugin" value="行情看板"/>
	<!--手动发送按钮-->
	<add key="SendManuallyButtonIsShow" value="true"/>
    <!--推市场成交 -->
	<add key="ReserveButtonIsShow" value="true"/>
	<!--首次修改结算是否联动配置 -->
	<add key="FirstUpdateSettlementSync" value="true"/>	
	<!--客户端单次克隆订单数-->
    <add key="CloneOrderCount" value="30"/>
	<!--是否显示删除按钮-->
    <add key="ShowInstDeleteBtn" value="true"/>
    <!--是否支持FQ-->
    <add key="IsFQ" value="1"/>
    <!--是否支持内部看板最优显示样式-->
    <add key="IsInnerQtyDetail" value="1"/>
    <!--内部看板下单界面报量支持散量配置 只支持1-4位小数-->
    <add key="QtyDecimalDigit" value="3"/>
    <!--是否显示风险敞口 -->
	<add key="IsShowRiskExposure" value="true"/>
    <!--是否支持QQ-->
    <add key="IsQQ" value="1"/>
    <!--是否写log -->
    <add key="IsWriteDBLog" value="true"/>
    <!-- 买方机构：是否使用投资经理和交易员的关联关系， 默认： false -->
    <add key="IsI2T" value="true"/>
    <!-- 是否是买方机构增强版， 默认： false -->
    <add key="IsPAYL" value="false"/>
    <!--是否开启询价-->
    <add key="IsInquiry" value="true"/>
    <!--是否使用风控检查-->
    <add key="IsRiskCheck" value="false"/>
    <!--是否隐藏报价撤单条件中的【订阅】标签 1隐藏 其他或不配置显示，默认显示 -->
    <add key="HideIfSubBond_TBook" value="1" />
  </appSettings>
  <runtime>
    <gcConcurrent enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <publisherPolicy apply="yes" />
      <probing privatePath="bin;plugin" />
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.12.0" newVersion="2.0.12.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>