<UserControl x:Class="STC.Chart.Plugin.OxyChart.TenorDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Chart.Plugin.OxyChart"
             mc:Ignorable="d" Background="#141414"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 关闭按钮样式-->
        <Style TargetType="{x:Type Button}" x:Key="ImageCloseButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                                <Border.Background>
                                    <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_loginpage_close_normal.png"/>
                                </Border.Background>
                            </Border>
                            <Grid>
                                <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_loginpage_close_hover.png"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Control.Background" TargetName="background">
                                    <Setter.Value>
                                        <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_loginpage_close_press.png"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border CornerRadius="2"  BorderThickness="0, 0, 0, 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="0" x:Name="TitleBar" Height="30">
                <Grid>
                    <Border x:Name="bdSecurity"  BorderThickness="0">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="24"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                             <StackPanel  Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" >
                                <Button Width="14" Height="14" x:Name="btnShutDown" Margin="2, 0, 0, 2" Click="btnShutDown_Click" IsCancel="True" Style="{StaticResource ImageCloseButton}" ToolTip="关闭" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Grid Margin="5" Grid.Row="1">
                <local:TenorChartControl x:Name="tenorChart"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
