<UserControl x:Class="STC.Chart.Plugin.OxyChart.ChartDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Chart.Plugin.OxyChart"
             mc:Ignorable="d"  Background="#141414"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="#193D37"
            BorderThickness="1">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="0">
                <CheckBox Content="Series 1"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="White"
                          Checked="CheckBox_Checked"
                          Unchecked="CheckBox_Checked"
                          IsChecked="True" />
                <CheckBox Content="Series 2"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="White"
                          Checked="CheckBox_Checked"
                          Unchecked="CheckBox_Checked"
                          IsChecked="True" />
                <CheckBox Content="Series 3"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="White"
                          Checked="CheckBox_Checked"
                          Unchecked="CheckBox_Checked"
                          IsChecked="True" />
                <CheckBox Content="Series 4"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="White"
                          Checked="CheckBox_Checked"
                          Unchecked="CheckBox_Checked"
                          IsChecked="True" />
                <TextBox Width="40" Name="count"/>
                <Button Width="60" Content="模拟数据" Margin="5,0" Click="Button_Click"/>
            </StackPanel>

            <local:ChartControl x:Name="chartControl"
                                Grid.Row="1" />
        </Grid>
    </Border>
</UserControl>
