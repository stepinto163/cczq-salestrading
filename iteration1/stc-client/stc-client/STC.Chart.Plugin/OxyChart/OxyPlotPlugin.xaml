<UserControl x:Class="STC.Chart.Plugin.OxyChart.OxyPlotPlugin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Chart.Plugin.OxyChart"
             xmlns:cpn="clr-namespace:STC.Chart.Plugin.Common.Component"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderThickness="1"
            BorderBrush="#193D37">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <oxy:PlotView x:Name="plotView"
                          Model="{Binding PlotModel}"
                          Grid.Row="0"
                          IsMouseWheelEnabled="True"
                          Background="Transparent"
                          Foreground="White">
                <oxy:PlotView.DefaultTrackerTemplate>
                    <ControlTemplate>
                        <oxy:TrackerControl Position="{Binding Position}"
                                            LineStroke="#193D37"
                                            LineExtents="{Binding PlotModel.PlotArea}"
                                            Foreground="#FFEBC8"
                                            BorderBrush="#193D37"
                                            Background="#172422"
                                            BorderThickness="1"
                                            CornerRadius="2">
                            <oxy:TrackerControl.Content>
                                <TextBlock Text="{Binding}"
                                           Margin="7" />
                                <!--<UniformGrid Columns="2"
                                             Canvas.Left="{Binding Position.X}"
                                             Canvas.Top="{Binding Position.Y}"
                                             Margin="6">
                                    <TextBlock Text="{Binding Series.Title}" />
                                    <TextBlock Text="" />
                                    <TextBlock Text="X:"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding DataPoint.X, StringFormat='{}{0:0.00}'}" />
                                    <TextBlock Text="Y:"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding DataPoint.Y, StringFormat='{}{0:0.00}'}" />
                                </UniformGrid>-->
                            </oxy:TrackerControl.Content>
                        </oxy:TrackerControl>
                    </ControlTemplate>
                </oxy:PlotView.DefaultTrackerTemplate>
            </oxy:PlotView>
            <cpn:RangeSlider x:Name="rangeSlider"
                             Grid.Row="1"
                             ValueChanged="RangeSlider_ValueChanged" 
                             Margin="3,0,3,2"/>
        </Grid>
    </Border>
</UserControl>
