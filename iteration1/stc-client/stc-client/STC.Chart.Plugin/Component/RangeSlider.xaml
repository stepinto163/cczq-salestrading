<UserControl x:Class="STC.Chart.Plugin.Common.Component.RangeSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="root">

    <UserControl.Resources>
        <ControlTemplate x:Key="simpleSlider" TargetType="{x:Type Slider}">
            <Border SnapsToDevicePixels="true" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Rectangle x:Name="PART_SelectionRange"/>

                    <Track x:Name="PART_Track" Grid.Row="1">
                        <Track.Thumb>
                            <Thumb x:Name="Thumb">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#136C5E"
                                                CornerRadius="2"
                                                Width="22"
                                                Height="22"
                                                SnapsToDevicePixels="True"
                                                Margin="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Background="#FFEBC8"
                                                        Width="2"
                                                        Height="12"
                                                        VerticalAlignment="Center"
                                                        Grid.Column="0"
                                                        Margin="7,0,0,0" />
                                                <Border Background="#FFEBC8"
                                                        Width="2"
                                                        Height="12"
                                                        VerticalAlignment="Center"
                                                        Grid.Column="2"
                                                        Margin="0,0,7,0" />
                                            </Grid>
                                        </Border>
                                        <!--<Rectangle Fill="#136C5E" 
                                                   Stroke="Black"
                                                   StrokeThickness="1"
                                                   Width="22"
                                                   Height="22"
                                                   SnapsToDevicePixels="True"/>-->
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </Border>
        </ControlTemplate>

    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Border BorderThickness="1"
                BorderBrush="#193D37"
                Background="#172422"
                VerticalAlignment="Center"
                Height="22"
                Margin="5,0,5,0"
                CornerRadius="2"/>

        <Slider x:Name="LowerSlider"
                Minimum="{Binding ElementName=root, Path=LMinimum}"
                Maximum="{Binding ElementName=root, Path=LMaximum}"
                Value="{Binding ElementName=root, Path=LowerValue, Mode=TwoWay}"
                Template="{StaticResource simpleSlider}"
                Margin="0,0,24,0"
                />
        
        <Slider x:Name="UpperSlider"
                Minimum="{Binding ElementName=root, Path=UMinimum}"
                Maximum="{Binding ElementName=root, Path=UMaximum}"
                Value="{Binding ElementName=root, Path=UpperValue, Mode=TwoWay}"
                Template="{StaticResource simpleSlider}"
                Margin="24,0,0,0"
                />
    </Grid>
</UserControl>
