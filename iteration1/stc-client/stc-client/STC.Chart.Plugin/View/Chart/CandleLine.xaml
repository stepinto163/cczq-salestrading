<UserControl x:Class="STC.Chart.Plugin.View.Chart.CandleLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Chart.Plugin.View.Chart"
             xmlns:cv="clr-namespace:STC.Chart.Plugin.Converts"
             xmlns:cpn="clr-namespace:STC.Chart.Plugin.Common.Component"
             xmlns:oxyplot="http://oxyplot.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="365" d:DesignWidth="527" Background="{DynamicResource MainFrame.Background}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Chart.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cv:CandleLineTrackerConverter x:Key="candleLlineTrackerConverter"/>
            <!--金色-->
            <SolidColorBrush x:Key="ColorBrush01" Color="#F9C152"></SolidColorBrush>
            <!--浅黄色 15min-->
            <SolidColorBrush x:Key="ColorBrush02" Color="#FFEBC8"></SolidColorBrush>
            <!--浅黄色 坐标轴字-->
            <SolidColorBrush x:Key="ColorBrush03" Color="#8F9598"></SolidColorBrush>
            <!--bar 红-->
            <SolidColorBrush x:Key="ColorBrush04" Color="#99DF201F"></SolidColorBrush>
            <!--bar 绿-->
            <SolidColorBrush x:Key="ColorBrush05" Color="#9921DF1F"></SolidColorBrush>
            <!--边框颜色-->
            <SolidColorBrush x:Key="BorderBrush" Color="#193D37"></SolidColorBrush>
            <!--网格内容色颜色-->
            <SolidColorBrush x:Key="BorderContendBrush" Color="#172422"></SolidColorBrush>
            <!--整体背景色颜色-->
            <SolidColorBrush x:Key="MainFrame.Background" Color="#141414"/>
            <!-- 关闭按钮样式-->
            <Style TargetType="{x:Type Button}" x:Key="ImageCloseButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="background" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Opacity="{TemplateBinding Opacity}"
                           BorderBrush="{TemplateBinding BorderBrush}"      
                            CornerRadius="2">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_loginpage_close_normal.png"/>
                                    </Border.Background>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_loginpage_close_hover.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Control.Background" TargetName="background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="/STC.Common;component/Images/stc_button_loginpage_close_press.png"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
        
    </UserControl.Resources>
    
    
    <Grid Background="{DynamicResource MainFrame.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Margin="0" x:Name="TitleBar" Height="30">
            <Grid>
                <Border x:Name="bdSecurity"  BorderThickness="0">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="24"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <StackPanel  Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" >
                            <Button Width="14" Height="14" x:Name="btnShutDown" Margin="2, 0, 0, 2" Click="btnShutDown_Click" IsCancel="True" Style="{StaticResource ImageCloseButton}" ToolTip="关闭" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <oxyplot:PlotView x:Name="Plot" Grid.Row="1" Grid.Column="1" Background="Black" Model="{Binding model}" Tag="{Binding CurrentTag}" Margin="0,0,10,0">
            <oxyplot:PlotView.DefaultTrackerTemplate>
                <ControlTemplate>
                    <oxyplot:TrackerControl Position="{Binding Position}"  Distance="10"  LineDashArray="2"  CanCenterVertically="False" CanCenterHorizontally="False"  LineStroke="#FFEBC8"  HorizontalLineVisibility="Visible" VerticalLineVisibility="Visible"  BorderBrush="#308376" Foreground="#FFEBC8"  ShowPointer="True" BorderThickness="2"  CornerRadius="3" LineExtents="{Binding PlotModel.PlotArea}">
                        <oxyplot:TrackerControl.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Color="#193D37" />
                                <GradientStop Offset="1" Color="#193D37"/>
                            </LinearGradientBrush>
                        </oxyplot:TrackerControl.Background>

                        <oxyplot:TrackerControl.Content>
                            <StackPanel>
                                <TextBlock Padding="4">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource candleLlineTrackerConverter}">
                                            <Binding Path="Position"/>
                                            <Binding Path="PlotModel"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <!--<TextBlock  Text="{Binding Position,Converter={StaticResource trackerconvert}}"/>-->
                            </StackPanel>
                        </oxyplot:TrackerControl.Content>
                    </oxyplot:TrackerControl>
                </ControlTemplate>
            </oxyplot:PlotView.DefaultTrackerTemplate>
            <oxyplot:PlotView.TrackerDefinitions>
                <oxyplot:TrackerDefinition TrackerKey="InvisibleTracker">
                    <oxyplot:TrackerDefinition.TrackerTemplate>
                        <ControlTemplate>
                            <TextBlock Text="{Binding}" Visibility="Collapsed"/>
                        </ControlTemplate>
                    </oxyplot:TrackerDefinition.TrackerTemplate>
                </oxyplot:TrackerDefinition>
            </oxyplot:PlotView.TrackerDefinitions>

            <oxyplot:PlotView.ContextMenu>
                <ContextMenu Style="{StaticResource DefaultContextMenu}">
                    <MenuItem Header="Reset" Command="{Binding ResetCommand}"  Style="{StaticResource DefaultMenuItem}"></MenuItem>
                </ContextMenu>
            </oxyplot:PlotView.ContextMenu>
        </oxyplot:PlotView>
        <oxyplot:PlotView x:Name="Plot2" Grid.Row="2" Grid.Column="1"  Background="Black" Model="{Binding model2}" Margin="0,0,10,0">
            <oxyplot:PlotView.DefaultTrackerTemplate>
                <ControlTemplate>
                    <oxyplot:TrackerControl Position="{Binding Position}" Distance="10"   LineDashArray="2"  CanCenterVertically="False" CanCenterHorizontally="False"  LineStroke="#FFEBC8"  HorizontalLineVisibility="Visible" VerticalLineVisibility="Visible"  BorderBrush="#308376" Foreground="#FFEBC8"  ShowPointer="True" BorderThickness="2"  CornerRadius="3" LineExtents="{Binding PlotModel.PlotArea}">
                        <oxyplot:TrackerControl.Background>
                            <LinearGradientBrush EndPoint="0,1">
                                <GradientStop Color="#193D37" />
                                <GradientStop Offset="1" Color="#193D37"/>
                            </LinearGradientBrush>
                        </oxyplot:TrackerControl.Background>
                    </oxyplot:TrackerControl>
                </ControlTemplate>
            </oxyplot:PlotView.DefaultTrackerTemplate>
        </oxyplot:PlotView>
        <cpn:RangeSlider x:Name="rangeSlider" Background="Black"
                         Grid.Row="3"
                         ValueChanged="RangeSlider_ValueChanged"
                         Margin="28,0,10,2" />

    </Grid>
</UserControl>
