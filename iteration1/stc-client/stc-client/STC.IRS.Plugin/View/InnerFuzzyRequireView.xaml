<Window x:Class="STC.IRS.Plugin.View.InnerFuzzyRequireView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.IRS.Plugin.View"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:innercomp="clr-namespace:STC.Common.View.Order.InnerView;assembly=STC.Common"            
             xmlns:localComp="clr-namespace:STC.IRS.Plugin.View.Component"
             mc:Ignorable="d" 
             Title="模糊需求" WindowStartupLocation="CenterScreen" WindowStyle="None"
             MinWidth="1000"  d:DesignWidth="1220" Width="1280" MinHeight="400" Height="300"
             BorderThickness="1" BorderBrush="#A0A0A0" Background="#000000"  KeyDown="Window_KeyDown">

<Window.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
            <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
            <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
            <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
            <ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>
            <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
        </ResourceDictionary.MergedDictionaries>
            <!-- STC 配置 -->
            <SolidColorBrush x:Key="MainBackgroup.ColorBrush" Color="#282828"/>
        </ResourceDictionary>
</Window.Resources>

<WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
</WindowChrome.WindowChrome>

    <Border CornerRadius="1" BorderThickness="0" BorderBrush="#A0A0A0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition Height="60"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="120"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
            </Grid.RowDefinitions>

            <!--标题区-->
            <Border Grid.Row="0" Margin="0" x:Name="TitleBar" Background="{DynamicResource MainBackgroup.ColorBrush}">
                <Grid>
                    <Border x:Name="bdSecurity"  BorderThickness="0">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="30"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBlock Margin="12, 0, 0, 0" Grid.Column="0" HorizontalAlignment="Left" Background="Transparent" VerticalAlignment="Center" Width="Auto" Text="模糊识别" Foreground="#D7D7D7" FontSize="14" FontWeight="Bold" ></TextBlock>

                            <StackPanel Grid.Column="2" Height="24" Margin="0,4,0,0" x:Name="TitlePanel"  HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" >
                                <Button Width="14" Height="14" x:Name="btnShutDown" Margin="8, 0, 0, 2" Command="{Binding CloseCommand}" IsCancel="True" Style="{StaticResource ImageCloseButton}" ToolTip="关闭" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--识别区-->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Row="1" Style="{StaticResource DefaultGridViewScrollViewerStyle}">
                <comp:WatermarkTextBox x:Name="contentTxt"  WaterMark="请粘贴报价信息" VerticalContentAlignment="Top"
                             BorderThickness="1" Background="#0B0C0C" Foreground="#FFFFFF" Margin="12,4,12,0" BorderBrush="{StaticResource MainBackgroup.ColorBrush}"
                             AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding BondTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="52"></comp:WatermarkTextBox>
            </ScrollViewer>

            <!--功能区-->
            <Border BorderThickness="0,0,0,1" Grid.Row="2" Margin="10,4,10,0" BorderBrush="{StaticResource MainBackgroup.ColorBrush}" Visibility="{Binding IsShowSaler}">
                <StackPanel Orientation="Horizontal" >
                    <Grid x:Name="tagGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <!--客户-->
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBox Text="客户:" FontWeight="Bold" BorderBrush="{StaticResource ColorBrush.Gray-23}" Foreground="{StaticResource ColorBrush.White-1}" Margin="4,0,0,0" BorderThickness="0"
                      HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" Background="Transparent"></TextBox>

                            <!--客户机构名-->
                            <comp:AutoCompleteComboBox x:Name="InsNameCb_edit" Height="24" Width="160" Margin="4,0,0,0"
                                                           DisplayValuePath="shortnamecn"
                                                           SelectedItem="{Binding SelectedInstintuion_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                           Text="{Binding InstitutionName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                           BackGroundCob="{StaticResource ColorBrush.Black8}" 
                                                           MouseOverBorderBrushCob="{StaticResource TextBox.MouseOver.Border}" 
                                                           FocusBorderBrushCob="{StaticResource TextBox.Focus.Border}"
                                                           Watermark="客户机构名" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                                           VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedInstitutionCB_PatternChanged">
                                <comp:AutoCompleteComboBox.AutoCompColumns>
                                    <DataGridTemplateColumn  Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent">
                                                    <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                    TextTrimming="CharacterEllipsis" >
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Content="{Binding Text}"/>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </comp:AutoCompleteComboBox.AutoCompColumns>
                            </comp:AutoCompleteComboBox>

                            <!--客户名-->
                            <comp:AutoCompleteComboBox x:Name="TrdNameCb_edit" Height="24" Width="160" Margin="6,0,0,0"
                                                       DisplayValuePath="namecn"
                                                       SelectedItem="{Binding SelectedTrader_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding TraderName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                        BackGroundCob="{StaticResource ColorBrush.Black8}" 
                                                       MouseOverBorderBrushCob="{StaticResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{StaticResource TextBox.Focus.Border}"
                                                       Watermark="客户名" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedUserIDCB_PatternChanged">
                                <comp:AutoCompleteComboBox.AutoCompColumns>
                                    <DataGridTemplateColumn MinWidth="100" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent">
                                                    <TextBlock Grid.Column="0" Height="22" Text="{Binding namecn}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Content="{Binding Text}"/>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn MinWidth="100" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent">
                                                    <TextBlock Grid.Column="0" Height="22" Text="{Binding instname}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Content="{Binding Text}"/>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </comp:AutoCompleteComboBox.AutoCompColumns>
                            </comp:AutoCompleteComboBox>

                            <!--VIP-->
                            <CheckBox Content="VIP" Foreground="{StaticResource ColorBrush.Yellow-1}" Width="40" FontStyle="Italic" FontWeight="Bold" BorderThickness="1" BorderBrush="{StaticResource ColorBrush.Gray-23}" 
                           IsChecked="{Binding CheckVIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource CommonCheckBoxStyle}" Background="Transparent" Padding="0,0,0,0" Margin="5,0,0,0"/>
                            <!--客户类型-->
                            <comp:AutoCompleteComboBox x:Name="cbClientType" Height="24" Width="120" Margin="1 0 0 0" Grid.Column="1"
                                                       DisplayValuePath="shortnamecn"
                                                       SelectedItem="{Binding SelectClientTypeItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding ClientTypeEnum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{StaticResource ColorBrush.Black8}" 
                                                       MouseOverBorderBrushCob="{StaticResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{StaticResource TextBox.Focus.Border}"
                                                       Watermark="客户类型" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                                       VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="cbClientType_PatternChanged">
                                <comp:AutoCompleteComboBox.AutoCompColumns>
                                    <DataGridTemplateColumn MinWidth="50" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent">
                                                    <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                        <TextBlock.ToolTip>
                                                            <ToolTip Content="{Binding Text}"/>
                                                        </TextBlock.ToolTip>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </comp:AutoCompleteComboBox.AutoCompColumns>
                            </comp:AutoCompleteComboBox>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

            <!--过滤筛选-->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10,4,10,4" Grid.Row="3" Grid.ColumnSpan="2"  Style="{StaticResource DefaultGridViewScrollViewerStyle}">
                <localComp:InnerBoardFilterPanel_New x:Name="FuzzyRequireFilterPanel"
                        FocusTags="{Binding FocusTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        StartPrice="{Binding StartPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndPrice="{Binding EndPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsPrice="{Binding IsPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsShowSaveEdit="Collapsed" />
            </ScrollViewer>

            <!--订阅 发布 UI-->
            <Border BorderThickness="0,0,0,0" Grid.Row="4" Grid.Column="2" Margin="10,0,10,0">
                <innercomp:TagConditionView x:Name="TagConditionView"></innercomp:TagConditionView>
            </Border>

            <Border BorderThickness="0,1,0,0" Grid.Row="5"  Grid.Column="0" Margin="10,0,10,0"  BorderBrush="{StaticResource MainBackgroup.ColorBrush}">
                <StackPanel  HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,10,0" >
                    <Button Content="取消" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" Style="{StaticResource GrayButtonStyle}" Command="{Binding CloseCommand}"/>
                    <Button Content="发布并继续" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" Style="{StaticResource RedButtonStyle}" Background="#193D37" Command="{Binding PublishAndContinueCommand}" />
                    <Button Content="发布" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" Style="{StaticResource RedButtonStyle}" Background="#193D37" Command="{Binding PublishCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
