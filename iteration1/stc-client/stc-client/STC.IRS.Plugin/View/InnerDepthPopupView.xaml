<UserControl x:Class="STC.IRS.Plugin.View.InnerDepthPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.IRS.Plugin.View"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:localComp="clr-namespace:STC.IRS.Plugin.View.Component"
             xmlns:con="clr-namespace:STC.IRS.Plugin.Convertor"
             xmlns:commonCon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             FontSize="12"
             Foreground="#515151" Width="650" Height="{Binding ViewHeight}"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <commonCon:GreaterThanZeroConverter x:Key="greaterThanZeroConverter"/>
            <con:PriceStringConverter x:Key="priceStringConverter"/>
            <con:WidthConverter x:Key="widthConverter"/>

            <!-- FrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Polygon Fill="#FFB60E" Points="6 -5.31777997e-15 0 7.42857143 4 7.42857143 2 13 8 5.57142857 3.99658203 5.57142857"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- NoFrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfNonFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="NF" Foreground="White">
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="2" Grid.Row="0" CornerRadius="4" BorderBrush="#A0A0A0"  Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Height="24" Margin="0,4,0,0" x:Name="TitlePanel"  HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Margin="6, 4, 0, 0" Text="{Binding SecurityID}" x:Name="TextBlockSecurity" Foreground="{DynamicResource LogDefaultFontBrush}" FontSize="14" FontWeight="Bold"></TextBlock>
                <TextBlock Margin="6, 4, 0, 0" Text="{Binding Symbol}" Foreground="{DynamicResource LogDefaultFontBrush}"  ToolTip="{Binding Symbol}" FontSize="14" FontWeight="Bold" ></TextBlock>
            </StackPanel>

            <Button x:Name="JOIN" Content="JOIN" Width="64" Height="24" Margin="0,0,70,0" HorizontalAlignment="Right" Style="{DynamicResource GrayButtonStyle2}" Click="JOIN_Click"  BorderBrush="#3C3C3C" BorderThickness="0 1 0 0" Background="#282828"/>
            <Button x:Name="REF" Content="REF" Width="64" Height="24" Margin="0,0,4,0" HorizontalAlignment="Right" Style="{DynamicResource GrayButtonStyle2}" Click="REF_Click"  BorderBrush="#3C3C3C" BorderThickness="0 1 0 0" Background="#282828"/>

            <localComp:CustomInnerDataGrid x:Name="depthDg_irs" Grid.Row="1" Style="{DynamicResource DefaultDataGrid}" ItemsSource="{Binding ViewSource.View}" MouseDoubleClick="depthDg_MouseDoubleClick" IsColumnSetting="False"
                      SelectedItem="{Binding SelectedDepthData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HeadersVisibility="None" MouseRightButtonDown="depthDg_MouseRightButtonDown">
                <localComp:CustomInnerDataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource  DataGridCellStyle}">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </localComp:CustomInnerDataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="dgMenu_Best" Style="{DynamicResource DefaultContextMenu}" Opened="dgMenu_Best_Opened">
                        <MenuItem x:Name="JoinMenu_Best" Header="Join" Style="{DynamicResource DefaultMenuItem}" Click="JoinMenu_Best_Click"/>
                        <MenuItem x:Name="PointPriceMenu_Best" Header="点价" Style="{DynamicResource DefaultMenuItem}" Click="PointPriceMenu_Best_Click"/>
                        <MenuItem x:Name="ReplyPriceMenu_Best" Header="回价" Style="{DynamicResource DefaultMenuItem}" Click="ReplyPriceMenu_Best_Click"/>
                        <MenuItem x:Name="REFMenu_Best" Header="REF" Style="{DynamicResource DefaultMenuItem}" Click="REFMenu_Best_Click"/>
                        <MenuItem x:Name="EditMenu_Best" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="EditMenu_Best_Click"/>
                        <MenuItem x:Name="ConsiderationMenu_Best" Header="报对价" Style="{DynamicResource DefaultMenuItem}" Click="ConsiderationMenu_Best_Click"/>
                        <MenuItem x:Name="CopyMenu_Best" Header="复制" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_Best_Click"/>
                        <!--<MenuItem x:Name="SearchMenu_Best" Header="搜索该券" Style="{DynamicResource DefaultMenuItem}" Click="SearchMenu_Best_Click"/>-->
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="报价时间(B)" Width="60" Binding="{Binding UpdateTime_InnerBid}"  HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                    <DataGridTemplateColumn Header="Trader(B)" Width="11*" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="isMeBorder_bid" CornerRadius="2" Background="#853629" Width="16" Height="16" Visibility="Collapsed" Margin="0,0,1,0" >
                                        <TextBlock Text="我" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding PartySubName_InnerBid}" Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding PartySubName_InnerBid}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMe_InnerBid}" Value="true">
                                        <Setter TargetName="isMeBorder_bid" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Vol.Bid" Width="12*" HeaderStyle="{DynamicResource DataGridColumnHeaderLeftStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="qtyTB_InnerBid" Text="{Binding Qty_InnerBid, Converter={StaticResource StringConvertor}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                                          ToolTip="{Binding Qty_InnerOfr, Converter={StaticResource StringConvertor}}"/>
                                    <Border x:Name="wholeTag_InnerBid" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" Margin="1 0 0 0" CornerRadius="1" Visibility="Collapsed">
                                        <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button x:Name="reply_InnerBid" Grid.Column="2" Content="未回" Height="18" Width="40" Style="{DynamicResource RedButtonStyle2}" Visibility="Collapsed" Margin="1 0 0 0"/>
                                    <!--<Border x:Name="reply_InnerBid" Grid.Column="2" CornerRadius="6" Width="36" Background="#136C5E" Visibility="Collapsed" Margin="1 0 0 0">
                                        <TextBlock Text="未回" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>-->
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding WholeFlag_InnerBid}" Value="1">
                                        <Setter TargetName="wholeTag_InnerBid" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Count_InnerBid}" Value="0">
                                        <Setter TargetName="qtyTB_InnerBid" Property="Text" Value=""/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DQType_InnerBid}" Value="!">
                                        <Setter TargetName="reply_InnerBid" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Bid" Width="13*" HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid x:Name="bid_Part">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition MinWidth="12" MaxWidth="12"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 大拇指 -->
                                    <Image x:Name="thumbImage" Source="/STC.Common;component/Images/大拇指.png" Width="10" Height="10" Visibility="Collapsed" Margin="1,0,0,0"/>

                                    <!-- 价格 -->
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="priceTB_InnerBid" Foreground="{DynamicResource ColorBrush.Orange}" FontSize="14" FontWeight="Bold" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource priceStringConverter}" ConverterParameter="Bid">
                                                    <Binding Path="Price_InnerBid" />
                                                    <Binding Path="SecurityID" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock x:Name="bp" Text="bp" Foreground="{DynamicResource ColorBrush.Orange}" Grid.Column="1" FontSize="12" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- 意向图标 -->
                                    <Grid x:Name="firm_part" Margin="1,0,0,0" Grid.Column="2">
                                        <Image x:Name="firmbtn" Source="/STC.Common;component/Images/Firm.png" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSpreadOrBasis}" Value="true"/>
                                            <Condition Binding="{Binding Count_InnerBid, Converter={StaticResource greaterThanZeroConverter}}" Value="true"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="bp" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <!--<DataTrigger Binding="{Binding FirmFlag_InnerBid}" Value="0">
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="intentionTB" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>-->
                                    <DataTrigger Binding="{Binding FirmFlag_InnerBid}" Value="1">
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Count_InnerBid}" Value="0">
                                        <Setter TargetName="priceTB_InnerBid" Property="Text" Value=""/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMarketBest_InnerBid}" Value="1">
                                        <Setter TargetName="thumbImage" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ofr" Width="13*" HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid x:Name="ofr_Part">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="12"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="16" MinWidth="16"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 意向图标 -->
                                    <Grid x:Name="firm_part">
                                        <Image x:Name="firmbtn" Source="/STC.Common;component/Images/Firm.png" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Right"   
                                           Margin="0,0,1,0" Visibility="Collapsed"/>
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="priceTB_InnerOfr" Foreground="{DynamicResource ColorBrush.Blue}" FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource priceStringConverter}" ConverterParameter="Ofr">
                                                    <Binding Path="Price_InnerOfr" />
                                                    <Binding Path="SecurityID" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock x:Name="bp" Text="bp" Foreground="{DynamicResource ColorBrush.Blue}" Grid.Column="1" FontSize="12" Visibility="Collapsed" VerticalAlignment="Bottom"/>
                                    </Grid>

                                    <!-- 大拇指 -->
                                    <Image x:Name="thumbImage" Grid.Column="2" Source="/STC.Common;component/Images/大拇指.png" Width="10" Height="10" Visibility="Collapsed" Margin="0,0,1,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSpreadOrBasis}" Value="true"/>
                                            <Condition Binding="{Binding Count_InnerOfr, Converter={StaticResource greaterThanZeroConverter}}" Value="true"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="bp" Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <!--<DataTrigger Binding="{Binding FirmFlag_InnerOfr}" Value="0">
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="nonfirmbtn" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="intentionTB" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>-->
                                    <DataTrigger Binding="{Binding FirmFlag_InnerOfr}" Value="1">
                                        <Setter TargetName="firmbtn" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Count_InnerOfr}" Value="0">
                                        <Setter TargetName="priceTB_InnerOfr" Property="Text" Value=""/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMarketBest_InnerOfr}" Value="1">
                                        <Setter TargetName="thumbImage" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Vol.Ofr" Width="12*" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="reply_InnerOfr" Content="未回" Height="18" Width="40" Style="{DynamicResource RedButtonStyle2}" Visibility="Collapsed" Margin="0 0 1 0"/>
                                    <!--<Border x:Name="reply_InnerOfr" CornerRadius="6" Width="36" Background="#136C5E" Visibility="Collapsed" Margin="0 0 1 0">
                                        <TextBlock Text="未回" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>-->
                                    <Border x:Name="wholeTag_InnerOfr" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18"  CornerRadius="1" Visibility="Collapsed" Margin="0 0 1 0">
                                        <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="qtyTb_InnerOfr" Grid.Column="2"  Text="{Binding Qty_InnerOfr, Converter={StaticResource StringConvertor}}" 
                                               ToolTip="{Binding Qty_InnerOfr, Converter={StaticResource StringConvertor}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding WholeFlag_InnerOfr}" Value="1">
                                        <Setter TargetName="wholeTag_InnerOfr" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Count_InnerOfr}" Value="0">
                                        <Setter TargetName="qtyTb_InnerOfr" Property="Text" Value=""/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DQType_InnerOfr}" Value="!">
                                        <Setter TargetName="reply_InnerOfr" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Trader(O)" Width="11*" HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PartySubName_InnerOfr}"  TextTrimming="CharacterEllipsis" ToolTip="{Binding PartySubName_InnerOfr}"/>
                                    <Border x:Name="isMeBorder_Ofr" Grid.Column="1" CornerRadius="2" Background="#853629" Width="16" Height="16" Visibility="Collapsed" Margin="1,0,0,0">
                                        <TextBlock Text="我" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMe_InnerOfr}" Value="true">
                                        <Setter TargetName="isMeBorder_Ofr" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="报价时间(O)" Width="60" Binding="{Binding UpdateTime_InnerOfr}"  HeaderStyle="{DynamicResource DataGridColumnHeaderRightStyle}"/>
                </DataGrid.Columns>
            </localComp:CustomInnerDataGrid>
        </Grid>

    </Border>
</UserControl>
