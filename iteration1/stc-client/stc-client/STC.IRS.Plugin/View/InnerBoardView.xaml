                                     PreviewMouseDown="ProfileListBox_PreviewMouseDown" SelectionChanged="ProfileListBox_SelectionChanged">
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource TagGroupListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding GroupName}"/>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Grid>


                    <localComp:CustomInnerDataGrid x:Name="InnerBoard_dataGrid_IRS" ItemsSource="{Binding ViewSource.View}" Grid.Row="2" VirtualizingPanel.VirtualizationMode="Standard"
                                  SelectedItem="{Binding SelectedItem_MyInnerOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionMode="Extended"
                                  Style="{DynamicResource DefaultDataGrid}" IsSynchronizedWithCurrentItem="True" DefaultHideColumns="简称,类型"
                                  Grid.ColumnSpan="2" FrozenColumnCount="3" PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown" MouseRightButtonDown="InnerBoard_dataGrid_MouseRightButtonDown"
                                                   SelectionChanged="InnerBoard_dataGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                                    </Trigger>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource DefaultAlternatingRowBackground.ColorBrush}" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Item.SelectedInactive.Background}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedInactive.Border}"/>
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                            <Condition Property="IsSelected" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}"/>
                                    </MultiTrigger>

                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="true" />
                                            <Condition Property="IsSelected" Value="false" />
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Item.MouseOver.Background}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Item.MouseOver.Border}" />
                                    </MultiTrigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="true" />
                                            <Condition Property="IsSelected" Value="true" />
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Item.SelectedActive.Background}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Item.SelectedActive.Border}" />
                                    </MultiTrigger>
                                    <DataTrigger Binding="{Binding FlashCount}" Value="3">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FlashCount}" Value="1">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}" />
                                <Setter Property="Background" Value="{DynamicResource DefaultBackgroup.ColorBrush}" />
                                <Setter Property="Height" Value="24" />
                            </Style>
                        </DataGrid.RowStyle>
                        <!--<DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNeedFlash}" Value="true">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation AutoReverse="True" 
                                                        RepeatBehavior="2x"
                                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" 
                                                        To="Orange" Duration="0:0:0.3"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>-->
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="dgMenu" Style="{DynamicResource DefaultContextMenu}" Opened="dgMenu_Opened">
                                <MenuItem x:Name="JoinMenu" Header="Join" Style="{DynamicResource DefaultMenuItem}" Click="JoinMenu_Click"/>
                                <MenuItem x:Name="PointPriceMenu" Header="点价" Style="{DynamicResource DefaultMenuItem}" Click="PointPriceMenu_Click"/>
                                <MenuItem x:Name="ReplyPriceMenu" Header="回价" Style="{DynamicResource DefaultMenuItem}" Click="ReplyPriceMenu_Click"/>
                                <MenuItem x:Name="REFMenu" Header="REF" Style="{DynamicResource DefaultMenuItem}" Click="REFMenu_Click"/>
                                <MenuItem x:Name="EditMenu" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="EditMenu_Click"/>
                                <MenuItem x:Name="ConsiderationMenu" Header="报对价" Style="{DynamicResource DefaultMenuItem}" Click="ConsiderationMenu_Click"/>
                                <MenuItem x:Name="CopyMenu" Header="复制" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_Click"/>
                                <MenuItem x:Name="SearchMenu" Header="搜索该券" Style="{DynamicResource DefaultMenuItem}" Click="SearchMenu_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <!--<DataGridTextColumn Header="orderid" Binding="{Binding OrderID}"/>-->
                            <!--<DataGridTextColumn Header="intentionid" Binding="{Binding IntentionID}"/>-->
                            <DataGridTemplateColumn Header="期限" Width="Auto" MinWidth="105" SortMemberPath="Term_Convert">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="14"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="term" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding Term}">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Text}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <Button Grid.Column="1" HorizontalAlignment="Right" Width="12" Height="12"  BorderThickness="0" Style="{DynamicResource OpenSecurityButton}"  ToolTip="查看行情小窗"  Click="opensecurity_btn_Click"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Is1YOr5Y}" Value="1">
                                                <Setter TargetName="term" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="term" Property="Foreground" Value="{StaticResource YellowForground}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding SecurityID}" Header="代码" Width="Auto" MinWidth="85" FontWeight="SemiBold" ClipboardContentBinding="{Binding SecurityID}" CellStyle="{StaticResource SinglePointPriceStyle}"  SortMemberPath="SecurityID">
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Style.Triggers>
                                                <DataTrigger Binding="{Binding Is1YOr5Y}" Value="1">
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource YellowForground}"/>
                                                </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn  Header="简称" Width="Auto" MinWidth="85" SortMemberPath="Symbol" CellStyle="{StaticResource SinglePointPriceStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Symbol}" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding Symbol}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Binding="{Binding Type}" Header="类型" Width="Auto" MinWidth="85"/>
                            <DataGridTextColumn Binding="{Binding Product}" Header="产品" Width="Auto" MinWidth="85"/>
                            <DataGridTextColumn Binding="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"
                                                    ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                    Header="方向" Width="Auto" MinWidth="40" CellStyle="{StaticResource ColumnColorStyle}"/>
                            <DataGridTemplateColumn Header="报价" Width="Auto" MinWidth="90" SortMemberPath="Price">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                                        <Setter Property="Padding" Value="11,0,5,0"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="price_part">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Polygon x:Name="BestInnerArrow" Grid.Column="0" Stroke="#FF7D00" Fill="#FF7D00" Points="0,0 0,6 6,0" HorizontalAlignment="Left" Visibility="Collapsed"/>

                                            <Grid x:Name="icon_part" Grid.Column="1" FlowDirection="LeftToRight">
                                                <Grid.MaxWidth>
                                                    <MultiBinding Converter="{StaticResource widthConverter}">
                                                        <Binding Path="ActualWidth" ElementName="price_part"/>
                                                        <Binding Path="ActualWidth" ElementName="reply"/>
                                                    </MultiBinding>
                                                </Grid.MaxWidth>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="bp" Text="bp" FontSize="12" Visibility="Collapsed" VerticalAlignment="Bottom"  Grid.Column="1"/>

                                                <!-- 价格 -->
                                                <TextBlock x:Name="priceTB_InnerOfr" FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" MinWidth="30">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource priceStringConverter}">
                                                            <Binding Path="Price_Display" />
                                                            <Binding Path="SecurityID" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>

                                            <Button x:Name="reply" Content="未回" Height="18" Width="40" Style="{DynamicResource RedButtonStyle2}" Visibility="Collapsed" Grid.Column="2" HorizontalAlignment="Right" FontSize="12" FontWeight="Normal"/>
                                            <!--<Border x:Name="reply" CornerRadius="6" Width="40" Background="#136C5E" Visibility="Collapsed" Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="未回" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontSize="12"/>
                                            </Border>-->

                                            <!--<TextBlock Grid.Column="1" Text="{Binding Price_Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Price_Display}"/>-->
                                            <!--<Button x:Name="reply" Content="回复" Height="24" Width="60" Style="{StaticResource RedButtonStyle2}" Grid.Column="3" Visibility="Collapsed" Margin="5 0 0 0"/>-->
                                            
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSpreadOrBasis}" Value="true">
                                                <Setter TargetName="bp" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInnerBest}" Value="true">
                                                <Setter TargetName="BestInnerArrow" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding DQType}" Value="!">
                                                <Setter TargetName="reply" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ColumnColorStyle}">
                                        <!--<Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMe}" Value="true">
                                                <Setter Property="Background" Value="DarkSeaGreen"/>
                                            </DataTrigger>
                                        </Style.Triggers>-->
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                            </DataGridTemplateColumn>
                            <!--<DataGridTextColumn Binding="{Binding Qty}" Header="报量(万元)" Width="Auto" MinWidth="80" ClipboardContentBinding="{Binding Qty}" />-->
                            <DataGridTemplateColumn Header="报量(百万)" Width="90" MinWidth="90" ClipboardContentBinding="{Binding Qty, Converter={StaticResource StringConvertor}}" SortMemberPath="Qty">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SinglePointPriceStyle}">
                                        <!--<Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMe}" Value="true">
                                                <Setter Property="Background" Value="DarkSeaGreen"/>
                                            </DataTrigger>
                                        </Style.Triggers>-->
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                         <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Qty, Converter={StaticResource StringConvertor}}" Foreground="{Binding Qty, Converter={StaticResource colorCon}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Qty, Converter={StaticResource StringConvertor}}"/>
                                            <Border x:Name="wholeTag" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Margin="1 0 1 0" VerticalAlignment="Center" Visibility="Hidden">
                                                <TextBlock Text="整" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
 
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                                                <Setter TargetName="wholeTag" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>

                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding FirmFlag,Converter={StaticResource EnumTypeConvertor},ConverterParameter='firmflag'}" Header="意向类型" Width="Auto" MinWidth="50" HeaderStyle="{StaticResource DataGridColumnHeaderLeftStyle}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource SinglePointPriceStyle}">
                                        <!--<Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMe}" Value="true">
                                                <Setter Property="Background" Value="DarkSeaGreen"/>
                                            </DataTrigger>
                                        </Style.Triggers>-->
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                           
                            <DataGridTemplateColumn  Header="本方交易员" Width="Auto" MinWidth="80" SortMemberPath="PartySubName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PartySubName}"/>
                                            <Border x:Name="isMeBorder" CornerRadius="2" Background="#853629" Width="16" Height="16" Visibility="Collapsed" Margin="5,0,0,0">
                                                <TextBlock Text="我" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMe}" Value="true">
                                                <Setter TargetName="isMeBorder" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="外部市场最优" Width="160" MinWidth="160" MaxWidth="350" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition  Width="4"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="best_bid" Grid.Column="2" Text="{Binding Best_Bid, Converter={StaticResource numConvertor}, StringFormat={}{0:0.00##}, NotifyOnTargetUpdated=True}" Opacity="{Binding Best_Bid_Opacity}" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="best_ofr" Grid.Column="4" Text="{Binding Best_Ofr, Converter={StaticResource numConvertor}, StringFormat={}{0:0.00##}, NotifyOnTargetUpdated=True}" Opacity="{Binding Best_Ofr_Opacity}" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Best_Bid, Converter={StaticResource numConvertor}}" Value="--">
                                                <Setter TargetName="best_bid" Property="Foreground" Value="#4A4D4C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Best_Ofr, Converter={StaticResource numConvertor}}" Value="--">
                                                <Setter TargetName="best_ofr" Property="Foreground" Value="#4A4D4C"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding RoleName}" Header="角色" Width="Auto" MinWidth="60"/>
                            <DataGridTemplateColumn Header="Client" Width="auto" MinWidth="80" SortMemberPath="Client">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Client_BT" Text="{Binding Client}" Foreground="{Binding Client, Converter={StaticResource colorCon}}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMe}" Value="true">
                                                <Setter TargetName="Client_BT" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="Client_BT" Property="Foreground" Value="#C29B4E"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="最新成交(%)" Width="Auto" MinWidth="80"  SortMemberPath="LastMarketPx">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastMarketPx,Converter={StaticResource numConvertor}}" Foreground="{Binding LastMarketPx, Converter={StaticResource colorCon}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding UpdateTime}" Header="最后更新时间" Width="Auto" MinWidth="80"/>
                        </DataGrid.Columns>
                    </localComp:CustomInnerDataGrid>
                </Grid>
            </TabItem>

            <!--<TabItem x:Name="historyreqTab" Header="历史需求"  Width="86" Visibility="{Binding IsShowIHR}">-->
            <!--<TabItem x:Name="historyreqTab" Header="历史需求"  Width="96" Visibility="Collapsed" Style="{DynamicResource TabItemStyle_Button}">
                <local:InnerHistoryRequire x:Name="ihr"></local:InnerHistoryRequire>
            </TabItem>-->
        </TabControl>

        <commComp:RowCountBar x:Name="countBar" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="290 0 0 6" Visibility="Collapsed"
                              RowCount="{Binding RowCount}" BidRowCount="{Binding BidRowCount}" OfrRowCount="{Binding OfrRowCount}"/>
        <commComp:RowCountBar x:Name="countBar_best" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="290 0 0 6"
                              RowCount="{Binding RowCount_Best}" BidRowCount="{Binding BidRowCount_Best}" OfrRowCount="{Binding OfrRowCount_Best}" />
        <commComp:RowCountBar x:Name="countBar_H" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="290 0 0 6" Visibility="Collapsed"
                              RowCount="{Binding DataContext.RowCount, ElementName=ihr}"
                              BidRowCount="{Binding DataContext.BidRowCount, ElementName=ihr}"
                              OfrRowCount="{Binding DataContext.OfrRowCount, ElementName=ihr}"/>

        <Button x:Name="btnFullScreen" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource PopupButton}" 
                    Command="{x:Static utils:CommonUtils.PopupWindowCommand}" Margin="0 0 10 4">
            <Button.CommandParameter>
                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                    <MultiBinding.Bindings>
                        <Binding Source="{x:Static command:PopupTypeEnum.InnerBoard}" Mode="OneWay"/>
                        <Binding ElementName="innerBoard"/>
                    </MultiBinding.Bindings>
                </MultiBinding>
            </Button.CommandParameter>
        </Button>


        <Button x:Name="btnVer" Grid.RowSpan="2" Grid.Column="1" Width="8" Height="40" Padding="0, 0, 0, 0" Margin="1, 0, 1, 0" Content=">" 
                FontSize="8" Style="{DynamicResource SplitButtonStyle}"  Panel.ZIndex="1" Click="BtnVer_Click"></Button>

        <!-- gridSplitter -->
        <GridSplitter x:Name="gridSplitter" Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource BackgroundBrush}" Style="{DynamicResource VGridSplitterStyleNoVer}"  DragCompleted="gridSplitter_DragCompleted"/>


        <Border BorderBrush="#282828" Margin="2" Grid.Column="2" Grid.RowSpan="2"  x:Name="Pov" BorderThickness="1" Background="#141414" Visibility="Visible">
            <card:PriceAndOrderView x:Name="dgPrice"></card:PriceAndOrderView>
        </Border>
        
        
    </Grid>

</UserControl>
