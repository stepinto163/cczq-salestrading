<UserControl x:Class="STC.IRS.Plugin.View.InnerBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.IRS.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:localComp="clr-namespace:STC.IRS.Plugin.View.Component"
              xmlns:card="clr-namespace:STC.Common.View.Card;assembly=STC.Common"
             xmlns:command="clr-namespace:STC.IRS.Plugin.Command"
              xmlns:utils="clr-namespace:STC.IRS.Plugin.Utils"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" Name="innerBoard"
             d:DesignHeight="450" d:DesignWidth="1500" Unloaded="UserControl_Unloaded"
             DataContextChanged="InnerBoardView_DataContextChanged" Loaded="innerBoard_Loaded"
             xmlns:con="clr-namespace:STC.IRS.Plugin.Convertor">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <con:ColorConvertor x:Key="colorCon"/>
            <fcon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <con:RemainingTimeAndDaysOffStrConvetor x:Key="remainingTimeAndDaysOffStrConvetor"/>
            <fcon:StrContainsConvertor x:Key="strContainsConvertor"/>
            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <fcon:ReverseVisibilityConvertor x:Key="reversevisibilityConvertor"/>
            <fcon:StringConvertor x:Key="StringConvertor"/>
            <fcon:IsInnerConvertor x:Key="IsInnerConvertor"/>
            <SolidColorBrush x:Key="YellowForground" Color="#FFEBC8"/>
            <fcon:MultiBindingConverter x:Key="MultiBindingConverter"/>
            <con:PriceStringConverter x:Key="priceStringConverter"/>
            <con:WidthConverter x:Key="widthConverter"/>
            <con:WidthAddConverter x:Key="widthAddConverter"/>
            <fcon:GreaterThanZeroConverter x:Key="greaterThanZeroConverter"/>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="SinglePointPriceStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <EventSetter Event="MouseDoubleClick" Handler="Single_DataGridCell_MouseDoubleClick"/>
            </Style>
            <Style x:Key="BestPriceStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <EventSetter Event="MouseDoubleClick" Handler="InnerBest_DataGridCell_MouseDoubleClick"/>
            </Style>
            <Style x:Key="InnerBidPointPriceStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <!--<EventSetter Event="MouseDoubleClick" Handler="InnerBid_DataGridCell_MouseDoubleClick"/>-->
                <!--<EventSetter Event="MouseEnter" Handler="InnerBid_DataGridCell_MouseEnter"/>-->
            </Style>

            <Style x:Key="InnerOfrPointPriceStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <!--<EventSetter Event="MouseDoubleClick" Handler="InnerOfr_DataGridCell_MouseDoubleClick"/>-->
                <!--<EventSetter Event="MouseEnter" Handler="InnerOfr_DataGridCell_MouseEnter"/>-->
            </Style>

            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource SinglePointPriceStyle}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
                
            </Style>

            <!-- FrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Label.Content>
                                            <Polygon Fill="#FFB60E" Points="6 -5.31777997e-15 0 7.42857143 4 7.42857143 2 13 8 5.57142857 3.99658203 5.57142857"/>
                                        </Label.Content>
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- NoFrimButton样式-->
            <Style TargetType="{x:Type Button}" x:Key="SelfNonFirmButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Border x:Name="border" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"  CornerRadius="0" Background="Transparent">
                                    <Label Name="label"  Margin="0"  Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Content="NF" Foreground="White">
                                    </Label>
                                </Border>
                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--内部看板-->
            <Style x:Key="TagGroupListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.Static.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.Static.Foreground}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="4 0 0 4"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="1" VerticalAlignment="Center" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource DefaultContextMenu}">
                                        <MenuItem x:Name="TagGroupMenu" Header="{Binding IfSubscribe, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='ifsubscribe_menu'}" Style="{StaticResource DefaultMenuItem}" Click="TagGroupMenu_Click"/>
                                        <MenuItem x:Name="EditGroupMenu" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="EditGroupMenu_Click"/>
                                        <MenuItem x:Name="DelGroupMenu" Header="删除" Style="{DynamicResource DefaultMenuItem}" Click="DelGroupMenu_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="svg_path" Style="{DynamicResource subscrib_path}" Visibility="{Binding IfSubscribe, Converter={StaticResource visibilityConvertor}}" Margin="0 0 4 0"/>
                                    <!--<Image x:Name="subscribeImage" Source="/STC.Common;component/Images/订阅.png" Width="24" Height="24" Visibility="{Binding IfSubscribe, Converter={StaticResource visibilityConvertor}}"/>-->
                                    <ContentPresenter Grid.Column="1" x:Name="Cp" TextElement.FontSize="{TemplateBinding FontSize}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscribeImage" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscribeImage" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid x:Name="innerBorderGrid"  Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Row0"/>
            <ColumnDefinition Width="9" x:Name="Row1"/>
            <ColumnDefinition x:Name="Row2" Width="Auto"/>
        </Grid.ColumnDefinitions>


        <TabControl x:Name="InnerBoard_IRS_CT" Grid.RowSpan="2" Background="{DynamicResource MainTitleBackgroup.ColorBrush}" Style="{DynamicResource TabControlStyle1}" SelectionChanged="TabControl_SelectionChanged">
            <TabItem x:Name="bestTab" Header="最优" Width="96" Style="{DynamicResource TabItemStyle_Button}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="220"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <!--<Button x:Name="Bid_OrderBtn_Best" Content="Bid"  Width="60" Height="24" Foreground="White" Visibility="{Binding ShowOrderBtn}" Margin="10 0 0 0" HorizontalAlignment="Left"
                       Click="Bid_OrderBtn_Best_Click" Background="#ED6D00" BorderBrush="#FF963D"  Style="{DynamicResource OrderButtonStyle}" />
                    <Button x:Name="Ofr_OrderBtn_Best" Content="Ofr" Width="60" Height="24" Foreground="White" Visibility="{Binding ShowOrderBtn}" Margin="80 0 0 0" HorizontalAlignment="Left"
                        Click="Ofr_OrderBtn_Best_Click" Background="#009AFF" BorderBrush="#89C9FF" 
                            Style="{DynamicResource OrderButtonStyle}"/>-->
                    <!--左标题区-->
                    <StackPanel Orientation="Horizontal" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
                        <Button Content="+ 新增需求" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Click="Button_Click"/>
                        <Button Content="批量识别" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Click="ShowRecognizeWin_Click"  Visibility="{Binding RecognitionBtnVisibility}"/>
                        <Button Content="+模糊" x:Name="btnFuzzyRequire" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Click="btnFuzzyRequire_Click" Visibility="{Binding IsShowFuzzy}"/>

                        <Button Content="REF ALL" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" Style="{DynamicResource GraySlateButtonStyle}" Foreground="White"
                             BorderThickness="0 1 0 0" Click="refall_click" IsEnabled="{Binding HasMyOrders}">
                        </Button>
                        <Button x:Name="refBestBtn" Content="REF" Width="80" Height="24" Margin="4 0 0 0"  HorizontalAlignment="Left" Style="{DynamicResource GraySlateButtonStyle}" Foreground="White"
                             BorderThickness="0 1 0 0" Click="ref_best_Click" IsEnabled="False"/>


                    </StackPanel>
                    <!--右标题区-->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource MainTitleBackgroup.ColorBrush}">
                        <commComp:SearchTextBox x:Name="Search_TextBox_Best" HintText="搜索..." ToolTip="可模糊查询债券代码、债券简称、角色、本方交易员" SearchText="{Binding Best_SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Center"  Width="120" Height="24" IsFuzzy="True" IsMagnifierMode="False"
                                                MouseOverBorderBrush="{DynamicResource TextBox.MouseOver.Border}" FocusBorderBrush="{DynamicResource TextBox.Focus.Border}"/>
                        <Button x:Name="RefreshBtn_Best" Width="24" Height="24" Style="{DynamicResource RefreshButton_24}" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
                        <!--<TextBlock Text="自动刷新:" Margin="0 0 110 0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource QuotationList.SubTitle.Foreground}" ToolTip="每隔5秒自动刷新"/>
                    <CheckBox x:Name="autoChk_Best" IsChecked="{Binding AutoEnable,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource  SwitchMMCheckBoxStyle}" Height="16" Width="34" Foreground="#3C3C3C"
                                        Margin="0 0 68 0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="每隔5秒自动刷新"/>-->
                        <Rectangle Width="1" Height="16" Fill="#3C3C3C" Margin="0 0 4 0" HorizontalAlignment="Right"/>
                        <Button x:Name="singleToggleBtn_Best" Width="24" Height="24" Style="{DynamicResource CollapsedButton_24}" Margin="0 0 0 0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="singleToggleBtn_Best_Click"/>
                    </StackPanel>

                    <!--过滤筛选部分-->
                    <Grid x:Name="best_single_filter_part" Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <localComp:InnerBoardFilterPanel_New x:Name="InnerBoardFilterPanel_New_Best" IsMe="{Binding IsMe_Best, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility4IsMe="Visible" 
                                                             HasPrice="{Binding HasPrice_Best, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility4All="Visible"
                                                             FocusTags="{Binding FocusTags_Best, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SaveAction="Save_Best_Click" EditAction="EditGroup_Best_Click"
                                                             SearchText="{Binding Best_SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                             StartPrice="{Binding StartPrice_Best, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndPrice="{Binding EndPrice_Best, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsPrice="{Binding IsPrice_Best, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsShowSaveEdit="Visible"/>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="ProfileListBox_Best"  Background="Transparent" VerticalAlignment="Center" SelectionMode="Single"
                                     ItemsSource="{Binding  ViewSource_Tag.View}" 
                                     SelectedItem="{Binding SelectedItem_Tag_Best, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewMouseDown="ProfileListBox_Best_PreviewMouseDown" SelectionChanged="ProfileListBox_Best_SelectionChanged">
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource TagGroupListBoxItemStyle}">
                                        <Setter Property="Content" Value="{Binding GroupName}"/>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_Best_PreviewMouseLeftButtonDown"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>


                        </Grid>
                    </Grid>
                    
                    <localComp:CustomInnerDataGrid Grid.Row="2"  Grid.ColumnSpan="2" x:Name="InnerBoard_Best_dataGrid_IRS" ItemsSource="{Binding ViewSource_Best.View}" SelectionMode="Extended"
                                  SelectedItem="{Binding SelectedItem_MyInnerOrders_Best, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   IsSynchronizedWithCurrentItem="True" DefaultHideColumns="简称,类型,Bid回复,Ofr回复"
                                  Style="{DynamicResource DefaultDataGrid}" MouseRightButtonDown="InnerBoard_Best_dataGrid_MouseRightButtonDown" FrozenColumnCount="3"
                                                   PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown"
                                                   SelectionChanged="InnerBoard_Best_dataGrid_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="dgMenu_Best" Style="{DynamicResource DefaultContextMenu}" Opened="dgMenu_Best_Opened">
                                <MenuItem x:Name="JoinMenu_Best" Header="Join" Style="{DynamicResource DefaultMenuItem}" Click="JoinMenu_Best_Click"/>
                                <MenuItem x:Name="PointPriceMenu_Best" Header="点价" Style="{DynamicResource DefaultMenuItem}" Click="PointPriceMenu_Best_Click"/>
                                <MenuItem x:Name="ReplyPriceMenu_Best" Header="回价" Style="{DynamicResource DefaultMenuItem}" Click="ReplyPriceMenu_Best_Click"/>
                                <MenuItem x:Name="REFMenu_Best" Header="REF" Style="{DynamicResource DefaultMenuItem}" Click="REFMenu_Best_Click"/>
                                <MenuItem x:Name="EditMenu_Best" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="EditMenu_Best_Click"/>
                                <MenuItem x:Name="ConsiderationMenu_Best" Header="报对价" Style="{DynamicResource DefaultMenuItem}" Click="ConsiderationMenu_Best_Click"/>
                                <MenuItem x:Name="CopyMenu_Best" Header="复制" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_Best_Click"/>
                                <MenuItem x:Name="SearchMenu_Best" Header="搜索该券" Style="{DynamicResource DefaultMenuItem}" Click="SearchMenu_Best_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="期限" Width="Auto" MinWidth="105" SortMemberPath="Term_Convert">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="14"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="term" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding Term}">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Text}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <Button Grid.Column="1" HorizontalAlignment="Right" Width="12" Height="12"  BorderThickness="0" Style="{DynamicResource OpenSecurityButton}"  ToolTip="查看行情小窗"  Click="best_opensecurity_btn_Click"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Is1YOr5Y}" Value="1">
                                                <Setter TargetName="term" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="term" Property="Foreground" Value="{StaticResource YellowForground}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding SecurityID}" Header="代码" Width="Auto" MinWidth="85" FontWeight="SemiBold" ClipboardContentBinding="{Binding SecurityID}" CellStyle="{StaticResource BestPriceStyle}"  SortMemberPath="SecurityID">
                                <DataGridTextColumn.ElementStyle>
                                    <Style>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Is1YOr5Y}" Value="1">
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource YellowForground}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn  Header="简称" Width="Auto" MinWidth="85" SortMemberPath="Symbol" CellStyle="{StaticResource BestPriceStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Symbol}" TextTrimming="CharacterEllipsis"  FontWeight="SemiBold"  ToolTip="{Binding Symbol}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Type}" Header="类型" Width="Auto" MinWidth="85"/>
                            <DataGridTextColumn Binding="{Binding Product}" Header="产品" Width="Auto" MinWidth="85"/>


                            <DataGridTemplateColumn Header="ClientB" Width="60" MinWidth="60" MaxWidth="200" SortMemberPath="Client_InnerBid" Visibility="Collapsed">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderCenterStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="clientBorder" BorderThickness="0" BorderBrush="#C29B4E" CornerRadius="2" HorizontalAlignment="Left" Padding="4 0 4 0">
                                            <TextBlock x:Name="ClientB_BT" Text="{Binding Client_InnerBid}" Foreground="{Binding Client_InnerBid, Converter={StaticResource colorCon}}"/>
                                        </Border>
                                        
                                        <DataTemplate.Triggers>
                                            <MultiDataTrigger >
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataContext.Type1_Flag, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Value="true"/>
                                                    <Condition Binding="{Binding Client_InnerBid, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="clientBorder" Property="BorderThickness" Value="1"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding IsMe_InnerBid}" Value="true">
                                                <Setter TargetName="clientBorder" Property="BorderThickness" Value="0"/>
                                                <Setter TargetName="ClientB_BT" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="ClientB_BT" Property="Foreground" Value="#C29B4E"/>
                                            </DataTrigger>
                                           
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="TraderB" MinWidth="80" Width="Auto" MaxWidth="150" CanUserSort="True" SortMemberPath="PartySubName_InnerBid">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                                        <Setter Property="Padding" Value="24 0 5 0"/>
                                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 我 -->
                                            <Border x:Name="isMeBorder_InnerBid" CornerRadius="2" BorderThickness="1" BorderBrush="#C29B4E" Background="#000000" Width="16" Height="16" Visibility="Collapsed">
                                                <TextBlock Text="我" Foreground="#C29B4E" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <!-- 本方交易员 -->
                                            <TextBlock Grid.Column="1" Text="{Binding PartySubName_InnerBid, Converter={StaticResource StringConvertor}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PartySubName_InnerBid}"  Foreground="{Binding PartySubName_InnerBid, Converter={StaticResource colorCon}}"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMe_InnerBid}" Value="true">
                                                <Setter TargetName="isMeBorder_InnerBid" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="No.Bid" Width="50" MinWidth="50" MaxWidth="200" SortMemberPath="Count_InnerBid"
                                                 CellStyle="{DynamicResource  DataGridTextCenterStyle}">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderCenterStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="countTB_InnerBid" Text="{Binding Count_InnerBid}" FontWeight="Bold" Foreground="{DynamicResource YellowForground}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Count_InnerBid}" Value="0">
                                                <Setter TargetName="countTB_InnerBid" Property="Text" Value="--"/>
                                                <Setter TargetName="countTB_InnerBid" Property="Foreground" Value="#4A4D4C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Count_InnerBid}" Value="1">
                                                <Setter TargetName="countTB_InnerBid" Property="Foreground" Value="white"/>
                                                <Setter TargetName="countTB_InnerBid" Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
