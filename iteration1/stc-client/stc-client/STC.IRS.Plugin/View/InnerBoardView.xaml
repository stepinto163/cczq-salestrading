                        <!--<TextBlock Text="自动刷新:" Margin="0,7,110,7" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource QuotationList.SubTitle.Foreground}" ToolTip="每隔5秒自动刷新" Grid.Column="1"/>
