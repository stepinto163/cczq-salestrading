                        <localComp:InnerBoardFilterPanel_New x:Name="InnerBoardFilterPanel_New" IsMe="{Binding IsMe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility4IsMe="Visible"
