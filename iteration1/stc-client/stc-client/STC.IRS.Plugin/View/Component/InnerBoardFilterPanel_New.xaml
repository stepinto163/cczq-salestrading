<UserControl x:Class="STC.IRS.Plugin.View.Component.InnerBoardFilterPanel_New"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.IRS.Plugin.View.Component"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" Background="Black" d:DesignHeight="500"
             d:DesignWidth="1200"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:innerComp="clr-namespace:STC.IRS.Plugin.View.Component">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MainBackgroup.ColorBrush}">
        <TextBox x:Name="tb" Width="0" Height="0"/>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!--<WrapPanel Orientation="Horizontal">-->
                <!--<commonComp:HoverButton x:Name="ShowAll_ToggleButton" Content="SHOW ALL" Width="80" Height="24" Margin="10 1 0 4"
                Background="#141414" Foreground="#C29B4E" BorderBrush="#141414" Style="{DynamicResource HoverButton}"
                PressBackground="#141414" PressForeground="#C29B4E" PressBorderBrush="#141414"
                HoverBackground="#141414" HoverForeground="#C29B4E" HoverBorderBrush="#141414"/>-->

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ShowAll_ToggleButton" Content="SHOW ALL" Width="80" Height="24" Margin="4 1 0 4"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          IsChecked="False" Style="{DynamicResource ShowAllRadioButtonStyle}" />

                    <!--方向不限IsChecked="True" Style="{DynamicResource ShowAllRadioButtonStyle}" />-->
                    <!--<comp:MultiSelectComboBox x:Name="side" Tag="SIDE" Width="100" Height="24" Background="Black" Margin="4 1 0 4" DefaultText="方向不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </comp:MultiSelectComboBox>-->
                    <innerComp:FilterOptions x:Name="side" TagKey="SIDE" Margin="10 1 0 4" TagsListChanged="TagsListChanged"/>

                    <!--意向不限-->
                    <comp:MultiSelectComboBox x:Name="firmflag" Tag="FIRM" Width="100" Height="24" Background="Black" Margin="4 1 0 4" DefaultText="意向不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </comp:MultiSelectComboBox>

                    <!--业务不限-->
                    <comp:MultiSelectComboBox x:Name="business" Tag="ROLE_TYPE"  Width="100" Height="24" Background="Black" Margin="4 1 0 4" DefaultText="业务不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </comp:MultiSelectComboBox>

                    <!--客户不限-->
                    <comp:MultiSelectComboBox x:Name="OrgCbb" Tag="ORG_TYPE" Width="140" Height="24" Background="Black" Margin="4 1 0 4" DefaultText="客户不限" FilterDicChanged="Cbb_FilterDicChanged">
                    </comp:MultiSelectComboBox>


                    <CheckBox x:Name="vipCB" Style="{DynamicResource DefaultCheckBoxStyle}" Content="VIP" Foreground="#D7D7D7" Padding="4 0 0 0" Margin="4 1 0 4"
                              Checked="vipCB_Checked" Unchecked="vipCB_Unchecked"/>

                    <CheckBox x:Name="isMMNoReplyCB" Content="做市未回" VerticalAlignment="Center" Margin="4 1 0 4" Style="{DynamicResource DefaultCheckBoxStyle}" IsChecked="true" Padding="5 0 0 0"
                      Foreground="#D7D7D7" Checked="isMMNoReplyCB_Checked"  Unchecked="isMMNoReplyCB_Unchecked"/>

                    <CheckBox x:Name="isMeCB" Content="我" VerticalAlignment="Center" Margin="4 1 0 4" Style="{DynamicResource DefaultCheckBoxStyle}" IsChecked="false" Padding="5 0 0 0"
                      Visibility="Collapsed"
                      Foreground="#D7D7D7" Checked="isMeCB_Checked" Unchecked="isMeCB_Unchecked"/>

                    <!--<CheckBox x:Name="PriceChk" Style="{StaticResource DefaultCheckBoxStyle}" Content="报价(%)" Foreground="#D7D7D7" Padding="4 0 0 0" Margin="4 1 0 4" Checked="PriceChk_Checked" Unchecked="PriceChk_Unchecked"/>-->
                    <TextBlock Text="报价" Foreground="#D7D7D7" VerticalAlignment="Center" Margin="8 0 4 2"/>
                    <StackPanel x:Name="Price_Part"  Margin="4 1 0 4"  VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBox x:Name="SPrice" Style="{DynamicResource defaultPercenTextBox}" Height="18" Width="50" input:InputMethod.IsInputMethodEnabled="False"
                         PreviewTextInput="TextBox_PreviewTextInput" Foreground="{DynamicResource ComboBoxItem.MouseOver.Border}"
                          PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" KeyDown="Price_KeyDown" LostFocus="Price_LostFocus" TextChanged="Price_TextChanged"/>
                        <TextBlock Text=" - " Foreground="#7D7D7D"/>
                        <TextBox x:Name="EPrice" Style="{DynamicResource defaultPercenTextBox}" Height="18" Width="50" input:InputMethod.IsInputMethodEnabled="False"
                         PreviewTextInput="TextBox_PreviewTextInput" Foreground="{DynamicResource ComboBoxItem.MouseOver.Border}"
                          PreviewKeyDown="TextBox_PreviewKeyDown" ContextMenu="{x:Null}" KeyDown="Price_KeyDown" LostFocus="Price_LostFocus" TextChanged="Price_TextChanged"/>
                        <!--<Button x:Name="PriceOKBtn" Content="确定" Grid.Column="1" Width="32" Style="{StaticResource GrayButtonStyle}" Height="18" Margin="4 0 0 0"
                             BorderBrush="#3C3C3C" Foreground="#D7D7D7" BorderThickness="0 1 0 0 " Background="#282828" Click="PriceOKBtn_Click"/>-->
                    </StackPanel>

                    <CheckBox x:Name="hasPriceChk" Style="{DynamicResource DefaultCheckBoxStyle}" Content="有价" Foreground="#D7D7D7" Padding="4 0 0 0" Margin="4 1 0 4"
                              IsChecked="True" Checked="hasPriceChk_Checked" Unchecked="hasPriceChk_Unchecked" Visibility="Collapsed"/>
                </StackPanel>

                <WrapPanel x:Name="row1" Orientation="Horizontal"  Grid.Row="1" Width="1200" HorizontalAlignment="Left">
                    <!--类型--><!--
                    <innerComp:FilterOptions x:Name="type1" TagKey="IRS_TYPE" Margin="10 1 0 4" TagsListChanged="TagsListChanged"/>-->

                    <!--产品-->
                    <!--<innerComp:FilterOptions x:Name="product" TagKey="IRS_PRODUCT_TYPE" Margin="10 1 0 4" TagsListChanged="TagsListChanged"/>-->
                    <TextBlock Text="Outright" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <innerComp:FilterOptions x:Name="product_outright" TagKey="Outright" Margin="10 1 0 4" TagsListChanged="TagsListChanged" />
                    <TextBlock Text="Spread" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <innerComp:FilterOptions x:Name="product_spread" TagKey="Spread" Margin="10 1 0 4" TagsListChanged="TagsListChanged" />
                    <TextBlock Text="Basis" Foreground="#A0A0A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4 1 0 4"/>
                    <innerComp:FilterOptions x:Name="product_basis" TagKey="Basis" Margin="10 1 0 4" TagsListChanged="TagsListChanged" />
                </WrapPanel>

                <WrapPanel x:Name="row2" Orientation="Horizontal"  Grid.Row="2" Width="1200" HorizontalAlignment="Left">
                    <!--期限-->
                    <innerComp:FilterOptions x:Name="term" TagKey="IRS_TERM" Margin="10 1 0 4" TagsListChanged="TagsListChanged"/>
                </WrapPanel>

            </Grid>
        </ScrollViewer>
        <Button x:Name="savebtn"  Visibility="Visible" Style="{DynamicResource SaveButton_24}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 34 18" Click="Save_Click"/>
        <Button x:Name="editbtn"  Visibility="Visible" Style="{DynamicResource SettingButton_24}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 10 18" Click="EditGroup_Click"/>
    </Grid>

</UserControl>
