<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        语义画刷层。View 中不允许写死颜色，一律引用本文件的 key；
        换肤 = 替换 Colors.xaml + 本文件（样式用 DynamicResource 引用，自动生效）。
    -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="{DynamicResource Color.WindowBg}" />
    <SolidColorBrush x:Key="PageBgBrush" Color="{DynamicResource Color.PageBg}" />
    <SolidColorBrush x:Key="BoardMainBgBrush" Color="{DynamicResource Color.BoardMainBg}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{DynamicResource Color.PanelBg}" />
    <SolidColorBrush x:Key="HeaderBrush" Color="{DynamicResource Color.PanelBg}" />
    <SolidColorBrush x:Key="HoverBgBrush" Color="{DynamicResource Color.HoverBg}" />
    <SolidColorBrush x:Key="HoverStrongBgBrush" Color="{DynamicResource Color.HoverStrongBg}" />
    <SolidColorBrush x:Key="SelectedBgBrush" Color="{DynamicResource Color.SelectedBg}" />
    <SolidColorBrush x:Key="SelectedHoverBgBrush" Color="{DynamicResource Color.SelectedHoverBg}" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{DynamicResource Color.BorderSubtle}" />
    <SolidColorBrush x:Key="BorderStdBrush" Color="{DynamicResource Color.BorderStd}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource Color.BorderStrong}" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource Color.TextMuted}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{DynamicResource Color.TextFaint}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="TextTagGrayBrush" Color="{DynamicResource Color.TextTagGray}" />

    <!-- 品牌蓝 / 活动 -->
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="BrandBlueBrush" Color="{DynamicResource Color.BrandBlue}" />
    <SolidColorBrush x:Key="OfrBrush" Color="{DynamicResource Color.Ofr}" />
    <SolidColorBrush x:Key="BlueDeepBrush" Color="{DynamicResource Color.BlueDeep}" />
    <SolidColorBrush x:Key="ButtonBlueBrush" Color="{DynamicResource Color.ButtonBlue}" />

    <!-- Bid 琥珀 -->
    <SolidColorBrush x:Key="BidBrush" Color="{DynamicResource Color.Bid}" />
    <SolidColorBrush x:Key="BidDeepBrush" Color="{DynamicResource Color.BidDeep}" />
    <!-- 最优看板 Bid/Ofr 列底（原型 .bid-col/.ofr-col：20% 透明度方向色底） -->
    <SolidColorBrush x:Key="BidColBgBrush" Color="#33F59E0B" />
    <SolidColorBrush x:Key="OfrColBgBrush" Color="#333B82F6" />

    <!-- 涨红跌绿 -->
    <SolidColorBrush x:Key="UpBrush" Color="{DynamicResource Color.Up}" />
    <SolidColorBrush x:Key="DownBrush" Color="{DynamicResource Color.Down}" />

    <!-- 语义 -->
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource Color.Danger}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource Color.Error}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource Color.Success}" />
    <SolidColorBrush x:Key="VolumeBrush" Color="{DynamicResource Color.Volume}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{DynamicResource Color.Purple}" />
    <SolidColorBrush x:Key="PurpleDeepBrush" Color="{DynamicResource Color.PurpleDeep}" />
    <SolidColorBrush x:Key="PinkBrush" Color="{DynamicResource Color.Pink}" />
    <SolidColorBrush x:Key="TknBrush" Color="{DynamicResource Color.Tkn}" />

    <!-- ============ 标签/徽章配色模式：12% 透明度底色 + 同色文字 + 30% 透明度 1px 边框（圆角 3px） ============ -->
    <SolidColorBrush x:Key="TagBidBgBrush" Color="#1FF59E0B" />
    <SolidColorBrush x:Key="TagBidBorderBrush" Color="#4DF59E0B" />
    <SolidColorBrush x:Key="TagOfrBgBrush" Color="#1F3B82F6" />
    <SolidColorBrush x:Key="TagOfrBorderBrush" Color="#4D3B82F6" />
    <SolidColorBrush x:Key="TagFirmBgBrush" Color="#1FD29922" />
    <SolidColorBrush x:Key="TagSuccessBgBrush" Color="#1F3FB950" />
    <SolidColorBrush x:Key="TagSuccessBorderBrush" Color="#4D3FB950" />
    <SolidColorBrush x:Key="TagPurpleBgBrush" Color="#1FA78BFA" />
    <SolidColorBrush x:Key="TagPurpleBorderBrush" Color="#4DA78BFA" />
    <SolidColorBrush x:Key="TagAccentBgBrush" Color="#1F79C0FF" />
    <SolidColorBrush x:Key="TagAccentBorderBrush" Color="#4D79C0FF" />
    <SolidColorBrush x:Key="TagDangerBgBrush" Color="#1FEF4444" />
    <SolidColorBrush x:Key="TagDangerBorderBrush" Color="#4DEF4444" />
    <SolidColorBrush x:Key="TagPinkBgBrush" Color="#1FEC4899" />
    <SolidColorBrush x:Key="TagPinkBorderBrush" Color="#4DEC4899" />
    <!-- 原型 active 态底色：.filter-tag.active 20% 金 / .active-bid 20% 橙 / .active-ofr 20% 蓝 / .active-green 12% 绿 -->
    <SolidColorBrush x:Key="TagGoldActiveBgBrush" Color="#33D29922" />
    <SolidColorBrush x:Key="TagBidActiveBgBrush" Color="#33F59E0B" />
    <SolidColorBrush x:Key="TagOfrActiveBgBrush" Color="#333B82F6" />
    <SolidColorBrush x:Key="TagSuccessActiveBgBrush" Color="#1F3FB950" />

</ResourceDictionary>
