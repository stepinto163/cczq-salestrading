<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        深色主题色板 —— 逐条摘录自原型 app.css（.tmp/prd/ficc-client），见 docs/PROTOTYPE_ANALYSIS.md §1.4。
        本文件只放 Color 原语；语义画刷在 Brushes.xaml；控件样式在 Controls.xaml。
    -->

    <!-- 背景层级 -->
    <Color x:Key="Color.WindowBg">#080A10</Color>
    <Color x:Key="Color.PageBg">#0D1117</Color>
    <Color x:Key="Color.BoardMainBg">#010409</Color>
    <Color x:Key="Color.PanelBg">#161B22</Color>
    <Color x:Key="Color.HoverBg">#1C2129</Color>
    <Color x:Key="Color.HoverStrongBg">#21262D</Color>
    <Color x:Key="Color.ActiveBg">#252D38</Color>
    <Color x:Key="Color.SelectedBg">#26384A</Color>
    <Color x:Key="Color.SelectedHoverBg">#2D4359</Color>

    <!-- 边框 -->
    <Color x:Key="Color.BorderSubtle">#21262D</Color>
    <Color x:Key="Color.BorderStd">#30363D</Color>
    <Color x:Key="Color.BorderStrong">#484F58</Color>

    <!-- 文字 -->
    <Color x:Key="Color.TextPrimary">#E6EDF3</Color>
    <Color x:Key="Color.TextSecondary">#C9D1D9</Color>
    <Color x:Key="Color.TextMuted">#8B949E</Color>
    <Color x:Key="Color.TextFaint">#7D8590</Color>
    <Color x:Key="Color.TextDisabled">#484F58</Color>
    <Color x:Key="Color.TextTagGray">#6E7681</Color>

    <!-- 品牌蓝 / 活动 -->
    <Color x:Key="Color.Accent">#79C0FF</Color>
    <Color x:Key="Color.BrandBlue">#58A6FF</Color>
    <Color x:Key="Color.Ofr">#3B82F6</Color>
    <Color x:Key="Color.BlueDeep">#1F6FEB</Color>
    <Color x:Key="Color.ButtonBlue">#2563EB</Color>

    <!-- Bid 琥珀 -->
    <Color x:Key="Color.Bid">#F59E0B</Color>
    <Color x:Key="Color.BidDeep">#D29922</Color>

    <!-- 涨红跌绿（中国习惯，与 A 股相反） -->
    <Color x:Key="Color.Up">#EF4444</Color>
    <Color x:Key="Color.Down">#3FB950</Color>

    <!-- 语义 -->
    <Color x:Key="Color.Danger">#EF4444</Color>
    <Color x:Key="Color.Error">#F85149</Color>
    <Color x:Key="Color.Success">#3FB950</Color>
    <Color x:Key="Color.Volume">#22D3EE</Color>
    <Color x:Key="Color.Purple">#A78BFA</Color>
    <Color x:Key="Color.PurpleDeep">#A855F7</Color>
    <Color x:Key="Color.Pink">#EC4899</Color>
    <Color x:Key="Color.Tkn">#A371F7</Color>

</ResourceDictionary>
