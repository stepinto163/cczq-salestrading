<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        控件样式库（全部 keyed、零隐式样式 —— 避免污染宿主与兄弟插件弹窗）。
        样式内画刷一律 DynamicResource 引用 Brushes.xaml，支持换肤。
        尺寸/圆角/间距按原型 tokens：按钮 4px、输入 6px、面板 8px、标签 3px；表头 13px/td 14px/base 15px。
    -->

    <!-- ============ 字体（原型 Inter + JetBrains Mono → 系统近似：Segoe UI + Consolas） ============ -->
    <FontFamily x:Key="TextFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>

    <!-- ============ 文本 ============ -->
    <Style x:Key="StcText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="StcTextSecondary" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="StcTextMuted" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="StcTextFaint" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="StcTextSmall" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="StcTextMono" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <!-- 分区标题（原型 uppercase + letter-spacing，WPF 无字距属性，用颜色/字号近似） -->
    <Style x:Key="StcSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <!-- 原型 .filter-section-title：13px / 600 / #8b949e / margin-bottom 8 -->
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style x:Key="StcButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource HoverStrongBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- 原型 tb-btn：padding 5px 14px，font 14/500，高约 29px -->
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StcButton" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <!-- 原型 .tb-btn-default：26px 高、灰底 #21262d + 1px 边框 #30363d、padding 0 10px -->
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BorderStdBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ActiveBgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcButtonPrimary" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource ButtonBlueBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BlueDeepBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcButtonDanger" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <!-- 原型 .tb-btn-primary：红底白字、无边框、30px -->
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcButtonGhost" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 方向批量按钮：Bid 橙底白字 / Ofr 蓝底白字（原型 .tb-btn-bid/.tb-btn-success 实心底，约30px 无边框） -->
    <Style x:Key="StcButtonBid" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource BidBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BidDeepBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcButtonOfr" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource OfrBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BlueDeepBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcButtonGreen" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <!-- 高度对齐工具栏节奏（无 Height 会按 padding+字号自动高，与相邻 26/28 控件混排） -->
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{DynamicResource TagSuccessBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TagSuccessBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TagSuccessBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcButtonRed" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{DynamicResource TagDangerBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TagDangerBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource TagDangerBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcIconButton" TargetType="Button" BasedOn="{StaticResource StcButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ============ 折叠手柄：细长竖条按钮（原型 sidebar-toggle/detail-toggle：深底 #30363d + 边框 #484f58 + hover 提亮） ============ -->
    <Style x:Key="StcSidebarToggle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 右缘圆角（0,6,6,0）：左面板折叠态竖条 -->
    <Style x:Key="StcSidebarToggleRight" TargetType="Button" BasedOn="{StaticResource StcSidebarToggle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,6,6,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 左缘圆角（6,0,0,6）：右面板展开/折叠态竖条 -->
    <Style x:Key="StcSidebarToggleLeft" TargetType="Button" BasedOn="{StaticResource StcSidebarToggle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,0,0,6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 折叠手柄箭头图标（原型 svg polyline 单 chevron，圆角端点=stroke-linecap round） ============ -->
    <Geometry x:Key="GeoChevronRight">M15,18 L9,12 L15,6</Geometry>
    <Geometry x:Key="GeoChevronLeft">M9,18 L15,12 L9,6</Geometry>

    <!-- ============ 输入 ============ -->
    <Style x:Key="StcTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PageBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <!-- 原型 tb-input：水平内距 8px（与 StcComboBox 的 8 对齐；过大的左内距让光标显得离边框很远） -->
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            <!-- 占位文案（项目约定：TextBox.Tag 即占位文案；Tag 为空时该 TextBlock 也不可见） -->
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Visibility="Collapsed"
                                       Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StcPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PageBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <!-- 同 tb-input 视觉：高 28、圆角 6、聚焦蓝描边（PasswordBox 无 Padding，用 PART_ContentHost 的 Margin 模拟水平内边距） -->
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StcComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,0" />
        <!-- 原型 tb-select：padding 4px 8px，font 14，高约 28px；显式 Height 锁死 -->
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" CornerRadius="6" BorderThickness="1"
                                            Background="{DynamicResource HoverStrongBgBrush}"
                                            BorderBrush="{DynamicResource BorderStdBrush}">
                                        <Path Data="M0,0 L4,4 L8,0" HorizontalAlignment="Right" Margin="0,0,8,0"
                                              VerticalAlignment="Center" StrokeThickness="1.5"
                                              Stroke="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource PanelBgBrush}"
                                    BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1"
                                    CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行内单元格下拉（原型 .field-underline .client-select：仅下划线、透明底、13px、focus 变蓝） -->
    <Style x:Key="StcUnderlineComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" CornerRadius="0" BorderThickness="0,0,0,1"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BorderStdBrush}">
                                        <Path Data="M0,0 L4,4 L8,0" HorizontalAlignment="Right" Margin="0,0,2,0"
                                              VerticalAlignment="Center" StrokeThickness="1.5"
                                              Stroke="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource PanelBgBrush}"
                                    BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1"
                                    CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 数据表格（原型：表头 32px/#161b22，行 32px，横向细分隔线，选中 #26384a） ============ -->
    <Style x:Key="StcDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource PageBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <!-- 显式关闭点击表头排序：自定义表头模板无排序箭头，"能排但看不见"比"不能排"更误导；
             接网关后若需排序，先给 StcColumnHeader 补箭头再打开 -->
        <Setter Property="CanUserSortColumns" Value="False" />
        <!-- 列拖拽换位/拉宽对齐原型（ColumnLayoutManager 持久化），行高固定不可拖 -->
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <!-- 虚拟化：行默认开启，列默认关闭。20+ 列宽表首渲染/滚动更快，显式开列虚拟化（本表列宽均固定，安全）。 -->
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <!-- 注意：被引用样式在本文件后文定义，必须用 DynamicResource（StaticResource 前向引用会在字典加载期
             解析到 MS.Internal.NamedObject 占位对象，强转 Style 抛 InvalidCastException，已实测踩坑） -->
        <Setter Property="ColumnHeaderStyle" Value="{DynamicResource StcColumnHeader}" />
        <Setter Property="CellStyle" Value="{DynamicResource StcCell}" />
        <Setter Property="RowStyle" Value="{DynamicResource StcRow}" />
        <!-- 空表占位：使用 DataGrid 自身背景和 Items.Count 触发器，避免窗口级 Adorner 跨页面残留。 -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                <Setter Property="Background">
                    <Setter.Value>
                        <VisualBrush Stretch="None" AlignmentX="Center" AlignmentY="Center">
                            <VisualBrush.Visual>
                                <TextBlock Text="暂无数据" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" Opacity="1" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding Items, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                <Setter Property="Background">
                    <Setter.Value>
                        <VisualBrush Stretch="None" AlignmentX="Center" AlignmentY="Center">
                            <VisualBrush.Visual>
                                <TextBlock Text="暂无数据" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFFFFF" Opacity="1" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="10,0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 单元格模板：背景透明（让行级选中/悬停色透出，且失焦时选中色不退灰）+ 内容上下居中 + 左右 8px 呼吸间隙 -->
    <Style x:Key="StcCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- 焦点反馈在模板内实现（编辑时浅蓝底提示），故显式屏蔽系统虚线框 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="bd" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="8,3" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 键盘进入编辑/单元格持焦：12% 蓝底提示（不加边框，避免 1px 内容位移） -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TagAccentBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StcRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <!-- 斑马纹（原型 table.dt tr.odd td{background:#1c2129}）：AlternationIndex 仅在
                 AlternationCount=2 时变化，未设的表格（报价确认/管理等）恒为 0、不受影响；
                 放在 hover/selected 之前，保证悬停/选中色优先 -->
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#1C2129" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectedBgBrush}" />
            </Trigger>
            <!-- 选中行悬停（原型 #2d4359） -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SelectedHoverBgBrush}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <!-- 数字单元格：等宽字体 + 右对齐 -->
    <Style x:Key="StcNumberCell" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- 文本单元格：超宽省略号 + Tooltip 显全文（原型 board-table td：ellipsis；quote-confirm/precise 表按原型显式 clip 不套此样式） -->
    <Style x:Key="StcTrimText" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
    </Style>
    <!-- ============ 看板表格对齐变体（原型 table.dt 默认 text-align:center，仅少数列 align:'left'；
                 其它模块的表不改对齐，故做成独立 key 只供三个看板引用） ============ -->
    <Style x:Key="StcColumnHeaderLeft" TargetType="DataGridColumnHeader" BasedOn="{StaticResource StcColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style x:Key="StcTextCellCenter" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StcTrimTextCenter" TargetType="TextBlock" BasedOn="{StaticResource StcTrimText}">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StcNumberCellCenter" TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StcNumberCellLeft" TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>


    <!-- ============ 标签（原型 .filter-tag：实心灰底 #21262d、无边框、圆角 3、padding 2×8、13px；active=20% 色底+同色文字） ============ -->
    <Style x:Key="StcTagBase" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource HoverStrongBgBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 筛选 tag：灰底灰字，hover 提亮，选中 20% 金底+金字（原型 .filter-tag.active） -->
    <Style x:Key="StcTagNeutral" TargetType="ToggleButton" BasedOn="{StaticResource StcTagBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BorderStdBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TagGoldActiveBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource BidDeepBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcTagBid" TargetType="ToggleButton" BasedOn="{StaticResource StcTagBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BorderStdBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <!-- 原型 .active-bid：20% 橙底 + #f59e0b 橙字 -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TagBidActiveBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource BidBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcTagOfr" TargetType="ToggleButton" BasedOn="{StaticResource StcTagBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BorderStdBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <!-- 原型 .active-ofr：20% 蓝底 + #3b82f6 蓝字 -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TagOfrActiveBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OfrBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 报价旗标（原型 .quote-flag：12% 底+30% 边+同色字，圆角 3、10px/600、padding 1×5；
         交互态走 .tag-interactive：off=opacity .3、hover .6、on 1 —— 未设置=淡化彩 chip，设置=全彩 chip） ============ -->
    <Style x:Key="StcQuoteFlagBase" TargetType="ToggleButton" BasedOn="{StaticResource StcTagBase}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Opacity" Value="0.35" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcFlagUrgent" TargetType="ToggleButton" BasedOn="{StaticResource StcQuoteFlagBase}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Background" Value="{DynamicResource TagDangerBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TagDangerBorderBrush}" />
    </Style>
    <Style x:Key="StcFlagRecommend" TargetType="ToggleButton" BasedOn="{StaticResource StcQuoteFlagBase}">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="Background" Value="{DynamicResource TagSuccessBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TagSuccessBorderBrush}" />
    </Style>
    <Style x:Key="StcFlagWhole" TargetType="ToggleButton" BasedOn="{StaticResource StcQuoteFlagBase}">
        <Setter Property="Foreground" Value="{DynamicResource PinkBrush}" />
        <Setter Property="Background" Value="{DynamicResource TagPinkBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TagPinkBorderBrush}" />
    </Style>
    <Style x:Key="StcFlagOco" TargetType="ToggleButton" BasedOn="{StaticResource StcQuoteFlagBase}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource TagAccentBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TagAccentBorderBrush}" />
    </Style>
    <Style x:Key="StcFlagPacking" TargetType="ToggleButton" BasedOn="{StaticResource StcQuoteFlagBase}">
        <Setter Property="Foreground" Value="{DynamicResource PurpleBrush}" />
        <Setter Property="Background" Value="{DynamicResource TagPurpleBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TagPurpleBorderBrush}" />
    </Style>

    <!-- 工具栏旗标（原型 button.quote-flag：同款彩色 chip 放大版 11px、padding 3×8；opacity 开关语义与表格内一致；
         五个旗标同尺寸同构，仅颜色区分 —— 替代原先误读为"红底白字大按钮"的 Red/Gray 两版） -->
    <Style x:Key="StcToolbarFlagUrgent" TargetType="ToggleButton" BasedOn="{StaticResource StcFlagUrgent}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="StcToolbarFlagRecommend" TargetType="ToggleButton" BasedOn="{StaticResource StcFlagRecommend}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="StcToolbarFlagWhole" TargetType="ToggleButton" BasedOn="{StaticResource StcFlagWhole}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="StcToolbarFlagOco" TargetType="ToggleButton" BasedOn="{StaticResource StcFlagOco}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="StcToolbarFlagPacking" TargetType="ToggleButton" BasedOn="{StaticResource StcFlagPacking}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- ============ 工具栏 / 面板 ============ -->
    <Style x:Key="StcToolbar" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="20,8" />
    </Style>
    <Style x:Key="StcPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="StcCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PageBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ============ 子页 tab（原型 subtab：活动态 #79c0ff 文字 + 底部 2px #3b82f6） ============ -->
    <Style x:Key="StcSubTabStrip" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource StcSubTabItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StcSubTabItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- hover 在前、selected 在后：选中项悬停时保持选中配色（后触发器优先） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 顶部导航按钮（原型 nav-btn：活动态 #79c0ff + 底部 2px 蓝边） ============ -->
    <Style x:Key="StcNavStrip" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource StcNavItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StcNavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 徽标（nav 角标：红底白字圆角 8px，字号 9px） ============ -->
    <Style x:Key="StcBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="StcBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- ============ 菜单项（用户下拉） ============ -->
    <Style x:Key="StcMenuButton" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StcMenuButtonDanger" TargetType="Button" BasedOn="{StaticResource StcMenuButton}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- ============ 细滚动条（7px，thumb #30363d hover #484f58，track 透明；横竖兼顾。
         关键：必须同时覆盖 MinWidth/MinHeight，否则被系统 ScrollBar 默认 MinWidth(~17px) 卡住，Width 不生效） ============ -->
    <Style x:Key="StcScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="7" />
        <Setter Property="MinWidth" Value="7" />
        <Setter Property="MinHeight" Value="7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                           IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton x:Name="PART_Decrease" Focusable="False" Command="ScrollBar.PageUpCommand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton x:Name="PART_Increase" Focusable="False" Command="ScrollBar.PageDownCommand">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <!-- 透明全尺寸外层承接命中（模板根 Background 为 null 时 1px margin 区不参与命中），
                                             内层 5px 才是可见滑块 -->
                                        <Grid Background="Transparent">
                                            <Border x:Name="th" Background="{DynamicResource BorderStdBrush}"
                                                    CornerRadius="3" Margin="1" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="th" Property="Background"
                                                        Value="{DynamicResource BorderStrongBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="PART_Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="PART_Increase" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 面板滚动视图：自定义 ScrollViewer 模板，滚动条显式套细样式，精确只作用于外层区域、不波及内部表格/列表 ============ -->
    <Style x:Key="StcPanelScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Column="0" Grid.Row="0"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                   Orientation="Vertical" Style="{StaticResource StcScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                   Orientation="Horizontal" Style="{StaticResource StcScrollBar}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============ 行内编辑下划线输入（原型 field-underline：无边框仅下划线，focus 变蓝） ============ -->
    <Style x:Key="StcFieldTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderStdBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 复选：复用 STC.Common DefaultCheckBoxStyle 的模板结构 ============ -->
    <Style x:Key="StcCheckBox" TargetType="CheckBox">
        <Setter Property="Background" Value="{DynamicResource PageBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="checkBoxBorder" Width="16" Height="16" CornerRadius="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="1" SnapsToDevicePixels="True">
                            <Grid x:Name="markGrid">
                                <Path x:Name="optionMark"
                                      Data="F1 M 9.97498,1.22334L 4.6983,9.09834L 4.52164,9.09834L 0,5.19331L 1.27664,3.52165L 4.255,6.08833L 8.33331,1.52588e-005L 9.97498,1.22334 Z"
                                      Fill="White" Opacity="0" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle x:Name="indeterminateMark" Width="10" Height="2"
                                           Fill="White" Opacity="0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource HoverBgBrush}" />
                            <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Fill" TargetName="optionMark" Value="White" />
                            <Setter Property="Fill" TargetName="indeterminateMark" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource ButtonBlueBrush}" />
                            <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Fill" TargetName="optionMark" Value="White" />
                            <Setter Property="Fill" TargetName="indeterminateMark" Value="White" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Opacity" TargetName="optionMark" Value="1" />
                            <Setter Property="Opacity" TargetName="indeterminateMark" Value="0" />
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource ButtonBlueBrush}" />
                            <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Opacity" TargetName="optionMark" Value="0" />
                            <Setter Property="Opacity" TargetName="indeterminateMark" Value="1" />
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource ButtonBlueBrush}" />
                            <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" TargetName="checkBoxBorder" Value="{DynamicResource BorderStdBrush}" />
                            <Setter Property="BorderBrush" TargetName="checkBoxBorder" Value="{DynamicResource BorderStdBrush}" />
                            <Setter Property="Fill" TargetName="optionMark" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Fill" TargetName="indeterminateMark" Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 右键菜单（深色） ============ -->
    <!-- ===== 行右键菜单（原型 ctx-menu / ctx-item / ctx-divider）=====
         .ctx-menu{background:#161b22;border:1px solid #30363d;border-radius:8px;min-width:180px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.5)}
         .ctx-item{padding:8px 14px;font-size:12px;color:#c9d1d9;display:flex;align-items:center;gap:8px}
         .ctx-item:hover{background:#1c2129;color:#e6edf3} / .active{background:rgba(121,192,255,.1);color:#79c0ff} / .disabled{opacity:.42}
         .ctx-divider{height:1px;background:#21262d}
         子菜单：left:100%;top:0;background:#161b22;border:1px solid #30363d;border-radius:6px;padding:4px 0;min-width:120px -->
    <Style x:Key="StcContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" MinWidth="180" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8"
                                              Direction="270" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel Margin="0,4" IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单分隔线：1px #21262d（原型 .ctx-divider） -->
    <Style x:Key="StcCtxSeparator" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单项图标：几何数据按 24×24 空间书写（与原型 svg viewBox 一致），
         使用时套 <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">…，
         由 Viewbox 把 24 空间缩放到 14px（0.583 倍），故描边给 2.5 以还原原型的 1.5px 视觉粗细；
         颜色跟随菜单项前景色（原型 svg 用 currentColor）。 -->
    <Style x:Key="StcCtxIcon" TargetType="Path">
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem},
                               FallbackValue=#C9D1D9, TargetNullValue=#C9D1D9}" />
    </Style>

    <Style x:Key="StcMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" Padding="14,6.5">
                            <DockPanel LastChildFill="True">
                                <!-- 子菜单箭头（原型 span ▶，仅带子菜单时显示） -->
                                <TextBlock x:Name="subArrow" DockPanel.Dock="Right" Text="▶" FontSize="8"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图标放在 Header 内容里（不用 MenuItem.Icon：本模板下实测不渲染且会把图标列压掉） -->
                                    <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 子菜单容器（原型 ctx-submenu：圆角 6、min-width 120、padding 4 0） -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                               HorizontalOffset="-4" VerticalOffset="-6" PopupAnimation="None">
                            <Border Background="{DynamicResource PanelBgBrush}"
                                    BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1"
                                    CornerRadius="6" MinWidth="120" Padding="0,4" Margin="0,0,8,8"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8"
                                                      Direction="270" Opacity="0.5" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="subArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <!-- 原型 .ctx-item.active（打包 / OCO 已置标签） -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1A79C0FF" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <!-- 原型 .ctx-item.disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ============ 左侧筛选面板专用（原型 .filter-label / .filter-tag / .filter-tag-add / .filter-btn* / .filter-input） ============ -->
    <!-- 分组标签：原型 .filter-label —— 13px / #6e7681 / min-width 70px / 与标签列对齐 -->
    <Style x:Key="StcFilterLabel" TargetType="TextBlock" BasedOn="{StaticResource StcText}">
        <Setter Property="Foreground" Value="{DynamicResource TextTagGrayBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 筛选面板按钮基样式：原型灰底实心、无渐变、圆角 3（区别于 StcButtonBase 的圆角 4/14px 字号） -->
    <Style x:Key="StcFilterButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Background" Value="{DynamicResource HoverStrongBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BorderStdBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 清除过滤：原型内联样式 padding 4px 14px / font 12 / 600（高约 27px） -->
    <Style x:Key="StcFilterButton" TargetType="Button" BasedOn="{StaticResource StcFilterButtonBase}">
        <Setter Property="Height" Value="27" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <!-- 筛选：原型 .filter-btn-primary padding 2px 10px / font 12 / 600（高约 22px） -->
    <Style x:Key="StcFilterMiniButton" TargetType="Button" BasedOn="{StaticResource StcFilterButtonBase}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <!-- 只读筛选标签（原型 .filter-tag，如「我的关注」）：灰底 #21262d、字 #c9d1d9、13px、padding 2px 8px -->
    <Style x:Key="StcFilterTag" TargetType="Button" BasedOn="{StaticResource StcFilterButtonBase}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <!-- 「+」新建标签（原型 .filter-tag-add）：灰底、字 #8b949e -->
    <Style x:Key="StcFilterTagAdd" TargetType="Button" BasedOn="{StaticResource StcFilterButtonBase}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- 分组 chip（侧栏关注债券/筛选分组区，原型 .filter-tag 可选中态）：
         常态 = #21262d/#c9d1d9（同 StcFilterTag），激活 = 金底 rgba(210,153,34,.2) + 金字 #d29922（.filter-tag.active） -->
    <Style x:Key="StcFilterTagToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource HoverStrongBgBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#33D29922" />
                            <Setter Property="Foreground" Value="#FFD29922" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource BorderStdBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="#4DD29922" />
                            <Setter Property="Foreground" Value="#FFE3B341" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分区分隔线：原型 .filter-section{padding-bottom:8px;border-bottom:1px solid #21262d;margin-bottom:12px}
         放在每个分区标题（StcSectionTitle）之前，视觉 = 上一分区底部的 1px 分割线 -->
    <Style x:Key="StcFilterSectionDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="Margin" Value="0,4,0,12" />
    </Style>

    <!-- 区间输入框：原型 .filter-input —— 43×22 / padding 2px 4px / 12px / 右对齐 / 圆角 3 / 底 #0d1117
         占位文案走 Tag（项目约定）：Text 为空时显示，聚焦或输入后隐藏 -->
    <Style x:Key="StcFilterInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PageBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStdBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Visibility="Collapsed"
                                       Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
