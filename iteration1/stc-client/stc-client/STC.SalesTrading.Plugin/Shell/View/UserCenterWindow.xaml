<Window x:Class="STC.SalesTrading.Plugin.Shell.View.UserCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个人中心" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI" UseLayoutRounding="True">
    <!--
        个人中心弹窗（对应原型 showProfile：头像+姓名+角色 / 部门·邮箱·手机 / 关闭·修改密码）。
        无边框自绘标题栏（拖拽/关闭）；"修改密码"切到同窗内密码表单（原型 showChangePasswordModal 语义）。
        独立 Window 不继承宿主皮肤，须自合并主题字典，否则 DynamicResource 解析失败导致全透明。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="个人中心" Style="{DynamicResource StcText}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <Button Content="✕" Width="36" Height="26" Padding="0" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"
                            Click="OnCloseClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StcButtonGhost}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TagDangerBgBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Margin="20,20,20,16">
                <!-- 资料视图 -->
                <StackPanel x:Name="ProfilePanel">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="28">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF3B82F6" Offset="0" />
                                    <GradientStop Color="#FF79C0FF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding Name}" Style="{DynamicResource StcText}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding RoleName}" Style="{DynamicResource StcTextMuted}" FontSize="12"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,20,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="部门" Style="{DynamicResource StcTextFaint}"
                                   Margin="0,0,0,12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Dept}" Style="{DynamicResource StcText}" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="邮箱" Style="{DynamicResource StcTextFaint}"
                                   Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Email}" Style="{DynamicResource StcText}" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="手机" Style="{DynamicResource StcTextFaint}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Phone}" Style="{DynamicResource StcText}" />
                    </Grid>

                    <WrapPanel HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="修改密码" Style="{DynamicResource StcButtonGhost}" FontSize="12" Padding="14,4"
                                Click="OnChangePasswordClick" />
                        <Button Content="关闭" Style="{DynamicResource StcButtonPrimary}" FontSize="12" Padding="18,4"
                                Margin="8,0,0,0" Click="OnCloseClick" />
                    </WrapPanel>
                </StackPanel>

                <!-- 修改密码视图 -->
                <StackPanel x:Name="PasswordPanel" Visibility="Collapsed">
                    <TextBlock Text="修改成功后，新密码将在下次登录时使用。" Style="{DynamicResource StcTextMuted}"
                               FontSize="12" Margin="0,0,0,14" />
                    <TextBlock Text="当前密码" Style="{DynamicResource StcTextFaint}" FontSize="12" />
                    <PasswordBox x:Name="OldPassword" Style="{DynamicResource StcPasswordBox}" Margin="0,6,0,12" />
                    <TextBlock Text="新密码" Style="{DynamicResource StcTextFaint}" FontSize="12" />
                    <PasswordBox x:Name="NewPassword" Style="{DynamicResource StcPasswordBox}" Margin="0,6,0,0" />
                    <TextBlock Text="至少8位，且不能与当前密码或用户名相同。" Style="{DynamicResource StcTextFaint}"
                               FontSize="11" Margin="0,4,0,12" />
                    <TextBlock Text="确认新密码" Style="{DynamicResource StcTextFaint}" FontSize="12" />
                    <PasswordBox x:Name="ConfirmPassword" Style="{DynamicResource StcPasswordBox}" Margin="0,6,0,0" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                               Margin="0,10,0,0" MinHeight="16" />

                    <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="取消" Style="{DynamicResource StcButtonGhost}" FontSize="12" Padding="14,4"
                                Click="OnCancelPasswordClick" />
                        <Button Content="确认修改" Style="{DynamicResource StcButtonPrimary}" FontSize="12" Padding="16,4"
                                Margin="8,0,0,0" Click="OnConfirmPasswordClick" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>