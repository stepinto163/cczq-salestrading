<Window x:Class="STC.SalesTrading.Plugin.Shell.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI" UseLayoutRounding="True">
    <!--
        系统设置弹窗（对应原型 showSettingsModal：偏好设置 + QT/IDEAL 连接状态）。
        偏好项开发期仅展示（Mock，保存 toast）；连接状态为静态样例。
        独立 Window 不继承宿主皮肤，须自合并主题字典，否则 DynamicResource 解析失败导致全透明。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <TextBlock Text="系统设置" Style="{DynamicResource StcText}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                    <Button Content="✕" Width="36" Height="26" Padding="0" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}"
                            Click="OnCloseClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StcButtonGhost}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TagDangerBgBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="20,16,20,4">
                <!-- 偏好设置 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="3" Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                    <TextBlock Text="偏好设置" Style="{DynamicResource StcText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox Content="识别后报价文本留在文本框" Style="{DynamicResource StcCheckBox}"
                          IsChecked="True" Margin="0,0,0,10" />
                <CheckBox Content="识别报价输入框按 Shift+回车 换行" Style="{DynamicResource StcCheckBox}"
                          IsChecked="False" Margin="0,0,0,10" />
                <CheckBox Content="弹窗提醒 - 关注分组报价提醒" Style="{DynamicResource StcCheckBox}"
                          IsChecked="True" Margin="0,0,0,10" />
                <CheckBox Content="弹窗提醒 - 对价提醒" Style="{DynamicResource StcCheckBox}"
                          IsChecked="True" Margin="0,0,0,10" />
                <CheckBox Content="弹窗提醒 - 筛选分组报价提醒" Style="{DynamicResource StcCheckBox}"
                          IsChecked="True" Margin="0,0,0,10" />
                <!-- 原型 0910 新增第四个账号级弹窗开关（对应 app.js alertSettings.bestQuote） -->
                <CheckBox Content="弹窗提醒 - 我的最优报价" Style="{DynamicResource StcCheckBox}"
                          IsChecked="True" Margin="0,0,0,12" />

                <!-- QT/IDEAL 连接 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                    <Border Width="3" Background="{DynamicResource BidDeepBrush}" CornerRadius="2" />
                    <TextBlock Text="QT/IDEAL 连接" Style="{DynamicResource StcText}" FontWeight="SemiBold" Margin="8,0,0,0" />
                </StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="QT 已连接" Foreground="{DynamicResource SuccessBrush}"
                               FontSize="12" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="v4.1.4.6" Style="{DynamicResource StcTextFaint}" FontSize="12" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="IDEAL 已连接" Foreground="{DynamicResource SuccessBrush}"
                               FontSize="12" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="v2.1.0" Style="{DynamicResource StcTextFaint}" FontSize="12" />
                </Grid>
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,14">
                <Button Content="关闭" Style="{DynamicResource StcButtonGhost}" FontSize="12" Padding="18,4"
                        Click="OnCloseClick" />
                <Button Content="保存设置" Style="{DynamicResource StcButtonPrimary}" FontSize="12" Padding="16,4"
                        Margin="8,0,0,0" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>