<UserControl x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.BoardIntentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BoardMainBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏（原型：更新报价/Copy/Refer/Unrefer/导出 + 日期区间） ===== -->
        <Border Grid.Row="0" Style="{DynamicResource StcToolbar}" Padding="20,8">
            <WrapPanel>
                <Button Content="更新报价" Style="{DynamicResource StcButton}" Command="{Binding RefreshCommand}" Margin="0,0,6,4" />
                <Button Content="Copy" Style="{DynamicResource StcButton}" Command="{Binding CopyCommand}" Margin="0,0,6,4" />
                <Button Content="Refer" Style="{DynamicResource StcButton}" Command="{Binding ReferCommand}" Margin="0,0,6,4" />
                <Button Content="Unrefer" Style="{DynamicResource StcButton}" Command="{Binding UnreferCommand}" Margin="0,0,6,4" />
                <Button Content="导出" Style="{DynamicResource StcButton}" Command="{Binding ExportCommand}" Margin="0,0,16,4" />
                <TextBlock Text="日期" Style="{DynamicResource StcTextFaint}" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox Text="{Binding StartDate, UpdateSourceTrigger=LostFocus}" Style="{DynamicResource StcTextBox}"
                         Width="86" FontSize="11" Margin="0,0,6,4" ToolTip="开始日期 MM-dd" />
                <TextBlock Text="~" Style="{DynamicResource StcTextFaint}" VerticalAlignment="Center" Margin="0,0,6,4" />
                <TextBox Text="{Binding EndDate, UpdateSourceTrigger=LostFocus}" Style="{DynamicResource StcTextBox}"
                         Width="86" FontSize="11" Margin="0,0,6,4" ToolTip="结束日期 MM-dd" />
            </WrapPanel>
        </Border>


        <!-- ===== 7 列可编辑表（原型 board-intent-table 1160px） ===== -->
        <DataGrid x:Name="Grid" Grid.Row="1" ItemsSource="{Binding Rows}" Style="{DynamicResource StcDataGrid}"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选择" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{DynamicResource StcCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="报价内容" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- 未同步：行前红色脉冲圆点（原型 board-intent-pending） -->
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         Visibility="{Binding IsPendingSync, Converter={x:Static conv:ConverterLocator.BoolToVis}}" />
                                <TextBox Style="{DynamicResource StcFieldTextBox}"
                                         Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="识别结果" Binding="{Binding RecognizedConditions, Mode=OneWay}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="报价机构" Binding="{Binding Institution, Mode=OneWay}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource StcTrimText}" />
                <DataGridTextColumn Header="报价交易员" Binding="{Binding Trader, Mode=OneWay}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource StcTrimText}" />
                <DataGridTextColumn Header="长城交易员" Binding="{Binding WallTrader, Mode=OneWay}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource StcTrimText}" />
                <DataGridTextColumn Header="报价时间" Binding="{Binding QuoteTimeDisplay, Mode=OneWay}" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="状态" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="12" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

<components:QueryStateOverlay Grid.Row="1" Panel.ZIndex="3"
                    State="{Binding LoadState}" ErrorMessage="{Binding ErrorMessage}" Retry="{Binding RetryCommand}" />
        <components:StatusBar Grid.Row="2" Sections="{Binding StatusSections}" />
    </Grid>
</UserControl>
