<UserControl x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.CreditFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             components:SidebarFilter.Scope="Credit"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 信用筛选面板（原型 filters-credit） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource StcPanelScrollViewer}">
        <StackPanel Margin="12,4,12,16">

                        <!-- 关注债券 / 筛选分组（批次 A）：原型两个独立 .filter-group，chip 由 FilterProfileService 数据驱动
                 （renderMarketGroupTags），title=「名称 · N只债券/N个条件」，点击激活/取消（金底 = 正在按该组过滤看板），
                 「+」打开管理弹窗；弹窗保存 → DataChanged → chip 重建 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="关注债券" Style="{DynamicResource StcFilterLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3,0,0,0">
                    <ItemsControl ItemsSource="{Binding CreditFavChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{DynamicResource StcFilterTagToggle}"
                                              Content="{Binding Name}" ToolTip="{Binding Title}"
                                              IsChecked="{Binding IsActive, Mode=OneWay}"
                                              Command="{Binding ToggleCommand}" Margin="0,0,3,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+" Style="{DynamicResource StcFilterTagAdd}"
                            ToolTip="管理关注债券分组" Click="OnFavBondAddClick" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="筛选分组" Style="{DynamicResource StcFilterLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3,0,0,0">
                    <ItemsControl ItemsSource="{Binding CreditFilterChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{DynamicResource StcFilterTagToggle}"
                                              Content="{Binding Name}" ToolTip="{Binding Title}"
                                              IsChecked="{Binding IsActive, Mode=OneWay}"
                                              Command="{Binding ToggleCommand}" Margin="0,0,3,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+" Style="{DynamicResource StcFilterTagAdd}"
                            ToolTip="管理筛选分组" Click="OnFilterGroupAddClick" />
                </StackPanel>
            </Grid>

<!-- ===== 报价筛选 ===== -->
<components:FilterSectionHeader Title="报价筛选" />
            <components:FilterTagRow components:SidebarFilter.Field="settlType" Label="清算速度" Items="T+0,T+1,远期,非远期" />
            <!-- 计价方式：原型 .filter-group = label 70 + tags + 右对齐"筛选"灰底按钮。
             修复点 1：内层 Grid 缺 Grid.Column="1"，原代码会让按钮挤到左标签下并覆盖 ToggleButton。
             修复点 2：原"筛选"用 StcButtonPrimary 蓝底，跟原型 .filter-btn-primary（#21262d 灰底）不符。 -->
            <Grid components:SidebarFilter.Field="quoteType" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="计价方式" Style="{DynamicResource StcFilterLabel}" Margin="0,2,3,0" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="收益率" Style="{DynamicResource StcTagNeutral}"
                                      Padding="28,2" FontSize="12" Margin="0,0,6,0" />
                        <ToggleButton Content="净价" Style="{DynamicResource StcTagNeutral}"
                                      Padding="28,2" FontSize="12" Margin="0,0,6,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="筛选" Style="{DynamicResource StcFilterMiniButton}" />
                </Grid>
            </Grid>
            <!-- 原型 .filter-grid{grid-template-columns:1fr 1fr;gap:4px 7px}：两列、行优先。
             顺序 = DOM 顺序：Bid/Ofr → Bid-中债/中债-Ofr → Bid-Ofr(置灰)/中债估值 → 中证估值/票面利率 → Vol.Bid/Vol.Ofr(只有最小)。
             Bid-Ofr 在信用页整行置灰（.filter-page-unavailable） -->
            <UniformGrid Columns="2" Margin="0,0,0,4">
                <components:FilterRangeRow components:SidebarFilter.Field="bidPrice" Label="Bid" Unit="%" />
                <components:FilterRangeRow components:SidebarFilter.Field="offerPrice" Label="Ofr" Unit="%" />
                <components:FilterRangeRow components:SidebarFilter.Field="bidValuationSpread" Label="Bid-中债" Unit="BP" />
                <components:FilterRangeRow components:SidebarFilter.Field="offerValuationSpread" Label="中债-Ofr" Unit="BP" />
                <components:FilterRangeRow components:SidebarFilter.Field="bidOfferSpread" Label="Bid-Ofr" Unit="BP" IsDisabled="True" />
                <components:FilterRangeRow components:SidebarFilter.Field="valuationYield" Label="中债估值" Unit="%" />
                <components:FilterRangeRow components:SidebarFilter.Field="csiValuationYield" Label="中证估值" Unit="%" />
                <components:FilterRangeRow components:SidebarFilter.Field="couponRate" Label="票面利率" Unit="%" />
                <components:FilterRangeRow components:SidebarFilter.Field="bidQuantity" Label="Vol.Bid" Unit="万" ShowMax="False" />
                <components:FilterRangeRow components:SidebarFilter.Field="offerQuantity" Label="Vol.Ofr" Unit="万" ShowMax="False" />
            </UniformGrid>

            <!-- ===== 债券筛选 ===== -->
<components:FilterSectionHeader Title="债券筛选" />
            <components:FilterTagRow components:SidebarFilter.Field="bondSubtype" Label="细分券种" Items="短融,中票,企业债,公司债,金融债,PPN,ABS,可转债,NCD,其他" />
            <components:FilterTagRow components:SidebarFilter.Field="hotTags" Label="热门标签" Items="商金债,银行二级,银行永续,政策性次级,保险次级,券商债,保险债,铁道债,可质押,跨市场,城投,房地产,产能过剩,公用事业,上市公司,科创债,TLAC债,新上市,不含假期,绿色债" />
            <components:FilterTagRow components:SidebarFilter.Field="ncdType" Label="NCD类型" Items="国有,股份,城商,农商,外资,其他" />
            <!-- 剩余期限：原型 .filter-group（label 70px 列 + 右侧 flex:1 内含 tags + 全宽输入行） -->
            <Grid components:SidebarFilter.Field="remainingYears" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="剩余期限" Style="{DynamicResource StcFilterLabel}" />
                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                    <WrapPanel>
                        <ToggleButton Content="&lt;3M" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="3-6M" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="6-9M" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="9-12M" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="1-3Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="3-5Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="5-7Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="7-10Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="10-15Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="15-20Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                        <ToggleButton Content="＞20Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    </WrapPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{DynamicResource StcTextBox}" FontSize="11" Padding="6,3" />
                        <TextBlock Grid.Column="1" Text="-" Style="{DynamicResource StcTextFaint}" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Grid.Column="2" Style="{DynamicResource StcTextBox}" FontSize="11" Padding="6,3" />
                        <ComboBox Grid.Column="3" Style="{DynamicResource StcComboBox}" FontSize="11" Width="52" Margin="4,0">
                            <ComboBoxItem Content="Y" /><ComboBoxItem Content="M" /><ComboBoxItem Content="D" />
                        </ComboBox>
                        <Button Grid.Column="4" Content="筛选" Style="{DynamicResource StcFilterMiniButton}" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Grid>
            <components:FilterSearchRow components:SidebarFilter.Field="issuerName" Label="发行人" Placeholder="搜索发行人..." />
            <components:FilterTagRow components:SidebarFilter.Field="listingStatus" Label="债券上市状态" Items="上市,非上市" />
            <components:FilterTagRow components:SidebarFilter.Field="issueMethod" Label="发行方式" Items="公募,小公募,私募" />

            <!-- ===== 流动性筛选 ===== -->
<components:FilterSectionHeader Title="流动性筛选" />
            <Grid components:SidebarFilter.Field="liquidityGrade" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="债券流动性" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="S" Style="{DynamicResource StcTagNeutral}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,3,3" />
                    <ToggleButton Content="A" Style="{DynamicResource StcTagNeutral}" Foreground="{DynamicResource BidBrush}" Margin="0,0,3,3" />
                    <ToggleButton Content="B" Style="{DynamicResource StcTagNeutral}" Foreground="{DynamicResource OfrBrush}" Margin="0,0,3,3" />
                    <ToggleButton Content="C" Style="{DynamicResource StcTagNeutral}" Foreground="{DynamicResource PurpleDeepBrush}" Margin="0,0,3,3" />
                    <ToggleButton Content="D" Style="{DynamicResource StcTagNeutral}" Foreground="#6B7280" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <components:FilterTagRow components:SidebarFilter.Field="marketMakerTags" Label="做市标的" Items="上证信用,深证信用" />
            <components:FilterTagRow components:SidebarFilter.Field="listedMarket" Label="上市场所" Items="银行间,上交所,深交所,北交所" />

            <!-- ===== 信用筛选 ===== -->
<components:FilterSectionHeader Title="信用筛选" />
            <components:FilterTagRow components:SidebarFilter.Field="bankType" Label="银行业" Items="国有行,股份制,城商行,农商行" />
            <components:FilterComboRow components:SidebarFilter.Field="industry" Label="行业" Items="不限,城投,房地产,煤炭,钢铁,化工,建筑,交运,公用事业" />
            <components:FilterTagRow components:SidebarFilter.Field="ownershipType" Label="企业性质" Items="央企,国企,民企,其他" />
            <components:FilterTagRow components:SidebarFilter.Field="guaranteeType" Label="担保" Items="有担保,无担保,全国性担保,地方性担保" />
            <components:FilterSearchRow components:SidebarFilter.Field="guarantorName" Label="担保人" Placeholder="搜索担保人..." />
            <components:FilterTagRow components:SidebarFilter.Field="issuerRating" Label="主体评级" Items="AAA,AA+,AA,AA-,A+,A,更多" />
            <components:FilterTagRow components:SidebarFilter.Field="issuerCbrRating" Label="中债资信" Items="AAA+,AAA,AAA-,AA+,更多" />
            <components:FilterTagRow components:SidebarFilter.Field="ratingOutlook" Label="评级展望" Items="正面,稳定,观察,负面" />
            <components:FilterTagRow components:SidebarFilter.Field="bondRating" Label="债项评级" Items="AAA,A-1,AA+,AA,AA-,更多" />
            <components:FilterTagRow components:SidebarFilter.Field="bondCbrRating" Label="中债隐含" Items="AAA+,AAA,AAA-,AA+,更多" />
            <components:FilterTagRow components:SidebarFilter.Field="yyRating" Label="YY评分" Items="投资级,投机级,风险级" />
            <!-- 中证隐含（原型 filters-credit 信用筛选第 12 项；此前漏实现） -->
            <components:FilterTagRow components:SidebarFilter.Field="csiRating" Label="中证隐含" Items="AAA+,AAA,AA+,AA,AA2,更多" />

            <!-- ===== 条款筛选 ===== -->
<components:FilterSectionHeader Title="条款筛选" />
            <components:FilterTagRow components:SidebarFilter.Field="optionType" Label="含权属性" Items="不含权,含权,赎回权,回售权,其他权" />
            <components:FilterTagRow components:SidebarFilter.Field="repaymentType" Label="偿还方式" Items="到期,提前还本" />
            <components:FilterTagRow components:SidebarFilter.Field="couponFrequency" Label="付息方式" Items="按月,按季,半年,按年,其他" />
            <components:FilterTagRow components:SidebarFilter.Field="isPerpetual" Label="永续债" Items="永续,非永续" />
            <components:FilterTagRow components:SidebarFilter.Field="isSubordinated" Label="次级债" Items="次级,非次级" />
            <components:FilterTagRow components:SidebarFilter.Field="rateIndex" Label="利率方式" Items="SHIBOR,DEPO,LPR,固息" />
            <components:FilterTagRow components:SidebarFilter.Field="issueYear" Label="发行年份" Items="2026,2025,2024,2023,更多" />

            <!-- ===== 区域筛选 ===== -->
<components:FilterSectionHeader Title="区域筛选" />
            <components:FilterTagRow components:SidebarFilter.Field="isMunicipal" Label="城投" Items="城投,非城投" />
            <components:FilterTagRow components:SidebarFilter.Field="keyProvince" Label="重点省份" Items="12重点省,非12重点省" />
            <components:FilterTagRow components:SidebarFilter.Field="municipalLevel" Label="城投层级" Items="省级,市级,区县级,其他" />
            <components:FilterComboRow components:SidebarFilter.Field="regionalRating" Label="地区等级" Items="取值逻辑待确认" />
            <components:FilterComboRow components:SidebarFilter.Field="regionCategory" Label="地区" Items="加载全国省/市/区县..." />
            <components:FilterComboRow components:SidebarFilter.Field="region" Label="省份" Items="不限,北京市,上海市,广东省,江苏省,浙江省,山东省,四川省,湖北省,湖南省,河南省,河北省,福建省,安徽省,江西省,山西省,陕西省,重庆市,天津市,云南省,贵州省,广西壮族自治区,甘肃省,吉林省,黑龙江省,辽宁省,内蒙古自治区,宁夏回族自治区,青海省,西藏自治区,新疆维吾尔自治区,海南省,深圳市,厦门市,宁波市,青岛市,大连市" RowMargin="0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
