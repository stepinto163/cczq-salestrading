<UserControl x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.BoardBestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters"
             xmlns:models="clr-namespace:STC.SalesTrading.Plugin.Abstractions.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="BoardRowContextMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 原型 0910：同档最优报价笔数按钮 + 悬停浮层（best-quote-count / best-quote-layer） ===== -->
            <!-- 笔数按钮：20×18，等宽粗体，>1 笔才显示（Visiability 由 MoreThanOneToVis 控制） -->
            <Style x:Key="StcBestCountButton" TargetType="ToggleButton">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Background" Value="#21262D" />
                <Setter Property="BorderBrush" Value="#4B5563" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBgBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 浮层表头 / 单元格 -->
            <Style x:Key="BestQuoteLayerHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                <Setter Property="Margin" Value="10,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="BestQuoteLayerCell" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Margin" Value="10,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 浮层数据行：可点击（仅本人报价），悬停高亮 -->
            <Style x:Key="BestQuoteLayerRowButton" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBgBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BestQuoteLayerRow" TargetType="Button" BasedOn="{StaticResource BestQuoteLayerRowButton}">
                <Style.Triggers>
                    <!-- 非本人报价：不可点击（原型 best-quote-layer-readonly） -->
                    <DataTrigger Binding="{Binding IsMine}" Value="False">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 浮层 7 列（价格/折算收益率/量/报价机构/报价交易员/长城交易员/报价时间） -->
            <DataTemplate x:Key="BestQuoteLayerDetailRow">
                <Button Style="{StaticResource BestQuoteLayerRow}"
                        Command="{Binding DataContext.LocateBestQuoteCommand,
                                          RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        ToolTip="跳转到全部行情并选中该笔报价">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="bqPrice" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="bqYield" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="bqVol" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="bqInst" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="bqTrader" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="bqOwner" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="bqTime" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Price}" MinWidth="86"
                                   Style="{DynamicResource StcTextMono}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,6" />
                        <TextBlock Grid.Column="1" Text="{Binding Yield, TargetNullValue=—, FallbackValue=—}"
                                   Style="{StaticResource BestQuoteLayerCell}" MinWidth="82" />
                        <TextBlock Grid.Column="2" Text="{Binding Volume, TargetNullValue=—, FallbackValue=—}"
                                   Style="{DynamicResource StcTextMono}" FontSize="12" MinWidth="62"
                                   Foreground="{DynamicResource VolumeBrush}" Margin="10,6" />
                        <TextBlock Grid.Column="3" Text="{Binding Institution, TargetNullValue=--, FallbackValue=--}"
                                   Style="{StaticResource BestQuoteLayerCell}" MinWidth="100"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding Trader, TargetNullValue=--, FallbackValue=--}"
                                   Style="{StaticResource BestQuoteLayerCell}" MinWidth="86"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{Binding OwnerTrader, TargetNullValue=--, FallbackValue=--}"
                                   Style="{StaticResource BestQuoteLayerCell}" MinWidth="86"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="6" Text="{Binding Time, TargetNullValue=--, FallbackValue=--}"
                                   Style="{DynamicResource StcTextMono}" FontSize="12" MinWidth="78"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="10,6" />
                    </Grid>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="BestQuoteLayerBody">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <!-- 表头：sticky 语义在 WPF 里由「表头不参与滚动」近似（浮层高度有限，直接置顶） -->
                    <Border Background="{DynamicResource HoverBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid MinWidth="620">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="bqPrice" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="bqYield" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="bqVol" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="bqInst" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="bqTrader" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="bqOwner" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="bqTime" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="价格" Style="{StaticResource BestQuoteLayerHeader}" MinWidth="86" />
                            <TextBlock Grid.Column="1" Text="折算收益率" Style="{StaticResource BestQuoteLayerHeader}" MinWidth="82" />
                            <TextBlock Grid.Column="2" Text="量" Style="{StaticResource BestQuoteLayerHeader}" MinWidth="62" />
                            <TextBlock Grid.Column="3" Text="报价机构" Style="{StaticResource BestQuoteLayerHeader}" MinWidth="100" />
                            <TextBlock Grid.Column="4" Text="报价交易员" Style="{StaticResource BestQuoteLayerHeader}" MinWidth="86" />
                            <TextBlock Grid.Column="5" Text="长城交易员" Style="{StaticResource BestQuoteLayerHeader}" MinWidth="86" />
                            <TextBlock Grid.Column="6" Text="报价时间" Style="{StaticResource BestQuoteLayerHeader}" MinWidth="78" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource BestQuoteLayerDetailRow}" />
                </StackPanel>
            </DataTemplate>

            <!-- 债券 hover 报价换算 tooltip -->
            <DataTemplate DataType="{x:Type models:BestRow}">
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderStdBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12" MaxWidth="300">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SecurityId}" Style="{DynamicResource StcText}" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding SecurityName}" Style="{DynamicResource StcText}" FontSize="13"
                                       Margin="8,1,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Bid, StringFormat=0.0000}" Style="{DynamicResource StcTextMono}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource BidBrush}" />
                            <TextBlock Text=" / " Style="{DynamicResource StcTextFaint}" />
                            <TextBlock Text="{Binding Ofr, StringFormat=0.0000}" Style="{DynamicResource StcTextMono}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource OfrBrush}" />
                            <TextBlock Text="{Binding VolBid, StringFormat={}Bid {0}万, Mode=OneWay}" Style="{DynamicResource StcTextFaint}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding VolOfr, StringFormat=Ofr {0}万, Mode=OneWay}" Style="{DynamicResource StcTextFaint}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource StcTextFaint}" Margin="0,2,0,0">
                            <Run Text="期限 " /><Run Text="{Binding Maturity, Mode=OneWay}" />
                            <Run Text=" · " /><Run Text="{Binding BondLibrary, Mode=OneWay}" />
                            <Run Text=" · 主体 " /><Run Text="{Binding IssuerRating, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{DynamicResource StcTextFaint}" Margin="0,2,0,0">
                            <Run Text="中债 " /><Run Text="{Binding NzYtm, StringFormat=0.0000, Mode=OneWay}" />
                            <Run Text=" / " /><Run Text="{Binding NzNetPrice, StringFormat=0.0000, Mode=OneWay}" />
                            <Run Text=" · 偏离 " /><Run Text="{Binding NzDeviation, StringFormat=0.00, Mode=OneWay}" />
                            <Run Text=" · 中证 " /><Run Text="{Binding CsYtm, StringFormat=0.0000, Mode=OneWay}" />
                            <Run Text=" / " /><Run Text="{Binding CsNetPrice, StringFormat=0.0000, Mode=OneWay}" />
                        </TextBlock>
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,8" />
                        <TextBlock Text="最优聚合规则：收益率 Bid 越小越优 / Ofr 越大越优（净价全价相反）；"
                                   Style="{DynamicResource StcTextFaint}" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <!-- 行右键菜单见共用字典 BoardRowContextMenu.xaml -->
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BoardMainBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

<!-- 原型 0910：「有 N 条新报价，点击刷新」横幅（公共件，绑定宿主 VM 的 RefreshPendingQuotesCommand/PendingNewQuoteCount） -->
        <components:PendingQuotesBanner Grid.Row="0" />

        <!-- ===== 工具栏（最优页无「未报价债券」） ===== -->
        <Border Grid.Row="1" Style="{DynamicResource StcToolbar}" Padding="20,8">
            <WrapPanel>
                <Button Content="Copy" Style="{DynamicResource StcButton}" Command="{Binding CopyCommand}" Margin="0,0,6,4" />
                <Button Content="Refer" Style="{DynamicResource StcButton}" Command="{Binding ReferCommand}" Margin="0,0,6,4" />
                <Button Content="导出" Style="{DynamicResource StcButton}" Command="{Binding ExportCommand}" Margin="0,0,14,4" />
                <ToggleButton Content="Bid" Style="{DynamicResource StcTagBid}" IsChecked="{Binding ShowBid}" Margin="0,0,6,4" />
                <ToggleButton Content="Ofr" Style="{DynamicResource StcTagOfr}" IsChecked="{Binding ShowOfr}" Margin="0,0,20,4" />
                <CheckBox Content="紧急" Style="{DynamicResource StcCheckBox}" IsChecked="{Binding ShowUrgent}" Margin="0,0,10,4" />
                <CheckBox Content="推荐" Style="{DynamicResource StcCheckBox}" IsChecked="{Binding ShowRecommend}" Margin="0,0,10,4" />
                <CheckBox Content="整量" Style="{DynamicResource StcCheckBox}" IsChecked="{Binding ShowWhole}" Margin="0,0,6,4" />
            </WrapPanel>
        </Border>

        <!-- ===== 22 列 Bid/Ofr 双侧聚合表（原型 min-width 2800，Bid 列橙底/Ofr 列蓝底） ===== -->
        <DataGrid x:Name="Grid" Grid.Row="2" ItemsSource="{Binding Rows}" Style="{DynamicResource StcDataGrid}"
                  MouseDoubleClick="Grid_OnMouseDoubleClick" ContextMenu="{StaticResource BoardRowMenu}"
                  ContextMenuOpening="Grid_OnContextMenuOpening"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  FrozenColumnCount="3" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="剩余期限" Binding="{Binding Maturity}" Width="96" HeaderStyle="{StaticResource StcColumnHeaderLeft}" />
                <DataGridTextColumn Header="代码" Binding="{Binding SecurityId}" Width="132" HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="ToolTip" Value="{Binding}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="简称" Binding="{Binding SecurityName}" Width="190" HeaderStyle="{StaticResource StcColumnHeaderLeft}" ElementStyle="{StaticResource StcTrimText}" CellStyle="{StaticResource StcFrozenEdgeCell}" />
                <DataGridTextColumn Header="报价机构.Bid" Binding="{Binding InstBid}" Width="135" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="长城交易员.Bid" Binding="{Binding TraderBid}" Width="120" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="Vol.Bid" Binding="{Binding VolBid}" Width="100"
                                    HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCellLeft}">
                            <Setter Property="Foreground" Value="{DynamicResource VolumeBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Bid" Width="120" HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BidColBgBrush}" Margin="-8,-3" Padding="8,3">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ToggleButton x:Name="BidCountButton" Content="{Binding BidQuotesCount}"
                                                      Style="{StaticResource StcBestCountButton}"
                                                      Visibility="{Binding BidQuotesCount,
                                                                   Converter={x:Static conv:ConverterLocator.MoreThanOneToVis}}"
                                                      MouseEnter="OnBestCountMouseEnter" />
                                        <TextBlock Text="{Binding Bid, StringFormat=0.0000}" Style="{DynamicResource StcTextMono}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource BidBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- 同档 Bid 报价浮层（原型 best-quote-layer） -->
                                    <Popup x:Name="BidLayer" PlacementTarget="{Binding ElementName=BidCountButton}"
                                           Placement="Bottom" HorizontalOffset="-40" VerticalOffset="4"
                                           IsOpen="{Binding IsChecked, ElementName=BidCountButton, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="{DynamicResource PanelBgBrush}"
                                                BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1"
                                                CornerRadius="6" MaxHeight="330"
                                                MouseLeave="OnBestLayerMouseLeave">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <ContentControl Content="{Binding BidQuotes}"
                                                                ContentTemplate="{StaticResource BestQuoteLayerBody}" />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ofr" Width="120" HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource OfrColBgBrush}" Margin="-8,-3" Padding="8,3">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ToggleButton x:Name="OfrCountButton" Content="{Binding OfrQuotesCount}"
                                                      Style="{StaticResource StcBestCountButton}"
                                                      Visibility="{Binding OfrQuotesCount,
                                                                   Converter={x:Static conv:ConverterLocator.MoreThanOneToVis}}"
                                                      MouseEnter="OnBestCountMouseEnter" />
                                        <TextBlock Text="{Binding Ofr, StringFormat=0.0000}" Style="{DynamicResource StcTextMono}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource OfrBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- 同档 Ofr 报价浮层 -->
                                    <Popup x:Name="OfrLayer" PlacementTarget="{Binding ElementName=OfrCountButton}"
                                           Placement="Bottom" HorizontalOffset="-40" VerticalOffset="4"
                                           IsOpen="{Binding IsChecked, ElementName=OfrCountButton, Mode=TwoWay}"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="{DynamicResource PanelBgBrush}"
                                                BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1"
                                                CornerRadius="6" MaxHeight="330"
                                                MouseLeave="OnBestLayerMouseLeave">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <ContentControl Content="{Binding OfrQuotes}"
                                                                ContentTemplate="{StaticResource BestQuoteLayerBody}" />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Vol.Ofr" Binding="{Binding VolOfr}" Width="100"
                                    HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCellLeft}">
                            <Setter Property="Foreground" Value="{DynamicResource VolumeBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="长城交易员.ofr" Binding="{Binding TraderOfr}" Width="120" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="报价机构.Ofr" Binding="{Binding InstOfr}" Width="135" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="最新成交价" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCellCenter}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="债券库" Binding="{Binding BondLibrary}" Width="100" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="主体评级" Binding="{Binding IssuerRating}" Width="90" ElementStyle="{StaticResource StcTextCellCenter}" />
                <DataGridTextColumn Header="债券评级" Binding="{Binding BondRating}" Width="90" ElementStyle="{StaticResource StcTextCellCenter}" />
                <DataGridTextColumn Header="报价时间" Binding="{Binding UpdateTime, StringFormat=HH:mm:ss}" Width="105">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCellCenter}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

<components:QueryStateOverlay Grid.Row="2" Panel.ZIndex="3"
                    State="{Binding LoadState}" ErrorMessage="{Binding ErrorMessage}" Retry="{Binding RetryCommand}" />
        <components:PaginationBar Grid.Row="3" Margin="20,4"
                                  TotalCount="{Binding TotalCount}"
                                  CurrentPage="{Binding Page, Mode=TwoWay}"
                                  TotalPages="{Binding TotalPages}"
                                  IsLoading="{Binding IsLoading}" />
        <components:StatusBar Grid.Row="4" Sections="{Binding StatusSections}" />
    </Grid>
</UserControl>
