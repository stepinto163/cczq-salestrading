<Window x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.QuoteEntryOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:entry="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteEntry.View"
        Title="报价录入" Width="1970" Height="840"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
        报价录入模块浮窗（原型 0910）：
        - 遮罩 .quote-entry-overlay{inset:0;background:rgba(0,0,0,.68);padding:20px;居中}
        - 外壳 .quote-entry-shell{width:min(1970px,96vw);height:min(840px,92vh);background:#0d1117;border:1px solid #30363d;border-radius:8px}
        - 标题 .quote-entry-header{height:44px;padding:0 16px 0 20px;border-bottom:1px solid #30363d;background:#161b22}
        遮罩用「窗口铺满宿主 + 内部半透明黑 Border」实现（见 OverlayBackdrop），
        外壳尺寸在 OnLoaded 里按宿主尺寸取 96%/92% 并保留 20px 内距。
        承载报价录入整模块（报价确认/精确报价/模糊报价三子页），DataContext 为独立新建的 QuoteViewModel。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- 遮罩：原型 .quote-entry-overlay{background:rgba(0,0,0,.68)}，点击空白处关闭 -->
        <Border Background="#AD000000" MouseLeftButtonDown="OnBackdropMouseDown" />

        <!-- 外壳：原型 .quote-entry-shell（无阴影） -->
        <Border x:Name="Shell" Width="1970" Height="840"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource PageBgBrush}"
                BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏：标题；右 关闭（原型无拖拽，外壳居中固定） -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                        BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,0,0,1"
                        Padding="20,0,16,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="报价录入" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
<Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{DynamicResource StcModalCloseButton}" Click="OnCloseClick" />
                    </Grid>
                </Border>

                <!-- 报价录入模块整页（三子页） -->
                <entry:QuoteView x:Name="ContentView" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
