<UserControl x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.MarketCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Modules.MarketCenter.ViewModel"
             xmlns:views="clr-namespace:STC.SalesTrading.Plugin.Modules.MarketCenter.View"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <Grid Background="{DynamicResource BoardMainBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FilterPanelWidth}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{Binding DetailPanelWidth}" />
        </Grid.ColumnDefinitions>

        <!-- 左：筛选面板（384↔40 可折叠，收起/展开按钮在面板内部） -->
        <views:MarketFilterPanel Grid.Column="0" />

        <!-- 中：子页 tab 条 + 内容（状态栏由各子页视图自带的 StatusBar 提供，避免重复） -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    Padding="20,0,12,0">
                <!-- 子页条 + 右侧 刷新/报价录入（原型 subtabs-board 尾部按钮） -->
                <DockPanel Height="40">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="28" Height="26" Padding="0" Style="{DynamicResource StcButton}"
                                ToolTip="刷新行情数据" Command="{Binding SelectedSubPage.RefreshCommand}"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <Path Data="M23 4 L23 10 L17 10 M1 20 L1 14 L7 14 M3.51 9a9 9 0 0 1 14.85-3.36L23 10 M1 14l4.64 4.36A9 9 0 0 0 20.49 15"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Content="报价录入" Style="{DynamicResource StcButtonPrimary}"
                                Command="{Binding SelectedSubPage.OpenQuoteEntryCommand}"
                                FontSize="12" Height="26" Padding="12,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox Style="{DynamicResource StcSubTabStrip}" Height="40"
                             ItemsSource="{Binding SubTabs}" SelectedItem="{Binding SelectedSubTab}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 子页角标（原型 .subtab .cnt）：报价提醒 = 未读提醒数 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Border Margin="4,0,0,0" Padding="5,1" CornerRadius="8"
                                            Background="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                                            Visibility="{Binding BadgeCount, Converter={x:Static conv:ConverterLocator.IntToVis}}">
                                        <TextBlock Text="{Binding BadgeCount}" Foreground="White"
                                                   FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <!-- 子页内容：看板视图常驻（KeepAliveContentControl 按内容缓存，切换不重建 DataGrid） -->
            <components:KeepAliveContentControl Grid.Row="1" Content="{Binding SelectedSubPage}">
                <components:KeepAliveContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:BoardListViewModel}">
                        <views:BoardListView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardBestViewModel}">
                        <views:BoardBestView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardIntentViewModel}">
                        <views:BoardIntentView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardAlertViewModel}">
                        <views:BoardAlertView />
                    </DataTemplate>
                </components:KeepAliveContentControl.Resources>
            </components:KeepAliveContentControl>
        </Grid>

        <!-- 右：债券详情面板（7 区块，选中行驱动，384↔40 可折叠，收起/展开按钮在面板内部） -->
        <views:BondDetailPanel Grid.Column="2" DataContext="{Binding Detail}" />
    </Grid>
</UserControl>
