<UserControl x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.IntentFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 模糊报价筛选面板（原型 filters-intent，0910 改名） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource StcPanelScrollViewer}">
        <StackPanel x:Name="RootPanel" Margin="12,4,12,16">

            <!-- 仅显示未完整识别 -->
            <ToggleButton Content="仅显示未完整识别" Style="{DynamicResource StcTagNeutral}"
                          Margin="0,0,0,8" />

            <!-- 互斥提示横幅（原型 intent-mutex-banner：金色底/边/字，✕ 可关闭） -->
            <Border x:Name="MutexBanner" Visibility="Collapsed" CornerRadius="4" Padding="6,6"
                    Background="#1AD29922" BorderBrush="#4DD29922" BorderThickness="1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MutexBannerText" Foreground="#FFD29922" FontSize="11" TextWrapping="Wrap" />
                    <Button Content="✕" Margin="6,0,0,0" Padding="4,0" Background="Transparent" BorderThickness="0"
                            Foreground="#FFD29922" FontSize="11" Click="OnMutexBannerClose" />
                </StackPanel>
            </Border>

            <!-- ===== 债券筛选 ===== -->
            <Border Style="{DynamicResource StcFilterSectionDivider}" />
            <TextBlock Text="债券筛选" Style="{DynamicResource StcSectionTitle}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="细分券种" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="国债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="国开" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="农发" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="口行" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="地方债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="短融" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="中票" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="企业债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="公司债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="金融债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="PPN" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="ABS" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="可转债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="NCD" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="其他" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="热门标签" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="商金债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="银行二级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="银行永续" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="政策性次级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="保险次级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="券商债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="保险债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="铁道债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="可质押" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="跨市场" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="城投" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="城投属性" Click="OnMutexTagClick" />
                    <ToggleButton Content="房地产" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="产能过剩" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="公用事业" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="上市公司" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="科创债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="TLAC债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="新上市" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="绿色债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="是否免税" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="免税" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="是否免税" Click="OnMutexTagClick" />
                    <ToggleButton Content="非免税" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="是否免税" Click="OnMutexTagClick" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="地方债类型" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="一般债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="专项债" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="NCD类型" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="国有" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="股份" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="城商" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="农商" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="外资" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="其他" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="剩余期限" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="&lt;3M" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="3-6M" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="6-9M" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="9-12M" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="1-3Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="3-5Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="5-7Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="7-10Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="10-15Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="15-20Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="＞20Y" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="上市状态" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="上市" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="上市状态" Click="OnMutexTagClick" />
                    <ToggleButton Content="非上市" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="上市状态" Click="OnMutexTagClick" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="发行方式" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="公募" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="小公募" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="私募" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>

            <!-- ===== 信用筛选 ===== -->
            <Border Style="{DynamicResource StcFilterSectionDivider}" />
            <TextBlock Text="信用筛选" Style="{DynamicResource StcSectionTitle}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="银行业" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="国有行" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="股份制" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="城商行" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="农商行" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="行业" Style="{DynamicResource StcFilterLabel}" Margin="0,2,3,0" />
                <ComboBox Grid.Column="1" Style="{DynamicResource StcComboBox}" FontSize="11">
                    <ComboBoxItem Content="不限" IsSelected="True" />
                    <ComboBoxItem Content="城投" /><ComboBoxItem Content="房地产" /><ComboBoxItem Content="煤炭" />
                    <ComboBoxItem Content="钢铁" /><ComboBoxItem Content="化工" /><ComboBoxItem Content="建筑" />
                    <ComboBoxItem Content="交运" /><ComboBoxItem Content="公用事业" />
                </ComboBox>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="企业性质" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="央企" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="国企" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="民企" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="其他" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="担保" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="有担保" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="无担保" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="全国性担保" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="地方性担保" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="主体评级" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="AAA" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA-" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="A+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="A" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="中债资信" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="AAA+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AAA" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AAA-" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="评级展望" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="正面" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="稳定" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="观察" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="负面" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="债项评级" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="AAA" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="A-1" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA-" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="中债隐含" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="AAA+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AAA" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AAA-" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="YY评分" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="投资级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="投机级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="风险级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="中证隐含" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="AAA+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AAA" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA+" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="AA2" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>

            <!-- ===== 条款筛选 ===== -->
            <Border Style="{DynamicResource StcFilterSectionDivider}" />
            <TextBlock Text="条款筛选" Style="{DynamicResource StcSectionTitle}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="含权属性" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="不含权" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="含权属性" Click="OnMutexTagClick" />
                    <ToggleButton Content="含权" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="含权属性" Click="OnMutexTagClick" />
                    <ToggleButton Content="赎回权" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="回售权" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="其他权" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="偿还方式" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="到期" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="提前还本" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="付息方式" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="按月" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="按季" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="半年" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="按年" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="其他" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="永续债" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="城投永续" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="永续债" Click="OnMutexTagClick" />
                    <ToggleButton Content="产业永续" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="永续债" Click="OnMutexTagClick" />
                    <ToggleButton Content="金融永续" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="永续债" Click="OnMutexTagClick" />
                    <ToggleButton Content="非永续" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="永续债" Click="OnMutexTagClick" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="次级债" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="次级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="次级债" Click="OnMutexTagClick" />
                    <ToggleButton Content="非次级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="次级债" Click="OnMutexTagClick" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="利率方式" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="SHIBOR" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="DEPO" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="LPR" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="固息" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="发行年份" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="2026" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="2025" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="2024" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="2023" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>

            <!-- ===== 区域筛选 ===== -->
            <Border Style="{DynamicResource StcFilterSectionDivider}" />
            <TextBlock Text="区域筛选" Style="{DynamicResource StcSectionTitle}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="城投属性" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="城投" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="城投属性" Click="OnMutexTagClick" />
                    <ToggleButton Content="非城投" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" Tag="城投属性" Click="OnMutexTagClick" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="重点省份" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="12重点省" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="非12重点省" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="城投层级" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="省级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="市级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="区县级" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="其他" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="地区" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="好地区" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="中部地区" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="弱地区" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                    <ToggleButton Content="差地区" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="全国地区" Style="{DynamicResource StcFilterLabel}" Margin="0,2,3,0" />
                <ComboBox Grid.Column="1" Style="{DynamicResource StcComboBox}" FontSize="11">
                    <ComboBoxItem Content="加载全国省/市/区县..." IsSelected="True" />
                </ComboBox>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="地区等级" Style="{DynamicResource StcFilterLabel}" Margin="0,2,3,0" />
                <ToggleButton Content="待定义" Style="{DynamicResource StcTagNeutral}" Opacity="0.4"
                              IsEnabled="False" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
