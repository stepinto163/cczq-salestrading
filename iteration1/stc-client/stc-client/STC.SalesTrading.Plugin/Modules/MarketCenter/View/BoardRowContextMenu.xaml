<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 菜单左对齐补偿：见下方 ContextMenu 的 HorizontalOffset 说明 -->
    <fcon:RelativeDropHorizontalOffsetConverter x:Key="RdhoConverter" />

    <!--
        行情看板行右键菜单（原型 0910 `#ctxMenu`，全部 / 最优 / 提醒三个看板共用同一套）：
        添加到分组 ▶（子菜单：暂无关注分组 / + 新建分组）
        ─────
        ✚ 新报价 / 🗎 编辑报价 / ↩ Refer
        ─────
        ⬡ 打包 / ◎ OCO      （原型为可切换项：已置标签时 .active，不可管理时 .disabled）
        ─────
        🗎 报价日志

        命令经 PlacementTarget.DataContext 绑定到宿主看板 VM（三个看板 VM 提供同名命令），
        因此本字典可被三个视图共用；行的 DataContext 由各视图的 ContextMenuOpening 注入。

        x:Shared="False"：ContextMenu 会被 ContextMenuService 认领为逻辑子元素，**同一个实例不能挂到
        多个 DataGrid 上**（会报 "already the logical child of another element"）；加此标记后每次
        {StaticResource} 查找都返回新实例，三个看板各用各的。

        图标说明：图标写在 MenuItem.Header 里（**不用** MenuItem.Icon —— 本项目的 StcMenuItem 模板下
        实测不渲染且会把图标列压缩掉）。几何数据按 24×24 空间书写，外面套 14px 的 Viewbox 还原
        原型 `<svg viewBox="0 0 24 24">` 的留白比例，颜色跟随菜单项前景色。

        定位：Placement="MousePoint"，与原型一致（原型 showCtxMenu：菜单左上角对齐鼠标）。
        注意系统若为「菜单左对齐」（SPI_GETMENUDROPALIGNMENT，即
        SystemParameters.MenuDropAlignment == true），WPF 会把弹出菜单**整体左移自身宽度**，
        菜单就跑到鼠标左边去了；这里按项目既有做法用 RelativeDropHorizontalOffsetConverter
        补回一个「菜单自身宽度」的水平偏移抵消掉（用法与 STC.Common 各 ComboBox 的 PART_Popup 一致，
        见 STC.Common/Convertor/RelativeDropHorizontalOffsetConverter.cs：右对齐时该值被转换成 0）。

        补偿值取 MinWidth（= 菜单固定设计宽度，原型实测 184px）而**不是 ActualWidth**：
        ActualWidth 要等 Popup 测量完才有值，首次弹出时读到 0 就补不上（表现为"第一次弹在左边、
        第二次才正常"）。MinWidth 是样式/本地值，弹出前即可用，且菜单内容固定、实际渲染宽度就等于它。
    -->
    <ContextMenu x:Key="BoardRowMenu" x:Shared="False" Style="{DynamicResource StcContextMenu}"
                 MinWidth="184"
                 Placement="MousePoint"
                 HorizontalOffset="{Binding MinWidth, RelativeSource={RelativeSource Self},
                                    Converter={StaticResource RdhoConverter}}">
        <!-- 添加到分组：原型 hover 展开右侧子菜单（该项无图标）。
             子菜单在打开时动态装配（BoardRowGroupMenu.Populate）：关注分组列表 + 分隔线 + 「+ 新建分组」 -->
        <MenuItem Header="添加到分组" Style="{DynamicResource StcMenuItem}" />

        <Separator Style="{DynamicResource StcCtxSeparator}" />

        <MenuItem Style="{DynamicResource StcMenuItem}"
                  Command="{Binding PlacementTarget.DataContext.NewQuoteForRowCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}">
            <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{DynamicResource StcCtxIcon}" Data="M12 5V19 M5 12H19" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="新报价" VerticalAlignment="Center" />
                </StackPanel>
            </MenuItem.Header>
        </MenuItem>

        <MenuItem Style="{DynamicResource StcMenuItem}"
                  Command="{Binding PlacementTarget.DataContext.OpenQuoteEntryForRowCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}">
            <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{DynamicResource StcCtxIcon}"
                                  Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7z M14 2v6h6" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="编辑报价" VerticalAlignment="Center" />
                </StackPanel>
            </MenuItem.Header>
        </MenuItem>

        <MenuItem Style="{DynamicResource StcMenuItem}"
                  Command="{Binding PlacementTarget.DataContext.ReferRowCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}">
            <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{DynamicResource StcCtxIcon}"
                                  Data="M17 1L21 5L17 9 M3 11V9a4 4 0 0 1 4-4h14" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Refer" VerticalAlignment="Center" />
                </StackPanel>
            </MenuItem.Header>
        </MenuItem>

        <Separator Style="{DynamicResource StcCtxSeparator}" />

        <!-- 打包 / OCO：原型按该笔报价的实际标签显示 active；点击直接更新标签（待接） -->
        <MenuItem Style="{DynamicResource StcMenuItem}"
                  IsChecked="{Binding IsPacking, Mode=OneWay}"
                  Command="{Binding PlacementTarget.DataContext.PackRowCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}">
            <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{DynamicResource StcCtxIcon}"
                                  Data="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="打包" VerticalAlignment="Center" />
                </StackPanel>
            </MenuItem.Header>
        </MenuItem>

        <MenuItem Style="{DynamicResource StcMenuItem}"
                  IsChecked="{Binding IsOco, Mode=OneWay}"
                  Command="{Binding PlacementTarget.DataContext.OcoRowCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}">
            <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{DynamicResource StcCtxIcon}"
                                  Data="M4 12a5 5 0 1 0 10 0a5 5 0 1 0 -10 0 M10 12a5 5 0 1 0 10 0a5 5 0 1 0 -10 0" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="OCO" VerticalAlignment="Center" />
                </StackPanel>
            </MenuItem.Header>
        </MenuItem>

        <Separator Style="{DynamicResource StcCtxSeparator}" />

        <MenuItem Style="{DynamicResource StcMenuItem}"
                  Command="{Binding PlacementTarget.DataContext.QuoteLogCommand,
                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding}">
            <MenuItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Style="{DynamicResource StcCtxIcon}"
                                  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="报价日志" VerticalAlignment="Center" />
                </StackPanel>
            </MenuItem.Header>
        </MenuItem>
    </ContextMenu>
</ResourceDictionary>
