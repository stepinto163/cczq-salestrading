<UserControl x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.BoardAlertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="BoardRowContextMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 行右键菜单见共用字典 BoardRowContextMenu.xaml -->
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BoardMainBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏（原型：4 开关） ===== -->
        <Border Grid.Row="0" Style="{DynamicResource StcToolbar}" Padding="20,8">
            <WrapPanel>
                <Button Content="标记已读" Command="{Binding MarkReadCommand}" CommandParameter="{Binding SelectedItems, ElementName=Grid}" Style="{DynamicResource StcButtonGhost}" Margin="0,0,12,4" />
                <CheckBox Content="关注债券" IsEnabled="{Binding CanChangePreferences}" Style="{DynamicResource StcCheckBox}" IsChecked="{Binding ShowFavorite}" Margin="0,0,12,4" />
                <CheckBox Content="筛选分组" IsEnabled="{Binding CanChangePreferences}" Style="{DynamicResource StcCheckBox}" IsChecked="{Binding ShowFilterGroup}" Margin="0,0,12,4" />
                <CheckBox Content="对价提醒" IsEnabled="{Binding CanChangePreferences}" Style="{DynamicResource StcCheckBox}" IsChecked="{Binding ShowPriceMatch}" Margin="0,0,12,4" />
                <CheckBox Content="我的最优报价" IsEnabled="{Binding CanChangePreferences}" Style="{DynamicResource StcCheckBox}" IsChecked="{Binding ShowBestQuote}" Margin="0,0,6,4" />
                <TextBlock Text="{Binding PreferenceError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </WrapPanel>
        </Border>

        <!-- ===== 提醒表（触发摘要、交易方及券级资料） ===== -->
        <DataGrid x:Name="Grid" Grid.Row="1" ItemsSource="{Binding View}" Style="{DynamicResource StcDataGrid}"
                  ContextMenu="{StaticResource BoardRowMenu}" ContextMenuOpening="Grid_OnContextMenuOpening"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  FrozenColumnCount="4" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="提醒类型" Width="110" HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- 首类显示 + 多类型计数；tooltip 展示服务端提醒文案与全量类型（方案 §3.2.4） -->
                            <!-- 原型 alertType 单元格：普通文本（多类型 "/" 连接），不上色；tooltip = 服务端文案 -->
                            <TextBlock Text="{Binding TypesText}" FontSize="12" HorizontalAlignment="Left"
                                       ToolTipService.ShowDuration="8000"
                                       ToolTip="{Binding Content}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="剩余期限" Binding="{Binding Maturity}" Width="96" HeaderStyle="{StaticResource StcColumnHeaderLeft}" />
                <DataGridTextColumn Header="代码" Binding="{Binding SecurityId}" Width="132" HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="简称" Binding="{Binding SecurityName}" Width="190" HeaderStyle="{StaticResource StcColumnHeaderLeft}" ElementStyle="{StaticResource StcTrimText}" CellStyle="{StaticResource StcFrozenEdgeCell}" />
                <DataGridTextColumn Header="报价机构.Bid" Binding="{Binding InstBid}" Width="135" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="报价交易员.Bid" Binding="{Binding ContactBid}" Width="120" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="长城交易员.Bid" Binding="{Binding TraderBid}" Width="120" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="Vol.Bid" Binding="{Binding VolBid}" Width="100"
                                    HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCellLeft}">
                            <Setter Property="Foreground" Value="{DynamicResource VolumeBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Bid" Width="120" HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BidColBgBrush}" Margin="-8,-3" Padding="8,3">
                                <TextBlock Text="{Binding Bid, StringFormat=0.0000}" Style="{DynamicResource StcTextMono}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource BidBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ofr" Width="120" HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource OfrColBgBrush}" Margin="-8,-3" Padding="8,3">
                                <TextBlock Text="{Binding Ofr, StringFormat=0.0000}" Style="{DynamicResource StcTextMono}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource OfrBrush}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Vol.Ofr" Binding="{Binding VolOfr}" Width="100"
                                    HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCellLeft}">
                            <Setter Property="Foreground" Value="{DynamicResource VolumeBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="报价交易员.Ofr" Binding="{Binding ContactOfr}" Width="120" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="长城交易员.Ofr" Binding="{Binding TraderOfr}" Width="120" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="报价机构.Ofr" Binding="{Binding InstOfr}" Width="135" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="最新成交价" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCellCenter}" />
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="债券库" Binding="{Binding BondLibrary}" Width="100" ElementStyle="{StaticResource StcTrimTextCenter}" />
                <DataGridTextColumn Header="主体评级" Binding="{Binding IssuerRating}" Width="90" ElementStyle="{StaticResource StcTextCellCenter}" />
                <DataGridTextColumn Header="债券评级" Binding="{Binding BondRating}" Width="90" ElementStyle="{StaticResource StcTextCellCenter}" />
                <DataGridTextColumn Header="报价时间" Binding="{Binding QuoteTime, StringFormat=HH:mm:ss}" Width="105">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCellCenter}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

<components:QueryStateOverlay Grid.Row="1" Panel.ZIndex="3"
                    State="{Binding LoadState}" ErrorMessage="{Binding ErrorMessage}" Retry="{Binding RetryCommand}" />
        <components:PaginationBar Grid.Row="2" Margin="20,4"
                                  TotalCount="{Binding TotalCount}"
                                  CurrentPage="{Binding Page, Mode=TwoWay}"
                                  TotalPages="{Binding TotalPages}"
                                  IsLoading="{Binding IsLoading}" />
        <components:StatusBar Grid.Row="3" Sections="{Binding StatusSections}" />
    </Grid>
</UserControl>
