<Window x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.FavBondManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关注债券管理" Width="880" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Background="{DynamicResource PageBgBrush}"
        ResizeMode="NoResize" FontFamily="Segoe UI" UseLayoutRounding="True"
        SnapsToDevicePixels="True" PreviewKeyDown="OnWindowPreviewKeyDown">
    <!--
        关注债券管理弹窗（原型 showFavBondModal/_fbmRender）：普通模态窗口（居中于宿主、无遮罩浮层）。
        正文 .fbm-layout{height:480px}：
          左列 260px = 上半分组列表（fbm-group-item：名称(数量)、hover 删除 ✕、双击重命名、active 蓝描边；
                       底部「+ 新建」虚线按钮）+ 下半选中分组的债券列表（代码 简称 + hover ✕）；
          右侧 = 粘贴代码 textarea（150px，清空/识别 按钮在右下）+ 识别结果表
                 （勾选 | 剩余期限 | 债券代码 | 债券简称 | 债券库 | 中债估值；found=false 行 0.4 透明）；
        页脚 = 取消 / 保存（蓝底，同步后端 + 回写会话缓存）。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <!-- 窗口内容：普通弹窗单层结构（无遮罩层） -->
    <Grid>
        <Border Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== 标题栏（padding 8 16 + 关闭点击区 26×26，与 QuoteEntryDialog 同款） ===== -->
                <Border Grid.Row="0" Padding="16,8" Background="Transparent"
                        BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid>
                        <TextBlock x:Name="TitleText" Text="关注债券管理"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="✕" Width="26" Height="26" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{DynamicResource StcModalCloseButton}" Click="OnCloseClick" />
                    </Grid>
                </Border>

                <!-- ===== 正文 .fbm-layout{height:480px}；PreviewMouseWheel 滚轮聚焦列表滚动 ===== -->
                <Grid Grid.Row="1" PreviewMouseWheel="OnPreviewMouseWheel" Height="480">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左列 -->
                    <Grid Grid.Column="0" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,0,1,0" />

                        <!-- 上半：分组列表 + 新建 -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="GroupList" Grid.Row="0" ItemsSource="{Binding Groups}"
                                     SelectedIndex="{Binding SelectedIndex}"
                                     ItemContainerStyle="{StaticResource StcModalGroupItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="OnGroupListDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 名称 (数量)；双击重命名 -->
                                            <TextBlock x:Name="GName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name}" /><Run Text="  (" Foreground="#7D8590" FontSize="10" /><Run Text="{Binding Bonds.Count, Mode=OneWay}" Foreground="#7D8590" FontSize="10" /><Run Text=")" Foreground="#7D8590" FontSize="10" />
                                            </TextBlock>
                                            <!-- 重命名（原型 _fbmRename input maxLength=30；新建才是 10） -->
                                            <TextBox x:Name="GEdit" Visibility="Collapsed" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="30" Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" CaretBrush="White"
                                                     KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" />
                                            <!-- hover 删除 ✕ -->
                                            <Button Grid.Column="1" Content="✕" FontSize="10" Width="16" Height="16"
                                                    Foreground="{DynamicResource TextMutedBrush}" Background="Transparent"
                                                    BorderThickness="0" Cursor="Hand" Margin="6,0,0,0"
                                                    Click="OnDeleteGroupClick" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="GName" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="GEdit" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="1" Margin="8,6">
                                <TextBox x:Name="NewGroupInput" Visibility="Collapsed" MaxLength="10"
                                         Background="Transparent" BorderThickness="0" FontSize="12"
                                         Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="White"
                                         KeyDown="OnNewGroupKeyDown" LostFocus="OnNewGroupLostFocus" />
                                <Button x:Name="NewGroupButton" Content="+ 新建" Style="{StaticResource StcModalDashedButton}"
                                        Click="OnStartNewGroupClick" />
                            </Grid>
                        </Grid>

                        <!-- 下半：选中分组的债券列表（原型空态：「请先选择分组」/「暂无关注债券」） -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding SelectedGroup.Bonds}" Background="Transparent"
                                              ScrollViewer.CanContentScroll="True"
                                              VirtualizingPanel.ScrollUnit="Pixel">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 行底分隔线（原型 border-bottom:1px #21262d） -->
                                            <Border BorderBrush="#21262D" BorderThickness="0,0,0,1">
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="10,6,0,6" VerticalAlignment="Center" FontFamily="Consolas"
                                                               Foreground="#79C0FF" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Code}">
                                                        <Run Text="{Binding Code}" /><Run Text=" " />
                                                        <Run Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Segoe UI" />
                                                    </TextBlock>
                                                    <!-- ✕ 悬停变红（原型 onmouseover） -->
                                                    <TextBlock Grid.Column="1" Text="✕" FontSize="10" Padding="6,2" Margin="0,0,10,0"
                                                               VerticalAlignment="Center" Cursor="Hand"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               MouseLeftButtonDown="OnRemoveBondClick" Tag="{Binding}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground" Value="#F85149" />
                                                                        <Setter Property="Background" Value="#26F85149" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空态（原型 _fbmRender 的两段文案） -->
                                <TextBlock Text="请先选择分组" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="12" Foreground="#484F58">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGroup}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="暂无关注债券" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="12" Foreground="#484F58">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGroup.Bonds.Count, FallbackValue=-1}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 右侧 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 粘贴代码 + 清空/识别 -->
                        <Border Grid.Row="0" Background="{DynamicResource PageBgBrush}"
                                BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="BondInputBox" Height="150" BorderThickness="0" Background="Transparent"
                                     FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}" Padding="12,10,70,10"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Text="{Binding BondInput, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnBondInputKeyDown" />
                            <!-- 占位（原型 textarea::placeholder #484f58）：输入为空时显示 -->
                            <TextBlock Text="粘贴债券代码，多个用空格、逗号或顿号分隔&#x0a;例：252980、240210 188572"
                                       Foreground="#484F58" FontSize="12" Margin="13,10,70,10"
                                       IsHitTestVisible="False" TextWrapping="Wrap" LineHeight="18">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BondInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,12,10">
                                <!-- 原型清空/识别：padding 4px 14px 自适应宽 -->
                                <Button Content="清空" Height="24" FontSize="11" FontWeight="SemiBold" Padding="14,0"
                                        Background="{DynamicResource HoverStrongBgBrush}" Foreground="{DynamicResource TextMutedBrush}"
                                        BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1" Cursor="Hand"
                                        Click="OnClearClick" />
                                <Button x:Name="IdentifyButton" Content="识别" Height="24" FontSize="11" FontWeight="SemiBold" Padding="14,0" Margin="6,0,0,0"
                                        Background="#1A3B82F6" Foreground="#58A6FF"
                                        BorderBrush="#4D3B82F6" BorderThickness="1" Cursor="Hand"
                                        Click="OnIdentifyClick" />
                            </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 识别结果表（原型 .fbm-table：自绘表格，不用 ListView —— 默认表头模板/
                             系统蓝色选中态/白色原生 CheckBox 三样叠加正是上一版"丑"的来源）：
                             th = bg #161b22 / padding 6,8 / 11px 600 #7d8590 / border-bottom #30363d（sticky → 表头在滚动区外）；
                             td = padding 5,8 / border-bottom #21262d / 12px #c9d1d9；
                             tr:hover = #21262d（CSS 里 td 背景盖过行内绿底，hover 触发器放最后同语义）；
                             已加入行 = rgba(63,185,80,.06)；found=false 行 = 整行 0.4 透明；
                             无结果时 12 行 32px 空骨架占位。列宽：固定 36/80/120 + 简称 * 撑满 + 100/100。 -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 表头 -->
                            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}"
                                    BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,0,0,1">
                                <Grid MinHeight="29">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Style="{DynamicResource StcCheckBox}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,6"
                                              ToolTip="全选/全不选（原型 _fbmToggleAll）"
                                              Checked="OnToggleAllChecked" Unchecked="OnToggleAllUnchecked" />
                                    <TextBlock Grid.Column="1" Text="剩余期限" Margin="8,6" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="债券代码" Margin="8,6" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="3" Text="债券简称" Margin="8,6" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="4" Text="债券库" Margin="8,6" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="5" Text="中债估值" Margin="8,6" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </Border>

                            <!-- 表体（与表头同一套列定义） -->
                            <ScrollViewer x:Name="ResultScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Style="{DynamicResource StcPanelScrollViewer}">
                                <Grid>
                                    <ItemsControl x:Name="ResultRows" ItemsSource="{Binding Results}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RowBd" MinHeight="29" Background="Transparent"
                                                        BorderBrush="#21262D" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="100" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" Style="{DynamicResource StcCheckBox}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,5"
                                                                  IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                                  Checked="OnRowCheckChanged" Unchecked="OnRowCheckChanged" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Tenor}" Margin="8,5" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Code}" Margin="8,5" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="#79C0FF" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="8,5" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding BondLib}" Margin="8,5" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Valuation}" Margin="8,5" VerticalAlignment="Center"
                                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Found}" Value="False">
                                                        <Setter TargetName="RowBd" Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="#0F3FB950" />
                                                    </DataTrigger>
                                                    <!-- hover 最后：原型 tr:hover 的 td 背景盖过行内绿底 -->
                                                    <Trigger SourceName="RowBd" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="#21262D" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 空结果骨架：原型画 12 行 32px 空行（行内容由 code-behind 填充） -->
                                    <ItemsControl x:Name="EmptySkeleton" Focusable="False" IsHitTestVisible="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="32" BorderBrush="#21262D" BorderThickness="0,0,0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
    </Grid>

                <!-- ===== 页脚：取消 / 保存 ===== -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{DynamicResource StcModalCancelButton}" Click="OnCancelClick" />
                        <Button Content="保存" Style="{DynamicResource StcModalSaveButton}" Click="OnSaveClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
