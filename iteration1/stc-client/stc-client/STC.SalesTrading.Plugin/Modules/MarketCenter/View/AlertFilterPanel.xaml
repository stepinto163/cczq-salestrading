<UserControl x:Class="STC.SalesTrading.Plugin.Modules.MarketCenter.View.AlertFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 合并筛选面板（原型 filters-merged，报价提醒页使用） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource StcPanelScrollViewer}">
        <StackPanel Margin="12,4,12,16">

                        <!-- 关注债券 / 筛选分组（批次 A）：原型两个独立 .filter-group，chip 由 FilterProfileService 数据驱动
                 （renderMarketGroupTags），title=「名称 · N只债券/N个条件」，点击激活/取消（金底 = 正在按该组过滤看板），
                 「+」打开管理弹窗；弹窗保存 → DataChanged → chip 重建 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="关注债券" Style="{DynamicResource StcFilterLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3,0,0,0">
                    <ItemsControl ItemsSource="{Binding MergedFavChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{DynamicResource StcFilterTagToggle}"
                                              Content="{Binding Name}" ToolTip="{Binding Title}"
                                              IsChecked="{Binding IsActive, Mode=OneWay}"
                                              Command="{Binding ToggleCommand}" Margin="0,0,3,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+" Style="{DynamicResource StcFilterTagAdd}"
                            ToolTip="管理关注债券分组" Click="OnFavBondAddClick" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="筛选分组" Style="{DynamicResource StcFilterLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3,0,0,0">
                    <ItemsControl ItemsSource="{Binding MergedFilterChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{DynamicResource StcFilterTagToggle}"
                                              Content="{Binding Name}" ToolTip="{Binding Title}"
                                              IsChecked="{Binding IsActive, Mode=OneWay}"
                                              Command="{Binding ToggleCommand}" Margin="0,0,3,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+" Style="{DynamicResource StcFilterTagAdd}"
                            ToolTip="管理筛选分组" Click="OnFilterGroupAddClick" />
                </StackPanel>
            </Grid>

<!-- ===== 报价筛选 ===== -->
<components:FilterSectionHeader Title="报价筛选" />
            <components:FilterTagRow Label="清算速度" Items="T+0,T+1,远期,非远期" />
            <!-- 计价方式：见 CreditFilterPanel 注释（修 Grid.Column="1" + 换灰底筛选按钮） -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="计价方式" Style="{DynamicResource StcFilterLabel}" Margin="0,2,3,0" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="收益率" Style="{DynamicResource StcTagNeutral}"
                                      Padding="28,2" FontSize="12" Margin="0,0,6,0" />
                        <ToggleButton Content="净价" Style="{DynamicResource StcTagNeutral}"
                                      Padding="28,2" FontSize="12" Margin="0,0,6,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="筛选" Style="{DynamicResource StcFilterMiniButton}" />
                </Grid>
            </Grid>
            <!-- 原型 .filter-grid：两列、行优先（顺序见 CreditFilterPanel 注释）。
             提醒合并页（filters-merged）的 Bid-Ofr 原型未标记置灰，保持可用 -->
            <UniformGrid Columns="2" Margin="0,0,0,4">
                <components:FilterRangeRow Label="Bid" Unit="%" />
                <components:FilterRangeRow Label="Ofr" Unit="%" />
                <components:FilterRangeRow Label="Bid-中债" Unit="BP" />
                <components:FilterRangeRow Label="中债-Ofr" Unit="BP" />
                <components:FilterRangeRow Label="Bid-Ofr" Unit="BP" />
                <components:FilterRangeRow Label="中债估值" Unit="%" />
                <components:FilterRangeRow Label="中证估值" Unit="%" />
                <components:FilterRangeRow Label="票面利率" Unit="%" />
                <components:FilterRangeRow Label="Vol.Bid" Unit="万" ShowMax="False" />
                <components:FilterRangeRow Label="Vol.Ofr" Unit="万" ShowMax="False" />
            </UniformGrid>

            <!-- ===== 债券筛选 ===== -->
<components:FilterSectionHeader Title="债券筛选" />
            <components:FilterTagRow Label="产品分类" Items="利率债,信用债,NCD" />
            <components:FilterTagRow Label="细分券种" Items="国债,国开,农发,口行,地方债,短融,中票,企业债,公司债,金融债,PPN,ABS,可转债,NCD,其他" />
            <components:FilterTagRow Label="热门标签" Items="商金债,银行二级,银行永续,政策性次级,保险次级,券商债,保险债,铁道债,可质押,跨市场,城投,房地产,产能过剩,公用事业,上市公司,科创债,TLAC债,新上市,不含假期,绿色债" />
            <components:FilterTagRow Label="是否免税" Items="免税,非免税" />
            <components:FilterTagRow Label="地方债类型" Items="一般债,专项债" />
            <!-- 地方债专项（原型 filters-merged：filter-group = label 70px 列 + 右侧全宽下拉；后端未支持，控件置灰） -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="地方债专项" Style="{DynamicResource StcFilterLabel}" Margin="0,2,3,0" />
                <ComboBox Grid.Column="1" Style="{DynamicResource StcComboBox}" FontSize="11" IsEnabled="False"
                          ToolTip="原型标记为 filter-control-unsupported（取值逻辑待确认）">
                    <ComboBoxItem Content="不限" IsSelected="True" />
                    <ComboBoxItem Content="棚改" />
                    <ComboBoxItem Content="土储" />
                    <ComboBoxItem Content="收费公路" />
                    <ComboBoxItem Content="其他" />
                </ComboBox>
            </Grid>
            <!-- 地方债地区（原型 filters-merged，此前漏实现） -->
            <components:FilterTagRow Label="地方债地区" Items="广东,山东,浙江,江苏,更多" />
            <components:FilterTagRow Label="NCD类型" Items="国有,股份,城商,农商,外资,其他" />
            <components:FilterTagRow Label="剩余期限" Items="&lt;3M,3-6M,6-9M,9-12M,1-3Y,3-5Y,5-7Y,7-10Y,10-15Y,15-20Y,＞20Y" />
            <components:FilterSearchRow Label="发行人" Placeholder="搜索发行人..." />
            <components:FilterTagRow Label="发行人类型" Items="央企,国企,民企,其他" />
            <components:FilterTagRow Label="债券上市状态" Items="上市,非上市" />
            <components:FilterTagRow Label="发行方式" Items="公募,小公募,私募" />

            <!-- ===== 流动性筛选 ===== -->
<components:FilterSectionHeader Title="流动性筛选" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="债券流动性" Style="{DynamicResource StcFilterLabel}" />
                <WrapPanel Grid.Column="1" Margin="3,0,0,0">
                    <ToggleButton Content="S" Style="{DynamicResource StcTagNeutral}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,3,3" />
                    <ToggleButton Content="A" Style="{DynamicResource StcTagNeutral}" Foreground="{DynamicResource BidBrush}" Margin="0,0,3,3" />
                    <ToggleButton Content="B" Style="{DynamicResource StcTagNeutral}" Foreground="{DynamicResource OfrBrush}" Margin="0,0,3,3" />
                    <ToggleButton Content="C" Style="{DynamicResource StcTagNeutral}" Foreground="{DynamicResource PurpleDeepBrush}" Margin="0,0,3,3" />
                    <ToggleButton Content="D" Style="{DynamicResource StcTagNeutral}" Foreground="#6B7280" Margin="0,0,3,3" />
                </WrapPanel>
            </Grid>
            <components:FilterTagRow Label="做市标的" Items="上证利率,上证信用,深证利率,深证信用" />
            <components:FilterTagRow Label="上市场所" Items="银行间,上交所,深交所,北交所" />

            <!-- ===== 信用筛选 ===== -->
<components:FilterSectionHeader Title="信用筛选" />
            <components:FilterTagRow Label="银行业" Items="国有行,股份制,城商行,农商行" />
            <components:FilterComboRow Label="行业" Items="不限,城投,房地产,煤炭,钢铁,化工,建筑,交运,公用事业" />
            <components:FilterTagRow Label="企业性质" Items="央企,国企,民企,其他" />
            <components:FilterTagRow Label="担保" Items="有担保,无担保,全国性担保,地方性担保" />
            <components:FilterSearchRow Label="担保人" Placeholder="搜索担保人..." />
            <components:FilterTagRow Label="主体评级" Items="AAA,AA+,AA,AA-,A+,A,更多" />
            <components:FilterTagRow Label="中债资信" Items="AAA+,AAA,AAA-,AA+,更多" />
            <components:FilterTagRow Label="评级展望" Items="正面,稳定,观察,负面" />
            <components:FilterTagRow Label="债项评级" Items="AAA,A-1,AA+,AA,AA-,更多" />
            <components:FilterTagRow Label="中债隐含" Items="AAA+,AAA,AAA-,AA+,更多" />
            <components:FilterTagRow Label="YY评分" Items="投资级,投机级,风险级" />
            <components:FilterTagRow Label="中证隐含" Items="AAA+,AAA,AA+,AA,AA2" />

            <!-- ===== 条款筛选 ===== -->
<components:FilterSectionHeader Title="条款筛选" />
            <components:FilterTagRow Label="含权属性" Items="不含权,含权,赎回权,回售权,其他权" />
            <components:FilterTagRow Label="偿还方式" Items="到期,提前还本" />
            <components:FilterTagRow Label="付息方式" Items="按月,按季,半年,按年,其他" />
            <components:FilterTagRow Label="永续债" Items="城投永续,产业永续,金融永续,非永续" />
            <components:FilterTagRow Label="次级债" Items="次级,非次级" />
            <components:FilterTagRow Label="利率方式" Items="SHIBOR,DEPO,LPR,固息" />
            <components:FilterTagRow Label="发行年份" Items="2026,2025,2024,2023,更多" />

            <!-- ===== 区域筛选 ===== -->
<components:FilterSectionHeader Title="区域筛选" />
            <components:FilterTagRow Label="城投" Items="城投,非城投" />
            <components:FilterTagRow Label="重点省份" Items="12重点省,非12重点省" />
            <components:FilterTagRow Label="城投层级" Items="省级,市级,区县级,其他" />
            <!-- 原型 filters-merged 区域筛选：地区等级（取值逻辑待确认，置灰）→ 地区（省/市/区县级联）→ 省份 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="地区等级" Style="{DynamicResource StcFilterLabel}" Margin="0,2,3,0" />
                <ComboBox Grid.Column="1" Style="{DynamicResource StcComboBox}" FontSize="11"
                          ToolTip="原型标记为 filter-control-unsupported（取值逻辑待确认）">
                    <ComboBoxItem Content="取值逻辑待确认" IsSelected="True" />
                </ComboBox>
            </Grid>
            <components:FilterComboRow Label="地区" Items="加载全国省/市/区县..." />
            <components:FilterComboRow Label="省份" Items="不限,北京市,上海市,广东省,江苏省,浙江省,山东省,四川省,湖北省,湖南省,河南省,河北省,福建省,安徽省,江西省,山西省,陕西省,重庆市,天津市,云南省,贵州省,广西壮族自治区,甘肃省,吉林省,黑龙江省,辽宁省,内蒙古自治区,宁夏回族自治区,青海省,西藏自治区,新疆维吾尔自治区,海南省,深圳市,厦门市,宁波市,青岛市,大连市" RowMargin="0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
