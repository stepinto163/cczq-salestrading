<UserControl x:Class="STC.SalesTrading.Plugin.Modules.QuoteMgmt.View.MgmtFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters"
             xmlns:mc="clr-namespace:STC.SalesTrading.Plugin.Modules.MarketCenter.View">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        报价管理左侧筛选面板（384px，复用原型 filters-merged 即行情中心 merged 面板）：
        顶部清除过滤/搜索 + 合并筛选面板内容 + 右侧细长收起竖条；折叠 40px 只留展开竖条。
    -->
    <Grid Background="{DynamicResource PanelBgBrush}">
        <!-- 展开态 -->
        <Grid Visibility="{Binding IsFilterExpanded, Converter={x:Static conv:ConverterLocator.BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部 sticky：清除过滤 + 搜索 -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="清除过滤" Style="{DynamicResource StcButtonGhost}" FontSize="12" Padding="8,3"
                            Click="OnClearFilters" />
                    <TextBox Grid.Column="1" Margin="10,0,0,0" Style="{DynamicResource StcTextBox}" FontSize="13"
                             ToolTip="搜索债券、机构、交易员、发行人（占位，待接数据过滤）" />
                </Grid>
            </Border>

            <!-- merged 合并筛选面板（复用行情中心） -->
            <mc:AlertFilterPanel Grid.Row="1" />

            <!-- 收起竖条（原型 sidebar-toggle：12×48 细长、贴面板右缘内侧；收起箭头朝右=收起方向） -->
            <Button Grid.RowSpan="2" Width="12" Height="48" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0"
                    Style="{DynamicResource StcSidebarToggle}" Panel.ZIndex="10"
                    ToolTip="收起筛选面板" Command="{Binding ToggleFilterPanelCommand}">
                <Path Data="{StaticResource GeoChevronRight}" Stretch="Uniform"
                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Grid>

        <!-- 折叠态：40px 竖条（仅展开按钮，展开箭头朝左） -->
        <Grid Visibility="{Binding IsFilterExpanded, Converter={x:Static conv:ConverterLocator.BoolToVis}, ConverterParameter=invert}">
            <Button Width="24" Height="48" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{DynamicResource StcSidebarToggleRight}"
                    ToolTip="展开筛选面板" Command="{Binding ToggleFilterPanelCommand}">
                <Path Data="{StaticResource GeoChevronLeft}" Stretch="Uniform"
                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
