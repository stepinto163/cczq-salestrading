<UserControl x:Class="STC.SalesTrading.Plugin.Modules.QuoteMgmt.View.QuoteMgmtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteMgmt.ViewModel"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             xmlns:views="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteMgmt.View">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PageBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FilterPanelWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧筛选栏（复用 filters-merged，384↔40 可折叠） -->
        <views:MgmtFilterPanel Grid.Column="0" />

        <!-- 右主区：子页 tab 条 + 内容 + 状态栏 -->
        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 子页 tab 条 -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="20,0">
            <ListBox Style="{DynamicResource StcSubTabStrip}" Height="40"
                     ItemsSource="{Binding SubTabs}" SelectedItem="{Binding SelectedSubTab}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 内容：今日/历史两子页（KeepAliveContentControl 按内容缓存，切换不重建 22/23 列 DataGrid） -->
        <components:KeepAliveContentControl Grid.Row="1" Content="{Binding SelectedSubPage}" Focusable="False">
            <components:KeepAliveContentControl.Resources>
                <!-- ============ 今日报价 ============ -->
                <DataTemplate DataType="{x:Type vm:MgmtTodayViewModel}">
                    <views:MgmtTodayView />
                </DataTemplate>

                <!-- ============ 历史报价（无「报价状态」列，22 列，日期区间） ============ -->
                <DataTemplate DataType="{x:Type vm:MgmtHistoryViewModel}">
                    <views:MgmtHistoryView />
                </DataTemplate>
            </components:KeepAliveContentControl.Resources>
        </components:KeepAliveContentControl>

        <components:StatusBar Grid.Row="2" Sections="{Binding SelectedSubPage.StatusSections}" />
        </Grid>
    </Grid>
</UserControl>
