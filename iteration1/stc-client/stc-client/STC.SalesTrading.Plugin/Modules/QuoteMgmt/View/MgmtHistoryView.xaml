<UserControl x:Class="STC.SalesTrading.Plugin.Modules.QuoteMgmt.View.MgmtHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteMgmt.ViewModel"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>                <Grid Background="{DynamicResource PageBgBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{DynamicResource StcToolbar}" Padding="20,8">
                        <WrapPanel>
                            <!-- 历史是审计：Unrefer/删除无意义（后端固定拒绝），方案 §3.3.2 移除 -->
                            <Button Content="Copy" Style="{DynamicResource StcButton}" Command="{Binding CopyCommand}" Margin="0,0,6,4" />
                            <Button Content="导出" Style="{DynamicResource StcButton}" Command="{Binding ExportCommand}" Margin="0,0,14,4" />

                            <components:SearchBox Width="180" Placeholder="代码/简称" Margin="0,0,8,4"
                                                 Text="{Binding BondSearchText}" Suggestions="{Binding BondSuggestions}" />
                            <components:SearchBox Width="140" Placeholder="报价机构" Margin="0,0,8,4"
                                                 Text="{Binding InstitutionSearchText}" Suggestions="{Binding InstitutionSuggestions}" />

                            <TextBlock Text="日期" Style="{DynamicResource StcTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding StartDate}" Height="26" />
                            <TextBlock Text="~" Style="{DynamicResource StcTextMuted}" VerticalAlignment="Center" Margin="6,0" />
                            <DatePicker SelectedDate="{Binding EndDate}" Height="26" Margin="0,0,0,4" />
                        </WrapPanel>
                    </Border>

                    <!-- 22 列宽表（无报价状态列） -->
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding View}"
                              Style="{DynamicResource StcDataGrid}" AutoGenerateColumns="False"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                              FrozenColumnCount="2" SelectionChanged="HistoryGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <!-- 报价方式（原型首列 tag：QT / ideal / 手工录入） -->
                            <DataGridTemplateColumn Header="报价方式" Width="76" HeaderStyle="{StaticResource StcColumnHeaderLeft}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1F2730" CornerRadius="3" Padding="6,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                ToolTip="{Binding SourceType}">
                                            <TextBlock Text="{Binding SourceType, Converter={x:Static conv:ConverterLocator.SourceTypeText}}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="剩余期限" Binding="{Binding Maturity}" Width="78" CellStyle="{StaticResource StcFrozenEdgeCell}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="代码" Binding="{Binding SecurityId}" Width="104">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="简称" Binding="{Binding SecurityName}" Width="118">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="52">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{Binding Side, Converter={x:Static conv:ConverterLocator.DirBrush}}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="报价" Binding="{Binding Price, StringFormat=0.0000}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="报量(万)" Binding="{Binding Quantity}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{DynamicResource VolumeBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="操作" Binding="{Binding FlagsText}" Width="84">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Foreground" Value="{DynamicResource BidDeepBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="报价机构" Binding="{Binding InstitutionName}" Width="92">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="报价交易员" Binding="{Binding ContactName}" Width="92">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="长城交易员" Binding="{Binding OwnerUserName}" Width="96">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="最新成交价" Width="86">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="债券库" Binding="{Binding BondLibrary}" Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="主体评级" Binding="{Binding IssuerRating}" Width="76">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="债券评级" Binding="{Binding BondRating}" Width="76">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="报价时间" Binding="{Binding QuoteTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <components:QueryStateOverlay Grid.Row="1" Panel.ZIndex="3"
                                        State="{Binding LoadState}" ErrorMessage="{Binding ErrorMessage}" Retry="{Binding RetryCommand}" />
                </Grid>
</UserControl>
