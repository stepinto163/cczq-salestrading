<UserControl x:Class="STC.SalesTrading.Plugin.Modules.QuoteEntry.View.PreciseQuoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteEntry.ViewModel"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             components:CrmLookup.Directory="{Binding CrmDirectory}"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 输入区 -->
            <RowDefinition Height="Auto" />   <!-- 识别工具行 -->
            <RowDefinition Height="Auto" />   <!-- 批量工具栏 -->
            <RowDefinition Height="Auto" />   <!-- 提交失败详情 -->
            <RowDefinition Height="*" />      <!-- 预览表 -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 输入区（可拖拽高度 100–500px，原型 preciseResizeHandle） ===== -->
        <Border Grid.Row="0" Style="{DynamicResource StcCard}" Padding="0" Margin="12,12,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding InputHeight}" />
                    <RowDefinition Height="6" />
                </Grid.RowDefinitions>
                <TextBox x:Name="InputBox" Grid.Row="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource StcTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                         Height="{Binding InputHeight}" VerticalContentAlignment="Top" Padding="12,10" FontSize="13"
                         PreviewKeyDown="InputBox_OnPreviewKeyDown"
                         ToolTip="Enter 换行 / Ctrl+Enter 识别">
                    <TextBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource StcScrollBar}" />
                    </TextBox.Resources>
                </TextBox>
                <Thumb x:Name="ResizeThumb" Grid.Row="1" Cursor="SizeNS" DragDelta="ResizeThumb_OnDragDelta"
                       HorizontalAlignment="Stretch">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="bd" Background="Transparent">
                                <Border Height="1" Background="{DynamicResource BorderStdBrush}"
                                        VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource TagAccentBgBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <!-- ===== 识别工具行（原型 0910：粘贴/清空/示例/识别后保留文本 + 识别报价；
             截图识别 / 导入图片 / 导入表格 入口按原型隐藏，能力（命令）保留） ===== -->
        <DockPanel Grid.Row="1" Margin="12,6,12,2">
            <Button DockPanel.Dock="Right" Content="识别报价" Style="{DynamicResource StcButtonPrimary}"
                    Command="{Binding IdentifyCommand}" VerticalAlignment="Center" />
            <WrapPanel>
                <Button Content="粘贴" Style="{DynamicResource StcButton}" Command="{Binding PasteCommand}" Margin="0,0,6,0" />
                <!-- 原型 display:none：能力保留，仅隐藏入口 -->
                <Button Content="截图识别" Style="{DynamicResource StcButton}" Command="{Binding DoSystemScreenshotCommand}"
                        Visibility="Collapsed" Margin="0,0,6,0" />
                <Button Content="导入图片" Style="{DynamicResource StcButton}" Command="{Binding ImportImageCommand}"
                        Visibility="Collapsed" Margin="0,0,6,0" />
                <Button Content="导入表格" Style="{DynamicResource StcButton}" Command="{Binding ImportTableCommand}"
                        Visibility="Collapsed" Margin="0,0,6,0" />
                <Button Content="清空" Style="{DynamicResource StcButton}" Command="{Binding ClearInputCommand}" Margin="0,0,6,0" />
                <Button Content="示例" Style="{DynamicResource StcButton}" Command="{Binding FillExampleCommand}" Margin="0,0,10,0" />
                <CheckBox Content="识别后保留文本" Style="{DynamicResource StcCheckBox}" FontSize="11"
                          Foreground="{DynamicResource TextMutedBrush}"
                          IsChecked="{Binding KeepTextAfterParse}" VerticalAlignment="Center" />
            </WrapPanel>
        </DockPanel>

        <!-- ===== 批量工具栏（作用域：精确结果，同报价确认页） ===== -->
        <Border Grid.Row="2" Style="{DynamicResource StcToolbar}" ToolTip="批量编辑仅作用于已勾选的报价，请先勾选下方报价。">
            <WrapPanel>
                <Button Content="确认报价" Style="{DynamicResource StcButtonDanger}"
                        Command="{Binding ConfirmSelectedCommand}" Margin="0,0,6,6" />
                <Button Content="删除" Style="{DynamicResource StcButton}"
                        Command="{Binding DeleteSelectedCommand}" Margin="0,0,20,6" />
                <Button Content="Bid" Style="{DynamicResource StcButtonBid}"
                        Command="{Binding SetDirectionBidCommand}" Margin="0,0,6,6" />
                <Button Content="Ofr" Style="{DynamicResource StcButtonOfr}"
                        Command="{Binding SetDirectionOfrCommand}" Margin="0,0,6,6" />
                <Button Content="+" Style="{DynamicResource StcIconButton}"
                        Command="{Binding AdjustBpUpCommand}" FontSize="14" FontWeight="Bold"
                        Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,6" />
                <Grid Margin="0,0,6,6" Width="86">
                    <TextBox Text="{Binding BpInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource StcTextBox}" TextAlignment="Right"
                             FontFamily="{DynamicResource MonoFont}" Padding="0,0,20,0" />
                    <TextBlock Text="BP" Style="{DynamicResource StcTextFaint}" IsHitTestVisible="False"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
                <Button Content="−" Style="{DynamicResource StcIconButton}"
                        Command="{Binding AdjustBpDownCommand}" FontSize="14" FontWeight="Bold"
                        Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,6" />
                <ComboBox Style="{DynamicResource StcComboBox}" Width="108" Margin="0,0,6,6"
                          ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.PriceTypeOptions}"
                          SelectedItem="{Binding ToolbarPriceType}" />
                <ComboBox Style="{DynamicResource StcComboBox}" Width="80" Margin="0,0,6,6"
                          ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.SettlementOptions}"
                          SelectedItem="{Binding ToolbarSettlement}" />
                <Button Content="+1k" Style="{DynamicResource StcButton}"
                        Command="{Binding AdjustAmountUpCommand}" Margin="0,0,6,6" />
                <Grid Margin="0,0,6,6" Width="86">
                    <TextBox Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource StcTextBox}" TextAlignment="Right"
                             FontFamily="{DynamicResource MonoFont}" Padding="0,0,20,0" />
                    <TextBlock Text="万" Style="{DynamicResource StcTextFaint}" IsHitTestVisible="False"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
                <Button Content="-1k" Style="{DynamicResource StcButton}"
                        Command="{Binding AdjustAmountDownCommand}" Margin="0,0,6,6" />
                <components:CrmLookup Text="{Binding CrmBatch.InstitutionText, UpdateSourceTrigger=PropertyChanged}" Kind="INSTITUTION"
                         InstitutionId="{Binding CrmBatch.InstitutionId}" SelectionCommand="{Binding CrmBatch.SelectInstitutionCommand}"
                         Width="100" Style="{DynamicResource StcTextBox}"
                         ToolTip="输入搜索并选择报价机构" Tag="报价机构" Margin="0,0,6,6" />
                <components:CrmLookup Text="{Binding CrmBatch.ContactText, UpdateSourceTrigger=PropertyChanged}" Kind="CONTACT"
                         InstitutionId="{Binding CrmBatch.InstitutionId}" SelectionCommand="{Binding CrmBatch.SelectContactCommand}"
                         Width="110" Style="{DynamicResource StcTextBox}"
                         ToolTip="输入搜索并选择报价交易员" Tag="报价交易员" Margin="0,0,6,6" />
                <ToggleButton Content="急" Style="{DynamicResource StcToolbarFlagUrgent}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="urgent" />
                <ToggleButton Content="荐" Style="{DynamicResource StcToolbarFlagRecommend}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="rec" />
                <ToggleButton Content="整" Style="{DynamicResource StcToolbarFlagWhole}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="whole" />
                <ToggleButton Content="OCO" Style="{DynamicResource StcToolbarFlagOco}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="oco" />
                <ToggleButton Content="打包" Style="{DynamicResource StcToolbarFlagPacking}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="packing" />
                <TextBlock Style="{DynamicResource StcTextMuted}" VerticalAlignment="Center" Margin="12,0,0,6">
                    <Run Text="已选 " />
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" />
                    <Run Text=" 条" />
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- ===== 识别结果预览表（19 列 = 类型 + 18 列，同报价确认明细） ===== -->
        <Border x:Name="SubmissionErrorPanel" Grid.Row="3" Margin="12,4" Padding="10,8"
                BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SubmissionError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="SubmissionErrorText" Text="{Binding SubmissionError}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" />
            </ScrollViewer>
        </Border>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" Style="{DynamicResource StcDataGrid}"
                  AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="32"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="类型" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RowTypeLabel}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RowTypeLabel}" Value="更新">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RowTypeLabel}" Value="撤销">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="选择" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{DynamicResource StcCheckBox}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="期限" Binding="{Binding Maturity, Mode=OneWay}" Width="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="代码" Binding="{Binding Code, Mode=OneWay}" Width="100" IsReadOnly="True" />
                <DataGridTextColumn Header="简称" Binding="{Binding Name, Mode=OneWay}" Width="112" IsReadOnly="True" />
                <DataGridTemplateColumn Header="方向" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{DynamicResource StcUnderlineComboBox}"
                                      ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.DirectionOptions}"
                                      SelectedItem="{Binding Direction, Mode=TwoWay}"
                                      TextElement.Foreground="{Binding Direction, Converter={x:Static conv:ConverterLocator.DirBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="报价" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{DynamicResource StcFieldTextBox}"
                                     Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Right" FontFamily="{DynamicResource MonoFont}"
                                     FontWeight="SemiBold" Foreground="{DynamicResource BidDeepBrush}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="价格类型" Width="102">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{DynamicResource StcUnderlineComboBox}"
                                      ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.PriceTypeOptions}"
                                      SelectedItem="{Binding PriceType, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="报量(万)" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{DynamicResource StcFieldTextBox}"
                                     Text="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Right" FontFamily="{DynamicResource MonoFont}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="OCO" Style="{DynamicResource StcFlagOco}"
                                              IsChecked="{Binding IsOco, Mode=TwoWay}" Margin="0,0,3,0" />
                                <ToggleButton Content="打包" Style="{DynamicResource StcFlagPacking}"
                                              IsChecked="{Binding IsPacking, Mode=TwoWay}" Margin="0,0,3,0" />
                                <ToggleButton Content="急" Style="{DynamicResource StcFlagUrgent}"
                                              IsChecked="{Binding IsUrgent, Mode=TwoWay}" Margin="0,0,3,0" />
                                <ToggleButton Content="荐" Style="{DynamicResource StcFlagRecommend}"
                                              IsChecked="{Binding IsRec, Mode=TwoWay}" Margin="0,0,3,0" />
                                <ToggleButton Content="整" Style="{DynamicResource StcFlagWhole}"
                                              IsChecked="{Binding IsWhole, Mode=TwoWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="报价机构" Width="112">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <components:CrmLookup Style="{DynamicResource StcFieldTextBox}"
                                     Text="{Binding Institution, UpdateSourceTrigger=PropertyChanged}" Kind="INSTITUTION"
                                     InstitutionId="{Binding InstitutionId}" SelectionCommand="{Binding SelectInstitutionCommand}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="报价交易员" Width="112">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <components:CrmLookup Style="{DynamicResource StcFieldTextBox}"
                                     Text="{Binding Trader, UpdateSourceTrigger=PropertyChanged}" Kind="CONTACT"
                                     InstitutionId="{Binding InstitutionId}" SelectionCommand="{Binding SelectContactCommand}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="交易日期" Width="66">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{DynamicResource StcFieldTextBox}"
                                     Text="{Binding TradeDate, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="清算速度" Width="82">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{DynamicResource StcUnderlineComboBox}"
                                      ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.SettlementOptions}"
                                      SelectedItem="{Binding Settlement, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="中债估值" Binding="{Binding NzValuation, Mode=OneWay}" Width="82" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="中债净价" Binding="{Binding NzNetPrice, Mode=OneWay}" Width="82" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="中债偏离" Binding="{Binding NzDeviation, Mode=OneWay}" Width="72" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="中证(行/到)" Binding="{Binding CsPriceBasis, Mode=OneWay}" Width="84" IsReadOnly="True" />
                <DataGridTemplateColumn Header="文本内容" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TextContent}" Style="{DynamicResource StcTextFaint}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TextContent}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <components:StatusBar Grid.Row="5" Sections="{Binding StatusSections}" />
    </Grid>
</UserControl>
