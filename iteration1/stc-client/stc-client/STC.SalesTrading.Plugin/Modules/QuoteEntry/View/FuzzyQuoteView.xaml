<UserControl x:Class="STC.SalesTrading.Plugin.Modules.QuoteEntry.View.FuzzyQuoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteEntry.ViewModel"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 输入区 -->
            <RowDefinition Height="Auto" />   <!-- 识别工具行 -->
            <RowDefinition Height="*" />      <!-- 左右两栏 -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 输入区（固定 200px） ===== -->
        <Border Grid.Row="0" Style="{DynamicResource StcCard}" Padding="0" Margin="12,12,12,0">
            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource StcTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                     Padding="12,10" FontSize="13" Height="200" VerticalContentAlignment="Top"
                     ToolTip="Enter 识别 / Shift+Enter 换行（原型语义）">
                <TextBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource StcScrollBar}" />
                </TextBox.Resources>
            </TextBox>
        </Border>

        <!-- ===== 识别工具行（左：输入工具；中：批量机构/交易员 + 删除 + 确认；右：识别报价） ===== -->
        <DockPanel Grid.Row="1" Margin="12,6,12,2">
            <Button DockPanel.Dock="Right" Content="识别报价" Style="{DynamicResource StcButtonPrimary}"
                    Command="{Binding IdentifyCommand}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBox Text="{Binding BatchInstitution, UpdateSourceTrigger=LostFocus}"
                         Style="{DynamicResource StcTextBox}" Width="120" Margin="0,0,6,0"
                         ToolTip="报价机构（失焦批量应用）" />
                <TextBox Text="{Binding BatchTrader, UpdateSourceTrigger=LostFocus}"
                         Style="{DynamicResource StcTextBox}" Width="120" Margin="0,0,6,0"
                         ToolTip="报价交易员（失焦批量应用）" />
                <Button Content="删除" Style="{DynamicResource StcButton}" FontSize="12" Padding="8,4"
                        Command="{Binding DeleteSelectedCommand}" Margin="0,0,6,0" />
                <Button Content="确认报价" Style="{DynamicResource StcButtonPrimary}" FontSize="12" Padding="10,4"
                        Command="{Binding ConfirmToIntentCommand}" />
            </StackPanel>
            <WrapPanel>
                <Button Content="粘贴" Style="{DynamicResource StcButton}" Command="{Binding PasteCommand}" Margin="0,0,6,0" />
                <!-- 原型 0910 display:none：能力保留，仅隐藏入口 -->
                <Button Content="截图识别" Style="{DynamicResource StcButton}" Command="{Binding DoSystemScreenshotCommand}"
                        Visibility="Collapsed" Margin="0,0,6,0" />
                <Button Content="导入图片" Style="{DynamicResource StcButton}" Command="{Binding ImportImageCommand}"
                        Visibility="Collapsed" Margin="0,0,6,0" />
                <Button Content="导入表格" Style="{DynamicResource StcButton}" Command="{Binding ImportTableCommand}"
                        Visibility="Collapsed" Margin="0,0,6,0" />
                <Button Content="清空" Style="{DynamicResource StcButton}" Command="{Binding ClearInputCommand}" Margin="0,0,6,0" />
                <Button Content="示例" Style="{DynamicResource StcButton}" Command="{Binding FillExampleCommand}" Margin="0,0,10,0" />
                <CheckBox Content="识别后保留文本" Style="{DynamicResource StcCheckBox}" FontSize="11"
                          Foreground="{DynamicResource TextMutedBrush}"
                          IsChecked="{Binding KeepTextAfterParse}" VerticalAlignment="Center" />
            </WrapPanel>
        </DockPanel>

        <!-- ===== 左右两栏（原型 6:4 + 1px 分隔线） ===== -->
        <Grid Grid.Row="2" Margin="12,6,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- 左：识别结果（☑ | 报价内容 | 识别结果 | 报价机构 | 报价交易员） -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Rows}" Style="{DynamicResource StcDataGrid}"
                      AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="32"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      SelectedItem="{Binding ActiveRow, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="选择" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{DynamicResource StcCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="报价内容" Binding="{Binding Content}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StcTextMono}">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="识别结果" Binding="{Binding ConditionsLabel}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="报价机构" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{DynamicResource StcFieldTextBox}"
                                         Text="{Binding Institution, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="报价交易员" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{DynamicResource StcFieldTextBox}"
                                         Text="{Binding Trader, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Background="{DynamicResource BorderStdBrush}" />

            <!-- 右：候选债券 + 底部分页 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" ItemsSource="{Binding Candidates}" Style="{DynamicResource StcDataGrid}"
                          AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="32"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="剩余期限" Binding="{Binding Maturity}" Width="76" />
                        <DataGridTextColumn Header="债券代码" Binding="{Binding Code}" Width="108">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="债券简称" Binding="{Binding Name}" Width="112" />
                        <DataGridTextColumn Header="债券库" Binding="{Binding BondLibrary}" Width="90" />
                        <DataGridTextColumn Header="中债估值" Binding="{Binding NzValuation}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- 分页条（原型：共N条 | 第x/y页 | 上一页/下一页） -->
                <Border Grid.Row="1" Background="{DynamicResource HeaderBrush}"
                        BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,1,0,0"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{DynamicResource StcTextFaint}" VerticalAlignment="Center">
                            <Run Text="共 " />
                            <Run Text="{Binding CandidateTotal, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" />
                            <Run Text=" 条　" />
                        </TextBlock>
                        <TextBlock Style="{DynamicResource StcTextFaint}" VerticalAlignment="Center">
                            <Run Text="第 " />
                            <Run Text="{Binding CurrentPage, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" />
                            <Run Text="/" />
                            <Run Text="{Binding TotalPages, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" />
                            <Run Text=" 页　" />
                        </TextBlock>
                        <Button Content="上一页" Style="{DynamicResource StcButton}" FontSize="11" Padding="6,2"
                                Command="{Binding PrevPageCommand}" Margin="0,0,6,0" />
                        <Button Content="下一页" Style="{DynamicResource StcButton}" FontSize="11" Padding="6,2"
                                Command="{Binding NextPageCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <components:StatusBar Grid.Row="3" Sections="{Binding StatusSections}" />
    </Grid>
</UserControl>
