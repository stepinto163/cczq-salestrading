<UserControl x:Class="STC.SalesTrading.Plugin.Modules.QuoteEntry.View.QuoteConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteEntry.ViewModel"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             xmlns:services="clr-namespace:STC.SalesTrading.Plugin.Shared.Services"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 批量工具栏（原型：确认/删除/Bid/Ofr/±BP/价格类型/清算/±报量/机构/交易员/5旗标/已选N） ===== -->
        <Border x:Name="BatchToolbar" Grid.Row="0" Style="{DynamicResource StcToolbar}">
            <WrapPanel>
                <Button Content="确认报价" Style="{DynamicResource StcButtonDanger}"
                        Command="{Binding ConfirmSelectedCommand}" Margin="0,0,6,6" />
                <Button Content="删除" Style="{DynamicResource StcButton}"
                        Command="{Binding DeleteSelectedCommand}" Margin="0,0,20,6" />
                <Button Content="Bid" Style="{DynamicResource StcButtonBid}"
                        Command="{Binding SetDirectionBidCommand}" Margin="0,0,6,6" />
                <Button Content="Ofr" Style="{DynamicResource StcButtonOfr}"
                        Command="{Binding SetDirectionOfrCommand}" Margin="0,0,6,6" />
                <Button Content="+" Style="{DynamicResource StcIconButton}"
                        Command="{Binding AdjustBpUpCommand}" FontSize="14" FontWeight="Bold"
                        Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,6" />
                <Grid Margin="0,0,6,6" Width="86">
                    <TextBox Text="{Binding BpInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource StcTextBox}" TextAlignment="Right"
                             FontFamily="{DynamicResource MonoFont}" Padding="0,5,20,5" />
                    <TextBlock Text="BP" Style="{DynamicResource StcTextFaint}" IsHitTestVisible="False"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
                <Button Content="−" Style="{DynamicResource StcIconButton}"
                        Command="{Binding AdjustBpDownCommand}" FontSize="14" FontWeight="Bold"
                        Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,6" />
                <ComboBox Style="{DynamicResource StcComboBox}" Width="108" Margin="0,0,6,6"
                          ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.PriceTypeOptions}"
                          SelectedItem="{Binding ToolbarPriceType}" />
                <ComboBox Style="{DynamicResource StcComboBox}" Width="80" Margin="0,0,6,6"
                          ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.SettlementOptions}"
                          SelectedItem="{Binding ToolbarSettlement}" />
                <Button Content="+1k" Style="{DynamicResource StcButtonGreen}" FontSize="11"
                        Command="{Binding AdjustAmountUpCommand}" Margin="0,0,6,6" />
                <Grid Margin="0,0,6,6" Width="86">
                    <TextBox Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource StcTextBox}" TextAlignment="Right"
                             FontFamily="{DynamicResource MonoFont}" Padding="0,5,20,5" />
                    <TextBlock Text="万" Style="{DynamicResource StcTextFaint}" IsHitTestVisible="False"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
                <Button Content="-1k" Style="{DynamicResource StcButtonRed}" FontSize="11"
                        Command="{Binding AdjustAmountDownCommand}" Margin="0,0,6,6" />
                <!-- 报价机构 / 报价交易员（原型 placeholder="报价机构"/"报价交易员"）：CRM 联想批量应用 -->
                <components:LazySearchComboBox Placeholder="报价机构" Width="100" Margin="0,0,6,6"
                                         SearchCommand="{x:Static services:CrmLazySearch.Institution}"
                                         ColumnMembers="SubText,Name" DisplayMember="SubText" ValueMember="Id"
                                         Text="{Binding InstitutionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectedValue="{Binding InstitutionSelectedId, Mode=TwoWay}" />
                <components:LazySearchComboBox Placeholder="报价交易员" Width="110" Margin="0,0,6,6"
                                         SearchCommand="{x:Static services:CrmLazySearch.Contact}"
                                         SearchParameter="{Binding InstitutionSelectedId}"
                                         ColumnMembers="Name,InstitutionName" DisplayMember="Name" ValueMember="Id"
                                         Text="{Binding TraderInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectionCommand="{Binding SelectContactCommand}" SelectedValue="{Binding TraderSelectedId, Mode=TwoWay}" />
                <ToggleButton Content="急" Style="{DynamicResource StcToolbarFlagUrgent}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="urgent" />
                <ToggleButton Content="荐" Style="{DynamicResource StcToolbarFlagRecommend}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="rec" />
                <ToggleButton Content="整" Style="{DynamicResource StcToolbarFlagWhole}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="whole" />
                <ToggleButton Content="OCO" Style="{DynamicResource StcToolbarFlagOco}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="oco" />
                <ToggleButton Content="打包" Style="{DynamicResource StcToolbarFlagPacking}" Margin="0,0,6,6"
                              Command="{Binding ToggleFlagCommand}" CommandParameter="packing" />
                <TextBlock Style="{DynamicResource StcTextMuted}" VerticalAlignment="Center" Margin="12,0,0,6">
                    <Run Text="已选 " />
                    <Run Text="{Binding SelectedCount, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" />
                    <Run Text=" 条" />
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- ===== 主从表：单一 18 列表头 + 组头通栏行（自定义 Row 模板）+ 明细无表头（RowDetails） ===== -->
        <DataGrid x:Name="MasterGrid" Grid.Row="1" ItemsSource="{Binding Batches}" Style="{DynamicResource StcDataGrid}"
                  AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="36"
                  RowDetailsVisibilityMode="Collapsed" SelectionMode="Single" SelectionUnit="FullRow"
                  Loaded="MasterGrid_OnLoaded"
                  PreviewMouseLeftButtonUp="MasterGrid_OnPreviewMouseLeftButtonUp">
            <!-- 唯一表头：18 列（组头行用自定义 Row 模板通栏显示，不占用这些列） -->
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="45">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox Style="{DynamicResource StcCheckBox}" IsThreeState="True"
                                      ToolTip="全选/取消全选" HorizontalAlignment="Center"
                                      IsChecked="{Binding DataContext.IsSelectAllChecked,
                                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}},
                                                  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="期限" Width="70" />
                <DataGridTextColumn Header="代码" Width="100" />
                <DataGridTextColumn Header="简称" Width="112" />
                <DataGridTextColumn Header="方向" Width="70" />
                <DataGridTextColumn Header="报价" Width="86" />
                <DataGridTextColumn Header="价格类型" Width="102" />
                <DataGridTextColumn Header="报量(万)" Width="86" />
                <DataGridTextColumn Header="操作" Width="190" />
                <DataGridTextColumn Header="报价机构" Width="112" />
                <DataGridTextColumn Header="报价交易员" Width="112" />
                <DataGridTextColumn Header="交易日期" Width="66" />
                <DataGridTextColumn Header="清算速度" Width="82" />
                <DataGridTextColumn Header="中债估值" Width="82" />
                <DataGridTextColumn Header="中债净价" Width="82" />
                <DataGridTextColumn Header="中债偏离" Width="72" />
                <DataGridTextColumn Header="中证(行/到)" Width="84" />
                <DataGridTextColumn Header="文本内容" Width="150" />
            </DataGrid.Columns>

            <!-- 组头行：通栏条（全选/来源徽标/机构/交易员/到报时间/N条·状态）＋ 下方明细 presenter -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource StcRow}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Border Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- 组头条（通栏，横跨所有列） -->
                                        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                                                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                                            <DockPanel Margin="10,0" Height="35">
                                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                           Text="{Binding Summary}" Style="{DynamicResource StcTextFaint}" FontSize="11" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{DynamicResource StcCheckBox}" IsThreeState="True"
                                                              IsChecked="{Binding IsGroupChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Margin="0,0,10,0" />
                                                    <Border x:Name="badge" CornerRadius="3" Padding="8,1" BorderThickness="1"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                                            Background="{DynamicResource TagOfrBgBrush}"
                                                            BorderBrush="{DynamicResource TagOfrBorderBrush}">
                                                        <TextBlock Text="{Binding SourceBadge}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource OfrBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Institution}" Style="{DynamicResource StcText}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                                               FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Trader}" Style="{DynamicResource StcText}"
                                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ReceivedAt}" Style="{DynamicResource StcTextFaint}"
                                                               FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <!-- 明细行（RowDetails，无表头） -->
                                        <DataGridDetailsPresenter Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding SourceType}" Value="qt">
                                        <Setter TargetName="badge" Property="Background" Value="{DynamicResource TagSuccessBgBrush}" />
                                        <Setter TargetName="badge" Property="BorderBrush" Value="{DynamicResource TagSuccessBorderBrush}" />
                                        <Setter TargetName="badge" Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>

            <!-- 明细：18 列行内编辑，无表头（复用主表表头） -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <DataGrid ItemsSource="{Binding Rows}" Style="{DynamicResource StcDataGrid}"
                              AutoGenerateColumns="False" HeadersVisibility="None" RowHeight="32"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              Background="{DynamicResource PageBgBrush}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="选择" Width="42"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource StcCheckBox}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource StcCheckBox}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="期限" Binding="{Binding Maturity, Mode=OneWay}" Width="70" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcText}">
                                        <Setter Property="FontSize" Value="13" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="代码" Binding="{Binding Code, Mode=OneWay}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="简称" Binding="{Binding Name, Mode=OneWay}" Width="112" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="方向" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{DynamicResource StcUnderlineComboBox}"
                                                  ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.DirectionOptions}"
                                                  SelectedItem="{Binding Direction, Mode=TwoWay}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource StcComboBoxItem}" />
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 收起态与下拉选项共用：按方向值着色（Bid=琥珀/Ofr=蓝） -->
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{Binding Converter={x:Static conv:ConverterLocator.DirBrush}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="报价" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource StcFieldTextBox}"
                                                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Right" FontFamily="{DynamicResource MonoFont}"
                                                 FontWeight="SemiBold" Foreground="{DynamicResource BidDeepBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="价格类型" Width="102">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{DynamicResource StcUnderlineComboBox}"
                                                  ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.PriceTypeOptions}"
                                                  SelectedItem="{Binding PriceType, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="报量(万)" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource StcFieldTextBox}"
                                                 Text="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Right" FontFamily="{DynamicResource MonoFont}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Content="OCO" Style="{DynamicResource StcFlagOco}"
                                                          IsChecked="{Binding IsOco, Mode=TwoWay}" Margin="0,0,3,0" />
                                            <ToggleButton Content="打包" Style="{DynamicResource StcFlagPacking}"
                                                          IsChecked="{Binding IsPacking, Mode=TwoWay}" Margin="0,0,3,0" />
                                            <ToggleButton Content="急" Style="{DynamicResource StcFlagUrgent}"
                                                          IsChecked="{Binding IsUrgent, Mode=TwoWay}" Margin="0,0,3,0" />
                                            <ToggleButton Content="荐" Style="{DynamicResource StcFlagRecommend}"
                                                          IsChecked="{Binding IsRec, Mode=TwoWay}" Margin="0,0,3,0" />
                                            <ToggleButton Content="整" Style="{DynamicResource StcFlagWhole}"
                                                          IsChecked="{Binding IsWhole, Mode=TwoWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="报价机构" Width="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <components:LazySearchComboBox Placeholder="机构"
                                            SearchCommand="{x:Static services:CrmLazySearch.Institution}"
                                            ColumnMembers="SubText,Name" DisplayMember="SubText" ValueMember="Id"
                                            Text="{Binding Institution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValue="{Binding InstitutionId, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="报价交易员" Width="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <components:LazySearchComboBox Placeholder="交易员"
                                            SearchCommand="{x:Static services:CrmLazySearch.Contact}"
                                            SearchParameter="{Binding InstitutionId, Mode=OneWay}"
                                            ColumnMembers="Name,InstitutionName" DisplayMember="Name" ValueMember="Id"
                                            Text="{Binding Trader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectionCommand="{Binding SelectContactCommand}"
                                SelectedValue="{Binding ContactId, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="交易日期" Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{DynamicResource StcFieldTextBox}"
                                                 Text="{Binding TradeDate, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="清算速度" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{DynamicResource StcUnderlineComboBox}"
                                                  ItemsSource="{x:Static vm:QuoteConfirmRowViewModel.SettlementOptions}"
                                                  SelectedItem="{Binding Settlement, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="中债估值" Binding="{Binding NzValuation, Mode=OneWay}" Width="82" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="中债净价" Binding="{Binding NzNetPrice, Mode=OneWay}" Width="82" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="中债偏离" Binding="{Binding NzDeviation, Mode=OneWay}" Width="72" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StcNumberCell}">
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="中证(行/到)" Binding="{Binding CsYtm, Mode=OneWay}" Width="84" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="文本内容" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Remark}" Style="{DynamicResource StcTextFaint}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Remark}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <components:StatusBar Grid.Row="2" Sections="{Binding StatusSections}" />
    </Grid>
</UserControl>
