<UserControl x:Class="STC.SalesTrading.Plugin.Modules.QuoteEntry.View.QuoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteEntry.ViewModel"
             xmlns:views="clr-namespace:STC.SalesTrading.Plugin.Modules.QuoteEntry.View"
             xmlns:components="clr-namespace:STC.SalesTrading.Plugin.Shared.Components"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 子页 tab 条（原型 subtabs-quote） -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="20,0">
            <ListBox Style="{DynamicResource StcSubTabStrip}" Height="40"
                     ItemsSource="{Binding SubTabs}" SelectedItem="{Binding SelectedSubTab}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 子页角标（原型 .subtab .cnt）：报价确认 = 待确认报价数 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Border Margin="4,0,0,0" Padding="5,1" CornerRadius="8"
                                    Background="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                                    Visibility="{Binding BadgeCount, Converter={x:Static conv:ConverterLocator.IntToVis}}">
                                <TextBlock Text="{Binding BadgeCount}" Foreground="White"
                                           FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <!-- 子页内容：视图常驻（KeepAliveContentControl 按内容缓存，切换不重建） -->
        <components:KeepAliveContentControl Grid.Row="1" Content="{Binding SelectedSubTab.Target}">
            <components:KeepAliveContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:QuoteConfirmViewModel}">
                    <views:QuoteConfirmView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:PreciseQuoteViewModel}">
                    <views:PreciseQuoteView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:FuzzyQuoteViewModel}">
                    <views:FuzzyQuoteView />
                </DataTemplate>
            </components:KeepAliveContentControl.Resources>
        </components:KeepAliveContentControl>
    </Grid>
</UserControl>
