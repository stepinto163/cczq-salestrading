<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.FilterRangeRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 筛选区间输入行（原型 .filter-grid-item：label 52px + 输入 43px + 「-」+ 输入 43px + 单位）
         · ShowMax=False   → 只渲染「最小」输入框（原型 Vol.Bid / Vol.Ofr 只有最小）
         · IsDisabled=True → 整行置灰不可编辑（原型 .filter-page-unavailable，如 Bid-Ofr） -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,0,7,4">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- 原型 .filter-page-unavailable{opacity:.68} + 输入框 opacity:.48 → 叠加约 0.33 -->
                    <DataTrigger Binding="{Binding IsDisabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Value="True">
                        <Setter Property="Opacity" Value="0.68" />
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 标签：原型 .filter-grid-item .filter-label = 12px / #c9d1d9 / 52px -->
        <TextBlock Grid.Column="0"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <TextBox Grid.Column="1" Width="43" Margin="3,0,0,0" Tag="最小"
                 Style="{DynamicResource StcFilterInput}"
                 Text="{Binding MinText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!-- 分隔符：原型 .filter-sep（11px / #484f58），ShowMax=False 时折叠 -->
        <TextBlock Grid.Column="2" Text="-" Margin="3,0,0,0" FontSize="11"
                   Foreground="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBox Grid.Column="3" Width="43" Margin="3,0,0,0" Tag="最大"
                 Text="{Binding MaxText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource StcFilterInput}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowMax, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <!-- 单位：原型 .filter-unit（11px / #7d8590 / min-width 22px） -->
        <TextBlock Grid.Column="4" Margin="3,0,0,0" MinWidth="22"
                   Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
    </Grid>
</UserControl>
