<Window x:Class="STC.SalesTrading.Plugin.Shared.Components.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="360" SizeToContent="Height" MaxHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="None" Background="{DynamicResource PageBgBrush}"
        ResizeMode="NoResize" FontFamily="Segoe UI" UseLayoutRounding="True"
        SnapsToDevicePixels="True" PreviewKeyDown="OnWindowPreviewKeyDown">
    <!--
        深色二次确认对话框（原型 _fbmConfirm 复刻）：普通模态窗口（无遮罩浮层），
        取消/✕/Esc 返回 false，确认或 Enter 返回 true；确认键红底 #ef4444。
        替代系统 MessageBox——系统白底对话框与深色主题观感割裂。
        用于：关注债券/筛选分组弹窗删除非空分组、筛选分组删除非空子分组。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1">
            <StackPanel>
                <!-- 标题栏（与 QuoteEntryDialog 同款：padding 16,8 + ✕ 26） -->
                <Border Padding="16,8" Background="Transparent"
                        BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid>
                        <TextBlock Text="确认" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="✕" Width="26" Height="26" FontSize="12"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{DynamicResource StcModalCloseButton}" Click="OnCancelClick" />
                    </Grid>
                </Border>

                <!-- 文案：原型 .fbm-confirm-msg 13px #c9d1d9 -->
                <TextBlock x:Name="MessageText" Margin="20,20,20,0" TextWrapping="Wrap"
                           FontSize="13" LineHeight="22"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <!-- 页脚：取消（灰底描边）/ 确认（红底白字） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,20,18">
                    <Button Content="取消" Style="{DynamicResource StcButton}" Height="26"
                            Click="OnCancelClick" />
                    <Button Content="确认" Style="{DynamicResource StcButtonDanger}" Height="26"
                            Padding="14,0" Margin="8,0,0,0" Click="OnConfirmClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
