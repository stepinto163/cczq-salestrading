<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:STC.SalesTrading.Plugin.Shared.Services"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Shared.ViewModel" xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 全局 Toast 承载（原型 toast-container 右侧滑入）。经 ToastService.Show 触发。 -->
    <ItemsControl ItemsSource="{x:Static services:ToastService.Messages}"
                  HorizontalAlignment="Right" IsHitTestVisible="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ToastMessage}">
                <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="8" Padding="14,9"
                        Margin="0,0,0,8"
                        BorderBrush="{Binding Kind, Converter={x:Static conv:ConverterLocator.ToastKindBrush}}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                    </Border.Effect>
                    <TextBlock Text="{Binding Text}" Style="{DynamicResource StcTextSecondary}"
                               MaxWidth="380" TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
