<Window x:Class="STC.SalesTrading.Plugin.Shared.Components.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建分组" Width="360" Height="190"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI" UseLayoutRounding="True"
        SnapsToDevicePixels="True" PreviewKeyDown="OnWindowPreviewKeyDown">
    <!--
        深色名称输入对话框（原型 showNewGroupModal：360px、label 12px #8b949e、
        输入框 placeholder「输入分组名称」、页脚 取消/确定（蓝底 #3b82f6））。
        用于：看板右键「添加到分组 → + 新建分组」（建组并加入当前行债券）。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 确定键：原型内联 style="background:#3b82f6;color:#fff"（hover 深蓝 #2563EB）。
                 不用 StcButton + 本地 Background（本地值会压掉 hover trigger），基于 Base 完整定义 -->
            <Style x:Key="PromptConfirmButton" TargetType="Button" BasedOn="{StaticResource StcButtonBase}">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Background" Value="#FF3B82F6" />
                <Setter Property="Foreground" Value="White" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF2563EB" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- 遮罩：点空白处取消 -->
        <Border Background="#73000000" MouseLeftButtonDown="OnBackdropMouseDown" />

        <Border Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="TitleText" Margin="20,18,20,0" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="分组名称" Margin="20,14,20,6" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBox x:Name="InputBox" Margin="20,0,20,0" Height="30" MaxLength="30"
                         Style="{DynamicResource StcTextBox}" Tag="输入分组名称" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,20,16">
                    <Button Content="取消" Style="{DynamicResource StcButton}" Height="26"
                            Click="OnCancelClick" />
                    <Button x:Name="ConfirmButton" Content="确定" Margin="8,0,0,0"
                            Style="{StaticResource PromptConfirmButton}" Click="OnConfirmClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
