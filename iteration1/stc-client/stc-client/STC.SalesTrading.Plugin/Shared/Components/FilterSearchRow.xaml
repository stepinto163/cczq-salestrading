<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.FilterSearchRow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        筛选面板「标签 + 搜索输入」行（原型 input::placeholder）。
        用法：<components:FilterSearchRow Label="发行人" Placeholder="搜索发行人..." />
    -->
    <Grid Margin="{Binding RowMargin, ElementName=Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{DynamicResource StcFilterLabel}" />
        <TextBox Grid.Column="1" Style="{DynamicResource StcTextBox}" FontSize="11"
                 Tag="{Binding Placeholder, ElementName=Root}" Margin="3,0,0,0" />
    </Grid>
</UserControl>
