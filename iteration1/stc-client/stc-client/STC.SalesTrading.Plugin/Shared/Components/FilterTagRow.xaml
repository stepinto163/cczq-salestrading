<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.FilterTagRow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        筛选面板「标签 + 静态 chip 组」行（原型 .filter-group：label 70px 列 + WrapPanel tags）。
        此前 Credit/Rate/Alert 三面板各手写 12 行 Grid + ToggleButton，共 60+ 行同构。
        用法：<components:FilterTagRow Label="细分券种" Items="短融,中票,企业债" />
        末行免底距：RowMargin="0"（默认 "0,0,0,8" 与原手写行一致）。
    -->
    <Grid Margin="{Binding RowMargin, ElementName=Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{DynamicResource StcFilterLabel}" />
        <ItemsControl Grid.Column="1" Margin="3,0,0,0" ItemsSource="{Binding Values, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Content="{Binding}" Style="{DynamicResource StcTagNeutral}" Margin="0,0,3,3" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
