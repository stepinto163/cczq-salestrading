<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Shared.ViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 底部状态栏（原型：panel 底 + 细分隔线，11px 分段文案，Bid/Ofr/同步状态可着色） -->
    <Border Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
            Padding="20,5">
        <ItemsControl ItemsSource="{Binding Sections, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StatusBarSection}">
                    <TextBlock Text="{Binding Text}" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StcTextSmall}">
                                <Setter Property="Foreground" Value="{Binding Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Brush}" Value="{x:Null}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
