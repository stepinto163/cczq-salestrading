<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.PendingQuotesBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <!--
        「有 N 条新报价，点击刷新」横幅（原型 0910；此前 信用全部/信用最优 两视图逐字重复）。
        绑定宿主 DataContext 的 RefreshPendingQuotesCommand / PendingNewQuoteCount（两个看板 VM 同名）。
        用法：<components:PendingQuotesBanner Grid.Row="0" />
    -->
    <Button Height="30" Padding="0" BorderThickness="0,0,0,1"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            FontSize="12" Cursor="Hand"
            Background="#2D2100" BorderBrush="#7C5A00" Foreground="#FBBF24"
            Command="{Binding RefreshPendingQuotesCommand}"
            Visibility="{Binding PendingNewQuoteCount, Converter={x:Static conv:ConverterLocator.IntToVis}}">
        <TextBlock>
            <Run Text="有 " /><Run Text="{Binding PendingNewQuoteCount, Mode=OneWay}" /><Run Text=" 条新报价，点击刷新" />
        </TextBlock>
    </Button>
</UserControl>
