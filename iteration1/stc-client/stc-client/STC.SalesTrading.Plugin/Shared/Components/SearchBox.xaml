<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        搜索联想组件：输入即过滤 Suggestions、弹出候选浮层、↑↓ 循环 / Enter 选中 / Esc 关闭。
        原型多处使用（报价机构/交易员联想、报价管理三搜索框、筛选侧栏搜索），组件化复用。
    -->
    <Grid>
        <TextBox x:Name="PART_TextBox" Style="{DynamicResource StcTextBox}"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock x:Name="PART_Watermark"
                   Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{DynamicResource StcTextFaint}"
                   Foreground="{DynamicResource TextDisabledBrush}" Margin="9,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False" />
        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderStdBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                    MinWidth="{Binding ActualWidth, ElementName=PART_TextBox}" MaxHeight="240">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource StcScrollBar}" />
                    </ScrollViewer.Resources>
                    <ListBox x:Name="PART_List" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedBgBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
