<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.CrmSearchBox"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        CRM 下拉联想选择框（方案 §4.0.1）：输入防抖 300ms 联想 → 选中同时回填 Id + 标准名称；
        清空/手改输入即清 Id（后端 confirm 只认 CRM 内部 Id，UNRESOLVED_COUNTERPARTY 前置拦截）。
        用法：
          <components:CrmSearchBox Kind="INSTITUTION"
              Text="{Binding Institution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              SelectedId="{Binding Row.InstitutionId, Mode=TwoWay}" />
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="InputBox" Style="{DynamicResource StcTextBox}"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Tag="{Binding Placeholder, ElementName=Root}"
                 Padding="10,0,6,0"
                 KeyDown="OnInputKeyDown" />
        <Button x:Name="ClearButton" Grid.Column="1" Content="✕" Width="18" Height="18"
                Margin="2,0,0,0" FontSize="10" Cursor="Hand" Click="OnClearClick" ToolTip="清空">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#F85149" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=InputBox}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4"
                    MaxHeight="220" MinWidth="{Binding ActualWidth, ElementName=InputBox}" Margin="0,2,8,0">
                <ListBox x:Name="CandidateList" ItemsSource="{Binding Candidates, ElementName=Root}"
                         Background="Transparent" BorderThickness="0"
                         PreviewMouseLeftButtonUp="OnCandidateClicked">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding Name}" Foreground="#E6EDF3" FontSize="12" />
                                <TextBlock Text="{Binding ShortName}" Foreground="#8B949E" FontSize="11" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding PositionName}" Foreground="#8B949E" FontSize="11" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
