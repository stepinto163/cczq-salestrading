<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.FilterSectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 筛选面板分区标题（原型 .filter-section-divider + .section-title，原三面板 17 处两行重复）。
         用法：<components:FilterSectionHeader Title="报价筛选" /> -->
    <StackPanel>
        <Border Style="{DynamicResource StcFilterSectionDivider}" />
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{DynamicResource StcSectionTitle}" />
    </StackPanel>
</UserControl>
