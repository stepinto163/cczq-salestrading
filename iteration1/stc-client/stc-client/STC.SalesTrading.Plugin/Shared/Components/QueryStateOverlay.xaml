<UserControl x:Class="STC.SalesTrading.Plugin.Shared.Components.QueryStateOverlay"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters">
    <!--
        查询加载/失败覆盖层（此前在 4 个看板 + 2 个管理列表逐字重复的块，各站绑定名一致）：
        Loading = #CC0D1117 半透明底 + 「正在加载...」；Error = 「查询失败」+ 错误信息 + 重试按钮。
        用法（挂在与 DataGrid 同一 Grid 单元、置于其上层）：
        <components:QueryStateOverlay Grid.Row="2" Panel.ZIndex="3"
            State="{Binding LoadState}" ErrorMessage="{Binding ErrorMessage}" Retry="{Binding RetryCommand}" />
    -->
    <Grid>
        <Border Background="#CC0D1117"
                Visibility="{Binding State, ElementName=Root, Converter={x:Static conv:ConverterLocator.KeyToVis}, ConverterParameter=Loading}">
            <TextBlock Text="正在加载..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding State, ElementName=Root, Converter={x:Static conv:ConverterLocator.KeyToVis}, ConverterParameter=Error}">
            <TextBlock Text="查询失败" HorizontalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock Text="{Binding ErrorMessage, ElementName=Root}" Margin="0,4,0,8" MaxWidth="420" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="重试" Command="{Binding Retry, ElementName=Root}" Style="{DynamicResource StcButtonPrimary}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
