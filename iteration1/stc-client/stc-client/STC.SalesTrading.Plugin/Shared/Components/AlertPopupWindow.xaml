<Window x:Class="STC.SalesTrading.Plugin.Shared.Components.AlertPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:STC.SalesTrading.Plugin.Shared.Services"
        xmlns:vm="clr-namespace:STC.SalesTrading.Plugin.Shared.ViewModel"
        xmlns:conv="clr-namespace:STC.SalesTrading.Plugin.Shared.Converters"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" FontFamily="Segoe UI">
    <!--
        报价提醒右下角弹窗（独立无边框窗口，定位在鼠标所在屏幕的工作区右下角，不局限于插件窗口）。
        队列空时由 AlertPopupService 自动隐藏。
        原型 0910 结构：按提醒类型分组；头部 = 类型徽标 + (新增数量) + 查看/关闭；正文最多 3 条；
        条目两行 = 债券代码/简称/时间 + Bid 侧(方向·交易员·量·价格) VS [价格类型] Ofr 侧(价格·量·交易员·方向)。
        原型关键样式：.alert-popup-wrap{flex-direction:column;gap:10px}  .alert-popup{border-radius:8px; box-shadow}。
        群里说"看起来像多个窗口一样、要不要多个透明窗口"——其实本窗本身就是透明独立窗口；
        要实现多卡片观感，把每组分模板本身的 Border 升级为带阴影/圆角的卡片 + 10px 下边距即可（无需 N 个窗口）。
        独立 Window 不继承宿主皮肤，必须自合并主题字典，否则 PanelBgBrush 等 DynamicResource
        解析失败 → 内层 Border 背景透明，弹窗看起来"全透明"（实机反馈过的 bug）。
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.SalesTrading.Plugin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AlertBtnBase" TargetType="Button">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 弹窗内的单条提醒（原型 alert-item） -->
            <DataTemplate x:Key="AlertItemTemplate" DataType="{x:Type vm:AlertPopupItem}">
                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="2,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Code}" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="11"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Bid" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BidBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BidTrader}" FontSize="12" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BidVolume}" FontSize="12" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource VolumeBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BidPrice}" FontSize="12" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BidBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="VS" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" Padding="4,0" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource HoverBgBrush}"
                                    BorderBrush="{DynamicResource BorderStdBrush}" BorderThickness="1"
                                    Visibility="{Binding PriceTypeMark,
                                                 Converter={x:Static conv:ConverterLocator.NullToCollapsed}}">
                                <TextBlock Text="{Binding PriceTypeMark}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding OfrPrice}" FontSize="12" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource MonoFont}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OfrBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OfrVolume}" FontSize="12" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource VolumeBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OfrTrader}" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Ofr" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                                       Foreground="{DynamicResource OfrBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- 一个提醒类型 = 一个独立卡片（原型 .alert-popup：background #161b22 / border 1px #30363d / border-radius 8px / box-shadow 0 8px 24px rgba(0,0,0,.6)）。
         分组间隔由 StackPanel 容器统一给 10px（对应 .alert-popup-wrap{gap:10px}）。
         软化投影让多卡堆叠不沉闷：blur 24 / depth 4 / opacity 0.55。 -->
            <DataTemplate x:Key="AlertGroupTemplate" DataType="{x:Type vm:AlertPopupGroup}">
                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderStdBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Left" CornerRadius="3" Padding="6,1" BorderThickness="1"
                                    Background="{DynamicResource PanelBgBrush}"
                                    BorderBrush="{Binding AlertType,
                                                  Converter={x:Static conv:ConverterLocator.AlertTypeBrush}}">
                                <TextBlock Text="{Binding HeaderText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding AlertType,
                                                       Converter={x:Static conv:ConverterLocator.AlertTypeBrush}}" />
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- 原型：查看 = 标记该弹窗 alertKey 已读并跳转定位；关闭 = 只关 UI 不标已读 -->
                                <Button Content="查看" Style="{StaticResource AlertBtnBase}"
                                        Background="{DynamicResource TagAccentBgBrush}"
                                        BorderBrush="{DynamicResource TagAccentBorderBrush}"
                                        Foreground="{DynamicResource AccentBrush}"
                                        Click="OnGroupViewClick" Margin="0,0,6,0" />
                                <Button Content="关闭" Style="{StaticResource AlertBtnBase}"
                                        Background="{DynamicResource HoverBgBrush}"
                                        BorderBrush="{DynamicResource BorderStdBrush}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Click="OnGroupCloseClick" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource AlertItemTemplate}"
                                      Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <!-- 原型 alert-popup-wrap：垂直方向、gap 10px；最外层用 StackPanel + ItemContainerStyle Margin 实现卡片间距 -->
    <StackPanel Margin="12">
        <StackPanel.Resources>
            <Style TargetType="ContentPresenter">
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
        </StackPanel.Resources>
        <ItemsControl ItemsSource="{x:Static services:AlertPopupService.Groups}"
                      ItemTemplate="{StaticResource AlertGroupTemplate}" Width="400" />
    </StackPanel>
</Window>
