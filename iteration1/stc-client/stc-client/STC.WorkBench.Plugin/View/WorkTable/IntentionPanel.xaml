                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.Zero.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.One.ColorBrush}"/>
                    </Trigger>
                </Style.Triggers>-->
            </Style>

            <Style x:Key="CardDataGrid" TargetType="DataGrid">
                <!--<Setter Property="CanUserSortColumns" Value="False"/>-->
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="Cell"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <!-- 不需要虚拟模式 -->
                <!--<Setter Property="EnableRowVirtualization" Value="False"/>-->
                <!-- 不需要边框 -->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="VirtualizingPanel.IsContainerVirtualizable" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
                <Setter Property="BorderBrush" Value="{StaticResource DataGridColumnHeaderBorderBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="AlternationCount" Value="0"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            </Style>

            <!--Bid Setter-->
            <DataTemplate x:Key="Bid_Source_DataTemplate">
                <Border x:Name="userTag" BorderBrush="{Binding Source,Converter={StaticResource venuesColorConvertor}}" Background="{Binding Source,Converter={StaticResource venuesColorConvertor}}" CornerRadius="2" Width="24" Height="16" ToolTip="{Binding InstitutionName}" Visibility="Visible" Margin="-1,0,-1,0">
                    <TextBlock x:Name="DealerName" Text="{Binding Source,Converter={StaticResource venuesSimpleConvertor}}"
                            Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Thin" FontFamily="Microsoft YaHei"
                            ToolTip="{Binding CustomerSource}"/>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMe}" Value="true">
                        <Setter TargetName="DealerName" Property="Text" Value="我"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <Setter TargetName="DealerName" Property="Foreground" Value="#4A4D4C"/>
                        <Setter TargetName="userTag" Property="Background" Value="#282828"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Ofr Venues-->
            <DataTemplate x:Key="Ofr_Venues_DataTemplate">
                <Border x:Name="userTag" BorderBrush="{Binding Source,Converter={StaticResource venuesColorConvertor}}" Background="{Binding Source,Converter={StaticResource venuesColorConvertor}}" 
                            CornerRadius="2" Width="24" Height="16" ToolTip="{Binding InstitutionName}" Visibility="Visible" Grid.Column="2" Margin="-6,0,0,0">
                    <TextBlock x:Name="DealerName" Text="{Binding Source,Converter={StaticResource venuesSimpleConvertor}}"
                                Foreground="#FFFFFF" FontSize="10" FontWeight="Thin" FontFamily="Microsoft YaHei"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="{Binding CustomerSource}"/>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMe}" Value="true">
                        <Setter TargetName="DealerName" Property="Text" Value="我"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <Setter TargetName="DealerName" Property="Foreground" Value="#4A4D4C"/>
                        <Setter TargetName="userTag" Property="Background" Value="#282828"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="TotalQty_DataTemplate" >
                <Grid>
                    <TextBlock x:Name="TotalQty_TB" Text="{Binding TotalQty}" Foreground="{StaticResource DefaultForegroup.ColorBrush}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="Text" TargetName="TotalQty_TB" Value=""/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <Setter Property="Foreground" TargetName="TotalQty_TB" Value="#788187"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="Bid_SettleType_DataTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="YuanQi" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#0A2420" BorderThickness="0" Margin="0,0,0,0">
                        <TextBlock Text="远" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8" 
                                   ToolTip="{Binding SettlType_yuan, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_tooltip'}"/>
                    </Border>
                    <Border x:Name="T0" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#0A2420" BorderThickness="0" Margin="0,0,0,0">
                        <TextBlock Text="+0" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8"/>
                    </Border>
                    <Border x:Name="whole" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="{DynamicResource TextBox.Focus.Border}" BorderThickness="0" Margin="0,0,0,0">
                        <TextBlock Text="整" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8"/>
                    </Border>
                    <Border x:Name="duo" CornerRadius="2" Width="16" Height="16" Visibility="Collapsed" Background="#0A2420" BorderThickness="0" Margin="0,0,0,0">
                        <TextBlock Text="多" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8"
                                   ToolTip="{Binding SettlType_yuan, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='settletype_tooltip'}"/>
                    </Border>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                        <Setter TargetName="whole" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SettlType,Converter={StaticResource stringContainsConvertor}, ConverterParameter='1'}" Value="true">
                        <Setter TargetName="T0" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding SettlType_yuan, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false"/>
                            <!--<Condition Binding="{Binding Source, Converter={StaticResource IsInnerConvertor}}" Value="false"/>-->
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter TargetName="YuanQi" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <!--+0和远 显示多-->
                            <Condition Binding="{Binding SettlType,Converter={StaticResource stringContainsConvertor}, ConverterParameter='1'}" Value="true"/>
                            <Condition Binding="{Binding SettlType_yuan, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter TargetName="duo" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="T0" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="YuanQi" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="Bid_QuotationList_DataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QtyStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="FontSize" Value="10"></Setter>
            </Style>

            <DataTemplate x:Key="Bid_Qty_DataTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="tbQty" Grid.Column="1"  Text="{Binding Qty, Converter={StaticResource numConvertor}, ConverterParameter=1}" Style="{StaticResource QtyStyle}" ToolTip="{Binding Text}" Margin="-3,4,-6,0" Padding="0,1,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="-2,0,0,0">
                        <Border x:Name="Arrow_Border" Visibility="Collapsed" Width="8">
                            <Polygon x:Name="Arrow" Fill="#136C5E" Points="0,8 0,0 8,0"/>
                        </Border>
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding PartySubName}" Value="ODM">
                        <Setter TargetName="Arrow_Border" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FlagType}" Value="0">
                        <Setter TargetName="Arrow_Border" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FlagType}" Value="1">
                        <Setter TargetName="Arrow_Border" Property="Visibility" Value="Visible"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <Setter TargetName="tbQty" Property="Foreground" Value="#788187"/>
                        <Setter TargetName="tbQty"  Property="FontStyle" Value="Italic" />
                        <Setter TargetName="tbQty"  Property="FontWeight" Value="Light" />
                    </DataTrigger>

                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="BargainFlagStyle" TargetType="Image">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='1'}" Value="true">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_nonfirm_1star_14x14.png"/>
                        <Setter Property="ToolTip" Value="需请示"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BargainFlag, Converter={StaticResource stringContainsConvertor},ConverterParameter='2'}" Value="true">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_nonfirm_2stars_14x14.png"/>
                        <Setter Property="ToolTip" Value="必须请示"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding FirmFlag}" Value="1">
                        <Setter Property="Source" Value="/STC.XBond.Plugin;component/Images/stc_tag_list_shandian_14x14.png"/>
                        <Setter Property="ToolTip" Value="firm"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EnlargeFontSizeElementStyle_Bid" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange_firm}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="FontSize" Value="12"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="#FB943C"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Light" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>



            <Style x:Key="QuotationList_DataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
