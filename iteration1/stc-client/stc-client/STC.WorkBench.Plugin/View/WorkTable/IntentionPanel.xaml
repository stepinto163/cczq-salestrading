            <Style x:Key="EnlargeFontSizeElementStyle_Ofr" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue_firm}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBest}" Value="true">
                        <Setter Property="FontSize" Value="12"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsPermission}" Value="false">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="#009AFF"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Light" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--最优价样式 Bid-->
            <Style x:Key="BestEnlargeFontSizeElementStyle_Bid" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange_firm}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.BidIsPermission}" Value="false">
                        <Setter Property="Foreground" Value="#FB943C"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="Margin" Value="0,6,0,0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriceModel.BestBid}" Value="--">
                        <Setter Property="Foreground" Value="#4A4D4C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!--最优价样式 Ofr-->
            <Style x:Key="BestEnlargeFontSizeElementStyle_Ofr" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue_firm}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceModel.OfrIsPermission}" Value="false">
                        <Setter Property="Foreground" Value="#009AFF"/>
