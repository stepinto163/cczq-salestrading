                    </Border>
                    <Border x:Name="duo" CornerRadius="2"  Width="16" Height="16" Visibility="Collapsed" Background="#0A2420" BorderThickness="0" Margin="-1,0,0,0">
                        <TextBlock Text="多" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFEBC8"
