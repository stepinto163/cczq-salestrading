<comp:WindowBase x:Class="STC.WorkBench.Plugin.View.WorkTable.RefInquiryMessageBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkBench.Plugin.View.WorkTable"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
                 Title="撤销询价" Width="300" Height="180"
                  MaxboxEnable="False" MinboxEnable="False" ResizeMode="NoResize"
                  FocusManager.FocusedElement="{Binding ElementName=btnOK}">
    <comp:WindowBase.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </comp:WindowBase.InputBindings>

    <!--<Viewbox x:Name="RootViewbox" Stretch="None">-->
    <Grid x:Name="RootGrid" Background="{DynamicResource MainBackgroup.ColorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="400"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtMessage" Text="是否给对方发送Ref的QQ消息?" Foreground="#FFFFFF" TextWrapping="Wrap" FontSize="{DynamicResource NormalContentFontSize}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Border Grid.ColumnSpan="2" Grid.Row="2" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0 0 0 0"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnNotSend" Width="60" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}" BorderThickness="0 0 0 0"
                        Click="btnNotSend_Click"  IsDefault="True">不发</Button>
                <Button x:Name="btnSend" Width="60" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}" BorderThickness="0 0 0 0"
                        Click="btnSend_Click"  IsDefault="True">发</Button>
            </StackPanel>

        </Border>
    </Grid>
    <!--</Viewbox>-->
</comp:WindowBase>
