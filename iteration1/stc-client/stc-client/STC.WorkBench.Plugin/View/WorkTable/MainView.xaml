<UserControl x:Class="STC.WorkBench.Plugin.View.WorkTable.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkBench.Plugin.View.WorkTable"
             xmlns:comComponent="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="282"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="400"/>
        </Grid.RowDefinitions>

        <!-- IM请求 -->
        <Border BorderBrush="#282828" Grid.RowSpan="2">
            <local:TradeRequestView/>
        </Border>

        <!-- 需求列表 -->
        <Border Grid.Column="1" Margin="4 0 4 0" BorderBrush="#282828" BorderThickness="1 0 1 1" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Background="#282828">
                    <TextBlock Text="{Binding TotalCount, StringFormat={}需求列表({0})}" Foreground="#FFFFFF"/>
                    <Rectangle Margin="8 0 8 0" Width="1" Height="16" Fill="#3C3C3C"/>
                    <TextBlock Foreground="#A0A0A0" VerticalAlignment="Center">
                        共<Run Text="{Binding TotalCount}" Foreground="#FFFFFF"/>条需求,其中Bid<Run Text="{Binding BidCount}" Foreground="#FFFFFF"/>条,Ofr<Run Text="{Binding BidCount}" Foreground="#FFFFFF"/>条
                    </TextBlock>
                </StackPanel>
                <Button Width="16" Height="16" Margin="0 0 6 0" Style="{StaticResource PopupButton}" HorizontalAlignment="Right"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <comComponent:HoverButton Content="报价识别" Width="80" Height="24" Margin="8,0,0,0" HorizontalAlignment="Left"
                                           Command="{Binding QuoteIdentifyCommand}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource RedButton.Static.Background}"
                                           BorderBrush="{StaticResource RedButton.Static.Border}"
                                           Foreground="{StaticResource RedButton.Static.Foreground}"
                                           PressBackground="{StaticResource RedButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource RedButton.Pressed.Border}"
                                           HoverBackground="{StaticResource RedButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource RedButton.MouseOver.Border}"/>
                    <comComponent:HoverButton Content="全停" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
                    <comComponent:HoverButton Content="结单" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
                    <TextBlock Text="操作:" Margin="12 0 0 0" Width="32" Foreground="#FFFFFF" VerticalAlignment="Center" TextAlignment="Center"/>
                    <comComponent:HoverButton Width="56" Height="24" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                        <WrapPanel Height="12">
                            <Image Source="/STC.WorkBench.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="全部" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                        </WrapPanel>
                    </comComponent:HoverButton>
                    <comComponent:HoverButton Width="56" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                        <WrapPanel Height="12">
                            <Image Source="/STC.WorkBench.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="1000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                        </WrapPanel>
                    </comComponent:HoverButton>
                    <comComponent:HoverButton Width="56" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                        <WrapPanel Height="12">
                            <Image Source="/STC.WorkBench.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="3000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                        </WrapPanel>
                    </comComponent:HoverButton>
                    <comComponent:HoverButton Width="56" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                        <WrapPanel Height="12">
                            <Image Source="/STC.WorkBench.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="5000" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                        </WrapPanel>
                    </comComponent:HoverButton>
                    <comComponent:HoverButton Width="56" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}">
                        <WrapPanel Height="12">
                            <Image Source="/STC.WorkBench.Plugin;component/Images/stc_tag_list_shandian_14x14.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="报价" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                        </WrapPanel>
                    </comComponent:HoverButton>
                    <TextBlock Text="状态:" Margin="8 0 0 0" Width="32" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                    <ComboBox Width="64" Height="24" Style="{StaticResource NonEditableComboBoxStyle}"/>
                    <CheckBox Content="本人" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="#A0A0A0" Padding="4 0 0 0" Style="{StaticResource DefaultCheckBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="16" Height="16" Style="{StaticResource MainPageNoticeLookButton}"/>
                    <Button Margin="8 0 0 0" Width="16" Height="16" Style="{StaticResource FilterButton}"/>
                    <Button Margin="8 0 0 0" Width="16" Height="16" Style="{StaticResource ImageSettingButton}"/>
                    <Button Margin="4 0 4 0" Width="24" Height="24" Style="{StaticResource ExportButton2}"/>
                </StackPanel>
                <DataGrid Grid.Row="2" Style="{StaticResource DefaultDataGrid}" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="选择" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" 
                                                      IsChecked="{Binding DataContext.IsAllChecked_Ignore, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="60" HeaderStyle="{StaticResource DataGridColumnHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="StartStopBtn" BorderThickness="0" Height="18" Width="18" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                        
                                                        Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                        PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown">
                                        </Button>
                                        <Button x:Name="DelBtn"  Height="18" Width="18" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DelOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                        FontSize="10" Style="{StaticResource DetailButton}"
                                                        IsEnabled="{Binding EnabledBtn}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"/>
                                        <Button x:Name="detailBtn" Grid.Column="1" HorizontalAlignment="Right" Width="12" Height="12"  BorderThickness="0" Style="{StaticResource OpenSecurityButton}"
                                        ToolTip="查看行情小窗"
                                        Command="{Binding DataContext.DetailCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="需求ID" MinWidth="92"/>
                        <DataGridTextColumn Header="代码" MinWidth="76"/>
                        <DataGridTextColumn Header="简称" MinWidth="72"/>
                        <DataGridTextColumn Header="方向" MinWidth="52"/>
                        <DataGridTextColumn Header="报价(%)" MinWidth="68"/>
                        <DataGridTextColumn Header="报量(万元)" MinWidth="68"/>
                        <DataGridTextColumn Header="成交量(万元)" MinWidth="76"/>
                        <DataGridTextColumn Header="清算速度" MinWidth="60"/>
                        <DataGridTextColumn Header="经纪人" MinWidth="60"/>
                        <DataGridTextColumn Header="客户机构" MinWidth="60"/>
                        <DataGridTextColumn Header="客户名" MinWidth="60"/>
                        <DataGridTextColumn Header="完成度" MinWidth="52"/>
                        <DataGridTextColumn Header="状态" MinWidth="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <!-- 历史需求列表-->
        <Border Grid.Column="1" Grid.Row="1" Margin="4 2 4 0" BorderBrush="#282828" BorderThickness="1" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Background="#282828">
                    <TextBlock Text="{Binding TotalCount, StringFormat={}历史需求({0})}" Foreground="#FFFFFF"/>
                    <Rectangle Margin="8 0 8 0" Width="1" Height="16" Fill="#3C3C3C"/>
                    <TextBlock Foreground="#A0A0A0" VerticalAlignment="Center">
                        共<Run Text="{Binding TotalCount}" Foreground="#FFFFFF"/>条需求,其中Bid<Run Text="{Binding BidCount}" Foreground="#FFFFFF"/>条,Ofr<Run Text="{Binding BidCount}" Foreground="#FFFFFF"/>条
                    </TextBlock>
                </StackPanel>
                <Button Width="16" Height="16" Margin="0 0 6 0" Style="{StaticResource PopupButton}" HorizontalAlignment="Right"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <comComponent:HoverButton Content="今天" Width="56" Height="24" Margin="8,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource RedButton.Static.Background}"
                                           BorderBrush="{StaticResource RedButton.Static.Border}"
                                           Foreground="{StaticResource RedButton.Static.Foreground}"
                                           PressBackground="{StaticResource RedButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource RedButton.Pressed.Border}"
                                           HoverBackground="{StaticResource RedButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource RedButton.MouseOver.Border}"/>
                    <comComponent:HoverButton Content="近1周" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
                    <comComponent:HoverButton Content="近1月" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
                    <DatePicker x:Name="dpFrom" Width="100px" Height="20" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" Margin="10,0,0,0" SelectedDateChanged="dpFrom_SelectedDateChanged"/>
                    <TextBlock Text="-" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="Auto" Height="Auto"/>
                    <DatePicker x:Name="dpTo" Width="100px" Height="20" Style="{StaticResource DefaultDatePickerStyle}" VerticalContentAlignment="Center" Margin="5,0,0,0" SelectedDateChanged="dpTo_SelectedDateChanged"/>
                    <TextBlock Text="筛选:" Margin="8 0 0 0" Width="32" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                    <comComponent:HoverButton Content="全部" Width="56" Height="24" Margin="8,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource RedButton.Static.Background}"
                                           BorderBrush="{StaticResource RedButton.Static.Border}"
                                           Foreground="{StaticResource RedButton.Static.Foreground}"
                                           PressBackground="{StaticResource RedButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource RedButton.Pressed.Border}"
                                           HoverBackground="{StaticResource RedButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource RedButton.MouseOver.Border}"/>
                    <comComponent:HoverButton Content="同客户" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
                    <comComponent:HoverButton Content="同券反向" Width="56" Height="24" Margin="4,0,0,0" HorizontalAlignment="Left"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                            PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
                    <CheckBox Content="本人" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="#A0A0A0" Padding="4 0 0 0" Style="{StaticResource DefaultCheckBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="16" Height="16" Style="{StaticResource MainPageNoticeLookButton}"/>
                    <Button Margin="8 0 0 0" Width="16" Height="16" Style="{StaticResource FilterButton}"/>
                    <Button Margin="8 0 0 0" Width="16" Height="16" Style="{StaticResource HistoryButton}"/>
                    <Button Margin="4 0 4 0" Width="24" Height="24" Style="{StaticResource ExportButton2}"/>
                </StackPanel>
                <DataGrid Grid.Row="2" Style="{StaticResource DefaultDataGrid}" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="选择" CanUserResize="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" 
                                                      IsChecked="{Binding DataContext.IsAllChecked_Ignore, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{StaticResource DefaultCheckBoxStyle}"></CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                       
                        <DataGridTextColumn Header="客户机构" MinWidth="92"/>
                        <DataGridTextColumn Header="时间" MinWidth="76"/>
                        <DataGridTextColumn Header="代码" MinWidth="72"/>
                        <DataGridTextColumn Header="简称" MinWidth="52"/>
                        <DataGridTextColumn Header="方向" MinWidth="68"/>
                        <DataGridTextColumn Header="报价" MinWidth="68"/>
                        <DataGridTextColumn Header="报量(万元)" MinWidth="76"/>
                        <DataGridTextColumn Header="成交价" MinWidth="60"/>
                        <DataGridTextColumn Header="PNL" MinWidth="60"/>
                        <DataGridTextColumn Header="时长" MinWidth="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="2" BorderBrush="#282828" BorderThickness="1 0 1 1">
            <local:IntentionPanel/>
        </Border>

        <Border Grid.Column="2" Grid.Row="1"  Margin="0 2 0 0"  BorderBrush="#282828" BorderThickness="1 0 1 1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Background="#282828">
                    <TextBlock Text="{Binding TotalCount, StringFormat={}历史需求({0})}" Foreground="#FFFFFF"/>
                    <Rectangle Margin="8 0 8 0" Width="1" Height="16" Fill="#3C3C3C"/>
                    <Button Content="+"/>
                    <TextBlock Foreground="#A0A0A0" VerticalAlignment="Center">
                        共<Run Text="{Binding TotalCount}" Foreground="#FFFFFF"/>笔,成交量<Run Text="{Binding BidCount}" Foreground="#FFFFFF"/>kw
                    </TextBlock>
                </StackPanel>
                <Button Width="16" Height="16" Margin="0 0 6 0" Style="{StaticResource PopupButton}" HorizontalAlignment="Right"/>
                <DataGrid Grid.Row="1" Style="{StaticResource DefaultDataGrid}" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PNL" MinWidth="60"/>
                        <DataGridTextColumn Header="成交价" MinWidth="60"/>
                        <DataGridTextColumn Header="成交量" MinWidth="76"/>
                        <DataGridTextColumn Header="渠道" MinWidth="40"/>
                        <DataGridTextColumn Header="时间" MinWidth="76"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
