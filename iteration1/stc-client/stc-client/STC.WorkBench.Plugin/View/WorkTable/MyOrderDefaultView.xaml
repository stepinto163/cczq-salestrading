<UserControl x:Class="STC.WorkBench.Plugin.View.WorkTable.MyOrderDefaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkBench.Plugin.View.WorkTable"
             xmlns:comp ="clr-namespace:STC.WorkBench.Plugin.View.Component"
             xmlns:commonComp ="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:command="clr-namespace:STC.WorkBench.Plugin.Command"
             xmlns:utils="clr-namespace:STC.WorkBench.Plugin.Utils"
             xmlns:conv="clr-namespace:STC.WorkBench.Plugin.Convertor"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200" Initialized="UserControl_Initialized"
             xmlns:Themes="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->

                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <FrameworkElement x:Key="Proxy" DataContext="{Binding}"/>

            <conv:TBookStatusEnumToBoolConvertor x:Key="tBookStatusEnumToBoolConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:NumberConvertor3 x:Key="numConvertor3"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <fcon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <fcon:BooleanConvertor x:Key="booleanConvertor"/>
            <conv:SubStringConverter x:Key="subStringConverter"/>
            <fcon:FormatDateTimeConvertor x:Key="FormatDateTimeConvertor"/>
            <fcon:StringConvertor x:Key="StringConvertor"/>
            <fcon:IntentionStatusConvertor x:Key="intentionStatusConvertor"/>
            <fcon:DaysOffStrConverter x:Key="daysOffStrConverter"/>
            <fcon:VenuesColorConvertor x:Key="venuesColorConvertor"/>
            <fcon:VenuesSimpleConvertor x:Key="venuesSimpleConvertor"/>
            <fcon:InnerBoardColorConvertor x:Key="colorCon"/>
            <fcon:EmptyColorConvertor x:Key="emptyColorCon"/>
            <fcon:RadioButtonConverter x:Key="radioBtnConverter"/>
            <fcon:GreaterThanZeroConverter x:Key="greaterThanZeroConverter"/>
            <fcon:StrContainsConvertor x:Key="strContainsConvertor"/>
            <fcon:MultiAndConverter x:Key="multiAndConverter"/>
            <fcon:ReverseBooleanConvertor x:Key="reverseBooleanConvertor"/>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#A0A0A0"/>
            </Style>
            
            <Style x:Key="SideTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Side}" Value="3">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Side}" Value="4">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <!-- 搜索文本框 -->
            <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>

                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--内部看板-->
            <Style x:Key="TagGroupListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.Static.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.Static.Foreground}"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="4 0 0 4"/>
                <Setter Property="Padding" Value="10,0,10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="1" VerticalAlignment="Center" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}">
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource DefaultContextMenu}">
                                        <MenuItem x:Name="TagGroupMenu" Header="{Binding IfSubscribe, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='ifsubscribe_menu'}" Style="{StaticResource DefaultMenuItem}" Click="TagGroupMenu_Click"/>
                                        <MenuItem x:Name="EditGroupMenu" Header="编辑" Style="{DynamicResource DefaultMenuItem}" Click="EditGroupMenu_Click"/>
                                        <MenuItem x:Name="DelGroupMenu" Header="删除" Style="{DynamicResource DefaultMenuItem}" Click="DelGroupMenu_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="svg_path" Style="{DynamicResource subscrib_path}" Visibility="{Binding IfSubscribe, Converter={StaticResource visibilityConvertor}}" Margin="0 0 4 0"/>
                                    <!--<Image x:Name="subscribeImage" Source="/STC.Common;component/Images/订阅.png" Width="24" Height="24" Visibility="{Binding IfSubscribe, Converter={StaticResource visibilityConvertor}}"/>-->
                                    <ContentPresenter Grid.Column="1" x:Name="Cp" TextElement.FontSize="{TemplateBinding FontSize}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscribeImage" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ListBoxItemTag.MouseOver.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ListBoxItemTag.MouseOver.Foreground}"/>
                                    <Setter TargetName="svg_path" Property="Fill" Value="{DynamicResource SvgButton.MouseOver.Foreground}"/>
                                    <!--<Setter TargetName="subscribeImage" Property="Source" Value="/STC.Common;component/Images/订阅选中.png"/>-->
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="FuzzyColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SecurityId}" Value="99999">
                        <Setter Property="Foreground" Value="#FFDA9A" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Storyboard x:Key="MoveStoryboard">
                <DoubleAnimation Storyboard.TargetName="FilterPopup"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                             From="0" To="200" Duration="0:0:2" />
            </Storyboard>
            <SolidColorBrush x:Key="Menu.Static.Background" Color="#FFF0F0F0"/>
            <SolidColorBrush x:Key="Menu.Static.Border" Color="#FF999999"/>
            <SolidColorBrush x:Key="Menu.Static.Separator" Color="#FFD7D7D7"/>
            <Style x:Key="customeMenuItemStyle" TargetType="{x:Type MenuItem}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="{DynamicResource BlueGreenButton.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BlueGreenButton.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource BlueGreenButton.Static.Foreground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="1"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Grid>
                                <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                    <!--<ContentPresenter x:Name="contentPresenter" Focusable="False" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>-->
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}" PlacementTarget="{Binding ElementName=border}">
                                    <ScrollViewer x:Name="SubMenuScrollViewer" Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                        <Grid RenderOptions.ClearTypeHint="Enabled" Background="{DynamicResource BlueGreenButton.Static.Background}">
                                            <!--<Canvas HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                    <Rectangle x:Name="OpaqueRect" Fill="{Binding Background, ElementName=SubMenuBorder}" Height="{Binding ActualHeight, ElementName=SubMenuBorder}" Width="{Binding ActualWidth, ElementName=SubMenuBorder}"/>
                                                </Canvas>
                                                <Rectangle Fill="{StaticResource Menu.Static.Separator}" HorizontalAlignment="Left" Margin="29,2,0,2" Width="1"/>-->
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="true" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" KeyboardNavigation.TabNavigation="Cycle"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource BlueGreenButton.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource BlueGreenButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource BlueGreenButton.Pressed.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource BlueGreenButton.Pressed.Border}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource BlueGreenButton.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource BlueGreenButton.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource BlueGreenButton.Disabled.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource BlueGreenButton.Disabled.Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--<Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="border" Margin="{TemplateBinding Margin}" Padding="{TemplateBinding Padding}"
                                    Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{StaticResource ColorBrush.Green3}">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderThickness" TargetName="border" Value="1"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource ColorBrush.Green8}"/>
                                    <Setter Property="Background" TargetName="border" Value="{StaticResource ColorBrush.Green}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>


                            
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>-->
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>

            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 4 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!--待处理/已处理/已忽略/已REF-->
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Content="+ 新增需求" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Click="Button_Click"/>

                <Button Content="批量识别" Width="80" Height="24" Margin="4 0 0 0" HorizontalAlignment="Left" BorderThickness="0 1 0 0" Style="{DynamicResource SlateGrayStyle}" Click="ShowRecognizeWin_Click"/>

                <Button x:Name="btnImport" ToolTip="导入" Width="24" Height="24" Margin="2,0,0,0"  HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ImportButton2}" Command="{Binding ImportCommand}" IsEnabled="{Binding ImportEnabled}" Visibility="Collapsed"/>
                <Button x:Name="btnExport" ToolTip="导出" Width="24" Height="24" Margin="2,0,0,0"  HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ExportButton2}" Command="{Binding ExportCommand}" IsEnabled="{Binding ExportEnabled}" Visibility="Collapsed"/>
                <!--<RadioButton x:Name="MyIntentionRB"
                         Style="{DynamicResource BoxRadioButton}" Margin="5,0,5,0"
                         IsChecked="{Binding OrderStatusEnum,Converter={StaticResource tBookStatusEnumToBoolConvertor},ConverterParameter=0}">我的需求</RadioButton>-->
                <!--<RadioButton x:Name="IgnoreRB"
                         Style="{DynamicResource BoxRadioButton}" Margin="5,0,5,0"
                         IsChecked="{Binding OrderStatusEnum,Converter={StaticResource tBookStatusEnumToBoolConvertor},ConverterParameter=1}">已删除</RadioButton>-->

                <Grid Margin="4 0 0 0" x:Name="single">
                    <RadioButton x:Name="SingleRd_ALL" Content="全" Height="24" Width="24" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource AllRadioButtonStyle}" IsChecked="True" Click="Single_Click"  ToolTip="全部债券"/>
                    <RadioButton x:Name="SingleRd_R" Content="利率"  Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource RateRadioButtonStyle}" Margin="26 0 0 0" Click="Single_Click"  ToolTip="仅利率"/>
                    <RadioButton x:Name="SingleRd_C" Content="信用" Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource CreditRadioButtonStyle}" Margin="64 0 0 0" Click="Single_Click"  ToolTip="仅信用"/>
                    <RadioButton x:Name="SingleRd_L" Content="地方债"  Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource RateRadioButtonStyle}" Margin="102 0 0 0" Click="Single_Click"  ToolTip="仅地方债"/>
                    <RadioButton x:Name="SingleRd_N" Content="NCD" Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource CreditRadioButtonStyle}" Margin="140 0 0 0" Click="Single_Click"  ToolTip="仅NCD"/>
                </Grid>

                <!--<commonComp:FilterOptions x:Name="QuoteType" TagKey="QuoteType" Margin="10 1 0 4" VerticalAlignment="Bottom"/>-->
            </StackPanel>


            <StackPanel  Grid.Column="2" Orientation="Horizontal" Margin="0 0 10 0" HorizontalAlignment="Right">

                <TextBlock x:Name="CommonIntentionStatus_Tb" Text="个需状态:" VerticalAlignment="Center"/>
                <commonComp:MultiSelectComboBox x:Name="CommonIntentionStatusCB" Width="130" Height="22" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 2 0 4" DefaultText="不限">
                </commonComp:MultiSelectComboBox>

                <commonComp:SearchTextBox x:Name="Search_TextBox" HintText="搜索..." ToolTip="可模糊查询债券代码、债券简称、Trader、来源方机构、来源方、发行人、担保人" SearchText="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="24" IsFuzzy="True" Grid.Column="1"
                                  Margin="5 0 0 0" MouseOverBorderBrush="{DynamicResource TextBox.MouseOver.Border}" FocusBorderBrush="{DynamicResource TextBox.Focus.Border}"/>
                <Button x:Name="RefreshBtn" Width="24" Height="24" Style="{DynamicResource RefreshButton_24}" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding RefreshCommand}" Grid.Column="1" IsEnabled="{Binding RefreshBtnEnable}"/>
                <Rectangle Width="1" Height="16" Fill="#3C3C3C" Margin="0 0 4 0" HorizontalAlignment="Right"/>

            </StackPanel>

            <!--<Button x:Name="RecoverBtn" Content="恢复" Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Right" Width="60" Height="20" Grid.Column="3" Margin="0 0 115 0"
                    Command="{Binding AllRecoverCommand}" Visibility="{Binding IgnoreDataGridVisibility}" IsEnabled="{Binding RecoverEnable}"/>-->
            <!--<Button x:Name="QuoteIdentifyBtn"  HorizontalAlignment="Right" Width="80" Height="18" Grid.Column="3" Margin="0 0 30 0"
                        Style="{DynamicResource BlueGreenStyle}" Command="{Binding QuoteIdentifyCommand}">
                <WrapPanel>
                    <Image Source="/STC.WorkBench.Plugin;component/Images/stc_icon_import_normal.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="报价识别" VerticalAlignment="Center" Foreground="#FFFFFF" HorizontalAlignment="Left" Width="Auto"/>
                </WrapPanel>
            </Button>-->
            <Button x:Name="btnFullScreen" Grid.Column="3" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource PopupButton}" 
                    Command="{x:Static utils:CommonUtils.PopupWindowCommand}" CommandParameter="{x:Static command:PopupTypeEnum.IntentionWorkTable}" Margin="0 0 10 0"/>
        </Grid>

        <Grid Grid.Row="1" Name="tables_part">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition x:Name="p_part" Height="2*"/>
                <RowDefinition Height="8"/>
                <!--<RowDefinition Height="auto"/>-->
                <RowDefinition x:Name="r_part" Height="*"/>
            </Grid.RowDefinitions>
            <!--个需-->
            <Grid Background="Black">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!--<Button x:Name="personToggleBtn" Width="24" Height="24" Style="{DynamicResource CollapsedButton_24}" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="personToggleBtn_Click"/>-->
                    <Border BorderBrush="#136C5E" BorderThickness="0 0 0 2" Width="96">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="个需"  FontWeight="Bold" Foreground="White"/>
                            <Border x:Name="RedPoint" BorderThickness="1" BorderBrush="Red" Background="Red" Width="4" Height="4" CornerRadius="2" Margin="5 0 0 0" Grid.Column="1" Visibility="{Binding RedPointV}"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Margin="20,4,0,4" VerticalAlignment="Center" Text="{Binding TotalCount4Working, StringFormat={}共{0}条，}"/>
                    <TextBlock Grid.Row="2" Margin="0,4,0,4" VerticalAlignment="Center" Text="{Binding TotalCount4BidWorking, StringFormat={}其中Bid{0}条}"/>
                    <TextBlock Grid.Row="2" Margin="0,4,0,4" VerticalAlignment="Center" Text="{Binding BidC,StringFormat={}(待处理{0}条)}" Foreground="Red" Visibility="{Binding BidCV}"/>
                    <TextBlock Grid.Row="2" Margin="0,4,0,4" VerticalAlignment="Center" Text="{Binding TotalCount4OfrWorking, StringFormat={}，Ofr{0}条}"/>
                    <TextBlock Grid.Row="2" Margin="0,4,0,4" VerticalAlignment="Center" Text="{Binding OfrC,StringFormat={}(待处理{0}条)}" Foreground="Red" Visibility="{Binding OfrCV}"/>
                </StackPanel>


                

                <StackPanel Orientation="Horizontal" Grid.ColumnSpan="7" VerticalAlignment="Center" Grid.Row="1" Margin="0,0,4,0">
                    <CheckBox x:Name="isMeCheck" Content="我的" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Style="{DynamicResource DefaultCheckBoxStyle}" Margin="4" Padding="5 0 0 0"
                      IsChecked="true"  Checked="isMeCheck_Checked" Unchecked="isMeCheck_Unchecked" Visibility="Collapsed"/>

                    <TextBlock x:Name="TradersTB" Text="交易员:" VerticalAlignment="Center" Margin="10 0 0 0 " Visibility="Collapsed"/>
                    <commonComp:MultiSelectComboBox x:Name="TradersCB" Width="130" Height="22" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 2 0 4" DefaultText="不限" Visibility="Collapsed">
                    </commonComp:MultiSelectComboBox>

                    <TextBlock x:Name="InvestorsTB" Text="投资经理:" VerticalAlignment="Center" Margin="10 0 0 0 " Visibility="Collapsed"/>
                    <commonComp:MultiSelectComboBox x:Name="InvestorsCB" Width="130" Height="22" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 2 0 4" DefaultText="不限" Visibility="Collapsed">
                    </commonComp:MultiSelectComboBox>

                    <TextBlock x:Name="IntentionStatus_tb" Text="个需状态:" VerticalAlignment="Center" Visibility="Collapsed" Margin="10 0 0 0 "/>
                    <commonComp:MultiSelectComboBox x:Name="IntentionStatusCB" Width="130" Height="24" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 0 0 0" DefaultText="不限" Visibility="Collapsed">
                    </commonComp:MultiSelectComboBox>

                    <TextBlock x:Name="MatchStatus_tb" Text="匹配状态:" VerticalAlignment="Center" Margin="4 0 4 0" Visibility="Collapsed"/>
                    <commonComp:MultiSelectComboBox x:Name="MatchStatusCB" Width="130" Height="24" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 0 0 0" DefaultText="不限" Visibility="Collapsed">
                    </commonComp:MultiSelectComboBox>

                    <commonComp:FilterOptions x:Name="side" TagKey="SIDE" Margin="4 0 4 0" TagsListChanged="TagsListChanged" Visibility="Collapsed"/>

                    <DatePicker x:Name="dateStartPicker" Grid.Column="3"  Width="90" Height="24" Margin="4, 0, 4, 0"  HorizontalAlignment="Left"
