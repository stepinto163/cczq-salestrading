                                <DataGridTemplateColumn Header="操作人" Width="70" MinWidth="20" MaxWidth="145" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="CloseByTB" Margin="5,0,0,0" Text="{Binding CloseByName}" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Text}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="募集类型" Binding="{Binding IssueType}" Width="140" MinWidth="20" MaxWidth="300" IsReadOnly="True"/>
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdateTime}" Width="140" MinWidth="20" MaxWidth="300" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreateTime}" Width="140" MinWidth="20" MaxWidth="300" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </comp:CustomDefaultDataGrid>

                        <!--<commonComp:PopupEx x:Name="FilterPopup" Placement="Top" PlacementTarget="{Binding ElementName=demand_title_grid}" StaysOpen="true"
                                   PopupAnimation="Slide" AllowsTransparency ="True" Opened="FilterPopup_Opened" Closed="FilterPopup_Closed" MouseEnter="FilterPopup_MouseEnter">-->
                        <!--SearchText="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"-->
                        <Grid x:Name="FilterPopup" Grid.RowSpan="4" VerticalAlignment="Top" Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border Width="{Binding ElementName=person_part, Path=ActualWidth}" Height="255" BorderBrush="#3C3C3C" Background="Black" BorderThickness="1">
                                <!--SearchText="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"-->
                                <commonComp:SecurityFilterPanel x:Name="customFilterPanel" Visibility4IsMe="Collapsed" IsMe="{Binding IsMe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Padding="0 6 0 2"
                                            StartTermDY="{Binding StartTermDY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndTermDY="{Binding EndTermDY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsAppTerm="{Binding IsAppTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            FocusTags="{Binding FocusTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SaveAction="Save_Click" EditAction="EditGroup_Click"
                                        
                                            StartCoupon="{Binding StartCoupon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndCoupon="{Binding EndCoupon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsCoupon="{Binding IsCoupon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartPrice="{Binding StartPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            EndPrice="{Binding EndPrice,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartChinaBondValue="{Binding StartChinaBondValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            EndChinaBondValue="{Binding EndChinaBondValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartBidBp="{Binding StartBidBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndBidBp="{Binding EndBidBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            StartOfrBp="{Binding StartOfrBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" EndOfrBp="{Binding EndOfrBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsFuzzy="False"
                                            Visibility4NoReply="Collapsed" IsShowSaveEdit="Visible"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.VirtualizationMode="Recycling"
                                            ScrollViewer.IsDeferredScrollingEnabled="True" 
                                                        ShowAllAction="customFilterPanel_ShowAllAction"/>
                            </Border>
                        </Grid>
                        <!--</commonComp:PopupEx>-->

                    </Grid>
                </TabItem>
            </TabControl>


            <Grid x:Name="demand_title_grid" Grid.Row="3" Margin="220,4,0,4" Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Visibility="{Binding ElementName=DemandTab,Path=IsSelected, Converter={StaticResource booleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center">共<Run Text="{Binding TotalCount4Demand}"/>条，其中Bid<Run Text="{Binding TotalCount4BidDemand}"/>条，Ofr<Run Text="{Binding TotalCount4OfrDemand}"/>条</TextBlock>


                <StackPanel Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Right" Grid.Column="1">
                    <ListBox x:Name="TimeLimitListBox" MinWidth="220" Grid.Column="1" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Right" SelectionMode="Single" SelectedIndex="{Binding TimeLimitSelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                        <ListBox.Template>
                            <ControlTemplate>
                                <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBoxItem Content="今天" Tag="Today" Style="{DynamicResource  InnerBoardFilterListBoxItemDodgerBlueStyle}" />
                        <ListBoxItem Content="昨天" Tag="YesterDay" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="60" Margin="4,0,0,0"/>
                        <ListBoxItem Content="最近7天" Tag="Last7Days" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}"  IsSelected="True" Width="60" Margin="4,0,0,0"/>
                        <ListBoxItem Content="最近30天" Tag="Last30Days"  Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="60" Margin="4,0,0,0"/>
                        <!--<ListBoxItem Content="不限" Tag="UnLimited"  Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="60" Margin="4,0,0,0"/>-->
                    </ListBox>
                    <DatePicker x:Name="DemendStartPicker" Grid.Column="2" Width="90" Height="24" Margin="4, 0, 0, 0" SelectedDate="{Binding DealTimeBegin_Demand,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBlueDatePickerStyle}" Foreground="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Foreground}"
                                                    Background="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Background}" BorderBrush="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Border}">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="IsReadOnly" Value="True"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>
                    <DatePicker x:Name="DemendEndPicker" Grid.Column="3" Width="90" Height="24" Margin="4, 0, 0, 0" SelectedDate="{Binding DealTimeEnd_Demand,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource GreenBlueDatePickerStyle}" Foreground="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Foreground}"
                                                    Background="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Background}" BorderBrush="{DynamicResource DailanBlueGreenOrangeComboBoxItem.Normal.Border}">
                        <DatePicker.Resources>
                            <Style TargetType="DatePickerTextBox">
                                <Setter Property="IsReadOnly" Value="True"/>
                            </Style>
                        </DatePicker.Resources>
                    </DatePicker>

                    <Button x:Name="btn_Fileter" Grid.Column="4"  Content="更多筛选" Cursor="Hand" Width="64" Height="24" Margin="4 0 0 0" Click="SearchBtn_Click" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0 1 0 0" Style="{DynamicResource BlueGreenStyle}"/>
                    <!--<Button x:Name="btn_Demend_Fileter" Content="筛选" Grid.Column="4" Width="64" Height="24" Margin="4 0 10 0" Click="btn_Demend_Fileter_Click" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0 1 0 0" Style="{DynamicResource BlueGreenStyle}"/>-->
                    <!--<Button x:Name="singleToggleBtn" Width="24" Height="24" Style="{DynamicResource CollapsedButton_24}" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="singleToggleBtn_Click" Grid.Column="1" />-->

                    <commonComp:DescriptionCtrl x:Name="desCtrl" Grid.Column="5" Margin="4 0 0 0" ItemsSource="{Binding DesSource}"/>

                    <Button x:Name="btn_ShowAll" Grid.Column="6" Content="Show All" Width="64" Height="24" Margin="4 0 10 0" Click="deleteBtn_Click" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" BorderThickness="0 1 0 0" Style="{DynamicResource BlueGreenStyle}"/>
                </StackPanel>

            </Grid>

            <!--询价操作部分-->
            <Grid Grid.Row="3" VerticalAlignment="Top" Visibility="{Binding ElementName=InquiryTab, Path=IsSelected, Converter={StaticResource booleanToVisibilityConverter}}">
                <Grid Grid.Row="3"  Margin="220,1,0,4"  Visibility="{Binding IsInquiry, Converter={StaticResource reverseVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <!--<RadioButton x:Name="Rd_Valid" Content="有效" Height="24" Width="24" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource AllRadioButtonStyle}" IsChecked="True" Click="Single_Click"  ToolTip="全部债券"/>
                            <RadioButton x:Name="Rd_Invalid" Content="已撤销"  Height="24" Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{DynamicResource AllRadioButtonStyle}" Margin="26 0 0 0" Click="Single_Click"  ToolTip="仅利率"/>-->

                    <StackPanel x:Name="InquiryTitle_SP" Orientation="Horizontal" HorizontalAlignment="Left">
                        <!--<TextBlock Text="询价" FontSize="15" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>-->
                        <!--<TextBlock Text="3.12Y" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>
                        <TextBlock Text="180210.IB" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>
                        <TextBlock Text="18国开10" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>
                        <TextBlock Text="Bid" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>
                        <TextBlock Text="2.11%" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>
                        <TextBlock Text="2000万" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>
                        <TextBlock Text="T+1" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>-->
                        <TextBlock Text="{Binding SelectedItem_Working.RemainingTime}" Margin="8 0 0 0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedItem_Working.SecurityId}" Margin="8 0 0 0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedItem_Working.Symbol}"  Margin="8 0 0 0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedItem_Working.Side, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}"  Margin="8 0 0 0" VerticalAlignment="Center"/>
                        <!--<TextBlock Text="{Binding SelectedItem_Working.Price, Converter={StaticResource numConvertor}}"  Margin="8 0 0 0" VerticalAlignment="Center"/>
                        <TextBlock Text="%" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedItem_Working.Qty, Converter={StaticResource numConvertor}}"  Margin="8 0 0 0" VerticalAlignment="Center"/>
                        <TextBlock Text="万" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedItem_Working.SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"  Margin="8 0 0 0" VerticalAlignment="Center"/>-->
                    </StackPanel>


                    <ListBox x:Name="FilterListBox"  Background="Transparent" VerticalAlignment="Bottom" SelectionMode="Extended" Grid.Column="1"
                            SelectionChanged="FilterListBox_SelectionChanged">
                        <ListBox.Template>
                            <ControlTemplate>
                                <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource InnerBoardFilterListBoxItemDodgerBlueStyle}">
                                <Setter Property="MinWidth" Value="32"/>
                                <Setter Property="Height" Value ="20"/>
                                <Setter Property="Margin" Value ="2 0 0 0"/>
                                <Setter Property="Padding" Value="8 0 8 0"/>
                                <Setter Property="Content" Value="{Binding Title}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="有效" Tag="1" Style="{StaticResource InnerBoardFilterListBoxItemStyle}" Width="40" Height="20" Margin="2,1,0,4" IsSelected="True"/>
                        <ListBoxItem Content="已REF" Tag="4" Style="{StaticResource InnerBoardFilterListBoxItemStyle}" Width="40" Height="20" Margin="2,1,0,4" IsSelected="True"/>
                    </ListBox>

                    <Grid HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="批量改价:" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="5 0 5 0"/>
                        <commonComp:NumericUpDown x:Name="PriceNU_Edit" Grid.Column="1" NumericValue="{Binding Price_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                    Background="#0F0F0F" OriginalFormat="0.00##" Margin="5 0 5 0" Width="100"
                                                    MinValue="0.0001" MaxValue="999.9999" DecimalLength="4" RangeValue="0.005" VerticalAlignment="Center" AllowEmpty="True"
                                                  LostFocus="PriceNU_Edit_LostFocus" GotFocus="PriceNU_Edit_GotFocus" IsEnabled="{Binding InquiryBatch_IsEnabled}"/>
                        <ComboBox x:Name="cbPriceType_edit" Height="18" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding PriceTypeEmptyDic}" 
                                          DisplayMemberPath="Value"  SelectedValuePath="Key" Grid.Column="2"
                                          SelectedValue="{Binding PriceType_Edit,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{DynamicResource NonEditableComboBoxStyle}"
                                          FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" LostFocus="cbPriceType_edit_LostFocus">
                            <ComboBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource multiAndConverter}">
                                    <MultiBinding.Bindings>
                                        <Binding Path="IsEditPrice" Converter="{StaticResource reverseBooleanConvertor}"/>
                                        <Binding Path="InquiryBatch_IsEnabled" Converter="{StaticResource reverseBooleanConvertor}"/>
                                    </MultiBinding.Bindings>
                                </MultiBinding>
                            </ComboBox.IsEnabled>
                        </ComboBox>
                        <Button Name="price_save_btn" Grid.Column="3" Style="{DynamicResource SaveButton}" Click="price_save_btn_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Width="16" Height="16"
                                 IsEnabled="{Binding InquiryBatch_IsEnabled}" Visibility="{Binding IsEditPrice, Converter={StaticResource visibilityConvertor}}"/>


                        <TextBlock Grid.Column="4" Text="批量改量(万):" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="5 0 5 0"/>
                        <commonComp:NumericUpDown x:Name="QuantityNU_edit" Grid.Column="5" NumericValue="{Binding Qty_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                    Background="#0F0F0F"  Margin="5 0 5 0" Width="100"
                                                  MinValue="1" MaxValue="100000000" DecimalLength="0" RangeValue="1000" VerticalAlignment="Center"
                                                FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" AllowEmpty="True"
                                                ToolTip="输入范围:[1,100000000]"
                                                  LostFocus="QuantityNU_edit_LostFocus_1" GotFocus="QuantityNU_edit_GotFocus" IsEnabled="{Binding InquiryBatch_IsEnabled}"/>
                        <Button Name="qty_save_btn" Grid.Column="6" Style="{DynamicResource SaveButton}" Click="qty_save_btn_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Width="16" Height="16" Visibility="Hidden"
                                 IsEnabled="{Binding InquiryBatch_IsEnabled}"/>
                    </Grid>


                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Column="1">
                        <Button x:Name="addBtn" Content="新增" Width="48" Style="{StaticResource BlueButtonStyle}" Click="addBtn_Click"/>
                        <Button x:Name="refAll" Content="REF ALL" Width="60" Style="{StaticResource BlueButtonStyle}" Margin="4 0 4 0" Click="refAll_Click">
                            <!--<Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource multiAndConverter}">
                                    <MultiBinding.Bindings>
                                        <Binding Path="SelectedItem_Working.Enabled_Inquiry" Converter="{StaticResource reverseBooleanConvertor}"/>
                                        <Binding Path="InquiryBatch_IsEnabled"  Converter="{StaticResource reverseBooleanConvertor}"/>
                                    </MultiBinding.Bindings>
                                </MultiBinding>
                            </Button.IsEnabled>-->
                        </Button>
                    </StackPanel>
                </Grid>

            </Grid>
            

           
        </Grid>
    </Grid>
</UserControl>
