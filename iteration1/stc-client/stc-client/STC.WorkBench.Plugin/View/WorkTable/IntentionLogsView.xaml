<comp:WindowBase x:Class="STC.WorkBench.Plugin.View.WorkTable.IntentionLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:local="clr-namespace:STC.WorkBench.Plugin.View.WorkTable"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" Height="450" Width="1000"
             d:DesignHeight="450" d:DesignWidth="800">
    <Window.Resources>
        <ResourceDictionary>
            <fcon:StrContainsConvertor x:Key="strContainsConvertor"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="操作日志" FontSize="15" Foreground="White" Margin="5 0 0 0"  VerticalAlignment="Center"/>

            <TextBlock Text="{Binding CurrentItem.RemainingTime}" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Text="{Binding CurrentItem.SecurityId}" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Text="{Binding CurrentItem.Symbol}"  Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>-->

        <DataGrid x:Name="LogDg" Grid.Row="1" ItemsSource="{Binding WorkingViewSource.View}" Style="{DynamicResource DefaultDataGrid}" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="操作时间" Width="140" Binding="{Binding UpdateTime}"/>
                <DataGridTemplateColumn Header="操作人" MinWidth="20" Width="80" MaxWidth="150" CanUserSort="True" SortMemberPath="Qty">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="CloseBy_display" Text="{Binding CloseByName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CloseByName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="操作类型" Width="120" Binding="{Binding Operation}"/>
                <DataGridTemplateColumn Header="报价" MinWidth="20" Width="65" MaxWidth="100" CanUserSort="True" SortMemberPath="Price">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="Price_Part">
                                <TextBlock x:Name="Price_Display" Text="{Binding Price, StringFormat={}{0:0.00##}}" VerticalAlignment="Center"/>
                            </Border>
                            
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Diff,Converter={StaticResource strContainsConvertor},ConverterParameter='1'}" Value="true">
                                    <Setter TargetName="Price_Part" Property="Background" Value="Orange"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="报量" MinWidth="20" Width="65" MaxWidth="150" CanUserSort="True" SortMemberPath="Qty">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="Quantity_Part">
                                <TextBlock x:Name="Quantity_display" Text="{Binding Qty, StringFormat={}{0:0}}" VerticalAlignment="Center" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Diff,Converter={StaticResource strContainsConvertor},ConverterParameter='2'}" Value="true">
                                    <Setter TargetName="Quantity_Part" Property="Background" Value="Orange"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="方向" MinWidth="20" Width="40" MaxWidth="60" CanUserSort="True" SortMemberPath="Side">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="Side_Part">
                                <TextBlock x:Name="SideTB_display" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Style="{DynamicResource SideTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Diff,Converter={StaticResource strContainsConvertor},ConverterParameter='3'}" Value="true">
                                    <Setter TargetName="Side_Part" Property="Background" Value="Orange"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="清算速度" MinWidth="20" Width="80" MaxWidth="145" CanUserSort="True" SortMemberPath="SettlType">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="settlType_Part">
                                <TextBlock x:Name="settlType_dispay" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myorder'}"  FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Diff,Converter={StaticResource strContainsConvertor},ConverterParameter='4'}" Value="true">
                                    <Setter TargetName="settlType_Part" Property="Background" Value="Orange"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="状态" Width="100" MinWidth="20" MaxWidth="500" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="Status_Part">
                                <TextBlock x:Name="txStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Status, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='intentionstatus_buyer'}"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Diff,Converter={StaticResource strContainsConvertor},ConverterParameter='6'}" Value="true">
                                    <Setter TargetName="Status_Part" Property="Background" Value="Orange"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="匹配状态" Width="100" MinWidth="20" MaxWidth="500" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="MatchStatus_Part">
                                <TextBlock x:Name="txStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding MatchStatus, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='matchstatus'}"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Diff,Converter={StaticResource strContainsConvertor},ConverterParameter='7'}" Value="true">
                                    <Setter TargetName="MatchStatus_Part" Property="Background" Value="Orange"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="指令备注" Width="120" MinWidth="20" MaxWidth="500" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="CommandNote_Part">
                                <TextBlock x:Name="txStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding CommandNote}" ToolTip="{Binding CommandNote}" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Diff,Converter={StaticResource strContainsConvertor},ConverterParameter='5'}" Value="true">
                                    <Setter TargetName="CommandNote_Part" Property="Background" Value="Orange"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</comp:WindowBase>
