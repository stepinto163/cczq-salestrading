<UserControl x:Class="STC.WorkBench.Plugin.View.WorkTable.IntentionControl_Sell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkBench.Plugin.View.WorkTable"
             xmlns:comp ="clr-namespace:STC.WorkBench.Plugin.View.Component"
             xmlns:commonComp ="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:utils="clr-namespace:STC.WorkBench.Plugin.Utils"
             xmlns:conv="clr-namespace:STC.WorkBench.Plugin.Convertor"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" DataContextChanged="UserControl_DataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->

                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
           

            <conv:TBookStatusEnumToBoolConvertor x:Key="tBookStatusEnumToBoolConvertor"/>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:NumberConvertor x:Key="numConvertor"/>
            <fcon:NumberConvertor3 x:Key="numConvertor3"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <fcon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <fcon:BooleanConvertor x:Key="booleanConvertor"/>
            <conv:SubStringConverter x:Key="subStringConverter"/>
            <fcon:FormatDateTimeConvertor x:Key="FormatDateTimeConvertor"/>
            <fcon:StringConvertor x:Key="StringConvertor"/>
            <fcon:IntentionStatusConvertor x:Key="intentionStatusConvertor"/>
            <fcon:DaysOffStrConverter x:Key="daysOffStrConverter"/>
            <fcon:VenuesColorConvertor x:Key="venuesColorConvertor"/>
            <fcon:VenuesSimpleConvertor x:Key="venuesSimpleConvertor"/>
            <fcon:InnerBoardColorConvertor x:Key="colorCon"/>
            <fcon:EmptyColorConvertor x:Key="emptyColorCon"/>
            <fcon:RadioButtonConverter x:Key="radioBtnConverter"/>
            <fcon:GreaterThanZeroConverter x:Key="greaterThanZeroConverter"/>

            <Style x:Key="FuzzyColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SecurityId}" Value="99999">
                        <Setter Property="Foreground" Value="#FFDA9A" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <comp:CustomDefaultDataGrid x:Name="WorkingDataGrid" FrozenColumnCount="11"
                    ItemsSource="{Binding WorkingViewSource.View}"
                    SelectedItem="{Binding SelectedItem_Working,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    Style="{DynamicResource DefaultDataGrid}" 
                    LoadingRow="DataGrid_LoadingRow" IsReadOnly="false"
                    UnloadingRow="DataGrid_UnloadingRow" SelectionMode="Extended"
                    DefaultHideColumns="公告,原文,操作人,序号,募集类型" EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.IsDeferredScrollingEnabled="True" 
                    BeginningEdit="WorkingDataGrid_BeginningEdit" CellEditEnding="WorkingDataGrid_CellEditEnding">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource UnderlineDataGridRowStyle}">
                    <EventSetter Event="MouseEnter" Handler="DataGridRow_MouseEnter"/>
                    <EventSetter Event="MouseLeave" Handler="DataGridRow_MouseLeave"/>
                </Style>
            </DataGrid.RowStyle>
            <!--BeginningEdit="WorkingDataGrid_BeginningEdit"
                CellEditEnding="WorkingDataGrid_CellEditEnding"
            
                PreviewKeyDown="DataGrid_PreviewKeyDown"
                PreparingCellForEdit="DataGrid_PreparingCellForEdit">-->

            <DataGrid.ContextMenu>
                <ContextMenu x:Name="dgMenu_Post" Style="{StaticResource DefaultContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                Opened="dgMenu_Post_Opened">
                    <MenuItem x:Name="ToQbMenu" Header="债券详情" Style="{DynamicResource DefaultMenuItem}" Click="ToQbMenu_Click" Visibility="Collapsed"/>
                    <MenuItem x:Name="CopyMenu" Header="复制" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_Click"/>
                    <MenuItem x:Name="CopyMenu_SecurityID" Header="复制债券代码" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_SecurityID_Click"/>
                    <MenuItem x:Name="CopyMenu_Symbol" Header="复制债券简称" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_Symbol_Click"/>
                    <MenuItem x:Name="CopyMenu_Price" Header="复制价格" Style="{DynamicResource DefaultMenuItem}" Click="CopyMenu_Price_Click"/>
                    <MenuItem x:Name="SearchMen" Header="搜索该券" Style="{DynamicResource DefaultMenuItem}" Click="SearchMenu_Click"/>
                    <MenuItem x:Name="publishBtn" Header="发内部" Style="{StaticResource DefaultMenuItem}" Click="publishBtn_Click"/>
                    <MenuItem x:Name="hiddenBtn" Header="取消发内部" Style="{StaticResource DefaultMenuItem}" Click="hiddenBtn_Click"/>
                    <MenuItem x:Name="refBtn" Header="撤销" Style="{StaticResource DefaultMenuItem}" Click="refBtn_Click"/>
                    <MenuItem x:Name="recoverBtn" Header="恢复" Style="{StaticResource DefaultMenuItem}" Click="recoverBtn_Click"/>
                    <MenuItem x:Name="finishBtn" Header="完成" Style="{StaticResource DefaultMenuItem}" Click="FinishBtn_Click"/>
                    <MenuItem x:Name="addBrokerBtn" Header="加入自动发布名单" Style="{StaticResource DefaultMenuItem}" Height="{Binding AddBrokerBtnH}" Command="{Binding AddBrokerCommand}"/>
                    <MenuItem x:Name="cancelBrokerBtn" Header="取消自动发布" Style="{StaticResource DefaultMenuItem}" Height="{Binding CancelBrokerBtnH}" Command="{Binding CancelBrokerCommand}"/>
                    <MenuItem x:Name="StartQQ" Header="弹出QQ" Style="{StaticResource DefaultMenuItem}" Command="{Binding StartQQCommand}" CommandParameter="{Binding ElementName=StartQQ}"/>
                    <MenuItem x:Name="StartQQ2" Header="议价" Style="{StaticResource DefaultMenuItem}" Command="{Binding StartQQ2Command}" CommandParameter="{Binding ElementName=StartQQ2}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!--<DataGridTemplateColumn Header="选择" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" 
                                                    IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                    Style="{DynamicResource DefaultCheckBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsShow, Converter={StaticResource visibilityConvertor}}"
                                            Style="{DynamicResource DefaultCheckBoxStyle}"></CheckBox>
                            -->
                <!--<DataTemplate.Triggers>
                                -->
                <!--<DataTrigger Binding="{Binding Status}" Value="1">
                                    <Setter Property="Visibility" TargetName="Selected_Chk" Value="Collapsed"/>
                                </DataTrigger>-->
                <!--
                                <DataTrigger Binding="{Binding Status}" Value="2">
                                    <Setter Property="Visibility" TargetName="Selected_Chk" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="4">
                                    <Setter Property="Visibility" TargetName="Selected_Chk" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>-->
                <!--
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTemplateColumn Header="序号" Width="Auto" MinWidth="20" MaxWidth="80" IsReadOnly="True" HeaderStyle="{DynamicResource DataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="No_TB" Text="{Binding No}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="来源方机构" MinWidth="20" Width="80" MaxWidth="100" CanUserSort="True" SortMemberPath="InstitutionName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--显示部分-->
                            <Border x:Name="InsNameBorder">
                                <TextBlock x:Name="InsName_display" Foreground="#FFFFFF" Text="{Binding InstitutionName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstitutionName}"></TextBlock>
                            </Border>
                            <!--<DataTemplate.Triggers>
                                -->
                            <!--没有来源方机构-->
                            <!--
                                <DataTrigger Binding="{Binding InstitutionName,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="InsNameBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="InsNameBorder" Property="BorderBrush" Value="red"/>
                                    <Setter TargetName="InsName_display" Property="Text" Value="来源方机构"/>
                                    <Setter TargetName="InsName_display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>-->
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="来源方" MinWidth="20" Width="100" MaxWidth="120" CanUserSort="True" SortMemberPath="TraderName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--显示部分-->
                            <Border x:Name="TrdNameBorder">
                                <TextBlock x:Name="TrdNameLb_display" Foreground="#FFFFFF" Text="{Binding TraderName}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TraderName}"></TextBlock>
                            </Border>
                            <!--<DataTemplate.Triggers>
                                -->
                            <!--没有来源方-->
                            <!--
                                <DataTrigger Binding="{Binding TraderName,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="TrdNameBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="TrdNameBorder" Property="BorderBrush" Value="red"/>
                                    <Setter TargetName="TrdNameLb_display" Property="Text" Value="来源方"/>
                                    <Setter TargetName="TrdNameLb_display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>-->
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="来源渠道" Width="35" MinWidth="20" MaxWidth="100" ClipboardContentBinding="{Binding Channel}" SortMemberPath="Channel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 图标 -->
                                <Image x:Name="thumbImageQq" Source="/STC.Common;component/Images/qq.png" Width="15" Height="15" Visibility="Collapsed" Grid.Column="0" ToolTip="{Binding IM}"/>
                                <Image x:Name="thumbImageGroup" Source="/STC.Common;component/Images/qq_group.png" Width="15" Height="15" Visibility="Collapsed" Grid.Column="0" ToolTip="{Binding IM}"/>
                                <Image x:Name="thumbImageIGroup" Source="/STC.Common;component/Images/qq_igroup.png" Width="15" Height="15" Visibility="Collapsed" Grid.Column="0" ToolTip="{Binding IM}"/>
                                <Image x:Name="thumbImageWechat" Source="/STC.Common;component/Images/wechat.png" Width="15" Height="15" Visibility="Collapsed" Grid.Column="0"/>
                                <TextBlock x:Name="thumbImage" Text="手动" Foreground="#FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" HorizontalAlignment="Center" FontWeight="Normal" FontSize="10"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Channel}" Value="FINQ">
                                    <Setter TargetName="thumbImageQq" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Channel}" Value="FINQ_GROUP">
                                    <Setter TargetName="thumbImageGroup" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Channel}" Value="FINQ_GROUP_INT">
                                    <Setter TargetName="thumbImageIGroup" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Channel}" Value="WECHAT">
                                    <Setter TargetName="thumbImageWechat" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Channel}" Value="CLIENT">
                                    <Setter TargetName="thumbImage" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="剩余期限" Width="Auto" MinWidth="20"  ClipboardContentBinding="{Binding RemainingDate}" SortMemberPath="RemaingingTime_convert" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding RemainingTime}" HorizontalAlignment="Left"/>
                                <!--<Button Grid.Column="2" HorizontalAlignment="Right" Width="12" Height="12"  BorderThickness="0" Style="{StaticResource OpenSecurityButton}"  ToolTip="查看行情小窗"  Click="best_opensecurity_btn_Click"/>-->
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="代码" MinWidth="20" Width="80" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="SecurityIDTB" Text="{Binding SecurityId}"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecurityId}"/>

                                <Border x:Name="TaxFreeBorder" CornerRadius="2" BorderThickness="1" BorderBrush="#C29B4E" Background="#000000" Width="16" Height="16" Visibility="Collapsed" Margin="5,0,0,0" Grid.Column="1">
                                    <TextBlock Text="免" Foreground="#C29B4E" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tax_Free}" Value="01">
                                    <Setter TargetName="TaxFreeBorder" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="orderid" Binding="{Binding OrderID}"/>
                <DataGridTextColumn Header="intentionid" Binding="{Binding IntentionId}"/>-->
                <DataGridTemplateColumn Header="简称" MinWidth="20" Width="80" MaxWidth="150" CanUserSort="True" SortMemberPath="Symbol" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="SymbolTB" Text="{Binding Symbol}"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Symbol}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="方向" MinWidth="20" Width="40" MaxWidth="60" CanUserSort="True" SortMemberPath="Side">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--显示部分-->
                            <Border x:Name="SideBorder">
                                <TextBlock x:Name="SideTB_display" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Style="{DynamicResource SideTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <!--没有方向-->
                                <DataTrigger Binding="{Binding Side,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <!--<Setter TargetName="SideBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="SideBorder" Property="BorderBrush" Value="red"/>-->
                                    <Setter TargetName="SideTB_display" Property="Text" Value="--"/>
                                    <Setter TargetName="SideTB_display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="状态" Width="100" MinWidth="20" MaxWidth="500" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txStatus" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource intentionStatusConvertor}">
                                        <MultiBinding.Bindings>
                                            <Binding Path="Type"/>
                                            <Binding Path="Status"/>
                                        </MultiBinding.Bindings>
                                    </MultiBinding>
                                </TextBlock.Text>
                                <!--<TextBlock.Style>
                                    <Style TargetType="TextBlock">

                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Property="Text" Value="已NF发布"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.Setters>
                                                    <Setter Property="Foreground" Value="{StaticResource RFQ.ColorBrush}"/>
                                                </MultiDataTrigger.Setters>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>-->
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="询价渠道" Width="100" MinWidth="20" MaxWidth="500" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txStatus" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Status_Display}" ToolTip="{Binding Status_Tooltip_Display}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="170" MinWidth="20" MaxWidth="300" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="ConfirmBtn" Content="发内部" Margin="0,0,2,0" HorizontalAlignment="Left" Width="42" Height="16" Background="Orange" Foreground="Black" Style="{DynamicResource DefaultButtonStyle}" 
                                            Command="{Binding DataContext.ConfirmCommand,RelativeSource={RelativeSource AncestorType={x:Type DataGrid},Mode=FindAncestor}}"
                                            CommandParameter="{Binding ElementName=ConfirmBtn}" Visibility="Collapsed"/>
                                <Button  Grid.Column="1" x:Name="ToNewBtn" Margin="0,0,2,0" Content="取消发内部" HorizontalAlignment="Left" Width="68" Height="16" Style="{DynamicResource DefaultButtonStyle}"
                                            Command="{Binding DataContext.ToNewCommand,RelativeSource={RelativeSource AncestorType={x:Type DataGrid},Mode=FindAncestor}}"
                                            CommandParameter="{Binding ElementName=ToNewBtn}" Visibility="Collapsed"/>
                                <Button  Grid.Column="2" x:Name="MarketBtn" Content="询价" Margin="0,0,2,0" HorizontalAlignment="Left" Width="32" Height="16" Style="{DynamicResource DefaultButtonStyle}" 
                                                Click="MarketBtn_Click"
                                                Visibility="Collapsed" IsEnabled="{Binding Enabled_Inquiry}"/>
                                <Button  Grid.Column="3" x:Name="CancelMarketBtn" Content="撤销询价" Margin="0,0,2,0" HorizontalAlignment="Left" Width="52" Height="16" Style="{DynamicResource DefaultButtonStyle}" 
                                                Click="CancelMarketBtn_Click"
                                                Visibility="Collapsed" IsEnabled="{Binding Enabled_Inquiry}"/>
                                <Button Grid.Column="4" x:Name="RefBtn" Margin="0,0,2,0" Content="撤销" HorizontalAlignment="Left" Width="32" Height="16" Style="{DynamicResource DefaultButtonStyle}"
                                            Click="RefBtn_Click_1"
                                            Visibility="Collapsed"/>
                                <Button  Grid.Column="5" x:Name="ReorderBtn" Content="恢复" Margin="0,0,2,0" HorizontalAlignment="Left" Width="32" Height="16" Style="{DynamicResource DefaultButtonStyle}" 
                                                Command="{Binding DataContext.ReorderCommand,RelativeSource={RelativeSource AncestorType={x:Type DataGrid},Mode=FindAncestor}}"
                                                CommandParameter="{Binding ElementName=ReorderBtn}" Visibility="Collapsed"/>
                                <!--<Button  Grid.Column="6" x:Name="FinishBtn" Content="完成" Margin="0,0,2,0" HorizontalAlignment="Left" Width="32" Height="16" Style="{DynamicResource DefaultButtonStyle}" 
                                                 Click="FinishBtn_Single_Click"
                                                 Visibility="Collapsed"/>-->
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="0">
                                    <Setter Property="Visibility" TargetName="RefBtn" Value="Visible"/>
                                    <!--<Setter Property="Visibility" TargetName="FinishBtn" Value="Visible"/>-->
                                    <Setter Property="Visibility" TargetName="ConfirmBtn" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="1">
                                    <Setter Property="Visibility" TargetName="RefBtn" Value="Visible"/>
                                    <!--<Setter Property="Visibility" TargetName="FinishBtn" Value="Visible"/>-->
                                    <Setter Property="Visibility" TargetName="ToNewBtn" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="4">
                                    <Setter Property="Visibility" TargetName="ReorderBtn" Value="Visible"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding InquiryStatus}" Value="0"/>
                                        <Condition Binding="{Binding DataContext.IsInquiry, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" TargetName="MarketBtn" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding InquiryStatus}" Value="1"/>
                                        <Condition Binding="{Binding DataContext.IsInquiry, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" Value="1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" TargetName="CancelMarketBtn" Value="Visible"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="来源方报价" MinWidth="20" Width="60" MaxWidth="100" CanUserSort="True" SortMemberPath="Bp">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PriceBorder">
                                <!--显示部分-->
                                <TextBlock x:Name="LastPrice_Display" Text="{Binding CustomerPrice, StringFormat={}{0:0.00##}}" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CustomerPrice,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <!--<Setter TargetName="PriceBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="PriceBorder" Property="BorderBrush" Value="red"/>-->
                                    <Setter TargetName="LastPrice_Display" Property="Text" Value="--"/>
                                    <Setter TargetName="LastPrice_Display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="点差" MinWidth="20" Width="55" MaxWidth="100" CanUserSort="True" SortMemberPath="Bp">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PriceBorder">
                                <!--显示部分-->
                                <TextBlock x:Name="BP_Display" Text="{Binding BP, StringFormat={}{0:0.00##}}" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding BP,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <!--<Setter TargetName="PriceBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="PriceBorder" Property="BorderBrush" Value="red"/>-->
                                    <Setter TargetName="BP_Display" Property="Text" Value="--"/>
                                    <Setter TargetName="BP_Display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="定价" MinWidth="20" Width="160" MaxWidth="300" CanUserSort="True" SortMemberPath="Price">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!--编辑部分-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <commonComp:NumericUpDown x:Name="PriceNU_Edit" NumericValue="{Binding Price_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                    Loaded="PriceNU_Edit_Loaded"
