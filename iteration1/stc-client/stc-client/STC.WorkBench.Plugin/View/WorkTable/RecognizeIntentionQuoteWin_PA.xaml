                <TextBlock Text="Ofr:估值" Foreground="{DynamicResource ColorBrush.Gray14}" VerticalAlignment="Center" Margin="5 0 0 0" />
                <ComboBox x:Name="ofrOp" Height="18" VerticalContentAlignment="Center" Margin="5 0 0 0" Width="40"
                                          DisplayMemberPath="Value"  SelectedValuePath="Key" Grid.Column="2"
                                          Style="{DynamicResource NonEditableComboBoxStyle}"
                          SelectedIndex="1"
                           ItemsSource="{Binding OpDic}"
                          SelectionChanged="ofrOp_SelectionChanged">
                </ComboBox>
                <comp:DrpNumericUpDown x:Name="bp_Ofr" Height="24" Width="80" NumericValue="{Binding OfrBp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="10 0 0 0" IsTabStop_Custom="False"
                                                                TextContentAlignment="Left" TextForeground="White" Foreground="White"  VerticalAlignment ="Center" DecimalLength="2" RangeValue="0.25" MaxValue="100" MinValue="0" UpDownBorderThickness="1" NumBorderBrush="#3C3C3C" UpDownBackground="#282828" UpDownBorderBrush="#282828" UpMargin="0,1,1,0"  DownMargin="0,1,1,1"
                                                                FontFamily="MicroSoft YaiHei" FontSize="14" FontWeight="Bold" Padding="0,0,0,0" AllowEmpty="True" IsDecreaseToZero="True"
                                       KeyDown="bp_Ofr_KeyDown" LostFocus="bp_Ofr_LostFocus"/>
                
                <TextBlock Text="加点" Foreground="{DynamicResource ColorBrush.Gray14}" VerticalAlignment="Center" Margin="5 0 0 0" />
                <comp:DrpNumericUpDown x:Name="bp1" Height="24" Width="80" NumericValue="{Binding BP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="10 0 0 0" IsTabStop_Custom="False"
                                                                TextContentAlignment="Left" TextForeground="White" Foreground="White"  VerticalAlignment ="Center" DecimalLength="2" RangeValue="0.25" MaxValue="100" MinValue="-100" UpDownBorderThickness="1" NumBorderBrush="#3C3C3C" UpDownBackground="#282828" UpDownBorderBrush="#282828" UpMargin="0,1,1,0"  DownMargin="0,1,1,1"
                                                                FontFamily="MicroSoft YaiHei" FontSize="14" FontWeight="Bold" Padding="0,0,0,0" AllowEmpty="True" IsDecreaseToZero="True"/>-->

            </StackPanel>
        </Border>

        <Border Grid.Row="4" Grid.Column="2" BorderBrush="#3B3C3E" BorderThickness="0,0,0,0">
            <StackPanel Orientation="Horizontal">


                <CheckBox Content="急" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="24" IsTabStop="False"
                          IsChecked="{Binding HurryFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
                <CheckBox Content="荐" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="24" IsTabStop="False"
                          IsChecked="{Binding SuggestFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
                <CheckBox Content="火" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="24" IsTabStop="False"
                          IsChecked="{Binding FireFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>

                <CheckBox Content="底" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" Width="24" Margin="10 0 0 0" IsTabStop="False"
                          IsChecked="{Binding FloorPrice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
                <CheckBox Content="oco" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="42" IsTabStop="False"
                          IsChecked="{Binding OcoFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}" />
                <CheckBox Content="打包" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="42" IsTabStop="False"
                          IsChecked="{Binding OcoFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='2'}"/>

                <!--<comp:MultiSelectComboBox x:Name="TagCB" Width="60" Height="24" Margin="4 0 0 0" ItemsSource="{Binding TagDic}" FilterDicChanged="TagCB_FilterDicChanged"/>-->

            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="InvestorTB" Text="投资经理" VerticalAlignment="Center" Margin="5 0 5 0" Foreground="#FFFFFF" Visibility="Collapsed"/>
                <comp:AutoCompleteComboBox x:Name="Investor_edit" Height="20" Width="100" Visibility="Collapsed"
                                                       DisplayValuePath="Name"
                                                       SelectedItem="{Binding SelectedInvestor_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding Investor_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="投资经理" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="Investor_edit_PatternChanged"  IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn  Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding Name }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>
                <!--<TextBlock Text="客户名:" Style="{StaticResource TitleTBFont}" VerticalAlignment="Center" Margin="5 3 5 0" Foreground="#FFFFFF"/>-->
                <TextBlock x:Name="TraderTB" Text="交易员" VerticalAlignment="Center" Margin="5 0 5 0" Foreground="#FFFFFF" Visibility="Collapsed"/>
                <comp:AutoCompleteComboBox x:Name="TraderCb_edit" Height="20" Width="100" Margin="5 0 0 0"  Visibility="Collapsed"
                                                       DisplayValuePath="Name"
                                                       SelectedItem="{Binding SelectedTrader_Buy_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding Trader_Buy_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown ="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="交易员" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="TraderCb_edit_PatternChanged"  IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn MinWidth="100" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>

                <TextBlock x:Name="clientTB" Text="来源方:" VerticalAlignment="Center" Margin="5 0 5 0" Foreground="#FFFFFF"/>
                <comp:AutoCompleteComboBox x:Name="InsNameCb_edit" Height="20" Width="100"
                                                       DisplayValuePath="shortnamecn" LostFocus="InsNameCb_edit_LostFocus"
                                                       SelectedItem="{Binding SelectedInstintuion_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding InstitutionName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="来源方机构" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedInstitutionCB_PatternChanged" IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn  Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>
                <!--<TextBlock Text="客户名:" Style="{StaticResource TitleTBFont}" VerticalAlignment="Center" Margin="5 3 5 0" Foreground="#FFFFFF"/>-->
                <comp:AutoCompleteComboBox x:Name="TrdNameCb_edit" Height="20" Width="100" Margin="5 0 0 0"
                                                       DisplayValuePath="namecn" LostFocus="TrdNameCb_edit_LostFocus"
                                                       SelectedItem="{Binding SelectedTrader_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding TraderName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown ="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="来源方" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedUserIDCB_PatternChanged" IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn MinWidth="100" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding namecn}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn MinWidth="100" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding instname}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>

                <Grid x:Name="tagGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="vipChk" Content="VIP" Foreground="{DynamicResource ColorBrush.Yellow-1}" Width="40" FontStyle="Italic" FontWeight="Bold" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray-23}" IsChecked="{Binding IsVip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource DefaultCheckBoxStyle}" Background="Transparent" Padding="0,0,0,0" Margin="5,0,0,0" IsTabStop="False"/>
                    <comp:AutoCompleteComboBox x:Name="cbClientType" Height="24" Width="100" Margin="1 0 0 0" Grid.Column="1"
                                                       DisplayValuePath="shortnamecn"
                                                       SelectedItem="{Binding SelectClientTypeItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding ClientTypeEnum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="客户类型" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedClientType_PatternChanged" IsTabStop="False">
                        <comp:AutoCompleteComboBox.AutoCompColumns>
                            <DataGridTemplateColumn MinWidth="50" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Text}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </comp:AutoCompleteComboBox.AutoCompColumns>
                    </comp:AutoCompleteComboBox>
                </Grid>
                <StackPanel x:Name="PA_GroupAccount_Part" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="投资组合名称:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5,0,5,0" Foreground="#FFFFFF"/>
                    <comp:MultiTreeComboBox Width="160" Height="24"  Margin="0 0 0 0"  x:Name="cmbMultiTree" SelectedItemChanged="cmbMultiTree_SelectedItemChanged"
                            VerticalAlignment="Center" Foreground="{StaticResource ComboBoxItem.Static.Foreground}"
                            TreeItemsSource="{Binding MultiTreeComboxItemsSource}" 
                            IsEnableMultiSelect="False" DefaultText="" IsEnableSelectRootNode="False" IsEnableSearch="True" DisplayPath="PA"
                            SelectedId="{Binding SelectedTradeAccountCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedTexts="{Binding SelectedTradeAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentId="{Binding SelectedGroupItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentTexts="{Binding SelectedGroupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentItems="{Binding SelectedGroupDict, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedProductId="{Binding SelectedProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                        <comp:MultiTreeComboBox.TreeItemItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                <StackPanel Orientation="Horizontal" Height="24">
                                    <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Tag="{Binding Id}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TreeCheckBoxButton}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding  RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                            <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                            <Condition Binding="{Binding IsLeaf}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                            <Condition Binding="{Binding IsGroup}" Value="False"/>
                                                            <Condition Binding="{Binding IsLeaf}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                            <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                            <Condition Binding="{Binding IsLeaf}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!--<Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>-->
                                    <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Checked}" Value="1">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                    <TextBlock Margin="2, 0, 0, 0" Text="{Binding ProductId, StringFormat=({0}), TargetNullValue=(空)}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#FFFFFF">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProductId}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProductId}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                            </HierarchicalDataTemplate>
                        </comp:MultiTreeComboBox.TreeItemItemTemplate>
                    </comp:MultiTreeComboBox>

                    <TextBlock Text="对谁可见:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5,0,5,0" Foreground="#FFFFFF"/>
                    <comp:MultiSelectComboBox x:Name="OtherInvestors" Width="120" Height="23" VerticalContentAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" DefaultText="" Grid.Row="1" Grid.Column="1" FilterDicChanged="OtherInvestors_FilterDicChanged">
                    </comp:MultiSelectComboBox>
                </StackPanel>

                <TextBlock x:Name="priceTypeTB" Text="报价标准" VerticalAlignment="Center" Margin="5 0 5 0" Foreground="#FFFFFF"/>
                <ComboBox x:Name="cbPriceType_edit" Height="24" Width="100" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding PriceTypeEmptyDic}" 
                                          DisplayMemberPath="Value"  SelectedValuePath="Key" Grid.Column="2"
                                          SelectedValue="{Binding PriceType,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{DynamicResource NonEditableComboBoxStyle}"
                                          FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                            SelectionChanged="cbPriceType_edit_SelectionChanged">
                </ComboBox>
            </StackPanel>


        </Grid>

        <Grid Grid.Row="6" Grid.RowSpan="2" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <comp:WatermarkTextBox x:Name="memo" WaterMark="个人笔记" Margin="4 0 4 4" MaxLength="1000" IsTabStop="False" AcceptsReturn="True" TextWrapping="WrapWithOverflow"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch"
                               Text="{Binding PersonalRemarks, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <comp:WatermarkTextBox x:Name="commandNote" WaterMark="指令备注" Margin="2 0 4 4" MaxLength="1000" IsTabStop="False" AcceptsReturn="True" TextWrapping="WrapWithOverflow"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch"
                               Text="{Binding CommandNotes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Column="1" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="2" Grid.Row="0" VerticalAlignment="Bottom">
                <Button x:Name="clear_button" Width="60" Height="24" Margin="0 0 4 4" Style="{DynamicResource GraySlateButtonStyle}" Click="clear_button_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">清空</Button>
                <!--<Button x:Name="close_button" Width="60" Height="24" Margin="0,0,4,0" Style="{DynamicResource GrayButtonStyle}" Click="close_button_Click">取消</Button>-->
                <!--<Button x:Name="firm_button" Width="60" Height="24" Margin="0 0 4 0" Style="{DynamicResource BlueGreenStyle}" Click="firm_button_Click" IsEnabled="{Binding IsFirmPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">Firm发布</Button>-->
                <Button x:Name="copy_button" Width="60" Height="24" Margin="0 0 4 4" Style="{DynamicResource BlueGreenStyle}" Click="copy_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">复制</Button>
                <Button x:Name="risk_button" Width="60" Height="24" Margin="0 0 4 4" Style="{DynamicResource BlueGreenStyle}" Click="risk_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">风控检查</Button>
                <Button x:Name="nf_button" Width="60" Height="24" Margin="0 0 4 4" Style="{DynamicResource BlueGreenStyle}" Click="nf_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsEnabledChanged="nf_button_IsEnabledChanged">发内部</Button>
                <!--<Button x:Name="ok_button" Width="60" Height="24" Margin="4 0 0 4" Style="{DynamicResource BlueGreenStyle}" Click="ok_button_Click" IsEnabled="{Binding IsPublishBtnEnable_PA}" Content="发个需" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False"/>-->
                <Button x:Name="ok_button" Width="60" Height="24" Margin="0 0 4 4" Style="{DynamicResource BlueGreenStyle}" Click="ok_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Content="发个需" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False"/>
                <Button x:Name="demand_button" Width="60" Height="24" Margin="0 0 4 4" Style="{DynamicResource BlueGreenStyle}" Click="demand_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">发私域池</Button>
            </StackPanel>
        </Grid>
    </Grid>
</comp:WindowBase>

