<comp:WindowBase x:Class="STC.WorkBench.Plugin.View.WorkTable.RecognizeIntentionQuoteWin_PA"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:localcomp="clr-namespace:STC.WorkBench.Plugin.View.Component"
             xmlns:comCon ="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:Con="clr-namespace:STC.WorkBench.Plugin.Convertor"
             mc:Ignorable="d" Background="{DynamicResource MainBackgroup.ColorBrush}"
             ResizeMode="CanResize"
             Title="报价识别"
             Height="400" Width="1180" Closed="WindowBase_Closed">
    <comp:WindowBase.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/GridSplitterStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <comCon:BooleanConvertor x:Key="booleanConvertor"/>
            <comCon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <comCon:DaysOffStrConverter x:Key="DaysOffCon"/>
            <comCon:NumberConvertor x:Key="numConvertor"/>
            <Con:SubStringConverter x:Key="subStringConverter"/>
            <comCon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <comCon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <comCon:RadioButtonConverter x:Key="radioBtnConverter"/>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="SideTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="SelfVGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{DynamicResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Rectangle Width="1" Height="12" Stroke="#515151" Margin="0,0,2,0"/>
                                    <Rectangle Width="1" Height="12" Stroke="#515151" Margin="-2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 居中 -->
            <Style x:Key="SelfDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="SelfDataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Right"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="SelfDataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>

            <Style TargetType="Image" x:Key="ImageStyle">
                <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BookType}" Value="R">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="P">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/group_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="A">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </comp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="8" x:Name="LeftRow"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TabControl x:Name="recogTypeTC" Grid.RowSpan="5"  Style="{DynamicResource TabControlStyle1}" Padding="0" BorderThickness="0" AllowDrop="True" DragDrop.DragEnter="TabControl_DragEnter" DragDrop.Drop="TabControl_Drop" PreviewKeyDown="img_PreviewKeyDown">
            <TabItem x:Name="textTI" Header="原文" Width="60" Style="{DynamicResource TabItemStyle_Button}" IsTabStop="False">
                <comp:WatermarkTextBox x:Name="contentTxt"  WaterMark="请粘贴报价信息&#x000A;如 BID 200210 3.24% 3000w&#x000A;(支持粘贴多条信息)" VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                            BorderThickness="2" Background="{DynamicResource MainBackgroup.ColorBrush}" KeyDown="contentTxt_KeyDown" Margin="1 0 0 0"
                            AcceptsReturn="True" TextWrapping="NoWrap"></comp:WatermarkTextBox>

            </TabItem>
            <TabItem x:Name="ImageTI" Header="图片" Width="60" Style="{DynamicResource TabItemStyle_Button}" Visibility="{Binding ParserImageVisibility}" IsTabStop="False">
                <Grid>
                    <TextBlock Name="ImageWaterMark" Text="请粘贴报价图片" Foreground="#3C3C3C" Margin="4 2 0 0" FontSize="13" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image  x:Name="img"  Focusable="True" Stretch="None"  AllowDrop="True" DragDrop.DragEnter="TabControl_DragEnter" DragDrop.Drop="TabControl_Drop" PreviewKeyDown="img_PreviewKeyDown"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!--<Border Background="{DynamicResource DataGridColumnHeaderBackground}">
            <TextBlock Text="原文" Foreground="{DynamicResource DataGridColumnHeaderForeground}" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <comp:WatermarkTextBox x:Name="contentTxt"  WaterMark="请粘贴报价信息&#x000A;如 BID 200210 3.24% 3000w&#x000A;(支持粘贴多条信息)" VerticalContentAlignment="Top"
                             BorderThickness="0" Background="{DynamicResource MainBackgroup.ColorBrush}"
                             AcceptsReturn="True" TextWrapping="Wrap"></comp:WatermarkTextBox>
            </ScrollViewer>
        </Grid>-->


        <CheckBox Content="全量替换上次识别内容" Grid.Row="5" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{Binding IsCover, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="6">
            <Button x:Name="btnClear" Width="60" Height="24" Style="{DynamicResource GraySlateButtonStyle}"
                            Click="btnClear_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">清除</Button>
            <Button x:Name="btnRecognize" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnRecognize_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0">识别</Button>
        </StackPanel>
        <Border x:Name="step1" Grid.Row="5" BorderBrush="#3B3C3E" BorderThickness="0 1 0 0" />

        <!--分割-->
        <GridSplitter x:Name="gridSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="7" Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SelfVGridSplitterStyle2}" DragCompleted="gridSplitter_DragCompleted" IsTabStop="False"/>

        <localcomp:CustomDefaultDataGrid x:Name="dg_pa" Grid.Column="2" Grid.RowSpan="3"
                      ItemsSource="{Binding ViewSource.View}"
                      SelectedItem="{Binding SelectedItem_Recognize,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource DefaultDataGrid}" SelectionMode="Single" IsReadOnly="False" IsTabStop="False"
                  RowStyle="{DynamicResource UnderlineDataGridRowStyle}"
                   LoadingRow="DataGrid_LoadingRow" 
                   UnloadingRow="DataGrid_UnloadingRow"
                  
                  BeginningEdit="DataGrid_BeginningEdit"
                  CellEditEnding="DataGrid_CellEditEnding">

            <DataGrid.Columns>
                <DataGridTemplateColumn MinWidth="40" Header="" Width="40" MaxWidth="40" HeaderStyle="{StaticResource SelfDataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="CheckBox_All"
                                                    IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Style="{DynamicResource DefaultCheckBoxStyle}"/>
                        </DataTemplate>

                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{DynamicResource DefaultCheckBoxStyle}"></CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" MinWidth="40" Width="40" MaxWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="DelBtn" Height="14" Width="14" 
                                      Click="DelBtn_Click"
                                        Style="{DynamicResource DeleteButton}" FontSize="10"
                                         PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown" IsTabStop="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="序号" Width="Auto" MinWidth="40" MaxWidth="80" IsReadOnly="True" HeaderStyle="{StaticResource SelfDataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="No_TB" Text="{Binding No}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="风控检查备注" Width="200" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="RiskNoteTB" Margin="0,0,0,0" Text="{Binding RiskNote}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Foreground="red">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding Text, Converter={StaticResource subStringConverter}, ConverterParameter=250}" TextWrapping="Wrap" MaxWidth="200"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                                <!--<Image Margin="1,0,0,0" Source="/STC.XBond.Plugin;component/Images/stc_icon_input_search_typing.png" Width="20" Height="20" VerticalAlignment="Center"/>-->
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="投资组合名称" Width="200">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <comp:MultiTreeComboBox Height="24"  Margin="0 0 0 0"  x:Name="cmbMultiTree"
                            VerticalAlignment="Center" Foreground="{StaticResource ComboBoxItem.Static.Foreground}"
                            TreeItemsSource="{Binding DataContext.MultiTreeComboxItemsSource,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                            IsEnableMultiSelect="False" DefaultText="" IsEnableSelectRootNode="False" IsEnableSearch="True" DisplayPath="PA"
                            SelectedId="{Binding SelectedTradeAccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem2="{Binding SelectedTradeAccountCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedTexts="{Binding SelectedTradeAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentId="{Binding SelectedGroupItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentTexts="{Binding SelectedGroupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentItems="{Binding SelectedGroupDict, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedProductId="{Binding SelectedProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                <comp:MultiTreeComboBox.TreeItemItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                        <StackPanel Orientation="Horizontal" Height="24">
                                            <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Tag="{Binding Id}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TreeCheckBoxButton}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding  RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                                    <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                                    <Condition Binding="{Binding IsLeaf}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                                    <Condition Binding="{Binding IsGroup}" Value="False"/>
                                                                    <Condition Binding="{Binding IsLeaf}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                                    <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                                    <Condition Binding="{Binding IsLeaf}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!--<Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>-->
                                            <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Checked}" Value="1">
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                            <TextBlock Margin="2, 0, 0, 0" Text="{Binding ProductId, StringFormat=({0}), TargetNullValue=(空)}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#FFFFFF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProductId}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ProductId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                    </HierarchicalDataTemplate>
                                </comp:MultiTreeComboBox.TreeItemItemTemplate>
                            </comp:MultiTreeComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayAccountName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayAccountName}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="交易员" Width="Auto" MinWidth="40" MaxWidth="300">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <!--<TextBlock x:Name="No_Trader" Text="{Binding Trader_Buyer}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>-->
                                <comp:AutoCompleteComboBox x:Name="TraderCb_edit" Height="20" Width="100" Margin="5 0 0 0" 
                                                       DisplayValuePath="Name"
                                                       SelectedItem="{Binding SelectedTrader_Buy_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding Trader_Buy_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown ="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="交易员" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="TraderCb_edit_PatternChanged"  IsTabStop="False">
                                    <comp:AutoCompleteComboBox.AutoCompColumns>
                                        <DataGridTemplateColumn MinWidth="100" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent">
                                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Content="{Binding Text}"/>
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </comp:AutoCompleteComboBox.AutoCompColumns>
                                </comp:AutoCompleteComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Trader_Buy_Edit}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Trader_Buy_Edit}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="对谁可见" Width="Auto" MinWidth="40" MaxWidth="300">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <comp:MultiSelectComboBox x:Name="OtherInvestors" Width="120" Height="23" VerticalContentAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" DefaultText="" 
                                                      SelectedValues="{Binding RelatedUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      ItemsSource="{Binding DataContext.RelatedUsersDic,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}">
                            </comp:MultiSelectComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RelatedUsers}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelatedUsers}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="方向" MinWidth="55" Width="65" MaxWidth="80" CanUserSort="True" SortMemberPath="Side">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!--编辑部分-->
                            <ComboBox x:Name="cbSide_edit" Height="18" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding DataContext.SideDic,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" 
                                          DisplayMemberPath="Value"  SelectedValuePath="Key" Grid.Column="2"
                                          SelectedValue="{Binding Side_Edit,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{DynamicResource NonEditableComboBoxStyle}"
                                      FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--显示部分-->
                            <Border x:Name="SideBorder">
                                <TextBlock x:Name="SideTB_display" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Width="45" Style="{StaticResource SideTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <!--没有方向-->
                                <DataTrigger Binding="{Binding Side,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="SideBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="SideBorder" Property="BorderBrush" Value="red"/>
                                    <Setter TargetName="SideTB_display" Property="Text" Value="方向"/>
                                    <Setter TargetName="SideTB_display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="代码" MinWidth="80" Width="100" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="代码" VerticalAlignment="Center"/>
                                <Button x:Name="CopyCodeBtn" Style="{DynamicResource CopyButton}" Width="20" Height="20" Grid.Column="1" Margin="5 0 0 0" Click="CopyCodeBtn_Click" IsTabStop="False"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="SecurityIDTB" Text="{Binding SecurityId}"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecurityId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="简称" MinWidth="80" Width="100" MaxWidth="150" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Symbol" Text="{Binding Symbol}"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Symbol}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="报价" MinWidth="80" Width="80" MaxWidth="100" CanUserSort="True" SortMemberPath="Price">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="报价" VerticalAlignment="Center"/>
                                <Button x:Name="ClearPriceBtn" Style="{DynamicResource DeleteButton}" Width="20" Height="20" Grid.Column="1" Margin="5 0 0 0" Click="ClearPriceBtn_Click" IsTabStop="False"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--编辑部分-->
                            <comp:NumericUpDown x:Name="PriceNU_Edit" ValueChanged="PriceNU_Edit_ValueChanged"
                                                NumericValue="{Binding Price,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                MinValue="-100" MaxValue="9999" ToolTip="输入范围[-100,999]" DecimalLength="4" RangeValue="0.0025" VerticalAlignment="Center" AllowEmpty="True"
