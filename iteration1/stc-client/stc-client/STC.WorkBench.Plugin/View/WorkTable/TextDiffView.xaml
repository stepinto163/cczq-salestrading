<comp:WindowBase x:Class="STC.WorkBench.Plugin.View.WorkTable.TextDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkBench.Plugin.View.WorkTable"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" Title="需求发生修改" Loaded="WindowBase_Loaded"
             Width="460" Height="360"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="24"/>
            <RowDefinition/>
            <RowDefinition Height="24"/>
            <RowDefinition/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <TextBlock Text="原始内容:" VerticalAlignment="Center" Margin="10 0 0 0" Grid.Row="1"/>

        <RichTextBox x:Name="ori_txt" Grid.Row="2" Margin="10" Background="Black" Foreground="#FFFFFF" FontWeight="Bold" Padding="2" IsReadOnly="true"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#3C3C3C"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Left"/>

        <TextBlock Text="新内容:" VerticalAlignment="Center" Margin="10 0 0 0" Grid.Row="3"/>

        <RichTextBox x:Name="new_txt" Grid.Row="4" Margin="10" Background="Black" Foreground="#FFFFFF" FontWeight="Bold" Padding="2" IsReadOnly="true"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#3C3C3C"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Left"/>

        <Button x:Name="know_btn" Content="我知道了" Grid.Row="5" Width="100" Height="32" Click="know_btn_Click" Style="{DynamicResource SlateGrayStyle}"/>
    </Grid>
</comp:WindowBase>
