                                    <ComboBoxItem Content="T+1" Tag="2"></ComboBoxItem>
                                </ComboBox>
                            </StackPanel>-->
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="settlTypeBorder">
                                <!--显示部分-->
                                <TextBlock x:Name="settlType_dispay" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"  FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SettlType,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="settlTypeBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="settlTypeBorder" Property="BorderBrush" Value="red"/>
                                    <Setter TargetName="settlType_dispay" Property="Text" Value="--"/>
                                    <Setter TargetName="settlType_dispay" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="报价标准" MinWidth="55" Width="55" MaxWidth="120" CanUserSort="True" SortMemberPath="Side">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--编辑部分-->
                            <ComboBox x:Name="cbPriceType_edit" Height="18" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding PriceTypeDic}" 
                                          DisplayMemberPath="Value"  SelectedValuePath="Key" Grid.Column="2"
                                          SelectedValue="{Binding PriceType,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{DynamicResource NonEditableComboBoxStyle}"
                                          FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
