                                                            <Run Text="自动撤回"  Foreground="{DynamicResource ColorBrush.Gray14}"/>
                    </TextBlock>
                    <!--时长-->
                    <StackPanel Orientation="Horizontal" Height="24" Grid.Column="0"  Margin="6, 0, 0, 0"  Visibility="{Binding HourValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                        <comp:WatermarkTextBox WaterMark="" ContextMenu="{x:Null}" Tag="1" MaxLength="3" x:Name="ValidMinute" PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput" Text="{Binding ValidMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputMethod.IsInputMethodEnabled="False" Width="28"  Height="24" Padding="0, 0, 0, 0" Style="{DynamicResource GreenBlueWatermarkTextBox}" IsTabStop="False">
                            <TextBox.ToolTip>
                                <ToolTip Content="输入范围:[0-500]分钟"></ToolTip>
                            </TextBox.ToolTip>
                        </comp:WatermarkTextBox>
                        <TextBlock Grid.Row="0" Text="分" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                        <comp:WatermarkTextBox  WaterMark="" ContextMenu="{x:Null}"  Margin="6,0,0, 0" Tag="3"  MaxLength="2"  x:Name="ValidSecond"   PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24" Padding="0, 0, 0, 0"  Style="{DynamicResource GreenBlueWatermarkTextBox}" IsTabStop="False">
                            <TextBox.ToolTip>
                                <ToolTip Content="输入范围:[0-60)"></ToolTip>
                            </TextBox.ToolTip>
                        </comp:WatermarkTextBox>
                        <TextBlock Grid.Row="0" Text="秒"  Height="16"  Margin="6, 0, 0, 0" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="后失效" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                    <!--时点-->
                    <StackPanel Orientation="Horizontal" Height="24"  Grid.Column="0"  Margin="10, 0, 0, 0" Visibility="{Binding TimeValidTimeQuotationCheck,Converter={StaticResource visibilityConvertor}}">
                        <comp:WatermarkTextBox  WaterMark="时" ContextMenu="{x:Null}" Tag="2" MaxLength="2" x:Name="ValidTimeHour"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False" Width="28" Height="24" Padding="0, 0, 0, 0" Style="{DynamicResource GreenBlueWatermarkTextBox}" IsTabStop="False">
                            <TextBox.ToolTip>
                                <ToolTip Content="输入范围:(0，24]"></ToolTip>
                            </TextBox.ToolTip>
                        </comp:WatermarkTextBox>
                        <TextBlock Grid.Row="0" Text=":"  Margin="6,0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                        <comp:WatermarkTextBox WaterMark="分" ContextMenu="{x:Null}"  Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="ValidTimeMinute"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24" Padding="0, 0, 0, 0"  Style="{DynamicResource GreenBlueWatermarkTextBox}" IsTabStop="False">
                            <TextBox.ToolTip>
                                <ToolTip Content="输入范围:[0-60)"></ToolTip>
                            </TextBox.ToolTip>
                        </comp:WatermarkTextBox>
                        <TextBlock Grid.Row="0" Text=":"   Margin="6, 0,0, 0" Height="16" HorizontalAlignment="Left" Grid.Column="0" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" />
                        <comp:WatermarkTextBox WaterMark="秒" ContextMenu="{x:Null}" Tag="0"  Margin="6,0,0, 0" MaxLength="2" x:Name="ValidTimeSecond"  PreviewKeyDown="ValidMinute_PreviewKeyDown"  PreviewTextInput="ValidMinute_PreviewTextInput"  Text="{Binding ValidTimeSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  InputMethod.IsInputMethodEnabled="False"   Width="28" Height="24" Padding="0, 0, 0, 0"  Style="{DynamicResource GreenBlueWatermarkTextBox}" IsTabStop="False">
                            <TextBox.ToolTip>
                                <ToolTip Content="输入范围:[0-60)"></ToolTip>
                            </TextBox.ToolTip>
                        </comp:WatermarkTextBox>
                        <TextBlock Grid.Column="1" Text="失效" Margin="6, 0, 0, 0" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource ColorBrush.Gray14}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="BrokerTextBox" IsHitTestVisible="False" Text="Trader:"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0" FontSize="12"
                           Foreground="#FFFFFF"/>

                <comp:AutoCompleteComboBox x:Name="BrokerCb_edit" Height="20" Width="100" Margin="5 0 0 0"
                                                       DisplayValuePath="Name"
                                                       SelectedItem="{Binding SelectedBroker_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding BrokerName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="Trader" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="BrokerCb_edit_PatternChanged" IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn MinWidth="100" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding Username }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn MinWidth="100" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding Name }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>

                <CheckBox Content="急" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="24" IsTabStop="False"
                          IsChecked="{Binding HurryFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
                <CheckBox Content="荐" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="24" IsTabStop="False"
                          IsChecked="{Binding SuggestFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
                <CheckBox Content="火" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="24" IsTabStop="False"
                          IsChecked="{Binding FireFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>

                <CheckBox Content="底" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" Width="24" Margin="10 0 0 0" IsTabStop="False"
                          IsChecked="{Binding FloorPrice, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>
                <CheckBox Content="oco" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="42" IsTabStop="False"
                          IsChecked="{Binding OcoFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}" />
                <CheckBox Content="打包" Style="{DynamicResource TagCheckBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="4 0 0 0" Height="24" Width="42" IsTabStop="False"
                          IsChecked="{Binding OcoFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='2'}"/>

                <!--<comp:MultiSelectComboBox x:Name="TagCB" Width="60" Height="24" Margin="4 0 0 0" ItemsSource="{Binding TagDic}" FilterDicChanged="TagCB_FilterDicChanged"/>-->
                
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="InvestorTB" Text="投资经理" VerticalAlignment="Center" Margin="5 0 5 0" Foreground="#FFFFFF" Visibility="Collapsed"/>
                <comp:AutoCompleteComboBox x:Name="Investor_edit" Height="20" Width="100" Visibility="Collapsed"
                                                       DisplayValuePath="Name"
                                                       SelectedItem="{Binding SelectedInvestor_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding Investor_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="投资经理" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="Investor_edit_PatternChanged"  IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn  Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding Name }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>
                <!--<TextBlock Text="客户名:" Style="{StaticResource TitleTBFont}" VerticalAlignment="Center" Margin="5 3 5 0" Foreground="#FFFFFF"/>-->
                <TextBlock x:Name="TraderTB" Text="交易员" VerticalAlignment="Center" Margin="5 0 5 0" Foreground="#FFFFFF" Visibility="Collapsed"/>                
                <comp:AutoCompleteComboBox x:Name="TraderCb_edit" Height="20" Width="100" Margin="5 0 0 0"  Visibility="Collapsed"
                                                       DisplayValuePath="Name"
                                                       SelectedItem="{Binding SelectedTrader_Buy_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding Trader_Buy_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown ="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="交易员" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="TraderCb_edit_PatternChanged"  IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn MinWidth="100" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>
                
                <TextBlock x:Name="clientTB" Text="来源方:" VerticalAlignment="Center" Margin="5 0 5 0" Foreground="#FFFFFF"/>
                <comp:AutoCompleteComboBox x:Name="InsNameCb_edit" Height="20" Width="100"
                                                       DisplayValuePath="shortnamecn" LostFocus="InsNameCb_edit_LostFocus"
                                                       SelectedItem="{Binding SelectedInstintuion_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding InstitutionName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="来源方机构" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedInstitutionCB_PatternChanged" IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn  Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>
                <!--<TextBlock Text="客户名:" Style="{StaticResource TitleTBFont}" VerticalAlignment="Center" Margin="5 3 5 0" Foreground="#FFFFFF"/>-->
                <comp:AutoCompleteComboBox x:Name="TrdNameCb_edit" Height="20" Width="100" Margin="5 0 0 0"
                                                       DisplayValuePath="namecn" LostFocus="TrdNameCb_edit_LostFocus"
                                                       SelectedItem="{Binding SelectedTrader_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding TraderName_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       PreviewMouseDown ="AutoComplateCb_edit_PreviewMouseDown"
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="来源方" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedUserIDCB_PatternChanged" IsTabStop="False">
                    <comp:AutoCompleteComboBox.AutoCompColumns>
                        <DataGridTemplateColumn MinWidth="100" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding namecn}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn MinWidth="100" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding instname}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </comp:AutoCompleteComboBox.AutoCompColumns>
                </comp:AutoCompleteComboBox>

                <Grid x:Name="tagGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="vipChk" Content="VIP" Foreground="{DynamicResource ColorBrush.Yellow-1}" Width="40" FontStyle="Italic" FontWeight="Bold" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray-23}" IsChecked="{Binding IsVip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Style="{DynamicResource DefaultCheckBoxStyle}" Background="Transparent" Padding="0,0,0,0" Margin="5,0,0,0" IsTabStop="False"/>
                    <comp:AutoCompleteComboBox x:Name="cbClientType" Height="24" Width="100" Margin="1 0 0 0" Grid.Column="1"
                                                       DisplayValuePath="shortnamecn"
                                                       SelectedItem="{Binding SelectClientTypeItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding ClientTypeEnum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="客户类型" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="SelectedClientType_PatternChanged" IsTabStop="False">
                        <comp:AutoCompleteComboBox.AutoCompColumns>
                            <DataGridTemplateColumn MinWidth="50" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                <TextBlock.ToolTip>
                                                    <ToolTip Content="{Binding Text}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </comp:AutoCompleteComboBox.AutoCompColumns>
                    </comp:AutoCompleteComboBox>
                </Grid>
                <StackPanel Orientation="Horizontal" Visibility="{Binding AccountUserVisibility}">
                    <TextBlock Text="投组账户" VerticalAlignment="Center" Margin="5,8,0,8" Foreground="#FFFFFF"/>
                    <ComboBox x:Name="AccountUserCbc" ItemsSource="{Binding AccountUserSource}" Style="{DynamicResource GreenBlueComboBoxStyle}" 
                      SelectedItem="{Binding AccountUserItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Width="100" Height="24" Margin="14,3,0,3" VerticalContentAlignment="Center"
                      HorizontalAlignment="Left" IsTabStop="False">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" />
                                    <TextBlock x:Name="midTB" Text="-" />
                                    <TextBlock Text="{Binding AccountName}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Id, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                        <Setter TargetName="midTB" Property="Text" Value=""/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="priceTypeTB" Text="报价标准" VerticalAlignment="Center" Margin="5 0 5 0" Foreground="#FFFFFF"/>
                <ComboBox x:Name="cbPriceType_edit" Height="24" Width="100" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding PriceTypeEmptyDic}" 
                                          DisplayMemberPath="Value"  SelectedValuePath="Key" Grid.Column="2"
                                          SelectedValue="{Binding PriceType,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{DynamicResource NonEditableComboBoxStyle}"
                                          FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                            SelectionChanged="cbPriceType_edit_SelectionChanged">
                </ComboBox>
            </StackPanel>

            
        </Grid>

        <Grid Grid.Row="5" Grid.RowSpan="2" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <comp:WatermarkTextBox x:Name="memo" WaterMark="个人笔记" Margin="4 0 4 4" IsTabStop="False" AcceptsReturn="True" TextWrapping="WrapWithOverflow"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch"
                               Text="{Binding PersonalRemarks, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            <comp:WatermarkTextBox x:Name="commandNote" WaterMark="指令备注" Margin="0 0 4 4" IsTabStop="False" AcceptsReturn="True" TextWrapping="WrapWithOverflow"
                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch"
                               Text="{Binding CommandNotes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Column="1" Visibility="Collapsed"/>

            <comp:WatermarkTextBox x:Name="mark" WaterMark="公告" Height="24" Margin="4 0 4 0" IsTabStop="False" VerticalAlignment="Center"
                               Text="{Binding PublicRemarks, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Grid.Row="1"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Grid.Row="1">
                <Button x:Name="clear_button" Width="60" Height="24" Style="{DynamicResource GraySlateButtonStyle}" Click="clear_button_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">清空</Button>
                <!--<Button x:Name="close_button" Width="60" Height="24" Margin="4,0,4,0" Style="{DynamicResource GrayButtonStyle}" Click="close_button_Click">取消</Button>-->
                <!--<Button x:Name="firm_button" Width="60" Height="24" Margin="4 0 0 0" Style="{DynamicResource BlueGreenStyle}" Click="firm_button_Click" IsEnabled="{Binding IsFirmPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">Firm发布</Button>-->
                <Button x:Name="copy_button" Width="60" Height="24" Margin="4 0 0 0" Style="{DynamicResource BlueGreenStyle}" Click="copy_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">复制</Button>
                <Button x:Name="nf_button" Width="60" Height="24" Margin="4 0 0 0" Style="{DynamicResource BlueGreenStyle}" Click="nf_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsEnabledChanged="nf_button_IsEnabledChanged">发内部</Button>
                <Button x:Name="ok_button" Width="60" Height="24" Margin="4 0 0 0" Style="{DynamicResource BlueGreenStyle}" Click="ok_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">发个需</Button>
                <Button x:Name="demand_button" Width="60" Height="24" Margin="4 0 4 0" Style="{DynamicResource BlueGreenStyle}" Click="demand_button_Click" IsEnabled="{Binding IsPublishBtnEnable}" Foreground="#D7D7D7" BorderThickness="0 1 0 0" IsTabStop="False">发私域池</Button>
            </StackPanel>
        </Grid>
    </Grid>
</comp:WindowBase>
