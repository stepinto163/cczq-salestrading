                                    <Setter TargetName="wholeTag" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>-->
                </DataGridTemplateColumn>
                <!--<DataGridTemplateColumn Header="整量" MinWidth="70" Width="70" MaxWidth="90" CanUserSort="True" SortMemberPath="Qty">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            -->
                <!--编辑部分-->
                <!--
                            <CheckBox IsChecked="{Binding WholeFlag, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Converter={StaticResource booleanConvertor}}"
                                      Style="{StaticResource WholeFlagCheckBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            -->
                <!--显示部分-->
                <!--
                            <Border x:Name="wholeTag" Background="#136C5E" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed">
                                <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                                    <Setter TargetName="wholeTag" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTemplateColumn Header="清算速度" MinWidth="80" Width="80" MaxWidth="145" CanUserSort="True" SortMemberPath="SettlType" HeaderStyle="{StaticResource SelfDataGridColumnHeaderLeftStyle}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!--编辑部分-->
                            <localcomp:SettleTypeSelector SettleType="{Binding SettlType_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"
                                                     CreateTime="{Binding CreateTime}"
                                                     FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"/>
                            <!--<StackPanel x:Name="settltype_panel_edit" Orientation="Horizontal">
                                <DatePicker x:Name="datePicker" Width="70" Height="24" 
                                                
                                        SelectedDate="{Binding edit_settltype_date,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Style="{StaticResource SettlTypeDatePickerStyle}"
                                            CalendarStyle="{StaticResource BlackRed_CalendarStyle}">
                                    <DatePicker.Resources>
                                        <Style TargetType="DatePickerTextBox">
                                            <Setter Property="IsReadOnly" Value="True"/>
                                        </Style>
