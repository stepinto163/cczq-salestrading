<comp:WindowBase x:Class="STC.WorkBench.Plugin.View.WorkTable.MatchExeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkBench.Plugin.View.WorkTable"
             xmlns:val ="clr-namespace:STC.WorkBench.Plugin.Validation"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:commConv="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" Title="匹配成交"
             d:DesignHeight="450" d:DesignWidth="800" Width="1500" Height="500">
    <Window.Resources>
        <ResourceDictionary>
            <commConv:DaysOffStrConverter x:Key="DaysOffCon"/>
            <commConv:ReverseVisibilityConvertor x:Key="reverseVisibilityConvertor"/>
            <commConv:VisibilityConvertor x:Key="visibilityConvertor"/>
            <commConv:BondFieldConvertor x:Key="BondFieldConvertor"/>
            <commConv:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <commConv:NumberConvertor3 x:Key="numConvertor3"/>
            <commConv:TreasuryFutureConvertor x:Key="treasuryFutureConverter"/>
            <commConv:MultiCompareConverter x:Key="multiCompareConverter"/>

            <SolidColorBrush x:Key="ColorBrush.Yellow" Color="#C29B4E"></SolidColorBrush>

            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Delflag}" Value="1">
                        <Setter Property="Foreground" Value="{StaticResource Text.Foreground.NoPermission}"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 居中 -->
            <Style x:Key="SelfDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>

            <!-- 图标样式 -->
            <Style x:Key="InfoIconStyle" TargetType="Path">
                <Setter Property="Fill" Value="Gray"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource SlateGrayButton.MouseOver.Background}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
            <RowDefinition/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentItem.InvestorName}" Margin="4 0 4 0"/>
            <TextBlock Text="{Binding CurrentItem.RemainingTime}" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Text="{Binding CurrentItem.SecurityId}" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Text="{Binding CurrentItem.Symbol}"  Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Text="{Binding CurrentItem.Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}"  Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Width="100"/>
            <TextBlock Text="已匹配成交量"/>
            <TextBlock Text="{Binding RelatedQty, StringFormat={}{0:0}}"/>
            <TextBlock Text="/"/>
            <TextBlock Text="{Binding CurrentItem.Qty, StringFormat={}{0:0}}"/>
            <TextBlock Text="万"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <comp:MultiSelectComboBox x:Name="venusCB" Width="130" Height="22" VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" Margin="4 0 4 0" DefaultText="渠道不限"
                                      FilterDicChanged="venusCB_FilterDicChanged">
            </comp:MultiSelectComboBox>
            <comp:FilterOptions x:Name="matchStatusFQ" Margin="4 0 4 0" TagKey="MATCH_STATUS" TagsListChanged="matchStatusFQ_TagsListChanged"/>
            <Button x:Name="RefreshBtn" Content="刷新" Margin="6 0 0 0" Style="{DynamicResource BlueButtonStyle}" Click="RefreshBtn_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" Style="{DynamicResource DefaultDataGrid}" ItemsSource="{Binding Mv.View}" 
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Delflag}" Value="1">
                            <Setter Property="Foreground" Value="#9D9D9D" />
                            <!--<Setter Property="FontSize" Value="10"/>-->
                            <Setter Property="FontStyle" Value="Italic"/>
                            <!--<Setter Property="Opacity" Value="0.5"/>-->
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <!--勾选-->
                <DataGridTemplateColumn x:Name="checkedColumn" Header="勾选" MinWidth="40" Width="40" MaxWidth="40" HeaderStyle="{StaticResource SelfDataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" 
                                                    IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Style="{DynamicResource DefaultCheckBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Style="{DynamicResource DefaultCheckBoxStyle}"></CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="状态" Binding="{Binding Delflag,  Converter={StaticResource EnumTypeConvertor}, ConverterParameter='delflag'}"/>
                <DataGridTextColumn Header="来源" Binding="{Binding Entrytype}"/>
                <DataGridTextColumn Header="渠道"  Binding="{Binding Venues,Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues_exept'}" />
                <DataGridTemplateColumn Header="剩余期限" Width="Auto" MinWidth="105" SortMemberPath="RemaingingTime_convert">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                            <Setter Property="Padding" Value="9,0,5,0"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="remainingTimetb" Grid.Column="1" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding RemainingTime}">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Text}"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                                <Border Grid.Column="2" x:Name="DayOff_Tag" BorderBrush="#C29B4E" BorderThickness="1" CornerRadius="2" Background="#C29B4E" Margin="2 0 0 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="休" Background="Black" Foreground="#C29B4E" FontSize="10" FontWeight="Bold" Padding="1"/>
                                        <TextBlock Text="{Binding DayOffStr, Converter={StaticResource DaysOffCon}}" Grid.Column="1" Foreground="Black" FontSize="10" FontWeight="Bold" Padding="1"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DayOffStr, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="DayOff_Tag" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RemainingTime}" Value="已到期">
                                    <Setter TargetName="remainingTimetb" Property="Foreground" Value="#B03131"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="债券代码" Binding="{Binding SecurityID}"/>
                <DataGridTextColumn Header="债券简称" Binding="{Binding Symbol}"/>
                <DataGridTextColumn Header="方向" Width="50" Binding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side_pt'}" CellStyle="{StaticResource ColumnColorStyle}"/>
                <DataGridTextColumn Header="成交价(%)" Width="Auto" MinWidth="80" SortMemberPath="LastPx"
                                FontWeight="SemiBold">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource BondFieldConvertor}" ConverterParameter="Price">
                            <Binding Path="LastPx_Display" />
                            <Binding Path="MarketIndicator" />
                            <Binding Source="Price" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="成交价(元)" Binding="{Binding NetPrice}"/>
                <DataGridTextColumn Header="成交量(万)" MinWidth="80">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource BondFieldConvertor}" ConverterParameter="Amount">
                            <Binding Path="LastQty" />
                            <Binding Path="MarketIndicator" />
                            <Binding Source="Amount" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="已匹配量(万)">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="已匹配量(万)" VerticalAlignment="Center"/>
                                <Viewbox Width="14" Height="14">
                                    <Path Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource InfoIconStyle}"
                                        Data="M8,0 C3.58,0 0,3.58 0,8 C0,12.42 3.58,16 8,16 C12.42,16 16,12.42 16,8 C16,3.58 12.42,0 8,0 Z M8.93,12.588 L7.07,12.588 L7.07,10.646 L8.93,10.646 L8.93,12.588 Z M8.93,9.293 L7.07,9.293 L7.07,3.411 L8.93,3.411 L8.93,9.293 Z"
                                        ToolTip="非个需向匹配的成交量">
                                    </Path>
                                </Viewbox>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OtherUsedQty, StringFormat={}{0:0}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="本个需匹配量(万)" Width="100" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="outer_bd" BorderBrush="Transparent">
                                <comp:NumericUpDown x:Name="bindQty_Edit"
                                                Background="#0F0F0F"
                                                MinValue="0" MaxValue="99999999" DecimalLength="0" RangeValue="100" VerticalAlignment="Center"
                                                FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" AllowEmpty="True"
                                                ToolTip="输入范围:1-99999999">
                                    <comp:NumericUpDown.NumericValue>
                                        <Binding Path="BindQty_Edit" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                                            <Binding.ValidationRules>
                                                <val:MatchExecValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </comp:NumericUpDown.NumericValue>
                                </comp:NumericUpDown>
                            </Border>
                            
                            <!--<TextBox x:Name="bindQty_Edit" Text="{Binding BindQty_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle1}"/>-->
                            <DataTemplate.Triggers>
                                <DataTrigger Value="False">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource multiCompareConverter}">
                                            <Binding Path="BindQty_Edit"/>
                                            <!-- 第一个要比较的属性 -->
                                            <Binding Path="BindQty"/>
                                            <!-- 第二个要比较的属性 -->
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="outer_bd" Property="BorderBrush" Value="Orange"/>
                                    <Setter TargetName="outer_bd" Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="本方交易员" Width="Auto" MinWidth="80" Binding="{Binding PartySubName}"/>
                <DataGridTemplateColumn Header="终端机构" Width="Auto" MinWidth="90"  MaxWidth="200" ClipboardContentBinding="{Binding Realcounterpartyname, Converter={StaticResource StringConvertor}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Realcounterpartyname, Converter={StaticResource StringConvertor}}" TextTrimming="CharacterEllipsis" 
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="发单对手机构" Width="Auto" MinWidth="80"  MaxWidth="200" ClipboardContentBinding="{Binding CounterPartyName, Converter={StaticResource StringConvertor}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPartyName, Converter={StaticResource StringConvertor}}" TextTrimming="CharacterEllipsis" 
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="对手方交易员" Width="Auto" MinWidth="90"  MaxWidth="200" ClipboardContentBinding="{Binding CounterPartySubName, Converter={StaticResource StringConvertor}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CounterPartySubName, Converter={StaticResource StringConvertor}}" TextTrimming="CharacterEllipsis" 
       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="风控检查备注"  Width="Auto" MinWidth="70" MaxWidth="200" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RiskRemark,Converter={StaticResource StringConvertor}}" TextTrimming="CharacterEllipsis" 
                                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="交易日期"  MinWidth="70"  Binding="{Binding TradeDate}"/>
                <DataGridTemplateColumn Header="清算速度" Width="Auto" MinWidth="70" SortMemberPath="SettlType">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="SettlType_display" Foreground="#FFFFFF" Text="{Binding SettlType}" Padding="0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstitutionName}"></TextBlock>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDelete}" Value="1">
                                    <Setter Property="Foreground" TargetName="SettlType_display" Value="{StaticResource Text.Foreground.NoPermission}"/>
                                    <Setter Property="FontFamily" TargetName="SettlType_display" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="SettlType_display" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="SettlType_display" Value="Italic" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="创建日期" Width="auto" Binding="{Binding Createtime}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3">
            <Button x:Name="CancelBtn" Content="取消" Style="{DynamicResource BlueButtonStyle}" HorizontalAlignment="Right"  Margin="4 0 194 0" Click="CancelBtn_Click"/>
            <Button x:Name="SaveBtn" Content="保存"  IsEnabled="{Binding CanSave}" Style="{DynamicResource BlueButtonStyle}"  HorizontalAlignment="Right" Margin="4 0 112 0" Click="SaveBtn_Click"/>
            <Button x:Name="SaveAndFinishBtn" Content="保存并完成个需" Width="100"  IsEnabled="{Binding CanSave}" Style="{DynamicResource BlueButtonStyle}" HorizontalAlignment="Right" Margin="4 0 10 0" Click="SaveAndFinishBtn_Click"/>
        </Grid>
    </Grid>
</comp:WindowBase>
