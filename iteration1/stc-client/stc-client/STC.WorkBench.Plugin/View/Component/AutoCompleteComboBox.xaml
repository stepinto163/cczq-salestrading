<TextBox x:Class="STC.WorkBench.Plugin.View.Component.AutoCompleteComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.WorkBench.Plugin.View.Component"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             x:Name="SearchTermTextBox" VerticalAlignment="Stretch"
                 PreviewKeyDown="tbSearch_PreviewKeyDown"
                 KeyDown="tbSearch_KeyDown"
                 GotFocus="tbSearch_GotFocus"
                 LostFocus="tbSearch_LostFocus" 
                 input:TextCompositionManager.PreviewTextInput="tbTraderAInfoChange_PreviewTextInput"
                 input:TextCompositionManager.PreviewTextInputUpdate="tbTraderAInfoChange_PreviewTextInputUpdate" 
                 TextBoxBase.TextChanged ="SearchTermTextBox_TextChanged" Margin="0,0">
    <TextBox.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.WorkBench.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <!--下拉按钮样式-->
            <Style x:Key="AutoCompleteComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Focusable" Value="false"/>
                <Setter Property="ClickMode" Value="Press"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="templateRoot" SnapsToDevicePixels="true" 
                                    Background="{Binding BackGroundCob, RelativeSource={RelativeSource AncestorType={x:Type local:AutoCompleteComboBox}, Mode=FindAncestor}}"
                                    BorderBrush="{DynamicResource TextBox.Static.Border}" BorderThickness="1 0 0 0">
                                <Border x:Name="splitBorder" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" SnapsToDevicePixels="true" Margin="0" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Transparent">
                                    <Path x:Name="arrow"  VerticalAlignment="Center"  HorizontalAlignment="Center"  Fill="{TemplateBinding Foreground}" Data="M0,0 L6,0 3,4 z"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--鼠标按下-->
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="templateRoot" Value="#3C3C3C"/>
                                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#515151"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--关闭按钮-->
            <Style x:Key="ClsoeButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsDefaulted" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="Transparent"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="border" Value="Transparent"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="Transparent"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border" Value="Transparent"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="Transparent"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </TextBox.Resources>
    
    <TextBox.Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{Binding BackGroundCob, RelativeSource={RelativeSource AncestorType={x:Type local:AutoCompleteComboBox}, Mode=FindAncestor}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBox.Focus.Foreground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AllowDrop" Value="true"/>
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>

            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                                Value="{Binding RelativeSource={RelativeSource Self}
                            ,Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                        <Condition Property="IsSelectionActive" Value="false"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </TextBox.Style>


    <TextBox.Template>
        <ControlTemplate>
            <Border x:Name="border" CornerRadius="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Grid Focusable="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="18"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="closeButton" Style="{DynamicResource ClsoeButtonStyle}"
                                            HorizontalAlignment="Right" 
                                            Width="20"
                                            Background="Transparent" BorderThickness="0"
                                            Margin="0"
                                            Click="closeButton_Click" Visibility="Visible">
                        <Image x:Name="SearchImage" Source="/STC.WorkBench.Plugin;component/Images/stc_icon_login_close.png"/>

                    </Button>

                    <TextBlock x:Name="HintTextBox" IsHitTestVisible="False" Text="{Binding Watermark, RelativeSource={RelativeSource AncestorType={x:Type local:AutoCompleteComboBox}, Mode=FindAncestor}}" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,1,0,0" FontSize="12"
                        Foreground="{DynamicResource TextBox.Static.Border}"/>

                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="1,0,20,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>

                    <ToggleButton x:Name="toggleBtn" Click="toggleBtn_Click" Style="{DynamicResource AutoCompleteComboBoxToggleButton}" ClickMode="Press" Grid.Column="1"></ToggleButton>

                    <Popup x:Name="popBondCode" PlacementTarget="{Binding ElementName=SearchTermTextBox}" StaysOpen="False" MaxHeight="300"
                            PopupAnimation="Slide" AllowsTransparency="False" Grid.ColumnSpan="2">
                        <Border BorderBrush="#282828" BorderThickness="1" >
                            <DataGrid x:Name="dgBondCode" Grid.Row="0"
                                    Style="{DynamicResource DefaultDataGrid}"
                                    HeadersVisibility="None"
                                    BorderThickness="0"       
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.ScrollUnit="Pixel"
                                    ScrollViewer.CanContentScroll="True"
                                    Margin="0" 
                                    Width="300"
                                    MouseUp="dgBondCode_MouseUp"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden">

                                <DataGrid.Resources>
                                    <Style x:Key="tbStyle" TargetType="{x:Type TextBlock}">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.Disable.Background}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBox.Disable.Foreground}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TextBox.Disable.Border}"/>
                    <Setter Property="Foreground" TargetName="toggleBtn" Value="{DynamicResource TextBox.Disable.Foreground}"/>
                    <Setter Property="Background" TargetName="toggleBtn"  Value="{DynamicResource TextBox.Disable.Background}"/>
                    <Setter Property="BorderBrush" TargetName="toggleBtn" Value="{DynamicResource TextBox.Disable.Border}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.MouseOver.Background}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{Binding MouseOverBorderBrushCob, RelativeSource={RelativeSource AncestorType={x:Type local:AutoCompleteComboBox}, Mode=FindAncestor}}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="true">
                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.Focus.Background}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
                    <Setter Property="BorderBrush" TargetName="border" Value="{Binding FocusBorderBrushCob, RelativeSource={RelativeSource AncestorType={x:Type local:AutoCompleteComboBox}, Mode=FindAncestor}}"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                    <Setter Property="Visibility" TargetName="closeButton" Value="Collapsed"/>
                    <Setter Property="Visibility" TargetName="HintTextBox" Value="Visible"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </TextBox.Template>
</TextBox>