<UserControl x:Class="STC.WorkBench.Plugin.View.Component.WorkBenchFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"  
             FontSize="12" Height="24"
             d:DesignHeight="24" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" Height="24">
                <TextBlock x:Name="SourceLbl" Text="状态:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource QuotationList.SubTitle.Foreground}"/>
                <ListBox x:Name="StatusListBox" Background="Transparent"  SelectionMode="Extended" SelectionChanged="StatusListBox_SelectionChanged" Height="24">
                    <ListBox.Template>
                        <ControlTemplate>
                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                        </ControlTemplate>
                    </ListBox.Template>
                    <!--<ListBoxItem Content="有效" Style="{DynamicResource FilterListBoxItemDodgerBlueAllStyle}" IsSelected="True" Width="50" Height="20" FontFamily="{DynamicResource DefaultFont}" HorizontalContentAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal"  Margin="0,0,0,0" BorderThickness="0 1 0 0"/>-->
                    <ListBoxItem Content="待发布" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" IsSelected="True" Width="50" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="4,0,0,0"/>
                    <ListBoxItem Content="已发布" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" IsSelected="True" Width="50" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="4,0,0,0"/>
                    <ListBoxItem Content="REF"  Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="50" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0"/>
                    <ListBoxItem Content="已成交" Style="{DynamicResource InnerBoardFilterListBoxItemDodgerBlueStyle}" Width="50" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="4,0,0,0"/>
                    <!--<ListBoxItem Content="已删除"  Style="{DynamicResource FilterListBoxItemDodgerBlueStyle}" Width="50" Height="20" FontFamily="{DynamicResource DefaultFont}" FontWeight="Normal" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="4,0,0,0" BorderThickness="0 1 0 0"/>-->
                </ListBox>


            </StackPanel>
        </Border>
    </Grid>
</UserControl>
