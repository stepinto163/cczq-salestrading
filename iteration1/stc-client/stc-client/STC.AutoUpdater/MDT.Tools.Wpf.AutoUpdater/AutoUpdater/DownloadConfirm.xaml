<Window x:Class="MDT.Tools.Wpf.AutoUpdater.DownloadConfirm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动升级" Height="200" Width="525" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="White" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderThickness="2" BorderBrush="#FF2B6457">
        <Grid Background="#173D37">
            <Label Content="应用升级" Style="{StaticResource LabelForeGround}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Top"/>
            <Label Content="系统检查到有一个新版可用，你想现在就下载吗？" Style="{StaticResource LabelForeGround}" HorizontalAlignment="Left" Margin="30,25,0,0" VerticalAlignment="Top"/>
            <Label Content="名称： IDC Deal" Name="label3" Style="{StaticResource LabelForeGround}" HorizontalAlignment="Left" Margin="25,70,0,0" VerticalAlignment="Top"/>
            <Label Content="  从： 远程服务器" HorizontalAlignment="Left" Style="{StaticResource LabelForeGround}" Margin="30,90,0,0" VerticalAlignment="Top"/>
            <Image HorizontalAlignment="Left" Source="download.ico" Height="82" Margin="385,20,0,0" VerticalAlignment="Top" Width="82"/>
            <Button Content="确定" Name="btnOk" Click="btnOk_Click" Margin="150,140,0,0" Style="{StaticResource ButtonOkStyle}" IsDefault="True"/>
            <Button Content="跳过" Name="btnSkip" Click="btnSkip_Click" Margin="370,140,0,0" Style="{StaticResource ButtonCancelStyle}" IsDefault="True"/>
        </Grid>
    </Border>
</Window>
