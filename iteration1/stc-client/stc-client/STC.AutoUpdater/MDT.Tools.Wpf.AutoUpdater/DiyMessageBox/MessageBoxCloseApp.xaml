<Window x:Class="MDT.Tools.Wpf.AutoUpdater.DiyMessageBox.MessageBoxCloseApp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MDT.Tools.Wpf.AutoUpdater.DiyMessageBox"
        mc:Ignorable="d" Height="140" Width="420" Title="自动升级" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" Icon="information.ico" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#173D37">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="tbTitle" x:FieldModifier="public" Text="自动升级" Margin="10,0,0,0" Grid.Column="0" VerticalAlignment="Center" Foreground="#F4E1C0" FontFamily="MicrosoftYaHei" FontSize="11px"></TextBlock>
        <Button x:Name="btnClose" Grid.Column="2" Foreground="White" Margin="0,0,2,0" HorizontalAlignment="Right" Style="{StaticResource ImageCloseButton}" Width="20" Height="20" Click="Button_Click" IsCancel="True"></Button>

        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="1">
            <Image x:Name="image" Source="information.ico" Height="48" Margin="30,0,0,0" Width="48"/>
            <TextBlock Name="uiTxtinfo" VerticalAlignment="Center" Text="进程 IDC 正在运行,请确定是否要关闭!" Margin="20,0" Foreground="Wheat" FontSize="15"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="2">
            <Button x:Name="btnOk" Content="是(Y)" Click="btnOk_Click" Margin="115,0,0,0"   Style="{StaticResource ButtonOkStyle}" IsDefault="True"/>
            <Button x:Name="btnCancel" Content="否(N)" Click="btnCancel_Click" Margin="30,0,0,0" IsCancel="True" Style="{StaticResource ButtonCancelStyle}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
