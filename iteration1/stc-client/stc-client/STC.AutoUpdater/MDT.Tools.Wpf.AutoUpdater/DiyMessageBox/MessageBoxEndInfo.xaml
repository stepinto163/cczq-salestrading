<Window x:Class="MDT.Tools.Wpf.AutoUpdater.DiyMessageBox.MessageBoxEndInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MDT.Tools.Wpf.AutoUpdater.DiyMessageBox"
        mc:Ignorable="d"
        Title="自动升级" Height="140" Width="520" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Icon="information.ico" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#173D37">
        <Grid.RowDefinitions>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="40*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="tbTitle" x:FieldModifier="public" Text="自动升级" Margin="10,0,0,0" Grid.Column="0" VerticalAlignment="Center" Foreground="#F4E1C0" FontFamily="MicrosoftYaHei" FontSize="11px"></TextBlock>
        <Button x:Name="btnClose" Grid.Column="2" Foreground="White" Margin="0,0,2,0" HorizontalAlignment="Right" Style="{StaticResource ImageCloseButton}" Width="20" Height="20" Click="Button_Click" IsCancel="True"></Button>

        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="1">
            <Image x:Name="image" Source="information.ico" Height="48" Width="48" Margin="30,0,0,0"/>
            <TextBlock Name="uiTxtinfo" VerticalAlignment="Center" Text="程序需要重新启动来应用更新，请单击确定重新启动程序！" Margin="10,0" Foreground="Wheat" FontSize="15"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="2">
            <Button x:Name="btnOk" Content="确定" Click="btnOk_Click" HorizontalAlignment="Left" Margin="380,0,0,0"  Style="{StaticResource ButtonOkStyle}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
