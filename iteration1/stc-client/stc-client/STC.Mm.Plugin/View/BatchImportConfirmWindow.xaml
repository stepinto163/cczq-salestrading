<base:WindowBase x:Class="STC.Mm.Plugin.View.BatchImportConfirmWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Mm.Plugin.View"
             xmlns:base="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" SizeToContent="Height" Width="300" Title="提示" MaxHeight="500"
                 x:Name="batchImport2ConfirmWin" Background="Black" MinWidth="500"
             d:DesignHeight="450" d:DesignWidth="800">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <TextBlock Text="本次导入债券数量" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="10 0 0 0"></TextBlock>
        <ItemsControl x:Name="excelImport" Background="Transparent" ItemsSource="{Binding FileImportInfo}" VirtualizingPanel.IsVirtualizing="True"
                 Grid.Row="1"   
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!--<ItemsControl.ItemContainerStyle>
                <Style TargetType="Control">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ItemsControl.ItemContainerStyle>-->
            <ItemsControl.Template>
                <ControlTemplate>
                    <ScrollViewer x:Name="ScrollViewer" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="10 0 0 0" Text="{Binding GroupName}"  Foreground="White"/>
                        <TextBlock Grid.Column="1" Text="{Binding ValidCount}" HorizontalAlignment="Right" Foreground="White"/>
                        <TextBlock Grid.Column="2" Text="/" HorizontalAlignment="Center"  Foreground="White"/>
                        <TextBlock Grid.Column="3" Text="{Binding TotalCount}" HorizontalAlignment="Left" Foreground="White"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="导入后的债券数量" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="10 0 0 0" Grid.Column="1"></TextBlock>
        <ItemsControl x:Name="afterImport" Background="Transparent" ItemsSource="{Binding AfterImportInfo}" VirtualizingPanel.IsVirtualizing="True"
                 Grid.Row="1" Grid.Column="1" Margin="1 0 0 0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!--<ItemsControl.ItemContainerStyle>
                <Style TargetType="Control">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ItemsControl.ItemContainerStyle>-->
            <ItemsControl.Template>
                <ControlTemplate>
                    <ScrollViewer x:Name="ScrollViewer" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="10 0 0 0" Text="{Binding GroupName}"  Foreground="White"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalCount}" HorizontalAlignment="Left"  Foreground="White"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border BorderBrush="#282828" Grid.Column="1" Grid.RowSpan="2" BorderThickness="1 0 0 0"></Border>
       
        
        <TextBlock Text="提示信息" Grid.Row="2" Grid.ColumnSpan="1" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="10 0 0 0"></TextBlock>
        <TextBlock Text="!导入会直接覆盖原有分组" Grid.Row="2" Grid.ColumnSpan="2" Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 0 0 0"></TextBlock>
        <!--<ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="3" Grid.ColumnSpan="2" Background="Black">
            <TextBlock x:Name="prompt" TextWrapping="Wrap" Text="{Binding afterImport}" FontSize="14" Foreground="#FFFFFF"/>
        </ScrollViewer>-->

        <ListBox Background="Transparent" ItemsSource="{Binding ErrorInfo}" VirtualizingPanel.IsVirtualizing="True"
                  Grid.Row="3" Grid.ColumnSpan="2"        
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Template>
                <ControlTemplate>
                    <ScrollViewer x:Name="ScrollViewer" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Foreground="#FFFFFF">
                        <Run Text="{Binding GroupName}"/><Run Text="债券" x:Name="zhaiquan"/><Run Text="{Binding SecurityID}" Foreground="#F9C152 "/><Run Text="{Binding ImportKey}"/><Run Text="{Binding ImportValue}" Name="sideRun"/><Run Text="{Binding ImportErrorResean}"/>
                    </TextBlock>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ImportValue}" Value="Bid">
                            <Setter Property="Foreground" TargetName="sideRun" Value="#FB943C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ImportValue}" Value="Ofr">
                            <Setter Property="Foreground" TargetName="sideRun" Value="#58B3FF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SecurityID,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                            <Setter Property="Text" TargetName="zhaiquan" Value="" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="2" BorderBrush="#282828" BorderThickness="0 1 0 0"/>
        <!--确认取消按钮区域-->
        <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="#282828" BorderThickness="0 1 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource  CancelButtonStyle}" Width="60" Height="24" Content="取消" Foreground="#FFFFFF" Command="{Binding CancelBtnCommand}" CommandParameter="{Binding ElementName=batchImport2ConfirmWin}"/>
                <Button Style="{StaticResource  ConfirmButtonStyle}" Width="100" Height="24" Content="确认" Foreground="#FFFFFF" Margin="10,0,0,0" 
                        Command ="{Binding ConfirmBtnCommand}" CommandParameter="{Binding ElementName=batchImport2ConfirmWin}"
                        Visibility="{Binding ConfirmVisible}"/>
            </StackPanel>
        </Border>
    </Grid>
</base:WindowBase>
