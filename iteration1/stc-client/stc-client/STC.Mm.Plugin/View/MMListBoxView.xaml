                        </Button.Content>
                    </Button>
                    <commComp:PopupEx x:Name="popOfrStrategyList" PlacementTarget="{Binding ElementName=ofrStrategyMode_btn}" StaysOpen="False" PopupAnimation="Slide" AllowsTransparency="False" Panel.ZIndex="111" Placement="Bottom"  Width="71">
                        <DataGrid x:Name="ofrStrategyList_dg" AutoGenerateColumns="False" BorderThickness="0"
                                              ItemsSource="{Binding ofrStrategyModeList}" HeadersVisibility="None" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                              MouseUp="ofrStrategyList_dg_MouseUp" LostFocus="ofrStrategyList_dg_LostFocus"  Style="{StaticResource ComboBoxPopDataGridStyle}" VerticalContentAlignment="Center">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn  Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Value}" Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </commComp:PopupEx>

                </DockPanel>
            </Border>


            <comp:HoverButton Content="修改参数" Width="60" Height="30" Margin="510,0,0,0" HorizontalAlignment="Left" Command="{Binding BatchUpdateCommand}"
                                           Padding="1" Style="{DynamicResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}" Visibility="Visible"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                           PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
            
            <TextBlock Foreground="#A0A0A0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 73 0">已选<Run Foreground="#FFFFFF" Text="{Binding CheckedCount}"/>条策略</TextBlock>

            <comp:HoverButton Content="删除" Width="50" Height="30" Margin="0,0,10,0" HorizontalAlignment="Right" Command="{Binding ToDelCommand}"
                                           Padding="1" Style="{DynamicResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                           PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
        </Grid>
    </Grid>
  
</UserControl>