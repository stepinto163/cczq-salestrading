<UserControl x:Class="STC.Mm.Plugin.View.MMSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:local="clr-namespace:STC.Mm.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded" Margin="20, 10, 20, 0">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--提交前需要注释掉，修改时可打开-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/DefaultSkin.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.Common;component/Resources/BlueSkin.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{DynamicResource DataGridColumnHeaderBackground}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment"  Value="Center"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="FontSize" Value="12"/>

            </Style>

            <Style x:Key="DataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="60"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DataGridStyle" TargetType="{x:Type DataGrid}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="None"/>
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Margin" Value="0,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridCell" >
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers >
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{Binding ShowBorderBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanContentScroll" Value="true"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
            
            <Style TargetType="Image" x:Key="ImageStyle">
                <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding BookType}" Value="R">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/root_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="P">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/group_1_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="A">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding BookType}" Value="">
                        <Setter Property="Source" Value="pack://application:,,,/STC.Frame;component/Images/leaf_normal.png" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush.Gray20}">
        <Grid Grid.Column="1" Visibility="Visible" Background="{DynamicResource MainListTitleBackgroup.ColorBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="210"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="120"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="做市义务提醒" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Bottom" Foreground="#788187" FontSize="14" FontWeight="Bold"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition  Width="35"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="09:25前未达标:" Grid.Column="0" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.White2}" 
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Right"/>
                    <CheckBox  Grid.Column="1"  TabIndex="-1" IsChecked="{Binding Tip1Enable, Mode=TwoWay}"
                               VerticalAlignment="Center" Margin="5, 3, 10, 0" BorderThickness="2"                                               
                               BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="16"                                                
                               FontSize="{DynamicResource SmallContentFontSize}" 
                               Style="{DynamicResource GreenBlueCheckedNormalCheckBox}"
                               Background="{DynamicResource ColorBrush.Transparent}"                                               
                               Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="提醒" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.Yellow}" FontSize="12" FontWeight="Bold"/>
                    
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="09:25-09:30未达标:" 
                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.White2}"
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Right"/>
                    <CheckBox Grid.Column="1" Grid.Row="1"  TabIndex="-1" IsChecked="{Binding Tip2Enable, Mode=TwoWay}"                               
                              VerticalAlignment="Center" Margin="5, 3, 10, 0" BorderThickness="2"                                                                           
                              BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="16"                                                                         
                              FontSize="{StaticResource SmallContentFontSize}" 
                              Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                              Background="{DynamicResource ColorBrush.Transparent}"                                                                           
                              Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="高强提醒" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.Yellow}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Grid.Column="0" Grid.Row="2" Text="09:29做市义务确认:" 
                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.White2}"
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Right"/>
                    <CheckBox Grid.Column="1" Grid.Row="2"  TabIndex="-1" IsChecked="{Binding Tip4Enable, Mode=TwoWay}"                               
                              VerticalAlignment="Center" Margin="5, 3, 10, 0" BorderThickness="2"                                                                           
                              BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="16"                                                                         
                              FontSize="{StaticResource SmallContentFontSize}" 
                              Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                              Background="{DynamicResource ColorBrush.Transparent}"                                                                           
                              Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="声音提醒" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.Yellow}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Grid.Column="0" Grid.Row="3" Text="盘中断报监控:" 
                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.White2}"
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Right"/>
                    <CheckBox Grid.Column="1" Grid.Row="3"  TabIndex="-1" IsChecked="{Binding Tip3Enable, Mode=TwoWay}"                               
                              VerticalAlignment="Center" Margin="5, 3, 10, 0" BorderThickness="2"                                                                           
                              BorderBrush="{DynamicResource ColorBrush.Gray15}" Height="16"                                                                         
                              FontSize="{DynamicResource SmallContentFontSize}" 
                              Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                              Background="{DynamicResource ColorBrush.Transparent}"                                                                           
                              Foreground="{DynamicResource ColorBrush.While}"></CheckBox>
                    <TextBlock Grid.Column="2" Grid.Row="3" Text="提醒" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.Yellow}" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <TextBlock Text="下单组合" Grid.Row="2" Margin="10, 0, 0, 0" VerticalAlignment="Bottom" Foreground="#788187" FontSize="14" FontWeight="Bold"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition  Width="150"/>
                        <ColumnDefinition  Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="默认下单组合:" Grid.Column="0" VerticalAlignment="Center" 
                               Foreground="{DynamicResource ColorBrush.White2}" 
                               FontSize="12" Margin="0,0,0,0"
                               HorizontalAlignment="Right"/>
                    
                    <!--<commComp:BookHierarchicalComboBox x:Name="bookHcbb" Grid.Column="1" Width="160" Height="22" Background="{DynamicResource MainBackgroup.ColorBrush}" 
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Tag="BOOK" IsEditable="True" 
                                                       SelectedId="{Binding SelectedBookIdTexts, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                       SelectedTexts="{Binding SelectedBookNameTexts, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></commComp:BookHierarchicalComboBox>-->

                    <commComp:MultiTreeComboBox  Grid.Column="1" Grid.ColumnSpan="2" Width="160" Height="26"  Margin="10 0 0 0"  HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" Foreground="White"
                                        TreeItemsSource="{Binding MultiTreeComboxItemsSource}" IsEnableMultiSelect="False"  SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedTexts="{Binding SelectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <commComp:MultiTreeComboBox.TreeItemItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                <StackPanel Orientation="Horizontal" Height="24">
                                    <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}" Visibility="{Binding IsLeaf, Converter={StaticResource visibilityConvertor}}"/>
                                    <Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>
                                    <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Checked}" Value="1">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </commComp:MultiTreeComboBox.TreeItemItemTemplate>
                    </commComp:MultiTreeComboBox>
                </Grid>
            </Grid>
            <Grid  Grid.Row="1" Visibility="{Binding DealCloseEnable,UpdateSourceTrigger=PropertyChanged}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="策略报单出现成交后表现" Grid.Row="0" Margin="10, 0, 0, 0" VerticalAlignment="Bottom" Foreground="#788187" FontSize="14" FontWeight="Bold"/>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="154"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="dealCloseAllChk" 
                              IsChecked="{Binding DealCloseAll,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                              Style="{DynamicResource  SwitchMMCheckBoxStyle}" Height="16" Width="34" Foreground="#3C3C3C" 
                              HorizontalAlignment="Left"
                              Margin="10 0 0 0" />
                    <TextBlock Grid.Column="1" Text="当前用户全部策略全撤全停" 
                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush.White2}"
                               FontSize="12" Margin="0,0,10,0"
                               HorizontalAlignment="Left"/>
                    <Image Grid.Column="2" Source="/STC.Mm.Plugin;component/Images/MM_Warn.png" HorizontalAlignment="Left" Width="16" Height="16" Margin="1,0,0,0">
                        <Image.ToolTip>
                            <Grid>
                                <TextBlock FontSize="14"  TextWrapping="Wrap" Text="打开这一开关，则如果当前用户正在&#13;运行的双边策略出现成交，当前用户&#13;所有双边做市策略自动关闭并撤单。"/>
                            </Grid>
                        </Image.ToolTip>
                    </Image>
                </Grid>
                <commComp:ExDataGrid x:Name="GroupListView" Grid.Row="2"
                          ItemsSource="{Binding DealCloseGroupObjs,UpdateSourceTrigger=PropertyChanged}"
                          Style="{DynamicResource DefaultDataGrid}" RowHeaderWidth="0" Margin="0 10 0 0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" MinWidth="150">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="分组内策略全撤全停" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="enableChk" 
                                                  IsChecked="{Binding DealCloseGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                                                  Style="{DynamicResource  SwitchMMCheckBoxStyle}" 
                                                  Height="16" Width="34" Foreground="#3C3C3C" 
                                                  Margin="4 0 0 0" IsTabStop="False" 
                                                  IsEnabled="{Binding GroupCheckEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <!--<DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RemainingTime}" Value="不可用">
                                            <Setter TargetName="enableChk" Property="IsEnabled" Value="false"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>-->
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="分组名" Width="*" MinWidth="100" Binding="{Binding GroupName}"/>
                    </DataGrid.Columns>
                </commComp:ExDataGrid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
