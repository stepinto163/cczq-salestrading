<UserControl x:Class="STC.Mm.Plugin.View.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Mm.Plugin.View"
             xmlns:comp="clr-namespace:STC.Mm.Plugin.View.Component"
             xmlns:commonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:homepage ="clr-namespace:STC.Mm.Plugin.View.HomePage"
             xmlns:conv="clr-namespace:STC.Mm.Plugin.Convertor" 
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             xmlns:command ="clr-namespace:STC.Mm.Plugin.Command"
             mc:Ignorable="d" x:Name="MM_MainView" Padding="5" Background="#141414"
             d:DesignHeight="450" d:DesignWidth="1450" Initialized="MM_MainView_Initialized"
             DataContextChanged="MM_MainView_DataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Mm.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.MM.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <conv:MmStatusConvertor x:Key="MmStatusConvertor"/>
            <!--<conv:MMStatusToolTipConverter x:Key="MMStatusToolTipConverter"/>-->

            <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="TextElement.FontWeight" TargetName="contentPresenter" Value="ExtraBold"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="TextElement.FontWeight" TargetName="contentPresenter" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="Gray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <Style x:Key="SwitchRadioButtonSytle" TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="#3C3C3C"/>
                <Setter Property="BorderBrush" Value="#3C3C3C"/>
                <Setter Property="Foreground" Value="#FFFFFF"></Setter>
                <Setter Property="Padding" Value="0"></Setter>
                <Setter Property="BorderThickness" Value="0"></Setter>
                <Setter Property="Height" Value="auto"></Setter>
                <Setter Property="SnapsToDevicePixels" Value="true"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid x:Name="grid"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  ClipToBounds="True" >
                                <Rectangle x:Name="ButtonStock"  Fill="{TemplateBinding Background}" Stroke="Gray"  RadiusX="1" RadiusY="1" Margin="0,0,0,0" StrokeThickness="0"/>
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"  Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Grid>
                            <!--触发器：设置选中状态符号-->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <!--<Setter Property="BorderThickness" Value="0"/>-->
                                    <!--<Setter Property="BorderBrush" Value="#FF37A22D"/>-->
                                    <Setter Property="Background" Value="#136C5E"></Setter>
                                    <Setter Property="Foreground" Value="White"></Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Opacity" Value="0.6"></Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" TargetName="grid" ></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 居中 -->
            <Style x:Key="MMDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderCenterStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 1 0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="MMDataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderRightStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 1 0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="MMDataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 1 0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Grid.ColumnSpan="3" Grid.RowSpan="2" BorderThickness="1" BorderBrush="#282828">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!--<ColumnDefinition Width="8"/>-->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Grid Grid.Row="0">
                <Button x:Name="AddQuantBtn" Width="88" Height="24" Style="{StaticResource RedButtonStyle}" Background="#515151" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center"
                    Command="{Binding AddBondCommand}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource multiAndNormalConverter}">
                            <MultiBinding.Bindings>
                                <Binding Path="HasGroup" Converter="{StaticResource booleanConvertor}"/>
                                <Binding Path="IsUnify" ElementName="OrderControl" Converter="{StaticResource reversebooleanConvertor}"/>
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                    <WrapPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Image Source="/STC.Mm.Plugin;component/Images/stc_icon_add_seleted.png" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                        <TextBlock Text="添加债券" Width="Auto" Height="16" Margin="2,0,0,0"/>
                    </WrapPanel>
                </Button>

                <Button x:Name="ImportGroupBtn" Width="106" Height="24" Style="{StaticResource RedButtonStyle}" Background="#515151" HorizontalAlignment="Left" Margin="97,0,0,0" VerticalAlignment="Center"
                    Command="{Binding ImportGroupCommand}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource multiAndNormalConverter}">
                            <MultiBinding.Bindings>
                                <Binding Path="HasGroup" Converter="{StaticResource booleanConvertor}"/>
                                <Binding Path="IsUnify" ElementName="OrderControl" Converter="{StaticResource booleanConvertor}"/>
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.IsEnabled>
                    <WrapPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Image Source="/STC.Mm.Plugin;component/Images/批量导入.png" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                        <TextBlock Text="批量导入" Width="Auto" Height="16" Margin="2,0,0,0"/>
                    </WrapPanel>
                </Button>

                <Button x:Name="CancelAllBtn" Width="106" Height="24" Style="{StaticResource RedButtonStyle}" Background="#515151" HorizontalAlignment="Left" Margin="209,0,0,0" VerticalAlignment="Center"
                    Command="{Binding UpdateCancelWidenSettingCommand}" IsEnabled="{Binding WidenQuoteBtnEnabled}">
                    <WrapPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Image Source="/STC.Mm.Plugin;component/Images/MM_CancelAll.png" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                        <TextBlock Text="全撤全停" Width="Auto" Height="16" Margin="2,0,0,0"/>
                    </WrapPanel>
                </Button>
                
                <Button x:Name="WidenQuoteBtn" Width="106" Height="24"  Style="{StaticResource RedButtonStyle}" Background="#515151" HorizontalAlignment="Left" Margin="321,0,0,0"
                    Command="{Binding UpdateWidenSettingCommand}" IsEnabled="{Binding WidenQuoteBtnEnabled}">
                    <WrapPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Image Source="/STC.Mm.Plugin;component/Images/MM_WidenQuote.png" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                        <TextBlock Text="{Binding WidenBtnText}" Width="Auto" Height="16" Margin="2,0,0,0"/>
                    </WrapPanel>
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel Width="450">
                                <TextBlock TextWrapping="Wrap" FontSize="14">1.仅作用于已开启策略——已关闭策略不会因为一键拉宽的使用而报价；</TextBlock>
                                <TextBlock/>
                                <TextBlock TextWrapping="Wrap" FontSize="14">2.同时作用于手动、自动报价的策略；</TextBlock>
                                <TextBlock/>
                                <TextBlock TextWrapping="Wrap" FontSize="14">3.对于已开启且有双边报价的策略，报价将使用已报价格、拉宽价格、动态防守价中更宽者（以收益率为单位，对于bid报价来说，更大的价格为更差的价格；对于ofr报价来说，更小的价格为更差的价格）</TextBlock>
                                <TextBlock/>
                                <TextBlock TextWrapping="Wrap" FontSize="14">4.对于已开启但未有双边报价的策略</TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" xml:space="preserve">    4.1如果能够计算得到双边动态防守价，则以此价格报送至市场；</TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" xml:space="preserve">    4.2如果无法计算得到双边动态防守价，则保持监控市场；</TextBlock>
                                <TextBlock/>
                                <TextBlock TextWrapping="Wrap" FontSize="14">5.对于拉宽状态下的报价，系统会实时监控行情并计算最新的动态防守价。有新的行情进入后，比较拉宽报价、已报价格、新的动态防守价三者，并报出当中最差的价格</TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" xml:space="preserve">    5.1若新价差于旧价，则应报出新价；</TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="14" xml:space="preserve">    5.2若新价优于旧价，则保持旧报价不变。</TextBlock>
                            </StackPanel>
                        </ToolTip>

                    </Button.ToolTip>
                </Button>
                
                <comp:SearchTextBox x:Name="Search_TextBox" SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,176,0" Width="120" Height="18" ListMarketFilter="CIB" AfterSearch="Search_TextBox_AfterSearch"/>
                <Button x:Name="SearchBtn" Width="60" Height="18" Content="筛选" Style="{StaticResource GrayButtonStyle}" HorizontalAlignment="Right" Margin="0,0,108,0" VerticalAlignment="Center" Click="SearchBtn_Click" />
                <commonComp:PopupEx x:Name="FilterPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchBtn}" StaysOpen="True"
                               PopupAnimation="Slide" AllowsTransparency="False" MouseLeave="FilterPopup_MouseLeave">
                    <Border Width="420" Height="256" BorderBrush="#A0A0A0" BorderThickness="1" Background="#3C3C3C">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="筛选条件" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                                <Button Content="×" FontSize="16" Background="Transparent" 
                                    BorderThickness="0" HorizontalAlignment="Right" 
                                    Foreground="#FFFFFF"  Margin="0,0,10,0"
                                    Click="CloseFilterButton_Click" Style="{StaticResource CloseButtonStyle}"/>
                            </Grid>
                            <Grid Grid.Row="1" Background="#1E1E1E">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!--债券类型-->
                                <TextBlock Text="债券类型:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <RadioButton x:Name="ShowAll_ToggleButton" Width="40" Height="18" Margin="0,0,0,0"  
                                         VerticalContentAlignment="Top" HorizontalContentAlignment="Center"
                                          IsChecked="True" Content="全部" Foreground="White" Style="{StaticResource ShowAllRadioStyle}" 
                                          Checked="ShowAll_ToggleButton_Checked"
                                             Unchecked="ShowAll_ToggleButton_Unchecked"
                                             Click="ShowAll_ToggleButton_Click"/>
                                    <ListBox x:Name="InterestRateDebtListBox" Grid.Column="1" Grid.Row="0"  FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="5" ItemsSource="{Binding InterestRateDebtList}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                                <Setter Property="Content" Value="{Binding itemText}"/>
                                                <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.Template>
                                            <ControlTemplate>
                                                <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                    </ListBox>
                                    <ListBox x:Name="CreditBondListBox" Grid.Column="1" Grid.Row="1"  FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="10" ItemsSource="{Binding CreditBondList}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                                <Setter Property="Content" Value="{Binding itemText}"/>
                                                <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                                <Setter Property="Margin" Value="{Binding itemMargin}"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.Template>
                                            <ControlTemplate>
                                                <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                    </ListBox>
                                </Grid>

                                <!--政府性金融债-->
                                <TextBlock Grid.Row="1" Text="政策性金融债:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                                <ListBox x:Name="PolicyFinancialBondListBox" Grid.Row="1" Grid.Column="1" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" FontSize="10" ItemsSource="{Binding PolicyFinancialBondList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>


                                </ListBox>

                                <!--剩余期限-->
                                <TextBlock Grid.Row="2" Text="剩余期限:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                                <ListBox x:Name="RemaingingTimeFilterListBox" Grid.Row="2" Grid.Column="1" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" FontSize="10" ItemsSource="{Binding RemaingingTimeList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    
                                </ListBox>
                                
                                <!--新发国债-->
                                <TextBlock Grid.Row="3" Text="新发国债:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                                <ListBox x:Name="NewBondSignFilterListBox" Grid.Row="3" Grid.Column="1" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" FontSize="10" ItemsSource="{Binding NewBondSignList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>

                                </ListBox>

                                <!--主题评级-->
                                <TextBlock Grid.Row="4" Text="主体评级:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                                <ListBox x:Name="Rating_CurrentFilterListBox" Grid.Row="4" Grid.Column="1" FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="11" ItemsSource="{Binding RatingList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                   
                                </ListBox>
                                
                                <!--清算速度-->
                                <TextBlock Grid.Row="5" Text="清算速度:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                                <ListBox x:Name="SettlTypeFilterListBox" Grid.Row="5" Grid.Column="1" FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="4" ItemsSource="{Binding SettlTypeList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>

                                </ListBox>
                                
                                <!--策略状态-->
                                <!--<TextBlock Grid.Row="6" Text="策略状态:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                                <ListBox x:Name="enableListBox" Grid.Row="6" Grid.Column="1" FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="4" ItemsSource="{Binding EnableList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                  
                                </ListBox>-->
                                
                                <!--做市状态-->
                                <!--<TextBlock Grid.Row="7" Text="做市状态:" Foreground="#A0A0A0" FontSize="10" Margin="0,8,5,0" HorizontalAlignment="Right"/>
                                <ListBox x:Name="monitorStatusListBox" Grid.Row="7" Grid.Column="1" FontSize="10" SelectionMode="Extended"
                                     Background="Transparent" Foreground="#A0A0A0" AlternationCount="5" ItemsSource="{Binding MonitorStatusList}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource FilterListBoxItemStyle}">
                                            <Setter Property="Content" Value="{Binding itemText}"/>
                                            <Setter Property="IsSelected" Value="{Binding itemIsSelected}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.Template>
                                        <ControlTemplate>
                                            <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                                        </ControlTemplate>
                                    </ListBox.Template>

                                </ListBox>-->
                                
                            </Grid>
                        </Grid>
                    </Border>
                </commonComp:PopupEx>
                <Button x:Name="btnImport" ToolTip="导入" Width="24" Height="24" Margin="0,0,76,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ImportButton2}" Command="{Binding ImportCommand}" IsEnabled="{Binding BtnEnable}"/>
                <Button x:Name="btnExport" ToolTip="导出" Width="24" Height="24" Margin="0,0,52,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ExportButton2}" Command="{Binding ExportCommand}" IsEnabled="{Binding BtnEnable}"/>
                <Button x:Name="btnReport" ToolTip="做市统计" Width="24" Height="24" Margin="0,0,28,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AnsStatisticsButton2}" Click="btnReport_Click"/>
                <Button x:Name="btnPopup" ToolTip="弹出" Width="24" Height="24" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PopupButton2}"
                        Command="{StaticResource PopupWindowCommand}">
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                            <MultiBinding.Bindings>
                                <Binding Source="{x:Static command:PopupTypeEnum.MMMainView}" Mode="OneWay"/>
                                <Binding ElementName="MM_MainView"/>
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>

            </Grid>

            <Grid Grid.Row="1">
                <CheckBox x:Name="isBreakBondCB" Content="断报券" VerticalAlignment="Center" HorizontalAlignment="Left" 
                          Margin="4 1 0 4" Style="{StaticResource DefaultCheckBoxStyle}" IsChecked="False" Padding="5 0 0 0"
                      Foreground="#D7D7D7" Checked="isBreakBondCB_Checked"  Unchecked="isBreakBondCB_Unchecked"/>
                <TextBlock Text="策略状态：" Foreground="#D7D7D7" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="75 1 0 4"/>
                <commonComp:MultiSelectComboBox x:Name="StrategyStatusMscb" HorizontalAlignment="Left" 
                                                Width="65" Height="22" Background="Black" Margin="135 1 0 4" 
                                                DefaultText="全部" Tag="StrategyStauts" 
                                                FilterDicChanged="StrategyStatusMscb_FilterDicChanged">
