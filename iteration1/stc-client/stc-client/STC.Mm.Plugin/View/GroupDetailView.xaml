            <commonComp:PopupEx x:Name="popBidStrategyList" PlacementTarget="{Binding ElementName=bidStrategyMode_btn}" Width="60" StaysOpen="False" PopupAnimation="Slide" AllowsTransparency="False" Panel.ZIndex="111">
