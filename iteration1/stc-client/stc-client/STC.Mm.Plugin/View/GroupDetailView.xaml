                                      Content="指示性报价" Foreground="#A0A0A0 " VerticalAlignment="Center" Margin="17,0,0,0" HorizontalAlignment="Left" Padding="5,0,0,0"
                                      IsChecked="{Binding Data.openQDM2Enable,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource booleanConvertor}}"
                                      Click="openODM2_cb_Click"/>-->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9" Height="1" BorderBrush="#282828" BorderThickness="1" Width="{Binding ElementName=orderDetailView, Path=ActualWidth}"/>

