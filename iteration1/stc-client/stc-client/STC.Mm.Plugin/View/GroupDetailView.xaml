                            <Image Grid.Row="1" Grid.Column="5" Grid.ColumnSpan="2" Source="/STC.Mm.Plugin;component/Images/MM_Warn.png" Width="16" Height="16" Margin="60,0,0,0" HorizontalAlignment="Left">
