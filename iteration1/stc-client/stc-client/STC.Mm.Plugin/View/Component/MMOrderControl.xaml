                        <StackPanel Orientation="Horizontal" Background="Black">
                            <TextBlock x:Name="OfrBaseQty_tb" Tag="Qty" Text="{Binding Params.displayOfrQty, Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource FormatZeroConverter}}" Padding="5,0,0,0" Width="50" Height="Auto"
                                     Focusable="True" GotFocus="OfrBaseQty_tb_GotFocus" LostFocus="OfrBaseQty_tb_LostFocus" MouseEnter="OfrBaseQty_tb_MouseEnter" MouseLeave="OfrBaseQty_tb_MouseLeave" input:InputMethod.IsInputMethodEnabled="False"
                                     PreviewKeyDown="TextBox_PreviewKeyDown" PreviewTextInput="TextBox_PreviewTextInput"  HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding ElementName=OfrBaseQty_tb,Path=Text}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Style.Triggers>
                                            <!--<DataTrigger Binding="{Binding enable}" Value="false">
                                                <Setter Property="Foreground" Value="#8F9598 "/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding enable}" Value="true">
                                                <Setter Property="Foreground" Value="#FFFFFF "/>
                                            </DataTrigger>-->
                                            <DataTrigger Binding="{Binding Params.isQuoteSuccess,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Value="0">
                                                <Setter Property="Foreground" Value="#8F9598 "/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Params.isQuoteSuccess,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Value="1">
                                                <Setter Property="Foreground" Value="#FFFFFF "/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Params.isQuoteSuccess,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Value="">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="KW" Foreground="#8F9598 " Height="Auto" Width="Auto"  Margin="0,1,2,0" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
            <Image x:Name="ofrAPIWarn_Img" Grid.Row="4" Grid.Column="1" Source="/STC.Mm.Plugin;component/Images/MM_Warn.png" Width="16" Height="16" Margin="27,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="Blue"  BorderThickness="0,0,0,0" Width="40" Height="25" CornerRadius="10" Background="Black" HorizontalAlignment="Center" Margin="0,-40,0,0" ToolTip="{Binding Params.bidOfrDiffToolTip}">
                <Grid VerticalAlignment="Center" Width="40" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PriceAdjustValue_tb" Grid.Column="0" Text="{Binding Params.bidOfrDiff,Mode=OneWay,Converter={StaticResource FormatZeroConverter},StringFormat={}{0}bp}" 
                               Foreground="#8F9598" FontSize="10" Height="Auto" HorizontalAlignment="Center" Width="Auto" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Button x:Name="PricePlus_btn" Style="{StaticResource   DefaultButtonStyle}" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2" FontSize="16" 
                    Width="20" Height="40" HorizontalAlignment="Center" Margin="-65,-10,0,0" Content="+" Foreground="#FFFFFF" VerticalContentAlignment="Center" Background="#3C3C3C" 
                    Click="PricePlus_btn_Click">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource multiAndNormalConverter}">
                        <MultiBinding.Bindings>
                            <Binding Path="Params.IsEnabledClick" Converter="{StaticResource booleanConvertor}"/>
                            <Binding Path="IsUnify" Converter="{StaticResource reversebooleanConvertor}"/>
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>

            <Button x:Name="PriceMinus_btn" Style="{StaticResource   DefaultButtonStyle}" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2" FontSize="16" 
                    Width="20" Height="40" HorizontalAlignment="Center" Margin="65,-10,0,0" Content="-" Foreground="#FFFFFF" VerticalContentAlignment="Center" Background="#3C3C3C"
                    Click="PriceMinus_btn_Click">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource multiAndNormalConverter}">
                        <MultiBinding.Bindings>
                            <Binding Path="Params.IsEnabledClick" Converter="{StaticResource booleanConvertor}"/>
                            <Binding Path="IsUnify" Converter="{StaticResource reversebooleanConvertor}"/>
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>

            <Button x:Name="PriceWiden_btn" Style="{StaticResource   DefaultButtonStyle}" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2" FontSize="10"
                    Width="40" Height="20" HorizontalAlignment="Center" Margin="0,-60,0,0" Content="拉宽" Foreground="#FFFFFF" VerticalContentAlignment="Center" Background="#3C3C3C"
                    Click="PriceWiden_btn_Click">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource multiAndNormalConverter}">
                        <MultiBinding.Bindings>
                            <Binding Path="Params.IsEnabledClick" Converter="{StaticResource booleanConvertor}"/>
                            <Binding Path="IsUnify" Converter="{StaticResource reversebooleanConvertor}"/>
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>

            <Button x:Name="PriceNarrow_btn" Style="{StaticResource   DefaultButtonStyle}" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="3" FontSize="10"
                    Width="40" Height="20" HorizontalAlignment="Center" Margin="0,15,0,0" Content="收窄" Foreground="#FFFFFF" VerticalContentAlignment="Center" Background="#3C3C3C"
                    Click="PriceNarrow_btn_Click">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource multiAndNormalConverter}">
                        <MultiBinding.Bindings>
                            <Binding Path="Params.IsEnabledClick" Converter="{StaticResource booleanConvertor}"/>
                            <Binding Path="IsUnify" Converter="{StaticResource reversebooleanConvertor}"/>
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>

            <Border  Grid.Row="7" Grid.ColumnSpan="2" x:Name="Pnl_dgPrice"  Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" BorderThickness="1,0,0,1" Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="224" x:Name="Row3"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="0" x:Name="TitleBar">
                        <TabControl BorderBrush="Transparent" x:Name="Tab_DgPrice" BorderThickness="0,0,0,0" Style="{DynamicResource TabControlStyle}" TabIndex="{Binding CurTabIndex, Mode=TwoWay}">
                            <TabItem Header="全市场" BorderThickness="0" BorderBrush="Transparent" Style="{DynamicResource TabItemStyle}" Height="16">
                                <card:PriceAndOrderViewMm x:Name="dgPrice" TitleBarVisible="Collapsed"/>
                            </TabItem>
                            <TabItem Header="仅双边" BorderThickness="0"  BorderBrush="Transparent"  Style="{DynamicResource TabItemStyle}"  Height="16">
                                <card:PriceAndOrderViewQDMESP  x:Name="dgPriceQdmesp" VenuesFilterString="1"/>
                            </TabItem>
                        </TabControl>
                    </Border>
                    <Border Grid.Row="1" Margin="0,0,0,1" BorderBrush="#3C3C3C" BorderThickness="0,0,0,0">
                        <card:MarketCardOrderView x:Name="dgMarketCard" HorizontalAlignment="Center" VerticalAlignment="Top" Width="348"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>
