<UserControl x:Class="STC.Mm.Plugin.View.Component.MyQuotePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.Mm.Plugin.View.Component"
             xmlns:conv ="clr-namespace:STC.Mm.Plugin.Convertor"
             mc:Ignorable="d" 
             d:DesignHeight="150" Height="Auto" d:DesignWidth="320" Width="Auto">
    <UserControl.Resources>
        <conv:FormatDigitConverter x:Key="FormatDigitConverter"/>
    </UserControl.Resources>
    <Border BorderThickness="2" Grid.Row="0" CornerRadius="4" BorderBrush="#A0A0A0"  Background="Transparent">

        <Grid Margin="0 10 10 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="策略类型:" Foreground="{DynamicResource ColorBrush.Gray21}"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="Auto" Height="Auto"/>
            <TextBlock Grid.Row="0"  Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="10,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Data.QuoteModel}" Value="Manual">
                                <Setter Property="Text" Value="手动"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.QuoteModel}" Value="Defend">
                                <Setter Property="Text" Value="防守"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.QuoteModel}" Value="Algorithm">
                                <Setter Property="Text" Value="算法"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Data.QuoteModel}" Value="API">
                                <Setter Property="Text" Value="接口"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="我的报价:" Foreground="{DynamicResource ColorBrush.Gray21}"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="Auto" Height="Auto"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}"  HorizontalAlignment="Left" Margin="10,0,0,0" Text="{Binding Data.BasePrice}">
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}"  HorizontalAlignment="Left" Margin="10,0,0,0" Text="{Binding Data.CalDetail}">
                </TextBlock>
                <!--<TextBlock VerticalAlignment="Center" Foreground="#FB943C" HorizontalAlignment="Left"  Margin="10,0,0,0" Text="{Binding Data.remark}">
            </TextBlock>-->
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="参考价:" Foreground="{DynamicResource ColorBrush.Gray21}"  FontSize="12" HorizontalAlignment="Right" Visibility ="{Binding Data.VisibileDefendValue}" VerticalAlignment="Center" Width="Auto" Height="Auto"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="{Binding Data.VisibileDefendValue}">
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="8,0,0,0" >
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.DefenReferMarketType}" Value="1">
                                    <Setter Property="Text" Value="双边"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.DefenReferMarketType}" Value="2">
                                    <Setter Property="Text" Value="X-Bond"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.DefenReferMarketType}" Value="3">
                                    <Setter Property="Text" Value="全市场"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.DefenReferMarketType}" Value="4">
                                    <Setter Property="Text" Value="CFETS"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="0,0,0,0" Visibility="{Binding Data.VisibileDefendValue}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.DefenReferLevel}" Value="1">
                                    <Setter Property="Text" Value="第一档"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.DefenReferLevel}" Value="2">
                                    <Setter Property="Text" Value="第二档"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.DefenReferLevel}" Value="3">
                                    <Setter Property="Text" Value="第三档"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.DefenReferLevel}" Value="4">
                                    <Setter Property="Text" Value="第四档"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.DefenReferLevel}" Value="5">
                                    <Setter Property="Text" Value="第五档"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" Text="{Binding Sign}">
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="0,0,0,0" Text="{Binding Data.AlgoDefenValue}">
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="1,0,0,0" Text="bp">
                </TextBlock>
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="墙:" Foreground="{DynamicResource ColorBrush.Gray21}"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="Auto" Height="Auto" Visibility ="{Binding Data.VisibileDefendValue}"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility ="{Binding Data.VisibileDefendValue}">
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" Text="{Binding Data.globalWall,Converter={StaticResource FormatDigitConverter}}">
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" Text="{Binding Sign}">
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="0,0,0,0" Text="{Binding Data.AlgoTrigValue}">
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="1,0,0,0" Text="bp">
                </TextBlock>
            </StackPanel>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="中债:" Foreground="{DynamicResource ColorBrush.Gray21}"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="Auto" Height="Auto"  Visibility="{Binding Data.VisibileDefendValue}"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"  Visibility="{Binding Data.VisibileDefendValue}">
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" Text="{Binding Data.defenCDCDetail}"/>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" Text="{Binding Sign}"/>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="0,0,0,0" Text="{Binding Data.DefenCDCValue}"/>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="1,0,0,0" Text="bp" />
            </StackPanel>
            <TextBlock Grid.Row="5" Grid.Column="0" Text="基准券:" Foreground="{DynamicResource ColorBrush.Gray21}"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="Auto" Height="Auto"  Visibility="{Binding Data.VisibileAlgorithmValue}"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"  Visibility="{Binding Data.VisibileAlgorithmValue}">
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Left" Margin="10,0,0,0" Text="{Binding Data.AlgoBaseSecurityid}" />
            </StackPanel>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="参考中间价:" Foreground="{DynamicResource ColorBrush.Gray21}"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Width="Auto" Height="Auto"  Visibility="{Binding Data.VisibileAlgorithmValue}"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"  Visibility="{Binding Data.VisibileAlgorithmValue}">
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Center" Margin="10,0,0,0" Text="{Binding Data.AlgoMidType}"/>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Center" Margin="10,0,0,0" Text="{Binding Data.AlgoMidValue}" />
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Center" Margin="1,0,0,0" Text="{Binding Data.AlgoMidOffsetValue}"/>
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Center" Margin="10,0,0,0" Text="{Binding Sign}" />
                <TextBlock VerticalAlignment="Center" Foreground="{Binding ForegroundBrush}" HorizontalAlignment="Center" Margin="1,0,0,0" Text="{Binding Data.AlgoValue}" />

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
