<bondComp:WindowBase x:Class="STC.quant.plugin.View.Component.AlterParamOrderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.quant.plugin.View.Component"
             xmlns:conv ="clr-namespace:STC.quant.plugin.Convertor"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:utils="clr-namespace:STC.quant.plugin.Utils;assembly=STC.quant.plugin"
             xmlns:bondComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:command ="clr-namespace:STC.quant.plugin.Command"
             xmlns:book="clr-namespace:STC.quant.plugin.SelectorTemplate"
             xmlns:SelectorT="clr-namespace:STC.quant.plugin.SelectorT"
             mc:Ignorable="d" FontSize="14"  Title="编辑参数"
             MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen"
            Width="780" Height="450">
    <bondComp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ListBoxStyleDictinary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

            <!-- 居中 -->
            <Style x:Key="MMDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderCenterStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="Margin" Value="9 0 0 0"/>
                <Setter Property="BorderThickness" Value="0 0 0 0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="MMDataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderRightStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 1 0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="MMDataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                <Setter Property="BorderBrush"  Value="#3C3C3C"/>
                <Setter Property="BorderThickness" Value="0 0 1 0"/>
            </Style>
            <SolidColorBrush x:Key="DataGridBorderBrush" Color="#3C3C3C"/>

            <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="{StaticResource DataGridColumnHeaderForeground}"/>
                <Setter Property="Background" Value="{StaticResource DataGridColumnHeaderBackground}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment"  Value="Center"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Padding" Value="10,0,0,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment ="{TemplateBinding VerticalContentAlignment}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="5,0,0,0"
                                                HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Path x:Name="SortArrow"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"                                           
                                                Width="8" Height="6" Margin="2,0,0,0"
                                                Stretch="Fill" Opacity="0.5" Fill="{TemplateBinding Foreground}"
                                                RenderTransformOrigin="0.5,0.4"
                                                Visibility="Collapsed"
                                                Data="M0,0 L1,0 0.5,1 z"/>
                                </Grid>
                                <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnHeaderGripperStyle}"/>
                                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripperStyle}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!--
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_LeftHeaderGripper" Property="Background">
                                <Setter.Value>
                                    <RadialGradientBrush>
                                        <GradientStop Color="Black" Offset="1"/>
                                        <GradientStop Color="White" Offset="0.5"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        -->
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SortArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"></Setter>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="Height" Value="24"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="0">
                        <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                    </Trigger>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                    </Trigger>
                    <!-- 不知悬浮颜色 todo  -->
                    <!--选中颜色-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.SelectedInactive.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Item.SelectedInactive.Border}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Item.SelectedActive.Border}"/>
                    </MultiTrigger>
                    <!--鼠标移过-->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="False"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.MouseOver.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Item.MouseOver.Border}"/>
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsSelected" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Item.SelectedActive.Border}"/>
                    </MultiTrigger>
                    <DataTrigger Binding="{Binding ParamId}" Value="-1">
                        <Setter Property="Background" Value="{StaticResource Item.SelectedActive.Background}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Item.SelectedActive.Border}"/>
                        <Setter Property="Height" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle" TargetType="{x:Type DataGridCell}">
                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="IsTabStop" Value="False"/>
                <!--<Setter Property="Padding" Value="10,0,0,0"/>-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True" BorderBrush="{DynamicResource DataGridCellBorderBrush}" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PARAMDataGrid" TargetType="DataGrid">
                <!--<Setter Property="CanUserSortColumns" Value="False"/>-->
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <!-- 不需要虚拟模式 -->
                <!--<Setter Property="EnableRowVirtualization" Value="False"/>-->
                <!-- 不需要边框 -->
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="VirtualizingPanel.IsContainerVirtualizable" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
                <Setter Property="BorderBrush" Value="{StaticResource DataGridColumnHeaderBorderBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Background" Value="{StaticResource DefaultBackgroup.ColorBrush}"/>
                <Setter Property="AlternationCount" Value="1"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource DefaultAlternatingRowBackground.ColorBrush}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
                <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}"/>
                <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            </Style>

        </ResourceDictionary>
    </bondComp:WindowBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>


        <!--<Grid  Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource MainBackgroup.ColorBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="75"></ColumnDefinition>
                <ColumnDefinition Width="24"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="编辑参数" Foreground="{StaticResource ColorBrush.While}" FontFamily="{DynamicResource IDCFontFamily.YaHei.Semibold}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10, 0, 0, 0"></TextBlock>
        </Grid>-->

        <DataGrid x:Name="ParamListView" Grid.Row="0"   BorderThickness="1"
                  SelectedItem="{Binding SelectedParamItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding ParamView}"
                  Style="{StaticResource PARAMDataGrid}"
                   ColumnHeaderStyle="{StaticResource MMDataGridColumnHeaderLeftStyle}" SelectionMode="Single" Grid.ColumnSpan="3" Margin="0,0,0.001,0"
                  CellEditEnding="ParamListView_CellEditEnding">
            <DataGrid.Resources>
                <DataTemplate x:Key="CheckBoxItem">
                    <book:CheckBoxItem/>
                </DataTemplate>
                <DataTemplate x:Key="ComboBoxItem">
                    <book:ComboBoxItem/>
                </DataTemplate>
                <DataTemplate x:Key="TextItem">
                    <book:TextItem LostFocus="TextItem_LostFocus"/>
                </DataTemplate>
                <DataTemplate x:Key="TextItemMulti">
                    <book:TextItemMulti LostFocus="TextItemMulti_LostFocus"/>
                </DataTemplate>
                <DataTemplate x:Key="TextItem1">
                    <book:TextItem1 LostFocus="TextItem1_LostFocus"/>
                </DataTemplate>
                <DataTemplate x:Key="TextItem2">
                    <book:TextItem2 LostFocus="TextItem2_LostFocus"/>
                </DataTemplate>
                <DataTemplate x:Key="DatePickerItem">
                    <book:DatePickerItem/>
                </DataTemplate>
                <DataTemplate x:Key="TextQtyItem" >
                    <book:TextQtyItem LostFocus="TextItem_LostFocus"/>
                </DataTemplate>
                <DataTemplate x:Key="lableItem">
                    <book:lableItem/>
                </DataTemplate>
                <DataTemplate x:Key="SearchTextBox">
                    <book:SearchTextBoxItem/>
                </DataTemplate>
                <DataTemplate x:Key="TextFieldItem">
                    <book:TextFieldItem AddEventHandler="TextFieldItem_AddEventHandler" EditEventHandler="TextFieldItem_EditEventHandler"/>
                </DataTemplate>
                <DataTemplate x:Key="MultiSelectItem">
                    <book:MultiSelectItem/>
                </DataTemplate>
                <!--<DataTemplate x:Key="TreeViewComBoxItem">
                    <book:TreeViewComBoxItem QuantUser="{Binding Username}" 
                       SelectedId="{Binding ParamValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>-->
                <DataTemplate x:Key="TreeViewComBoxItem">
                    <bondComp:MultiTreeComboBox 
                                    HorizontalAlignment="Left" VerticalAlignment="Center" TreeItemStyle="{DynamicResource GreenBlueTreeViewItemStyle}" Foreground="White"
                                        TreeItemsSource="{Binding MultiTreeComboxItemsSource}" IsEnableMultiSelect="False"  Width="100"
                                         SelectedItem="{Binding ParamValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                                        <!--SelectedTexts="{Binding SelectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">-->
                        <bondComp:MultiTreeComboBox.TreeItemItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                <StackPanel Orientation="Horizontal" Height="24">
                                    <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TreeCheckBoxButton}" Background="Transparent" Tag="{Binding Id}" Visibility="{Binding IsLeaf, Converter={StaticResource visibilityConvertor}}"/>
                                    <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Checked}" Value="1">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </bondComp:MultiTreeComboBox.TreeItemItemTemplate>
                    </bondComp:MultiTreeComboBox>
                </DataTemplate>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <!--<DataGridTemplateColumn  Width="45" HeaderStyle="{StaticResource MMDataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnAdd" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Content="➕" Width="32" Height="20" 
                                    Style="{StaticResource AddButtonStyle}" Click="btnAdd_Click"
                            ToolTip="添加" Margin="0 ,0 ,0 ,2"></Button>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsParamEnabled, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" Value="true">
                                    <Setter Property="Visibility"  TargetName="btnAdd" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsParamEnabled, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" Value="false">
                                    <Setter Property="Visibility"  TargetName="btnAdd" Value="Hidden" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center">
                                <Button x:Name="btMin" Content="一" Foreground="#A0A0A0" Width="24" Height="24" ToolTip="删除" HorizontalAlignment="Center" Style="{StaticResource GreenDeleteButtonStyle}"
                                      Click="btnDelete_Click"
                                          FontSize="10" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="true">
                                    <Setter Property="Visibility"  TargetName="btMin" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="false">
                                    <Setter Property="Visibility"  TargetName="btMin" Value="Hidden" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->

                <DataGridTextColumn Header="参数名" MinWidth="100" Width="*" Binding="{Binding ParamKey}" Visibility="Hidden">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Info1}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="说明" MinWidth="100" Width="*" Binding="{Binding ParamDesc}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Info1}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
               
                <!--<DataGridTemplateColumn Header="参数值" MinWidth="144" Width="*" x:Name="ColValue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            --><!--<DockPanel LastChildFill="True">--><!--
                                <TextBox Name="txParamV" Text="{Binding ParamValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="124" Height="24" Style="{StaticResource STCDefaultBoxStyle}">
                                    <TextBox.ToolTip>
                                        <ToolTip Content="{Binding Path=Text}"></ToolTip>
                                    </TextBox.ToolTip>
                                </TextBox>
                       
                            --><!--</DockPanel>--><!--
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding PString}" Value="Hidden">
                                    <Setter Property="TextWrapping"  TargetName="txParamV" Value="2" />
                                    <Setter Property="Height"  TargetName="txParamV" Value="48" />
                                    <Setter Property="VerticalScrollBarVisibility"  TargetName="txParamV" Value="3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PString}" Value="Visible">
                                    <Setter Property="TextWrapping"  TargetName="txParamV" Value="1" />
                                    <Setter Property="Height"  TargetName="txParamV" Value="24" />
                                    <Setter Property="VerticalScrollBarVisibility"  TargetName="txParamV" Value="2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTemplateColumn Header="参数值" MinWidth="100" Width="*" >
                    <DataGridTemplateColumn.CellTemplateSelector>
                        <SelectorT:ParamDataTemplateSelector />
                    </DataGridTemplateColumn.CellTemplateSelector>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="参数值1" MinWidth="100" Width="*" >
                    <DataGridTemplateColumn.CellTemplateSelector>
                        <SelectorT:Param1DataTemplateSelector />
                    </DataGridTemplateColumn.CellTemplateSelector>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="参数值2" MinWidth="100" Width="*" >
                    <DataGridTemplateColumn.CellTemplateSelector>
                        <SelectorT:Param2DataTemplateSelector />
                    </DataGridTemplateColumn.CellTemplateSelector>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="操作" Width="48" MinWidth="40" Visibility="Hidden">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"  VerticalAlignment="Center" >

                                <!--<Button x:Name="btnEdit" Height="16" Width="16" Margin="5,0,0,0" ToolTip="编辑"
                                                       Click="btnEdit_Click"
                                                        Style="{StaticResource EditButton}"  FontSize="10" IsEnabled="{Binding IsAlterEnabled}"
                                                        />-->
                                <Button x:Name="btnDelete" Foreground="#A0A0A0" Width="16" Height="16" Margin="5,0,0,0" ToolTip="删除" HorizontalAlignment="Center" Style="{StaticResource DeleteButton}"
                                       Click="btnDelete_Click"
                                         FontSize="10"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="true">
                                    <Setter Property="IsEnabled"  TargetName="btnDelete" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="false">
                                    <Setter Property="IsEnabled"  TargetName="btnDelete" Value="False" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border  Grid.Row="1" BorderBrush="#232323" BorderThickness="0,1,0,0" Grid.ColumnSpan="3" Margin="0,0,0.001,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK_Click" IsDefault="True">确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</bondComp:WindowBase>
