<UserControl x:Class="STC.quant.plugin.View.Component.BadgeComboBoxDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.quant.plugin.View.Component"
             mc:Ignorable="d" x:Name="usercontrol" Loaded="usercontrol_Loaded" Initialized="usercontrol_Initialized"
             d:DesignHeight="24" d:DesignWidth="376">
    <!--d:DesignHeight="24" d:DesignWidth="376"-->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/STC.SkinStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type Border}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#3B3C3E"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="stackpanel" Orientation="Horizontal"  HorizontalAlignment="Left" VerticalAlignment="Center" PreviewMouseLeftButtonUp="StackPanel_PreviewMouseLeftButtonUp" Panel.ZIndex="100">
        <ItemsControl x:Name="ic" ItemsSource="{Binding}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#3C3C3C" VerticalAlignment="Center" Margin="2.5,0,0,0" Height="20" HorizontalAlignment="Left"
                                    CornerRadius ="2" MaxWidth="116">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Name_tb" Grid.Column="0" Text="{Binding Value}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,3,10,0" Height="20" MaxWidth="96" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path=Text,ElementName=Name_tb}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
