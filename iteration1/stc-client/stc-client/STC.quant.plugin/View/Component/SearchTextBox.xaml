<UserControl x:Class="STC.quant.plugin.View.Component.SearchTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.quant.plugin.View.Component"
             xmlns:conv="clr-namespace:STC.quant.plugin.Convertor"
             mc:Ignorable="d" 
             d:DesignHeight="18" d:DesignWidth="120"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/ScrollViewerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <!-- 搜索文本框 -->
            <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{StaticResource TextBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextBox.Static.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBox.Focus.Foreground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <!--<Border x:Name="SearchImage" Width="16" Height="16" HorizontalAlignment="Left"  >
                                        <Border.Background>
                                            <ImageBrush ImageSource="/STC.XBond.Plugin;component/Images/stc_icon_input_search_normal.png"/>
                                        </Border.Background>
                                    </Border>-->
                                    <Button x:Name="closeButton" HorizontalAlignment="Left" Width="{TemplateBinding Height}" Background="Transparent" BorderThickness="0"
                                            Click="closeButton_Click" Style="{DynamicResource ClsoeButtonStyle}">
                                        <Button.Resources>

                                            <Style x:Key="ClsoeButtonStyle" TargetType="{x:Type Button}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                                                <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsDefaulted" Value="true">
                                                                    <Setter Property="BorderBrush" TargetName="border" Value="Transparent"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="true">
                                                                    <Setter Property="Background" TargetName="border" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" TargetName="border" Value="Transparent"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="true">
                                                                    <Setter Property="Background" TargetName="border" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" TargetName="border" Value="Transparent"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="false">
                                                                    <Setter Property="Background" TargetName="border" Value="Transparent"/>
                                                                    <Setter Property="BorderBrush" TargetName="border" Value="Transparent"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Resources>
                                        <Image x:Name="SearchImage" Source="/STC.quant.plugin;component/Images/stc_icon_input_search_normal.png"/>
                                    </Button>

                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Margin="20,0,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border"  Value="{StaticResource TextBox.Disable.Background}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBox.Disable.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource TextBox.Disable.Border}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{StaticResource TextBox.MouseOver.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{Binding MouseOverBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:SearchTextBox}, Mode=FindAncestor}}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{StaticResource TextBox.Focus.Background}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBox.Focus.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{Binding FocusBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:SearchTextBox}, Mode=FindAncestor}}"/>
                                    <Setter Property="Source" TargetName="SearchImage" Value="/STC.quant.plugin;component/Images/stc_icon_input_search_typing.png"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTermTextBox,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="false">
                                    <Setter Property="Source" TargetName="SearchImage" Value="/STC.quant.plugin;component/Images/stc_icon_login_close.png"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{StaticResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <TextBox x:Name="SearchTermTextBox" Style="{StaticResource SearchTextBoxStyle}" 
                 VerticalContentAlignment="Center" 
                 MaxLength="20"
                 TextChanged="SearchTermTextBox_TextChanged"
                 PreviewKeyDown="tbSearch_PreviewKeyDown"
                 KeyDown="tbSearch_KeyDown"
                 GotFocus="tbSearch_GotFocus"
                 LostFocus="tbSearch_LostFocus"
                 input:TextCompositionManager.PreviewTextInput="tbTraderAInfoChange_PreviewTextInput"
                  input:TextCompositionManager.PreviewTextInputUpdate="tbTraderAInfoChange_PreviewTextInputUpdate"/>
        <TextBlock x:Name="HintTextBox" IsHitTestVisible="False" Text="搜索全局策略..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0" 
                       Foreground="{StaticResource TextBox.Static.Border}">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=SearchTermTextBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Popup x:Name="popBondCode" PlacementTarget="{Binding ElementName=SearchTermTextBox}" StaysOpen="False" MaxHeight="300"
                   PopupAnimation="Slide" AllowsTransparency="False">
            <Border BorderBrush="#282828" BorderThickness="1" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="搜索策略" FontSize="12" Background="{StaticResource DefaultBackgroup.ColorBrush}" Foreground="{StaticResource DefaultForegroup.ColorBrush}"/>
                    <!--{StaticResource DefaultBackgroup.ColorBrush}-->
                    <DataGrid x:Name="dgBondCode" Grid.Row="1"
                        ItemsSource="{Binding}" 
                        HeadersVisibility="None"
                        BorderThickness="0"       
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        ScrollViewer.CanContentScroll="True"
                        Margin="0" 
                        Width="360"
                        MouseUp="dgBondCode_MouseUp"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  >

                        <DataGrid.Resources>
                            <Style x:Key="tbStyle" TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Style>
                            <StaticResource ResourceKey="DefaultDataGrid"/>
                        </DataGrid.Style>
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Lable}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Lablepinyin}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" 
                                                Foreground="{StaticResource DefaultForegroup.ColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Lablepinyinfull}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" 
                                                Foreground="{StaticResource DefaultForegroup.ColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource self}, Path=Text}">
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>

            </Border>

        </Popup>

    </Grid>
</UserControl>
