<bondComp:WindowBase  x:Class="STC.quant.plugin.View.HomePage.BatachAddBondTab1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
       xmlns:bondComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
                  Closed="WindowBase_Closed"
         Title="债券" MinHeight="400" MinWidth="420" Height="400" Width="420"  ResizeMode="CanResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen">
    <bondComp:WindowBase.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
    </bondComp:WindowBase.Resources>

        <!--<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
            <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK_Click" IsDefault="True">确定</Button>
        </StackPanel>-->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" >

            <Button x:Name="btnAddBonds" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0 1 0 0"
                          IsDefault="True" Command="{Binding AddBondCommand}">添加债券</Button>
            <Button x:Name="btnBatchImport" Width="100" Height="24" Margin="10,0,0,0" Style="{DynamicResource BlueGreenStyle}"  BorderThickness="0,1,0,0"
                         Command="{Binding BatchImportBondCommand}"   >批量导入</Button>
            <Button x:Name="btnImport" ToolTip="导入" Width="24" Height="24" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ImportButton2}"  
                    Command="{Binding ImportBondCommand}"/>
            <Button x:Name="btnExport" ToolTip="导出" Width="24" Height="24" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource ExportButton2}" 
                    Command="{Binding ExportBondCommand}"/>

        </StackPanel>

        <DataGrid x:Name="ParamListView" Grid.Row="1"   BorderThickness="1"
                  SelectedItem="{Binding SelectedBondItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding BondView}"
                  Style="{DynamicResource DefaultDataGrid}"
                   SelectionMode="Single" Grid.ColumnSpan="3" Margin="0,0,0.001,0"
                  >
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="" Width="48" MinWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center">
                                <Button Content="一" Foreground="#A0A0A0" Width="24" Margin="0, 0, 6, 0" Height="24" ToolTip="删除" HorizontalAlignment="Center" Style="{DynamicResource GreenDeleteButtonStyle}" 
                                        Command="{Binding DataContext.DelBondCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="债券代码" MinWidth="100" Width="*" Binding="{Binding Securityid}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Info1}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="债券简称" MinWidth="100" Width="*" Binding="{Binding Symbol}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Info1}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="剩余期限" MinWidth="100" Width="*" Binding="{Binding Tenor}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Info1}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!--<DataGridTextColumn Header="类型" MinWidth="100" Width="*" Binding="{Binding Type}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Info1}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>-->
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.ColumnSpan="2" Grid.Row="2" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{DynamicResource GraySlateButtonStyle}" BorderThickness="0 1 0 0"
                            Command="{Binding BondCancelCommand}">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"  BorderThickness="0,1,0,0"
                        Command="{Binding BondOKCommand}" IsDefault="True">确定</Button>
            </StackPanel>

        </Border>
    </Grid>


</bondComp:WindowBase>
