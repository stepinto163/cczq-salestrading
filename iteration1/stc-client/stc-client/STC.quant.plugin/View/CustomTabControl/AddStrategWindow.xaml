<Framecomp:WindowBase x:Class="STC.quant.plugin.View.HomePage.AddStrategWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.quant.plugin.View.HomePage"
        xmlns:Framecomp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        xmlns:comp="clr-namespace:STC.quant.plugin.View.Component"
        mc:Ignorable="d"
        Title="新增策略组" Height="228" Width="502" ResizeMode="NoResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen"
                     FocusManager.FocusedElement="{Binding ElementName=bond_txt}">
    <Framecomp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Framecomp:WindowBase.Resources>
    <Grid FocusManager.FocusedElement="{Binding ElementName=quantname}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>


            <ColumnDefinition Width="62"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--<TextBlock Text="策略代码: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="quant" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" Grid.Row="0" Grid.Column="1" Style="{StaticResource  STCDefaultBoxStyle}"/>-->
        <TextBlock Text="策略名: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="1"/>
        <TextBox x:Name="quantname" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="376" Grid.Row="0" Grid.Column="2" Style="{StaticResource  STCDefaultBoxStyle}"/>
        <!--IsChecked="{Binding Source,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"-->
        <CheckBox Width="16" Name="ckTemplet" Style="{StaticResource DefaultCheckBoxStyle}" FocusManager.IsFocusScope="False" Grid.Row="2" Grid.Column="0"                                     
                                    VerticalAlignment="Center" IsChecked="True"
                                      HorizontalAlignment="Right" Click="CheckBox_Click" Visibility="Hidden"
                                      ></CheckBox>
        <TextBlock x:Name="lblTemplate" Text="策略模板: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="1"/>
        <ComboBox x:Name="comTemplet" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left"  Width="376" Height="24"    Grid.Row="2" Grid.Column="2"
        ItemsSource="{Binding }"  SelectedValuePath="Key" DisplayMemberPath="Value" Style="{StaticResource NonEditableComboBoxStyle}" />

        <TextBlock x:Name="lblStrategyDesc" Text="策略说明: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="4" Grid.Column="1"/>
        <TextBox x:Name="remark" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="376" Grid.Row="4" Grid.Column="2"  Style="{StaticResource  STCDefaultBoxStyle}" />


        <!--<TextBlock Text="策略分组: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="6" Grid.Column="1"/>-->
        <TextBlock x:Name="lblStrategyKeyword" Text="策略标签: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="6" Grid.Column="1"/>
        <!--<TextBox x:Name="groupcode" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" Grid.Row="2" Grid.Column="1" Style="{StaticResource  STCDefaultBoxStyle}" />-->
        <!--<ComboBox x:Name="groupcode" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left"  Width="376" Height="24"    Grid.Row="6" Grid.Column="2"
        SelectedValuePath="Key" 
                  DisplayMemberPath="Value" Style="{StaticResource NonEditableComboBoxStyle}"/>-->
        <comp:BadgeComboBox x:Name="groupcode" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left"  Width="376" Height="24"  Grid.Row="6" Grid.Column="2"/>

        <TextBlock x:Name="error_tb" Grid.ColumnSpan="3" Grid.Row="7" Foreground="#E63034" VerticalAlignment="Top"  Margin="95,10,40,0"/>
        <Border Grid.ColumnSpan="3" Grid.Row="8" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}" Foreground="#FFFFFF"
                        Click="btnOK_Click" >确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</Framecomp:WindowBase>
