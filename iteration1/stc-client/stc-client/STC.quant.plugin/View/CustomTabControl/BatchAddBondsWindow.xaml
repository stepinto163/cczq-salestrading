<bondComp:WindowBase  x:Class="STC.quant.plugin.View.HomePage.BatchAddBondsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
       xmlns:bondComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        Closing="WindowBase_Closing"
                  Closed="WindowBase_Closed"
         Title="导入债券" MinHeight="400" MinWidth="420" Height="400" Width="420"  ResizeMode="CanResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen">
    <bondComp:WindowBase.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                --><!--<ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/STC.SkinStyle.xaml"/>--><!--
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.quant.Plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
        </ResourceDictionary>
    </bondComp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- 第一步 -->
        <Grid x:Name="step1">
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="50"/>-->
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <!--<StackPanel Grid.Row="0"  Orientation="Horizontal" Grid.ColumnSpan="2" Margin="40,0,0,0">
                <CheckBox x:Name="checkrole"  IsChecked="{Binding DefaultCheck, Mode=TwoWay}" VerticalAlignment="Center"
                               BorderThickness="2" BorderBrush="{StaticResource ColorBrush.Gray15}" Height="20"
                              FontFamily="{StaticResource IDCFontFamily.NotoSansCJKsc-Regular}" FontSize="{StaticResource SmallContentFontSize}" 
                              Style="{StaticResource CommonCheckBoxStyle}" Background="{StaticResource ColorBrush.Transparent}" Foreground="{StaticResource ColorBrush.While}" 
                              Content="选择已有关注组" Click="Checkrole_Click"></CheckBox>
                <ComboBox x:Name="comGroup" HorizontalAlignment="Left" Width="100" Height="24" Padding="0, 3, 0, 0" Margin="5,0,0,0" 
        SelectedValuePath="Key" IsEnabled="False"
                  DisplayMemberPath="Value" Style="{StaticResource NonEditableComboBoxStyle}" SelectionChanged="ComGroup_SelectionChanged">
                </ComboBox>
            </StackPanel>-->
            
            <Border  Grid.Row="0" BorderBrush="#3B3C3E" Background="#0B0C0C" BorderThickness="1"  Margin="40,40,40,5" Visibility="Visible">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="importTxt" BorderThickness="0" Background="#0B0C0C" Foreground="#FFFFFF"  AcceptsReturn="True" TextWrapping="Wrap"  Padding="10"  >
                            <!--<TextBox.ContextMenu>
                        <ContextMenu Name="cm" StaysOpen="true">
                            <MenuItem Header="导入CVS文件" Command="{Binding ImportCommand}"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>-->
                        </TextBox>
                    </ScrollViewer>

                    <TextBlock x:Name="HintTextBox" IsHitTestVisible="False" Text="贴上文本信息以识别债券数据" 
                       Foreground="{DynamicResource TextBox.Static.Border}" Padding="10">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=importTxt}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                   
                </Grid>
                
            </Border>
            <!--<StackPanel Orientation="Horizontal" Grid.Row="2" Margin="40,0,0,0">
                <Button x:Name="btnImport" ToolTip="导入" Width="24" Height="24" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ImportButton2}"  IsEnabled="{Binding BtnEnable}" Click="BtnImport_Click"/>
                <Button x:Name="btnExport" ToolTip="导出" Width="24" Height="24" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ExportButton2}"  IsEnabled="{Binding BtnEnable}" Click="BtnExport_Click"/>
            </StackPanel>-->

        </Grid>

        <!-- 第二步 -->
        <Grid x:Name="step2" Visibility="Collapsed">
            <TextBlock Margin="20,20,20,0">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}识别: {0}/{1}">
                        <Binding Path="CheckedCount"></Binding>
                        <Binding Path="SumCount"></Binding>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <DataGrid Margin="20,40,20,20" ItemsSource="{Binding ImportDv}" Style="{DynamicResource DefaultDataGrid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn MinWidth="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsCheck,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Checked="CheckBox_Click" Unchecked="CheckBox_Click" Style="{DynamicResource DefaultCheckBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="代码" MinWidth="80" Binding="{Binding SecurityID}"/>
                    <DataGridTextColumn Header="简称" MinWidth="130" Binding="{Binding Symbol}"/>
                    <DataGridTextColumn Header="期限" MinWidth="100" Binding="{Binding RemainingDate}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 第三步 -->
        <Grid x:Name="step3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="InfoIcon" Width="16" Height="16" CornerRadius="8" Background="#00A84B" Visibility="Visible">
                    <TextBlock Text="✔" Foreground="#FFFFFF"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

            <DockPanel  Grid.Column="1" Margin="5,36,10,30"  VerticalAlignment="Top" >
                <TextBlock x:Name="title" DockPanel.Dock="Left" Text="{Binding SuccessCount, StringFormat={}成功导入{0}只债券，}"  Foreground="#A0A0A0"  />
                <TextBlock x:Name="title_fail" Text="{Binding FailCount, StringFormat={}失败导入{0}只债券：}" Foreground="#A0A0A0"  />
            </DockPanel>
          
           
            <ScrollViewer Margin="5,60,10,30" Grid.Column="1" MinWidth="260" 
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="viewer">
                <TextBox x:Name="txtMessage" IsReadOnly="True"  TextWrapping="Wrap" BorderThickness="0" Background="#0B0C0C" Foreground="#FFFFFF" Text="{Binding ResultStr}" ></TextBox>
            </ScrollViewer>
        </Grid>

        <Border Grid.ColumnSpan="2" Grid.Row="1" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{DynamicResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnOK_Click" Visibility="Visible">识别</Button>
                <Button x:Name="btnBack" Width="60" Height="24" Style="{DynamicResource GrayButtonStyle}"
                            Click="btnBack_Click" Visibility="Collapsed">返回</Button>
                <Button x:Name="btnOK2" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnOK2_Click" Visibility="Collapsed" IsDefault="True">确认导入</Button>
                <Button x:Name="btnOK3" Width="100" Height="24"  Margin="4,0,0,0"  Style="{DynamicResource BlueGreenStyle}"
                        Click="btnOK3_Click" Visibility="Collapsed" IsDefault="True" IsEnabled="{Binding BtnOK3Enabled}">确认</Button>
            </StackPanel>

        </Border>
    </Grid>
</bondComp:WindowBase>
