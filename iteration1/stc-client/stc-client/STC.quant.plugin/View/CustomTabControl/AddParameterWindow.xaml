<bondComp:WindowBase x:Class="STC.quant.plugin.View.HomePage.AddParameterWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:bondComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
        mc:Ignorable="d"
           Title="新增参数" Height="245" Width="300" ResizeMode="CanResize"
                 MinboxEnable="False" MaxboxEnable="False" WindowStartupLocation="CenterScreen">
    <bondComp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/TextBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/ComboBoxStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </bondComp:WindowBase.Resources>
    <Grid FocusManager.FocusedElement="{Binding ElementName=groupname_txt}">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
       
        <TextBlock Text="参数名: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"/>
        <TextBox x:Name="param_key" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" Grid.Row="0" Grid.Column="1" Style="{StaticResource  STCDefaultBoxStyle}"/>


        <TextBlock Text="参数类型: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0"/>
        <!--<TextBox x:Name="param_type" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" Grid.Row="1" Grid.Column="1" Style="{StaticResource  STCDefaultBoxStyle}" />-->
        <ComboBox x:Name="param_type" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left"  Grid.Row="1" Grid.Column="1"  Width="160" Height="24"  
        SelectedValuePath="Key"
                  DisplayMemberPath="Value" Style="{StaticResource NonEditableComboBoxStyle}"/>


        <TextBlock Text="说明: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0"/>
        <TextBox x:Name="param_desc" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" Grid.Row="2" Grid.Column="1" Style="{StaticResource  STCDefaultBoxStyle}" />

        <TextBlock Text="参数值: " VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0"/>
        <TextBox x:Name="param_value" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" Grid.Row="3" Grid.Column="1" Style="{StaticResource  STCDefaultBoxStyle}" />

        <Border Grid.ColumnSpan="2" Grid.Row="5" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK_Click" IsDefault="True">确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</bondComp:WindowBase>
