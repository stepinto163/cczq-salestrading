                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTemplateColumn Width="72" MinWidth="72" HeaderStyle="{StaticResource MMDataGridColumnHeaderLeftStyle}" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" Margin="4 0 0 0"
                                                      IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      Style="{StaticResource DefaultCheckBoxStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="Selected_Chk" IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                          Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}" Style="{StaticResource DefaultCheckBoxStyle}"  Margin="1 0 0 0" Click="Selected_Chk_Click"/>
                                <CheckBox x:Name="enableChk" IsChecked="{Binding Source,Mode=OneWay}" Style="{DynamicResource SwitchMMCheckBoxStyle}" Height="16" Width="34" Foreground="#3C3C3C"
                                           Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}"      PreviewMouseLeftButtonDown="CheckBox_PreviewMouseLeftButtonDown" Margin="4 0 0 0"/>
                                <!--<ToggleButton Width="100" Height="25" Style="{StaticResource ToggleButtonStyle1}"/>-->
                                <!--<comp:HoverButton Width="16" Height="16"  Style="{StaticResource HoverButton}"
                                                       Background="Transparent"
                                                   BorderBrush="Transparent"
                                                      OutBorderBrush ="Transparent"
                                                     Foreground="{StaticResource RedButton.Static.Foreground}"
                                                    PressBackground="{StaticResource RedButton.Pressed.Background}" 
                                                    PressBorderBrush="{StaticResource RedButton.Pressed.Border}"
                                                    HoverBackground="{StaticResource RedButton.MouseOver.Background}" 
                                                    HoverBorderBrush="{StaticResource RedButton.MouseOver.Border}"
                                            HorizontalAlignment="Center" 
                                            Margin="2,0,0,0"
                                            Click="del_btn_Click">
                                </comp:HoverButton>-->
                            </StackPanel>
                            <!--<DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RemainingTime}" Value="不可用">
                                    <Setter TargetName="enableChk" Property="IsEnabled" Value="false"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>-->
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--<DataGridTemplateColumn Header="启停" Width="*" MinWidth="80" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            --><!--<CheckBox Width="32" Style="{StaticResource SwitchCheckBoxStyle1}"   FocusManager.IsFocusScope="False"
                                      IsChecked="{Binding Source,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"                                                
                                      VerticalAlignment="Center" 
                                      HorizontalAlignment="Left" Click="CheckBox_Click"
                                      ></CheckBox>-->
                            <!--<Grid HorizontalAlignment="Center">
                                <Button  Foreground="#A0A0A0" Width="32" Height="16" ToolTip="启用" HorizontalAlignment="Center" Style="{StaticResource ImageActivationStartButton}"
                                        Command="{Binding DataContext.DelStrategyCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                         Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"/>
                            </Grid>--><!--


                            <StackPanel Orientation="Horizontal">
                                <Button   Foreground="#A0A0A0" Width="32" Height="16" ToolTip="启用" HorizontalAlignment="Left" Style="{StaticResource ImageActivationStartButton}"
                                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                         Visibility="{Binding ShowStopBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"/>
                                <Button   Foreground="#A0A0A0" Width="32" Height="16" ToolTip="停止" HorizontalAlignment="Left" Style="{StaticResource ImageInactiveStopButton}"
                                         Visibility="{Binding ShowStopBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"/>

                                <Button   Foreground="#A0A0A0" Width="32" Height="16" ToolTip="启用" HorizontalAlignment="Left" Style="{StaticResource ImageInactiveStartButton}"
                                         Visibility="{Binding ShowStartBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"/>
                                <Button   Foreground="#A0A0A0" Width="32" Height="16" ToolTip="停止" HorizontalAlignment="Left" Style="{StaticResource ImageActivationStopButton}"
                                         Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                         Visibility="{Binding ShowStartBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->

                <DataGridTemplateColumn Header="操作" Width="Auto" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" >
                                <Button x:Name="EditBtn" Height="16" Width="16"  ToolTip="编辑"
                                                        Command="{Binding DataContext.UpdateStrategyCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                        Style="{StaticResource MainPageImageSettingButton}" Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"
                                                        IsEnabled="{Binding EnabledBtn}" PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"/>
                                <Button Foreground="#A0A0A0" Width="16" Height="16" Margin="5,0,0,0" ToolTip="删除" HorizontalAlignment="Center" Style="{StaticResource DeleteButton}"
                                        Command="{Binding DataContext.DelStrategyCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                       IsEnabled="{Binding ShowDelete2Btn,Converter={StaticResource BooleanConvertor}}"  Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"/>
                                <Button Foreground="#A0A0A0" Width="15" Height="15" Margin="5,0,0,0" ToolTip="结束进程" HorizontalAlignment="Center" Style="{StaticResource KillButton}"
                                        Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                         Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="策略名"  Width="*" MinWidth="120" Binding="{Binding Quantid}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!--<DataGridTemplateColumn Header="日志" Width="Auto" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" >
                                <Button x:Name="btnReport"  Width="24" Height="24" Margin="1,0,0,0" ToolTip="日志"
                                        Command="{Binding DataContext.ExportLogCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                                        Style="{StaticResource AnsStatisticsButton2}" Visibility="{Binding ShowDeleteBtn,Converter={StaticResource visibilityConvertor}}" FontSize="10"
                                                        IsEnabled="{Binding EnabledBtn}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->

                <DataGridTextColumn Header="策略说明"  Width="*" MinWidth="100" Binding="{Binding Quantname}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="策略模板"  Width="*" MinWidth="110" Binding="{Binding TempletName}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="运行状态"  Width="*" MinWidth="80" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Name="txRun" Text="{Binding Enable}" HorizontalAlignment="Left" ToolTip="{Binding Remark}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Enable}" Value="启动">
                                    <Setter Property="Foreground"  TargetName="txRun" Value="#00FF8B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Enable}" Value="停止">
                                    <Setter Property="Foreground"  TargetName="txRun" Value="#A0A0A0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>

                        </DataTemplate>
                        
                        
                        
                        
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn Header="作者"  Width="*" MinWidth="100" Binding="{Binding Username}" />
                <DataGridTextColumn Header="最后编辑人"  Width="*" MinWidth="100" Binding="{Binding Closeby}" />
                <DataGridTextColumn Header="最后编辑时间" Width="*" MinWidth="140"  Binding="{Binding Updatetime, Converter={StaticResource UpdateTimeConverter}}"/>

                <DataGridTemplateColumn Header="策略标签"  MinWidth="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" >
                                <comp:BadgeComboBoxDisplay x:Name="EditBtn" DataContext="{Binding LABLE,Mode=TwoWay}" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="24"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="策略标签"  Width="*" MinWidth="140" Binding="{Binding LABLE2}" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>-->
            </DataGrid.Columns>
        </CommonComp:ExDataGrid>

        <Grid x:Name="OperationGrid" Height="41" VerticalAlignment="Bottom" Visibility="{Binding IsHiddenOperationGrid}" Margin="0,0,0,10" IsVisibleChanged="OperationGrid_IsVisibleChanged">

            <Border  Background="#193D37" IsHitTestVisible="False" BorderThickness="0 1 0 0" BorderBrush="#136C5E" Grid.ColumnSpan="3"/>
            <comp:HoverButton Content="开启" Width="50" Height="30" Margin="10,0,0,0" HorizontalAlignment="Left" Command="{Binding OpenCommand}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                           PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
            <comp:HoverButton Content="关闭" Width="50" Height="30" Margin="65,0,0,0" HorizontalAlignment="Left" Command="{Binding CloseCommand}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                           PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>
            <Rectangle Fill="#136C5E " HorizontalAlignment="Left" Margin="127,0,0,0" Height="24" Width="1"/>

            <TextBlock Foreground="#A0A0A0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 10 0">已选<Run Foreground="#FFFFFF" Text="{Binding CheckedCount}"/>条策略</TextBlock>

            <!--<comp:HoverButton Content="删除" Width="50" Height="30" Margin="0,0,10,0" HorizontalAlignment="Right" Command="{Binding ToDelCommand}"
                                           Padding="1" Style="{StaticResource HoverButton}"
                                           IsEnabled="{Binding BatchOperateBtnEnable}"
                                           Background="{StaticResource LightGrayButton.Static.Background}"
                                           BorderBrush="{StaticResource LightGrayButton.Static.Border}"
                                           Foreground="{StaticResource LightGrayButton.Static.Foreground}"
                                           PressBackground="{StaticResource LightGrayButton.Pressed.Background}" 
                                           PressBorderBrush="{StaticResource LightGrayButton.Pressed.Border}"
                                           HoverBackground="{StaticResource LightGrayButton.MouseOver.Background}" 
                                           HoverBorderBrush="{StaticResource LightGrayButton.MouseOver.Border}"/>-->
        </Grid>
    </Grid>
  
</UserControl>