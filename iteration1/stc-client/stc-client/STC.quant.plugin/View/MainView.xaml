            <!--<Grid Visibility="{Binding LockVisibility}" MouseLeftButtonDown="Grid_MouseLeftButtonDown" Grid.Row ="1" Background="black" Opacity="0.3" Margin="0 24 0 0" Grid.ColumnSpan="2"/>
            <Grid  Visibility="{Binding LockVisibility}" MouseLeftButtonDown="Grid_MouseLeftButtonDown" Grid.Column="2" Grid.RowSpan="2" Background="black" Opacity="0.3" ></Grid>-->


            <!--<fUI:LoadingMask x:Name="loadMask" Visibility="{Binding MaskVisibility}" Grid.ColumnSpan="3" Grid.RowSpan="2"/>-->
        </Grid>
    </Border>
</UserControl>
