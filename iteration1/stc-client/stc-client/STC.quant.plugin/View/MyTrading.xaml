<UserControl x:Class="STC.quant.plugin.View.MyTrading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Component="clr-namespace:STC.quant.plugin.View.Component" 
             xmlns:ViewModel="clr-namespace:STC.quant.plugin.ViewModel"
              xmlns:conv="clr-namespace:STC.quant.plugin.Convertor"
             xmlns:CommonComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="256" d:DesignWidth="1000" 
             Initialized="UserControl_Initialized" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/TabControlStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/DataGridStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/ButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/GridSplitterStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/ScrollViewerDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/CheckBoxStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.quant.plugin;component/Resources/ContextMenuStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--<ContextMenu x:Key="CopyContextMenu" Style="{StaticResource DefaultContextMenu}" ContextMenuOpening="UserControl_ContextMenuOpening">
                <MenuItem x:Name="copyRow" Header="复制" Style="{StaticResource DefaultMenuItem}" Click="copyRow_Click"/>
                <MenuItem x:Name="copySTCCode" Header="复制单号" Style="{StaticResource DefaultMenuItem}" Click="copySTCCode_Click"/>
            </ContextMenu>-->

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DataGridCellStyle1" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Border x:Name="Bg" Background="Transparent" UseLayoutRounding="True"  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" >
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="5,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


          
          
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="myTradeGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--<TabControl Grid.Row="0" x:Name="TradeInfo_tabControl2" Style="{StaticResource TabControlStyle1}"  Background="{StaticResource MainBackgroup.ColorBrush}" SelectionChanged="TradeInfo_tabControl_SelectionChanged" MinHeight="60">
                -->
        <!--我的订单-->
        <!--
                <TabItem x:Name="MyOrders_TabItem" Header="{Binding TotalCountOrderHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" >-->

        <Grid  Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource MainBackgroup.ColorBrush}">
            <Grid.RowDefinitions/>
            <TextBlock x:Name="txTitle" Grid.Row="0" Text="{Binding TotalCountOrderHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource ColorBrush.While}" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10, 0, 0, 0"></TextBlock>
        </Grid>

        <Grid Grid.Row="1">

            <DataGrid x:Name="MyOrders_Quant_dataGrid" ItemsSource="{Binding MyOrdersDV}"
                                  SelectedItem="{Binding SelectedItem_MyOrders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Style="{StaticResource DefaultDataGrid}" 
                                 Grid.ColumnSpan="3">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding UpdateTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}" Header="更新时间" Width="Auto" MinWidth="60"
                                                    Foreground="{StaticResource DataGrid.SubTitle.Foreground}" 
                                                    HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}" 
                                                    CellStyle="{StaticResource DataGridTextRightStyle}"/>
                    <DataGridTextColumn Binding="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}" 
                                                    ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                    Header="方向" Width="Auto" CellStyle="{StaticResource ColumnColorStyle}"/>
                    <DataGridTextColumn Binding="{Binding SecurityID}" Header="代码"  MinWidth="80" Width="Auto" FontWeight="SemiBold" ClipboardContentBinding="{Binding SecurityID}"/>
                    <DataGridTextColumn Binding="{Binding Symbol}" Header="简称"  MinWidth="85" Width="Auto" FontWeight="SemiBold" ClipboardContentBinding="{Binding Symbol}"/>
                    <DataGridTextColumn Binding="{Binding Price,Converter={StaticResource numConvertor},ConverterParameter=''}" Header="报价(%)" Width="Auto"  MinWidth="60" CellStyle="{StaticResource ColumnColorStyle}"/>
                    <DataGridTemplateColumn Header="报量(万元)" Width="Auto" MinWidth="80" CellStyle="{StaticResource DataGridCellStyle1}"
                                                        ClipboardContentBinding="{Binding Qty}" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border x:Name="warningTag" Background="Transparent" Width="6" Height="6" CornerRadius="3" DockPanel.Dock="Left"></Border>
                                    <TextBlock Text="{Binding Qty}"/>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding warningStatus}" Value="1">
                                        <Setter TargetName="warningTag" Property="Background" Value="#F9C152"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding NetPrice,Converter={StaticResource numConvertor}}" Header="净价(元)" Width="Auto" MinWidth="60" />
                    <DataGridTextColumn Binding="{Binding ExecQty,Converter={StaticResource numConvertor}}" Header="成交量(万元)" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Binding="{Binding SettleType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                    ClipboardContentBinding="{Binding SettleType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_myOrder'}" 
                                                    Header="清算速度" Width="Auto" MinWidth="40" SortMemberPath="SettlDate">
                        <!--<DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="ToolTip" Value="{Binding SettleType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                            </Style>
                        </DataGridTextColumn.CellStyle>-->
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ExecType,ConverterParameter=ordstatus, Converter={StaticResource EnumTypeConvertor}}" Header="状态" Width="Auto" MinWidth="50"/>

                    <DataGridTextColumn Binding="{Binding VenuesSelectDisplay}" Width="Auto" Header="渠道"   MinWidth="70"/>
                    <!--<DataGridTextColumn Binding="{Binding Veneues,ConverterParameter=venues, Converter={StaticResource EnumTypeConvertor}}" Header="渠道" Width="Auto" MinWidth="50"/>-->


                    <DataGridTextColumn Binding="{Binding STCCode}" Width="Auto" Header="STC单号"   MinWidth="135"/>
                    <DataGridTextColumn Binding="{Binding ordertype}" Width="Auto" Header="订单类型"   MinWidth="80"/>
                    <DataGridTextColumn Binding="{Binding QuantID}" Width="Auto" Header="策略名"   MinWidth="100"/>
                    <DataGridTextColumn Binding="{Binding OffsetFlag}" Header="开平标志" Width="Auto" MinWidth="80"/>
                </DataGrid.Columns>
            </DataGrid>


        </Grid>
        <!--<TextBlock Grid.Row="1" Margin="10,4,0,4" Foreground="#FFFFFF"  VerticalAlignment="Center" Grid.ColumnSpan="3">共<Run Text="{Binding TotalCount4MyOrders}"/>条订单，其中Bid <Run Text="{Binding TotalCount4MyBidOrders}"/> 条，Ofr <Run Text="{Binding TotalCount4MyOfrOrders}"/>条</TextBlock>-->

        <!--</TabItem>

            </TabControl>-->

        <GridSplitter  Grid.Row="2"  Background="{StaticResource MainBackgroup.ColorBrush}" Style="{StaticResource HGridSplitterStyle2}"/>

        <!--<TabControl Grid.Row="3" x:Name="TradeInfo_tabControl" Style="{StaticResource TabControlStyle1}"  Background="{StaticResource MainBackgroup.ColorBrush}" SelectionChanged="TradeInfo_tabControl_SelectionChanged" MinHeight="60">

                -->
        <!--我的成交-->
        <!--
                <TabItem x:Name="MyExecutions_TabItem" Header="{Binding TotalCountExecutionsHeader,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" >-->
        <Grid  Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource MainBackgroup.ColorBrush}">
            <Grid.RowDefinitions >
                <RowDefinition Height="24"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock x:Name="txTitle2"  Text="{Binding TotalCountExecutionsHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource ColorBrush.While}" FontFamily="{StaticResource IDCFontFamily.YaHei.Semibold}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10, 0, 0, 0" ></TextBlock>
            <DataGrid x:Name="MyExecutions_Quant_dataGrid" Grid.Row="4" Style="{StaticResource DefaultDataGrid}"
                          ItemsSource="{Binding MyExecutionsDV}" 
                          SelectedItem="{Binding SelectedItem_MyExecutions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="成交时间"  MinWidth="60" Width="Auto" Binding="{Binding ExecutionTime,Converter={StaticResource FormatDateTimeConvertor},ConverterParameter={StaticResource TimeFormatHHMMSS}}"
                                            Foreground="{StaticResource DataGrid.SubTitle.Foreground}" 
                                            HeaderStyle="{StaticResource DataGridColumnHeaderRightStyle}" 
                                            CellStyle="{StaticResource DataGridTextRightStyle}"/>
                    <DataGridTextColumn Binding="{Binding Side,Converter={StaticResource EnumTypeConvertor}, ConverterParameter='side'}" Width="Auto"
                                                    ClipboardContentBinding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                                    Header="方向"  MinWidth="40" CellStyle="{StaticResource ColumnColorStyle}"/>
                    <DataGridTextColumn Header="代码" Width="Auto" MinWidth="80" Binding="{Binding SecurityID}" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="简称" Width="Auto" MinWidth="85" Binding="{Binding Symbol}"  FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="成交价(%)" Width="Auto" MinWidth="60" Binding="{Binding LastPx_Display, Converter={StaticResource numConvertor}}" SortMemberPath="LastPx"
                                            FontWeight="SemiBold" />
                    <DataGridTextColumn Header="净价(元)" Width="Auto" MinWidth="60" Binding="{Binding NetPrice,Converter={StaticResource numConvertor}}"/>

                    <DataGridTextColumn Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                                    ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                                    Header="清算速度" Width="Auto" MinWidth="50" SortMemberPath="SettlDate">
                        <!--<DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="ToolTip" Value="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                            </Style>

                        </DataGridTextColumn.CellStyle>-->
                    </DataGridTextColumn>



                    <DataGridTextColumn Header="成交量(万)" Width="Auto" MinWidth="60" Binding="{Binding LastQty}"/>

                    <!--<DataGridTextColumn Binding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                                    ClipboardContentBinding="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" 
                                                    Header="清算速度"  MinWidth="60" SortMemberPath="SettlDate">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="ToolTip" Value="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype_tooltip'}" />
                            </Style>

                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>-->

                    <DataGridTextColumn Binding="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues_exe'}" 
                                                    ClipboardContentBinding="{Binding Venues, Converter={StaticResource EnumTypeConvertor},ConverterParameter='venues_exe'}" 
                                                    Header="渠道" Width="Auto" MinWidth="60"/>
                    <DataGridTextColumn Header="成交编号" Width="Auto" MinWidth="150" Binding="{Binding ExecID}"/>
                    <DataGridTextColumn Binding="{Binding StrategyOrderID}" Header="STC单号" Width="Auto"  MinWidth="135"/>
                    <DataGridTextColumn Binding="{Binding QuantID}" Header="策略名" Width="Auto"  MinWidth="100"/>
                    <DataGridTemplateColumn Header="对手方" Width="Auto" MinWidth="80"  MaxWidth="200" ClipboardContentBinding="{Binding CounterPartyName, Converter={StaticResource StringConvertor}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CounterPartyName, Converter={StaticResource StringConvertor}}" TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="对手交易员" Width="Auto" MinWidth="90"  MaxWidth="200" ClipboardContentBinding="{Binding CounterPartySubName, Converter={StaticResource StringConvertor}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CounterPartySubName, Converter={StaticResource StringConvertor}}" TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding OffsetFlag}" Header="开平标志" Width="Auto" MinWidth="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--</TabItem>

            </TabControl>-->
    </Grid>

</UserControl>
