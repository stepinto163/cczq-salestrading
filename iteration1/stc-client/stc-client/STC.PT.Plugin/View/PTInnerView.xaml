<UserControl x:Class="STC.PT.Plugin.View.PTInnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.PT.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:Component="clr-namespace:STC.PT.Plugin.View.Component" 
             xmlns:ViewModel="clr-namespace:STC.PT.Plugin.ViewModel" 
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:fcon="clr-namespace:STC.PT.Plugin.Convertor"
             xmlns:commConv="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:fUI="clr-namespace:STC.Common.View.UI;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1500" Initialized="UserControl_Initialized">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.PT.Plugin;component/Resources/ButtonStyleDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <commConv:DaysOffStrConverter x:Key="DaysOffCon"/>
            <commConv:ReverseVisibilityConvertor x:Key="reverseVisibilityConvertor"/>
            <commConv:VisibilityConvertor x:Key="visibilityConvertor"/>
            <fcon:BondFieldConvertor x:Key="BondFieldConvertor"/>
            <commConv:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <commConv:NumberConvertor3 x:Key="numConvertor3"/>
            <commConv:TreasuryFutureConvertor x:Key="treasuryFutureConverter"/>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>


            <SolidColorBrush x:Key="ColorBrush.Yellow" Color="#C29B4E"></SolidColorBrush>

            <Style x:Key="TextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="{StaticResource SmallContentFontSize}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Delflag}" Value="1">
                        <Setter Property="Foreground" Value="{StaticResource Text.Foreground.NoPermission}"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ColumnColorStyle2" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Sendstatus}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Red}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Delflag}" Value="1">
                        <Setter Property="Foreground" Value="{StaticResource Text.Foreground.NoPermission}"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ApprovalstatusColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Sendstatus}" Value="3">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Red}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Sendstatus}" Value="7">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Red}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Sendstatus}" Value="4">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Green}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Sendstatus}" Value="9">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Green}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ColumnColorStyle3" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Matchstatus}" Value="0">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Yellow}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ExecIDTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!--<Button x:Name="cleanBtn" Style="{DynamicResource CleanButton}" Click="closeButton_Click" Width="{Binding Height, ElementName=CommonSearchTextBox, Mode=TwoWay}" Padding="2" Visibility="Visible"/>-->

                                    <Border x:Name="search_border" Background="Transparent" Width="{TemplateBinding Height}" Height="{TemplateBinding Height}" BorderBrush="{TemplateBinding BorderBrush}" Visibility="Collapsed">
