                                <Grid>
                                    <ContentPresenter  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{DynamicResource  SvgButton.MouseOver.Background}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource  SvgButton.MouseOver.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{DynamicResource  SvgButton.MouseOver.Background}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource  SvgButton.MouseOver.Foreground}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="background" Value="{DynamicResource  SvgButton.MouseOver.Background}"/>
                                    <Setter Property="Fill" TargetName="svg_path" Value="{DynamicResource  SvgButton.MouseOver.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition x:Name="p_part" Height="2*" />
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition x:Name="r_part"  Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0"  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Button x:Name="btnEnter" Width="80" Height="20" Content="手工录入" Style="{StaticResource BlueGreenStyle}" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Command="{Binding EnterCommand}"/>
            <Button x:Name="btnRecognize" Width="80" Height="20" Content="成交识别" Style="{StaticResource BlueGreenStyle}" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Command="{Binding BatchRecognizeCommand}"/>
            <Button x:Name="btnMannelSend" Width="80" Height="20" Content="手工下发" Style="{StaticResource BlueGreenStyle}" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Command="{Binding MannelSendCommand}"/>
            <Button x:Name="btnCancelSend" Width="80" Height="20" Content="撤销下发" Style="{StaticResource BlueGreenStyle}" Margin="4,0,0,0" HorizontalAlignment="Left"  VerticalAlignment="Center" Command="{Binding CancelSendCommand}"/>
            <ListBox x:Name="lbSettlType" Background="Transparent" VerticalAlignment="Center" SelectionMode="Single" SelectionChanged="lbSettlType_SelectionChanged" Visibility="Collapsed">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="ALL" Width="40" Height="16" x:Name="All" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True" />
                <!--<ListBoxItem Content="+1" Width="56" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}"/>-->
                <ListBoxItem Content="+0" Width="56" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="今+1" Width="56" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="明+0" Width="56" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
                <ListBoxItem Content="远期" Width="56" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
            </ListBox>
            <ListBox x:Name="lbAssetType" Background="Transparent" VerticalAlignment="Center" SelectionMode="Single" SelectionChanged="lbAssetType_SelectionChanged"  Margin="4 0 0 0" Visibility="Collapsed">
                <ListBox.Template>
                    <ControlTemplate>
                        <WrapPanel Background="{TemplateBinding Background}" Orientation="Horizontal" IsItemsHost="True" ScrollViewer.CanContentScroll="True"/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Content="ALL" Width="40" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}" IsSelected="True" />
                <ListBoxItem Content="现券" Width="56" Height="16" Style="{StaticResource CommonFilterListBoxItemStyle}"/>
