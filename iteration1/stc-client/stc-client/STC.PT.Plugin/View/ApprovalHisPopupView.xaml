<UserControl x:Class="STC.PT.Plugin.View.ApprovalHisPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.PT.Plugin.View"
             xmlns:commConv="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             FontSize="12"
             Foreground="{DynamicResource DefaultForegroup.ColorBrush}" MaxHeight="507"
             d:DesignHeight="168" d:DesignWidth="489" Background="Transparent" Height="Auto" Width="Auto">
    <UserControl.Resources>
        <ResourceDictionary>
            <commConv:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border BorderThickness="1,1,1,1" CornerRadius="0" BorderBrush="#A0A0A0"  Background="#4E4E4E">
            <DataGrid x:Name="dg" 
                  ItemsSource="{Binding Mv}" AutoGenerateColumns="False" Style="{DynamicResource DefaultDataGrid}"
                  RowHeaderWidth="0" 
                  VerticalGridLinesBrush="Transparent" HorizontalAlignment="Stretch"
                  Background="{DynamicResource MainListTitleBackgroup.ColorBrush}"
                  VirtualizingPanel.IsVirtualizing="True" Margin="0 0 0 0"
                  EnableRowVirtualization="True" VirtualizingPanel.IsContainerVirtualizable="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="审批状态" 
                                        ClipboardContentBinding="{Binding Approvalstatus, Converter={StaticResource EnumTypeConvertor},ConverterParameter='Approvalstatus'}"                                          
                                        MinWidth="60" IsReadOnly="True">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                <Setter Property="Foreground" Value="{StaticResource DefaultForegroup.ColorBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Approvalstatus}" Value="3">
                                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Red}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Approvalstatus}" Value="7">
                                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Red}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Approvalstatus}" Value="4">
                                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Green}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Approvalstatus}" Value="9">
                                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Green}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="approvalstatustb" Foreground="#FFFFFF" 
                                       Text="{Binding Approvalstatus, Converter={StaticResource EnumTypeConvertor},ConverterParameter='Approvalstatus'}" 
                                       Padding="0" TextTrimming="CharacterEllipsis" 
                                       ToolTip="{Binding Approvalstatus, Converter={StaticResource EnumTypeConvertor},ConverterParameter='Approvalstatus'}"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="145" Header="单号">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Approvalorderid}" ToolTip="{Binding Approvalorderid}" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold" FontFamily="MicroSoftYaiHei" FontSize="12"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="70" Header="时间">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Updatetime}" ToolTip="{Binding Updatetime}" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold" FontFamily="MicroSoftYaiHei" FontSize="12"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  MinWidth="70" Header="审批系统">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Approvalterminal}" ToolTip="{Binding Approvalterminal}" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold" FontFamily="MicroSoftYaiHei" FontSize="12"></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
