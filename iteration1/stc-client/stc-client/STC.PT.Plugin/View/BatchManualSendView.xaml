<commComp:WindowBase x:Class="STC.PT.Plugin.View.BatchManualSendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.PT.Plugin.View"
             xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:fcon="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             xmlns:ptfcon="clr-namespace:STC.PT.Plugin.Convertor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Width="740" Height="380" Title="手工下发">
    <commComp:WindowBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <fcon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <fcon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <fcon:ReverseVisibilityConvertor x:Key="reversevisibilityConvertor"/>
            <fcon:BooleanConvertor x:Key="booleanConvertor"/>
            <ptfcon:BondFieldConvertor x:Key="BondFieldConvertor"/>
            <fcon:NumberConvertor3 x:Key="numConvertor3"/>
            
        </ResourceDictionary>
    </commComp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="70"></RowDefinition>
        </Grid.RowDefinitions>
        <commComp:ExDataGrid x:Name="sendDataGrid" ItemsSource="{Binding Mv}" Grid.Row="0"
                            Style="{DynamicResource DefaultDataGridNoHeadSpaceStyle}">
            
            <!--SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"-->
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选择" Width="27" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="CheckBox_All" 
                                              IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" Height="12" Margin="6,0,0,0"
                                              Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" BorderBrush="{DynamicResource GraySlateButton.Static.Border}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk"
                                      IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Style="{DynamicResource GreenBlueCheckedNormalCheckBox}" 
                                      BorderBrush="{DynamicResource GraySlateButton.Static.Border}" Height="12"></CheckBox>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentDate}" Value="0">
                                    <Setter TargetName="Selected_Chk" Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Venueexecid}" Header="成交编号" Width="Auto" MinWidth="85"/>
                <DataGridTextColumn Header="关联号" MinWidth="80" Binding="{Binding Blocknum}"/>
                <DataGridTextColumn Binding="{Binding TradeDate}" Header="交易日期" Width="Auto" MinWidth="70"/>
                <DataGridTextColumn Binding="{Binding SecurityID}" Header="债券代码" Width="Auto" MinWidth="70"/>
                <DataGridTextColumn Binding="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" Header="方向" Width="Auto" MinWidth="30"/>
                <DataGridTextColumn Header="成交价(%)" Width="Auto" MinWidth="40" SortMemberPath="LastPx"
                                                FontWeight="SemiBold">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource BondFieldConvertor}" ConverterParameter="Price">
                            <Binding Path="LastPx_Display" />
                            <Binding Path="MarketIndicator" />
                            <Binding Source="Price" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="净价(元)" Width="Auto" MinWidth="70">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource numConvertor3}">
                            <Binding Path="NetPrice" />
                            <Binding Path="MarketIndicator" />
                            <Binding Path="MinChange" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="成交量(万元)" MinWidth="50">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource BondFieldConvertor}" ConverterParameter="Amount">
                            <Binding Path="LastQty" />
                            <Binding Path="MarketIndicator" />
                            <Binding Source="Amount" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding SettlType}" Header="清算速度" Width="Auto" MinWidth="30"/>
                <DataGridTextColumn Binding="{Binding InstitutionName}" Header="客户机构" Width="Auto" MinWidth="70"/>
                <DataGridTextColumn Binding="{Binding TraderName}" Header="客户" Width="Auto" MinWidth="10"/>

            </DataGrid.Columns>
        </commComp:ExDataGrid>
        <Border Grid.Row="1" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{DynamicResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource RedButtonStyle}"
                        Command="{Binding ConfirmCommand}" >确定</Button>
            </StackPanel>

        </Border>
    </Grid>
</commComp:WindowBase>
