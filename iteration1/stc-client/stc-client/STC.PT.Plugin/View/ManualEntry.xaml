                </ListBox.ItemsPanel> <!--IsSelected="{Binding OpenSelected, Mode=TwoWay}"IsSelected="{Binding CloseSelected, Mode=TwoWay}"-->
                <ListBoxItem x:Name="lbOpen" Width="47"  Height="24" Content="开仓" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                <ListBoxItem x:Name="lbClose"  Width="47" Height="24" Content="平仓" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
            </ListBox>
        </StackPanel>
        <StackPanel  x:Name="AccountSP" Orientation="Horizontal" Grid.Row="9" Grid.ColumnSpan="8" Margin="0 4 0 4">
            <TextBlock Text="交易标签:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="8" Grid.Column="0" Margin="8,0,0,0"/>
            <ComboBox x:Name="comLable"  Style="{StaticResource ComboBoxStyle}"
                 SelectedValuePath="Key" DisplayMemberPath="Value" Margin="6,0,0,0" HorizontalAlignment="Left"
                              VerticalAlignment="Center" SelectedIndex="0"   Height="24" Width="120" Grid.Row="8" Grid.Column="1" >
            </ComboBox>

            <TextBlock Text="投组账户:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="8" Grid.Column="2" Margin="10,0,0,0"/>
            <ComboBox x:Name="AccountUserCbc" ItemsSource="{Binding AccountUserSource}" Style="{StaticResource ComboBoxStyle}" 
                      SelectedItem="{Binding AccountUserItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="6, 0, 0, 0"  Height="24" Width="120" Grid.Row="8" Grid.Column="3"  VerticalContentAlignment="Center"
                      HorizontalAlignment="Left">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id}" />
                            <TextBlock x:Name="midTB" Text="-" />
                            <TextBlock Text="{Binding AccountName}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Id, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                <Setter TargetName="midTB" Property="Text" Value=""/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="渠道:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="8" Grid.Column="4" Margin="10,0,0,0"/>
            <ComboBox x:Name="comVenue"  Style="{StaticResource ComboBoxStyle}"
             SelectedValuePath="Key" DisplayMemberPath="Value"  Margin="6,0,0,0" 
        VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="72" Grid.Row="8" Grid.Column="5">
            </ComboBox>
        </StackPanel>
       


        <TextBlock Name="txCopyTxt" Text="{Binding CopyTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left"
                   Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="8" Foreground="{StaticResource Title.Foreground}" FontWeight="Bold" />
        <Border Grid.ColumnSpan="8" Grid.Row="11" BorderBrush="#232323" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{StaticResource GrayButtonStyle}"
                            Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}"
                        Click="btnOK_Click" >确定</Button>
                <Button x:Name="btnSend" Width="100" Height="24" Margin="4,0,0,0" Style="{StaticResource RedButtonStyle}" Visibility="Collapsed"
                        Click="btnSend_Click" >推送</Button>
            </StackPanel>

        </Border>
    </Grid>
</commComp:WindowBase>
