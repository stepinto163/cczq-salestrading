<UserControl x:Class="STC.PT.Plugin.View.PostTradeGUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.PT.Plugin.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.PT.Plugin;component/Resources/RadioButtonStyleDictionary.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>

           
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">

            <!--<RadioButton x:Name="Overview" 
                             Style="{StaticResource BoxRadioButton}" Margin="0,0,2,0"
                          IsChecked="True"    Click="Overview_Click">交易概览</RadioButton>-->
            <RadioButton x:Name="InternalTransaction" 
                             Style="{StaticResource BoxRadioButton}" Margin="0,0,2,0"
                          IsChecked="True"   Click="InternalTransaction_Click">内部成交</RadioButton>
            <!--<RadioButton x:Name="ExternalTransaction" 
                             Style="{StaticResource BoxRadioButton}" Margin="0,0,2,0"
                             Click="ExternalTransaction_Click">外部成交</RadioButton>
            <RadioButton x:Name="OrderInquiry" 
                             Style="{StaticResource BoxRadioButton}" Margin="0,0,2,0"
                             Click="OrderInquiry_Click">订单查询</RadioButton>-->
        </StackPanel>
        <Frame Name="PTFrame" NavigationUIVisibility="Hidden" Grid.Row="1">
            <Frame.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="24*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Frame.Content>
        </Frame>
        </Grid>
</UserControl>
