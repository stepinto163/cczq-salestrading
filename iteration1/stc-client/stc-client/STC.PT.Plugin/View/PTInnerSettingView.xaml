<UserControl x:Class="STC.PT.Plugin.View.PTInnerSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STC.PT.Plugin.View" 
             xmlns:commConv="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/STC.Frame;component/Resources/StyleDict.xaml"/>
                <ResourceDictionary Source="/STC.Common;component/Resources/STC.SkinStyle.xaml"/>
                <ResourceDictionary Source="/STC.PT.Plugin;component/Resources/PT.SkinStyle.xaml"/>-->
                <!--<ResourceDictionary Source="/STC.PT.Plugin;component/Resources/TextBoxStyleDictionary.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
            <commConv:BooleanConvertor x:Key="booleanConvertor"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="上证席位号:" Foreground="#D7D7D7" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="1"/>
        <TextBox  Margin="5,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="120"
                  Text="{Binding SHNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="1" Grid.Column="2"  Style="{DynamicResource  STCDefaultBoxStyle}"/>
        <TextBlock Text="深证席位号:" Foreground="#D7D7D7" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="1"/>
        <TextBox  Margin="5,0,0,0"  VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="120"
                  Text="{Binding SZNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="2" Grid.Column="2"  Style="{DynamicResource  STCDefaultBoxStyle}"/>
        <TextBlock Text="机构:" Foreground="#D7D7D7" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="1"/>
        <TextBox  Margin="5,0,0,0"  VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="120"
                  Text="{Binding PartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabledInst,Converter={StaticResource booleanConvertor}}"
                 Grid.Row="3" Grid.Column="2"  Style="{DynamicResource  STCDefaultBoxStyle}"/>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Margin="16,15,0,0">
            <TextBlock Text="分割符" Foreground="#D7D7D7"/>

            <RadioButton x:Name="SpaceChk" Content="空格" Style="{DynamicResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding IsSpaceChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <RadioButton x:Name="TwoSpaceChk" Content="空格(2)" Style="{DynamicResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsTwoSpaceChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <RadioButton x:Name="LongSpaceChk" Content="长空格" Style="{DynamicResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsLongSpaceChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <RadioButton x:Name="TagChk" Content="Tab制表符" Style="{DynamicResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsTagChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!--<StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Margin="16,15,0,0">
            <TextBlock Text="内部交易发送规则：" Foreground="#D7D7D7"/>

            <RadioButton Content="打包发送" Style="{DynamicResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7" Margin="5 0 0 0" IsChecked="{Binding IsPackSendChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <RadioButton Content="逐笔发送" Style="{DynamicResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsStrokeSendChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <RadioButton Content="选择一笔发送" Style="{DynamicResource  DefaultRadioButtonStyle}" Foreground="#D7D7D7"  Margin="5 0 0 0" IsChecked="{Binding IsOneSendChk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>-->
    </Grid>
</UserControl>
