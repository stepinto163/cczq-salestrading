<commComp:WindowBase x:Class="STC.PT.Plugin.View.ExecManage.AddIntentionQuoteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.PT.Plugin.View.ExecManage"
        xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common" 
        xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="产生个需" WindowStartupLocation="CenterScreen" BorderThickness="1" BorderBrush="#A0A0A0"
        Height="170" Width="300">
    <commComp:WindowBase.Resources>
        <ResourceDictionary>
            <Style x:Key="TextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Gray14}"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </commComp:WindowBase.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Grid.Row="1" Margin="4,0,4,0" Text="投资经理:" Style="{StaticResource TextBlockStyle}"></TextBlock>
        <!--<commComp:MultiSelectComboBox x:Name="investorstcb" HorizontalAlignment="Left" 
                        Width="100" Height="22" 
                              ItemsSource="{Binding InvestorstItemsSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              SelectedValues="{Binding SelectedInvestorstItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              VerticalAlignment="Center" Background="{DynamicResource MainBackgroup.ColorBrush}" 
                              Margin="4 0 0 0" DefaultText="ALL"/>-->
        <ComboBox x:Name="investorstcb" Grid.Column="1" Grid.Row="1"
                  Style="{DynamicResource ComboBoxStyle}" 
                SelectedValuePath="Key" DisplayMemberPath="Value"  
                Margin="4,0,0,0" HorizontalAlignment="Left" 
                ItemsSource="{Binding InvestorstItemsSource, Mode=TwoWay}"
                SelectedValue="{Binding SelectedInvestorstItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalAlignment="Center" SelectedIndex="0" Height="24" Width="160">
        </ComboBox>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="报量:" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txQty" Grid.Column="0" FontSize="14" Margin="4,0,1,0" 
                         VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160"   
                         Style="{DynamicResource  STCDefaultBoxStyle}"
                         PreviewTextInput="TxPrice_PreviewTextInput"
                         input:InputMethod.IsInputMethodEnabled="False" 
                         Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="1" Margin="1,0,0,0"  Text="万" 
                           VerticalAlignment="Center" HorizontalAlignment="Left" 
                           Background="Transparent" />
            </Grid>
        </StackPanel>
        <Grid Grid.Row="3" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnCancel" Width="60" Height="24" Style="{DynamicResource GrayButtonStyle}"
                Click="btnCancel_Click">取消</Button>
                <Button x:Name="btnOK" Width="80" Height="24" Margin="4,0,0,0" Style="{DynamicResource RedButtonStyle}"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding ConfirmIsEnabled}">确定</Button>
                
            </StackPanel>
        </Grid>
    </Grid>
</commComp:WindowBase>
