<comp:WindowBase x:Class="STC.PT.Plugin.View.ExecManage.MatchIntentionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STC.PT.Plugin.View.ExecManage"
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
                 xmlns:localcomp="clr-namespace:STC.PT.Plugin.View.Component"
             xmlns:commConv="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
                  xmlns:ViewModel="clr-namespace:STC.PT.Plugin.ViewModel.ExecManage" 
        mc:Ignorable="d"
        Title="匹配个需" d:DesignHeight="450" d:DesignWidth="800" Width="1280" Height="500">
    <Window.Resources>
        <ResourceDictionary>

            <commConv:DaysOffStrConverter x:Key="DaysOffCon"/>
            <commConv:ReverseVisibilityConvertor x:Key="reverseVisibilityConvertor"/>
            <commConv:VisibilityConvertor x:Key="visibilityConvertor"/>
            <commConv:BondFieldConvertor x:Key="BondFieldConvertor"/>
            <commConv:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <commConv:NumberConvertor3 x:Key="numConvertor3"/>
            <commConv:TreasuryFutureConvertor x:Key="treasuryFutureConverter"/>
            <commConv:MultiCompareConverter x:Key="multiCompareConverter"/>
            <commConv:SubStringConverter x:Key="subStringConverter"/>
            <Style x:Key="ColumnColorStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource DataGridCellStyle}">
                <Setter Property="Foreground" Value="{StaticResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{StaticResource ColorBrush.Blue}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Delflag}" Value="1">
                        <Setter Property="Foreground" Value="{StaticResource Text.Foreground.NoPermission}"/>
                        <Setter Property="FontFamily" Value="Roboto" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- 居中 -->
            <Style x:Key="SelfDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 图标样式 -->
            <Style x:Key="InfoIconStyle" TargetType="Path">
                <Setter Property="Fill" Value="Gray"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource SlateGrayButton.MouseOver.Background}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="8"/>
            <RowDefinition/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Text="{Binding CurrentItem.SecurityID}" Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Text="{Binding CurrentItem.Symbol}"  Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Text="{Binding CurrentItem.Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                       Margin="8 0 0 0" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock Text="已匹配量:"/>
            <TextBlock Text="{Binding RelatedQty, Converter={StaticResource StringConvertor}}"/>
            <TextBlock Text="/"/>
            <TextBlock Text="{Binding LastQty, Converter={StaticResource StringConvertor}}"/>
            <TextBlock Text="万"/>
            <Button x:Name="RefreshBtn" Content="刷新" Margin="10 0 0 0" Style="{DynamicResource BlueButtonStyle}" 
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>
        <DataGrid Grid.Row="2" Style="{DynamicResource DefaultDataGrid}" ItemsSource="{Binding Mv.View}" 
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding DataGridIsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  >
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DelFlag}" Value="1">
                            <Setter Property="Foreground" Value="#9D9D9D" />
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <!--勾选-->
                <DataGridTemplateColumn x:Name="checkedColumn" Header="勾选" MinWidth="40" Width="40" 
                                        MaxWidth="40" HeaderStyle="{StaticResource SelfDataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="CheckBox_All" Click="CheckBox_All_Click" 
                                            IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor},UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Style="{DynamicResource DefaultCheckBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox x:Name="Selected_Chk" Click="Selected_Chk_Click" 
                                      IsChecked="{Binding IsChecked,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                      IsEnabled="{Binding IsCheckEnable,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Style="{DynamicResource DefaultCheckBoxStyle}" Unchecked="Selected_Chk_Unchecked"></CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="投资经理" MinWidth="60" Width="Auto" MaxWidth="130" CanUserSort="True" 
                                    SortMemberPath="InvestorName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">

                                    <TextBlock Text="{Binding InvestorName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InvestorName}" Visibility="{Binding EditBtnVisible}" HorizontalAlignment="Left"/>
                                    <comp:AutoCompleteComboBox x:Name="Investor_edit"
                                                       DisplayValuePath="Name"
                                                       SelectedItem="{Binding SelectedInvestor_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding InvestorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="投资经理" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" PatternChanged="Investor_edit_PatternChanged" 
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding InvestorEnable}"  Visibility="{Binding SaveBtnVisible}">
                                        <comp:AutoCompleteComboBox.AutoCompColumns>
                                            <DataGridTemplateColumn  Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent">
                                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Name }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                                <TextBlock.ToolTip>
                                                                    <ToolTip Content="{Binding Text}"/>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </comp:AutoCompleteComboBox.AutoCompColumns>
                                    </comp:AutoCompleteComboBox>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="交易员" Width="Auto" MinWidth="60"  MaxWidth="130" CanUserSort="True"  SortMemberPath="TraderName_Buyer">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">

                                    <TextBlock x:Name="TraderNameBuyerTB"  Text="{Binding TraderName_Buyer}" Visibility="{Binding EditBtnVisible}" HorizontalAlignment="Left"/>
                                    <comp:AutoCompleteComboBox x:Name="TraderCb_edit" Margin="5 0 0 0"
                                                       DisplayValuePath="Name"
                                                       SelectedItem="{Binding SelectedTrader_Buy_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Text="{Binding TraderName_Buyer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       BackGroundCob="{DynamicResource TextBox.Static.Background}" 
                                                      
                                                       MouseOverBorderBrushCob="{DynamicResource TextBox.MouseOver.Border}" 
                                                       FocusBorderBrushCob="{DynamicResource TextBox.Focus.Border}"
                                                       Watermark="交易员" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                          VerticalAlignment="Center" VerticalContentAlignment="Center" PatternChanged="TraderCb_edit_PatternChanged"  IsEnabled="{Binding TraderEnable}"  Visibility="{Binding SaveBtnVisible}" >
                                        <comp:AutoCompleteComboBox.AutoCompColumns>
                                            <DataGridTemplateColumn MinWidth="100" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent">
                                                            <TextBlock Grid.Column="0" Height="22" Text="{Binding Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                                TextTrimming="CharacterEllipsis" >
                                                                <TextBlock.ToolTip>
                                                                    <ToolTip Content="{Binding Text}"/>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </comp:AutoCompleteComboBox.AutoCompColumns>
                                    </comp:AutoCompleteComboBox>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="INTENTION_DETAIL">
                                    <Setter Property="Text" TargetName="TraderNameBuyerTB" Value=""/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--SelectedId="{Binding BookId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedTexts="{Binding BookName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentId="{Binding SelectedGroupItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentTexts="{Binding SelectedGroupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentItems="{Binding SelectedGroupDict, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedProductId="{Binding HsProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"-->
                <DataGridTemplateColumn  Header="组合名称" Width="Auto" MinWidth="60" MaxWidth="120" SortMemberPath="BookName" ClipboardContentBinding="{Binding BookName}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock Text="{Binding BookName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BookName}" Visibility="{Binding EditBtnVisible}" HorizontalAlignment="Left"/>
                                    <comp:MultiTreeComboBox    Margin="0 0 0 0"  x:Name="cmbMultiTree" SelectedItemChanged="cmbMultiTree_SelectedItemChanged"
                            VerticalAlignment="Center" Foreground="{StaticResource ComboBoxItem.Static.Foreground}"
                            TreeItemsSource="{x:Static ViewModel:MatchIntentionViewModel.MultiTreeComboxItemsSource}" 
                            IsEnableMultiSelect="False" DefaultText="" IsEnableSelectRootNode="False" IsEnableSearch="True" DisplayPath="PA"
                            SelectedId="{Binding SelectedTradeAccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem2="{Binding SelectedTradeAccountCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedTexts="{Binding SelectedTradeAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentId="{Binding SelectedGroupItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentTexts="{Binding SelectedGroupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedParentItems="{Binding SelectedGroupDict, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedProductId="{Binding HsProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       IsEnabled="{Binding EditEnable}"  Visibility="{Binding SaveBtnVisible}">

                                        <comp:MultiTreeComboBox.TreeItemItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Nodes}">
                                                <StackPanel Orientation="Horizontal" Height="24">
                                                    <Button  Margin="0, 0, 4, 0" VerticalAlignment="Center" ToolTip="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Tag="{Binding Id}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource TreeCheckBoxButton}">
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding  RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                                            <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                                            <Condition Binding="{Binding IsLeaf}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                                            <Condition Binding="{Binding IsGroup}" Value="False"/>
                                                                            <Condition Binding="{Binding IsLeaf}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type comp:MultiTreeComboBox}}, Path=IsEnableSelectRootNode}" Value="False"/>
                                                                            <Condition Binding="{Binding IsGroup}" Value="True"/>
                                                                            <Condition Binding="{Binding IsLeaf}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <!--<Image Style="{StaticResource ImageStyle}" Width="13" Height="13" Margin="0,0,3,0"/>-->
                                                    <TextBlock Margin="0, 0, 0, 0" Text="{Binding Name}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Checked}" Value="1">
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.PaleGrey}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.While}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Margin="6, 0, 0, 0" Text="{Binding Id}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#F0C49F"></TextBlock>
                                                    <TextBlock Margin="2, 0, 0, 0" Text="{Binding ProductId, StringFormat=({0}), TargetNullValue=(空)}" FontFamily="MicroSoft YaHei" VerticalAlignment="Center" Foreground="#FFFFFF">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProductId}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLeaf}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ProductId}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                            </HierarchicalDataTemplate>
                                        </comp:MultiTreeComboBox.TreeItemItemTemplate>
                                    </comp:MultiTreeComboBox>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Header="组合代码" Width="Auto" MinWidth="50" MaxWidth="150" SortMemberPath="AccountName" ClipboardContentBinding="{Binding AccountName}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BookId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BookId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn  Header="恒生基金编号" Width="Auto" MinWidth="50" MaxWidth="150" SortMemberPath="AccountName" ClipboardContentBinding="{Binding HsProductId}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding HsProductId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HsProductId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="方向" Width="50" 
                                    Binding="{Binding Side, Converter={StaticResource EnumTypeConvertor},ConverterParameter='side'}" 
                                    CellStyle="{StaticResource ColumnColorStyle}"/>


                <DataGridTemplateColumn Header="报价" MinWidth="20" Width="130" MaxWidth="200" CanUserSort="True" SortMemberPath="Price" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Border x:Name="PriceBorder" Visibility="{Binding EditBtnVisible}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="priceType_bd" Width="16" Height="16" BorderThickness="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="priceType_txt" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Normal" FontSize="12"/>
                                            </Border>
                                            <TextBlock x:Name="Price_Display" Text="{Binding Price_Display, StringFormat={}{0:0.00##}}" VerticalAlignment="Center"
                                            Style="{DynamicResource SideTextBlockStyle}" Grid.Column="1"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="PriceBorder2" IsEnabled="{Binding EditEnable}"  Visibility="{Binding SaveBtnVisible}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <comp:NumericUpDown x:Name="PriceNU_Edit" NumericValue="{Binding Price_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                    Loaded="PriceNU_Edit_Loaded" Background="#0F0F0F" 
                                                    MinValue="-100" MaxValue="9999" DecimalLength="4" RangeValue="0.005" VerticalAlignment="Center" AllowEmpty="True"
                                                        IsEnabled="{Binding EditEnable}"  Visibility="{Binding SaveBtnVisible}" Grid.Column="0"/>
                                            <ComboBox x:Name="cbPriceType_edit"  VerticalContentAlignment="Center" Grid.Column="1"
                                          ItemsSource="{x:Static ViewModel:MatchIntentionViewModel.PriceTypeEmptyDic}" 
                                          DisplayMemberPath="Value"  SelectedValuePath="Key"
                                          SelectedValue="{Binding PriceType,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{DynamicResource  ComboBoxStyle}"
                                          FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" 
                                              >
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                </Grid>
                            </Grid>




                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Price,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <!--<Setter TargetName="PriceBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="PriceBorder" Property="BorderBrush" Value="red"/>-->
                                    <Setter TargetName="Price_Display" Property="Text" Value="--"/>
                                    <Setter TargetName="Price_Display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                                <!--行权收益率-->
                                <DataTrigger Binding="{Binding PriceType}" Value="7">
                                    <Setter TargetName="priceType_bd" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="priceType_bd" Property="BorderBrush" Value="#964E00"/>
                                    <Setter TargetName="priceType_txt" Property="Text" Value="权"/>
                                    <Setter TargetName="priceType_txt" Property="Foreground" Value="#964E00"/>
                                </DataTrigger>
                                <!--净价-->
                                <DataTrigger Binding="{Binding PriceType}" Value="1">
                                    <Setter TargetName="priceType_bd" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="priceType_bd" Property="BorderBrush" Value="Green"/>
                                    <Setter TargetName="priceType_txt" Property="Text" Value="N"/>
                                    <Setter TargetName="priceType_txt" Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <!--全价-->
                                <DataTrigger Binding="{Binding PriceType}" Value="2">
                                    <Setter TargetName="priceType_bd" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="priceType_bd" Property="BorderBrush" Value="#FB943C"/>
                                    <Setter TargetName="priceType_txt" Property="Text" Value="F"/>
                                    <Setter TargetName="priceType_txt" Property="Foreground" Value="#FB943C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="报量(万)" MinWidth="20" MaxWidth="150" Width="Auto" CanUserSort="True" SortMemberPath="Qty">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="QtyBorder">
                                    <TextBlock x:Name="Quantity_display" 
                                               Text="{Binding Qty, StringFormat={}{0:0}}" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="wholeTag" Grid.Column="1" Background="{DynamicResource TextBox.Focus.Border}" Width="18" Height="18" CornerRadius="1" Visibility="Collapsed" Margin="2 0 0 0">
                                    <TextBlock Text="整" Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Qty,Converter={StaticResource StringIsNullOrEmptyConvertor}}" 
                                             Value="true">
                                    <Setter TargetName="Quantity_display" Property="Text" Value="--"/>
                                    <Setter TargetName="Quantity_display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WholeFlag}" Value="1">
                                    <Setter TargetName="wholeTag" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--清算速度-->
                <DataGridTemplateColumn Header="清算速度" MinWidth="50" Width="90" MaxWidth="500" CanUserSort="True" SortMemberPath="SettlType" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock x:Name="SettlType_Display" Text="{Binding SettlType, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}" VerticalAlignment="Center" Visibility="{Binding EditBtnVisible}"/>
                                    <localcomp:SettleTypeSelector SettleType="{Binding SettlType_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource EnumTypeConvertor},ConverterParameter='settletype'}"
                                                     CreateTime="{Binding CreateTime}"
                                                     FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" IsEnabled="{Binding EditEnable}"  Visibility="{Binding SaveBtnVisible}"/>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="4">
                                    <Setter Property="FontFamily" TargetName="SettlType_Display" Value="Roboto" />
                                    <Setter Property="FontWeight" TargetName="SettlType_Display" Value="Normal" />
                                    <Setter Property="FontStyle" TargetName="SettlType_Display" Value="Italic" />
                                    <Setter Property="Foreground" TargetName="SettlType_Display" Value="{DynamicResource Text.Foreground.NoPermission}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="已匹配量(万)" MinWidth="80" Width="80" MaxWidth="500">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="已匹配量(万)" VerticalAlignment="Center"/>
                                <Viewbox Width="14" Height="14">
                                    <Path Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center" 
                                          Style="{StaticResource InfoIconStyle}"
                                          Data="M8,0 C3.58,0 0,3.58 0,8 C0,12.42 3.58,16 8,16 C12.42,16 16,12.42 16,8 C16,3.58 12.42,0 8,0 Z M8.93,12.588 L7.07,12.588 L7.07,10.646 L8.93,10.646 L8.93,12.588 Z M8.93,9.293 L7.07,9.293 L7.07,3.411 L8.93,3.411 L8.93,9.293 Z"
                                          ToolTip="非本个需匹配的成交量">
                                    </Path>
                                </Viewbox>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MatchedQty}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="本成交的量(万)" MinWidth="128" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--<TextBox x:Name="bindQty_Edit" 
                                     Text="{Binding BindQty_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource TextBoxStyle1}"/>-->
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="outer_bd" BorderBrush="Transparent" Width="100">
                                    <comp:NumericUpDown x:Name="bindQty_Edit"
                                    Background="#0F0F0F" 
                                    MinValue="0" MaxValue="99999999" DecimalLength="0" RangeValue="100" VerticalAlignment="Center"
                                    FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" AllowEmpty="True"
                                    ToolTip="输入范围:1-99999999"
                                    IsEnabled="{Binding IsCheckEnable,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                                    LostFocus="bindQty_Edit_LostFocus" ValueChanged="bindQty_Edit_ValueChanged">
                                        <comp:NumericUpDown.NumericValue>
                                            <Binding Path="BindQty_Edit" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"
                                             ValidatesOnDataErrors="True" NotifyOnValidationError="True" NotifyOnTargetUpdated="True" 
                                             ValidatesOnNotifyDataErrors="True">
                                                <!--<Binding.ValidationRules>
                                                <val:MatchExecValidationRules ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                                            </Binding.ValidationRules>-->
                                            </Binding>
                                        </comp:NumericUpDown.NumericValue>
                                    </comp:NumericUpDown>
                                </Border>
                                <!--<Viewbox Width="14" Height="14" x:Name="riskVB">
                                    <Path Width="16" Height="16" Margin="4,0,0,0" VerticalAlignment="Center" 
                                              Style="{StaticResource InfoIconStyle}"
                                              Data="M8,0 C3.58,0 0,3.58 0,8 C0,12.42 3.58,16 8,16 C12.42,16 16,12.42 16,8 C16,3.58 12.42,0 8,0 Z M8.93,12.588 L7.07,12.588 L7.07,10.646 L8.93,10.646 L8.93,12.588 Z M8.93,9.293 L7.07,9.293 L7.07,3.411 L8.93,3.411 L8.93,9.293 Z"
                                              ToolTip="{Binding RiskNote,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                                              Fill="Red">
                                    </Path>
                                </Viewbox>-->
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="False">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource multiCompareConverter}">
                                            <Binding Path="BindQty_Edit"/>
                                            <!-- 第一个要比较的属性 -->
                                            <Binding Path="BindQty"/>
                                            <!-- 第二个要比较的属性 -->
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="outer_bd" Property="BorderBrush" Value="Orange"/>
                                    <Setter TargetName="outer_bd" Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <!--<DataTrigger Binding="{Binding RiskNote, Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="riskVB" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>-->
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="备注" Width="70" MinWidth="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="RiskNoteTB" Margin="0,0,0,0" Text="{Binding RiskNote}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Foreground="red">
                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding Text, Converter={StaticResource subStringConverter}, ConverterParameter=250}" TextWrapping="Wrap" MaxWidth="200"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                                <!--<Image Margin="1,0,0,0" Source="/STC.XBond.Plugin;component/Images/stc_icon_input_search_typing.png" Width="20" Height="20" VerticalAlignment="Center"/>-->
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="状态" Width="*" MinWidth="50" MaxWidth="500" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="txStatus" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                       Text="{Binding Status, Converter={StaticResource EnumTypeConvertor}, ConverterParameter='intentionstatus_buyer'}">
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="*" MinWidth="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <!--<StackPanel Grid.Column="0" Orientation="Horizontal">-->
                                <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0"
                                                        Style="{DynamicResource SaveButton}" ToolTip="保存个需" Visibility="{Binding SaveBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"
                                                        Command="{Binding DataContext.SaveRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"></Button>
                                <Button BorderThickness="0" Height="20" Width="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" Grid.Column="1"
                                                        Style="{DynamicResource EditCloseButton}" ToolTip="删除" 
                                                        Command="{Binding DataContext.DelRecordCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" 
                                        Visibility="{Binding DelBtnVisible,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource visibilityConvertor}}"></Button>
                                <!--</StackPanel>-->
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" >
            <Button x:Name="AddlBtn" Content="+个需" Style="{DynamicResource BlueButtonStyle}"
                    HorizontalAlignment="Right"  Margin="4 0 276 0" 
                   Command="{Binding AddCommand}"/>
            <Button x:Name="CancelBtn" Content="取消" Style="{DynamicResource BlueButtonStyle}" 
                    HorizontalAlignment="Right"  Margin="4 0 194 0" 
                                        Click="CancelBtn_Click"/>
            <Button x:Name="ConfirmBtn" Content="保存" Style="{DynamicResource BlueButtonStyle}"  
                    HorizontalAlignment="Right" Margin="4 0 112 0" 
                    Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding ConfirmEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </Grid>
</comp:WindowBase>
