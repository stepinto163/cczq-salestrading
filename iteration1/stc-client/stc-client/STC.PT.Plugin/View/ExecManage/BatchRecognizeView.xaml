<comp:WindowBase x:Class="STC.PT.Plugin.View.ExecManage.BatchRecognizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:comp="clr-namespace:STC.Common.View.Component;assembly=STC.Common"
             xmlns:local="clr-namespace:STC.PT.Plugin.View.Component"
             xmlns:comCon ="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
                      xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             mc:Ignorable="d" 
             ResizeMode="CanResize"
             Title="成交识别"
             Height="400" Width="1100" Closed="WindowBase_Closed">
    <comp:WindowBase.Resources>
        <ResourceDictionary>
            <comCon:BooleanConvertor x:Key="booleanConvertor"/>
            <comCon:EnumTypeConvertor x:Key="EnumTypeConvertor"/>
            <comCon:DaysOffStrConverter x:Key="DaysOffCon"/>
            <comCon:NumberConvertor x:Key="numConvertor"/>
            <comCon:SubStringConverter x:Key="subStringConverter"/>
            <comCon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <comCon:StringIsNullOrEmptyConvertor x:Key="StringIsNullOrEmptyConvertor"/>
            <comCon:RadioButtonConverter x:Key="radioBtnConverter"/>
            <!--默认ScrollView-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource DefaultScrollViewer}"/>
            <Style x:Key="SideTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Orange}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Side}" Value="2">
                        <Setter Property="Foreground" Value="{DynamicResource ColorBrush.Blue}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SelfVGridSplitterStyle2" TargetType="{x:Type GridSplitter}">
                <Setter Property="PreviewStyle" Value="{DynamicResource GridSplitterPreviewStyle}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Grid Background="{TemplateBinding Background}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Rectangle Width="1" Height="12" Stroke="#515151" Margin="0,0,2,0"/>
                                    <Rectangle Width="1" Height="12" Stroke="#515151" Margin="-2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 居中 -->
            <Style x:Key="SelfDataGridColumnHeaderCenterStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 居右 -->
            <Style x:Key="SelfDataGridColumnHeaderRightStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment"  Value="Right"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <!-- 居左 -->
            <Style x:Key="SelfDataGridColumnHeaderLeftStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>
            <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
                <Grid Height="25">
                    <Border Grid.Column="1" Background="#FFEBC8" Opacity="0"   Cursor="Hand"/>
                    <Path x:Name="Arrow" Grid.Column="1"  Margin="0,0,0,0"  Data="M 0 0  6 6 12 0 Z"  VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="None" Fill="#A0A0A0" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="true">
                        <Setter TargetName="Arrow" Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform   CenterX="6" CenterY="3" Angle="180"></RotateTransform>
                            </Setter.Value>
                        </Setter>
                        <Setter TargetName="Arrow" Property="Margin" Value="0 -5 0 2"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <Style TargetType="{x:Type ComboBox}" x:Key="DTitileComboxStyle">
                <Setter Property="BorderBrush" Value="#3C3C3C"></Setter>
                <Setter Property="Background" Value="#0F0F0F"></Setter>
                <Setter Property="Foreground" Value="#D7D7D7"></Setter>
                <Setter Property="FontSize" Value="14"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.3*" MaxWidth="25"/>
                                </Grid.ColumnDefinitions>
                                <Border  Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="1"/>
                                <ContentPresenter HorizontalAlignment="Left" Margin="3,3,0,3"  x:Name="ContentSite"  VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/>

                                <!--ToggleButton 已数据绑定到 ComboBox 本身以切换 IsDropDownOpen-->
                                <ToggleButton Grid.Column="1"  Grid.ColumnSpan="1"  Template="{StaticResource ComboBoxToggleButton}" x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                                <!--必须将 TextBox 命名为 PART_EditableTextBox，否则 ComboBox 将无法识别它-->
                                <TextBox   Visibility="Hidden" BorderThickness="0"   Margin="2 0 0 0" x:Name="PART_EditableTextBox"  VerticalAlignment="Center" Focusable="True" Background="#0F0F0F" IsReadOnly="{TemplateBinding IsReadOnly}"/>

                                <!--Popup 可显示 ComboBox 中的项列表。IsOpen 已数据绑定到通过 ComboBoxToggleButton 来切换的 IsDropDownOpen-->
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Margin="0,4,0,0" Placement="Bottom" x:Name="Popup"  Focusable="False" AllowsTransparency="True" PopupAnimation="Slide">
                                    <Border CornerRadius="1" BorderThickness="1,0,1,1" BorderBrush="{TemplateBinding BorderBrush}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{TemplateBinding Background}" MinWidth="{TemplateBinding ActualWidth}" x:Name="DropDown" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FFEBC8" BlurRadius="2" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Style="{DynamicResource ScrollViewerStyle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True" 
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                            <!-- StackPanel 用于显示子级，方法是将 IsItemsHost 设置为 True -->
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" Background="#0F0F0F"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="true">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height" Value="24"/>
                            <Setter Property="MinHeight" Value="20"></Setter>
                            <Setter Property="Foreground" Value="#D7D7D7"></Setter>
                            <Setter Property="VerticalAlignment" Value="Center"></Setter>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontFamily" Value="MicrosoftYaHeiSemibold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Name="Back" CornerRadius="1" Background="#0F0F0F" >
                                            <ContentPresenter ContentSource="{Binding }" VerticalAlignment="Center" HorizontalAlignment="Left"></ContentPresenter>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Back" Property="Background" Value="#3C3C3C"></Setter>
                                                <!--<Setter TargetName="Back" Property="BorderThickness" Value="1,0,1,1"></Setter>-->
                                                <Setter TargetName="Back" Property="BorderBrush" Value="#3C3C3C"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ExecBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.Disable.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TextBox.Disable.Border}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.MouseOver.Background}"/>
                                    <!--<Setter Property="Foreground" Value="{DynamicResource TextBox.MouseOver.Foreground}"/>-->
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TextBox.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.Focus.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TextBox.Focus.Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </comp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="8" x:Name="LeftRow"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TabControl x:Name="recogTypeTC" Grid.RowSpan="2"  Style="{DynamicResource TabControlStyle1}" Padding="0" BorderThickness="0" AllowDrop="True" DragDrop.DragEnter="TabControl_DragEnter" DragDrop.Drop="TabControl_Drop" PreviewKeyDown="img_PreviewKeyDown">
            <TabItem x:Name="textTI" Header="原文" Width="60" Style="{DynamicResource TabItemStyle_Button}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <comp:WatermarkTextBox x:Name="contentTxt"  WaterMark="请粘贴报价信息&#x000A;如 BID 200210 3.24% 3000w&#x000A;(支持粘贴多条信息)" VerticalContentAlignment="Top"
                             BorderThickness="0" Background="{DynamicResource MainBackgroup.ColorBrush}"
                             AcceptsReturn="True" TextWrapping="Wrap"></comp:WatermarkTextBox>
                </ScrollViewer>

            </TabItem>
            <TabItem x:Name="ImageTI" Header="图片" Width="60" Style="{DynamicResource TabItemStyle_Button}" Visibility="{Binding ParserImageVisibility}">
                <Grid>
                    <TextBlock Name="ImageWaterMark" Text="请粘贴报价图片" Foreground="#3C3C3C" Margin="4 2 0 0" FontSize="13" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image  x:Name="img"  Focusable="True" Stretch="None"  AllowDrop="True" DragDrop.DragEnter="TabControl_DragEnter" DragDrop.Drop="TabControl_Drop" PreviewKeyDown="img_PreviewKeyDown"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="4">
            <Button x:Name="btnClear" Width="60" Height="24" Style="{DynamicResource GraySlateButtonStyle}"
                            Click="btnClear_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0">清除</Button>
            <Button x:Name="btnRecognize" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource BlueGreenStyle}"
                        Click="btnRecognize_Click" Foreground="#D7D7D7" BorderThickness="0 1 0 0">识别</Button>
        </StackPanel>
        <Border x:Name="step1" Grid.Row="2" Grid.RowSpan="2" BorderBrush="#3B3C3E" BorderThickness="0 1 0 0" />

        <!--分割-->
        <GridSplitter x:Name="gridSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource BackgroundBrush}" Style="{StaticResource SelfVGridSplitterStyle2}" DragCompleted="gridSplitter_DragCompleted"/>

        <DataGrid x:Name="dg" Grid.Column="2" Grid.RowSpan="2"
                      ItemsSource="{Binding ViewSource.View}"
                      SelectedItem="{Binding SelectedItem_Recognize,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource DefaultDataGrid}" SelectionMode="Single" IsReadOnly="False"
                  
                   LoadingRow="DataGrid_LoadingRow" 
                   UnloadingRow="DataGrid_UnloadingRow"
                  
                  BeginningEdit="DataGrid_BeginningEdit"
                  CellEditEnding="DataGrid_CellEditEnding"
                  ColumnReordered="dg_ColumnReordered">

            <!--ColumnDisplayIndexChanged="dg_ColumnDisplayIndexChanged"-->
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="操作" MinWidth="40" Width="40" MaxWidth="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="DelBtn" Height="14" Width="14" 
                                        Command="{Binding DataContext.DelOrderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}"
                                        Style="{DynamicResource DeleteButton}" FontSize="10"
                                         PreviewMouseLeftButtonDown="Btn_PreviewMouseLeftButtonDown"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="序号" Width="Auto" MinWidth="40" MaxWidth="60" IsReadOnly="True" HeaderStyle="{StaticResource SelfDataGridColumnHeaderCenterStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="No_TB" Text="{Binding No}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="剩余期限" Width="Auto" MinWidth="105" SortMemberPath="RemaingingTime_convert">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderLeftStyle}">
                            <Setter Property="Padding" Value="9,0,5,0"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="remainingTimetb" Grid.Column="1" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Text="{Binding RemainingTime}">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding Text}"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RemainingTime}" Value="已到期">
                                    <Setter TargetName="remainingTimetb" Property="Foreground" Value="#B03131"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="风控检查备注" MaxWidth="200" MinWidth="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="RiskRemark" Text="{Binding RiskNote}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Foreground="red">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock Text="{Binding Text, Converter={StaticResource subStringConverter}, ConverterParameter=250}" TextWrapping="Wrap" MaxWidth="200"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="渠道" MinWidth="80" Width="Auto" MaxWidth="200" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Venue" Text="自谈"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Symbol}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="代码" MinWidth="80" Width="Auto" MaxWidth="200" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="代码" VerticalAlignment="Center"/>
                                <Button x:Name="CopyCodeBtn" Style="{DynamicResource CopyButton}" Width="20" Height="20" Grid.Column="1" Margin="5 0 0 0" Click="CopyCodeBtn_Click"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="SecurityIDTB" Text="{Binding SecurityId}"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecurityId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="简称" MinWidth="80" Width="Auto" MaxWidth="200" CanUserSort="True" SortMemberPath="SecurityId" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Symbol" Text="{Binding Symbol}"  FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Symbol}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="我方方向" MinWidth="60" Width="60" CanUserSort="True" SortMemberPath="Side">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!--编辑部分-->
                            <ComboBox x:Name="cbSide_edit" Height="18" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding DataContext.SideDic,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}, Mode=FindAncestor}}" 
                                          DisplayMemberPath="Value"  SelectedValuePath="Key" Grid.Column="2"
                                          SelectedValue="{Binding Side_Edit,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{DynamicResource NonEditableComboBoxStyle}"
                                      FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}">
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--显示部分-->
                            <Border x:Name="SideBorder">
                                <TextBlock x:Name="SideTB_display" Text="{Binding Side,Converter={StaticResource EnumTypeConvertor},ConverterParameter='side_pt'}" Width="45" Style="{StaticResource SideTextBlockStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <!--没有方向-->
                                <DataTrigger Binding="{Binding Side,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="SideBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="SideBorder" Property="BorderBrush" Value="red"/>
                                    <Setter TargetName="SideTB_display" Property="Text" Value="我方方向"/>
                                    <Setter TargetName="SideTB_display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="成交价(%)" MinWidth="80" Width="Auto" MaxWidth="200" CanUserSort="True" SortMemberPath="Price">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!--编辑部分-->
                            <comp:NumericUpDown x:Name="PriceNU_Edit" NumericValue="{Binding Price_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                    MinValue="0" MaxValue="999999999999" DecimalLength="4" RangeValue="0.0025" VerticalAlignment="Center" AllowEmpty="True"
                                                Loaded="PriceNU_Edit_Loaded"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PriceBorder">
                                <!--显示部分-->
                                <TextBlock x:Name="Price_Display" Text="{Binding Price, StringFormat={}{0:0.00##}}" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Price,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="PriceBorder" Property="BorderThickness" Value="1"/>
                                    <Setter TargetName="PriceBorder" Property="BorderBrush" Value="red"/>
                                    <Setter TargetName="Price_Display" Property="Text" Value="--"/>
                                    <Setter TargetName="Price_Display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="成交价(权%)" MinWidth="80" Width="Auto" MaxWidth="200" CanUserSort="True" SortMemberPath="Yieldtoexecution">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!--编辑部分-->
                            <comp:NumericUpDown x:Name="YieldtoexecutionNU_Edit" NumericValue="{Binding Yieldtoexecution_Edit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                    MinValue="0" MaxValue="999999999999" DecimalLength="4" RangeValue="0.0025" VerticalAlignment="Center" AllowEmpty="True"
                                Loaded="YieldtoexecutionNU_Edit_Loaded" IsEnabled="{Binding IsExeCdcType,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}" 
                                                Visibility="{Binding IsExeCdcType,Converter={StaticResource visibilityConvertor}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PriceBorder">
                                <!--显示部分-->
                                <TextBlock x:Name="Price_Display" Text="{Binding Yieldtoexecution, StringFormat={}{0:0.00##}}" VerticalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Yieldtoexecution,Converter={StaticResource StringIsNullOrEmptyConvertor}}" Value="true">
                                    <Setter TargetName="PriceBorder" Property="BorderThickness" Value="1"/>
                                    <!--<Setter TargetName="PriceBorder" Property="BorderBrush" Value="red"/>-->
                                    <Setter TargetName="Price_Display" Property="Text" Value="--"/>
                                    <Setter TargetName="Price_Display" Property="Foreground" Value="#3C3C3C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="净价" MinWidth="80" Width="Auto" MaxWidth="200" CanUserSort="True" SortMemberPath="CleanPrice">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox x:Name="txNetPrice" FontSize="14"  Margin="0, 0, 0, 0" 
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="24"
                                 input:InputMethod.IsInputMethodEnabled="False"
                                 Style="{DynamicResource  STCDefaultBoxStyle}" 
                                 Text="{Binding CleanPrice_Edit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="TxPrice_PreviewTextInput"   
                                 PreviewKeyDown="TxNetPrice_PreviewKeyDown"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PriceBorder">
                                <!--显示部分-->
                                <TextBlock x:Name="Price_Display" Text="{Binding CleanPrice, StringFormat={}{0:0.000#}}" VerticalAlignment="Center"/>
                            </Border>
