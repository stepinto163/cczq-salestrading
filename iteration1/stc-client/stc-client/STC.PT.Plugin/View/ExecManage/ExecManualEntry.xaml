                     Height="24" Width="160"
                     Text="{Binding ShenzhenInstCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" HorizontalAlignment="Left" 
                     Style="{DynamicResource  ExecBoxStyle}"/>-->
            <localcomp:AutoCompleteComboBox x:Name="ShenzhenInstCode_edit" Grid.Row="7" Grid.Column="3"
                                Height="24" Width="160" Margin="4,0,0,0"
                DisplayValuePath="szedealercode" 
                Text="{Binding ShenzhenInstCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                BackGroundCob="{StaticResource ColorBrush.Black8}" 
