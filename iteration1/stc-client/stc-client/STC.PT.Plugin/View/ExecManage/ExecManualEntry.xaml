                            IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>
