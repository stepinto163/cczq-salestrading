                                    <Border Background="Transparent">
                                        <TextBlock Grid.Column="0" Height="22" Text="{Binding Name}"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{StaticResource DefaultForegroup.ColorBrush}"
                                    TextTrimming="CharacterEllipsis" >
                                            <TextBlock.ToolTip>
                                                <ToolTip Content="{Binding Text}"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </localcomp:AutoCompleteComboBox.AutoCompColumns>
                </localcomp:AutoCompleteComboBox>
            </StackPanel>
            <TextBlock Text="上交所机构代码:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" />

            <!--<TextBox x:Name="txShanghaiInstCode" Grid.Row="7" Grid.Column="1"  Margin="4,0,0,0" 
                     Height="24" Width="160"
                     Text="{Binding ShanghaiInstCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" HorizontalAlignment="Left" 
                     Style="{DynamicResource  ExecBoxStyle}"/>-->
            <localcomp:AutoCompleteComboBox x:Name="ShanghaiInstCode_edit" Grid.Row="7" Grid.Column="1"
                    Height="24" Width="160" Margin="4,0,0,0"
                DisplayValuePath="sseinstitutioncode" 
                Text="{Binding ShanghaiInstCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                BackGroundCob="{StaticResource ColorBrush.Black8}" 
                PreviewMouseDown="ShanghaiInstCode_edit_PreviewMouseDown"
