                <Button x:Name="btnSend" Width="100" Height="24" Margin="4,0,0,0" Style="{DynamicResource RedButtonStyle}"
                        Command="{Binding ConfirmAndAddCommand}" Visibility="{Binding IsAdd,Converter={StaticResource visibilityConvertor}}" >保存并新建个需</Button>
            </StackPanel>
        </Grid>

    </Grid>
</commComp:WindowBase>
