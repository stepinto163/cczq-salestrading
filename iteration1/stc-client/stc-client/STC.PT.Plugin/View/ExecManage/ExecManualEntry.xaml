                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="Transparent">
                                    <TextBlock Grid.Column="0" Height="22" Text="{Binding sseinstitutioncode }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                        TextTrimming="CharacterEllipsis" >
