                    FocusBorderBrushCob="{StaticResource TextBox.Focus.Border}" BorderThickness="1"
                    Watermark="发单对手方" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                    VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left"
                    PatternChanged="OrderCounter_edit_PatternChanged"
                    IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}">
