                    Text="{Binding PartySubName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    BackGroundCob="{StaticResource ColorBrush.Black8}" 
                    PreviewMouseDown="PartySubName_edit_PreviewMouseDown"
                    MouseOverBorderBrushCob="{StaticResource TextBox.MouseOver.Border}" 
                    FocusBorderBrushCob="{StaticResource TextBox.Focus.Border}"
                    Watermark="本方交易员" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
