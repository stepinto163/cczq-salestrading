                      SelectedValue="{Binding OrderSide_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center" SelectedIndex="0"   Height="24" Width="160"
                      IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}">
                    </ComboBox>
            
            <TextBlock Text="发单方式:" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
