                     VerticalAlignment="Center" HorizontalAlignment="Left" 
                     Style="{DynamicResource  ExecBoxStyle}"/>
            <TextBlock Text="对手交易员:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" />
