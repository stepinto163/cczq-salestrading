<commComp:WindowBase  x:Class="STC.PT.Plugin.View.ExecManage.ExecManualEntry"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:local="clr-namespace:STC.PT.Plugin.View.ExecManage"
                      xmlns:commComp="clr-namespace:STC.Common.View.Component;assembly=STC.Common" 
                      xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:comCon ="clr-namespace:STC.Common.Convertor;assembly=STC.Common"
        xmlns:localcomp="clr-namespace:STC.PT.Plugin.View.Component"
             mc:Ignorable="d"  WindowStartupLocation="CenterScreen" BorderThickness="1" BorderBrush="#A0A0A0"
             Title="手工录入" Height="680" Width="660">
    <commComp:WindowBase.Resources>
        <ResourceDictionary>

            <comCon:RadioButtonConverter x:Key="radioBtnConverter"/>
            <comCon:BooleanConvertor x:Key="booleanConvertor"/>
            <comCon:VisibilityConvertor x:Key="visibilityConvertor"/>
            <comCon:ReverseVisibilityConvertor x:Key="reverseVisibilityConvertor"/>
            <VisualBrush x:Key="HintText" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left" AlignmentY="Top">
                <VisualBrush.Visual>
                    <TextBlock Padding="5, 5, 0, 0" Height="30" FontSize="12" Foreground="{DynamicResource TextBlockDefaultForground}" Text="请输入识别文本，支持修改文本后点击 Enter 进行识别" ToolTip="请输入识别文本，支持修改文本后点击 Enter 进行识别，Ctrl+Enter换行" />
                </VisualBrush.Visual>
            </VisualBrush>
            <SolidColorBrush x:Key="TextBlockForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PriceButtonDefaultBackground" Color="#172422"></SolidColorBrush>
            <Style x:Key="TextBoxStyle1" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="#0F0F0F"/>
                <Setter Property="BorderBrush" Value="#136C5E"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="Bd" SnapsToDevicePixels="true" BorderThickness="{TemplateBinding BorderThickness}" 
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter Property="Background" TargetName="Bd" Value="#1E1E1E"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="#3C3C3C"/>
                                    <!--<Setter Property="Foreground" Value="#3C3C3C"/>-->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SelfSendPriceTextBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource ColorBrush.Black8}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBlockDefaultForground}"/>
                <Setter Property="FontFamily" Value="Roboto"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush.Gray15}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="#3C3C3C" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="false"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3C3C3C"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                        <Condition Property="Tag" Value="1"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="true"/>
                                        <Condition Property="Tag" Value="0"/>
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="true"/>
                                        <!--<Condition Property="Tag" Value="1"/>-->
                                    </MultiTrigger.Conditions>

                                    <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=BorderBrush,RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}"/>
                                    <!--Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ColorBrush.Gray15}"/-->
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground"  Value="#FFFFFF "/>
                                    <Setter Property="SelectionBrush" Value="#009AFF"/>
                                </MultiTrigger>


                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsKeyboardFocused" Value="false"/>
                                        <Condition Property="Text" Value=""/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3C3C3C"/>
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource HintText}"/>
                                </MultiTrigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--清算速度 +0 远 按钮-->
            <Style x:Key="SendPriceFilterListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <!--<Setter Property="Padding" Value="0"/>-->
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBlockForeground}"/>
                <Setter Property="Background" Value="{StaticResource PriceButtonDefaultBackground}"/>
                <!--<Setter Property="Padding" Value="10,0,10,0"/>-->
                <Setter Property="Width" Value="48"/>
                <Setter Property="Margin" Value="1, 0, 0, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2" BorderThickness="0, 1, 0, 0" VerticalAlignment="Center"
                    BorderBrush="#193D37"  Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}"
                    SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="Cp" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" 
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedActive.Background}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedActive.Border}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <!--Condition Property="Selector.IsSelectionActive" Value="True"/-->
                                        <Condition Property="IsSelected" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedInactive.Border}"/>
                                    <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource ListBoxItem.SelectedActive.Background}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{DynamicResource TextBlockForeground}"/>
                                    <Setter TargetName="Cp" Property="TextBlock.FontWeight" Value="Bold"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="Bd" Value="{DynamicResource TextBox.Disable.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ExecBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource TextBox.Static.Background}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroup.ColorBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AllowDrop" Value="true"/>
                <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="{DynamicResource SmallContentFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border" CornerRadius="2" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Grid>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.Disable.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TextBox.Disable.Border}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.MouseOver.Background}"/>
                                    <!--<Setter Property="Foreground" Value="{DynamicResource TextBox.MouseOver.Foreground}"/>-->
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TextBox.MouseOver.Border}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="true">
                                    <Setter Property="Background" TargetName="border"  Value="{DynamicResource TextBox.Focus.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBox.Focus.Foreground}"/>
                                    <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource TextBox.Focus.Border}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsInactiveSelectionHighlightEnabled" Value="true"/>
                            <Condition Property="IsSelectionActive" Value="false"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </commComp:WindowBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <commComp:WatermarkTextBox Grid.Row="0" x:Name="tbContent" VerticalContentAlignment="Top" 
                                   IsEnabled="{Binding IsEnableParse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                     
                                   VerticalScrollBarVisibility="Auto"                      
                                   BorderThickness="1" Style="{DynamicResource SelfSendPriceTextBox}"
                                   PreviewKeyDown="tbContent_PreviewKeyDown" Margin="4,2,4,3" 
                                   Text="{Binding BondTxt, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"                     
                                   AcceptsReturn="True" TextWrapping="Wrap" 
                                   BorderBrush="{Binding BorderBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                    
                                   WaterMark="请输入识别文本" 
                                   ToolTip="请输入识别文本，支持修改文本后点击 Enter 进行识别，Ctrl+Enter换行" 
                                   MinHeight="50" ></commComp:WatermarkTextBox>
        <Grid Grid.Row="1" Margin="0 5 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="债券信息:" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txSecurityid" 
                       Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Margin="4,8,0,0" Height="24" Width="188" FontWeight="Bold"
                       Visibility="{Binding IsAdd,Converter={StaticResource visibilityConvertor}}"/>
            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2">
                <commComp:SearchTextBox x:Name="Search_TextBox" Margin="4,0,0,0" 
                                    SearchText="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"  Width="160" Height="24" FontSize="12" HorizontalAlignment="Left"
                                    AfterSearch="Search_TextBox_AfterSearch"
                                    IsHitTestVisible="{Binding IsAdd,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}"/>
                <!--Visibility="{Binding IsAdd,Converter={StaticResource reverseVisibilityConvertor}}"-->
                <TextBlock x:Name="txSymbol"  Margin="4,8,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="120" 
                           Text="{Binding Symbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold"/>

            </StackPanel>
            <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="40 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="方向:" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <ListBox x:Name="SideListBox" Grid.Column="1" SelectionMode="Single" Margin="5, 0, 0, 0" 
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" 
                     Height="26" 
                     Background="Transparent" MinWidth="88"
                     BorderThickness="0"
                     FontSize="12" SelectedIndex="{Binding SideIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" HorizontalAlignment="Left" 
                     BorderBrush="Transparent"
                     IsHitTestVisible="{Binding IsAdd,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem x:Name="lbBid" Width="30" Height="24"  Content="买入" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                    <ListBoxItem x:Name="lbOfr" Width="30"  Height="24" Content="卖出" Style="{DynamicResource SendPriceFilterListBoxItemStyle}"/>
                </ListBox>
                <TextBlock Text="渠道:" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <CheckBox Content="{Binding VenueDisplay}" Grid.Column="3" Style="{DynamicResource TagCheckBoxStyle}" 
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                          Margin="4 0 0 0" Height="24" Width="35" 
                          IsTabStop="False" IsChecked="True" IsHitTestVisible="False"/>

            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="到期" Style="{DynamicResource TagCheckBoxStyle}" 
                          HorizontalAlignment="Right"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                          Margin="1 0 0 0" Height="24" Width="35" IsTabStop="False"
                          IsChecked="{Binding YieldTypeFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}"/>
                <CheckBox Content="行权" Style="{DynamicResource TagCheckBoxStyle}" 
                          HorizontalAlignment="Right"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                          Margin="1 0 0 0" Height="24" Width="35" IsTabStop="False"
                          IsChecked="{Binding YieldTypeFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"
                          Visibility="{Binding IsExeCdcType,Converter={StaticResource visibilityConvertor}}"/>


            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txPrice" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" 
                             input:InputMethod.IsInputMethodEnabled="False"
                             Style="{DynamicResource  STCDefaultBoxStyle}" PreviewTextInput="TxPrice_PreviewTextInput" 
                             Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding YieldTypeFlag,Converter={StaticResource visibilityConvertor}}"
                             IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}" />
                    <TextBox x:Name="txExePrice" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" 
                             input:InputMethod.IsInputMethodEnabled="False"
                             Style="{DynamicResource  STCDefaultBoxStyle}" PreviewTextInput="TxPrice_PreviewTextInput" 
                             Text="{Binding ExePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding YieldTypeFlag,Converter={StaticResource reverseVisibilityConvertor}}"
                             IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}" />
                    <TextBlock Text="%" Margin="1 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="净价" Style="{DynamicResource TagCheckBoxStyle}" 
                          HorizontalAlignment="Right"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                          Margin="1 0 0 0" Height="24" Width="35" IsTabStop="False"
                          IsChecked="{Binding NetPriceFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}"/>

                <CheckBox Content="全价" Style="{DynamicResource TagCheckBoxStyle}" 
                          HorizontalAlignment="Right"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                          Margin="1 0 0 0" Height="24" Width="35" IsTabStop="False"
                          IsChecked="{Binding NetPriceFlag, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource radioBtnConverter}, ConverterParameter='1'}"/>


            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3" >
                <TextBox x:Name="txNetPrice" FontSize="14"  Margin="4, 0, 0, 0" 
                         VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" 
                         input:InputMethod.IsInputMethodEnabled="False"
                         Style="{DynamicResource  STCDefaultBoxStyle}" 
                         Text="{Binding NetPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="TxPrice_PreviewTextInput"   
                         PreviewKeyDown="TxNetPrice_PreviewKeyDown" 
                         Visibility="{Binding NetPriceFlag,Converter={StaticResource visibilityConvertor}}"
                         IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}" />
                <TextBox x:Name="txFullPrice" FontSize="14"  Margin="4, 0, 0, 0" 
                         VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160" 
                         input:InputMethod.IsInputMethodEnabled="False"
                         Style="{DynamicResource  STCDefaultBoxStyle}" 
                         Text="{Binding FullPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="TxPrice_PreviewTextInput"   
                         PreviewKeyDown="TxNetPrice_PreviewKeyDown"
                         Visibility="{Binding NetPriceFlag,Converter={StaticResource reverseVisibilityConvertor}}"
                         IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}" />
                
                <TextBlock  Text="元" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="量:" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txQty" Grid.Column="0" FontSize="14" Margin="4,0,1,0" 
                             VerticalAlignment="Center" HorizontalAlignment="Left" Height="24" Width="160"   
                             Style="{DynamicResource  STCDefaultBoxStyle}"
                             PreviewTextInput="TxPrice_PreviewTextInput"
                             input:InputMethod.IsInputMethodEnabled="False" 
                             Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}"/>
                    <TextBlock Grid.Column="1" Margin="1,0,0,0"  Text="万" VerticalAlignment="Center" HorizontalAlignment="Left" 
                               Background="Transparent" />
                </Grid>
                <!--<TextBlock Text="KW" VerticalAlignment="Center" HorizontalAlignment="Left"/> Foreground="{DynamicResource ColorBrush.Gray14}" -->
            </StackPanel>
            <TextBlock Text="终端对手方:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <localcomp:AutoCompleteComboBox x:Name="CounterInsNameCb_edit" Grid.Row="2" Grid.Column="3" 
                                            Height="24" Width="160" Margin="4,0,0,0"
                                            DisplayValuePath="shortnamecn" 
                                            SelectedItem="{Binding RealcounterpartynameItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Text="{Binding RealcounterpartynameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            BackGroundCob="{StaticResource ColorBrush.Black8}" 
                                            PreviewMouseDown="CounterInsNameCb_edit_PreviewMouseDown"
                                            MouseOverBorderBrushCob="{StaticResource TextBox.MouseOver.Border}" Background="Black"
                                            FocusBorderBrushCob="{StaticResource TextBox.Focus.Border}" BorderThickness="1"
                                            Watermark="终端对手方" FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                            VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left"
                                            PatternChanged="CounterInsNameCb_edit_PatternChanged"
                                            IsHitTestVisible="{Binding IsManual,Converter={StaticResource radioBtnConverter}, ConverterParameter='0'}">
                <localcomp:AutoCompleteComboBox.AutoCompColumns>
                    <DataGridTemplateColumn  Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="Transparent">
                                    <TextBlock Grid.Column="0" Height="22" Text="{Binding shortnamecn }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                                        TextTrimming="CharacterEllipsis" >
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Text}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn  Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="Transparent">
                                    <TextBlock Grid.Column="0" Height="22" Text="{Binding fullnamecn }"  Margin="5, 0, 0, 5" Padding="0, 5, 0, 0" Foreground="{DynamicResource DefaultForegroup.ColorBrush}"
                    TextTrimming="CharacterEllipsis" >
                                        <TextBlock.ToolTip>
                                            <ToolTip Content="{Binding Text}"/>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </localcomp:AutoCompleteComboBox.AutoCompColumns>
            </localcomp:AutoCompleteComboBox>
            <TextBlock Text="交易日期:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,0">
                <DatePicker x:Name="datePicker" Grid.Row="3" Grid.Column="1" Width="90" Height="24" Margin="4, 0, 0, 0"
